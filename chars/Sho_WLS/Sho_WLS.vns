trigger1 = var(15) = 1
anim = 30041
ID = 30000
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
removetime = -1
bindtime = -1

[State 40, 6]
type = ChangeState
trigger1 = Pos Y + Vel Y >= 0
value = 52
ctrl = 1

