;---------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = N
sprpriority = 0
velset = 0,0

[State -3,STOP]
type = StopSnd
trigger1 = prevstateno = [191,194]
trigger1 = roundstate = 2
channel = 0

[State -3,STOP]
type = StopSnd
trigger1 = prevstateno = [191,194]
trigger1 = roundstate = 2
channel = 1

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
trigger3 = Time = 0
x = 0

[State 0, Kino]
type = RemoveExplod
trigger1 = !time && prevstateno != 5900
id = 30000
[State 0, Kino]
type = RemoveExplod
trigger1 = !time
id = 30001
[State 0, Daidou]
type = Explod
triggerall = var(15) = 1
trigger1 = !numexplod(30001) && anim = 5
anim = 30005
ID = 30001
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
bindtime = -1
[State 0, Kino]
type = RemoveExplod
trigger1 = anim = 0
id = 30001
[State 0, Daidou]
type = Explod
triggerall = var(15) = 1
triggerall = !numexplod(30000) && !numexplod(30001)
trigger1 = anim = 0
trigger2 = anim = 5 && !animtime
anim = 30000
ID = 30000
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
removetime = -1
bindtime = -1
[State 0, Kino]
type = RemoveExplod
trigger1 = anim = 5
id = 30000

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050 + 100*((Anim = 5120) || (Anim = 5150))

