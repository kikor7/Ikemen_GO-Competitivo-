;CLAYTALITIES (usando los estados de Juano16)
;--------------------------------------------
;FINISH HIM!! START
[Statedef 9000]
type = A
movetype= A
physics = N
velset = 0,0
anim = 9000
ctrl = 0

[State No block No music]
type = AssertSpecial
trigger1 = 1
flag = unguardable
flag2 = nomusic
ignorehitpause = 1

[State HIT]
type = HitDef
Trigger1 = !movecontact && enemynear,alive && enemynear,stateno != 9002
attr = S, NA
hitflag = -M
sparkno = -1
p2stateno = 9002
numhits = 0

[State succesfull]
type = ChangeState
trigger1 = movecontact && p2stateno = 9002
value = 9001
ctrl = 0

[State Follow Enemy]
type = posset
trigger1 = 1 
x = floor(enemynear,pos x)
y = floor(enemynear,pos y)

[State END]
type = destroyself
trigger1 = !animtime && p2stateno = 9002 && !enemynear,ctrl
trigger2 = time = 300

;------
;FINISH HIM!! STUFF
[Statedef 9001]
type = A
movetype= A
physics = N
velset = 0,0
anim = 9001

[State KILL]
type = parentvarset
trigger1 = 1
var(20) = 1

[State Follow]
type = bindtoparent
trigger1 = 1

[State Time Stop]
type = assertspecial
trigger1 = 1
flag = timerfreeze
ignorehitpause = 1

[State Music OFF]
type = assertspecial
trigger1 = parent,var(21) > 0
trigger2 = parent,win = 1 || !enemynear,alive 
trigger3 = p2stateno = 9002 
flag = nomusic
ignorehitpause = 1

[State Noboard]
type = AssertSpecial
trigger1 = parent,var(21) > 0
flag = nobardisplay

[State Fatality MSG]
type = null;Explod
trigger1 = !numexplod(10001) && parent,var(21) = 1 && parent,time = 120 && parent,stateno = [180,189]
anim = 10001
id = 10001
pos = 160,50
postype = left
facing = 1
bindtime = 9999
removetime = 9999
ontop = 1
ownpal = 1

[State Fatality SND]
type = PlaySnd
trigger1 = numexplod(10001) = 1 && parent,var(21) = 1 && parent,time = 120 && parent,stateno = [180,189]
value = 4,1

[State Fatality time]
type = AssertSpecial
trigger1 = parent,var(21) > 0 && parent,time < 250 && parent,stateno = [180,189]
flag = roundnotover
ignorehitpause = 1

;------
;p2 dizzy
[Statedef 9002]
type = S
movetype= I
physics = N
velset = 0,0
ctrl = 0
sprpriority = 3

[State Killme]
type = HitBy
trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
value2 = S,NA
time = 9999

[State Effect OFF]
type = AfterImage
trigger1 = !time
time = 1
length = 1
ignorehitpause = 1

[State Dizzy]
type = ChangeAnim
trigger1 = !time
value = ifelse(selfanimexist(5305),5305,5300)
elem = ifelse(selfanimexist(5305),3,0)

[State Ground]
type = posset
trigger1 = !time
y = 0

[State doubleKO]
type = LifeAdd
trigger1 = !enemynear,alive
value = -9999
kill = 1

[State doubleKO]
type = SelfState
trigger1 = !enemynear,alive
value = 5050

[State timeup]
type = lifeadd
trigger1 = time = 300 && !enemynear,var(21)
value = -9999

[State timeup]
type = selfstate
trigger1 = time = 300 && !enemynear,var(21)
value = 5050


;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

[Statedef -2]

;-----------------
; Sonidos estados 5000
[State -2 , 0]
type = PlaySnd 
triggerall = Random < 500
triggerall = Time = 1
trigger1 = stateno = 5000 || stateno = 5001 || stateno = 5020
value = 11,0

[State -2 , 1]
type = PlaySnd 
triggerall = Random < 500
triggerall = Time = 1
trigger1 = stateno = 5010 || stateno = 5011 || stateno = 5012
value = 11,0

[State -2 , 2]
type = PlaySnd 
triggerall = Random < 500
triggerall = Time = 1
trigger1 = stateno = 5002 || stateno = 5021 || stateno = 5022
value = 0,11

[State -3, Claytality]
type = PlaySnd
triggerall = time = 1
trigger1 = anim = 5305
value = 0,11

;-----------------
; Compatibilidad chars de Shadowtak (CF1-2 de SNES)
[State -2 , 2]
type = VarSet 
triggerall = RoundState = 2
trigger1 = enemy,authorname = "Shadowtak"
v = 15
value = 1

;-----------------
; Estados fatality by Juano16
[State -2, wins]
type = VarAdd
trigger1 = !time && stateno = 180
var(30) = 1

[State -2, wins reset]
type = VarSet
triggerall = var(30) > 0 && !time && stateno = 5900
trigger1 = roundno = 1
trigger2 = !roundsexisted 
var(30) = 0

[State -2, kill]
type = varset
trigger1 = (var(30) <= var(31)) && var(31) != -1 
trigger2 = numpartner >= 1 
trigger3 = enemynear,numpartner >= 1 
trigger4 = var(31) = -1
var(20) = 1
ignorehitpause = 1

[State -2, Fatality]
type = DisplayToClipboard
trigger1 = 1
text = "Kill:%d Wins:%d OFF:%d p2Life:%d Finish:%d"
params = var(10),var(30),var(31),p2life,var(21)

[State -2, Call Finish]
type = Helper
trigger1 = !numhelper(9000) && !var(20) && var(30) > var(31) && enemynear,life <= 1
helpertype = Normal
ID = 9000
name = "Finish Him!"
postype = p2
stateno = 9000
ownpal = 1

[State -2, No Damage]
type = NotHitBy
trigger1 = !var(20) && var(30) > var(31) && enemynear,life <= 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 10

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106
trigger3 = stateno = 511
value = 1,4

[State -3, Pop]
type = null;PlaySnd
triggerall = stateno = 5120
trigger1 = animelem = 6
value = 2,1

[State -3, Crashing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5100
trigger2 = stateno = 5110
value = 2,5
