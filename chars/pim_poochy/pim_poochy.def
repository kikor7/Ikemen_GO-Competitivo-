; ここにキャラ情報を書いてください
[Info]
name = "Poochy"        ;キャラの名前
displayname = "Poochy" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "shimon"         ;キャラの製作者名
pal.defaults = 1          ;敵としてでるキャラのパレット

; Files for the player
[Files]
movelist = movelist.dat
cmd     = poochy.cmd.cns   ;キャラのコマンド
cns     = poochy.cns       ;キャラのプログラム
st      = poochy.cns       ;キャラのプログラム
stcommon = common1.cns 
sprite  = poochy.sff   ;キャラの絵
anim    = poochy.air   ;キャラの動き
sound   = poochy.snd   ;キャラの音
pal1    = 2p.act  ;キャラの色（最大１２個）
pal2    = 4p.act
pal3    = 1p.act
pal4    = 1p.act
pal5    = 3p.act
pal6    = 1p.act

[Arcade]
;intro.storyboard = 
ending.storyboard = poochy_end.def