
[Data]
life = 1000          ;体力ゲージの初期値
attack = 100         ;攻撃力（これ以上に設定すると強くなる）
defence = 100        ;防御力（これ以上に設定すると強くなる）
fall.defence_up = 50 ;コンボをくらっている時にあがる防御力
liedown.time = 60    ;倒れてから起上がるまでのフレーム数
airjuggle = 15       ;空中でどれだけコンボが繋がるか（高くすると無限コンボに
sparkno = 2          ;hitdefで設定していない時の基本ヒットスパークナンバー
guard.sparkno = 40   ;設定してない時のガードナンバー
KO.echo = 0          ;KOした時に声にエコーをかけるか（１でＯＮ）
 volume = 0
  IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;水平方向の縮尺（通常１）
yscale = 1           ;垂直方向の縮尺（通常１）
ground.back = 15     ;キャラの幅(後方,地上)
ground.front = 16    ;キャラの幅(前方,地上)
air.back = 12        ;キャラの幅(後方,空中)
air.front = 12       ;キャラの幅(前方,空中)
height = 60          ;キャラの高さ
attack.dist = 160    ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist = 90;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale = 0     ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos = -5, -90   ;頭の大体の座標
mid.pos = -5, -60    ;体の中心の大体の座標
shadowoffset = 0     ;影の垂直方向のオフセット
draw.offset = 0,0    ;使用しない

[Velocity]
walk.fwd  = 2.4      ;前進の速度
walk.back = -2.2     ;後退の速度
run.fwd  = 6.5, 0    ;前ダッシュの速度（ホップする時はyを-にする）
run.back = -6.5,-3.8 ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu = 0,-8.4    ;垂直ジャンプの速度
jump.back = -2.55    ;後ジャンプの速度
jump.fwd = 2.5       ;前ジャンプの速度
runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd = 4,-8.1      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu = 0,-8.1      ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back = -2.55      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd = 2.5         ;２段ジャンプ以降の前ジャンプの速度

[Movement]
airjump.num = 0       ;空中でジャンプする回数
airjump.height = 35   ;空中でジャンプする最低限の高さ
yaccel = .44          ;重力
stand.friction = .85  ;立ち状態の摩擦係数
crouch.friction = .82 ;屈み状態の摩擦係数

;---------------------------------------------------------------------------
; ステイトの解説
; [Statedef STATENO]
; type = ?      S/C/A/L  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｌ：ダウン
; movetype = ?  I/A/H    Ｉ：通常状態/Ａ：攻撃状態/Ｈ：ダメージをくらってる状態
; physics = ?   S/C/A/N  Ｓ：立ち/Ｃ：屈み/Ａ：空中/Ｎ：無し
; juggle = ?             その攻撃に使うジャグル数

;-------------------------------------------------------------------------------
; ダッシュ
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 100,Vel]
type = VelSet
trigger1 = 1
x = Const(velocity.run.fwd.x)

[State 100,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100,Next]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 101,End]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0
ctrl = 1

;---------------------------------------------------------------------
; バックステップ
;------------------------ 開始
[Statedef 105]
type = S
movetype = I
physics = N
anim = 105
ctrl = 0
velset = 0, 0

[State 105,VelSet]
type = VelSet
trigger1 = AnimElem = 3
x = Const(velocity.run.back.x)

[State 105, VelMul]
type = VelMul
trigger1 = AnimElem = 3, > 0
x = 1

[State 4150,Muteki]
type = NotHitBy
trigger1 = AnimElem = 2, >= 0 && AnimElem = 5, < 0
value = SCA

[State 105,VelSet]
type = VelSet
trigger1 = AnimElem = 5
x = 0

[State 100,AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; タイムオーバーで負けた時
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利ポーズ分岐

[Statedef 180]
type = S
 

[State 180, 1]
type = ChangeState
trigger1 = MatchOver = 0
value = 181

[State 180, 2]
type = ChangeState
trigger1 = MatchOver = 1
value = 182

;---------------------------------------------------------------------------
; 勝利ポーズ1

[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 190, Snd]
type = PlaySnd
trigger1 = time = 0 
value = s181, 0

[State 181, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0,100]
flag = roundnotover


;2
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 181, Muteki]
type = NotHitBy
trigger1 = 1
value = SCA


[State 190, Snd]
type = PlaySnd
trigger1 = AnimElem = 4
value = s181, 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = time = [0,150]
flag = roundnotover

;---------------------------------------------------------------------------
; 開始前の動作

[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] 
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 191, 2] 
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3]
type = PlaySnd
trigger1 = AnimElem = 5
value = s180,0

[State 191, 4] 
type = ChangeState
trigger1 = AnimTime = 0
value = 0

