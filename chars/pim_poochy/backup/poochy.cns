trigger1 = PrevStateNo != 100 && Var(11) > 0 && sysvar(1) != 0
trigger2 = prevstateno = 100 && sysvar(1) = 1
x = ifelse(sysvar(1)=1,const(velocity.runjump.fwd.x),const(velocity.runjump.back.x))
y = -6

[State 40, VarSet(12)]
type = VarSet
triggerall = AnimTime = 0 && var(12) = 0 && Command != "holdup"
trigger1 = PrevStateNo != 100 && Var(11) > 0 && sysvar(1) != 0
trigger2 = prevstateno = 100 && sysvar(1) = 1
