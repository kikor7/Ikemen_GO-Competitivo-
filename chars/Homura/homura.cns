getpower = 30,15
priority  = 3
animtype  = Light
hitflag = MAF
guardflag = L
pausetime = 7,8
sparkno = s6000                    ;Spark anim no (Def: set above)
sparkxy = -10,-42
hitsound   = 5,0
guardsound = 6,0
ground.type = Low
ground.slidetime = 4
ground.hittime  = 6
ground.velocity = -4
air.velocity = -1.5,-3
guard.hittime = 4
guard.ctrltime = 4
fall.recovertime = 18

