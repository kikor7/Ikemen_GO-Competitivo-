;;Juat Defence -Stand-
[Statedef 160]
type    = S
physics = S
anim = 160
ctrl = 0
velset = 0,0
SprPriority = -1

[State 160]
type = PosFreeze
trigger1 = time >= 0

[state 150, 0]
type = palfx
trigger1 = time = 0
time = 15
add = 0,0,255
ignorehitpause = 1
persistent = 0

[State 161]
type = PosSet
trigger1 = time >= 0
y = 0

[State 161]
type = VelSet
trigger1 = time >= 0
y = 0

[State 160]
type = Explod
trigger1 = time = 0
anim = 6220
pos = 5,-60
postype = p1
ownpal = 1
scale = 0.5,0.5
ignorehitpause = 1
persistent = 0
sprpriority = 10
bindtime = 1
pausemovetime = 65535
supermovetime = 65535
supermove = 1

[State 160]
type = Pause
trigger1 = time = 0
time = 15
movetime = 15
ignorehitpause = 1

[State 161]
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = s50,0
Volume = 999
persistent = 0
freqmul = 1.25

[State 810, Hurt 11]
type = LifeAdd
trigger1 = time = 0
value = 5
absolute = 1

[State 160, 14]
type = PowerAdd
trigger1 = time = 0
trigger1 = power < 6001
value = Ceil(0.01*const(data.power))

[State 160]
type = ChangeState
Trigger1 = AnimTime = 0
value = 130
ctrl = 1

