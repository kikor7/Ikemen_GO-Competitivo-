; Win state decider
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 180]
type = S
ctrl = 0
velset = 0,0

[State 180, Devil?]
type = ChangeState
trigger1 = prevstateno = 3705
value = 3706

[State 180, Still Crying for her...]
type = changestate
trigger1 = matchover
trigger1 = partner,name = "Madoka Kaname"  
trigger1 = partner,stateno = [3905,3906]
value = 10180

[State -2, LOOOOOOOOOOOOOOOOOOOOOOOSSSSSSSSSSSSSSSSSSSSEEEEEEEEEEERRRRRRRRRRRR!!!]
type = ChangeState
trigger1 = !partner,alive  
trigger1 = partner,name = "Madoka Kaname" 
trigger2 = !enemynear,alive
trigger2 = enemynear,name = "Madoka Kaname"   || p2name = "Madoka Kaname"   || p4name = "Madoka Kaname"  
trigger2 = TeamMode = Single || TeamMode = Turns
trigger2 = enemynear,teamMode = Single || enemynear,teamMode = Turns
value = 10182

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181 +(random%2)
ctrl = 0
;---------------------------------------------------------------------------
; Win pose 1 - Bow
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 0, PlaySnd]
type = PlaySnd
triggerall = time = 0
trigger1 = !numpartner
trigger2 = numpartner
trigger2 = partner,name != "Madoka Kaname" && partner,name != "Madoka3" && partner,name != "PMrosa"
trigger3 = numpartner
trigger3 = partner,name != "miki sayaka" && partner,name != "Sayaka Miki" && partner,name != "PMazul"
trigger4 = numpartner
trigger4 = partner,name != "Tomoe Mami" && partner,name != "Mami Tomoe" && partner,name != "PMamarillo"
trigger5 = numpartner
trigger5 = partner,name != "Kyouko Sakura" && partner,name !=  "Kyoko_Sakura" && partner,name != "PMrojo"
value = S5,11
channel = 5
volume = 255

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
trigger1 = numpartner
trigger1 = partner,name = "Madoka Kaname" || partner,name = "Madoka3" || partner,name = "PMrosa"
value = s185,17
channel = 5
volume = 255

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
trigger1 = numpartner
trigger1 = partner,name = "miki sayaka" || partner,name = "Sayaka Miki" || partner,name = "PMazul"
value = S185,16
channel = 5
volume = 255

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
trigger1 = numpartner
trigger1 = partner,name = "Tomoe Mami" || partner,name = "Mami Tomoe" || partner,name = "PMamarillo"
value = S185,14
channel = 5
volume = 255

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
trigger1 = numpartner
trigger1 = partner,name = "Kyouko Sakura" || partner,name =  "Kyoko_Sakura" || partner,name = "PMrojo"
value = S185,15
channel = 5
volume = 255

