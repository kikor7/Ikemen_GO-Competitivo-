;AI用ヘルパー
[Statedef 12500]
type = A
movetype= I
physics = N
ctrl = 0
anim = 8000
velset = 0,0



;----------------------------------------------------------------------------------------------
;以下AIで利用
;var(30)        中段等学習用現在状態記憶
;var(57)	相手起き上がり無敵警戒
;var(58)	相手地上空中状態認識
;var(59)        暗転計測
;----------------------------------------------------------------------------------------------
;位置
[State -1]
type = PosSet
trigger1 = 1
x = ((root,pos x)-(90*facing))
y = (root,pos y)
[State -1]
type = Turn
trigger1 = enemynear,facing = facing
[State -1]
type = NotHitBy
trigger1 = 1
value = SCA
[State -1]
type = AssertSpecial
trigger1 = 1
flag = invisible


;中段等学習用現在状態記憶
;1 下段ガード
;2 立ちガード
;3 空中ガード
