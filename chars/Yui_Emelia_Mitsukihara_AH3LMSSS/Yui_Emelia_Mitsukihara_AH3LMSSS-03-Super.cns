[Statedef 1000];エンハンスリロード　エーテル弾
type = S
movetype = A
physics = S
sprpriority = 2
ctrl = 0
juggle  = 1
poweradd = 0
anim = 1000

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 1

[State Set]
type = Null
triggerall = Time = 0
trigger1 = var(4) :=   0|| 1;エフェクトY座標
trigger1 = var(5) :=   0|| 1;ヒットorガードエフェクトNo(2桁目=hit,1桁目=guard)
trigger1 = var(6) :=   0|| 1;エフェクト拡大倍率
trigger1 = var(7) :=   0|| 1;エフェクト角度
trigger1 = var(8) :=   0|| 1;ダメージ値(アルカナ基準値に準じる)

[State dist]
type = AttackDist
trigger1 = MoveType = A
value = 0

[State explod]
type = Explod
trigger1 = AnimElem = 3
anim = 1001
ID = 1
pos = -5,-112
postype = p1
bindtime = -1
removetime = -2
scale = 0.5,0.5
sprpriority = 3
shadow = 0,0,0
ownpal = 1

[State mod]
type = ModifyExplod
trigger1 = NumExplod(1)
trigger1 = AnimElem = 3, >= 0 && AnimElem = 4, < 0
scale = 0.06 * (Time - 4),0.06 * (Time - 4)
id = 1

[State mod]
type = ModifyExplod
trigger1 = NumExplod(1)
trigger1 = AnimElem = 5, > 2
scale = 0.3 - 0.06 * (Time - 14),0.3 - 0.06 * (Time - 14)
id = 1

[State explod]
type = Explod
trigger1 = AnimElem = 5
anim = 1002
ID = 2
pos = -5,-112
postype = p1
bindtime = -1
removetime = -2
scale = 0.5,0.5
sprpriority = 3
shadow = 0,0,0
ownpal = 1

[State mod]
type = ModifyExplod
trigger1 = NumExplod(2)
trigger1 = AnimElem = 5, >= 0 && AnimElem = 6, < 0
scale = 0.06 * (Time - 12),0.06 * (Time - 12)
id = 2

[State explod]
type = Explod
trigger1 = AnimElem = 6
anim = 1003
ID = 3
pos = -5,-112
postype = p1
bindtime = -1
removetime = -2
scale = 0.5,0.5
sprpriority = 3
shadow = 0,0,0
ownpal = 1

[State mod]
type = ModifyExplod
trigger1 = NumExplod(3)
trigger1 = AnimElem = 6, >= 0
scale = 0.04 * (Time - 17),0.04 * (Time - 17)
id = 3

[State explod]
type = Explod
triggerall = AnimElem = 5, >= 0 && AnimElem = 11, < 0
trigger1 = (random <= 300 && Time%3 != 0) || Time%3 = 0
anim = 1004 + random%3
ID = 4
pos = -5 - 30 + random%61,-112 - 20 + random%61
postype = p1
bindtime = 1
removetime = 8 + random%8
scale = 0.10,0.10
sprpriority = 3
shadow = 0,0,0
ownpal = 1

[State explod]
type = Explod
triggerall = AnimElem = 5, >= 0 && AnimElem = 11, < 0
trigger1 = (random <= 300 && Time%3 != 0) || Time%3 = 0
anim = 1007 + random%3
ID = 4
pos = -5 - 30 + random%61,-112 - 20 + random%61
postype = p1
bindtime = 1
removetime = 8 + random%8
scale = 0.10,0.10
sprpriority = 3
shadow = 0,0,0
ownpal = 1

[State snd]
type = PlaySnd
trigger1 = AnimElem = 3
value = s6,1000

[State var]
type = VarSet
trigger1 = AnimElem = 1
var(57) = 0

[State ch]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

