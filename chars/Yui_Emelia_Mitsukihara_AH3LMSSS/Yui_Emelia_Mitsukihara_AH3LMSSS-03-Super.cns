x = 7

[State Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = s0,1000 + random%2
channel = 0

[State snd]
type = PlaySnd
trigger1 = AnimElem = 3
value = s6,1100

[State explod]
type = Explod
trigger1 = AnimElem = 3, >= 0 && MoveType = A
anim = 1101 + AnimElemNo(0) - 3
ID = 1
pos = 50,-45
postype = p1
bindtime = -1
removetime = 1
scale = 1,1
sprpriority = 4
shadow = 0,0,0
ownpal = 1
ignorehitpause = 1
removeongethit = 1

[State explod]
