type = S
movetype = A
physics = S
sprpriority = 2
ctrl = 0
juggle  = 1
poweradd = 0
anim = 1100

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 2

[State Set]
type = Null
triggerall = Time = 0
trigger1 = var(4) :=    11|| 1;エフェクト番号(2桁目=hit,1桁目=guard)
trigger1 = var(5) :=     0|| 1;エフェクト角度
trigger1 = var(6) :=    80|| 1;エフェクト倍率
trigger1 = var(7) := 30020|| 1;エフェクト座標(X=4桁目以降、Y=3桁目以内)
trigger1 = var(8) :=  1680|| 1;ダメージ値(アルカナ基準値に準じる)

[State set]
type = StateTypeSet
trigger1 = AnimElem = 3
Statetype = C

[State Vel]
type = VelSet
