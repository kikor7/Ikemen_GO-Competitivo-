trigger1 = MoveType = I
anim = 1105
ID = 1
pos = 45,-45
postype = p1
bindtime = -1
removetime = -2
scale = 1,1
sprpriority = 4
shadow = 0,0,0
ownpal = 1
persistent = 0
ignorehitpause = 1
removeongethit = 1

[State hitdef]
type = HitDef
trigger1 = AnimElem = 3, >= 0 && !MoveContact && !MoveReversed && MoveType = A
attr = C,SA
hitflag = MAF
guardflag = MA
animtype = Hard
priority = 5,Hit
damage = ceil(var(8) * 1000 / 24000),ceil(150 * 1000 / 24000)
pausetime = 11, 11
sparkno = -1
guard.sparkno = -1
sparkxy = -1
hitsound = S1 ,3
guardsound = S2, 1
ground.type = Low
air.type = High
ground.hittime = 20
air.hittime = 24
guard.hittime = 20
ground.slidetime = 20
guard.ctrltime = 20
airguard.ctrltime = 24
yaccel = Const(Movement.yaccel)
ground.velocity = (Vel X + 0.5) * -1,Const(Movement.yaccel) * -8
guard.velocity = (Vel X + 4) * -1
air.velocity = (Vel X + 0.5) * -1,Const(Movement.yaccel) * -8
sprpriority = 2
fall = 1
fall.recovertime = 11 + ceil(24*var(9)*fvar(1)*fvar(2))
id = StateNo
getpower = 0, 0
givepower = 0, 0

[State Set]
type = StateTypeSet
trigger1 = AnimElem = 6
movetype = I

[State ch]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

