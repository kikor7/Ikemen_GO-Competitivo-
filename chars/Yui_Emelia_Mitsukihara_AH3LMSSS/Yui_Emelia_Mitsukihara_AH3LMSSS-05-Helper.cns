[State -2];カウンターヒット初期化
type = varset
triggerall = var(9) != 1
trigger1 = MoveHit != 1
var(9) = 1
ignorehitpause = 1

[State -2];カウンターヒット判定
type = varset
triggerall = var(9) != 2
trigger1 = MoveType = A && P2MoveType = A
var(9) = 2
ignorehitpause = 1

[State -2];最終攻撃
type = AttackMulSet
trigger1 = movetype = A
value = Cond(Root,fvar(38) > 0.2,Root,fvar(38),0.2)

[State Set]
type = Null
triggerall = Time = 0
trigger1 = var(4) :=     1|| 1;エフェクト番号(2桁目=hit,1桁目=guard)
trigger1 = var(5) :=     0|| 1;エフェクト角度
trigger1 = var(6) :=   100|| 1;エフェクト倍率
trigger1 = var(7) :=     0|| 1;エフェクト座標(X=4桁目以降、Y=3桁目以内)
trigger1 = var(8) :=   840|| 1;ダメージ値(アルカナ基準値に準じる)

[State hitdef]
type = HitDef
trigger1 = AnimElem = 2, >= 0 && !MoveContact && !MoveReversed
attr = A,HP
hitflag = MAF
guardflag = MA
animtype = Hard
priority = 5,Hit
damage = ceil(var(8) * 1000 / 24000),ceil(150 * 1000 / 24000)
pausetime = 0, 5
sparkno = -1
guard.sparkno = -1
sparkxy = -1
hitsound = -1
guardsound = -1
ground.type = High
air.type = High
ground.hittime = 15
air.hittime = 17
guard.hittime = 15
ground.slidetime = 15
guard.ctrltime = 15
airguard.ctrltime = 17
yaccel = Const(Movement.yaccel)
ground.velocity = -8
guard.velocity = -8
air.velocity = -4, Const(Movement.yaccel) * -10
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
sprpriority = 3
air.fall = 1
fall.recovertime = 5 + ceil(24*var(9)*Root,fvar(1)*Root,fvar(2))
id = StateNo
getpower = 0, 0
givepower = 0, 0

[State -2];ヒット数カウント
type = Null
trigger1 = MoveHit = 1 && NumTarget
trigger1 = Root,Cond(1,var(12) := var(12) + 1,1)
ignorehitpause = 1

[State snd]
type = PlaySnd
trigger1 = MoveHit = 1 && NumTarget
value = s1,1

[State snd]
type = PlaySnd
trigger1 = MoveGuarded = 1 && NumTarget
value = s2,0

[State var]
type = parentvarset
trigger1 = MoveHit = 1 && NumTarget
fvar(38) = Root,fvar(38) * Cond(Root,var(12) = 1,Cond(var(9) = 2,(1 - 0.90) * 0.83 + 0.90,0.90),0.80)
ignorehitpause = 1

[State var]
type = parentvarset
trigger1 = MoveHit = 1 && Root,var(12) >= 2 && NumTarget
fvar(1) = Root,fvar(1) * 0.95
ignorehitpause = 1

[State var]
type = Helper
trigger1 = MoveContact = 1 && NumTarget
helpertype = normal
name = "Effect"
pos = floor(var(7) * 0.001) + 15 - random%16,(-var(7)%1000)
postype = p1
facing = 1
Stateno = Cond(var(9) = 2,6020,6000 + Cond(MoveHit,floor(var(4)/10),15 + var(4)%10))
pausemovetime = 999
supermovetime = 999
keyctrl = 0
ownpal = 1
ignorehitpause = 1

[State target]
type = TargetState
trigger1 =  MoveHit = 1
trigger1 = NumTarget
trigger1 = Target,HitFall
value = 910
id = StateNo
ignorehitpause = 1

[State Remove]
type = RemoveExplod
trigger1 = IsHelper(2000) && var(0) >= 17
trigger2 = (IsHelper(2021) || IsHelper(2022)) && var(0) >= 18
trigger3 = (IsHelper(2023) || IsHelper(2024) || IsHelper(2025) || IsHelper(2026)) && FrontEdgeDist <= -100

[State end]
type = ChangeState
trigger1 = IsHelper(2000) && var(0) >= 17
