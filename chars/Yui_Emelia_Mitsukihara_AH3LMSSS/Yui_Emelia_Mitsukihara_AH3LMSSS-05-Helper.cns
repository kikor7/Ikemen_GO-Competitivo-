[State -2];カウンターヒット初期化
type = varset
triggerall = var(9) != 1
trigger1 = MoveHit != 1
var(9) = 1
ignorehitpause = 1

[State -2];カウンターヒット判定
type = varset
triggerall = var(9) != 2
trigger1 = MoveType = A && P2MoveType = A
var(9) = 2
ignorehitpause = 1

[State -2];最終攻撃
type = AttackMulSet
trigger1 = movetype = A
value = Cond(Root,fvar(38) > 0.2,Root,fvar(38),0.2)

[State Set]
type = Null
triggerall = Time = 0
trigger1 = var(4) :=    11|| 1;エフェクト番号(2桁目=hit,1桁目=guard)
trigger1 = var(5) :=     0|| 1;エフェクト角度
trigger1 = var(6) :=    70|| 1;エフェクト倍率
trigger1 = var(7) :=     0|| 1;エフェクト座標(X=4桁目以降、Y=3桁目以内)
trigger1 = var(8) :=  1920|| 1;ダメージ値(アルカナ基準値に準じる)

[State hitdef]
type = HitDef
triggerall = var(10) < 3
trigger1 = AnimElem = 2
trigger2 = AnimElem = 3
trigger3 = AnimElem = 4
trigger4 = AnimElem = 5
trigger5 = AnimElem = 6
trigger6 = AnimElem = 7
trigger7 = AnimElem = 8
trigger8 = AnimElem = 9
trigger9 = AnimElem = 10
trigger10 = AnimElem = 11
attr = A,HP
hitflag = MAF
guardflag = MA
animtype = Hard
priority = 5,Hit
damage = ceil(var(8) * 1000 / 24000),ceil(50 * 1000 / 24000)
pausetime = 0, 5
sparkno = -1
guard.sparkno = -1
sparkxy = -1
hitsound = -1
guardsound = -1
ground.type = High
air.type = High
ground.hittime = 15
air.hittime = 17
guard.hittime = 15
ground.slidetime = 15
guard.ctrltime = 15
airguard.ctrltime = 17
yaccel = Const(Movement.yaccel)
ground.velocity = -4,Const(Movement.yaccel) * -25
guard.velocity = -6
air.velocity = -4, Const(Movement.yaccel) * -25
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
sprpriority = 3
fall = 1
fall.recovertime = 5 + ceil(24*var(9)*Root,fvar(1)*Root,fvar(2))
id = StateNo
getpower = 30,15
givepower = 0, 0

[State -2];ヒット数カウント
type = Null
trigger1 = MoveHit = 1 && NumTarget
trigger1 = Root,Cond(1,var(12) := var(12) + 1,1)
ignorehitpause = 1

[State snd]
type = PlaySnd
trigger1 = MoveHit = 1 && NumTarget
value = s1,2

[State snd]
type = PlaySnd
trigger1 = MoveGuarded = 1 && NumTarget
value = s2,0

[State var]
type = parentvarset
trigger1 = MoveHit = 1 && NumTarget
fvar(38) = Root,fvar(38) * Cond(Root,var(12) = 1,Cond(var(9) = 2,(1 - 0.90) * 0.83 + 0.90,0.90),0.80)
ignorehitpause = 1

[State var]
type = parentvarset
trigger1 = MoveHit = 1 && Root,var(12) >= 2 && NumTarget
fvar(1) = Root,fvar(1) * 0.95
ignorehitpause = 1

[State -2]
type = Helper
trigger1 = MoveContact = 1 && NumTarget
helpertype = normal
name = "Effect"
pos = 15 - random%16, 0
postype = p1
facing = 1
Stateno = Cond(var(9) = 2,6020,6000 + Cond(MoveHit || var(0),floor(var(4)/10),15 + var(4)%10))
pausemovetime = 999
supermovetime = 999
keyctrl = 0
ownpal = 1
ignorehitpause = 1

[State target]
type = TargetState
trigger1 =  MoveHit = 1
value = 910
id = StateNo
ignorehitpause = 1

[State var]
type = varadd
trigger1 = MoveContact = 1 || MoveReversed = 1
var(10) = 1

[State end]
type = ChangeState
trigger1 = var(0) >= 40
value = 2099

[Statedef 2011]
type    = A
movetype = A
physics = N
sprpriority = 3
anim = 2011

[State angle]
type = AngleDraw
trigger1 = AnimElem = 2, < 0
scale = 0.75 + Time * 0.1,0.75 + Time * 0.1

[State trans]
type = Trans
trigger1 = AnimElem = 2, < 0
trans = addalpha
alpha = 256- Cond(Time > 10,(Cond(IsHelper(2010),Time,Time - 1) - 10) * 42,0),256

[State end]
type = DestroySelf
trigger1 = AnimTime = 0

[Statedef 2012]
type    = A
movetype = I
physics = N
sprpriority = 3
anim = Cond(IsHelper(2010),2012,2013)

[State anim]
type = ChangeAnim
trigger1 = Time = 0 && IsHelper(2031)
value = 2013
elem = 2

[State angle]
type = AngleDraw
trigger1 = 1
scale = 0.4 + Time * Cond(IsHelper(2010),0.05,Cond(IsHelper(2021),0.03,0.05)),0.4 + Time * Cond(IsHelper(2010),0.05,Cond(IsHelper(2021),0.03,0.05))

[State trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256- Cond(Time > 8,(Time - 6) * 42,0),256

[State end]
type = DestroySelf
trigger1 = AnimTime = 0

[Statedef 2014]
type    = A
movetype = I
physics = N
sprpriority = 3
anim = 2014

[State bind]
type = BindtoParent
trigger1 = Time = 0
pos = -20,0

[State var]
type = varadd
trigger1 = 1 && Parent,HitPauseTime <= 0
var(0) = 1

[State var]
type = varadd
trigger1 = var(0) > 30 && Parent,HitPauseTime <= 0
var(1) = 25

[State var]
type = varadd
trigger1 = time > 0 && Parent,HitPauseTime <= 0
fvar(0) = 0.12

[State var]
type = varadd
trigger1 = var(0) > 20 && Parent,HitPauseTime <= 0
fvar(1) = -0.025

[State angle]
type = AngleDraw
trigger1 = 1
scale = 0.15 + fvar(0),0.5 + fvar(1)

[State trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256- var(1),256

[State end]
type = DestroySelf
trigger1 = 0.5 + fvar(1) < 0

[Statedef 2015]
type    = A
movetype = I
physics = N
sprpriority = 1
anim = 2015

[State angle]
type = AngleDraw
trigger1 = 1
scale = 0.5 - Time * 0.05,0.5 - Time * 0.05

[State trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256,256

[State end]
type = DestroySelf
trigger1 = animtime = 0

