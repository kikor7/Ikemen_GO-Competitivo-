
[Statedef 200];立ち弱
type = S
movetype = A
physics = S
sprpriority = 2
ctrl = 0
juggle  = 1
poweradd = 0
anim = 200

[State Null]
type = Null
trigger1 = Time = 0
trigger1 = Helper(id),Cond(1,var(10) := 0,1) || 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 1

[State remove]
type = RemoveExplod
trigger1 = time = 0
id = 2

[State Set]
type = Null
triggerall = Time = 0
trigger1 = var(4) :=   100|| 1;エフェクト番号(2桁目=hit,1桁目=guard)
trigger1 = var(5) :=    50|| 1;エフェクト角度
trigger1 = var(6) :=    50|| 1;エフェクト倍率
trigger1 = var(7) := 50080|| 1;エフェクト座標(X=4桁目以降、Y=3桁目以内)
trigger1 = var(8) :=   500|| 1;ダメージ値(アルカナ基準値に準じる)

[State Voice]
type = PlaySnd
trigger1 = AnimElem = 4
value = s0,200 + random%2
channel = 0

[State snd]
type = PlaySnd
trigger1 = AnimElem = 4
value = s4,3

[State explod]
type = Explod
trigger1 = AnimElem = 4
anim = StateNo + 1
ID = 1
pos = 95,-85
postype = p1
bindtime = -1
removetime = -1
scale = 1,1
sprpriority = 3
shadow = 0,0,0
ownpal = 1
ignorehitpause = 1
removeongethit = 1

[State remove]
type = RemoveExplod
trigger1 = AnimElem = 7
id = 1

[State explod]
type = Explod
trigger1 = AnimElem = 7
anim = StateNo + 2
ID = 1
pos = 90,-85
postype = p1
bindtime = -1
removetime = -2
scale = 1,1
sprpriority = 4
shadow = 0,0,0
ownpal = 1
ignorehitpause = 0
removeongethit = 1

[State rev]
type = reversaldef
trigger1 = animelem = 1
reversal.attr = SCA,NA,SA
priority = 7,Hit
pausetime = 12,12
sparkno = -1
sparkxy = -1
sprpriority = -1
hitsound = -1
numhits = 0
id = 99999

[State hitdef]
type = HitDef
trigger1 = AnimElem = 6
attr = S,NA
hitflag = MAF
guardflag = MA
animtype = Light
priority = 1,Hit
damage = ceil(var(8) * 1000 / 24000)
pausetime = 9, 9
sparkno = -1
guard.sparkno = -1
sparkxy = -1
hitsound = S1 ,1
guardsound = S2, 0
ground.type = Low
air.type = Low
ground.hittime = ceil(11 * fvar(2))
air.hittime = ceil(13 * fvar(2))
guard.hittime = 11
ground.slidetime = 11
guard.ctrltime = 11
airguard.ctrltime = 13
yaccel = Const(Movement.yaccel)
ground.velocity = -4
guard.velocity = -4
air.velocity = -1.5, Const(Movement.yaccel) * -10
ground.cornerpush.veloff = Cond(PrevStateNo = 200 || PrevStateNo = 300,-10,-4) + Cond(var(12) > 1,(var(12) - 1) * -0.5,0)
air.cornerpush.veloff = Cond(PrevStateNo = 200 || PrevStateNo = 300,-10,-4) + Cond(var(12) > 1,(var(12) - 1) * -0.5,0)
guard.cornerpush.veloff = Cond(PrevStateNo = 200 || PrevStateNo = 300,-10,-4)
airguard.cornerpush.veloff = Cond(PrevStateNo = 200 || PrevStateNo = 300,-10,-4)
sprpriority = 2
air.fall = 1
fall.recovertime = 9 + ceil(24*fvar(1)*fvar(2))
id = StateNo
getpower = 30,15
givepower = 0, 0

[State set]
type = StatetypeSet
trigger1 = animelem = 7
movetype = I

[State ch] 
type = ChangeState
trigger1 = time > 1
trigger1 = AnimTime = 0
value = 0
ctrl = 1

