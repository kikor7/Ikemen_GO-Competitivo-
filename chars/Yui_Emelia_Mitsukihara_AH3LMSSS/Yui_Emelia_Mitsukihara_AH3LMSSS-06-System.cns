[Statedef 4010]
type = A
movetype = I
physics = N
velset = 0,0
ctrl = 0
PowerAdd = 0
sprpriority = 2
anim = 4010

[State null]
type = null
triggerall = Time = 0
trigger1 = fvar(10) := 0       || 1
trigger1 = fvar(11) := 0       || 1
trigger1 = fvar(12) := 0       || 1
trigger1 = fvar(13) := 1       || 1;初期値
trigger1 = fvar(14) := 0       || 1
trigger1 = fvar(15) :=-1       || 1;Time = 0の時0になるように。
trigger1 = fvar(16) :=fvar(16) || 1;そのまんま東
trigger1 = fvar(17) := 0       || 1

[State var]
type = VarSet
trigger1 = var(13) = 1
var(14) = var(14) + 1

[State var]
type = VarAdd
trigger1 = 1
fvar(15) = 1

[State turn]
type = Turn
trigger1 = p2dist x < 0

[State Helper]
type = Helper
trigger1 = fvar(15) = 1
trigger2 = fvar(15) > 0 && floor(fvar(15))%12 = 0
helpertype = normal
name = "Homing"
id = 6400
pos = -20, -70
postype = p1
facing = 1
StateNo = 6401
keyctrl = 0
ownpal = 0

[State anim]
type = changeanim
trigger1 = time
trigger1 = anim != 4010
trigger1 = vel y < -2
value = 4010

[State anim]
type = changeanim
trigger1 = time
trigger1 = anim != 4011
trigger1 = vel y > 1
value = 4011

[State anim]
type = changeanim
trigger1 = time
trigger1 = anim != 4012
trigger1 = vel y = [-2.0,1.0]
value = 4012

[State var]
type = VarSet
trigger1 = 1
fvar(10) = Cond(P2Dist X = 0,0.101,P2Dist X * 0.101)

[State var]
type = VarSet
trigger1 = 1
fvar(11) = Cond(P2Dist Y = 0,0.101,P2Dist Y * 0.101)

[State vel]
type = VarSet
trigger1 = 1
fvar(12) = vel x + vel y

[State HomingVelocity]
type = VelAdd
trigger1 = 1
x = 0.000001 + (0.50*cos(Atan(fvar(11)/fvar(10))))*(fvar(13))
y = 0.000001 + (0.50*sin(Atan(fvar(11)/fvar(10))))*(fvar(13))

[State HomingVelocity]
type = VelAdd
trigger1 = fvar(12) > 12.0 && fvar(13) = 1.0
trigger2 = fvar(12) > 24.0 && fvar(13) = 2.0
trigger3 = fvar(12) >= 36.0 && fvar(13) = 3.0
x = 0.000001 - (0.50*cos(Atan(fvar(11)/fvar(10))))*(fvar(13))

[State HomingVelocity]
type = VelAdd
triggerall = p2bodydist x >= 20
trigger1 = fvar(12) > 12.0 && fvar(13) = 1.0
trigger2 = fvar(12) > 24.0 && fvar(13) = 2.0
trigger3 = fvar(12) >= 36.0 && fvar(13) = 3.0
y = 0.000001 - (0.50*sin(Atan(fvar(11)/fvar(10))))*(fvar(13))

[State snd]
type = PlaySnd
triggerall = fvar(13) < 3
trigger1 = !var(59) && Command = "y"
trigger1 = fvar(13) := fvar(13) + 1 || 1
value = s5,4000

[State vel]
type = VelSet
trigger1 = P2bodydist X <= 10
trigger1 = P2bodydist Y = [-300,300] 
x = 0

[State vel]
type = VelSet
trigger1 = P2bodydist X <= 100
trigger1 = P2bodydist Y = [-30,0]
y = 0

[State var]
type = VarAdd
triggerall = fvar(14) <= 6.0
trigger1 = fvar(16) > 1
fvar(14) = cond(fvar(16) <= 7, 0.03,0.05) + cond(fvar(16) > 13,0.55,0)

[State vel]
type = VelSet
triggerall = fvar(10) >= abs(fvar(11))
triggerall = P2BodyDist X >= 20
triggerall = fvar(16) <= 14
trigger1 = !var(59)
trigger1 = Command = "holdback"
x = 1.0 + fvar(14)

[State vel]
type = velset
triggerall = P2BodyDist X  <= 20
triggerall = P2BodyDist Y = [0,150]
trigger1 = !var(59)
trigger1 = Command = "holdup"
y = 3.25

[State vel]
type = VelSet
triggerall = fvar(10) >= abs(fvar(11))
triggerall = P2BodyDist X >= 21
trigger1 = !var(59)
trigger1 = Command = "holddown"
y = 4.0 / fvar(13)

[State var]
type = VarSet
triggerall = fvar(10) >= abs(fvar(11))
trigger1 = p2bodydist x >= 200
fvar(17) = floor(p2bodydist x/200)*100

[State vel]
type = Velset
triggerall = fvar(10) >= abs(fvar(11))
triggerall = P2BodyDist Y >= 150 || P2BodyDist Y <= -150
triggerall = P2BodyDist X >= 20 && P2BodyDist X < 200
trigger1 = !var(59)
trigger1 = Command = "holdup"
y = -(p2bodydist x / 50) / fvar(13)

[State vel]
type = Velset
triggerall = fvar(10) >= abs(fvar(11))
triggerall = P2BodyDist Y >= 150 || P2BodyDist Y <= -150
triggerall = P2BodyDist X >= 400
triggerall = P2BodyDist X  < 500
trigger1 = !var(59)
trigger1 = Command = "holdup"
y = -(p2bodydist x / 200) / fvar(13)

[State vel]
type = Velset
triggerall = fvar(10) >= abs(fvar(11))
triggerall = P2BodyDist X  >= 200
trigger1 = !var(59)
trigger1 = Command = "holdup"
y = -(p2bodydist x / (floor(p2bodydist x * 0.01) * 50)) / fvar(13)

[State vel]
type = Velset
triggerall = fvar(10) > abs(fvar(11)) + 10
triggerall = P2BodyDist X >= 120
triggerall = P2BodyDist Y <= -100
triggerall = Vel X <= 0
triggerall = fvar(16) <= 13
trigger1 = !var(59)
trigger1 = Command = "holddown"
y = -1.0 + fvar(14)

[State vel]
type = Velset
triggerall = fvar(10) > abs(fvar(11)) + 10
triggerall = P2BodyDist X >= 120
triggerall = P2BodyDist Y >= 100
triggerall = Vel X <= 0
triggerall = fvar(16) <= 13
trigger1 = !var(59)
trigger1 = Command = "holddown"
y = 1.0 + fvar(14)

[State vel]
type = Velset
trigger1 = Abs(Vel Y) >= 15
y = Cond(Vel Y > 0,15,-15)

[State vel]
type = Velset
triggerall = fvar(10) > abs(fvar(11)) + 10
triggerall = (P2BodyDist Y >= 151) || (P2BodyDist Y <= -151)
trigger1 = !var(59)
trigger1 = Command = "holdfwd" || Command = "holdback"
x = (p2bodydist y / 500) / fvar(13) * cond(Command = "holdfwd",-1,1)

[State ch];ok
type = ChangeState
trigger1 = time > 1
trigger1 = Vel Y > 0
trigger1 = Pos Y > 0
value = 52
ctrl = 0

[State ch]
