value = 106

;----------------------------------------
;バックステップ・空中
[Statedef 106]
type    = A
physics = N
ctrl = 0
anim = 106

[State 106,PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = 1,1

[State 106, VelSet]
type = VelSet
trigger1 = Time = 3
x = -8.5
y = -3.5

[State 106, VelAdd]
type = VelAdd
trigger1 = Time >= 5
trigger1 = Pos Y < -3
x = .42
y = .55

[State 106, VelSet]
type = VelSet
trigger1 = Time > 10
trigger1 = Pos Y >= -5
y = 0
x = 0

[State 106, PosSet]
type = PosSet
trigger1 = Time > 10
trigger1 = Pos Y >= -5
y = 0

[State 106, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,0

[State 106, ChangeState]
type = ChangeState
trigger1 = Time > 10
trigger1 = Pos Y = 0
value = 107

;----------------------------------------
;バックステップ・着地
