value = 60,0
channel = 0

[State 1000, PlaySnd]
type = PlaySND
trigger1 = AnimElem = 3
value = 60,1

[State 1000, PlaySnd]
type = PlaySND
trigger1 = AnimElem = 7
value = 3,3

[State 1000, VelSet]
