StateType = A
physics = N

[State 1000, HitDef]
type = HitDef                    
trigger1 = time = 0
attr = A, SA                     
damage = 65,10                  
getpower = 60,30
animtype = Hard                 
guardflag = MA                   
hitflag = MAF                    
priority = 3, Hit                
pausetime = 14, 14                 
