p2facing = 1           
air.fall = 1
fall.recover = 0

[State 1000, ChangeState]
type = ChangeState
triggerall = Enemy(0),Pos y = 0
trigger1 = MoveHit = 1 && command = "スピンフォール・弱" || MoveHit = 1 && command = "スピンフォール・強"
value = 1020

[State 1000, ChangeState]
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 1010

