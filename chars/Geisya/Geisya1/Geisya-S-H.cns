
;---------------------------------------------------------------------------
; ここからは必殺技のステート
;---------------------------------------------------------------------------
; 鶴の舞（弱）

[Statedef 1000]
type     = S
movetype = A
physics  = S
juggle   = 4
poweradd = 0
velset   = 0,0
anim     = 1000
ctrl     = 0
sprpriority = 2

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElemTime(2) = 0
trigger2 = AnimElemTime(8) = 0
trigger3 = AnimElemTime(14) = 0
trigger4 = AnimElemTime(20) = 0
trigger5 = AnimElemTime(26) = 0
value = 0, 1

[State 1000, ボイス]
type = PlaySnd
trigger1 = Time = 1
value = 5, 1
channel = 0

[State 1000, 移動速度]
type = Velset
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(39) < 0
x = 9

[State 1000, VarSet]
type = VarAdd
trigger1 = MoveHit = 1
var(1) = 1

[State 1000, ヒット定義]
type = HitDef
trigger1 = P2MoveType != H
trigger1 = var(1) < 4
trigger1 = 1
attr = S, SA
damage    = 123,16
animtype  = Hard
guardflag = MA
hitflag = MA-
pausetime = 18,18
sparkno       = s7020
guard.sparkno = s7070
sparkxy = -10,-80
hitsound = s2,1
guardsound = s3,1
ground.type = High
ground.slidetime = 15
ground.hittime  = 16;36
ground.velocity = -12,0
air.type = Low
air.velocity = -4,-4 
ground.cornerpush.veloff = -22
guard.cornerpush.veloff = -22
ID = 1000

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = var(1) >= 4
value = 0
ctrl = 1

