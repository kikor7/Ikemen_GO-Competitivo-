
;---------------------------------------------------------------------------
; ここからは通常攻撃技のステート
;---------------------------------------------------------------------------
; 立ち弱パンチ(遠)

[Statedef 200]
type     = S
movetype = A
physics  = S
juggle   = 1
velset   = 0,0
ctrl     = 0
anim     = 200
poweradd = 0
sprpriority = 2

[State 200, varset]
type = varset
trigger1 = Time = 0
var(4) = 0

[State 200, varset]
type = varset
triggerall = var(59) = 0
triggerall = var(3) = 0
triggerall = p2bodydist X >= 30
trigger1 = Time >= 2
trigger1 = command = "x"
trigger1 = command != "holddown"
trigger1 = command != "holdup"
var(4) = 200

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 200, ヒット定義]
type = HitDef
trigger1 = Time = 0
attr = S, NA
damage = 106
getpower = 30,15
animtype = Light
guardflag = MA 
hitflag = MAF
pausetime = 14, 14
sparkno       = s7000
guard.sparkno = s7050
sparkxy = -10, -80
hitsound = s2,0
guardsound = s3,0
ground.type = High
ground.slidetime = 11
ground.hittime  = 12;28
ground.velocity = -12,0
air.type = Low
air.velocity = -4,-4
ground.cornerpush.veloff = -22
guard.cornerpush.veloff = -22

[State 200, varsetステート変更]
type = ChangeState
trigger1 = Time = 10
trigger1 = var(4) != 0
value = var(4)

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

