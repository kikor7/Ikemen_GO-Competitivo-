;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, 2]
type = PlaySnd
triggerall = Time = 1
triggerall = Life
triggerall = random % 10 > 5
trigger1 = stateno = 5000 || stateno = 5020
trigger1 = anim != 5000 && anim != 5010
trigger2 = stateno = 5010
trigger2 = anim != 5020
value = 22,0
channel = 0
ignorehitpause = 1
volume = 255

[State -3, 3]
type = PlaySnd
triggerall = Time = 45
trigger1 = anim = 5150
value = 25,0
channel = 0
volume = 255

[State -3, 4]
type = PlaySnd
triggerall = Time = 15
trigger1 = anim = 195
value = 0,0
channel = 0
volume = 255

[State -3, 5]
type = PlaySnd
triggerall = Time = 30
trigger1 = anim = 195
value = 28,0
channel = 0
volume = 255



