; Definition file for MARGE SIMPSON By WARNER
;  update 4 abril 2018

; Player information
[Info]
name = "marge"        ;Name of character
displayname = "Marge" ;Name of character to display
versiondate = 09,30,2009    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Warner"         ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
movelist = movelist.dat
cmd     = marge.cmd           ;Command set
cns     = marge.cns           ;Constants
st      = marge.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = marge.sff           ;Sprite
anim    = Marge.air           ;Animation
sound   = marge.snd           ;Sound
ai      = kfm.ai            ;AI hints data (not used)
pal1    = Marge5.act
pal2    = Marge4.act
pal3    = Marge3.act
pal4    = Marge.act
pal5    = Marge2.act
pal6    = Marge6.act

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
;x2 = 7 ;Hold Start and press button X for palette 7, etc.
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12


