type = Projectile
trigger1 = AnimElem = 3, = 1
attr = S, NP ;立ち通常飛び道具
damage = 72,5
getpower = 30,15
animtype = up
pausetime = 5,0
guard.pausetime = 8,0
sprpriority = -2
;-----------------------------------Projectile専用のパラメータ
offset = 50,0                ;飛び道具を発射する位置（Ｘ軸,Ｙ軸）
velocity = 2.5,0     ;飛び道具の移動速度（Ｘ軸,Ｙ軸）
accel = 0.1,0;0,0.4                  ;飛び道具の加速度(float)（Ｘ軸,Ｙ軸）
projID = 201                ;飛び道具のＩＤナンバー（NumProjIDなどで判断）
projanim = 201               ;飛び道具のアニメ（アクションナンバー）
projhitanim = 202             ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim = 202            ;飛び道具が消える時のアニメ（アクションナンバー）
projscale = 1,1               ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在２倍
projshadow = 0,0,0             ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits = 1                  ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime = 10                ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority = 999999999               ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime = -1;117            ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
guardflag = M
;hitflag = MA
priority = 5
sparkno = -1;s8003
sparkxy = 0, -35
guard.sparkno = s6002
hitsound = S40,3
guardsound = 6,0
ground.type = High
ground.slidetime = 8
ground.hittime = 8
ground.velocity = -2,-4
air.velocity = -2,-4
guard.velocity = -4
airguard.velocity = -4
air.animtype = up
air.juggle = 4 ;Projectileの場合はここで設定しないとヒットした時ジャグルが消費しない
p2stateno = 201


