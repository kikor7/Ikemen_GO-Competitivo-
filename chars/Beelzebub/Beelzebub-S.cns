trigger1 = time = 5
value = 40, 9


[State 1300, 飛び道具];HitDefに飛び道具専用のパラメータを加えたようなものが「Projectile」
type = Projectile
trigger1 = AnimElem = 4, = 1
attr = S, SP ;立ちヒッサツ飛び道具
damage = 32,16
getpower = 30,15
animtype = Hard
pausetime = 5,0
guard.pausetime = 8,0
sprpriority = -2
;-----------------------------------Projectile専用のパラメータ
offset = 130,-60                ;飛び道具を発射する位置（Ｘ軸,Ｙ軸）
velocity = 0,0     ;飛び道具の移動速度（Ｘ軸,Ｙ軸）
accel = 0,0;0,0.4                  ;飛び道具の加速度(float)（Ｘ軸,Ｙ軸）
projID = 1001                ;飛び道具のＩＤナンバー（NumProjIDなどで判断）
projanim = 1001               ;飛び道具のアニメ（アクションナンバー）
projhitanim = -1             ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim = -1            ;飛び道具が消える時のアニメ（アクションナンバー）
projscale = 1,1               ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在２倍
projshadow = 0,0,0             ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits = 999999                  ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime = 5                ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority = 999999999               ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime = 96;117            ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
guardflag = M
;hitflag = MA
priority = 5
sparkno = -1;s6001
sparkxy = 0, -20
guard.sparkno = s6002
hitsound = S80,0
guardsound = s7,1
ground.type = High
ground.slidetime = 8
ground.hittime = 8
ground.velocity = -2,-3
air.velocity = -2,-3
guard.velocity = -3
airguard.velocity = -3
air.animtype = hard
air.juggle = 4 ;Projectileの場合はここで設定しないとヒットした時ジャグルが消費しない
fall = 1
fall.recovertime = 20


[State 1000, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

