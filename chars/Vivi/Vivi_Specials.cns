y = 0.3


[state 410, Generador de var para activar el cambio de lugar]
type = varset
trigger1 = time = 0
trigger1 =((ScreenPos X)-(Helper(4000),ScreenPos X))< 0
fv = 38
value = 1


[State 410 ,cambio en referencia al var generado por el helper]
type = posadd
triggerall = time > 8
trigger1 = fvar(38) = 1
trigger1 = facing = 1
trigger1 = Helper(4000),facing = 1
trigger2 = fvar(38) = 1
trigger2 = facing = -1
trigger2 = helper(4000),facing = -1
x = -(fvar(39)/40)


[State 410 ,cambio en referencia al var generado por el helpe (pero del otro lado)]
