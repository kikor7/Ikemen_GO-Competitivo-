triggerall = time >= 8
trigger1 = fvar(38) = 0
trigger1 = facing = 1
trigger1 = Helper(4000),facing = 1
trigger2 = fvar(38) = 1
trigger2 = facing = 1
trigger2 = Helper(4000),facing = -1
trigger3 = fvar(38) = 0
trigger3 = facing = -1
trigger3 = Helper(4000),facing = -1
trigger4 = fvar(38) = 1
trigger4 = facing = -1
trigger4 = Helper(4000),facing = 1
x = (fvar(39)/40)

[State 200, End]
type = ChangeState
triggerall = time > 30
trigger1 = pos y > -10
value = ifelse(command = "hold_c", 1801,1840)
ctrl = 0





