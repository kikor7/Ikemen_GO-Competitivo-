;---------------------------------------------------------------------------
; Win pose 1 - Bow
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181,1]
type = AssertSpecial
triggerall= stateno=181
trigger1 = Time < 540
trigger1 = Roundstate=4
flag  = roundnotover
flag2 = timerfreeze
ignorehitpause=1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
