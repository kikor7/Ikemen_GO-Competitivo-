[state -2 , ゲージ最大値]
type = VarSet
trigger1 = var(50) > 1000
var(50) = 1000

[state -2];ゲージ増加(体力100～50%)
type = VarAdd
triggerall = Life >= 0.5*LifeMax
triggerall = stateno !=[3402,3409]
triggerall = Var(50) < 1000 
triggerall = RoundState = 2
trigger1 = time%3 = 0
v = 50
value = ifelse(palno = 12,4,1)
ignorehitpause = 1

[state -2];ゲージ増加(体力50～25%)
type = VarAdd
triggerall = Life >= 0.25*LifeMax
triggerall = Life <= 0.5*LifeMax
triggerall = stateno !=[3302,3309]
triggerall = Var(50) < 1000 
triggerall = RoundState = 2
trigger1 = time%3 = 0
v = 50
value = ifelse(palno = 12,8,2)
ignorehitpause = 1

[state -2];ゲージ増加(体力25%以下)
type = VarAdd
triggerall = PalNo != 12
triggerall = Life <= 0.25*LifeMax
triggerall = stateno !=[3302,3309]
triggerall = Var(50) < 1000 
triggerall = RoundState = 2
trigger1 = time%3 = 0
v = 50
value = 4
ignorehitpause = 1

[state -2];ゲージ増加(体力25%以下)
type = VarAdd
triggerall = PalNo = 12
triggerall = Life <= 0.25*LifeMax
triggerall = stateno !=[3302,3309]
triggerall = Var(50) < 1000 
triggerall = RoundState = 2
trigger1 = 1
v = 50
value = 20
ignorehitpause = 1

