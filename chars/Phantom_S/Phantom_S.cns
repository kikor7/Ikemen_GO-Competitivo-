trigger9 = Root,Command = "hammerB"
trigger10 = Root,Command = "hammerEX"
trigger11 = Root,Command = "twinripperA"
trigger12 = Root,Command = "twinripperB"
trigger13 = Root,Command = "twinripperEX"
