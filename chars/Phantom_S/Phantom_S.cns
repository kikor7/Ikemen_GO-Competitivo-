;============================================================
;先行入力受付ヘルパー ;Cns内のどこかに置く。末尾に置くと編集しやすい。
;============================================================
[StateDef 60000]
anim=9999;9999版に指定しているが攻撃判定、当たり判定の無いアニメなら何でもよい
ctrl=0

[State 60000 透明化]
type = assertspecial
trigger1 = 1
flag = invisible
flag2 = noshadow

[State 60000 無敵化]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1


[State 200, 1];下溜めリセット
type = varset
triggerall = parent,time=1
trigger1 = parent,stateno=1200||parent,stateno=1210||parent,stateno=1220
var(17) = 0
[State 200, 1]
type = varset
trigger1 = var(17)=0
var(16) = 0
[State 200, 1]
type = varadd
trigger1 = var(17)>0
var(17) = -1
[State 200, 1];下タメ成立からのコマンド入力猶予時間
type = varset
triggerall = parent,var(59)=0
trigger1 = root,command="holddown"&&(var(17)=0||var(17)>=5)
var(17) = 10
[State 200, 1];総下タメ時間
type = varadd
triggerall = parent,var(59)=0
trigger1 = root,command="holddown"&&var(17)>=5
var(16) = 1

[State -2]
type = DisplayToClipboard ;ステータス表示で見られる変数ディスプレイ　タメ時間の確認用「下タメ,横タメ」
trigger1 = 1
text = "%d,%d"
params = var(16),var(14)
ignorehitpause = 1

;================[コマンド入力];先行入力に対応させたい技をCMDファイル内の上にあるものから書いていく(Cns内の処理は上に記述してある物から優先される。)
