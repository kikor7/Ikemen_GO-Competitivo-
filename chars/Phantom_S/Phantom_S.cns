[State -2,ゲージ用ヘルパー]
type = Helper
Trigger1 = Numhelper(10000) = 0
helpertype = normal
ID = 10000
Stateno = 10000
pos = 0,0
PosType = p1
persistent = 0
facing = 1
keyctrl = 0
ownpal = 1

[State -2,先行入力受付ヘルパー呼び出し];StateDef -2に置く
type=helper
trigger1 = !Ishelper;自分がヘルパーではない時
trigger1 = Alive;自分が生きている時
trigger1 = RoundState < 3;イントロ～戦闘中
Trigger1 = !NumHelper(60000);先行入力ヘルパーが存在しない時
helpertype = normal
name="Cmd"
stateno=60000
ID=60000
pos=9999,9999
keyctrl=0
pausemovetime=2147483647
supermovetime=2147483647
ignorehitpause = 1

;念のため関係無いステートに行かないように↓も付けておく
[State -2, helper]
type = changestate
trigger1 = Ishelper(60000)
trigger1 = !(stateno = 60000)
value = 60000
ignorehitpause = 1

[State -2];12P専用強化モード
type = attackmulset
triggerall = 1
trigger1 = PalNo = 12
value = 2

[State -2];12P専用強化モード
type = defencemulset
triggerall = 1
trigger1 = PalNo = 12
value = 0.5

[State -2];12P専用強化モード
type = poweradd
triggerall = RoundState = 2
trigger1 = PalNo = 12
value = 3

[State -2];12P専用強化モード
type = NotHitBy
triggerall = PalNo = 12
trigger1 = stateno = [1020,1029]
trigger2 = stateno = [1120,1129]
trigger3 = stateno = [1220,1229]
trigger4 = stateno = [3000,3099]
trigger5 = stateno = [3100,3199]
trigger6 = stateno = [3200,3299]
trigger7 = stateno = [3300,3399]
value = SCA
time = 1

[State -2];12P専用強化モード
type = lifeadd
trigger1 = 1
trigger1 = PalNo = 12
trigger1 = GetHitVar(damage) >= 200
value = 0 + (GetHitVar(damage))

[State -2];12P専用強化モード
type = lifeadd
triggerall = movetype != H
triggerall = Life <= 0.24*LifeMax
trigger1 = PalNo = 12
value = 1

;---------------------------------------------------------------------------
;【デバック】
;相手がいっしょにとれーにんぐの場合スタートボタンで特殊ゲージＭＡＸ

[state -2];ゲージMAX
type = VarAdd
triggerall = P2Name = "Training"|| P2Name = "TRM Man"
triggerall = Var(50) < 1000 
trigger1 = command = "start"
v = 50
value = 1000

;---------------------------------------------------------------------------
;【演出設定】

[state -2];まっぷたつ演出スイッチ
type = varset
trigger1 = 1
v = 30
value = 1
;　　　↑ここの数字を変えることでシザースデストロイのまっぷたつ演出を変更可能。デフォルトはON(あり)
;　　　  0・・・OFF
;　　　  1・・・ON
;---------------------------------------------------------------------------
;【強化設定】

;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;-----------------------------------
;ここは「ジャンプ」か「バックステップ」をした後に
;着地する音を鳴らす設定をしています。

[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
value = 40, 0

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; ■最後に『コモンステート』について■
; コモンステートとは、全キャラ共通の基本動作のステートです。
; 通常は特に変更しない限り、M.U.G.E.N本体のdataフォルダにある
;「common1.cns（コモンステートファイル）」を使います。
;
; しかし、もしもあなたのキャラのステートファイルでcommon1.cnsと同じ番号の
; 基本動作のステートを作った場合は処理が上書きされ、
; common1.cns側の同じ番号のステートは無効になります。
;
; common1.cnsのプログラム優先度は最低に属しているので、
; ステートの作成には番号に注意しないといけません。
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
