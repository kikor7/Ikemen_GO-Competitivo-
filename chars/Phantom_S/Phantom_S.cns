;================[受付時間設定];コマンド入力受付時間を設定します
[State 60000,超必殺技入力受付]
type = VarSet
triggerall = !Var(1);入力受付時間がセットされていない時
trigger1 = Root,Command = "Phantomdance"
trigger2 = Root,Command = "crazyanker"
trigger3 = Root,Command = "thundernine"
trigger4 = Root,Command = "scissorsdestroy"
trigger5 = Root,Command = "guillotineA"
trigger6 = Root,Command = "guillotineB"
trigger7 = Root,Command = "guillotineEX"
