;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

; Super FX Section ==================================================



; Misc SCtrls Section ==================================================

[State -2, Damage based on hits]
type=varset
trigger1= numenemy
fvar(17)= enemynear,gethitvar(hitcount)
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type=varset
trigger1= numenemy
trigger1= (enemynear,movetype!=H)
trigger2= !numenemy
fvar(17)=1

[State -2, Dampener]
type=varset
trigger1=1
fvar(18)= ifelse(fvar(17)=0, 1, ifelse(fvar(17)=1, .9, .8**fvar(17)))
ignorehitpause=1

[State -2, Dampener itself]
type=attackmulset
trigger1= 1
value=fvar(18)
ignorehitpause=1

[State -2, Global Spam Reduction Var]
type = VarSet
trigger1=stateno=1000 || stateno=1010 || stateno=1020 || stateno=1300 || stateno=1307
trigger1 = time
var(26) = 50
ignorehitpause = 1

[State -2, Global Spam Reduction Var 2]
type = VarSet
trigger1=  Stateno=1080 || stateno=1308
trigger1 = time
var(27) = 70
ignorehitpause = 1

[State -2,Attack Time Var 2]
type = VarAdd
trigger1 = var(26) > 0
var(26) = -1
ignorehitpause = 1

[State -2,Attack Time Var 2]
type = VarAdd
trigger1 = var(27) > 0
var(27) = -1
ignorehitpause = 1

[State -2, Lie Down Snd]
type = PlaySnd
trigger1 = Time = 1
trigger1 = anim = 5300
value = 3,21
channel = 0

[State -2, Dash Onscreen if Offscreen]
type = Changestate
triggerall = Roundstate = [2,3]
trigger1 = Pos Y >= 0 && stateno != 100 && stateno != 101 && movetype != H && BackEdgeDist < -35
value = 101

[State -2, Let's Screen Bounding!]
type = ScreenBound
trigger1 = Var(10) = 1 && FrontEdgeBodyDist > 30
value = 0

[State -2, Aerial Rave now Ends. Bound.]
type = Varset
trigger1 = statetype != A && stateno != 52
trigger2 = movetype = H
var(10) = 0

[State -2, Variables Display]
type = DisplaytoClipboard
trigger1 = 1
text =  "Aerial Rave = %d, Spam Prevention = %d, Spam Prevention 2 = %d"
params = Var(10), Var(26), Var(27)
