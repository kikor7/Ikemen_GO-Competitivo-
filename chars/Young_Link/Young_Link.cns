ground.front = 20
air.back = 18
air.front = 22
height = 60
attack.dist = 160
attack.width = 4,4
proj.dist = 90
proj.attack.dist = 90 
proj.doscale = 0
head.pos = 0, -90
mid.pos = 0, -45
shadowoffset = 0
draw.offset = 0,0

[Velocity]
