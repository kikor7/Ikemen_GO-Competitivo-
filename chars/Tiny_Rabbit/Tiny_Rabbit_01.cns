;===============================================================================================================================================================
;===============================================================================================================================================================
;イントロヘルパー
;var(1)=本体ctrl開始
;var(2)=本体ctrl開始からの経過時間（開幕行動用）
;var(11)ステージ端右
;var(12)ステージ端左
;var(13)本体とステージ端との距離右
;var(14)本体とステージ端との距離左
;var(20)～(25)相手地上攻撃9F
;var(26)～(29)相手空中攻撃9F
;var(30)～(35)相手地上攻撃6F
;var(36)～(39)相手空中攻撃6F
;fvar(20)～(25)相手地上攻撃+hitshaketime30F
;fvar(26)～(29)相手空中攻撃+hitshaketime30F
;fvar(30)相手前ジャンプ回数 距離p2dist[150,170]
;fvar(31)相手前ジャンプ回数 距離p2dist[170,190]
;fvar(32)相手前ジャンプ回数 距離p2dist[190,210]
;fvar(33)相手前ジャンプ回数 距離p2dist[210,230]
[Statedef 25000]
anim = 20000
physics = N

[State 25000, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 25000,ぶつかり消し]
type = PlayerPush
trigger1 = 1
value = 0

[State 25000, 透明]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible
flag3 = noautoturn

[State 25000,位置固定]
type = PosFreeze
trigger1 = 1
value = 1

[State 25000,ラウンド開始]
type = varset
triggerall = roundState >= 2
triggerall = var(1) = 0
trigger1 = root,ctrl = 1
trigger2 = root,Stateno != 0
trigger2 = root,Stateno != 5900
trigger2 = root,Stateno !=[190,200]
ignorehitpause = 1
v = 1
value = 1

[State 25000,開始からの時間30fまで]
type = varadd
triggerall = roundState >= 2
triggerall = var(1) = 1
trigger1 = var(2) < 30
v = 2
value = 1

[State 25000,画面端調査ヘルパー右]
type = helper
trigger1 = var(11) = 0
trigger1 = numhelper(21000) = 0
name = "stage"
id = 21000
Stateno = 21000
pos = 160, 0
postype = left
facing = 1
supermovetime = 9999
pausemovetime = 9999
size.xscale = 0
size.yscale = 0
size.ground.back = 0
size.ground.front = 0
size.air.back = 0
size.air.front = 0
size.height = 0
size.proj.doscale = 0
size.head.pos = 0, 0
size.mid.pos = 0, 0
size.shadowoffset = 0
ignorehitpause = 1

[State 25000,画面端調査ヘルパー左]
type = helper
trigger1 = var(12) = 0
trigger1 = numhelper(21001) = 0
name = "stage"
id = 21001
Stateno = 21000
pos = 160, 0
postype = left
facing = -1
supermovetime = 9999
pausemovetime = 9999
size.xscale = 0
size.yscale = 0
size.ground.back = 0
size.ground.front = 0
size.air.back = 0
size.air.front = 0
size.height = 0
size.proj.doscale = 0
size.head.pos = 0, 0
size.mid.pos = 0, 0
size.shadowoffset = 0
ignorehitpause = 1

[State 25000,本体と画面端との距離右]
type = varset
trigger1 = var(11) != 0
v = 13
value = floor(var(11) - ParentDist x)

[State 25000,本体と画面端との距離左]
type = varset
trigger1 = var(12) != 0
v = 14
value = floor(var(12) + ParentDist x)

