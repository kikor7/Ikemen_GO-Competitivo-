;====================================================================================;====================================================================================
;■ヘルパー■
;====================================================================================
;アーマーヘルパー
;var(1)=ヒットストップ
;var(2)=攻撃くらい時animelemno
[Statedef 26000]
type = S
movetype= I
physics = N

[State 26000,ぶつかり消し]
type = PlayerPush
trigger1 = 1
value = 0

[State 26000, 透明]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible
flag3 = noautoturn

[State 26000,本体の動きをトレース]
type = ChangeAnim
trigger1 = 1
value = parent,Anim
elem = parent,AnimElemNo(0)
ignorehitpause = 1

[State 26000,本体に固定]
type = BindToRoot
trigger1 = 1
facing = 1
ignorehitpause = 1

[State 26000,投げ無敵]
type = NotHitBy
trigger1 = 1
value = ,AT

[State 26000,攻撃くらい後無敵]
type = NotHitBy
trigger1 = AnimElemNo(0) = var(2)
value = SCA,AA,AP,AT
time = 1
ignorehitpause = 1

[State 26000,攻撃くらいへ]
type = HitOverride
trigger1 = 1
time = -1
attr = SCA,AA,AP
Stateno = 26100
ignorehitpause = 1

[State 26000,ヒットストップ減少]
type = Varadd
trigger1 = var(1) > 0
v = 1
value = -1
ignorehitpause = 1

[State 26000,死亡無敵]
type = NotHitBy
trigger1 = root,alive = 0
value = SCA,AA,AP,AT

[State 26000,消滅]
type = DestroySelf
triggerall = root,alive || root,time > 2
trigger1 = root,Stateno != [570,572]
trigger2 = root,stateno = 572
trigger2 = root,animelemtime(5) > 0
;================================================================================
;================================================================================
;アーマーヘルパーくらい
[Statedef 26100]
type = S
movetype= H
physics = N

[State 26000,無敵]
type = NotHitBy
trigger1 = 1
value = SCA,AA,AP,AT
time = 3
ignorehitpause = 1

[State 26100,ヒットストップ格納]
type = Varset
trigger1 = time = 0
v = 1
value = GetHitVar(hitshaketime)-1
ignorehitpause = 1
persistent = 0

[State 26100,アニメ番号格納]
type = Varset
trigger1 = time = 0
v = 2
value = root,animelemno(0)
ignorehitpause = 1
persistent = 0

[State 26100,ゲージ増加]
type = Poweradd
trigger1 = time = 0
value = GetHitVar(damage)
ignorehitpause = 1

[State 26100,基本へ]
type = SelfState
trigger1 = time = 0
value = 26000
ignorehitpause = 1
;===============================================================================================================================================================
;===============================================================================================================================================================
;背後監視ヘルパー
;v1:rootの真近に居る敵のID
[Statedef 20000]
anim = 20000
physics = N

[State 20000, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 20000,ぶつかり消し]
type = PlayerPush
trigger1 = 1
value = 0

[State 20000, 透明]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible
flag3 = noautoturn

[State 20000,前方近くにいる敵IDe0敵一体]
type = Varset
trigger1 = numenemy = 1
v = 1
value = enemy(0),ID
ignorehitpause = 1

[State 20000,前方近くにいる敵IDe0敵複数]
type = Varset
triggerall = numenemy >= 2
triggerall = enemy(0),alive
trigger1 = enemy(1),alive = 0
trigger2 = enemy(1),alive
trigger2 = (root,fvar(3) > 0) && (root,fvar(4) > 0) && (root,fvar(3)<root,fvar(4))
trigger3 = enemy(1),alive
trigger3 = (root,fvar(3) < 0) && (root,fvar(4) < 0) && (root,fvar(3)>root,fvar(4))
trigger4 = enemy(1),alive
trigger4 = (root,fvar(3) > 0) && (root,fvar(4) < 0) && (root,fvar(3)+root,fvar(4))<0
trigger5 = enemy(1),alive
trigger5 = (root,fvar(3) < 0) && (root,fvar(4) > 0) && (root,fvar(3)+root,fvar(4))>0
v = 1
value = enemy(0),ID
ignorehitpause = 1

[State 20000,前方近くにいる敵IDe1敵複数]
type = Varset
triggerall = numenemy >= 2
triggerall = enemy(1),alive
trigger1 = enemy(0),alive = 0
trigger2 = enemy(0),alive
trigger2 = (root,fvar(4) > 0) && (root,fvar(3) > 0) && (root,fvar(4)<root,fvar(3))
trigger3 = enemy(0),alive
trigger3 = (root,fvar(4) < 0) && (root,fvar(3) < 0) && (root,fvar(4)>root,fvar(3))
trigger4 = enemy(0),alive
trigger4 = (root,fvar(4) > 0) && (root,fvar(3) < 0) && (root,fvar(4)+root,fvar(3))<0
trigger5 = enemy(0),alive
trigger5 = (root,fvar(4) < 0) && (root,fvar(3) > 0) && (root,fvar(4)+root,fvar(3))>0
v = 1
value = enemy(1),ID
ignorehitpause = 1

[State 20000,本体の後ろに固定]
type = BindToRoot
triggerall = playerIDexist(var(1))
trigger1 = root,facing != playerID(var(1)),facing
time = 1
facing = 1
pos = -30, 0
;rootが近くの敵と向きが逆

[State 20000,本体に固定]
type = BindToRoot
triggerall = playerIDexist(var(1))
trigger1 = root,facing = playerID(var(1)),facing
time = 1
facing = -1
pos = 60, 0
;rootが近くの敵と同じ向き

[State 20000,勝利敗北で消滅]
type = DestroySelf
trigger1 = win
trigger2 = lose
ignorehitpause = 1
;===============================================================================================================================================================
;===============================================================================================================================================================
;前方監視ヘルパー
;var(2)=PlayerID(root,var(40))攻撃Stateno
;var(53)=root防御時間
[Statedef 20100]
anim = 20000
physics = N

[State 20100, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 20100,ぶつかり消し]
type = PlayerPush
trigger1 = 1
value = 0

[State 20100, 透明]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible
flag3 = noautoturn

[State 20100,本体に固定]
type = BindToRoot
trigger1 = 1
time = 1
facing = 1
pos = 40, 0

[State 20100,勝利敗北で消滅]
type = DestroySelf
trigger1 = win
trigger2 = lose
ignorehitpause = 1

[State 20100,ガード時の敵ステートセット]
type = varset
triggerall = root,Stateno = 150 || root,Stateno = 152
triggerall = root,time = [0,1]
triggerall = PlayerIDExist(root,var(40))
triggerall = playerID(root,var(40)),movetype= A
trigger1 = (playerID(root,var(40)),HitDefAttr = SCA,NA,SA)
v = 2
value = playerID(root,var(40)),Stateno
ignorehitpause = 1

[State 20100,ガード時の敵ステートリセット]
type = varset
triggerall = PlayerIDExist(root,var(40))
triggerall = var(2) != 0
triggerall = playerID(root,var(40)),Stateno != var(2)
trigger1 = (root,stateno != 151)&&(root,stateno != 153)
trigger2 = (root,stateno = 151)||(root,stateno = 153)
trigger2 = time > 100
v = 2
value = 0
ignorehitpause = 1


[State 20100,本体防御時間増加]
type = varadd
trigger1 = root,movetype = H
v = 53
value = 1

[State 20100,本体防御時間減少]
type = varadd
trigger1 = var(53) > 0
trigger1 = root,ctrl = 1 || (root,Stateno =[10000,10021])
v = 53
value = -1

[State 20100,本体防御時間リセット]
type = varset
trigger1 = var(53) != 0
trigger1 = root,movetype =A
v = 53
value = 0
ignorehitpause = 1

;===============================================================================================================================================================
;===============================================================================================================================================================
;AI起動ヘルパー
;var(1)=本体command = command
[Statedef 20200]
anim = 20000
physics = N
ctrl = 0

[State 20200, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 20200,ぶつかり消し]
type = PlayerPush
trigger1 = 1
value = 0

[State 20200, 透明]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible
flag3 = noautoturn

[State 20200,本体に固定]
type = BindToRoot
trigger1 = 1
time = 1
facing = 1
pos = 0, 0

[State 20200,command合致]
type = Varset
trigger1 = (root,command = "a") && (command ="a")
trigger2 = (root,command = "b") && (command ="b")
trigger3 = (root,command = "c") && (command ="c")
trigger4 = (root,command = "x") && (command ="x")
trigger5 = (root,command = "y") && (command ="y")
trigger6 = (root,command = "z") && (command ="z")
trigger7 = (root,command = "start") && (command ="start")
v = 1
value = -1

[State 20200,command]
type = Varset
triggerall=var(1)!=-1
trigger1 = (root,command = "a")
trigger2 = (root,command = "b")
trigger3 = (root,command = "c")
trigger4 = (root,command = "x")
trigger5 = (root,command = "y")
trigger6 = (root,command = "z")
trigger7 = (root,command = "start")
v = 1
value = 1

[State 20200,AIon]
type = ParentVarset
trigger1 = root,var(59)<=1
trigger1 = var(1) = 1
v = 59
value = 2

[State 20200,消滅]
type = DestroySelf
triggerall = roundState >=2
trigger1 = root,var(59)>=2
trigger2 = var(1) = -1


;===============================================================================================================================================================
;===============================================================================================================================================================
;ステージ端調査ヘルパー
[Statedef 21000]
anim = 20000
physics = N

[State 21000, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 21000,ぶつかり消し]
type = PlayerPush
trigger1 = 1
value = 0

[State 21000, 透明]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible
flag3 = noautoturn

[State 21000,移動]
type = Velset
trigger1 = time = 0
x = 20
ignorehitpause = 1

[State 2100,Atackdist]
type = Attackdist
trigger1 = 1
value = 0

[State 21000,調査ビーム右]
type = Projectile
trigger1 = time = 0
trigger1 = facing = 1
projID = 21000
projanim = 20000
velocity = 20, 0
projedgebound = 5000
projstagebound = 0
projheightbound = -600, 300
postype = p1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1
attr = A,NT
hitflag = F-
guardflag = MA
guard.dist = 0

[State 21000,調査ビーム左]
type = Projectile
trigger1 = time = 0
trigger1 = facing = -1
projID = 21001
projanim = 20000
velocity = 20, 0
projedgebound = 5000
projstagebound = 0
projheightbound = -600, 300
postype = p1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1
attr = A,NT
hitflag = F-
guardflag = MA
guard.dist = 0

[State 21000,ビームが消えたら親の変数変更右]
type = Parentvarset
trigger1 = time > 0
trigger1 = root,numprojID(21000) = 0
trigger1 = facing = 1
v = 11
value = floor(ParentDist x * -1)
ignorehitpause = 1

[State 21000,ビームが消えたら親の変数変更左]
type = Parentvarset
trigger1 = time > 0
trigger1 = root,numprojID(21001) = 0
trigger1 = facing = -1
v = 12
value = floor(ParentDist x * -1)
ignorehitpause = 1

[State 21000,通常消滅]
type = DestroySelf
triggerall = time > 0
trigger1 = facing = 1 && root,numprojID(21000) = 0
trigger2 = facing = -1 && root,numprojID(21001) = 0
ignorehitpause = 1
