;====================================================================================
;■立ち攻撃■
;====================================================================================
;立ちP弱
[Statedef 500]
type = S
movetype= A
physics = S
anim = 500
poweradd = 0
juggle = 1
ctrl = 0
sprpriority = 2

[State 500,スイング音]
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
value = 400,random%4
volume = 0

[State 500,敵LIFE記憶]
type = varset
triggerall = AnimElemtime(4) = 0
trigger1 = PlayerIDExist(var(40))
fv = 9
value = playerID(var(40)),life
persistent = 0

[State 500,ヒット定義]
type = HitDef
trigger1 = AnimElemTime(4) = 0
attr = S, NA
damage = 18, 0
animtype = Light
air.animtype = back
fall.animtype = back
guardflag = M
hitflag = MAF
priority = 3, Hit
pausetime = 9, 9+var(58)
sparkno = -1
guard.sparkno = -1
sparkxy = -15 , -83
hitsound = s800,random%4
guardsound = 6, 0
ground.type = High
ground.slidetime = 11
ground.hittime  = 11
ground.velocity = -4
guard.ctrltime = 11
guard.velocity = -4
air.type = High
air.hittime = 11
air.velocity = -4,-3+ifelse((var(4)>10),((var(4)-10)*0.1),0)
airguard.velocity = -4,-1
fall.recover = 0
fall.recovertime = 11
yaccel = 0.5
fall.yvelocity=-4.5
air.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
getpower = 30,15
GivePower = 15, 30
ID = 500
nochainID = var(7)
guard.dist = 70

[State 500,コンボ数増加]
type = varadd
trigger1 = movehit = 1
trigger1 = numtarget(500) > 0
trigger1 = target(500),Stateno = [5000,5100]
v = 4
value = 1
persistent = 0
ignorehitpause = 1

[State 500,ヒットエフェクト]
type = Explod
trigger1 = movehit = 1
trigger1 = numtarget(500)
anim = 3000 + random%8
ID = 3000
pos = floor(ifelse(facing=1,(target(500),screenpos x-screenpos x),(screenpos x-target(500),screenpos x))), -57
postype = p1
bindtime = 1
removetime = -2
scale = 0.4, 0.4
sprpriority = 3
ownpal = 1
supermovetime  = 9999
pausemovetime  = 9999
removeongethit = 0
ignorehitpause = 1
persistent = 0

[State 500,ヒットエフェクト]
type = Explod
trigger1 = movehit = 1
trigger1 = numtarget(500) = 0
trigger1 = anim = 500
trigger1 = AnimElemTime(4) >= 0
anim = 3000 + random%8
ID = 3000
pos = 45, -57
postype = p1
bindtime = 1
removetime = -2
scale = 0.4, 0.4
sprpriority = 3
ownpal = 1
supermovetime  = 9999
pausemovetime  = 9999
removeongethit = 0
ignorehitpause = 1
persistent = 0

[State 500,ガードエフェクト]
type = Explod
trigger1 = MoveGuarded = 1
trigger1 = numtarget(500)
anim = 3100
ID = 3100
pos = floor(ifelse(facing=1,(target(500),screenpos x-screenpos x),(screenpos x-target(500),screenpos x))), -57
postype = p1
bindtime = 1
removetime = -2
scale = 0.5, 0.5
sprpriority = 3
ownpal = 1
supermovetime  = 9999
pausemovetime  = 9999
removeongethit = 0
ignorehitpause = 1
persistent = 0

[State 500, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
