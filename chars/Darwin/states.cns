; States
;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
anim = 170
velset = -5,0
ctrl = 0

[State 170, PlaySnd]
type = PlaySnd
trigger1 = time=0
value = S170,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, DestroySelf]
type = DestroySelf
trigger1 = time=215


;---------------------------------------------------------------------------
; Win Pose
[Statedef 180]
type = S
anim = 180
velset = 0,0
ctrl = 0

[State 180, 0]
type = AssertSpecial
trigger1 = Time < 150
flag = RoundNotOver

[State 180, 0]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, 1]
type = VarRandom
trigger1 = Time <= 0
v = 0
range = 0,2

[State 180, 2]
type = VarSet
trigger1 = Time <= 0
trigger1 = command = "hold_a"
var(0) = 0

[State 180, 2]
type = VarSet
trigger1 = Time <= 0
trigger1 = command = "hold_b"
var(0) = 1

[State 180, 2]
type = VarSet
trigger1 = Time <= 0
trigger1 = command = "hold_c"
var(0) = 2

[State 180, 3]
type = ChangeState
trigger1 = Time <= 0
trigger1 = Var(0) > 0
value = 180 + Var(0)

[State 180,PlaySnd]
type= PlaySnd
trigger1=AnimElem=1
value=180,0


