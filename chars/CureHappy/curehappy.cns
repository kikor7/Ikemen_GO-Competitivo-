;ブロッサムダブルインパクト：成功（放り投げる）
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 805
poweradd = 0

[State 1905, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP

[State 810, 変数];「holdfwd」のコマンドが入力されているかどうかを判断する
type = VarSet
trigger1 = Time = 0
var(2) = command = "holdfwd"

[State 810, 音を鳴らす];掴み用
type = PlaySnd
trigger1 = AnimElem = 1;2
value = 1, 1

[State 810, 音を鳴らす];パンチヒット音
type = PlaySnd
trigger1 = AnimElem = 2
trigger2 = AnimElem = 6
value = 5, 4

[State 810, 音を鳴らす];ダブルイインパクトヒット音
type = PlaySnd
trigger1 = AnimElem = 12
value = 5, 4

[State 3004, EnvShake]
type	= EnvShake
trigger1= AnimElem = 2;AnimElemTime(4) >= 0 && AnimElemtime(5) < 15
time	= 10;15;8
ampl	= 5
persistent = 0

[State 3004, EnvShake]
