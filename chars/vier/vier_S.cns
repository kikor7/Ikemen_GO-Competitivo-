;===========================================================================
; 必殺技
;===========================================================================
;必殺技を使った瞬間にいくらかゲージ回収（ニトブラ式）。
;ニトブラ式より空振りの回収量は多いがヒットまでさせての回収量はあちらの方が上（こっちが10回ヒット1ゲージ程度でむこうは6回ヒット。回収少なめでも9回ヒットで到達）
;空振りの場合ニトブラは30回、多いものは60回とかだがこちらは21回程度空振りで1ゲージ到達する。
;hitdefのgivepower,getpowerは基本的にデフォルトに任せる。問題があれば正式版で定義せよ。デフォルトはdamage*0.7がget,damage*0.6がgive

;多段技の補正はhitdefの上に置くこと(補正が正しくかからないときがあるため)

;波動a（必殺技）補正まだ
[Statedef 1000]
type    = S
movetype= A
physics = S
poweradd= 20
velset = 0,0
anim = 1000
ctrl = 0
sprpriority = 2
;facep2   = 1


[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 8
value = 190, 4

[State 1000, Helper]
type = Helper
trigger1 = animelem = 8
helpertype = normal ;player
name = "a_canon"
ID = 1001
stateno = 1001
pos = 40,-20
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 0
pausemovetime = 0
ignorehitpause = 1

;射出後はattackdistを切り、カウンターヒットのリスクを保持せよ
[State 1000, 攻撃範囲]
Type     = AttackDist
Trigger1 =  animelemtime(9) >= 0
value    = 0


[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
;a砲(ヘルパー)
[Statedef 1001]
type     = A
movetype = A
physics  = A
juggle   = 4
velset   = 9.6,-2.4
ctrl     = 0
anim     = 1001
poweradd = 0
sprpriority = 3



[State 1001, ガード距離]
type = AttackDist
trigger1 = 1
value = 96

;飛び道具にのみくらいが反応する
[State 1001, 指定技のみヒット]
type = hitby
trigger1 = 1
value = SCA,AP
time = 1
ignorehitpause = 1

;補正
[State 1001, VarSet]
type = parentVarSet
trigger1 = movehit=1
fv = 1
value = Ifelse(root,fvar(1)=1,0.70,root,fvar(1)*0.80)
ignorehitpause = 1
persistent = 0

;ノックバック補正
[State 1001, varset]
type=Varset
TriggerAll = StateNo = [200,2999];超必以外の時にカウントするよ
Trigger1 = MoveHit = 1 
fv=2
Value = ifelse(var(3)=1,fvar(2)+0.09,fvar(2)+0.16);相手のHit*0.2の補正をかけるよ
IgnoreHitPause = 1
persistent= 0

[State 1001, ヒット定義]
type = HitDef
trigger1 = time = 0
attr              = S, SP
damage            = ceil(60*root,fvar(1)*root,fvar(3)),ceil(6*root,fvar(1)*root,fvar(3))
getpower = 30,15
animtype          = Hard
hitflag           = MAF
guardflag         = MA
priority          = 4,Hit
pausetime         = 6,6
sparkno = s7000
sparkxy = 0,-20
guard.sparkno     = 40
hitsound = s241,0
guardsound = s150,0
ground.type       = High
ground.slidetime = 15
ground.hittime  = 16
guard.hittime = 12
guard.ctrltime= 11
guard.slidetime = 10
Fall.RecoverTime = 20
air.hittime = 19
ground.velocity   = -8-fvar(2),0
guard.velocity = -6-fvar(2)
air.type          = High
air.velocity      = -4,-3+fvar(2)
airguard.velocity = -4.8,-1.6+fvar(2)
yaccel=0.32
Fall = 0
;Air.Fall = 1





[State 1001]
type = HitOverride
trigger1 = time = 0
attr = SCA,AA,AP,AT
stateno = 1022
time = -1

[State 1001]
type = ChangeState
triggerall = Numhelper(1001) >= 1;最低条件ヘルパーあるか
trigger1 = movecontact;攻撃が当たったら
trigger2 = pos y>-8
trigger3 = parent,movetype = H
trigger3 = parent,stateno != [120,155]
;trigger3 = parent,stateno = [5000,5999]
value = 1022


