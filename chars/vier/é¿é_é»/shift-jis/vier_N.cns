; 通常技はそんなに難しいテクニックは使ってないから、
; テンプレートを見ながら確認すれば覚えやすいと思う。
; 基本忘るべからず。
;
; ステートナンバーは、立ち技が２００～２９９、しゃがみ技が４００～４９９、
; ジャンプ技が６００～６９９の間で決めて作るのが一般的。
; しかし強制じゃないので自由に作っちゃってＯＫ。
;---------------------------------------------------------------------------
;===========================================================================
; 通常攻撃技
;===========================================================================

;5A
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 200
sprpriority = 2;表示した絵の重なり具合(2一番前　0通常　-1奥)
facep2 = 1

[State 200, 音を鳴らす]
type = PlaySnd
;腕を振った瞬間軽い音がなる(kfm)
trigger1 = Time = 1
value = 0, 0

[State 200, ヒット定義]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA ;立ち通常打撃（Standing, Normal Attack）
damage = ceil(23*fvar(1)*fvar(3)), ceil(0*fvar(1)*fvar(3))
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
sparkno = random%2
sparkxy = -10, -76
hitsound = s201, random%2
guardsound = s150, 0
ground.type = low
pausetime = 8,8 
ground.slidetime = 9
ground.hittime  = 10
guard.hittime = 7
guard.ctrltime= 6
ground.velocity = -4-fvar(2),0
Fall.RecoverTime = 20
air.hittime = 19
airguard.velocity = -2.0,-0.8+fvar(2)
air.type = low
air.velocity = -1.4,-3
yaccel=0.36
Fall = 0
;Air.Fall = 1

;硬直中はmovetype=Aを切ってね
[state 200]
type = statetypeset
trigger1 = animelemtime(3) >= 0
movetype = I

;コンボ補正
[State 200, VarSet]
type = VarSet
trigger1 = movehit = 1
fv = 1
value = Ifelse(fvar(1)=1,0.78,fvar(1)*0.88)
ignorehitpause = 1
persistent = 0

;ノックバック補正
[State 200, varset]
type=Varset
TriggerAll = StateNo = [200,2999];超必以外の時にカウントするよ
Trigger1 = MoveHit = 1 
fv=2
Value = ifelse(var(3)=1,fvar(2)+0.14,fvar(2)+0.24);相手のHit*0.2の補正をかけるよ
IgnoreHitPause = 1 
persistent= 0



[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 200, ステート変更];ジャンプキャンセル
type = ChangeState
triggerall = var(59)=0;AIがこれ使わないようにしろ
triggerall = command = "holdup"
trigger1 =  (stateno = 200) && MoveHit=[1,8]
value = 40

;---------------------------------------------------------------------------
; 下の「立ち強パンチ」のステートを見てみましょ。
;
;「Width」のコントローラは相手や画面端を押すための『物理的な幅』を
; 一時的に伸ばしたり縮ませたりする命令。
; キャラの幅はバトル中に「Ctrl+C」を押して「判定ボックス」を表示させてる時に
; 一緒に確認出来る。「軸位置から伸びる黄緑色の線」がその幅。
;
; 後は「ChangeAnim」を使って５枚目で攻撃を当てたらすぐに６枚目に
; コマを進ませる命令をしてたり、
;『画像表示優先度』で「振りかぶる時は奥」「振り切った直後から手前」に
; モーション表示の操作をしてるくらいで、難しくない処理。
;
; これは余談だけど、Widthの読み方は「ウィッズ」。
; この解説文書いた時に初めて読み方知ったよ！　｡ﾟ(ﾟつД`ﾟ)ﾟ｡
;---------------------------------------------------------------------------

;5B
[Statedef 210]
type    = S
movetype= A
physics = S
juggle  = 0
ctrl = 0
velset = 0,0
anim = 210
sprpriority = 2


[State 210, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 2
value = 0, 1

[State 210, ヒット定義一段]
type = HitDef
trigger1 = AnimElem = 3
attr = S, NA
animtype  = Medium
damage    = ceil(33*fvar(1)*fvar(3)),ceil(0*fvar(1)*fvar(3))
guardflag = MA
pausetime = 8,8
sparkno = 1
sparkxy = -10,-70
hitsound   = s231,random%3
guardsound = s150,1
ground.type = High
ground.slidetime = 11
ground.hittime  = 12
guard.hittime = 10
guard.ctrltime= 9
ground.velocity = -8-fvar(2)
air.velocity = -2.0,-3+fvar(2)
yaccel=0.36
air.hittime = 19
fall.recovertime=20
Fall = 0
;Air.Fall = 1

[State 210, ヒット定義二段]
type = HitDef
trigger1 = AnimElem = 4
attr = S, NA
animtype  = Medium
damage    = ceil(50*fvar(1)*fvar(3)),ceil(0*fvar(1)*fvar(3))
guardflag = MA
pausetime = 9,9
sparkno =3
sparkxy = -10,-70
hitsound   = s231,3
guardsound = s150,1
ground.type = High
ground.slidetime = 13
ground.hittime  = 14
guard.hittime = 9
guard.ctrltime= 8
ground.velocity = -8-fvar(2)
air.velocity = -1,-4+fvar(2)
yaccel=0.32
air.hittime = 31
fall.recovertime=32
Fall = 0
;Air.Fall = 1

;硬直中はmovetype=Aを切ってね
[state 210]
type = statetypeset
trigger1 = animelemtime(5) >= 0
movetype = I


;コンボ補正
[State 210, VarSet]
type = VarSet
Trigger1 = MoveHit = 1
fv = 1
value = Ifelse(fvar(1)=1,0.85,fvar(1)*0.90)
ignorehitpause = 0
persistent = 1


;ノックバック補正
[State 210, varset]
type=Varset
TriggerAll = StateNo = [200,2999];超必以外の時にカウントするよ
Trigger1 = MoveHit = 1 
fv=2
Value = ifelse(var(3)=1,fvar(2)+0.09,fvar(2)+0.16);相手のHit*0.2の補正をかけるよ
IgnoreHitPause = 0 
persistent= 1


[State 210, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


[State 210, ステート変更];ジャンプキャンセル
type = ChangeState
triggerall = var(59)=0;AIがこれ使わないようにしろ
triggerall = command = "holdup"
trigger1 = (stateno = 210) && MoveHit=[1,8] 
trigger1 = (stateno = 210)&& AnimElem = 4 >=1
value = 40

;---------------------------------------------------------------------------
