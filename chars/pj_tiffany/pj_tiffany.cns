


; Rival Schools/Project Justice - Tiffany Lords CNS

;----------------------------------------------------------
;       Índice de Variáveis
;----------------------------------------------------------
; Var(1)  = Winstate Decider
; var(2)  = Light/Medium/Strong Attacks
; var(3)  = Groove Punch Strenght Controller
; var(4)  = Exciting Kick hits Controller
; var(5)  =
; var(6)  =
; var(7)  = Tardy Counter Controller
; var(8)  =
; var(9)  =
; var(10) = Just Defence Controller
; var(11) =
; var(12) =
; var(13) =
; var(14) = 
; var(15) = 
; var(16) = 
; var(17) = Long Jump Controler
; var(18) =
; var(53) = Special winposes
; var(54) = Mode Select Side
; var(55) = Mode
; var(56) = used by the XOR-ed commands method to detect recent custom states.
; var(57) = the GameTime variable, required by the helper and XOR methods.
; var(58) = the primary AI variable.


; fvar(6)  = Tardy Counter Controller (X Air Velocity)
; fvar(7)  = Tardy Counter Controller (Y Air Velocity)



[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 50
FloatPersistIndex = 40

[Size]
xscale = 1           
yscale = 1
ground.back = 18
ground.front = 18
air.back = 12        
air.front = 12       
height = 60          
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = -8,-90
mid.pos = -7,-62
shadowoffset = 0     
draw.offset = 0,0    

[Velocity]
walk.fwd  = 3
walk.back = -2.5
run.fwd  = 5.2,0
run.back = -4.5,-3.8 
jump.neu = 0,-9.4
jump.back = -3.05
jump.fwd = 3
runjump.back = -4.5,-9.1
runjump.fwd = 4.5,-9.1
airjump.neu = 0,-8.1      
airjump.back = -2.55      
airjump.fwd = 2.5         

[Movement]
airjump.num = 0      
airjump.height = 35  
yaccel = .47
stand.friction = .85  
crouch.friction = .82

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

;RS  = 1
;RS2 = 2
;MJ  = 3
;EX  = 4

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10
velset = 0,0

[State 10, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0
velset = 0,0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12
velset = 0,0

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && Time > 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && Time > 0
value = 21


;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
velset = 0,0

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VarSet
triggerall = command = "longjump"  || prevstateno = 730
trigger1 = !time
trigger2 = var(0)
trigger2 = P2Bodydist x > 65
var(17) = 1

[State 40, 5]
type = VelSet
triggerall = var(17)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1) = 0, const(velocity.jump.neu.x), ifelse(sysvar(1) = 1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))
y = const(velocity.jump.y)*1.1

[State 40, 6]
type = VelSet
triggerall = !var(17)
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
triggerall = prevstateno = 720
trigger1 = AnimTime = 0
x = const(velocity.jump.fwd.x)
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
triggerall = prevstateno = 730
trigger1 = AnimTime = 0
x = const(velocity.runjump.fwd.x)
y = const(velocity.jump.y)*1.1

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)
y = const(velocity.jump.y)*1.1

[State 40, 8]
type = Explod
trigger1 = Time = 1
anim = ifelse(sysvar(1)=0, 8070, ifelse(sysvar(1)=1, 8080, 8090))
ID = 8070
postype = p1
pos = 0,0
bindtime = 1
sprpriority = -1
ownpal = 1

[State 40, 9]
type = Playsnd
trigger1 = Time = 1
value = s4000, ifelse((prevstateno = 100 || var(17) = 1), 14, 13)

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 0]
type = VarSet
trigger1 = Time = 0
var(17) = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 4]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 5]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 6]
type = AfterImage
triggerall = vel y = const(velocity.jump.y)*1.1
trigger1 = time = 0
time = 9999
TimeGap  = 2
FrameGap = 3
length = 8
PalBright = 1,1,1
PalContrast = 120, 120, 120
PalAdd = 0,0,0
PalMul = .80,.80,.80
trans = add1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
velset = 0,0

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = ifelse((prevstateno = 600 && anim = 600), 48, 47)

[State 1210, 0]
type = varset
trigger1 = Time = 0
var(18) = 0

[State 52, 0]
type = AfterImageTime
trigger1 = Time = 0
time = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = Explod
trigger1 = Time = 0
anim = 8100
ID = 8100
postype = p1
pos = 3,0
bindtime = 1
sprpriority = -1
ownpal = 1

[State 52, 6]
type = RemoveExplod
trigger1 = time = 0
id = 3230
ignorehitpause = 1

[State 52, 7]
type = Playsnd
trigger1 = Time = 0
value = s4000,15

[State 52, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = Playsnd
trigger1 = time = 1
value = s4000,16

[State 100, 4]
type = Playsnd
trigger1 = animelem = 3
value = s4000,17

[State 100, 5]
type = Playsnd
trigger1 = animelem = 8
value = s4000,18

[State 100, 6]
type = Explod
trigger1 = Time = 1
Anim = 8110
ID = 8110
pos = 0, 3
postype = p1
ownpal = 1
bindtime = 1
pausemovetime = -1
supermove = 1
ignorehitpause = 1
sprpriority = 2

[State 100, 7]
type = ChangeState
trigger1 = command = "holdup"
value = 40

[State 100, 8]
type = ChangeState
triggerall = Time >= 5
trigger1 = command != "holdfwd"
value = 104
ctrl = 0

