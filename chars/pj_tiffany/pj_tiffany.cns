triggerall = var(55) = 4
triggerall = command = "Crouch Parry"
triggerall = statetype != A
trigger1 =  ctrl
trigger2 = stateno = [152,153]
trigger3 = stateno = 4100 || stateno = 4105
slot = 0
stateno = 4105
attr = C,AA,AP
time = ifelse((stateno = [4100,4105]),4,6)

[State -2, Air Parry]
type = HitOverride
triggerall = var(55) = 4
triggerall = command = "Parry"
triggerall = statetype = A
trigger1 = ctrl
trigger2 = stateno = [154,155]
trigger3 = stateno = 4110
slot = 0
stateno = 4110
attr = SCA,AA,AP
time = ifelse(stateno = 4110,4,6)

[State -2, VarAdd]
type = Varset
trigger1 = command = "Just Defend"
var(10) = 6

[State -2, VarAdd]
type = VarAdd
trigger1 = var(10)
v = 10
value = -1

[State -2, Just Defend]
type = ChangeState
triggerall = var(55) = 4
triggerall = statetype != A
triggerall = stateno = 150 && time = 0
trigger1 = var(10)
value = 4150
ctrl = 0

[State -2, Just Defend]
type = ChangeState
triggerall = var(55) = 4
triggerall = statetype != A
triggerall = stateno = 152 && time = 0
trigger1 = var(10)
value = 4155
ctrl = 0

[State -2, Just Defend]
type = ChangeState
triggerall = var(55) = 4
triggerall = statetype = A
triggerall = stateno = 154 && time = 0
trigger1 = var(10)
value = 4160
ctrl = 0

[State -2, Char side]
type = VarSet
trigger1 = var(54) = 0
var(54) = teamside

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 1500
ID = 1515

[State -2, RemoveExplod]
type = RemoveExplod
trigger1 = stateno != 3015
ID = 3015

[State -2, removeafterimage]
type = AfterImageTime
triggerall = Movetype = H  || ((prevstateno = [3000,3280]) && (stateno = [1000,1600]))
trigger1 = !Time = 0
time = 0

[State -2, AttackMulSet]
type = AttackMulSet
trigger1 = 1
value = ifelse(var(55) < 4, .75, .9)

[State -2, AttackMulSet]
type = AttackMulSet
triggerall = numhelper(4050)
trigger1 = 1
value = .7

[State -2, HitAdd]
type = HitAdd
triggerall = numtarget(3000)
trigger1 = target(3000), StateNo = 3070 && target(3000), time = 1
value = 1

