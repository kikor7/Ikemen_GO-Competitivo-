animtype  = Medium
damage    = 57
getpower = 20,10
guardflag = MA
pausetime = 12,12
sparkno = -1
guard.sparkno = -1
hitsound   = s1,1
guardsound = s1,10
ground.type = High
ground.slidetime = 12
ground.hittime  = 15
guard.ctrltime = 15
fall.recovertime = 15
ground.velocity = -5.5
air.velocity = -2.5,-4
kill = (numexplod(5) = 0)

