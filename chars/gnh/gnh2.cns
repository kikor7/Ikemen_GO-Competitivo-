fall = 1
fall.recover = 0
p2facing = 1
ID = 1000
envshake.time = 10
envshake.freq = 120
envshake.ampl =10
kill = (numexplod(5) = 0)
persistent= 1

[State 固定ダメージ分]
type = TargetLifeAdd
trigger1 = numtarget(1000) != 0
trigger1 = target(1000),gethitvar(damage) != 0
trigger1 = movehit >= 1
value = -44
ID = 1000
