fvar(1) = -(fvar(3)/10)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

;---------------------------------------------------------------------------
;キャンセル関連　　　　 /
;-----------------------
[State -2, 気合消費]
