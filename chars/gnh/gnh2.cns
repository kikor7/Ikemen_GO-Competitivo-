;/////////////////////////////////////////

;---------------------[ステート移行]
[state a]
type = ctrlset
trigger1 = (AnimElemTime (161) >= 0)
value = 1

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime >= 0
value = 0
ctrl = 1

;===============================================================
;;すごパ連打(特殊) 
;===============================================================
[Statedef 1130]
type    = S
movetype= A
physics = S
ctrl = 0
velset = 0,0
facep2   = 1
anim = 1130
poweradd = 20
sprpriority = 1

[State -2, 攻撃力下限保障]
type = AttackMulSet
trigger1 = 1
value = 1
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 1

;---------------------------------------------------------------------------
;気合ゲージ消費　　　　 /
;-----------------------
[State -2, 気合消費]
type = varadd
Trigger1 = time = 0
fvar(1) = -(fvar(3)/10)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

;---------------------------------------------------------------------------
;キャンセル関連　　　　 /
;-----------------------
[State -2, 気合消費]
type = varadd
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = var(11) <= 5 ;キャンセル前行動が現在の行動ランク以下
fvar(1) = -(var(10)*(5/var(11)))-((NumExplod(77) != 0)*(var(11))*5)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, 根性消費]
type = varadd
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = var(11) > 5 ;キャンセル前行動が現在の行動ランクより上
fvar(0) = -(var(10)*(var(11)/5))-((NumExplod(77) != 0)*(var(11))*5)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, 気合切れ]
type = varset
Trigger1 = time = 0
Trigger1 = (fvar(1) <= 0)&&(helper(7),NumExplod(7000) != 0)
fvar(1) = -fvar(3)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, 根性切れ]
type = varset
Trigger1 = time = 0
Trigger1 = (fvar(0) <= 0)&&(helper(7),NumExplod(7100) != 0)
fvar(0) = -fvar(3)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State 3000, 空キャン判定用蒼炎エフェ]
type = Explod
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = var(11) <= 5 ;キャンセル前行動が現在の行動ランク以下
Trigger1 = NumExplod(77) != 0;空キャン判定フラグあり
anim = (2200+(random >= 500)*5)
ID = 75
postype = P1
pos = 0,0
