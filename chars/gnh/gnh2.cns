projanim = 1160               ;飛び道具のアニメ（アクションナンバー）
projhitanim = -1;1155             ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim = -1             ;飛び道具が消える時のアニメ（アクションナンバー）
