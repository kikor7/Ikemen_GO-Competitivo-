hitflag = -MAF
priority = 3
sparkno = -1
guard.sparkno = -1
hitsound   = s1,(3+(random>= 500))
guardsound = s1,12
ground.type = low
ground.slidetime = 25
ground.hittime  = 25
guard.ctrltime = 15
ground.velocity = -8,0
air.velocity = -8,-1
air.hittime  = 25
yaccel = 0.4
air.fall = 1
fall.recover = 0
p2facing = 1
ID = 1130 
persistent= 1

