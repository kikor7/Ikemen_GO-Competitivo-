projscale = 0.5,0.5               ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在２倍
projshadow = 0,0,0             ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits = 1                   ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime = 1               ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority = 999999          ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime = 125            ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
guardflag = L
hitflag = MFD
affectteam = B
priority = 3
sparkno = -1;s6010
sparkxy = ceil(60*Const(size.xscale)),-ceil(135*Const(size.yscale))
guard.sparkno = 40
hitsound = s1,5
guardsound = s1,11
ground.type = low
ground.slidetime = 24
ground.hittime  = 20
ground.velocity = 0,0
ID = 1950
envshake.time = 20
envshake.freq = 120
envshake.ampl =10
kill = (numexplod(5) = 0)

[State 220, proj仕込みからの時間計測用]
type = Explod
Trigger1 = AnimElem = 29
anim = 1950
ID = 1950
postype = P1
pos = 0,0
facing = 1
vfacing= 1
scale =0.6*Const(size.xscale),0.9*Const(size.yscale)
bindtime = 1
removetime = -2
sprpriority = -2
ontop = 1
shadow = 0, 0, 0
Trans = add   ;Add ,None, Add1, Sub, AddAlpha
ownpal = 1
persistent= 0

;---------------------[ステート移行]
[state a]
type = ctrlset
trigger1 = (AnimElemTime (52) >= 0)
value = 1

[State 1200, ステート変更]
type = ChangeState
trigger1 = AnimTime >= 0
value = 0
ctrl = 1

