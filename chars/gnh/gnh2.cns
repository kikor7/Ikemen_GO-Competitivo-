;---------------------[攻撃判定]
[State 1000, ヒット定義]
type = HitDef
trigger1 = movecontact = 0
trigger2 = numtarget(1000) = 0
attr = S, SA
animtype  = back
damage    = 20+(time*2),10
priority = 5, Hit
getpower = 7,3
guardflag = M
hitflag = MAF
