;===========================================================================
; 必殺技
;===========================================================================
;すごいパンチ(物理)
[Statedef 1000]
type    = S
movetype= A
physics = N
velset = 0,0
ctrl = 0
facep2   = 1
anim = 1000
poweradd = 20
sprpriority = 1

[State -2, 攻撃力下限保障]
type = AttackMulSet
trigger1 = (0.1+(0.9*(fvar(1)/fvar(3))))*(0.8+(numtarget=0)*0.2-(prevstateno=stateno)*0.5)/(1+(NumExplod(14)!=0)) < 0.3+(time/850)*2
value = 0.3+(time/850)*2;最大溜めでゲージ版と同じ保障
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 1

;---------------------------------------------------------------------------
;気合ゲージ消費　　　　 /
;-----------------------
[State -2, 気合消費]
type = varadd
Trigger1 = time = 0
fvar(1) = -(fvar(3)/10)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

;---------------------------------------------------------------------------
;キャンセル関連　　　　 /
;-----------------------
[State -2, 気合消費]
type = varadd
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = var(11) <= 5 ;キャンセル前行動が現在の行動ランク以下
fvar(1) = -(var(10)*(5/var(11)))-((NumExplod(77) != 0)*(var(11))*5)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, 根性消費]
type = varadd
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = var(11) > 5 ;キャンセル前行動が現在の行動ランクより上
fvar(0) = -(var(10)*(var(11)/5))-((NumExplod(77) != 0)*(var(11))*5)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, 気合切れ]
type = varset
Trigger1 = time = 0
Trigger1 = (fvar(1) <= 0)&&(helper(7),NumExplod(7000) != 0)
fvar(1) = -fvar(3)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, 根性切れ]
type = varset
Trigger1 = time = 0
Trigger1 = (fvar(0) <= 0)&&(helper(7),NumExplod(7100) != 0)
fvar(0) = -fvar(3)
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State 3000, 空キャン判定用蒼炎エフェ]
type = Explod
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = var(11) <= 5 ;キャンセル前行動が現在の行動ランク以下
Trigger1 = NumExplod(77) != 0;空キャン判定フラグあり
anim = (2200+(random >= 500)*5)
ID = 75
postype = P1
pos = 0,0
facing = 1
vfacing= 1
scale = 1.5*Const(size.xscale),1.5*Const(size.yscale)
bindtime = -1
removetime = -2
removeongethit = 1
sprpriority = 7
ontop = 1
shadow = 0, 0, 0
Trans = add   ;Add ,None, Add1, Sub, AddAlpha
ownpal = 1
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0


[State 3000, 空キャン判定用赤炎エフェ]
type = Explod
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = var(11) > 5 ;キャンセル前行動が現在の行動ランクより上
Trigger1 = NumExplod(77) != 0;空キャン判定フラグあり
anim = (3200+(random >= 500)*5)
ID = 76
postype = P1
pos = 0,0
facing = 1
vfacing= 1
scale = 1.5*Const(size.xscale),1.5*Const(size.yscale)
bindtime = -1
removetime = -2
removeongethit = 1
sprpriority = 7
ontop = 1
shadow = 0, 0, 0
Trans = add   ;Add ,None, Add1, Sub, AddAlpha
ownpal = 1
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State 1000, 収束音]
type = PlaySnd
Trigger1 = time = 0
Trigger1 = var(10) != 0
Trigger1 = NumExplod(77) != 0;空キャン判定フラグあり
channel = 4
value = 2, 2200
volume = 128
persistent= 0

[State -2, 空キャン判定用エフェクト]
type = Explod
trigger1 = time = 0
anim = 7
ID = 77
postype = P1
pos = 0,0
facing = 1
vfacing= 1
scale = 1,1
bindtime = 1
removetime = -1
removeongethit = 1
sprpriority = 7
ontop = 1
shadow = 0, 0, 0
Trans = add   ;Add ,None, Add1, Sub, AddAlpha
ownpal = 1
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, 現在の行動ランクセット]
type = varset
Trigger1 = time = 0
var(11) = 5
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State -2, キャンセル回数カウント]
type = varadd
Trigger1 = time = 0
var(10) = 1
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

;---------------------------------------------------------------------------
;	       　　　　 /
;-----------------------



[State 1000, 収束音]
type = PlaySnd
trigger1 = Time = 0
channel = 2
value = 2, 1000
persistent= 0

[State 1000, 最大溜め爆発音]
type = PlaySnd
triggerall = (AnimElemTime (17) < 0)
trigger1 = time >= 77
channel = 2
value = 2, 1001
persistent= 0


[State 195, 声]
type = PlaySnd
triggerall = AnimElem = 10
trigger1 = command = "hold_x"
value = 5, 1000
channel = 0
persistent= 0


[State 1000, 突進音]
type = PlaySnd
trigger1 = animelem = 18
channel = 2
value = 2, 2
volume = -128
persistent= 0

;---------------------[タメ用アニメループ]
[State 1000, アニメループ]
type = ChangeAnim
trigger1 = command = "hold_x"
trigger1 = animelem = 16
value = 1000
elem = 6

;---------------------[タメ用根性消費]
[State -2, 根性ゲージ消費]
type = varadd
trigger1 = time >= 27
trigger1 = (AnimElemTime (17) < 0)
fvar(0)  = -fvar(3)/100
ignorehitpause = 1
persistent= 1

[State 3000, 最大溜め爆発エフェ]
type = Explod
triggerall = (AnimElemTime (17) < 0)
trigger1 = time >= 77
anim = 6015
ID = 1000
postype = P1
pos = ceil(-3*Const(size.xscale)),ceil(-185*Const(size.yscale))
facing = 1-((random>=500)*2)
vfacing= 1-((random>=500)*2)
scale = 0.7*Const(size.xscale),0.7*Const(size.yscale)
bindtime = -1
removetime = -2
removeongethit = 1
sprpriority = 7
ontop = 1
shadow = 0, 0, 0
Trans = add   ;Add ,None, Add1, Sub, AddAlpha
ownpal = 1
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause	= 1 
persistent= 0

[State 3000, 最大溜め暗転時間停止]
type = SuperPause
triggerall = (AnimElemTime (17) < 0)
trigger1 = time >= 77
anim = -1       ;超必エフェクトのアクションナンバー。通常は「fightfx.air」のアニメを使うが、
                 ;左に「s」を付ければ「自分のairファイル」のアクションナンバーが使える。
pos = 25, -57    ;超必エフェクトの座標（Ｘ軸,Ｙ軸）
sound = 20, 0    ;超必発動サウンド。通常は「common.snd」の音を使うが、
                 ;左に「s」を付ければ「自分のsndファイル」の音が使える。
poweradd = 0 ;パワーゲージ増減量
time = 30       ;ポーズする時間（フレーム）
;movetime = 0    ;ポーズ中に動ける時間。timeよりも多いとバグる（デフォルトは０）
darken = 1      ;ポーズ中画面を暗転するか否か（0=しない・1=する）
                 ;暗転する色は「ownpal」の有無により「Explod」や「ヘルパー」にも影響するので注意。
;p2defmul = 1.0  ;直前のステートを「SuperPauseを設置したステート」でキャンセルした場合、
                 ;『相手に一時的に与える防御力乗算値(float)』。
                 ;デフォルトは０。（相手の防御力が上がり、ダメージ量に下方修正が掛かる）
                 ;１にすれば『ダメージ補正が掛からなくなる』事になる。
                 ;相手が食らい状態以外（相手のMoveTypeが「H」以外）になれば解除される。
unhittable = 1  ;ポーズ中自分を無敵状態にするか否か（0=しない・1=する）
                 ;デフォルトは１。
persistent= 0


;---------------------[タメ後攻撃移行]
[State 1000, 攻撃移行]
type = ChangeAnim
triggerall = (AnimElemTime (17) < 0)
trigger1 = var(59) = 0;★AIスイッチ
trigger1 = command != "hold_x"
trigger1 = time >= 27
trigger2 = (fvar(0) <= 0)
trigger3 = time >= 78
value = 1000
elem = 17
persistent= 0

[State 195, 声]
type = PlaySnd
trigger1 = AnimElem = 17
value = 5, 4
channel = 0
volume = 128
freqmul = 1.1
persistent= 0

;---------------------[移動]
[state velset]
type = velset
trigger1 = animelem = 23
x = 30

[state velmul]
type = velmul
trigger1 = 1
x = .85


[state velset]
type = velset
trigger1 = animelem = 41
x = 0

[State 1220, 物理的なキャラの幅]
type = Width
trigger1 = animelemtime(25) <= 0
value = ceil(160*Const(size.xscale)),0

