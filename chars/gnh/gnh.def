; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Sogiita Gunha"        ;Name of character
displayname = "Gunha" ;Name of character to display
versiondate = 8,7,2014    ;Version date of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "fugaku"         ;Character author name
pal.defaults = 1     ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
movelist = movelist.dat

cmd     = gnh.cmd           ;Command set
;cmd     = gnh-AI.cmd           ;簡易AI起動
cns     = gnhcons.cns           ;コンスタンツ
st      = gnhcommon.cns         ;基本動作
St0     = gnh1.cns     ;通常攻撃
St1     = gnh2.cns     ;必殺技
St2     = gnh3.cns     ;超必殺技
St3     = gnh-2.cns    ;-2,-3ステート
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = gnh.sff           ;Sprite
anim    = gnh.air           ;Animation
;sound   = gnh.snd           ;声無し
sound   = gnh-voice.snd           ;声あり

;★ごく普通　基本の状態
pal1    = pal1.act 
pal2    = pal1.act 
pal3    = pal1.act 
pal4    = pal1.act 
pal5    = pal1.act 
pal6    = pal1.act 

;★特殊効果付き
pal7    = pal1.act ;★気合ゲージ常時MAX
pal8    = pal1.act ;★根性カウントMAX
pal9    = pal1.act ;★パレット効果7+8
pal10    = pal1.act ;★通常ゲージ常時MAX
pal11    = pal1.act ;★パレット効果9+10
pal12    = pal1.act ;★パレット効果11+根性ゲージ常時MAX
