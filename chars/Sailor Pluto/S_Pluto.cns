type = S
ctrl = 0
anim = 180
velset = 0,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Animelem = 1
value = 20,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Animelem = 2
value = 22,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 180
value = 23,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 200
value = 24,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Animelem = 210
value = 25,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1
;---------------------------------------------------------------------------
; Intro state decider
[Statedef 190]
type = S

[State 0, VarRandom]
type = VarRandom
trigger1 = !time
v = 19
range = 1,2

[State 180, 1]
type = ChangeState
trigger1 = !time && var(19) = 1
value = 191

[State 180, 1]
type = ChangeState
trigger1 = !time && var(19) = 2
value = 192
;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 2
value = 190,1
volume = 0

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0
;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
