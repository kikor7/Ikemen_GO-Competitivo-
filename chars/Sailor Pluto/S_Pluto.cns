;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

; Play "ouch" sound when hit light or medium
[State -2, 2]
type = PlaySnd
triggerall = time = 1
triggerall = Alive
triggerall = stateno=5000
trigger1 = anim = 5000
trigger2 = anim = 5011
trigger3 = anim = 5005
trigger4 = anim = 5015
trigger5 = anim = 5020
trigger6 = anim = 5025
trigger7 = anim = 5027
value = 5000,Random%2

; Play "ouch" sound when hit light or medium
[State -2, 2]
type = PlaySnd
triggerall = time = 1
triggerall = Alive
triggerall = stateno=5001
trigger1 = anim = 5001
trigger2 = anim = 5010
trigger3 = anim = 5006
trigger4 = anim = 5016
trigger5 = anim = 5021
trigger6 = anim = 5026
value = 5000,Random%2

; Play "ouch" sound when hit light or medium (in the air)
[State -2, 3]
type = PlaySnd
triggerall = time = 1
triggerall = stateno=5001
triggerall = Alive
trigger1 = anim = 5020
trigger2 = anim = 5021
value =5000,Random%2

; Play "ouch" sound when hit hard
[State -2, 4]
type = PlaySnd
triggerall = time = 1
triggerall = stateno=5001||stateno=5030
triggerall = Alive
trigger1 = anim = 5002
trigger2 = anim = 5012
trigger3 = anim = 5022
value = 5000,Random%2

; Play "ouch" sound when hit hard (in the air)
[State -2, 5]
type = PlaySnd
trigger1 = time = 1
triggerall = stateno=5001
trigger1 = Alive
trigger1 = anim = 5050
value = 5000,2

; Play "ouch" when landing on back
[State -2, 6]
type = PlaySnd
trigger1 = time = 1
triggerall = stateno=5001||stateno=5030
trigger1 = stateno = 5100
trigger2 = stateno = 5151
trigger1 = Alive
value = 5000,1

;Play "ouch" when hit up
[State -2, 6]
type = PlaySnd
triggerall = time = 1
triggerall = stateno=5000
trigger1 = anim = 5051
trigger2 = anim = 5061
trigger3 = anim = 5030
triggerall = Alive
value = 5000,2

[State -2, 6]
type = PlaySnd
triggerall = time = 1
trigger1 = random <= 333
trigger1 = stateno=5030
triggerall = Alive
value = 5000,random%2

;Play "ouch" when hit down
[State -2, 6]
type = PlaySnd
triggerall = time = 1
trigger1 = random <= 333
triggerall = stateno=5070
trigger1 = anim = 5070
triggerall = Alive
value = 5000,random%2

[State 0, PlaySnd]
type = PlaySnd
triggerall = animelem = 2
triggerall = animelem = 7
trigger1 = anim = 20
trigger2 = anim = 21
value = 40,0
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
