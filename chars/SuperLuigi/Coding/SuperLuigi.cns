FrameGap = 1
length = 15;12;30
PalBright = 0,0,0
PalContrast = 0,0,300
Trans = add
persistent = 0

[State 104, Poof]
type = DestroySelf
trigger1 = IsHelper
trigger1 = Root,Anim != 105
trigger1 = time > 60

