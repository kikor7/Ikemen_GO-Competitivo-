ctrl = 0
anim = 170
velset = 0,0

[State 195, 1]
type = playsnd
trigger1 = animelem = 1
value = 170,0
channel = 0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

