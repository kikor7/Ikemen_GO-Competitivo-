; Win sword throw
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[state 181, No Life Bar]
type = assertspecial
trigger1 = Time >= 0
flag = NoBarDisplay


[State not hit]
type = NotHitBy
trigger1 = 1
value = SCA

[State 0]
type = Explod
trigger1 = AnimElem = 4 && (var(7) = 0)
anim = 8730
removetime = 9999999
sprpriority = -3
bindtime = -1
supermovetime = -1
ownpal = 1
removeongethit = 1

[State 1030, 2]
type = Explod
trigger1 = animelem = 4
anim = 9115
postype = p1
pos = 0, 0
bindtime = 1
removetime = -2
ownpal = 1
sprpriority = 3
vel = -.3, 0

[state width]
type = width
trigger1 = 1
edge = 0, const(size.ground.back) + const(size.ground.front) + 15

[State 191, 5]
type = playsnd
trigger1 = animelem = 1
value = s190, 2

[State 191, 5]
type = playsnd
trigger1 = animelem = 4
value = s5210, 0


[state round not over]
type = assertspecial
trigger1 = time < 220
flag = roundnotover

