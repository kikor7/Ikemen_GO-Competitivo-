[State 1000, 6]
type = ChangeState
trigger1 = movecontact
trigger2 = animtime = 0
;trigger2 = animelem = 10
value = 1001
ctrl = 0

[State 1000, 7]
type = ChangeState
triggerall = var(20) < 5 
trigger1 = movecontact && command = "QCB_a"
value = 1002
ctrl = 0

[State 1000, 7]
type = ChangeState
triggerall = var(20) = 5 && movecontact
trigger1 = command = "x" || command = "y" || command = "b"
value = 1002
ctrl = 0
