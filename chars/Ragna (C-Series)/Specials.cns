[State 1000, 5]
type = HitDef
trigger1 = AnimElem = 6
trigger2 = AnimElem = 7 && !movecontact
trigger3 = AnimElem = 8 && !movecontact
trigger4 = AnimElem = 9 && !movecontact
trigger5 = AnimElem = 10 && !movecontact
attr = S, SA
animtype  = Hard
damage    = 90, 4
getpower = 60,30
priority  = 5
hitflag = MAFD
guardflag = MA
pausetime = 12,12
sparkxy = -10,-60
hitsound   = S3,3
guardsound = S6,1
ground.type = Low
ground.slidetime = 14
ground.hittime  = 27
ground.velocity = -4,0
air.velocity = -2,-8
down.velocity = -4,-5
air.fall = 1
fall.recover = 1
fall.recovertime = 40
;fall = 1
;Drive Hit Spark
[State 1, Drive Hit Spark]
type = explod
trigger1 = movecontact = 1 && numtarget
trigger1 = target,time <=0 && p2movetype = H
