[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 1000, 7]
type = ChangeState
triggerall = var(20) < 5 
trigger1 = animelemtime(8) && command = "QCB_a"
trigger2 = animelemtime(9) && command = "QCB_a"
trigger3 = animelemtime(10) && command = "QCB_a"
value = 1002
ctrl = 0

[State 1000, 7]
type = ChangeState
triggerall = var(20) = 5 
trigger1 = animelemtime(8) && command = "x"
trigger1 = command = "x" || command = "y" || command = "b"
trigger2 = animelemtime(9)
trigger2 = command = "x" || command = "y" || command = "b"
trigger3 = animelemtime(10)
trigger3 = command = "x" || command = "y" || command = "b"
value = 1002
ctrl = 0

[State 1025, State]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl=1

