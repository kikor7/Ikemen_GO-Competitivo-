hitflag = MAF                    ;Flags of conditions that move can hit; medium(=HL), high, low, air, fall, down
guardflag = MA
pausetime = 12,12
sparkno = S-1 
sparkxy = -10,-70
hitsound   = S1,1
guardsound = S6,1
ground.type = High
guard.hittime = 16               ;Time opponent is in guard state
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = -6
air.velocity = -1.5,-6
air.fall = 1
fall.recover = 1
fall.recovertime = 10
