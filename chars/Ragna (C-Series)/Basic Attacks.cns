;---------------------------------------------------------------------------
; CNS difficulty: easy
; Note the width controller. It makes Ragna the Bloodedge (C-Series)'s push box larger, so he doesn't
; stand so close to the opponent. Hit Ctrl-C and look at the red bar at his
; feet.
; The sprpriority for this state is at -1, instead of the usual 2 for
; attacks. This makes Ragna the Bloodedge (C-Series) appear behind the opponent initially.
; The SprPriority controller in [State 210, 4] brings Ragna the Bloodedge (C-Series) to the front when
; his arm has swung over.
; To stop Ragna the Bloodedge (C-Series) from pausing in his swing frame, there is a ChangeAnim in
; [State 210, 3] that detects if the hit has come in contact with the
; opponent during that frame, and switches to the next animation element
; (notice the elem=6 parameter). If you don't see what I mean, try commenting
; out that controller, then hit someone with this attack.
; 5B
[Statedef 210]
type    = S
movetype= A
physics = S
juggle  = 2
poweradd= 0
ctrl = 0
;velset = 0,0
anim = 210
sprpriority = 2
facep2 = 1

[State 210, Width]
type = Width
trigger1 = (AnimElemTime (2) >= 0) && (AnimElemTime (7) < 0)
value = 15,0

[State 210, 1]
type = PlaySnd
trigger1 = animelem = 9
value = 1, 0

[State 210, 2]
type = HitDef
trigger1 = AnimElem = 10
trigger2 = AnimElem = 11 && !movecontact
trigger3 = AnimElem = 12 && !movecontact
attr = S, NA
animtype  = Medium
damage    = 64
getpower = 6,3
hitflag = MAF                    ;Flags of conditions that move can hit; medium(=HL), high, low, air, fall, down
guardflag = MA
pausetime = 12,12
sparkno = S-1 
sparkxy = -10,-70
hitsound   = S1,1
guardsound = S6,0
ground.type = High
guard.hittime = 16               ;Time opponent is in guard state
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = -6
air.velocity = -1.5,ifelse(var(20)=5,-3,-6)
air.fall = 1
fall.recover = 1
fall.recovertime = 30
p2facing = 1
[State 1, Hit Spark]
