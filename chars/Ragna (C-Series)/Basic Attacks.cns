anim = 20062
pos = 20,-40
postype = P1  ;P2, Front, Back, Left, Right
facing = 1
vfacing = 1
bindtime = -1
removetime = -2
supermovetime = 0
pausemovetime = 0
scale = const(size.xscale)*.7,const(size.yscale)*.7
ignorehitpause = 0
sprpriority = 3
[State 1008, 1]
type = veladd
trigger1 = animelemtime(10) = 0
y = -10

[State 1008, 2]
type = veladd
trigger1 = animelemtime(11) > 0
x = .65
y = .65

[State 1008, 3]
type = statetypeset
trigger1 = animelem = 10
statetype = A

