trigger1 = animelemtime(6) > 0 && movecontact
trigger1 = command = "up" || command = "upF" || command = "upB"  
value = 40
ctrl = 1

[State 205, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;Smart Combo (Technical Mode)
[State 200, 3]
type = ChangeState
triggerall = var(20) = 5 && var(21) = 0
trigger1 = movecontact && command = "y"
value = 230
ctrl = 0

;Smart Combo (Stylish Mode)
[State 200, 3]
