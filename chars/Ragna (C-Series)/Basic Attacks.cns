trigger1 = movehit
anim = 8055
id = 8055
pos = 0,-85
facing = 1
postype = p2
sprpriority = 6
bindtime = 1
ownpal = 1
ignorehitpause = 1
persistent = 0
scale = const(size.xscale)*.75,const(size.yscale)*.75
[State 210, 4]
type = SprPriority
trigger1 = AnimElem = 5
value = 2
