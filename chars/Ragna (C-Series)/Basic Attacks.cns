; Ragna the Bloodedge (C-Series)'s constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

;---------------------------------------------------------------------------
; 5A
[Statedef 200]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 2                      ;Number of air juggle points move takes
;Commonly-used controllers:
;velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 200                       ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 2                  ;Set p1's sprite layering priority to 2 (in front)
facep2 = 1

[State 210, 1]
type = PlaySnd
trigger1 = Time = 2
value = 0, 0

[State 200, 1]
type = HitDef
trigger1 = AnimElem = 3
attr = S, NA                     ;Attribute: [Air(A), Standing(S), Crouching(C)] , [All (A), Normal Attack (N), Special (S), Hyper (H)][Attack (A), Throw (T), Projectile (P)]
damage = 30, 0                   ;Damage that move inflicts, guard damage
getpower = 3,1
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back, Up, DiagUp (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit; medium(=HL), high, low, air, fall, down
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 7, 7                 ;Time attacker pauses, time opponent shakes
sparkno = S-1                      ;Spark anim no (Def: set above)
sparkxy = -10, -76               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
guard.hittime = 11               ;Time opponent is in guard state
hitsound = S0, 1                 ;Sound to play on hit
guardsound = S6, 0               ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 12             ;Time opponent is in hit state
ground.velocity = -5             ;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.4,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 25                 ;Time before opponent regains control in air
fall.recover = 1
fall.recovertime = 25
p2facing = 1
[State 1, Hit Spark]
type = explod
trigger1 = movehit
anim = 8005
id = 8005
pos = 0,-100
facing = 1
postype = p2
sprpriority = 6
bindtime = 1
ownpal = 1
ignorehitpause = 1
persistent = 0
scale = const(size.xscale)*.75,const(size.yscale)*.75
[State 0, COUNTER HIT]
type = Helper
trigger1 = fvar(13) = 1
trigger1 = movehit
name = "Counter Hit"
ID = 3970
stateno = 3970
pos = 0,0
postype = p2
ignorehitpause = 1
persistent = 0
ownpal = 1
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)
[State 200, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;Stylish Mode
[State 200, 3]
type = ChangeState
triggerall = p2bodydist X=[-32,34]
triggerall = var(21) = 1
trigger1 = movecontact && command = "x"
value = 700
ctrl = 0
;Stylish Mode
[State 200, 3]
type = ChangeState
triggerall = p2bodydist X!=[-32,34]
triggerall = var(21) = 1
trigger1 = movecontact && command = "x"
value = 701
ctrl = 0
;---------------------------------------------------------------------------
; 6A
[Statedef 205]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 2                      ;Number of air juggle points move takes
;Commonly-used controllers:
;velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 205                       ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 2                  ;Set p1's sprite layering priority to 2 (in front)
facep2 = 1

[State 1008, 1]
type = null;veladd
trigger1 = animelemtime(2) = 0
x = 1
[State 1008, 1]
type = null;veladd
triggerall = prevstateno = 220
trigger1 = animelemtime(1) = 0
x = 20
[State 1008, 1]
type = null;velset
triggerall = prevstateno = 220
trigger1 = animelemtime(2) = 0
x = 0
[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = S0,0
channel = 0

[State 205, 1]
type = HitDef
trigger1 = AnimElem = 6
trigger2 = AnimElem = 7 && !movecontact
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 80, 0                   ;Damage that move inflicts, guard damage
getpower = 60,30
animtype = Up                 ;Animation type: Light, Medium, Heavy, Back, Up, DiagUp (def: Light)
guardflag = MA                   ;Flags on how move is to be guarded against
hitflag = MAF                    ;Flags of conditions that move can hit
priority = 3, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 8, 8                 ;Time attacker pauses, time opponent shakes
sparkno = S-1                      ;Spark anim no (Def: set above)
sparkxy = -10, -76               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
hitsound = S0, 1                  ;Sound to play on hit
guardsound = S6, 0                ;Sound to play on guard
guard.hittime = 16               ;Time opponent is in guard state
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = ifelse(var(20)=5&&var(21)=1,25,17)             ;Time opponent is in hit state
ground.velocity = ifelse(var(20)=5&&var(21)=1,-7,-1),ifelse(var(20)=5&&var(21)=1,0,-8.5)            ;Velocity at which opponent is pushed
airguard.velocity = -2,-3     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.5,-7           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 40               ;Time before opponent regains control in air
fall = ifelse(var(20)=5&&var(21)=1,0,1)
fall.recover = 1
fall.recovertime = 40
air.fall = 1
p2facing = 1
[State 1, Hit Spark]
