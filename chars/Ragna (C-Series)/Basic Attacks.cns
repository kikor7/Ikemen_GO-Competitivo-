type    = S
movetype= A
physics = S
juggle  = 2
poweradd= 0
ctrl = 0
;velset = 0,0
anim = 210
sprpriority = 2
facep2 = 1

[State 210, Width]
type = Width
trigger1 = (AnimElemTime (2) >= 0) && (AnimElemTime (7) < 0)
value = 15,0

