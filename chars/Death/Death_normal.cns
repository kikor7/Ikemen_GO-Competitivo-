;======================================================================
;　奪われた刻印
;======================================================================
; 通常状態
[Statedef 1000]
type     = A
movetype = I
physics  = N
sprpriority = -2

[State 1000, 1]
type = ChangeState
trigger1 = Life = 0
value = 5150

[State 1000, 2]
Type = HitOverride
Trigger1 = 1
Attr = SCA, AA, AP
Time = -1
slot = 0
stateno = 1001
IgnoreHitPause = 1

[State 1000, 3]
type = ChangeAnim
trigger1 = Anim != 1000
value = 1000

[State 1000, 4]
type = VelMul
triggerall = var(59) = 0
trigger1 = command != "holdfwd"
trigger1 = vel x >= 0.1
trigger2 = command != "holdback"
trigger2 = vel x <= -0.1
x = 0.92

[State 1000, 5]
type = VelMul
triggerall = var(59) = 0
trigger1 = command != "holdup"
trigger1 = vel y <= -0.1
trigger2 = command != "holddown"
trigger2 = vel y >= 0.1
y = 0.92

[State 1000, 6]
type = VelAdd
triggerall = var(59) = 0
trigger1 = command = "holdfwd"
trigger2 = command = "holdback"
x = ifelse(command="holdfwd",0.08,-0.08)

[State 1000, 7]
type = VelAdd
triggerall = var(59) = 0
trigger1 = command = "holdup"
trigger2 = command = "holddown"
y = ifelse(command="holdup",-0.08,0.08)

[State 1000, 8]
type = VelSet
trigger1 = var(59) = 0
trigger1 = abs(vel x) < 0.1
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
x = 0

[State 1000, 9]
type = VelSet
trigger1 = var(59) = 0
trigger1 = abs(vel y) < 0.1
trigger1 = command != "holdup"
trigger1 = command != "holddown"
y = 0

[State 1000,10]
type = VelSet
trigger1 = vel x > const(velocity.walk.fwd.x)
trigger2 = vel x < -const(velocity.walk.fwd.x)
x = ifelse(vel x>const(velocity.walk.fwd.x),const(velocity.walk.fwd.x),-const(velocity.walk.fwd.x))

[State 1000,11]
type = VelSet
trigger1 = vel y > const(velocity.walk.fwd.x)
trigger2 = vel y < -const(velocity.walk.fwd.x)
y = ifelse(vel y>const(velocity.walk.fwd.x),const(velocity.walk.fwd.x),-const(velocity.walk.fwd.x))

[State 1000,12]
type = PosSet
trigger1 = pos y > 30
trigger2 = pos y < -120
y = ifelse(pos y>30,30,-120)

[State 1000,13]
type = ChangeState
trigger1 = RoundState > 2
value = 0

