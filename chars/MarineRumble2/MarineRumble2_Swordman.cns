type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = 1
x = const(velocity.walk.fwd.x)

[State 0, PlaySnd]
type = PlaySnd
triggerall = Anim = 10020
trigger1 = Animelem = 3
value = S40,0
volume = 50

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = (Anim != 10020 && Anim != 10005)
trigger2 = (Anim = 10005) && AnimTime = 0
value = 10020

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = time%50 = 0 && random = [200,300]
value = ifelse(random> 650,10300,10200)
ctrl = 1

[State 100:		ChangeState]
type			= ChangeState
trigger1		= time > 20+(random%40)
trigger2		= time = 60
value			= 10000




