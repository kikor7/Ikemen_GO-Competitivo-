v = 30
value = -gethitvar(damage)

[State 10601, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 10601, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 10605 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 10601, 3] ;Stop sliding back
