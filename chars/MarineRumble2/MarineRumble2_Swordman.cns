; HITC_SHAKE
[Statedef 10610]
type    = C
movetype= H
physics = N
velset = 0,0


[State 10610, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = 10620 + GetHitVar(animtype)

[State 10610, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = var(30) <= 0
value = 10630

[State 10610, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(10647 + GetHitVar(animtype)))
value = 10647 + GetHitVar(animtype) ;10651 - 4 + type

[State 10610, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 10610, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
triggerall = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 10610, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 10611 ;HITC_SLIDE

[State 10610, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger2 = var(30) <= 0
value = 10630

[State 10610, FFB Light]
type = ForceFeedback
trigger1 = anim = 10620
persistent = 0
time = 6
waveform = square

[State 10610, FFB Medium]
type = ForceFeedback
trigger1 = anim = 10621
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 10610, FFB Hard]
type = ForceFeedback
trigger1 = anim = 10622
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

