;---------------------------------------------------------------------------
; HIT_LIEDOWN
[Statedef 10710]
type    = L
movetype= H
physics = N

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)


[State 10710, EnvShake]
type = FallEnvShake
trigger1 = Time = 0

[State 10710, 1] ;For hit up/up-diag type (from state 10681)
type = ChangeAnim
persistent = 0
trigger1 = SelfAnimExist(10710 + (anim % 10))
trigger1 = anim = [10681,10689]
value = 10710 + (anim % 10)

[State 10710, 2] ;Hit ground anim (normal)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [10710,10719] ;Not already changed anim
trigger1 = anim != [10761,10769]
trigger2 = !SelfAnimExist(10770 + (anim % 10))
value = 10770

[State 10710, 3] ;Hit ground anim (for hit up)
type = ChangeAnim
triggerall = time = 0
triggerall = anim != [10710,10719] ;Not already changed anim
trigger1 = anim = [10761,10769]
trigger1 = SelfAnimExist(10770 + (anim % 10))
value = 10770 + (anim % 10)

[State 10710, 4]
type = HitFallDamage
trigger1 = Time = 0

[State 10710, 5]
type = PosSet
trigger1 = Time = 0
y = 0

[State 10710, Var] ;Get fall velocity
type = VarSet
trigger1 = Time = 0
trigger1 = GetHitVar(fall.yvel) != 0
sysvar(1) = floor(vel y)

[State 10710, 6]
type = PlaySnd
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = F7, (sysvar(1) > 5) + (sysvar(1) > 14)

[State 10710, 7]
type = GameMakeAnim
trigger1 = Time = 0
trigger1 = !SysVar(0)
value = 60 + (sysvar(1) > 5) + (sysvar(1) > 14)
pos = 0, 0
under = sysvar(1) <= 14

[State 10710, 8]
type = VelSet
trigger1 = Time = 0
y = 0

[State 10710, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [10771,10779]
triggerall = SelfAnimExist(10710 + (anim % 10))
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground anim
value = 10710 + (anim % 10)

[State 10710, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [10711,10719]
trigger1 = AnimTime = 0
trigger2 = SysVar(0) ;SysVar(0) = 1 avoids hit ground frame
value = 10710




[State 10710, end] ; con esto muere cuando el contador de vida llega a O
type = changestate ; con esto cuando Momonga muere, mueren todos
trigger1 = parent, var(31) <= 0
trigger1 = AnimTime = 0
value = 10750 ;10750 --> lleva a muerte/desaparición
ctrl = 0

[State 10710, end] ; con esto se decide cuándo muere
type = changestate
trigger1 = AnimTime = 0
value = Ifelse((var(30) <= 0),10750,10720) ; 10750 --> lleva a muerte/desaparición
ctrl = 0                                 ; 10720 --> lleva al Get Up



[State 10710, 13] ;Friction
type = VelMul
trigger1 = 1
x = 0.85

[State 10710, 14]
type = ForceFeedback
trigger1 = alive
trigger1 = Time = 0
time = 8
ampl = 240
waveform = sine

[State 10710, 15]
type = ForceFeedback
trigger1 = !alive
trigger1 = Time = 0
ampl = 200, 7, -.467
time = 30
waveform = sine

