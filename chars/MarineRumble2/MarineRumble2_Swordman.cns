;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 10650]
type    = A
movetype= H
physics = N

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)


[State 106106, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 10635
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 10635
trigger2 = (Anim != [10651, 10659]) && (Anim != [10661, 10669])
trigger2 = Anim != 10690 ;Not if hit off ground anim
value = 10650

[State 10650, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [10650,10659]
trigger1 = Vel Y >= ifelse(anim = 10650, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 10650, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 10650, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 10800 ;HITFALL_RECOVER

[State 10650, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 10810 ;HITFALL_AIRRECOVER

[State 10650, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [10651,10659]) || (anim = [10661,10669]), 0, 10)
value = 10700

