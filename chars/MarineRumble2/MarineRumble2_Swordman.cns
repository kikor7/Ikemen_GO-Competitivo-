;==========<JUMP IN>====================================================
;-----------------------------------------------------------------------

[Statedef 10099]
type = A
physics = N
anim = 10041

[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr= SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=10600
ignorehitpause=1


[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30

[State 1005, vel]
type = veladd
trigger1 = 1
y =.3

[State 1005, Not Bound]
type=screenbound
trigger1= 1
value=0
ignorehitpause = 1


[State 1005, vel]
type = velset
trigger1 = time = 0
x = 1+(Random%3)
y = -3-(Random%3)

[State 0, VarSet] ; esto es lo que le da la vida
type = VarSet
trigger1 = !time
v = 30
value = 100 ; tiene 100 de vida (valor recomendado para clones)

[State 0, Varset] ; cuenta la cantidad de veces que se invoca el helper
type = Varset     ; para no invocar mas de los que permite la vida total
trigger1 = time = 0
v = 33
value = 1
[State 0, Varset]
type = Varset
trigger1 = time = 1
v = 33
value = 0

[State 1005, end]
type = changestate
trigger1 = Pos y > -1
value = 10012


;=======================================================================
;------ CAIDAS ---------------------------------------------------------
;=======================================================================

;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 10600]
type    = S
movetype= H
physics = N
velset = 0,0


[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)




[State 10600, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),10600,10610) + GetHitVar(animtype)

[State 10600, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = var(30) <= 0
value = 10630

[State 10600, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(10647 + GetHitVar(animtype)))
value = 10647 + GetHitVar(animtype) ;10651 - 4 + type

[State 10600, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 10600, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 10600, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 10601 ;HITG_SLIDE

[State 10600, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger2 = var(30) <= 0
value = 10630

[State 10600, FFB Light]
type = ForceFeedback
trigger1 = anim = 10600
trigger2 = anim = 10610
persistent = 0
time = 6
waveform = square

[State 10600, FFB Medium]
type = ForceFeedback
trigger1 = anim = 10601
trigger2 = anim = 10611
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 10600, FFB Hard]
type = ForceFeedback
trigger1 = anim = 10612
trigger2 = anim = 10602
trigger3 = anim = 10630
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 10601]
type    = S
movetype= H
physics = S


[State 0, VarAdd] ;para restar vida del Swordman
