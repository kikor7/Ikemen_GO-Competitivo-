;---------------------------------------------------------------------------
; Stand
[Statedef 15000]
type = S
physics = S
sprpriority = 0

[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr=SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=15600
ignorehitpause=1


[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 15000 && Anim != 15005)
trigger2 = (Anim = 15005) && AnimTime = 0
value = 15000


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30



;------------------------------

[State 0, Winpose]
type = ChangeState
triggerall = parent, numhelper(182) = 1
trigger1 = 1
value = 15181
ctrl = 0

[State 0, Lose by Time]
type = ChangeState
triggerall = parent, numhelper(172) = 1
trigger1 = 1
value = 15900
ctrl = 0




;-----------------------------------------------------------

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = parent,var(31) <= 0
value = 15700
;------------------------------------------------------------

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x > 50
trigger1 = time%50 = 0 && random = [200,300]
value = 15220
ctrl = 1

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = time%50 = 0 && random = [200,300]
value = ifelse(random> 350,15200,15210)
ctrl = 1

[State 0, Walk] ; caminar
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 10
trigger1 = time%50 = 0 &&  random = [100,700]
value = ifelse(random >= 650, 15021,15020)
ctrl = 1


[State 0, Salto]
type = ChangeState
;trigger1 = p2movetype = A
trigger1 = time%50 = 0 && random = [200,300]
value = 15040
ctrl = 0




