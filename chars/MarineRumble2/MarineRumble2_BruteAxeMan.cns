;---------------------------------------------------------------------------
; Jump Start
[Statedef 15040]
type    = S
physics = S
anim = 15040
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)-(ifelse(var(3) = 1,0.7,0)), const(velocity.jump.back.x)+(ifelse(var(3) = 1,0.7,0))))
y = -6

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S1,5
volume = 50

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 15050
ctrl = 0

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 15045]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(15044)
value = 15044

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(15044)
value = 15041

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 15050
ctrl = 0

;---------------------------------------------------------------------------
; Jump Up
[Statedef 15050]
type    = A
physics = N

[State 0, VelAdd]
type = VelAdd
trigger1 = 1
y = 0.3

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 15041, ifelse((vel x)>0, 15042, 15043))


[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 1005, end]
type = changestate
triggerall = time >= 5
trigger1 = pos y >-1
value = 15012

