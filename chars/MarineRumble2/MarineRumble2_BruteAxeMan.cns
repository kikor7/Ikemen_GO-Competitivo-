trigger1 = p2bodydist x > 50
trigger1 = time%50 = 0 && random = [200,300]
value = 15220
ctrl = 1

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = time%50 = 0 && random = [100,700]
value = ifelse(random> 350,15200,15210)
ctrl = 1

[State 100:		ChangeState]
type			= ChangeState
trigger1		= time > 20+(random%40)
trigger2		= time = 60
value			= 15000




