trigger1 = AnimElem = 2
attr = S, NA ;立ち通常打撃（Standing, Normal Attack）
damage = 20, 0
animtype = Light
guardflag = MA
hitflag = MAF
getpower = 30,15
priority = 4, Hit
pausetime = 9, 10
sparkno = -1
guard.sparkno = -1
sparkxy = -47, -206
hitsound = s100, 37
guardsound = s100, 45
ground.type = High
ground.slidetime = 8
ground.hittime  = 8
ground.velocity = -4
air.type = High
air.velocity=-2.8,-5
air.hittime = 12
guard.sparkno=-1
yaccel=.48
fall=ifelse(var(50) = 1,1,0);.recover=ifelse(var(19),0,1)
fall.recovertime=10
ground.cornerpush.veloff=-7

[State 200, 攻撃エフェクト]
