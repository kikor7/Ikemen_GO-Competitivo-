type    = S
movetype= A
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 200
poweradd = 0
sprpriority = 2

[State ];コンボ補正
type=Varadd
trigger1=movehit
var(30)=1
ignorehitpause=1
persistent=0

[State 200, ヒット定義]
