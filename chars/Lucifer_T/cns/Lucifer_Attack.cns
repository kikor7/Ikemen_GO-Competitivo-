trigger1 = AnimElem = 2
anim = 6039
ID = 6039
pos = 35,-95
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
sprpriority = 5
removeongethit = 1
ignorehitpause = 0
persistent = 0
ownpal = 1
scale = 0.5,0.5

