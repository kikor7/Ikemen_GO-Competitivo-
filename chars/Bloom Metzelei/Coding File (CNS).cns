;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;Die (HitPause)
[Statedef 6000]
type = A
movetype = A
physics = S
anim = 6000
ctrl = 1
sprpriority = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 5
value = S0,3
volumescale = 100
channel = 1

[State 6000]
type = ChangeState
trigger1 = !animtime
value = 5150

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;Seeing as you have a copy of common1.cns file in your template folder
;you wont need to override any common states here, instead do it in the
;common1.cns file.

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[statedef -2]

[State -2, Null]
type = Null
trigger1 = 1

[State -2]
type = SelfState
trigger1 = !ishelper
trigger1 = life <= lifemax/2
trigger1 = !var(17)
trigger1 = statetype != A
value = 555
ignorehitpause = 1

[State -2, Super Armor Helper]
type = Helper
trigger1 = !NumHelper(800)
trigger1 = Alive
stateno = 800
id = 800
name = "Armor"
keyctrl = 0
ownpal = 1
persistent = 0

[State -2, Super Armor Is Active]
type = VarSet
trigger1 = NumHelper(800)
var(1) = 1
ignorehitpause = 1

[State -2, Super Armor Is Destroyed]
type = VarSet
trigger1 = !NumHelper(800)
var(1) = 0
ignorehitpause = 1

[State -2, No Guarding!!]
type = AssertSpecial
trigger1 = 1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard
ignorehitpause = 1

[State -2, AI_selector]
type=VarSet
trigger1=var(59)!=0
trigger1=Var(59)!=Var(50)
v=59
value=Var(50)

[State -2, Death animation]
type = selfstate;ChangeState
trigger1 = stateno = [5000,5300]
trigger1 = stateno != 5150
trigger1 = stateno != 5110
trigger1 = life <= 1
value = 6000

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

[State -3, Null]
type = Null
trigger1 = 1

; Super Armor
[State -3, NotHitBy]
type = NotHitBy
trigger1 = Var(1)
trigger1 = StateNo != [120,159]
value = SCA
time = 1

[State -3, LifeAdd]
type = LifeAdd
trigger1 = Alive = 1
trigger1 = Var(1)
trigger1 = Var(2)
time = 1
value = -Var(2)

[State -3, LifeAdd]
type = LifeAdd
trigger1 = Alive = 1
trigger1 = MoveType = H
trigger1 = StateNo != [120,159]
trigger1 = Var(1) && !Var(2)
value = -Floor(GetHitVar(Damage) / GetHitVar(HitCount))

[State -3, SelfState]
type = SelfState
trigger1 = Alive = 1
trigger1 = MoveType = H
trigger1 = StateNo != [120,159]
trigger1 = StateType != A
trigger1 = Var(1)
value = 0
ctrl = 1

[State -3, SelfState]
type = SelfState
trigger1 = Alive = 1
trigger1 = MoveType = H
trigger1 = StateNo != [120,159]
trigger1 = StateType = A
trigger1 = Var(1)
value = 50
ctrl = 1

[State -3, AIlevel]      ;=== AI Type and Difficulty ===
type = varset            ;= Change it here if you want =
trigger1 = !var(50)      ;===== Current level is =======

var(50) =                                3

                                      ;(1 = begginer)
                                      ;(2 = normal
                                      ;(3 = expert
