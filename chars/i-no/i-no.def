; Player information
[Info]
name = "i-no"        ;Name of character
displayname = "i-no" ;Name of character to display
versiondate = 04,14,2001    ;Version date of character
mugenversion = 04,14,2001   ;Version of M.U.G.E.N character works on
author = "MEKA"         ;Character author name
pal.defaults = 6,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd	= i-no.cmd   ;Command set
cns     = cns/i-no.cns   ;Constants
st      = cns/-2.cns
st1     = cns/i-no_normal.cns
st2     = cns/i-no_dust.cns
st3     = cns/etc.cns
st4	= cns/i-no_special.cns
st5	= cns/i-no_kakusei.cns
st6	= cns/effect.cns
stcommon = cns/common1.cns ;Common states
sprite  = i-no.sff   ;Sprite
anim    = i-no.air   ;Animation
sound   = i-no.snd   ;Sound
pal1    = act/i-no.act  
pal2    = act/i-no2.act  
pal3    = act/i-no3.act  
pal4    = act/i-no4.act  
pal5    = act/i-no5.act  
pal6    = act/i-no6.act  
pal7    = act/i-no7.act  
pal8    = act/i-no8.act  
pal9    = act/i-no9.act  
pal10    = act/i-no10.act  
pal11    = act/i-no11.act  
pal12    = act/i-no12.act  

