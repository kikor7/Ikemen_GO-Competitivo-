;-----基本情報------------------------------------------------------

[Info]
Name         = "Kendou_Nakanishi"   ;キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "Kendou Nakanishi"   ;ゲーム中表示される名前（省略可能）
VersionDate  = 01,20,2008       ;キャラの最終更新日
MugenVersion = 04,14,2001       ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "Ina"            ;このキャラの作成者の名前
Pal.Defaults = 1                ;CPUで出てくるキャラカラーの順番

;-----必要なファイルの設定------------------------------------------

[Files]
movelist = movelist.dat
Cmd      = Kendou_Nakanishi.cmd          ;入力コマンド定義ファイルの登録
Cns      = cns/Kendou_Nakanishi.st       ;基本ステータス情報ファイルの登録
St       = cns/Kendou_Nakanishi.cns      ;動作プログラムファイルの登録1
St1      = cns/Special.cns               ;動作プログラムファイルの登録2
St2      = cns/B_PowerArts.cns           ;動作プログラムファイルの登録3
St3      = cns/Intro&Win.cns             ;動作プログラムファイルの登録4
St4      = cns/helper.cns                ;動作プログラムファイルの登録5
St5      = cns/-2.cns                    ;動作プログラムファイルの登録6
St6      = cns/system_mode.cns           ;動作プログラムファイルの登録7
St7      = AI/Default_AI.cns             ;動作プログラムファイルの登録8
StCommon = cns/common.cns                ;コモン動作プログラムファイルの登録
Sprite   = Kendou_Nakanishi.sff          ;複数のPCX画像を１パック化したスプライトファイルの登録
Anim     = Kendou_Nakanishi.air          ;アニメーションファイルの登録
Sound    = Kendou_Nakanishi.snd          ;複数のWAV音声を１パック化したサウンドファイルの登録

;---カラーパレットファイルの設定（最大１２個まで可能）---

Pal1 = act/Kendou_Nakanishi1.act         ;Ａボタンで決定した色が使えます
Pal2 = act/Kendou_Nakanishi2.act        ;Ｂボタンで決定
Pal3 = act/Kendou_Nakanishi3.act        ;Ｃボタンで決定
Pal4 = act/Kendou_Nakanishi4.act        ;Ｘボタンで決定
Pal5 = act/Kendou_Nakanishi5.act        ;Ｙボタンで決定
Pal6 = act/Kendou_Nakanishi6.act        ;Ｚボタンで決定
;Pal7 = act/Kendou_Nakanishi7.act        ;Ｓ押しながらＡボタンで決定した色が使えます
;Pal8 = act/Kendou_Nakanishi8.act        ;Ｓ押しながらＢボタンで決定
;Pal9 = act/Kendou_Nakanishi9.act        ;Ｓ押しながらＣボタンで決定
;Pal10= act/Kendou_Nakanishi10.act       ;Ｓ押しながらＸボタンで決定
;Pal11= act/Kendou_Nakanishi11.act       ;Ｓ押しながらＹボタンで決定
;Pal12= act/Kendou_Nakanishi12.act       ;Ｓ押しながらＺボタンで決定

;-----ストーリーボード設定------------------------------------------
[Arcade]
;Intro.Storyboard  = opeing.def
;Ending.Storyboard = ending.def
