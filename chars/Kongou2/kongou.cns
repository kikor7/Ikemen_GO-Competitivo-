;---------------------------------------------------------------------------
; Throw - Attempt
; CNS difficulty: medium-advanced
; Description: Throws are not difficult to make, although then can be
;     tedious at times. Throw attempt states have a HitDef of a
;     special format. The key parameters in a throw are p1stateno
;     and p2stateno. If the HitDef successfully connects, then
;     the attacker will change to the state number specified by
;     p1stateno, and the opponent will be change to the state
;     number assigned to p2stateno. The special thing about p2stateno
;     is that the opponent will be temporarily brought into the
;     attacker's state file. In this case, no matter who the
;     opponent is, he will be taken to state 820 of this file (kfm.cns)
;     and remain here until the end of the throw (look at his debug
;     information when he is being thrown; the text changes to yellow
;     to mean that he is in another player's state file).
[Statedef 800]
type    = S
movetype= A
physics = S
sprpriority = -1
ctrl = 0
movehitpersist = 1

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
trigger1 = var(11) := 0 || 1
trigger1 = var(12) := 0 || 1
value = 800

[State Armour MoveHit]
type = MoveHitReset
trigger1 = time = 0
trigger1 = prevstateno != 9000

[State Armour PowerAdd]
type = PowerAdd
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 70*(var(44) = 0)

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(7)*(prevstateno = 9000)
y = fvar(1)*(prevstateno = 9000)

[State 800, Helper]
type = Helper
trigger1 = animelemno(0) = [23, 38]
trigger1 = !numhelper(801)
id = 801
stateno = 801
ownpal = 0
pausemovetime = 999999
supermovetime = 999999

[State 800, 1]
type = HitDef
triggerall = var(22)
triggerall = !var(43)
trigger1 = !var(18)
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
attr = S, NA
damage = 100, 20*(var(44) != 0)
getpower = 30,15
animtype = Heavy
guardflag = MA
hitflag = MA
pausetime = 6, 6
sparkno = s17002
guard.sparkno = s17006 + 2*(numenemy = 1 && var(8) - var(6) < 1)
sparkxy = ifelse(p2bodydist x < 40, ifelse(p2bodydist x < 0, -50, ceil(p2bodydist x - 50)), -10), floor(-70.0*const(size.yscale))
sprpriority = -1
hitsound   = s5,2
guardsound = s6,0 + 2*(numenemy = 1 && var(8) - var(6) < 1)
ground.type = Low
ground.velocity = -10
ground.hittime  = 20
ground.slidetime  = 20
guard.hittime = 19
air.hittime = 999
airguard.ctrltime = 999
air.type = Low
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536

