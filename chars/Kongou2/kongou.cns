trigger1 = facing != var(32)
ignorehitpause = 1

[State 9000, Armour Recovery]
type = VarSet
trigger1 = time = 0
var(1) = 60
ignorehitpause = 1

[State 9000, Armour HitVel]
type = VarSet
trigger1 = time = 0
fvar(2) = gethitvar(xvel)*0.5*facing
ignorehitpause = 1

[State 9000, Armour Vel]
type = VarSet
trigger1 = time = 0
fvar(5) = ifelse(fvar(0) < fvar(2), fvar(0), fvar(2))
ignorehitpause = 1

[State 9000, Armour Vel]
type = VarSet
trigger1 = time = 0
fvar(6) = ifelse(fvar(0) > fvar(2), fvar(0), fvar(2))
ignorehitpause = 1

[State 9000, Armour Vel]
type = VarSet
trigger1 = time = 0
fvar(7) = fvar(0)+fvar(2)
ignorehitpause = 1

[State 9000, Armour Vel]
type = VarSet
trigger1 = time = 0
trigger1 = fvar(7) < fvar(5)
fvar(7) = fvar(5)
ignorehitpause = 1

[State 9000, Armour Vel]
type = VarSet
trigger1 = time = 0
trigger1 = fvar(7) > fvar(6)
fvar(7) = fvar(6)
ignorehitpause = 1

