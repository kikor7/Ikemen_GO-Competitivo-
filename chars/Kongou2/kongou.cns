;==================================================================================
;==================================================================================
;==================================================================================

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[StateDef -2]

;==================================================================================
;======| RELACIONADO À AI - AI RELATED |===========================================
;==================================================================================

; Within StateDef -2, none of your own AI-related code should be placed
; above these next two controllers.

[State -2, StopAI]
type = VarSet
triggerall = (var(59) > 0)
trigger1 = (RoundState != 2)
trigger2 = !Alive
var(59) = -2
IgnoreHitPause = 1

; This controller is optional.  It allows you treat the AI flag as a boolean
; value rather than an integer value, letting you trigger your AI directives
; with "var(0)" instead of "var(59)>0", and letting you make moves usable only
; by humans by using "!var(0)" instead of "var(59)<1", thus slightly improving
; the size and efficiency of your code.
; Another benefit is that it makes it much easier for users to disable your AI,
; if they so choose.
;[State -2, Simplifier]
;type = VarSet
;trigger1 = (var(59) = 1)
;trigger2 = (var(0):=0)
;var(0) = 1	; Another option is to replace 1 with something like MatchNo, if
		; you want to design your AI to have varying levels of difficulty.
;IgnoreHitPause = 1

;==================================================================================
;==================================================================================
;==================================================================================


[State -2, Armour]
type = VarAdd
trigger1 = var(1) > 1
trigger2 = movetype != H
trigger2 = var(1) = 1
var(1) = -1

[State -2, Armour]
type = VarSet
trigger1 = !var(1)
var(9) = 0

[State -2, Armour]
type = VarSet
trigger1 = stateno != 9000
fvar(2) = 0

[State -2, Armour]
type = VarSet
trigger1 = stateno != 9000
fvar(7) = 0

[State -2, Disable Armour During Custom States]
type = VarSet
trigger1 = !var(19)
var(0) = -1

[State -2, Defence during custom states]
type = LifeAdd
triggerall = var(44)
triggerall = !var(19) || var(0) = -1
trigger1 = life > 1
trigger1 = life < var(31)
trigger1 = alive
value = (var(31) - life)/2 ;def
ignorehitpause = 1

[State -2, Var Helper]
type = Helper
trigger1 = !numhelper(9999)
id = 9999
stateno = 9999
ignorehitpause = 1
pausemovetime = 99999
supermovetime = 99999
ownpal = 0
postype = left
pos = 0, 128

[State -2, GetHit Sound]
type = StopSnd
triggerall = movetype = H
trigger1 = stateno != 9000
trigger1 = gethitvar(hitshaketime) = 1
trigger1 = !gethitvar(guarded) || stateno > 155
trigger2 = !var(19)
channel = 1
ignorehitpause = 1

[State Debug Info]
type = DisplayToClipboard
trigger1 = 1
text = "en.1 guard %d, armor %d, ai, %d, %f, %f"
params = var(3), var(44), var(18), p2bodydist x/const(size.xscale), p2dist y/const(size.yscale)
ignorehitpause = 1

[State -2, Custom State Detection]
type = VarSet
trigger1 = 1
var(19) = 0
ignorehitpause = 1

[State -2, Width Scale]
type = Width
trigger1 = statetype != A
player = floor(const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State -2, Width Scale]
type = Width
trigger1 = statetype = A
player = floor(const(size.air.front)*(const(size.xscale) - 1)), floor(const(size.air.back)*(const(size.xscale) - 1))

[State -2, Single Target Guarded]
type = VarAdd
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = numtarget(var(14)) = 1
triggerall = numenemy
triggerall = target(var(14)), gethitvar(guarded)
triggerall = var(6)
trigger1 = target(var(14)), id = var(2)
trigger1 = var(3) != -1
trigger2 = target(var(14)), id = var(4)
trigger2 = var(5) != -1
v = ifelse(target(var(14)), id = var(2), 3, 5)
value = var(6)
ignorehitpause = 1

[State -2, Multiple Targets Guarded]
type = null
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = numtarget(var(14)) > 1
triggerall = numenemy
triggerall = var(6)
;triggerall = target(var(14)), id = var(2) || target(var(14)), id = var(4)
trigger1 = var(3) != -1
trigger1 = enemy(0), gethitvar(guarded)
trigger1 = enemy(0), gethitvar(chainid) = var(14)
trigger1 = enemy(0), gethitvar(hitshaketime)
trigger1 = var(3) := var(3) + var(6)
trigger1 = 0
trigger2 = var(5) != -1
trigger2 = numenemy > 1
trigger2 = enemy(1), gethitvar(guarded)
trigger2 = enemy(1), gethitvar(chainid) = var(14)
trigger2 = enemy(1), gethitvar(hitshaketime)
trigger2 = var(5) := var(5) +  var(6)
trigger2 = 0
ignorehitpause = 1

[State -2, Single Target Guard Break]
type = TargetState
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = var(6)
triggerall = numtarget(var(14)) = 1
triggerall = target(var(14)), alive
triggerall = target(var(14)), gethitvar(guarded)
trigger1 = target(var(14)), id = var(2)
trigger1 = var(3) >= floor(target(var(14)), lifemax*target(var(14)), const(data.defence)*0.01)
trigger1 = var(3) := 0 || 1
trigger1 = var(7) := 1
trigger2 = target(var(14)), id = var(4)
trigger2 = var(5) >= floor(target(var(14)), lifemax*target(var(14)), const(data.defence)*0.01)
trigger2 = var(5) := 0 || 1
trigger2 = var(7) := 1
id = var(14)
value = 5400
ignorehitpause = 1

[State -2, Multiple Target Guard Break]
;Since TargetState can only affect ALL targets, only activates when both enemies meet criteria
;This means if only 1 can be broken, but both are hit at the same time, there will be no guard crush
type = TargetState
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = var(6)
triggerall = numtarget(var(14)) > 1
triggerall = numenemy > 1
trigger1 = enemy(0), alive
trigger1 = enemy(0), gethitvar(guarded)
trigger1 = enemy(0), gethitvar(chainid) = var(14)
trigger1 = enemy(0), gethitvar(hitshaketime)
trigger1 = enemy(1), alive
trigger1 = enemy(1), gethitvar(guarded) 
trigger1 = enemy(1), gethitvar(chainid) = var(14)
trigger1 = enemy(1), gethitvar(hitshaketime)
trigger1 = var(3) >= floor(enemy(0), lifemax*enemy(0), const(data.defence)*0.01)
trigger1 = var(5) >= floor(enemy(1), lifemax*enemy(0), const(data.defence)*0.01)
trigger1 = var(3) := 0 || 1
trigger1 = var(5) := 0 || 1
trigger1 = var(7) := 2
id = var(14)
value = 5400
ignorehitpause = 1

[State -2, Single Mode Guard Break Spark/Sound]
type = VarSet
trigger1 = var(7)
trigger1 = var(22)
trigger1 = numenemy = 1
var(7) = 0
ignorehitpause = 1

[State -2, Guard Break Spark]
type = Explod
trigger1 = numtarget(var(14)) = 1
trigger1 = var(7) = 1
id = 17008
anim = 17008
sprpriority = 5
bindtime = 1
pos = floor((target(var(14)), pos x - pos x)*facing - target(var(14)), const(size.ground.front) + 10), floor((target(var(14)), pos y - pos y) + target(var(14)), const(size.head.pos.y)*0.3 + target(var(14)), const(size.mid.pos.y)*0.7)
ignorehitpause = 1
supermovetime = 99999
pausemovetime = 99999
ownpal = 1

[State -2, Double Guard Break Spark]
type = Explod
trigger1 = numenemy
trigger1 = var(7) = 2
id = 17008
anim = 17008
sprpriority = 5
bindtime = 1
pos = floor((enemy(0), pos x - pos x)*facing - enemy(0), const(size.ground.front) + 10), floor((enemy(0), pos y - pos y) + enemy(0), const(size.head.pos.y)*0.3 + enemy(0), const(size.mid.pos.y)*0.7)
ignorehitpause = 1
supermovetime = 99999
pausemovetime = 99999
ownpal = 1


[State -2, Double Guard Break Spark]
type = Explod
trigger1 = numenemy > 1
trigger1 = var(7) = 2
id = 17008
anim = 17008
sprpriority = 5
bindtime = 1
pos = floor((enemy(1), pos x - pos x)*facing - enemy(1), const(size.ground.front) + 10), floor((enemy(1), pos y - pos y) + enemy(1), const(size.head.pos.y)*0.3 + enemy(1), const(size.mid.pos.y)*0.7)
ignorehitpause = 1
supermovetime = 99999
pausemovetime = 99999
ownpal = 1

[State -2, Guard Break Sound]
type = PlaySnd
trigger1 = numenemy > 1
trigger1 = numtarget(var(14)) = 1
trigger1 = var(7) = 1
trigger1 = var(7) := 0 || 1
value = 6, 2
abspan = floor(target(var(14)), pos x)
ignorehitpause = 1

[State -2, Double Guard Break Sounds]
type = PlaySnd
trigger1 = var(7) = 2
trigger1 = numenemy
value = 6, 2
abspan = floor(enemy(0), pos x)
ignorehitpause = 1

[State -2, Double Guard Break Sounds]
type = PlaySnd
trigger1 = var(7) = 2
trigger1 = var(7) := 0 || 1
trigger1 = numenemy > 1
value = 6, 2
abspan = floor(enemy(1), pos x)
ignorehitpause = 1

[State -2, Guard Break Reset]
type = VarSet
triggerall = var(7) := 0 || 1
trigger1 = !hitdefattr = SCA, AA
trigger2 = movecontact = 1 || projcontacttime(var(14)) = 0
var(6) = 0
ignorehitpause = 1

[State -2, Enemy 1 Guard Guage]
type = VarAdd
trigger1 = var(3) > 0
trigger1 = numenemy
trigger1 = enemy(0), statetype != A
trigger1 = enemy(0), movetype != H || enemy(0), statetype = L
var(3) = ifelse(var(3) > ceil(fvar(12)*15), -ceil(fvar(12)*15), -var(3))
ignorehitpause = 1

[State -2, Enemy 2 Guard Guage]
type = VarAdd
trigger1 = var(5) > 0
trigger1 = numenemy > 1
trigger1 = enemy(1), statetype != A
trigger1 = enemy(1), movetype != H || enemy(1), statetype = L
var(5) = ifelse(var(5) > ceil(fvar(12)*15), -ceil(fvar(12)*15), -var(5))
ignorehitpause = 1

[State -2, Single Mode Guard Break Spark/Sound]
type = VarSet
trigger1 = var(8)
var(8) = 0
ignorehitpause = 1

[State -2, Single Mode Guard Break Spark/Sound]
type = null
triggerall = numenemy = 1
trigger1 = enemy, id = var(2)
trigger1 = var(8) := floor(enemy, lifemax*enemy, const(data.defence)*0.01) - var(3)
trigger2 = enemy, id = var(4)
trigger2 = var(8) := floor(enemy, lifemax*enemy, const(data.defence)*0.01) - var(5)
ignorehitpause = 1

[State -2, GetHit Sound]
type = PlaySnd
triggerall = alive
trigger1 = movetype = H
trigger1 = stateno != 9000
trigger1 = gethitvar(hitshaketime) = 1
trigger1 = random < (gethitvar(animtype) + 1)*100
trigger1 = !gethitvar(guarded)
channel = 1
value = 5000, random%2
ignorehitpause = 1

[State -2, Movehit Var Reset]
type = VarSet
trigger1 = 1
var(26) = ifelse(movehit = 1 && (hitpausetime > var(28) || movetype != A), -1, 0)
ignorehitpause = 1

[State -2, Movehit Var Reset for Projcontact]
type = VarSet
trigger1 = projcontacttime(var(14)) = 0
var(26) = -1
ignorehitpause = 1

[State -2, Hitpause Var Reset]
type = VarSet
trigger1 = 1
var(28) = hitpausetime
ignorehitpause = 1

[State -2, FX Flag Reset]
type = VarSet
trigger1 = var(27) < 0
var(27) = 0
ignorehitpause = 1

[State -2, Fire FX]
type = Explod
trigger1 = var(27) = 1
trigger1 = var(26) = -1
trigger1 = numtarget(var(14))
trigger1 = var(26) := 2
id = 7050
anim = 7050 + random%3
sprpriority = 2
postype = p2
bindtime = 45 
pos = 0, floor(target(var(14)), const(size.mid.pos.y))
random = floor((target(var(14)), const(size.ground.front)+target(var(14)), const(size.ground.back))*(hitcount != 0)*0.4), floor((target(var(14)), const(size.mid.pos.y)-target(var(14)), const(size.head.pos.y))*(hitcount != 0)*0.8)
ignorehitpause = 1
ownpal = 1

[State -2, FX Sound]
type = PlaySnd
trigger1 = var(26) = 2
trigger1 = numtarget(var(14))
value = 5, 7 + var(27)
abspan = floor(target(var(14)), pos x)
ignorehitpause = 1
channel = 4

[State -2, FX Flag Invert]
type = VarSet
trigger1 = var(27) > 0
var(27) = -var(27)
ignorehitpause = 1

[State -2, Jump Buffer]
type = VarAdd
triggerall = var(15) > 0
trigger1 = var(15) > 1
trigger2 = command != "holddown"
var(15) = -1
ignorehitpause = 1

[State -2, Jump Buffer]
type = VarSet
triggerall = var(15) = 0
trigger1 = command = "holddown"
var(15) = 20
ignorehitpause = 1

[State -2, Hit Tracking]
type = VarSet
trigger1 = movecontact = 1
trigger2 = movereversed = 1
var(18) = animelemno(-1)
ignorehitpause = 1

[State -2, Juggle Flag]
type = VarSet
triggerall = var(43) := 0 || 1
triggerall = numtarget
trigger1 = numenemy = 1
trigger1 = target, statetype = A
trigger1 = target, movetype = H
trigger2 = numenemy > 1
trigger2 = enemynear(0), statetype = A
trigger2 = enemynear(0), movetype = H
trigger2 = enemynear(1), statetype = A
trigger2 = enemynear(1), movetype = H
var(43) = 1
ignorehitpause = 1

[State -2, NoGuard]
type = AssertSpecial
trigger1 = !var(17)
trigger2 = var(44)
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard
ignorehitpause = 1

[State -2, Hyper Armour Timer]
type = VarAdd
trigger1 = var(44)
trigger1 = !var(20)
trigger1 = stateno != 9000
trigger1 = roundstate = 2
var(44) = -1

[State -2, Hyper Armour Timer]
type = VarSet
trigger1 = var(44) < 2
trigger1 = var(0) = 220
var(44) = 2

[State -2, Hyper Armour]
type = HitOverride
trigger1 = var(44) > 1
trigger1 = alive
trigger1 = movetype != H || stateno = 9000
attr = SCA, AA, AP, NT, ST
stateno = 9000
ignorehitpause = 1

[State -2, Hyper Amour PalFX]
type = PalFx
trigger1 = var(44) > 1
;add = floor(sin(gametime*pi/30)*16) - 16, floor(sin(gametime*pi/30)*8) - 24, floor(sin(gametime*pi/30)*16) - 48
;mul = 526 + floor(sin(gametime*pi/30)*96), 256 + floor(sin(gametime*pi/30)*114), 56
;add = -floor(sin(gametime*pi/30)*8) + 16, floor(sin(gametime*pi/30)*8) - 24, -floor(sin(gametime*pi/30)*16)
;mul = 526 + floor(sin(gametime*pi/30)*96), 256 + floor(sin(gametime*pi/30)*114), 48 + floor(sin(gametime*pi/30)*16)
add = floor(sin(gametime*pi/30)*16) - 16, floor(sin(gametime*pi/30)*8) - 24, floor(sin(gametime*pi/30)*16) - 48
mul = 526 + floor(sin(gametime*pi/30)*96), 256 + floor(sin(gametime*pi/30)*114), 48 + floor(sin(gametime*pi/30)*16)
color = 128 - floor(sin(gametime*pi/30)*32)
time = 1
ignorehitpause = 1

[State -2, Hyper Amour No Power Gain]
type = PowerSet
triggerall = !var(20)
trigger1 = stateno = 9000
trigger1 = time < 1
trigger1 = var(44)
value = var(45)
ignorehitpause = 1

[State -2, Hyper Amour No Power Gain]
type = VarSet
trigger1 = !var(20)
var(45) = power
ignorehitpause = 1

[State -2, Life Var]
type = VarSet
trigger1 = 1
var(31) = life

[State -2, Hitstun Balance]
type = VarAdd
triggerall = var(53) < 600
trigger1 = movetype = H
trigger1 = gametime%3
trigger2 = stateno = [120, 155]
trigger2 = gametime%6
var(53) = 2
ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;==================================================================================
;======| RELACIONADO À AI - AI RELATED |===========================================
;==================================================================================

; Kamek and Luchini appear to have been the first ones to use the IsHomeTeam AI activation concept.
; Feel free to move this controller to your character's intro state for slightly better efficiency.
[State -3, SetAI]
type = VarSet
triggerall = !RoundState
triggerall = IsHomeTeam
trigger1 = (TeamSide = 2)
trigger2 = (MatchNo > 1)
var(59) = 1

; Feel free to move this controller to your character's intro state for slightly better efficiency.
; Note that it may give P2 a slight unfair advantage in simul team vs mode, so you
; may want to disable it.  But then, since when has Mugen been about fairness? =P
[State -3, Unfair]; Is this reliable?
type = VarSet
trigger1 = !RoundState
trigger1 = (var(59) != 1)
trigger1 = NumPartner
trigger1 = (ID > Partner,ID)
trigger1 = (TeamSide = 2)
var(59) = 1

[State -3, AI Helper (Compatibly Partnered Version)]
type = Helper
trigger1 = !var(59)
trigger1 = !NumHelper(9742)
trigger1 = (RoundState = 2)
trigger1 = Alive
trigger1 = NumPartner
trigger1 = Partner,SelfAnimExist(9741)
HelperType = normal
name = "AI Helper (Simul Version)"
ID = 9742
pos = 9999999,99999
StateNo = 9742
KeyCtrl = 1
PauseMoveTime = 999999999
SuperMoveTime = 999999999

; If you want to use the Guard mode, Dummy mode, Distance, or Button jam dummy control
; options in Training mode without activating the dummy's AI while working on your
; character, then all you need to do is temporarily disable this controller.
; Or, if you want to permanently disable this controller in Training mode,
; then you could use the Training mode detection code available on my site
; ( http://www.shinmugen.net/winane/ ), and then just add a "(var(59)&63)>30"
; triggerall to this controller.
[State -3, AI Helper]
type = Helper
triggerall = !var(59)
triggerall = !NumHelper(9741)
triggerall = (RoundState = 2)
triggerall = Alive
trigger1 = !NumPartner
trigger2 = !(Partner,SelfAnimExist(9741))
HelperType = normal
name = "AI Helper"
ID = 9741
pos = 9999999,99999
StateNo = 9741
KeyCtrl = 1
PauseMoveTime = 999999999
SuperMoveTime = 999999999

[State -3, TurnBackOnAI]
type = VarSet
trigger1 = (var(59) = -2)
trigger1 = (RoundState = 2)
trigger1 = Alive
var(59) = 1

[State -3, HitPauseTime Helper]
type = Helper
triggerall = var(59)!=1
triggerall = !NumHelper(9743)
triggerall = (RoundState = 2)
triggerall = Alive
trigger1 = (MatchNo = 1)
trigger2 = NumPartner
trigger2 = (ID > Partner,ID)
HelperType = normal
name = "HitPauseTime"
ID = 9743
pos = 9999999,99999
StateNo = 9743
PauseMoveTime = 999999999
SuperMoveTime = 999999999

; According to Roque, this method works in Linux Mugen version 2002.04.14,
; whereas the old humanly-impossible commands method does not.
; It is very important that this controller NOT be moved to State -2.
; Note that this part won't work if AI.Cheat is turned off in mugen.cfg.
[State -3, XOR]
type = VarSet
triggerall = var(59)!=1
triggerall = (var(57) = GameTime-1)
triggerall = NumHelper(9743)
triggerall = !(Helper(9743),var(1))
trigger1 = (command = "a") ^^ (command = "a2")
trigger2 = (command = "b") ^^ (command = "b2")
trigger3 = (command = "c") ^^ (command = "c2")
trigger4 = (command = "x") ^^ (command = "x2")
trigger5 = (command = "y") ^^ (command = "y2")
trigger6 = (command = "z") ^^ (command = "z2")
trigger7 = (command = "start") ^^ (command = "start2")
trigger8 = (command = "holda") ^^ (command = "holda2")
trigger9 = (command = "holdb") ^^ (command = "holdb2")
trigger10 = (command = "holdc") ^^ (command = "holdc2")
trigger11 = (command = "holdx") ^^ (command = "holdx2")
trigger12 = (command = "holdy") ^^ (command = "holdy2")
trigger13 = (command = "holdz") ^^ (command = "holdz2")
trigger14 = (command = "holdstart") ^^ (command = "holdstart2")
trigger15 = (command = "holdfwd") ^^ (command = "holdfwd2")
trigger16 = (command = "holdback") ^^ (command = "holdback2")
trigger17 = (command = "holdup") ^^ (command = "holdup2")
trigger18 = (command = "holddown") ^^ (command = "holddown2")
trigger19 = (command = "recovery") ^^ (command = "recovery2")
trigger20 = (command = "gekido") ^^ (command = "gekido2")
trigger21 = (command = "kobushichigirix") ^^ (command = "kobushichigirix2")
trigger22 = (command = "kobushichigiriy") ^^ (command = "kobushichigiriy2")
trigger23 = (command = "kobushichigiriz") ^^ (command = "kobushichigiriz2")
trigger24 = (command = "doatsuryux") ^^ (command = "doatsuryux2")
trigger25 = (command = "doatsuryuy") ^^ (command = "doatsuryuy2")
trigger26 = (command = "doatsuryuz") ^^ (command = "doatsuryuz2")
trigger27 = (command = "daibustudena") ^^ (command = "daibustudena2")
trigger28 = (command = "daibustudenb") ^^ (command = "daibustudenb2")
trigger29 = (command = "daibustudenc") ^^ (command = "daibustudenc2")
trigger30 = (command = "maggakashiwadea") ^^ (command = "maggakashiwadea2")
trigger31 = (command = "maggakashiwadeb") ^^ (command = "maggakashiwadeb2")
trigger32 = (command = "maggakashiwadec") ^^ (command = "maggakashiwadec2")

;Add more as desired. (See my notes in the CMD.)
var(59) = 1

; It is very important that this controller NOT be moved to State -2, as putting
; it there would defeat the entire purpose of the controller, allowing the
; helper method or the XOR method to erroneously set the AI variable.
; And within State -3, don't put any ChangeState controllers before this
; controller, lest you unnecessarily delay your character's AI activation.
[State -3, GameTimeVar]
type = VarSet
trigger1 = 1
var(57) = GameTime
IgnoreHitPause = 1

; Within StateDef -3, none of your own AI-related code should come after the code
; provided here (and putting it before the code is also generally a bad idea).
; It's better to use State -1 (or, in special circumstances, State -2) instead.

;==================================================================================
;==================================================================================
;==================================================================================

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
trigger3 = stateno = 1052
value = 52, 0

[State -3, VarSet]
type = VarSet
trigger1 = MoveType != H
var(0) = StateNo 

[State -3, VarSet]
type = VarSet
trigger1 = MoveType != H || stateno = [120, 155]
fvar(0) = vel x

[State -3, VarSet]
type = VarSet
trigger1 = MoveType != H || stateno = [120, 155]
fvar(1) = vel y

[State -3, Custom State Detection]
type = VarSet
trigger1 = 1
var(19) = 1
