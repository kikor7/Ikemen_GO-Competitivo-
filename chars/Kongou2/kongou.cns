[State 800, 2]
type = HitDef
getpower = 30,15
trigger1 = movehit || movereversed
trigger1 = numtarget
trigger1 = p2bodydist x < 104.0*const(size.xscale)
id = 800
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M          ;Affect only ground people who are not being hit
numhits = 0
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
sprpriority = -1
hitsound   = s8,0
;p1facing = ifelse (command != "holdback", 1,- 1) ;Turn if holding forwards
p2facing = 1          ;Force p2 to face player
p1stateno = 810       ;On success, player changes to state 810
p2stateno = 820       ;If hit, p2 changes to state 820 in player's cns
fall = 1              ;Force p2 into falling down
yaccel = .536
fall.recover = 0;

[State 800, StateTypeSet]
type = StateTypeSet
trigger1 = animelemno(0) > 38
movetype = I
persistent = 0

