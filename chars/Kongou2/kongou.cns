trigger1 = gethitvar(damage)/2 >= life
trigger2 = statetype != A
trigger2 = pos y < 0
value = 5000
ignorehitpause = 1

[State 9000, PosFreeze]
type = PosFreeze
trigger1 = 1
value = 1
ignorehitpause = 1

[State 9000, Turn]
