;Vars:
;	0  = superarmour state no.
;	1  = superarmour ticks
;	2  = enemy 1 id
;	3  = enemy 1 guardcrush guage
;	4  = enemy 2 id
;	5  = enemy 2 guardcrush guage
;	6  = guard break strength
;	7  = guard break sound trigger
;	8  = guard crush fx check
;	9  = armour level
;	10 = gethitvar(damage)

;	11 = temp var
;	12 = temp var

;	13 = l/m/h var

;	14 = id of most recent hitdef
;	15 = highjump buffer
;	16 = custom gameplay on/off
;	17 = guarding on/off
;	18 = hit tracking
;	19 = custom state detection
;	20 = gekido setting

;	22 = warzard hitsparks off/on

;	25 = hitsound flag
;	26 = movehit/fx sound flag
;	27 = fx element flag
;	28 = previous hitpausetime

;	31 = life last frame
;	32 = previous facing

;	43 = juggle flag
;	44 = hyper armour timer
;	45 = previous power

;	53 = hitstun balance

;	57 = (Winane) GameTime var, for pause and custom state check
;	58 = ai action select
;	59 = (Winane) AI

;Fvars:
;	0  = superarmour vel x
;	1  = superarmour vel y
;	2  = superarmour hitvel x
;	3  = temp var
;	4  = temp var
;	5  = math var
;	6  = math var
;	7  = superarmour combined vel x

;	10 = AI aggression setting

;	12 = guard crush strength setting

;       39 = AI guard jump/crouch response

;Channels:
;	1 = voice
;	2 = swing
;	3 = smash
;	4 = fx

; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1350			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 1		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 200			;Volume offset (negative for softer)
IntPersistIndex = 58	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
;Adapted scale large (direct conversion from CPS-3)
	xscale=0.83333333333333333333333333333333
	yscale=1.0714285714285714285714285714286

;Adapted scale small (bit smaller to avoid pixellation)
;	xscale = 0.801           ;Horizontal scaling factor.
;	yscale = 1

;Original scale (no scaling, may appear "squashed")
;	xscale = 1           ;Horizontal scaling factor.
;	yscale = 1           ;Vertical scaling factor.

ground.back = 32		;Player width (back, ground)
ground.front = 32		;Player width (front, ground)
air.back = 20		;Player width (back, air)
air.front = 20		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 240		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 1		;Set to 1 to scale projectiles too   
head.pos = 20, -140	;Approximate position of head
mid.pos = 0, -85		;Approximate position of midsection
shadowoffset = -3		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 8		;Walk forward
walk.back = -8		;Walk backward
run.fwd  = 16, 0		;Run forward (x, y)
run.back = 0,0	;Hop backward (x, y)
jump.neu = 0,-10.8		;Neutral jumping velocity (x, y)
jump.back = -2.5		;Jump back Speed (x, y)
jump.fwd = 2.5		;Jump forward Speed (x, y)
runjump.back = -3,-10.8;Running jump speeds (opt)
runjump.fwd = 3,-10.8	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .536		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, RoundNotOver]
type = AssertSpecial
trigger1 = time < 150
flag = RoundNotOver

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = ifelse(random%2, 180, 210), 0
channel = 1

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0
sprpriority = -1

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
trigger1 = animelem = 2
value = 190

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 1]
type = ChangeAnim
trigger1 = anim = 190
trigger1 = !animtime
value = 191

[State 190, SprPriority]
type = SprPriority
trigger1 = anim = 191
trigger1 = animelem = 11
value = 0

[State 190, 4]
type = ChangeAnim
trigger1 = anim = 191
trigger1 = !animtime
value = 0

[State 190, 4]
type = ChangeState
trigger1 = anim = 0
trigger1 = animelemno(0) > 15
value = 0

[State 190, EnvShake]
type = EnvShake
trigger1 = anim = 191
trigger1 = animelemno(0) = [11, 24]
trigger1 = gametime%4 = 0
time = 4
freq = 90
ampl = 3

[State 190, EnvShake]
type = EnvShake
trigger1 = anim = 191
trigger1 = animelemno(0) = [25, 27]
trigger1 = gametime%4 = 0
time = 4
freq = 90
ampl = 2

[State 190, EnvShake]
type = EnvShake
trigger1 = anim = 191
trigger1 = animelemno(0) = [28, 30]
trigger1 = gametime%4 = 0
time = 4
freq = 90
ampl = 1

[State 190, PlaySnd]
type = PlaySnd
trigger1 = anim = 191
trigger1 = animelem = 9
value = 190, 0
channel = 1

[State 190, PlaySnd]
type = PlaySnd
trigger1 = anim = 191
trigger1 = animelem = 9
value = 190, 1
channel = 2

;---------------------------------------------------------------------------
; Taunt
; CNS difficulty: easy
[Statedef 195]
type = S
ctrl = 0
velset = 0,0
movetype = I
physics = S
sprpriority = -1
hitdefpersist = 1
movehitpersist = 1

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
trigger1 = var(11) := 0 || 1
trigger1 = var(12) := 0 || 1
value = 195

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(7)*(prevstateno = 9000)
y = fvar(1)*(prevstateno = 9000)

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 195, PlaySnd]
type = PlaySnd
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 210, 0
channel = 1

;---------------------------------------------------------------------------
; Standing Light Punch
; CNS difficulty: easy
[Statedef 200]
type    = S
movetype= A
physics = S
ctrl = 0
sprpriority = -1
movehitpersist = 1

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
trigger1 = var(11) := 0 || 1
trigger1 = var(12) := 0 || 1
value = 200

[State Armour PowerAdd]
type = PowerAdd
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 40*(var(44) = 0)

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(7)*(prevstateno = 9000)
y = fvar(1)*(prevstateno = 9000)

[State 200, Width]
type = Width
trigger1 = animelemno(0) = [1, 16]
player = floor(-8*const(size.xscale) + const(size.ground.front)*(const(size.xscale) - 1)), floor(8*const(size.xscale) + const(size.ground.back)*(const(size.xscale) - 1))

[State 200, Width]
type = Width
trigger1 = animelemno(0) = [17, 20]
trigger2 = animelemno(0) = [57, 61]
player = floor(16*const(size.xscale) + const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State 200, Width]
type = Width
trigger1 = animelemno(0) = [21, 24]
player = floor(24*const(size.xscale) + const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State 200, Width]
type = Width
trigger1 = animelemno(0) = [25, 56]
player = floor(32*const(size.xscale) + const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State 200, 1]
type = HitDef
triggerall = var(22)
triggerall = !var(43)
trigger1 = !var(18)
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
attr = S, NA
damage = 140, 28*(var(44) != 0)
getpower = 30,15
animtype = Heavy
guardflag = MA
hitflag = MA
pausetime = 13, 13
sparkno = s17002
guard.sparkno = s17006 + 2*(numenemy = 1 && var(8) - var(6) < 1)
sparkxy = ifelse(p2bodydist x < 40, ifelse(p2bodydist x < 0, -50, ceil(p2bodydist x - 50)), -10), floor(-96.0*const(size.yscale))
hitsound   = s5,2
guardsound = s6,0 + 2*(numenemy = 1 && var(8) - var(6) < 1)
ground.type = High
ground.velocity = -10
ground.hittime  = 20
ground.slidetime  = 20
guard.hittime = 19
air.hittime = 999
airguard.ctrltime = 999
air.type = Low
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
sprpriority = 2

[State 200, 1]
type = HitDef
triggerall = !var(22)
triggerall = !var(43)
trigger1 = !var(18)
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
