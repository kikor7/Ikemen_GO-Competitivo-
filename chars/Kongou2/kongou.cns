[State 9000, VarSet]
type = VarSet
trigger1 = time = 0
var(10) = 0
ignorehitpause = 1

[State 9000, Hyper Armour]
type = LifeAdd
trigger1 = time = 1
trigger1 = var(10)
value = var(10)
ignorehitpause = 1

[State 9000, VarSet]
type = Null
triggerall = gethitvar(damage) > 0
triggerall = time = 0
trigger1 = var(0) = 2000
trigger1 = life + gethitvar(damage) > lifemax
trigger1 = var(10) := gethitvar(damage)
trigger2 = var(44)
trigger2 = life + gethitvar(damage)/2 > lifemax ;def
trigger2 = var(10) := gethitvar(damage)/2 ;def
ignorehitpause = 1

[State 9000, Hyper Armour] ;No damage during Gekido
type = LifeAdd
trigger1 = time = 0
trigger1 = gethitvar(damage) > 0
trigger1 = !var(10)
trigger1 = var(0) = 2000
trigger1 = life + gethitvar(damage) <= lifemax
value = gethitvar(damage)
ignorehitpause = 1

[State 9000, Hyper Armour] ;Half damage afterwards
type = LifeAdd
trigger1 = time = 0
trigger1 = gethitvar(damage) > 0
trigger1 = !var(10)
trigger1 = var(0) != 2000
trigger1 = var(44)
trigger1 = gethitvar(damage)/2 < life ;def
trigger1 = life + gethitvar(damage)/2 <= lifemax ;def
value = ifelse( gethitvar(damage) > life, life - gethitvar(damage)/2, gethitvar(damage)/2 ) ;def
ignorehitpause = 1

