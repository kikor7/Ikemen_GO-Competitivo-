trigger1 = gethitvar(hitshaketime)
value = Anim
elem = AnimElemNo(-1) ;-(anim > 99 || (anim = [41, 46]))

[State 9000, Dead]
type = ChangeState
trigger1 = !alive
value = 5000

[State 9000, PalFX]
type = PalFx
trigger1 = time < 2
add = 8, 8, 8
mul = 384, 640, 768
color = 0
time = 1
