;------------------
; 昇龍パンチ小 - jump

[Statedef 1051]
type    = A
movetype= A
physics = A
juggle  = 4
velset = 0,-1
anim = 1051

[State 1051, move]
type = velset
trigger1 = time = 2
y = -12

[State 1051,1] ;攻撃
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
attr = A, SA                     ;技の属性
damage = 83-(var(10)*3), 21      ;ダメージ(ヒット,ガード)
animtype = up                    ;くらい属性(ダウンの有無は別項目)
guardflag = M                    ;ガード属性
hitflag = MAF                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 12, 12               ;硬直時間(相手,自分)ヒットストップ
sparkno = 1                      ;Spark anim no (Def: set above)
sparkxy = -10, -130              ;ヒットスパークの表示位置(-10,-高さ)
hitsound = 5, 2
guardsound = 6, 0
ground.type = High               ;くらい動作のアニメを指定
ground.slidetime = 23
ground.hittime  = 40             ;重要。短いと反撃し放題。
air.hittime = 40
ground.velocity = -4,-16
air.velocity = -4,-16
guard.hittime = 23             ;ガード硬直(のけぞりと別に設定できる)
guard.velocity = -12             ;ガード後退速度(地上転倒なので設定)
fall = 1                         ;ダウン
getpower = 60,30;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 1051, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 2
movetype = I

[State 1051, 4] ;次の着地ステートへ
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= -5
value = 1052

[State 1051, 6]
type = PlaySnd
trigger1 = Time = 0
value = 100, 0

