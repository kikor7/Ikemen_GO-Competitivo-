;
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "usagi_kun"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "usagi kun"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 00,00,0000   ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 00,00,0000   ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Meitoru"    ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6  ;ＣＰＵで出てきた時のカラーパレットの順番

;--| 必要なファイルの設定 |---------------------------------------------------

[Files]
movelist = movelist.dat
Cmd     = usagi_kun.cmd       ;コマンドファイルの登録
Cns     = usagi_kun.cns       ;コンスタンツファイルの登録
St      = usagi_kun.cns       ;ステートファイルの登録・最大１１個まで増やせます
StCommon = common1.cns        ;コモンステートファイルの登録
Sprite  = usagi_kun.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = usagi_kun.air       ;アニメーションファイルの登録
Sound   = usagi_kun.snd             ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

;--| カラーパレットファイル |-------------------------------------------------

Pal1 = usagi_kun01.act  ;Ａ黒
Pal2 = usagi_kun02.act  ;Ｂ青
Pal3 = usagi_kun03.act  ;Ｃ黄
Pal4 = usagi_kun04.act  ;Ｘ緑
Pal5 = usagi_kun05.act  ;Ｙ赤
Pal6 = usagi_kun06.act  ;Ｚ白

;Pal7 =   ;Ｓ押しながらＡボタンで決定した色が使えます
;Pal8 =   ;Ｓ押しながらＢ
;Pal9 =   ;Ｓ押しながらＣ
;Pal10=   ;Ｓ押しながらＸ
;Pal11=   ;Ｓ押しながらＹ
;Pal12=   ;Ｓ押しながらＺ

