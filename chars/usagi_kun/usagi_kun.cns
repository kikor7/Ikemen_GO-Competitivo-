;■ハイパーアーマー
[Statedef 9000]; アーマー判定ヘルパー
type = A
movetype = I
physics = N

[State 9000, 0]; 不具合対策
type = ChangeState
trigger1 = !IsHelper
value = 0
ctrl = 1

[State 9000, 0]; アーマー化した瞬間に重複被弾しないための無敵
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 1

[State 9000, 0]; 投げ無敵
type = NotHitBy
trigger1 = Time >= 1
value = ,AT
time = 2

[State 9000, 0]; 透明＋影消し
type = AssertSpecial
trigger1 = 1
flag = Invisible
flag2 = NoShadow

[State 9000, 0]; 本体に追従
type = BindToParent
trigger1 = 1
time = 1
facing = 1
pos = 0,0

[State 9000, 0]; 判定を揃える
type = ChangeAnim
trigger1 = SelfAnimExist(Parent,Anim)
value = Parent,Anim
elem = Parent,AnimElemNo(0)

[State 9000, 0]; 打撃／飛び道具を受けたらステートを繰り返す
type = HitOverRide
trigger1 = IsHelper(9000)
attr = SCA,AA,AP
stateno = 9000

[State 9000, 0]; 本体がアーマーパートを過ぎたら消滅
type = DestroySelf
trigger1 = Parent,StateNo != 1030
trigger1 = Parent,StateNo != 1031

;=====================================================================
; 常時監視ステート（－２）
;=====================================================================
;---------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------

[Statedef -2]

[State -2, ■デバック(変数確認)]
Type = DisplayToClipBoard
Trigger1 = 1
Text = "AI=%d,DMG:%6.2f"
Params = var(59),fvar(10)*100
IgnoreHitPause = 1

[State -2, ■距離確認デバック]
type = AppendToClipboard
trigger1 = 1
text =  "P2X:%f,P2Y:%f,Vx%f,Vy%f,Py%f \n"
params = P2BodyDist x,P2BodyDist y,vel x,vel y,Pos y
IgnoreHitPause = 1

;---------------------------------------------------------------------
;■ダメージ補正

[State -2, VarSet];最大値は100％
Type = VarSet
Trigger1 = FVar(10) != 1.00
Trigger1 = !(P2MoveType = H && (P2StateNo != [150,159]))
IgnoreHitPause = 1
FV = 10
Value = 1.00

[State -2, VarSet];最小値は１％
Type = VarSet
Trigger1 = FVar(10) < 0.01
IgnoreHitPause = 1
FV = 10
Value = 0.01

;---------------------------------------------------------------------
;■根性値

[State -2, 0]
type = DefenceMulSet
trigger1 = Life <= 500 && Life >= 301
value = 0.9

[State -2, 0]
type = DefenceMulSet
trigger1 = Life <= 300 && Life >= 201
value = 0.7

[State -2, 0]
type = DefenceMulSet
trigger1 = Life <= 200
value = 0.5


;---------------------------------------------------------------------

[State -2, ■起き上がり遅延時間の設定]
Type = VarSet
Trigger1 = MoveType != H
var(9) = 60

[State -2, ■空中ダッシュ制御用]
type =   Varset
trigger1 = Statetype != A
var(10) =   0 ;回数を0にする

[State -2, ■ジャンプ上くるくる制御用]
type =   Varset
trigger1 = Statetype != A
var(11) =   0 ;回数を0にする

[State -2, ■ジャンプ前くるくる制御用]
type =   Varset
trigger1 = Statetype != A
var(12) =   0 ;回数を0にする

[State -2, ■ジャンプ前バチン制御用]
type =   Varset
trigger1 = Statetype != A
var(13) =   0 ;回数を0にする

[State -2, ■ジャンプ下]
type =   Varset
trigger1 = Statetype != A
var(14) =   0 ;回数を0にする

[State -2, ■ジャンプ強叩き]
type =   Varset
trigger1 = Statetype != A
var(15) =   0 ;回数を0にする

;---------------------------------------------------------------------

[State -2, ■アーマーヘルパー呼び出し]
type = Helper
triggerall = !NumHelper(9000) && MoveType != H
trigger1 = StateNo = 1030 && Time = 11
trigger2 = StateNo = 1031 && Time = 1
name = "Armor"
stateno = 9000
ID = 9000
size.xscale = 1
size.yscale = 1
postype = p1
pos = 0,0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999

[State -2, アーマー中の投げ以外無敵]
type = NotHitBy
trigger1 = NumHelper(9000)
value2 = ,AA,AP
time = 2

[State -2, アーマー中に被弾した時の無敵時間延長（２重被弾抑制処置）]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = SCA
time = Helper(9000),GetHitVar(hitshaketime)+5

[State -2, アーマー受けした時の点滅]
type = PalFX
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
time = 5
add = 256,10,10

[State -2, アーマー受けした時のライフ減少]
type = LifeAdd
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = -1*Helper(9000),GetHitVar(damage)
absolute = 1
ignorehitpause = 1

;---------------------------------------------------------------------

[State -2, ■喰らいボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 480
trigger1 = stateno = 5000  ;立ち
trigger2 = stateno = 5010 ;屈み
trigger3 = stateno = 5020 ;跳び
value = S10, 4
volume = 300
channel = 0
lowpriority = 1

[State -2, ■喰らいボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Random > 480
trigger1 = stateno = 5000  ;立ち
trigger2 = stateno = 5010 ;屈み
trigger3 = stateno = 5020 ;跳び
value = S10, 3
volume = 300
channel = 0
lowpriority = 1

[State -2, ■ガードボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Random <= 480
trigger1 = stateno = 150  ;立ち
trigger2 = stateno = 152 ;屈み
trigger3 = stateno = 154 ;跳び
value = S10, 5
volume = 300
channel = 0
lowpriority = 1

[State -2, ■ガードボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Random > 480
trigger1 = stateno = 150  ;立ち
trigger2 = stateno = 152 ;屈み
trigger3 = stateno = 154 ;跳び
value = S10, 6
volume = 300
channel = 0
lowpriority = 1

;=====================================================================
; 準常時監視ステート（－３）
;=====================================================================
;---------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------

[Statedef -3]

■AI
[State -3, AI起動用ヘルパー]
type=helper
trigger1=!NumHelper(10001+id)
Trigger1=RoundState<2||(RoundState=2&&Ctrl&&Stateno=0)
trigger1=alive
trigger1=var(59)=0
Trigger1=(PrevStateNo=[190,195])||PrevStateNo=5900||PrevStateNo=0
Trigger1=!IsHelper
helpertype=normal
name="AI"
stateno=10001
ID=10001+id
pos=9999,9999
keyctrl=1
pausemovetime=2147483647
