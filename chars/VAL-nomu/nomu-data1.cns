
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------必殺技
; レインボーアイズ小

[Statedef 1000]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 0,0
poweradd= 20 -(Var(13)*1000)
anim = 1000
ctrl = 0
sprpriority = 2

[State 1000, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1000, 0

[State 1000, 2]
type = Helper       ;Helperを飛び道具として使う
trigger1 = AnimElem = 2       ;飛び道具発射
helpertype = normal
name = "tama1"       ;任意の名前
ID = 1010
stateno = 1010       ;飛び道具のステートナンバー
pos = 152,-119       ;出現座標
postype = p1       ;出現座標の基準(プレイヤー1)
supermovetime = 0       ;暗転した際に動けなくなる時間
pausemovetime = 0       ;停止した際に動けなくなる時間
OwnPal = 1 ;独自パレット

[State 1000, 残像発生]
type = AfterImage
trigger1 = Var(13) = 1
trigger1 = time = 0
time = 50

[State 1000, StateTypeSet]
type = StateTypeSet
trigger1 = time > 13
movetype = I

[State 1000, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; レインボーアイズ小飛び道具
[Statedef 1010]
type = A
movetype = A
velset = 0,0       ;速度(根元で少しとどまる)
physics = N       ;摩擦、重力を無視
juggle  = 4       ;本体とは別
anim = 1010
ctrl = 0
sprpriority = 3

[State 1010,1]
type = velset       ;速度の変更
trigger1 = time = 2
x = 8

[State 1010,3]
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
attr = A, SP                     ;技の属性(ヘルパーは画面端の押し戻しが適用されるので空中属性に)
damage = 53*(64-((Root,Var(4))))/64, 13 ;ダメージ(ヒット,ガード)
animtype = Medium                ;くらい属性(ダウンの有無は別項目)
guardflag = MA                   ;ガード属性
hitflag = MAFP                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 0, 0                 ;硬直時間(相手,自分)(ヒットストップ中に飛び道具が消えたままなので短く)
sparkno = S9999                  ;Spark anim no (空の値を指定)
ground.type = high               ;くらい動作のアニメを指定
ground.slidetime = 24            ;摩擦を無視する時間
ground.hittime  = 24             ;のけぞり時間
ground.velocity = (Root,fVar(1)) ;地上で攻撃を受けた時、相手が飛んでいく速度
air.hittime = 30
air.velocity = -4+((Root,Var(13))*8),-8 ;(ガーキャン時ふっとび速度を増加)
guard.hittime = 24             ;ガード硬直(のけぞりと別に設定できる)
guard.velocity = (Root,fVar(1))  ;ガード後退速度
fall = (Root,Var(13))            ;ダウン(ガーキャン時1が適用される)
getpower = 30,15;p1ゲージ追加増加量
givepower = 30,30                ;p2ゲージ増加量

[State 1010,5]
type = hitoverride               ;攻撃を食らった時に任意のステートへ
trigger1 = 1
attr = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP
stateno = 1030                   ;消滅用のステート
time = 1
IgnoreHitPause = 1

[State 1010,6]
type = changestate
trigger1 = movecontact = 1         ;飛び道具が相手に触れた時
trigger2 = frontedgebodydist < -50 ;正面の画面端を25ドット通り過ぎた時
value = 1030                     ;消滅用のステート
IgnoreHitPause = 1

[State 1010, 7]               ;飛び道具のみをくらう事を許可
type = HitBy
trigger1 = 1
value = SCA,AP

[State 1010,影を消す]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow
IgnoreHitPause = 1

;---------------------------------------------------------------------------
; レインボーアイズ小飛び道具消滅
[Statedef 1030]
type = A
movetype = I
velset = 0,0
pos = 152,-119       ;出現座標
physics = N
anim = 1030
ctrl = 0
sprpriority = 3

[State 1030, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = p2movetype = H && p2stateno != [120,153]
trigger1 = frontedgebodydist > -50
value = f5, 2

[State 1030, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = p2movetype = H && p2stateno = [120,153]
trigger1 = frontedgebodydist > -50
value = f6, 0

[State 1030]
type = destroyself
trigger1 = animtime = 0

[State 1030,影を消す]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow
IgnoreHitPause = 1

[State 1030, NotHitBy] ;無敵
type = NotHitBy
trigger1 = 1
value = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP

