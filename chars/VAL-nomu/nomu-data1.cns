;  - Jump

[Statedef 1306]
type    = A
movetype= I
physics = N
velset = -3,1
anim = 1201
ctrl = 0
sprpriority = 2

[State 1306, move]
type = VelAdd
trigger1 = AnimElemTime(2) >= 0
y = Const(movement.yaccel)

[State 1306, 4] ;次の着地ステートへ
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= -5
value = 1202

