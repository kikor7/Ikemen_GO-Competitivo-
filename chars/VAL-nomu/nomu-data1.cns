[State 1302, 1] ;Reset y-position to ground level
type = PosSet
trigger1 = Time = 0
y = 0

[State 1302, 2] ;Play a sound for landing
type = PlaySnd
trigger1 = Time = 0
value = 40, 0

[State 1302, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; 空中グランドレインボーアイズ小飛び道具
[Statedef 1310]
type = A
movetype = A
velset = 0,0       ;速度(根元で少しとどまる)
physics = N       ;摩擦、重力を無視
juggle  = 4       ;本体とは別
anim = 1310
ctrl = 0
sprpriority = 2

[State 1310,1]
type = velset       ;速度の変更
trigger1 = time = 2
x = 7
y = 6

[State 1310,3]
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
attr = A, SP                     ;技の属性(ヘルパーは画面端の押し戻しが適用されるので空中属性に)
damage = 53*(64-((Root,Var(4))))/64, 13 ;ダメージ(ヒット,ガード)
animtype = Medium                ;くらい属性(ダウンの有無は別項目)
guardflag = MA                   ;ガード属性
hitflag = MAFDP                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 0, 0                 ;硬直時間(相手,自分)(ヒットストップ中に飛び道具が消えたままなので短く)
sparkno = S9999                  ;Spark anim no (空の値を指定)
ground.type = high               ;くらい動作のアニメを指定
ground.slidetime = 19            ;摩擦を無視する時間
ground.hittime  = 19             ;のけぞり時間
ground.velocity = (Root,fVar(1)) ;地上で攻撃を受けた時、相手が飛んでいく速度
air.hittime = 30
air.velocity = -4,-8             ;
guard.hittime = 19             ;ガード硬直(のけぞりと別に設定できる)
guard.velocity = (Root,fVar(1))  ;ガード後退速度
fall = (Root,Var(13))            ;ダウン(ガーキャン時1が適用される)
getpower = 30,15;p1ゲージ追加増加量
givepower = 30,30                ;p2ゲージ増加量

[State 1310,5]
type = hitoverride               ;攻撃を食らった時に任意のステートへ
trigger1 = 1
attr = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP
stateno = 1330                   ;消滅用のステート
time = 1
IgnoreHitPause = 1

[State 1310,6]
type = changestate
trigger1 = movecontact = 1         ;飛び道具が相手に触れた時
trigger2 = frontedgebodydist < -50 ;正面の画面端を25ドット通り過ぎた時
trigger3 = Vel Y > 0 && Pos Y >= -5
value = 1330                     ;消滅用のステート
IgnoreHitPause = 1

[State 1310, 7]               ;飛び道具のみをくらう事を許可
type = HitBy
trigger1 = 1
value = SCA,AP

[State 1310,影を消す]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow
IgnoreHitPause = 1

;---------------------------------------------------------------------------
; 空中グランドレインボーアイズ小飛び道具消滅
[Statedef 1330]
type = A
movetype = I
velset = 0,0
pos = 86,-34       ;出現座標
physics = N
anim = 1030
ctrl = 0
sprpriority = 2

[State 1330, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = p2movetype = H && p2stateno != [120,153]
trigger1 = frontedgebodydist > -50
trigger1 = pos y < -5
value = f5, 2

[State 1330, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = p2movetype = H && p2stateno = [120,153]
trigger1 = frontedgebodydist > -50
trigger1 = pos y < -5
value = f6, 0

[State 1330]
type = destroyself
trigger1 = animtime = 0

[State 1330,影を消す]
Type = AssertSpecial
Trigger1 = 1
Flag = NoShadow
IgnoreHitPause = 1

[State 1330, NotHitBy] ;無敵
type = NotHitBy
trigger1 = 1
value = SCA, NT, ST, HT, NA, SA, HA,NP,SP,HP

