;------------------
; ジョーブローカー小 - jump

[Statedef 1051]
type    = A
movetype= A
physics = A
juggle  = 2
velset = 3,-15
anim = 1051

[State 1051, move]
type = velset
trigger1 = var(11) = 1
trigger1 = AnimElem = 1
x = 2
y = -10

[State 1051,1] ;攻撃
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
trigger2 = AnimElem = 2          ;トリガー、アニメ何枚目
triggerall = var(2) = 0          ;スカらせフラグが否
attr = A, SA                     ;技の属性
damage = 68, 17 ;ダメージ(ヒット,ガード)
animtype = up                    ;くらい属性(ダウンの有無は別項目)
guardflag = MA                    ;ガード属性
hitflag = MAF                    ;ヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;相打ちの優先順位
pausetime = 8, 8               ;硬直時間(相手,自分)ヒットストップ
sparkno = 1                      ;Spark anim no (Def: set above)
sparkxy = -10, -130              ;ヒットスパークの表示位置(-10,-高さ)
hitsound = 5, 2
guardsound = 6, 0
ground.type = High               ;くらい動作のアニメを指定
ground.slidetime = 23
ground.hittime  = 45             ;重要。短いと反撃し放題。(自キャラ36フレーム目に着地)
air.hittime = 45
ground.velocity = -4,-18
air.velocity = -4,-18
guard.hittime = 23             ;ガード硬直(のけぞりと別に設定できる)
guard.velocity = -12             ;ガード後退速度(地上転倒なので設定)
fall = 1                         ;ダウン
getpower = 60,30;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 1051, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 3
movetype = I

[State 1051,HitOverride] ;サマソ一段目が打ち負けたら空中ガードを上書きする。
type = HitOverride               ;攻撃を食らった時に任意のステートへ
triggerall = alive
trigger1 = AnimElem = 1          ;トリガー、アニメ何枚目
attr =  A, NA, SA, HA,
stateno = 1053                   ;とりあえず経由してガードステートへ
time = 4 
forceair = 0

[State 1051, 4] ;次の着地ステートへ
type = ChangeState
trigger1 = Vel Y > 0 && Pos Y >= -5
value = 1052

[State 1051, 6]
type = PlaySnd
trigger1 = Time = 0
value = 1000, 2

