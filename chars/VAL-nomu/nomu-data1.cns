;---------------------------------------------------------------------------
; 空中グランドレインボーアイズ大

[Statedef 1305]
type    = A
movetype= A
physics = N
velset = 0,0
juggle  = 4
poweradd= 20 -(Var(13)*1000)
anim = 1300
ctrl = 0
sprpriority = 2

[State 1305, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1000, 0

[State 1305, 2]
type = Helper       ;Helperを飛び道具として使う
trigger1 = AnimElem = 2       ;飛び道具発射
helpertype = normal
name = "a_tama2b"       ;任意の名前
ID = 1315
stateno = 1315       ;飛び道具のステートナンバー
pos = 86,-34       ;出現座標
postype = p1       ;出現座標の基準(プレイヤー1)
facing = 1        ;相手の方を向く
supermovetime = 0       ;暗転した際に動けなくなる時間
pausemovetime = 0       ;停止した際に動けなくなる時間
OwnPal = 1 ;独自パレット

[State 1305, 残像発生]
type = AfterImage
trigger1 = Var(13) = 1
trigger1 = time = 0
time = 16

[State 1305, 5]
type = ChangeState
trigger1 = AnimTime = 0
trigger2 = AnimElem = 3 && var(14)>0
value = 1306

