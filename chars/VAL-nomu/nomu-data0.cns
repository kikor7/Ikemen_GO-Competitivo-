
;---------------------------------------------------------------------------通常技
; Stand Light Punch

[Statedef 200]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown立屈空ダウン
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit攻撃、待機、くらい
physics = S                      ;Physics: S-stand, C-crouch, A-air摩擦や重力(Nで無視)
juggle  = 1                      ;Number of air juggle points move takesおてだま
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)移動速度
ctrl = 0                         ;Set ctrl (Def: no change)コントロール(技中は0)
anim = 200                       ;Change animation (Def: no change)アニメ
poweradd = 0                    ;Power to add (Def: 0)技ゲージ増加空振りも
sprpriority = 2                  ;Set p1's sprite layering priority to 2 (in front)絵の深さ

[State 200, 1]
type = HitDef                    ;攻撃の設定
trigger1 = AnimElem = 2          ;トリガー(そのステートを実行する条件)、アニメ何枚目
attr = S, NA                     ;Attribute: Standing, Normal Attack技の属性
damage = 23, 0                   ;Damage that move inflicts, guard damageダメージ(ヒット,ガード)
animtype = Light                 ;Animation type: Light, Medium, Heavy, Back (def: Light)くらい属性(ダウンの有無は別項目)
guardflag = M                    ;Flags on how move is to be guarded againstガード属性
hitflag = MAF                    ;Flags of conditions that move can hitヒットする状態の指定(省略時MAF)
priority = 4, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default相打ちの優先順位
pausetime = 8, 8                 ;Time attacker pauses, time opponent shakes硬直時間(相手,自分)ヒットストップ
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = -10, -100              ;X-offset for the "hit spark" rel. to p2,ヒットスパークの表示位置(-10,-高さ)
hitsound = 5, 0                  ;Sound to play on hit
guardsound = 6, 0                ;Sound to play on guard
ground.type = High               ;Type: High, Low, Trip (def: Normal)くらい動作のアニメを指定
ground.slidetime = 15            ;Time that the opponent slides back摩擦を無視する時間
ground.hittime  = 15             ;Time opponent is in hit stateのけぞり時間(1/60秒。ナックルの２倍-1)
ground.velocity = -8             ;Velocity at which opponent is pushed地上で攻撃を受けた時、相手が飛んでいく速度
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)くらい位置
air.hittime = 30                 ;Time before opponent regains control in air重要。無いと反撃し放題。
air.velocity = -4,-8             ;X-velocity at which opponent is pushed,相手が空中にいる時、攻撃を受けて飛んでいく速度(省略可能)
forcenofall = 0                  ;落下追い討ちを1で解除
getpower = 30,15;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 200, 2]
type = PlaySnd
trigger1 = Time = 2
value = 0, 1

[State 200, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 3
movetype = I

[State 200, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Standing strong punch

[Statedef 210]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 0
ctrl = 0
velset = 0,0
anim = 210
sprpriority = 2

[State 210, posadd]
type = posadd
trigger1 = time =10
x = 32

[State 210, posadd]
type = posadd
trigger1 = time =30
x = -32

[State 210, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 100, 0

[State 210, 2]
type = HitDef
trigger1 = AnimElem = 2
trigger2 = AnimElem = 3
triggerall = var(2) = 0          ;スカらせフラグが否
attr = S, NA
animtype  = Medium
damage    = 90
guardflag = M
hitflag = MAFD                    ;ヒットする状態の指定(省略時MAF)
pausetime = 12,12
sparkno = 1
sparkxy = -10,-110
hitsound = 5, 2
guardsound = 6, 0
ground.type = High
ground.slidetime = 23
ground.hittime  = 23
ground.velocity = -12
air.hittime = 30                 ;重要。無いと反撃し放題。
air.velocity = -4,-8             ;
fall = ifelse(p2StateType = A,1,0) ;転倒命令(相手が空中にいる時)
getpower = 30,15;p1ゲージ追加増加量
givepower = 30,15                ;p2ゲージ増加量

[State 210, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 4
movetype = I

[State 210, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

