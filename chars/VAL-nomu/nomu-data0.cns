;---------------------------------------------------------------------------
;---------------------------------------------------------------------------投げ
;Kung Fu Throw - Attempt投げ・根元

[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 4
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2

[State 800, 1]
type = HitDef
getpower = 60,30
Trigger1 = Time = 0
Trigger1 = p2movetype!=H || p2stateno!=[150,155]    ;当て投げ不可能な投げには追加しておく。
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hitコンボに組み込めない。
priority = 5, Miss    ;Throw has low priority, must be miss or dodge type.優先度。Missを指定しないとバグる。
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
p1facing = 1          ; KFM振り向き。1で相手の方、-1で逆を向く。
p2facing = 1          ;Force p2 to face
p1stateno = 810       ;On success, KFM changes to state 810ヒット分岐。成功したら810へ。
p2stateno = 820       ;If hit, p2 changes to state 820 in KFM's cns相手投げられアニメ。SFFに登録済みのステート820へ。
guard.dist = 0        ;This prevents p2 from going into a guard state if closeガード距離0、つまりガード不可。
fall = 1              ;Force p2 into falling down

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 210

;---------------------------------------------------------------------------
;Kung Fu Throw - Throwing the opponent投げ・ヒット分岐

[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
poweradd = 0

[State 810, Grab Sound]
type = PlaySnd
trigger1 = AnimElem = 1
value = 1, 1

[State 810, Throw Sound]
type = PlaySnd
trigger1 = AnimElem = 4
value = 800, 0

[State 810, Bind 1]
type = TargetBind  ;指定したフレーム、相手を指定した座標に「静止」させる。
trigger1 = AnimElemTime(2) < 0  ;アニメが1枚目の絵。
pos = 64, 0

[State 810, Width 2-9]
type = Width  ;押し返し
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(9) < 0
edge = 60,0  ;画面端の押し返し範囲を増加

[State 810, turn]
type = turn
trigger1 = time = 9
value = 1

[State 810, Bind 2-3]
type = TargetBind
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(4) < 0
pos = -56, -170

[State 810, Bind 4]
type = TargetBind
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
pos = 128, 0

[State 810, Bind 5]
type = TargetBind
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(5) < 0
pos = 96, -80

[State 810, Hurt 4]
type = TargetLifeAdd       ;ここで相手の体力を減らす。
trigger1 = AnimElem = 4
value = -135

[State 810, snd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 100, 2

[State 810, Throw 5]       ;821に相手のステートを移動
type = TargetState
trigger1 = AnimElem = 5
value = 821

[State 810, State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw
; (a custom gethit state)相手投げられアニメ前半

[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

;バグ防止のためのステート脱出記述
[State 820, 2]
type = SelfState  ;相手に制御権を戻す。
trigger1 = !gethitvar(isbound)
trigger1 = time > 40
value = 5050

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw - thrown into the air
; (a custom gethit state)相手投げられ後半のふっとんでる部分

[Statedef 821]
type    = A
movetype= H
physics = N
velset = 6,6
poweradd = 40

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
y = .8

[State 821, 2] ; Recover near ground (use ChangeState)ステート回復
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5200 ;HITFALL_RECOVER

[State 821, 3] ; Recover in mid air (use SelfState)ステート回復
type = SelfState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210 ;HITFALL_AIRRECOVER

[State 821, 4] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground

