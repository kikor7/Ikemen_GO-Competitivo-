
; Player information
[Info]
name = "VAL-nomu"    ;Name of character
displayname = "nomu" ;Name of character to display
versiondate = 09,30,2009    ;Version of character (MM-DD-YYYY or X.XX)
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "mer"         ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 640,480       ;Local coordinate space width and height

; Files for the player
[Files]
movelist = movelist.dat
cmd     = nomu.cmd        ;Command set
stcommon = common1.cns      ;Common states (from data/ or motif)
cns     = nomu.cns        ;Constants
st      = nomu.cns        ;States
st1     = nomu-data0.cns  ;通常技データ
st2     = nomu-data1.cns  ;必殺技データ
st3     = nomu-data2.cns  ;ゲージ技データ
st4     = nomu-data3.cns  ;補助ヘルパー、-2ステート
st5     = nomu-ai.cns     ;-3ステート(AI等)
sprite  = nomu.sff        ;Sprite
anim    = nomu.air        ;Animation
sound   = nomu.snd        ;Sound

pal1  = nomu.act
pal2  = nomu.act
pal3  = nomu.act
pal4  = nomu.act
pal5  = nomu.act
pal6  = nomu.act

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x = 1 ;Press button X to select palette 1, etc.
y = 2
z = 3
a = 4
b = 5
c = 6
;x2 = 7 ;Hold Start and press button X for palette 7, etc.
;y2 = 8
;z2 = 9
;a2 = 10
;b2 = 11
;c2 = 12

; Arcade mode
[Arcade]
