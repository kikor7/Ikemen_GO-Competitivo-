trigger1 = Time = 2
value = 1

[State 0, changeanim]
type = ChangeAnim
trigger1 =  var(1)=10000
trigger1 = Anim != 105+var(1)
value = 105+var(1)

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

