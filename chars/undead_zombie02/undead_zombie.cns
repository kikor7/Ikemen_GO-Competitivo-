
;这个算是我第4个人物吧.(旭婷就半坑了)
;这个人物用了25天时间,由出图,创招代码.
;也是我做人物最快的一个.
;火花都是默认的.
;必杀都是呕吐系.
;投技是咬系.
;亢奋狀态.
;断尸狀态.(第一版未加入这个模式)



;有任何BUG或建议欢迎于
;http://hi.baidu.com/realredred/home留言.
;2011/01/23


;===========================================================
[Data]
life = 1000                        ;生命值
attack = 100                       ;攻击力百分比
defence = 100                       ;防御力百分比
fall.defence_up = 50               ;打倒时防御力临时上升的百分比
liedown.time = 50                  ;倒地时间
airjuggle = 16                     ;空中连击修定值（不建议改）
sparkno = 2                        ;默认的攻击火花编号
guard.sparkno = 1               ;默认的防御火花编号
KO.echo = 1                        ;被KO的时候，声音是否有回音效果
volume = 70                        ;语音音量修正值
power = 300                      ;能量值（默认是3000=3个能量）
IntPersistIndex = 1,60             ;var参数跨场次变化台阶
FloatPersistIndex = 23,29          ;fvar参数跨场次变化台阶

[Size]
xscale = 0.5                      ;x轴缩放比例
yscale = 0.5                      ;y轴缩放比例
ground.back = 15                   ;地面人物宽度(后)陈可汗这些肥肥这些参数就得设大些.
ground.front = 18                  ;地面人物宽度(前)
air.back = 12                      ;空中人物宽度(后)
air.front = 12                     ;空中人物宽度(前)
height = 60                        ;人物高度
;attack.width = 4,4                ;攻击宽度
attack.dist = 138                  ;攻击距离
proj.attack.dist = 80              ;飞行道具距离
proj.doscale = 1                   ;飞行道具缩放比例
head.pos = 5,-100                   ;头部大概的位置(在某些投技时候有用)
mid.pos = 5,-75                    ;中心大概位置(在某些投技时候有用)
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 1.4        ;前行的速度
walk.back = -1.25       ;后退的速度
run.fwd  = 3,0          ;向前跑的速度
run.back = -3.5,-6      ;向后跑的速度
jump.neu = 0,-7.8       ;跳跃的高度及前后距离   X=0,Y=-10
jump.back = -1.5       ;后跳的速度
jump.fwd = 1.5         ;前跳速度(x, y)
runjump.back = -2.95,-11  ;跑步中后跳跃的速度
runjump.fwd = 4.3,-11     ;跑步中前跳跃的速度
airjump.neu = 0,-7.5      ;空中直接跳跃速度
airjump.back = -2.55      ;空中后跳速度
airjump.fwd = 2.5         ;空中前跳速度

[Movement]
airjump.num = 0           ;允许空中2段跳 （0，不允许 ；1 ，允许）
airjump.height = 10       ;空中跳跃高度
yaccel = 0.3             ;重力加速度
stand.friction = 0.8      ;站立时的摩擦系数
crouch.friction = 0.8     ;蹲下中的摩擦系数
;---------------------------------------------------------------------------
;var(1)    断尸  0= 全尸  10000 = 断尸
;var(2)    猎人扑 加乘

;var(20)   每2TICK记录生命
;var(21)   每1TICK记录生命
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0+var(1) && Anim != 5+var(1)
trigger2 = Anim = 5+var(1)&& AnimTime = 0  ;&& var(2)=0;Turn anim over
value = 0+var(1)



[state 7322, posset]
type = posset
trigger1 = time =0
trigger1 = pos y !=0
y=0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0



[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 5]
type    = S
physics = S
;anim = 12+var(1)

[State 5, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 5+var(1)
value = 5+var(1)



[State 5, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 6]
type    = S
physics = S
;anim = 12+var(1)

[State 6, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 6+var(1)
value = 6+var(1)



[State 5, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
;anim = 10+var(1)
ctrl = 1

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 0, changeanim]
type = ChangeAnim
trigger1 = Anim != 10+var(1)
value = 10+var(1)

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
;anim = 11+var(1)
sprpriority = 0
ctrl = 1

[state 7322, posset]
type = posset
trigger1 = time =0
trigger1 = pos y !=0
y=0

[State 0, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 11+var(1)
value = 11+var(1)

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6+var(1) && AnimTime = 0
value = 11+var(1)

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
;anim = 12+var(1)

[State 0, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 12+var(1)
value = 12+var(1)

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0


;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger1 = var(1) = 0
x = const(velocity.walk.fwd.x)



[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger1 = var(1) = 10000
x = const(velocity.walk.fwd.x) +0.5

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
trigger1 = var(1) = 10000
x = const(velocity.walk.back.x) -0.5

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
trigger1 = var(2) = 1
x = const(velocity.walk.fwd.x) +0.5


[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
trigger1 = var(2) = 1
x = const(velocity.walk.back.x) -0.5

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20+var(1) && Anim != 5+var(1)
trigger2 = Anim = 5+var(1) && AnimTime = 0
value = 20+var(1)





[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21+var(1) && Anim != 5+var(1)
trigger2 = Anim = 5+var(1) && AnimTime = 0
value = 21+var(1)







;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
;anim = 40+var(1)
ctrl = 0
sprpriority = 1

[State 0, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 40+var(1)
value = 40+var(1)

[State 40,起跳声]
type = PlaySnd
trigger1 = time = 2            ;条件:5毫秒以后播放声音
value = S22,3
channel = 10                   ;记号为10


[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)
yaccel = const(velocity.yaccel)


[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1) = 10000
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)+0.4, const(velocity.jump.back.x)-0.4))
y = const(velocity.jump.y)-2
yaccel = const(velocity.yaccel)

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(2) = 1
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)+0.55, const(velocity.jump.back.x)-0.5))
y = const(velocity.jump.y)  -2.8
yaccel = const(velocity.yaccel)


[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = var(1) = 0
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = var(1) = 10000
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44+var(1)

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41+var(1)

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41 + var(1)+ var(4), ifelse((vel x)>0, 42 + var(1)+ var(4), 43 + var(1)+ var(4)))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3 + var(1)+ var(4)




[State 50, 4]
type = HitDef

trigger1 = anim = 10041
trigger2 = anim = 10042
trigger3 = anim = 10043
attr = A, NA
damage = 85, 0
animtype = Hard
hitflag = MA
guardflag = HA
priority = 7, Hit
pausetime = 3,6
sparkno = S920
guard.sparkno = S900
sparkxy = ceil(-10*const(size.xscale)), ceil(-10*const(size.yscale))
hitsound = S2,4
guardsound = S3,0
ground.type = Trip
ground.slidetime = 28
ground.hittime  = 28
ground.velocity = -3,-7
groundguard.velocity = -6
airguard.velocity = -5,-2
air.velocity = -5,-3
fall = 1
air.fall = 1
persistent = 0

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
;anim = 47 + var(1)



[State 0, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 47+var(1)
value = 47+var(1)


[State 100,落地声]
type = PlaySnd
trigger1 = var(1) = 0
trigger1 = time = 1
value = S22,4
channel = 11

[State 52, Snd]
type = Playsnd
trigger1 = AnimElem = 1
trigger1 = var(1) = 10000
value = 4,0
volume = 255
persistent = 0

[State 52, envshake]
type = envshake
trigger1 = var(1) = 10000
trigger1 = AnimElem = 1
time = 18
freq = 120
ampl = 6
phase = -8
persistent = 0


[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
;anim = 100+ var(1)
sprpriority = 1

[State 0, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 100+var(1)
value = 100+var(1)

[State 100,跑步声]
type = PlaySnd
trigger1 = time = 5            ;条件:5毫秒以后播放声音
value = S22,0
channel = 20                   ;记号为20
loop = 1

[State 100,stop]
type = StopSnd
trigger1 = Command != "holdfwd"
trigger2 = anim !=100 + var(1)
channel = 20

[State 100, AfterImage]          ;残影
type =AfterImage
trigger1 = Animelem = 1           ;条件  第一张图
time = 60                        ;持续时间  60桢
timeGap = 1                       ; 影子间隔时间  1桢
frameGap = 2                      ; 历史缓冲中每第value幅画面将显示为残影。例如，如果framegap = 4（缺省），那么，历史缓冲中的第1、5、9、……幅画面将被显示为残影
length = 10                       ; 每个影子持续时间 10桢
trans = add1                     ;  指定残影的透明类型。有效类型包括“none”为不透明残影、“add”，    “add1”和“sub”。
palBright = 1,1,1
palContrast = 128,128,255
palAdd = 0,0,0
palMul = 1,1,1

[State 100, 1]
type = VelSet                  ;跑步的速度设置
trigger1 = 1                    ;无条件
trigger1 = var(1) = 0
x = const(velocity.run.fwd.x)     ;取得前面[Velocity]设置run.fwd的数字

[State 100, 1]
type = VelSet
trigger1 = 1
trigger1 = var(1) = 10000
x = const(velocity.run.fwd.x) +0.5

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial      ;特别设置
trigger1 = 1               ;无条件
flag = NoWalk               ;设置这个参数人物在跑步时就不会转换到步行的动作了

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState                     ;转换state
trigger1 = command != "holdfwd"      ;如果放开一直向前跑的键
value = 0                            ;如果改为101 就会进入刹车STATE

[Statedef 101]                 ;刹车编号,这个数字101和上面的value = ?设置的数字相同才能对应转换.
type    = S
physics = S
anim = 101                     ;这里输入AIR对应的刹车编号
velset = 0,0

[State 0, changeanim]
type = ChangeAnim
trigger1 =  var(1)=10000
trigger1 = Anim != 100+var(1)
value = 100+var(1)

[State 101, 1]
type = ChangeState
trigger1 = AnimTime = 0        ;刹车动作完成的0秒时
value = 0                      ;就会转换到站立动作statedef 0
ctrl = 1                       ;而且转换到站立动作后可以控制人物,若设置为0则不可控制人物
;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = A
physics = A
ctrl = 0
;anim = 105
sprpriority = 1

[State 0, changeanim]
type = ChangeAnim
;trigger1 =  var(1)=10000
trigger1 = Anim != 105+var(1)
value = 105+var(1)

