trigger1 = AnimElem = 2
trigger1 = p2stateNo != 1170
value = 1152

[State 1160, 物理的なキャラの幅]
type = Width
trigger1 = AnimElemTime(2) = 0
edge = 60,60

[State 1160, 相手の位置]
type = TargetBind
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
pos = ceil(const(size.xscale)*80),ceil(const(size.yscale)*-125)

[State 1160, 相手の位置]
type = TargetBind
trigger1 = AnimElemTime(3) >= 0 && AnimElemTime(4) < 0
pos = ceil(const(size.xscale)*20),ceil(const(size.yscale)*-75)

[State 1160, 相手の位置]
type = TargetBind
trigger1 = AnimElemTime(4) >= 0 && AnimElemTime(4) < 10
pos = ceil(const(size.xscale)*-60),ceil(const(size.yscale)*-5)

[State 1160, 相手の位置]
type = TargetBind
trigger1 = AnimElemTime(4) >= 10 && AnimElemTime(5) < 0
pos = ceil(const(size.xscale)*-60),ceil(const(size.yscale)*-25)

[State 1160, ダウン音]
type = PlaySnd
trigger1 = Time = 26
value = 41, 0

[State 1160, 画面を揺す]
