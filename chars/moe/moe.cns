;# 使用変数 ###############################################################
;
; 0 = 汎用
; 1 = 
; 2 = コンボ補正
; 3 = パワーアップ状態
; 4 = モコモコヒットフラグ
; 5 = 飛び道具ヒットフラグ
;F
; FV0 = パワーアップ攻撃力設定
; FV1 = パワーアップタイム測定
;
; 
;##########################################################################

[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 400
IntPersistIndex = 10
FloatPersistIndex = 40

[Size]
xscale = 0.5.
yscale = 0.5
ground.back = 14
ground.front = 14
air.back = 13
air.front = 13
height = 60
attack.dist = 160
proj.attack.dist = 80
proj.doscale = 0
head.pos = -0, -70
mid.pos = -0, -47
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.0
walk.back = -3.0
jump.neu = 0,-9
jump.back = -3.5
jump.fwd = 3.0


;walk.fwd  = 2.0
;walk.back = -2.0
;run.fwd  = 4.6, 0
run.back = -4.5,-4.5
;jump.neu = 0,-8.0
;jump.back = -2.3
;jump.fwd = 2.3
;runjump.back = -2.55,-8.
;runjump.fwd = 3,-8.0
airjump.neu = 0,-6
;airjump.back = -2.3
;airjump.fwd = 2.3

[Movement]
airjump.num = 1
airjump.height = 30
yaccel = .50
stand.friction = .85
crouch.friction = .82

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = N
anim = 100
ctrl = 0
velset = 5,0
sprpriority = 1

[State 191, 3]
type = PlaySnd
trigger1 = Time = 0
value = 1100,1

[state 1,2]
type = veladd
trigger1 = time > 5
x = -0.25

[State 100, 2]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = command = "holdup" 
value = 40
ctrl = 1

[State 100, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = A
physics = A
ctrl = 0
anim = 105
sprpriority = 1

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 106

