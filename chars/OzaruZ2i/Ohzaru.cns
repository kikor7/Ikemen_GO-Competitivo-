pausemovetime = 999999

;===============================================================================
; Limitador Air Jump:
;-------------------------------------------------------------------------------
[State 0, VarSet]
type = VarSet
trigger1 = var(5) = 0 && (stateno = 60||stateno = 70)
v = 5
value = 1

[State 0, VarSet]
type = VarSet
trigger1 = var(5) = 1 && pos y >= 0
v = 5
value = 0
;===============================================================================
; Air C:
;-------------------------------------------------------------------------------
[State 0, AngleDraw]
type = AngleDraw
trigger1 = prevstateno = 620 && time = 1
value = 0

[State 0, Helper]
type = Helper
triggerall = p2movetype = H
triggerall = numhelper(1350) = 0
trigger1 = p2stateno = 1306
helpertype = normal
name = "Pared Rota"
ID = 1350
stateno = 1350
pos = 0,-30
postype = p2
facing = 1
keyctrl = 0
ownpal = 1

;This controller plays a sound everytime the player lands from a jump, or from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 && prevstateno != 107 ;back dash land and no flik flak
trigger3 = stateno=0 && prevstateno=5120
trigger4 = stateno = 5201
trigger5= stateno=130 && ((prevstateno=132)||(prevstateno=[154,155]))
value = 0, 4

[State -3, Walk Sound]
type = PlaySnd
triggerall = stateno = 20
triggerall = anim = 20
trigger1 = animelem = 3
trigger2 = animelem = 6
value = 0,4

[State -3, Super Jump AI get closer to you]
type = veladd
x = 0.2
triggerall = AILevel>0 && numenemy && statetype = A && roundstate = 2 && enemy,vel y < -1
triggerall = (p2bodydist y = [-320,-30]) && enemynear,Statetype=A 
trigger1 = (prevstateno=[10230,10232])

[state 52, Land FX]
type = helper
triggerall = Time = 1
trigger1 = stateno = 52
trigger2 = stateno = 106 && prevstateno != 107
trigger3 = stateno = 5201
trigger4= stateno=130 && ((prevstateno=132)||(prevstateno=[154,155]))
name = "LandFX"
helpertype = normal
stateno = 17100
id = 17100
postype = P1
ownpal = 1
keyctrl = 0
supermovetime = 99999
pausemovetime = 99999

[State 0,recoverpulser]
type = Helper
triggerall = !numHelper(52100)
trigger1 = StateNo = 5201
name = "recoverpulser"
ID = 52100
StateNo = 52100
ownpal = 1
supermovetime = 99999
pausemovetime = 99999

[State -3, Jumping Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 40 || stateno = 105
value = 0,3

[State -3, Running Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 100
value = 110,0

[State 0, Golpeado]
type = PlaySnd
trigger1 = movetype=H && (stateno!=[0,155]) && !time && HitOver=0 && random%3=0
value = 5000,ifelse(random < 500,1,ifelse(random < 500,2,3))

