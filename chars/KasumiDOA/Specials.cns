;Special 1
[Statedef 1000]
type = S
movetype = A
physics = S
anim = 1000
ctrl = 0
velset = 0,0
poweradd = 0 * !var(20)
sprpriority = 2
facep2 = 1

[State 0, Button Detect]
type = VarSet
trigger1 = !Time
var(10) = ifElse((command = "a" || command = "rlsa"), 0, ifElse((command = "b" || command = "rlsb"), 1, 2))

[State 1000, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || PrevStateNo = 750 || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 1000, Voice]
type = PlaySnd
trigger1 = !Time
value = 0,(Random % 8)
channel = 0

[State 1000, Swing Snd]
type = PlaySnd
trigger1 = Animelem = 6
value = 1, 5

[State 1000, Velocity]
type = VelSet
trigger1 = AnimElemTime(1) >= 0 && AnimElemTime(7) < 0
x = ifelse(var(10)=2,12, ifelse(var(10)=1, 9, 6))

[State 1000, VelStop]
type = VelSet
trigger1 = AnimElem = 8 && !var(10)
trigger2 = AnimElem = 9 && var(10)=1
trigger3 = AnimElem = 10 && var(10)=2
x = 0

[State #, Resist]
type = NotHitBy
trigger1 = Animelem = 1
time = 14
value = SCA

[State 1000, HitDef] 
type = HitDef
trigger1 = !var(16) && var(15) < 2
trigger1 = !Time
attr = S, SA
damage = ceil(ifElse(fvar(11) * ifElse(var(10) = 2, 95, ifElse(var(10), 75, 55)) < 7, 7, fvar(11) * ifElse(var(10) = 2, 95, ifElse(var(10), 75, 55)))), 7
priority = 4, hit
animtype = Hard
getpower = 60,30
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,5
guardsound = S130,0
pausetime = 10,10
guard.pausetime = 10,10
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 59), var(36) := -54
air.animtype = Back
fall.animtype = Back
ground.type = Low
air.type = Low
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -6,-6
air.velocity = -6,-6
guard.velocity = -5
airguard.velocity = -5, -5
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .5
fall = 1
forcestand = 0
fall.recover = 0
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48

[State 1000, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(8) >= 0
movetype = I

[State 1000, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

