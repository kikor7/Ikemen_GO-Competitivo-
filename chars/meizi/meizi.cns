type = Projectile
trigger1 = AnimElem = 2
attr = S, SP
damage = ceil(5+var(5)*10),4 ;Var(5)をここなどに代入すれば活かされる
getpower = 0,0
animtype = Light
pausetime = 0,4
;-----------------------------------Projectile専用のパラメータ
offset = 35,-55                ;飛び道具を発射する位置（Ｘ軸,Ｙ軸）
velocity = 0.8,0  ;ceil(4+var(5)*2),-3 ;飛び道具の移動速度（Ｘ軸,Ｙ軸）
projID = 8070                  ;飛び道具のＩＤナンバー（NumProjIDなどで判断）
projanim = ifelse(var(18)>=60,8072,ifelse((var(18)=[30,59]),8071,8070))                ;飛び道具のアニメ（アクションナンバー）
projhitanim = ifelse(var(18)>=60,8072,ifelse((var(18)=[30,59]),8071,8070))             ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim = 8008             ;飛び道具が消える時のアニメ（アクションナンバー）
projcancelanim = 8008
projscale = (0.5+0.005*var(18)),(0.5+0.005*var(18))                ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在２倍
projshadow = 0,0,0             ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits = 80                   ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime = 10               ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority = 7               ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime = 260+var(18)*4            ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
guardflag = MA
hitflag = MAF
priority = 3,dodge
sparkno = -1
sparkxy = 0,0
guard.sparkno = 40
hitsound = 5,3
guardsound = 6,0
ground.type = High
ground.slidetime = 10
ground.hittime = 18
ground.velocity = 0,0
air.velocity = 0,0
air.juggle = 0 ;Projectileの場合はここで設定しないとヒットした時ジャグルが消費しない
envshake.time = 8
envshake.ampl = 6
envshake.freq = 100
air.fall = 1
fall.recover = 0

