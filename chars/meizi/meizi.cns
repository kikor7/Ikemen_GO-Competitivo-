[State 303, 飛び道具];HitDefに飛び道具専用のパラメータを加えたようなものが「Projectile」
type = Projectile
trigger1 = AnimElem = 2
attr = S, SP ;立ち必殺飛び道具（Standing, Special Projectile）
damage = ceil(20+var(5)*10),7 ;Var(5)をここなどに代入すれば活かされる
getpower = 20,10
animtype = Hard
pausetime = 0,2+ceil(var(18)/4)
;-----------------------------------Projectile専用のパラメータ
offset = 0,0                ;飛び道具を発射する位置（Ｘ軸,Ｙ軸）
velocity = 0,0  ;ceil(4+var(5)*2),-3 ;飛び道具の移動速度（Ｘ軸,Ｙ軸）
accel = 0,0                 ;飛び道具の加速度(float)（Ｘ軸,Ｙ軸）
projID = 1302                  ;飛び道具のＩＤナンバー（NumProjIDなどで判断）
projanim = 8004                ;飛び道具のアニメ（アクションナンバー）
projhitanim = 8004             ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim = 8004             ;飛び道具が消える時のアニメ（アクションナンバー）
projcancelanim = 8004
projscale = 1.0,1.0                ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在２倍
projshadow = 255,0,0             ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits = 2                   ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime = 30               ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority = 3               ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime = 27            ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
guardflag = MA
hitflag = MAFD
priority = 3
sparkno = -1
sparkxy = -600,600
guard.sparkno = 40
hitsound = 5,3
guardsound = 6,0
ground.type = High
ground.slidetime = 10+ceil(var(18)/2)
ground.hittime = 10+ceil(var(18)/2)
ground.velocity = -6,0
air.velocity = -2,-4
air.juggle = 4 ;Projectileの場合はここで設定しないとヒットした時ジャグルが消費しない
air.fall = 1
fall.recovertime = 10+var(18)
envshake.time = 8
envshake.ampl = 6
envshake.freq = 100

