triggerall = (root,Stateno = [120,159]) || (root,stateno = 52 && (root,prevstateno = [120,159]))
trigger1 = var(4) = 0
v = 7
value = 0

[State 7000, 位置修正]
type = Velset
triggerall = (root,Stateno = [120,159]) || (root,stateno = 52 && (root,prevstateno = [120,159]))
trigger1 = ParentDist x < 0
trigger2 = ParentDist x > 0
x = ceil(ParentDist x/4)

[State 7000, 位置修正]
type = Velset
triggerall = (root,Stateno = [120,159]) || (root,stateno = 52 && (root,prevstateno = [120,159]))
triggerall = root,Statetype = S
trigger1 = ParentDist y < 0
trigger2 = ParentDist y > 0
y = ceil(ParentDist y/4)

[State 7000, 位置修正]
type = Velset
triggerall = (root,Stateno = [120,159]) || (root,stateno = 52 && (root,prevstateno = [120,159]))
triggerall = root,Statetype = C
trigger1 = ParentDist y +30 < 0
trigger2 = ParentDist y +30 > 0
y = ceil(ParentDist y +30/4)

[State 7000, 位置修正]
type = Velset
triggerall = (root,Stateno = [120,159]) || (root,stateno = 52 && (root,prevstateno = [120,159]))
triggerall = root,Statetype = A
trigger1 = ParentDist y -30 < 0
trigger2 = ParentDist y -30 > 0
y = ceil(ParentDist y -30/4)

[State 7000, 停止]
type = velset
trigger1 = root,Stateno != [120,159]
trigger1 = root,stateno != 52
trigger2 = root,stateno = 52
trigger2 = var(7) = 1
x = 0 
y = 0

[State 7000, スケール用変数]
type = varadd
trigger1 = var(7) = 0
trigger2 = var(4) != 0
v = 4
value = 1

[State 7000, スケール用変数]
