[State 1202, 飛び道具];HitDefに飛び道具専用のパラメータを加えたようなものが「Projectile」
type = Projectile
trigger1 = time = 0
attr = S, SP ;立ち必殺飛び道具（Standing, Special Projectile）
damage = ceil(120+var(5)*10),0 ;Var(5)をここなどに代入すれば活かされる
getpower = 0,0
animtype = Light
pausetime = 0,5
;-----------------------------------Projectile専用のパラメータ
offset = 0,0                ;飛び道具を発射する位置（Ｘ軸,Ｙ軸）
velocity = 0,0  ;ceil(4+var(5)*2),-3 ;飛び道具の移動速度（Ｘ軸,Ｙ軸）
projID = 1302                  ;飛び道具のＩＤナンバー（NumProjIDなどで判断）
projanim = 8039                ;飛び道具のアニメ（アクションナンバー）
projhitanim = 8039             ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim = 8039             ;飛び道具が消える時のアニメ（アクションナンバー）
projcancelanim = 8039
projscale = 0.6,0.6               ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在２倍
projshadow = 0,0,0             ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits = 10                   ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime = 500               ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority = 7               ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime = 55            ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
guardflag = L
hitflag = MAFD
priority = 7,hit
sparkno = -1
sparkxy = 0,0
guard.sparkno = 40
hitsound = s108,0
guardsound = -1
ground.type = High
ground.slidetime = 14
ground.hittime = 16
ground.velocity = 0,-14
air.velocity = 0,-14
air.juggle = 4 ;Projectileの場合はここで設定しないとヒットした時ジャグルが消費しない
fall = 1
fall.recover = 0
envshake.time = 20
envshake.ampl = 10
envshake.freq = 100

