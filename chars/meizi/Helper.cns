type = Projectile
triggerall = var(25) = 0
trigger1 = time = 0
attr = S, SP ;立ち必殺飛び道具（Standing, Special Projectile）
damage = ceil(15+var(5)*10),7 ;Var(5)をここなどに代入すれば活かされる
getpower = 30,10
animtype = Light
pausetime = 0,5
;-----------------------------------Projectile専用のパラメータ
offset = 0,0 ;39,-53                ;飛び道具を発射する位置（Ｘ軸,Ｙ軸）
velocity = 4,0  ;ceil(4+var(5)*2),-3 ;飛び道具の移動速度（Ｘ軸,Ｙ軸）
accel = 0.0,0                 ;飛び道具の加速度(float)（Ｘ軸,Ｙ軸）
projID = 8000+var(21)                  ;飛び道具のＩＤナンバー（NumProjIDなどで判断）
projanim = 8013                ;飛び道具のアニメ（アクションナンバー）
projhitanim = 8013             ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim = 8013             ;飛び道具が消える時のアニメ（アクションナンバー）
projcancelanim = 8013
projscale =  0.25,0.25 ;0.6,0.8                ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在２倍
projshadow = 255,0,0             ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits = 1                   ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime = 300               ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority = 1               ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime = 40            ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
guardflag = MA
priority = 1,miss
sparkno = -1
sparkxy = 0,0
guard.sparkno = 40
hitsound = 5,3
guardsound = 6,0
ground.type = High
ground.slidetime = 8
ground.hittime = 6
ground.velocity = -6,0
air.velocity = -3,-4
air.juggle = 4 ;Projectileの場合はここで設定しないとヒットした時ジャグルが消費しない
envshake.time = 8
envshake.ampl = 6
envshake.freq = 100
air.fall = 1
fall.recovertime = 9

