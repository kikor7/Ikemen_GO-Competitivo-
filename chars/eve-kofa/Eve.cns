;Var(1)  ジャンプ用
;Var(2)  攻撃力補正用
;Var(3)  勝利メッセージ分岐、エフェクト表示用
;Var(4)  やられ用
;Var(5)  ヘブンズフォール制御用
;Var(6)  剣質スイッチ
;Var(7)  ガーキャンスイッチ
;Var(8)  喰らいキャンセルスイッチ
;Var(9)  勝利メッセージスイッチ
;Var(10) AI起動

[Data]
life = 1500
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 30
airjuggle = 20
sparkno = 			2
guard.sparkno = 	40
KO.echo = 0
volume = 100
IntPersistIndex = 59
FloatPersistIndex = 40

[Size]
xscale = 1
yscale = 1
ground.back = 15
ground.front = 15
stand.height = 95
head.pos = 0,-90
mid.pos = 0,-65
air.back = 12
air.front = 12
z.width = 3
attack.width = 4,4
attack.dist = 160
proj.attack.dist = 90

[Velocity]
walk.fwd     = 3.3          ;前進歩行速度
walk.back    = -3.1         ;後退歩行速度
run.fwd      = 7.2, 0       ;前に走る時の速度（Ｘ軸,Ｙ軸）
run.back     = -6,-4      ;後ろに走る時の速度（Ｘ軸,Ｙ軸）
jump.neu     = 0,-10       ;垂直ジャンプ速度（Ｘ軸,Ｙ軸）
jump.back    = -4           ;後ジャンプ速度
jump.fwd     = 4.2          ;前ジャンプ速度
runjump.back = -2.55,-8.1   ;後ろに走りながらのジャンプ速度（オプション）
runjump.fwd  = 4.8,-9.5     ;前に走りながらのジャンプ速度（オプション）
airjump.neu  = 0,-8.1       ;空中垂直ジャンプ速度（オプション）
airjump.back = -2.5         ;空中後ジャンプ速度（オプション）
airjump.fwd  = 2.55         ;空中前ジャンプ速度（オプション）

;---------------------------------------------------------------------------
;動作設定
[Movement]
airjump.num     = 1      ;空中ジャンプが出来る回数（オプション）
airjump.height  = 35     ;空中ジャンプするために必要な最低限の高さ（オプション）
yaccel          = .54    ;重力（垂直下降加速度）
stand.friction  = .85    ;立ち状態の摩擦係数
crouch.friction = .82    ;しゃがみ状態の摩擦係数

;===========================================================================
;基本動作
;===========================================================================
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 0]
type = ChangeAnim
triggerall = prevstateno != 300
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 0]
type = ChangeAnim
triggerall = prevstateno = 300
trigger1 = Anim != 1 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 1

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40]
type = turn
trigger1 = time = 0 && P2dist X < 0

[State 40]
type = VarSet
trigger1 = Time = 0
var(1) = 0

[State 40]
type = VarSet
triggerall = var(59)<=0
trigger1 = command = "holdfwd"
trigger1 = var(1) != 2
var(1) = 1

[State 40]
type = VarSet
triggerall = var(59)<=0
trigger1 = command = "holdback"
trigger1 = var(1) != -2
var(1) = -1

[State 40]
type = VarSet
triggerall = var(59)<=0
triggerall = Time = 0
triggerall = command = "holdfwd"
trigger1 = command = "jump"
trigger2 = prevstateno = 100 ;RUN_FWD
var(1) = 2

[State 40]
type = VarSet
triggerall = var(59)<=0
trigger1 = Time = 0
trigger1 = command = "holdback"
trigger1 = command = "jump"
var(1) = -2

[State 40, AI-VarSet]
type = VarSet
TriggerAll = var(59)>0 && RoundState=2 && Alive && !Ishelper && PlayerIDExist(var(58))
trigger1 = P2Bodydist X>40
trigger2 = PlayerID(var(58)),Statetype = A
trigger2 = PlayerID(var(58)),Movetype = H
trigger3 = Numhelper(373333)
trigger3 = P2Bodydist X>80
trigger4 = BackEdgeBodydist<30
var(1) = 1+Ifelse(PrevStateNo=100,1,Ifelse(var(43)=1,1,0))

[State 40, AI-VarSet]
type = VarSet
TriggerAll = var(59)>0 && RoundState=2 && Alive && !Ishelper && PlayerIDExist(var(58))
triggerall = PlayerID(var(58)),movetype != H
triggerall = BackEdgeBodydist>=30
trigger1 = P2Bodydist X<30
trigger1 = PlayerID(var(58)),Statetype != A
trigger1 = BackEdgeBodyDist > 40
trigger2 = PlayerID(var(58)),Statetype = L
trigger2 = BackEdgeBodyDist > 40
trigger2 = P2Bodydist X<30
var(1) = -1-(var(43))

[State 40]
type = PlaySnd
trigger1 = Time = 0
trigger1 = prevstateno != 100
value = 0,0
channel = 3

[State 40]
type = PlaySnd
trigger1 = Time = 0
trigger1 = prevstateno = 100
trigger1 = var(1) = 1;※
value = 0,1
channel = 3

[State 40]
type = Afterimage
trigger1 = prevstateno = 100
trigger1 = var(1) = 1;※
time = 15
length = 10
PalBright = 0, 0, 0
PalContrast = 128, 128, 128
PalAdd = 0, 0, 0
PalMul = 1, 1, 1
FrameGap = 3
Trans = Add1

[State 40]
type = ChangeState
;triggerall = AnimTime = 0;※
triggerall = Time=0
trigger1 = var(1) != 0
trigger1 = var(1) != 1
trigger1 = var(1) != -1
trigger1 = var(59)<=0
trigger1 = command = "holdup"
trigger2 = var(59)<=0
trigger2 = command != "holdup"
trigger3 = var(59)>0 && var(43)=1
value = 70

[State 40]
type = VelSet
;trigger1 = AnimTime = 0;※
trigger1 = Time = 0
x = ifelse(var(1)=0, const(velocity.jump.neu.x), ifelse(var(1)>0, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 4]
type = Turn
triggerall = var(59)<=0
triggerall = frontedgebodydist < 3
triggerall = pos y < -15
trigger1 = command = "holdup"
trigger1 = command = "holdback"

[State 50, 5]
type = ChangeState
triggerall = var(59)<=0
triggerall = backedgebodydist < 3
triggerall = pos y < -15
trigger1 = command = "holdup"
trigger1 = command = "holdfwd"
value = 53

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 0]
type = ChangeAnim
triggerall = time = 0
trigger1 = prevstateno = 1300
trigger2 = prevstateno = 1310
trigger3 = prevstateno = 1200
trigger4 = prevstateno = 1210
trigger5 = prevstateno = 3010
value = 1320

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 4]
type = PlaySnd
trigger1 = time = 0
value = 0,2

[State 52, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;三角跳び
[Statedef 53]
type = A
physics = A
ctrl = 1
anim = 53

[State 53]
type = PlaySnd
trigger1 = Time = 0
value = 0, 2

[State 53]
type = velset
trigger1 = Time < 6
x = 0
y = 0

[State 53]
type = VelSet
trigger1 = time = 6
x = 3.5
y = -8

[State 53]
type = PlaySnd
trigger1 = time = 6
value = 0,0
channel = 3

[State 53]
type = ChangeState
trigger1 = AnimTime = 0
value = 50

;---------------------------------------------------------------------------
; JUMP_UP (short)
[Statedef 70]
type    = A
physics = A
velset = 0, -7
ctrl = 1

[State 70]
type = StopSnd
triggerall = Time = 0
trigger1 = var(1) = -2
trigger2 = var(1) = 2
channel = 3

[State 70]
type = PlaySnd
triggerall = Time = 0
trigger1 = var(1) = -2
trigger2 = var(1) = 2
value = 0,1
persistent = 0

[State 70]
type = Afterimage
triggerall = Time = 0
trigger1 = var(1) = -2
trigger2 = var(1) = 2
time = 17
length = 9
PalBright = 0, 0, 0
PalContrast = 128, 128, 128
PalAdd = 0, 0, 0
PalMul = 1, 1, 1
FrameGap = 3
Trans = Add1

[State 70]
type = Afterimage
trigger1 = Time = 14
time = 0

[State 70]
type = VelSet
triggerall = var(59)<=0
trigger1 = Time = 0
trigger1 = command = "holdup"
y = -10

[State 70]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(1) = 1
x = 3

[State 70]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(1) = 2
x = 6

[State 70]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(1) = -1
x = -3

[State 70]
type = VelSet
trigger1 = Time = 0
trigger1 = Var(1) = -2
x = -6

[State 70]
type = ChangeAnim
triggerAll = Time = 0
triggerAll = Vel X = 0
trigger1 = var(59)<=0
trigger1 = command = "holdup"
trigger2 = var(59)<=0
trigger2 = command != "holdup"
trigger3 = var(59)>0
value = 41

[State 70]
type = ChangeAnim
triggerall = Time = 0
triggerall = Vel X > 0
trigger1 = var(59)<=0
trigger1 = command = "holdup"
trigger2 = var(59)<=0
trigger2 = command != "holdup"
trigger3 = var(59)>0
value = 42

[State 70]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = Vel X < 0
value = 43

[State 70]
type = ChangeAnim
triggerall = Time = 0
triggerall = Vel X < 0
trigger1 = var(59)<=0
trigger1 = command != "holdup"
trigger2 = var(59)>0
value = 43

[State 70]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 70];三角跳び
type = Turn
triggerall = frontedgebodydist < 3
triggerall = pos y < -15
trigger1 = var(59)<=0
trigger1 = command = "holdup"
trigger1 = command = "holdback"
trigger2 = var(59)>0 && var(44)

[State 70];三角跳び
type = ChangeState
triggerall = backedgebodydist < 3
triggerall = pos y < -15
trigger1 = var(59)<=0
trigger1 = command = "holdup"
trigger1 = command = "holdfwd"
trigger2 = var(59)>0 && var(44)
value = 53

;---------------------------------------------------------------------------
; SGUARDHIT (shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State 150, 0]
type = VarAdd
trigger1 = time = 0
var(7) = 1

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 2]
type = ChangeState
triggerall = var(59)<=0
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, 2(AI)]
type = ChangeState
triggerall = var(59)>0
trigger1 = HitShakeOver
value = 151 + 2*(Statetype=C)

[State 150, Hi to Lo]
type = StateTypeSet
triggerall = var(59)<=0
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
triggerall = var(59)<=0
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

;---------------------------------------------------------------------------
; SGUARDHIT2 (knocked back)
