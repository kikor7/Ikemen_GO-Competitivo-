type    = S
movetype= H
physics = N

[State 5200, 0]
type = posset
trigger1 = time >= 0
y = 0

[State 5200, 3]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5201

