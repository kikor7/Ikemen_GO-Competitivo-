trigger1 = time >= 0
value = SCA

[State 5201]
type = Turn
trigger1 = (Time = 0) && (p2dist X < -5)

[State 5201]
type = VelSet
trigger1 = Time = 0
x = -18

[State 5201]
type = Veladd
trigger1 = Time >= 0
x = 2.5

[State 5201]
type = VelSet
trigger1 = Vel X >= 0
x = 0

[State 5201]
type = PosSet
trigger1 = Time >= 0
y = 0

[State 5201]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

