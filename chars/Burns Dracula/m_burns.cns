[State 183, run]
type = velset
trigger1 = time = 0
x = var(21)

[State 183, stop]
type = velset
trigger1 = time = 30
x = 0

[State 183, anim]
type = changeanim
trigger1 = time = 30
value = ifelse( (var(21) >= 0), 183, 182 )


