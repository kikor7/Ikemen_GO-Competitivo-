[State 183, distance X_right]
type = varset
trigger1 = facing = 1
trigger1 = time = 0
var(20) = floor(ifelse((enemy,facing = -1),(enemy,FrontEdgeDist - BackEdgeDist),(enemy,BackEdgeDist - BackEdgeDist)))

[State 183, distance X_left]
type = varset
trigger1 = facing = -1
trigger1 = time = 0
var(20) = floor(ifelse((enemy,facing = 1),(FrontEdgeDist - enemy,BackEdgeDist),(FrontEdgeDist - enemy,FrontEdgeDist)))

[State 183, time for distance]
type = varset
trigger1 = time = 0
var(21) = floor(var(20)/30)

[State 183, run_anim]
type = changeanim
trigger1 = time = 0
