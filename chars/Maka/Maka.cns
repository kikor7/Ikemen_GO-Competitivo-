;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.



[State -3, Walk]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 20
value = 0, 1
loop = 1
channel = 10


[State , StopSnd]
type = StopSnd
trigger1 =  stateno != 20
channel = 10



[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 0, 3


[State -3, Run]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 100
trigger2 = stateno = 105
value = 0, 2

[State -3, Jump]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 50
value = 0, 4

[State -3, Getting Up]
type = PlaySnd
triggerall = time = 1
triggerall = var(10) = 0
trigger1 = stateno = 5120
value = 8 , 1

[State -3, Getting Up]
type = PlaySnd
triggerall = time = 1
triggerall = var(10) = 1
trigger1 = stateno = 5120
value = 13 , 5

[State 2OS]
type=stopsnd
trigger1=stateno!= 190 ;; In a nutshell, if not in an intro state, stop the sound(s) with the labeled channel [ channel=1 in this case ] immediately
channel= 11
persistent=1


[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = var (10) = 0
value =  1

