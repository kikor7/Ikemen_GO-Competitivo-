st2     = homero-s.cns	;(super)
st3     = simpson-common.cns
stcommon = common1.cns	;common states (in data/)
sprite  = homero.sff	;sprite
anim    = homero.air	;animation
sound   = homero.snd	;sound
pal1    = homero.act	;palettes
pal2    = homerob.act
pal3    = homeroc.act
pal4    = homerod.act
pal5    = homeroe.act
pal6    = homerof.act
pal7    = homerog.act
pal8    = homeroh.act
pal9    = homeroi.act
pal10   = homeroj.act
pal11   = homerok.act
pal12   = homerol.act



