; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "GENMA"        ;Name of character
displayname = "GENMA" ;Name of character to display
versiondate = 04,14,2002    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "rainman"          ;Character author name
pal.defaults = 1            ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd     = Genma.cmd   ;Command set
cns     = Genma.cns   ;Constants
st      = Genma.cns   ;States
st1     = Super_move.cns;技のプログラム
st2     = system.cns    ;システムのプログラム
st3     = seigyo.cns    ;相手挙動のプログラム
st4     = Hyper_move.cns;ゲージ技のプログラム
st5     = helper.cns    ;ヘルパーのプログラム



stcommon = common1.cns ;Common states
sprite  = Genma.sff   ;Sprite
anim    = Genma.air   ;Animation
sound   = Genma.snd   ;Sound
pal1    = Genma1.act
pal2    = Genma2.act

; Arcade mode
[Arcade]
