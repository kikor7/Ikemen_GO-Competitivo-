p1facing = 1;攻撃が当たった時の自分の向き ★６
p2facing = 1          ;攻撃が当たった時の相手の向き
p1stateno = 6471       ;自分のステート変更
p2stateno = 7000       ;相手を制御するステートに行かせる
;;guardflag = MA
