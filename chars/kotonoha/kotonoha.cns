;priority  = 6
;guardflag = MA
;pausetime = 15,15
;sparkxy = -10,-60
;hitsound   = 5,4
;guardsound = 6,0
;ground.type = Low
;ground.slidetime = 12
;ground.hittime  = 15
;ground.velocity = -4,-3.5
;air.velocity = -4,-3
;fall = 1

;[State 1000, 6] ;相手が遠い時
