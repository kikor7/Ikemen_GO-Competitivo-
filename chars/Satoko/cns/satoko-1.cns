[Statedef 9999]
type = U
movetype = H
physics  = N

[State 9999, 軸位置]
type = PosSet
trigger1 = (StateType != A)
y = 0

[State 9999, のけぞり]
type = PosAdd
trigger1 = time = 0
x = -6

[State 9999, スーパーアーマーにするため]
type = VarSet
trigger1 = 1
v = 34
value = 1

[State 9999, 色を加える]
type = PalFX
trigger1 = 1
time = 20
add = 150, 0, 0
color = 200
IgnoreHitPause = 1

[State 9999, 攻撃食らう前のステートに戻す]
type = ChangeState
trigger1 = HitShakeOver
value = var(31)
ctrl = var(32)

[State 9999, 速度Ｘ軸];Ｘ軸の移動速度を記憶
type = VarSet
trigger1 = time = 0
trigger1 = MoveType != H
trigger1 = StateNo != 9999
fv = 10
value = (Vel X)
IgnoreHitPause = 1
Persistent = 1

[State 9999, 速度Ｙ軸];Ｙ軸の移動速度を記憶
type = VarSet
trigger1 = time = 0
trigger1 = MoveType != H
trigger1 = StateNo != 9999
fv = 11
value = (Vel Y)
IgnoreHitPause = 1
Persistent = 1

