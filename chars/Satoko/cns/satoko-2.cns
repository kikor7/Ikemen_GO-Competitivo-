trigger1 = Time = 26
x = 3

[State 810, ヒット定義]
type = HitDef
trigger1 = AnimElem = 2
attr = S, SA
animtype  = back
getpower  = 100
priority  = 5
guardflag = 
pausetime = 3,3
sparkno = S4201
sparkxy = 0,-7
hitsound   = S2,5
guardsound = S2,10
ground.type = Trip
ground.slidetime = 20
ground.hittime  = 20
ground.velocity = 0.1,-2
guard.velocity = -3
air.cornerpush.veloff = 0
air.velocity = 0.3,-1
fall.damage = ifelse(Var(30) >= 1, 150, 80)
air.fall = 1
fall = 1
fall.recover = 0

