;===========================================================================
;---------------------------------------------------------------------------
; ジャンプ通常攻撃にChangeStateのコントローラが無いのは、
; Physicsを「A」にしているから。
; おまけフォルダの「小ネタ.txt」を参照。（Physicsの仕組み）
;
; しゃがみ通常技とは逆に、ジャンプ通常技は基本的に「中段属性」の攻撃。
; しゃがみガードが出来ないのが普通なので、guardflagを「HA」にしておくのが定石。
;「立ちガードの需要性」と「空対地のガードの揺さぶりによる駆け引き」を
; プレイヤーに楽しんでもらうための先人達の知恵だね。
;---------------------------------------------------------------------------
;ジャンプ弱攻撃
[Statedef 600]
type    = A
movetype= A
physics = A
juggle  = 2
poweradd= 0
ctrl = 0
sprpriority = 2

[State 600, アニメ(通常時)]
type = ChangeAnim
triggerall = PrevStateNo != 9999
trigger1 = Time = 0
value = 600
IgnoreHitPause = 1

[State 600, アニメ（アーマー処理から）]
type = ChangeAnim
triggerall = PrevStateNo = 9999
trigger1 = time = 0
value = 600
elem = var(33)

[State 600, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 2, 2

[State 600, ヒット定義]
type = HitDef
trigger1 = Time = 0
attr = A, NA ;空中通常打撃（Air, Normal Attack）
damage    = 20
getpower = 30,15
guardflag = HA ;相手はしゃがみガードが出来ない
priority = 3, Hit
pausetime = 7,8
sparkno = S4200
sparkxy = -10,-58
hitsound   = S2,5
guardsound = S6,0
ground.type = High
ground.slidetime = 5
ground.hittime  = 5
ground.velocity = -4
air.juggle = 3
air.velocity = -1.3,-3
fall.recover = 0

