;===========================================================================
; サブシステム
;===========================================================================
;---------------------------------------------------------------------------
;『ストⅢ』で登場したハイリスクハイリターンな究極の防御システム、ブロッキング。
; 複数のテクニックの組み合わせで再現出来る。色々駆使して作ったのは良いけど、
; 相手のヒットスパークさえ表示しなきゃ完璧なんだけどね…(´・ω・`)
; もちろん投げを捌く事は出来なくしてる。発生させる条件は-2にて処理。
; 
; これを応用して、メルティブラッドの『シールド』、
; 餓狼MOTWの『ジャストディフェンス（ＥＦＺのリコイルガード）』も再現出来る。
;
;「ReversalDef」と「HitOverRide」はSpecial.cnsの方で説明するので、ここでは割愛。
;---------------------------------------------------------------------------
;ブロッキング準備（ＡＩ専用ステートにしてます）
[Statedef 700]
type     = U
movetype = I
physics  = N
ctrl     = 0
anim     = ifelse(StateType=C,702,ifelse(StateType=A,704,701))
poweradd = 0

[State 700, 状態変更]
type = StateTypeSet
trigger1 = (StateType = A)
Physics = A
IgnoreHitPause = 1
Persistent = 1

;***********************************
[State 700, 軸位置]
type = PosSet
trigger1 = (StateType != A)
y = 0

[State 700, 移動速度]
type = VelSet
trigger1 = (StateType != A)
x = 0
y = 0

;***********************************
[State 700, 受け止め定義];相手のHitDef用
type = ReversalDef
trigger1 = Time = 0
reversal.attr = SCA, NA,SA,HA,NP,SP,HP
pausetime     = 0,14
numhits       = 0
sparkno       = -1
sparkxy       = 0,0
hitsound      = -1,-1
P1StateNo = 701

[State 700, 食らい上書き];相手のProjectile用
type = HitOverRide
trigger1 = Time = [0,6]
time = 1
;attr = SCA, NA,SA,HA,NP,SP,HP
attr = SCA, AA,AP
stateno = 701
IgnoreHitPause = 1

;***********************************
[State 700, ステート変更];地上
type = ChangeState
triggerall = (StateType != A)
trigger1 = (Time > 3)
value = ifelse((StateType=C),11,0)
ctrl = 1

[State 700, ステート変更];空中
type = ChangeState
triggerall = (StateType = A)
trigger1 = (Time > 3)
value = 51
ctrl = 1

;---------------------------------------------------------------------------
;ブロッキング（成功モーション）
[Statedef 701]
type     = U
movetype = I
physics  = U
ctrl     = 0
anim     = ifelse((StateType!=A)&&(EnemyNear,StateType=C),703,ifelse(StateType=A,705,701))
poweradd = 150

[State 701, 速度Ｘ軸];Ｘ軸の移動速度を記憶
type = VarSet
triggerall = (StateType = A)
trigger1 = Time = 0
fv = 10
value = (Vel X)
IgnoreHitPause = 1
Persistent = 1

[State 701, 速度Ｙ軸];Ｙ軸の移動速度を記憶
type = VarSet
triggerall = (StateType = A)
trigger1 = Time = 0
fv = 11
value = (Vel Y)
IgnoreHitPause = 1
Persistent = 1

;***********************************
[State 701, ライフ増減]
type = LifeAdd
trigger1 = Time = 0
value = 5
IgnoreHitPause = 1
Persistent = 1

[State 701, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 2

[State 701, 時間停止]
type = Pause
trigger1 = Time = 0
time = 14
movetime = 14
IgnoreHitPause = 1
Persistent = 1

[State 701, 押し判定];単なる気休め（これは消してもＯＫ）
type = PlayerPush
trigger1 = 1
value = 1
IgnoreHitPause = 1
Persistent = 1

[State 701, 画像の色]
type = PalFX
trigger1 = Var(30) = 0
trigger1 = Time = 0
time = 12
add = 80,80,255

;***********************************
[State 701, 軸位置]
type = PosSet
trigger1 = (StateType != A)
y = 0

[State 701, 移動速度]
type = VelSet
trigger1 = (StateType != A)
trigger2 = (StateType = A) && (Time = [0,13])
