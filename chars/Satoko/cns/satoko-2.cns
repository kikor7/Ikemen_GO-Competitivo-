;========================================================================
;投げ
;========================================================================
;---------------------------------------------------------------------------
;投げ
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
poweradd= 0
sprpriority = 2

[State 800, アニメ(通常時)]
type = ChangeAnim
triggerall = PrevStateNo != 9999
trigger1 = Time = 0
value = 800
IgnoreHitPause = 1

[State 800, アニメ（アーマー処理から）]
type = ChangeAnim
triggerall = PrevStateNo = 9999
trigger1 = time = 0
value = 800
elem = var(33)

[State 800, スピード]
type = VelSet
trigger1 = time < 7
x = 3

[State 800, 1]
type = AssertSpecial
trigger1 = 1
flag = unguardable

[State 800, 1]
type = HitDef
getpower = 60,30
Trigger1 = Time = 0
priority = 1
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sprpriority = 1       ;Draw in front of p2
sparkno = 20000
p1stateno = 810       ;On success, KFM changes to state 810
p2stateno = 820       ;If hit, p2 changes to state 820 in KFM's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down
fall.recover = 0

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

