;===========================================================================
; 通常攻撃技
;===========================================================================
;---------------------------------------------------------------------------
;立ち弱攻撃
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
poweradd = 0
sprpriority = 2
facep2 = 1

[State 200, アニメ(通常時)]
type = ChangeAnim
triggerall = PrevStateNo != 9999
trigger1 = Time = 0
value = 200
IgnoreHitPause = 1

[State 200, アニメ（アーマー処理から）]
type = ChangeAnim
triggerall = PrevStateNo = 9999
trigger1 = time = 0
value = 200
elem = var(33)

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 2, 2

[State 200, 声]
type = PlaySnd
trigger1 = Time = 1
trigger1 = Random <= 349
value = 1, 0
channel = 4

[State 200, ヒット定義]
type = HitDef
trigger1 = time = 1
attr = S, NA
damage = 30
getpower = 30,15
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 8, 8
sparkno = S4200
sparkxy = -10, -40
hitsound = S2, 5
guardsound = S6, 0
ground.type = High
ground.hittime  = 8
ground.slidetime = 5
ground.velocity = -2
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -1.4,-3
air.hittime = 12

[State 200, ヒット定義（カウンターヒット）]
type = HitDef
trigger1 = P2moveType = A
trigger1 = P2StateType = A
trigger1 = time = 1
attr = S, NA
damage = 40
getpower = 30,15
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 0,15
pausetime = 8, 8
sparkno = S4201
sparkxy = -10, -40
hitsound = S2, 6
guardsound = S6, 0
ground.type = High
ground.hittime  = 20
ground.slidetime = 5
ground.velocity = -2, -3
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -1.4,-5
air.hittime = 12
fall.recover = 0
fall = 1

[State 200, ステート変更]
type = ChangeState
trigger1 = Animtime = 0
value = 0
ctrl = 1

