;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0, 2

[State 180, 2]
type = ChangeState
triggerall = command = "holdx" || command = "holdy"
trigger1 = time = 1
value = 181

[State 180, 3]
type = ChangeState
triggerall = command = "holda" || command = "holdb"
trigger1 = time = 1
value = 182

[State 180, 4]
type = ChangeState
trigger1 = Time = 1
value = 180 + var(1)

;---------------------------------------------------------------------------
; Winpose 1
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, 2]
type = PlaySnd
trigger1 = animelem = 1
value = S180,0
channel = 0
volume = 255

[State 181, 3]
type = AssertSpecial
trigger1 = time <= 230
flag = roundnotover

[State 181, 4]
type = AssertSpecial
triggerall = numhelper(3650)
trigger1 = 1
flag = invisible

[State 181, 5]
type = Helper
triggerall = teammode = single
trigger1 = time = 229 && MatchOver
helpertype = normal
name = "Winscreen"
ID = 3650
stateno = 3650
pos = 0,0
postype = p1
facing = 1
keyctrl = 0
ownpal = 1

