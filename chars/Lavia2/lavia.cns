;---------------------------------------------------------------------------
; Taunt
; CNS difficulty: easy
[Statedef 195]
type = S
ctrl = 0
anim = 195
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Standing Light Punch
; CNS difficulty: easy
[Statedef 200]
type    = S				;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A				;Move-type: A-attack, I-idle, H-gethit
physics = S				;Physics: S-stand, C-crouch, A-air
;Commonly-used controllers:
velset = 0,0			;Set velocity (x,y) (Def: no change)
ctrl = 0				;Set ctrl (Def: no change)
anim = 200 + (var(11) != 0)				;Change animation (Def: no change)
poweradd = 0			;Power to add (Def: 0)
sprpriority = 2			;Set layering priority to 2 (in front)

[State StateType]
type = StateTypeSet
trigger1 = !time
trigger1 = var(10) = 3
statetype = A
physics = N

[State StateType Flag]
type = VarSet
trigger1 = !time
var(10) = ifelse( statetype = A, 3, ifelse( statetype = C, 2, 1 ) )
ignorehitpause = 1

[State 200, PlaySnd]
type = PlaySnd
trigger1 = animelemno(1) = 2
value = 20, 1
persistent = 0
channel = 1

[State 200, 1]
type = HitDef
triggerall = var(22)
triggerall = !var(43)
triggerall = !var(11)
trigger1 = !movecontact && !movereversed
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
attr = S, NA
damage = 104, 0
getpower = 30,15
animtype = Medium
guardflag = MA
hitflag = MA
pausetime = 11, 11
sparkno = s17001
guard.sparkno = s17006 + 2*(numenemy = 1 && var(8) - var(6) < 1)
sparkxy = ifelse(p2bodydist x < 20, ifelse(p2bodydist x < 0, -30, ceil(p2bodydist x - 30)), -10), floor(-58*const(size.yscale))
hitsound   = -1 + (var(23) := 2)*0 ;s5,1
guardsound = s6,0 + 2*(numenemy = 1 && var(8) - var(6) < 1)
ground.type = High
ground.velocity = -7.5
ground.hittime  = 16
ground.slidetime  = 16
guard.hittime = 15
air.hittime = 999
airguard.ctrltime = 999
air.type = Low
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536

[State 200, 1]
type = HitDef
triggerall = var(22)
triggerall = !var(43)
triggerall = var(11)
trigger1 = !movecontact && !movereversed
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
