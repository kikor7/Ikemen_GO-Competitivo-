;Vars:
;	0  = temp var
;	1  = temp var
;	2  = enemy 1 id
;	3  = enemy 1 guardcrush guage
;	4  = enemy 2 id
;	5  = enemy 2 guardcrush guage
;	6  = guard break strength
;	7  = guard break sound trigger
;	8  = guard crush fx check
;	9  = starting animelem
;	10 = fake statetype flag
;	11 = altitude flag
;	12 = normal walking off/on
;	13 = hover statetype
;	14 = id of most recent hitdef
;	15 = highjump buffer
;	16 = custom gameplay off/on

;	18 = hit tracking

;	22 = warzard hitsparks off/on
;	23 = hitsound flag
;	24 = target pos
;	25 = helper pos
;	26 = movehit/fx sound flag
;	27 = fx element flag
;	28 = previous hitpausetime
;	29 = holdz
;	30 = holdc

;	33 = delay damage dampening

;	37 = previous uniqhitcount
;	38 = combo counter
;	39 = helper combo counter
;	40 = helper has target

;	43 = juggle flag
;	44 = juggle level

;	51 = walk timer
;	52 = enemy cornered
;	53 = hitstun balance

;	56 = pause/superpause check
;	57 = (Winane) GameTime var, for pause and custom state check
;	58 = ai action select
;	59 = (Winane) AI

;Fvars:
;	0  = temp var
;	1  = temp var
;	2  = hover height

;	3  = math var
;	4  = math var

;	10 = AI aggression setting

;	12 = guard crush strength setting
;	13 = overall damage mod
;	14 = damage dampening setting

;Channels:
;	0  = voice
;	1  = swing
;	2  = flap
;	3  = fire
;	4  = fx

[Data]
life = 1000			;Amount of life to start with
attack = 90		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 1		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 200			;Volume offset (negative for softer)
IntPersistIndex = 58	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
;Adapted scale large (direct conversion from CPS-3)
;	xscale=0.83333333333333333333333333333333
;	yscale=1.0714285714285714285714285714286

;Adapted scale small (bit smaller to avoid pixellation)
	xscale = 0.801           ;Horizontal scaling factor.
	yscale = 1

;Original scale (no scaling, may appear "squashed")
;	xscale = 1           ;Horizontal scaling factor.
;	yscale = 1           ;Vertical scaling factor.

ground.back = 20		;Player width (back, ground)
ground.front = 20		;Player width (front, ground)
air.back = 20		;Player width (back, air)
air.front = 20		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 200		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 1		;Set to 1 to scale projectiles too   
;head.pos = 25, -107	;head pos while standing
head.pos = -20, -125	;head pos when hit high
mid.pos = 8, -75		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 3.33		;Walk forward
walk.back = -3.33		;Walk backward
run.fwd  = 7.5, 0		;Run forward (x, y)
run.back = -5, -6.96		;Dash backward (x, y)
jump.neu = 0,-11.6		;Neutral jumping velocity (x, y)
jump.back = -2.5		;Jump back Speed (x, y)
jump.fwd = 2.5		;Jump forward Speed (x, y)
runjump.back = -2.55,-11.6;Running jump speeds (opt)
runjump.fwd = 4,-11.6	;.
airjump.neu = 0,-11.6	;.
airjump.back = -2.5	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .429		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, 1]
type = ChangeAnim
trigger1 = anim = 6
value = 5

[State 180, 3]
type = ChangeAnim
triggerall = var(11)
trigger1 = anim = 5
value = 15

[State 180, 1]
type = VarSet
trigger1 = anim = 5 || anim = 15
trigger2 = anim = 20
var(9) = 65

[State 180, 1]
type = VarSet
trigger1 = anim = [5005, 5027]
trigger2 = anim = [5505, 5527]
var(9) = 69

[State 180, 1]
type = VarSet
trigger1 = anim = [140, 142]
var(9) = 21

[State 180, 1]
type = VarSet
trigger1 = anim = 0
trigger2 = anim = [21, 22]
trigger3 = anim = 100
var(9) = animelemno(0)

[State 180, 1]
type = ChangeAnim
trigger1 = (anim != [1, 2]) && (Anim != 5 && anim != 15)
trigger1 = fvar(0) := 8*sin(var(9)*pi/36.5 + pi*1.5)*const(size.yscale) || 1
trigger1 = var(0) := 30
trigger2 = (Anim = 5 || anim = 15) && AnimTime = 0 ;Turn anim over
trigger2 = fvar(0) := 8*sin(var(9)*pi/36.5 + pi*1.5)*const(size.yscale) || 1
trigger2 = var(0) := 30
value = ifelse( var(11), 2, 1 )
elem = var(9)

[State 180, ChangeState]
type = ChangeState
trigger1 = anim > 2
trigger2 = animelem = 41
value = 181

[State 180, 1]
type = VarSet
trigger1 = anim = [1, 2]
var(9) = 0

[State 180, 1]
type = VarSet
trigger1 = var(0) < 90
fvar(1) = fvar(0)*(0.5 + 0.5*sin(var(0)*pi/60))

[State 180, 1]
type = VarSet
trigger1 = var(0) = 90
fvar(1) = 0

[State 180, 1]
type = VarAdd
trigger1 = var(0) < 90
var(0) = 1

[State 180, Sine]
type = Offset
trigger1 = anim = [1, 2]
y = fvar(1) - 8*sin(animelemno(0)*pi/36.5 + pi*1.5)*const(size.yscale)

[State 180, 1]
type = AssertSpecial
trigger1 = time < 300
flag = RoundNotOver

