[State 0, PalFX]
type = PalFX
trigger1 = time = 0
time = 150
add = 30,60,80
invertall = 0
color = 50

[State 6403, vel]
type = velset
trigger1 = time >= 0
x = 0
y = 0


[State 0, Turn]
type = Turn
triggerall = p2bodydist x < 0
trigger1 = p2stateno = 1852

[State 0, Selfstate]
type = Selfstate
trigger1 = p2stateno = 1852
value = 5050
ctrl = 0

[State 0, Selfstate]
