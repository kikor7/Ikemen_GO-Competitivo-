
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "Chain saw Man"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Chain saw Man"      ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 10,15,2025     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 1.1   	      ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Aitoro"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 6,3,4,2        ;ＣＰＵで出てきた時のカラーパレットの順番
;localcoord = 426


[Files]
movelist = movelist.dat
Cmd      = DENJI_cmd.cmd       
Cns      = DENJI_CNS.cns
StCommon = DENJI_COMMON.cns
St      = DENJI_CNS.cns     
St0     = DENJI_Attk.cns
St1     = DENJI_-2-3.cns
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません

Sprite  = DENJI.sff       ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = DENJI.air       ;アニメーションファイルの登録
Sound   = DENJI.snd       ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録



Pal1 = DENJI.act		
Pal2 = POTITA.act


