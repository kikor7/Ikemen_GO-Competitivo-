[StateDef 231]
MoveType    = A
Physics     = N
Anim        = 255
VelSet      = IfElse(IsHelper(231), 15, 10), IfElse(IsHelper(231), 0, IfElse(IsHelper(232), -5, 4))
SprPriority = 3

[State 231,~影なし~]
Type     = AssertSpecial
Trigger1 = 1
Flag     = NoShadow

[State 231,~透明~]
Type     = Trans
Trigger1 = 1
Trans    = Add

[State 231,~移動速度~]
Type     = VelSet
Trigger1 = IsHelper(231) || IsHelper(232) || IsHelper(233) || IsHelper(234)
X        = 15*IfElse(IsHelper(231), Cos(0*Pi/180), IfElse(IsHelper(232), Cos(25*Pi/180), Cos(-25*Pi/180)))
Y        = -15*IfElse(IsHelper(231), Sin(0*Pi/180), IfElse(IsHelper(232), Sin(25*Pi/180), Sin(-25*Pi/180)))

[State 231,~サイズ大きく~]
Type     = VarAdd
Trigger1 = 1
FV       = 0
Value    = 0.35

[State 231,~サイズ変更~]
Type     = AngleDraw
Trigger1 = 1
Value    = ATan (Vel Y / Vel X) * (-180.0 / Pi)
Scale    = 1+FVar(0),1

[State 231,~攻撃力変更~]
Type     = AttackMulSet
Trigger1 = 1
Value    = Root,FVar(3)
