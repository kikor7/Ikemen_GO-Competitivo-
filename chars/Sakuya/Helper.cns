Air.HitTime                = 16
Ground.Velocity            = 0,10
Air.Velocity               = 0,10
Ground.CornerPush.VelOff   = 0
Air.CornerPush.VelOff      = 0
Guard.CornerPush.VelOff    = 0
Airguard.CornerPush.VelOff = 0
Fall                       = 1
Fall.RecoverTime           = IfElse(Ceil(60*Root,FVar(20)) <= 15, 15, Ceil(60*Root,FVar(20)))
Guard.Kill                 = 0
GetPower                   = 40,20
Hitonce                    = 1
NumHits                    = 0

[State 3203,~ヒット数上げ~]
Type     = HitAdd
Trigger1 = MoveHit && P2MoveType = H && P2StateNo != [120,159]
Value    = 1
IgnoreHitPause = 1
Persistent = 0

[State 3203,~ヒットエフェ~]
Type     = Helper
Trigger1 = MoveHit && P2MoveType = H && P2StateNo != [120,159]
Name     = "Hit"
Stateno  = 6030
ID       = 6032
Pos      = Ceil(EnemyNear,Pos X - Pos X) * Facing,Ceil(EnemyNear,Pos Y - Pos Y - 50)
PosType  = P1
OwnPal   = 1
SuperMoveTime = 999
PauseMoveTime = 999
IgnoreHitPause = 1
Persistent = 0
[State 3203,~ガードエフェ~]
Type     = Helper
Trigger1 = MoveGuarded && P2MoveType = H
Name     = "Guard"
Stateno  = 6050
ID       = 6050
Pos      = Ceil(EnemyNear,Pos X - Pos X) * Facing,Ceil(EnemyNear,Pos Y - Pos Y - 50)
PosType  = P1
OwnPal   = 1
SuperMoveTime = 999
PauseMoveTime = 999
IgnoreHitPause = 1
Persistent = 0

[State 3203,~補正値~]
Type     = ParentVarAdd
Trigger1 = MoveHit
FV       = 3
Value    = -.03
IgnoreHitPause = 1
Persistent = 0
[State 3203,~補正値~]
Type     = ParentVarAdd
Trigger1 = MoveHit
FV       = 20
Value    = -.04*Root,FVar(21)
IgnoreHitPause = 1
Persistent = 0

[State 3203,~消滅~]
Type     = DestroySelf
Trigger1 = Time >= 200
Trigger2 = Pos Y >= 50 && Vel Y >= 0 || ScreenPos Y <= -50 && Vel Y < 0
Trigger3 = FrontEdgeBodyDist <= -50 && Vel X >= 0 || BackEdgeBodyDist <= -50 && Vel X < 0
