[Statedef 1000]
Type     = U
poweradd = 20
MoveType = A
Physics  = N
VelSet   = IfElse(PrevStateNo != 101, 0, Vel X),0
Anim     = 1000
Ctrl     = 0

[State 1000,~状況設定~]
Type     = StateTypeSet
Trigger1 = Time = 0 && StateType != A
Value    = S
Physics  = S

[State 1000,~行動設定~]
Type     = VarSet
Trigger1 = StateType != A && Time = 0 && Var(57) != 1
Trigger2 = StateType = A && Time = 0
V        = 20
Value    = IfElse(Command = "a", 0, 1)
[State 1000,~行動設定~]
Type     = VarSet
Trigger1 = Time = 0 && Var(57) = 1
V        = 20
Value    = IfElse(Command = "a", 0, 2)

[State 1000,~行動設定~]
Type     = VarSet
Trigger1 = Time = 0 && Var(59) = 1 && Var(57) = 0
V        = 20
Value    = IfElse(Random >= 850, 0, 1)
[State 1000,~行動設定~]
Type     = VarSet
Trigger1 = Time = 0 && Var(59) = 1 && Var(57) = 1
V        = 20
Value    = IfElse(Random >= 500, 0, 2)

[State 1000,~アニメ変更~]
Type     = ChangeAnim
Trigger1 = StateType != A && Time = 0
Value    = IfElse(Var(20) != 2, 1000, 1001)
[State 1000,~アニメ変更~]
Type     = ChangeAnim
Trigger1 = StateType = A && Time = 0
Value    = 1002

[State 1000,~ナイフ発射~]
Type     = PlaySnd
Trigger1 = Anim = 1000 && AnimElem = 7
Trigger2 = Anim = 1001 && AnimElem = 6
Trigger3 = Anim = 1002 && AnimElem = 5
Value    = S3,0
Channel  = 1

[State 1000,~霊力消費~]
Type     = VarAdd
Trigger1 = Anim = 1000 && AnimElem = 7
Trigger2 = Anim = 1001 && AnimElem = 6
Trigger3 = Anim = 1002 && AnimElem = 5
FV       = 4
Value    = -150
[State 1000,~回復までのタイム~]
Type     = VarSet
Trigger1 = Anim = 1000 && AnimElem = 7
Trigger2 = Anim = 1001 && AnimElem = 6
Trigger3 = Anim = 1002 && AnimElem = 5
V        = 7
Value    = 60

[State 1000,~速度設定 X~]
Type     = VelSet
Trigger1 = Time = 0
X        = Vel X * 0.25
[State 1000,~速度設定 Y~]
Type     = VelSet
Trigger1 = Time = 0
Y        = Vel Y * 0.25
[State 1000,~速度設定~]
Type     = VelSet
Trigger1 = StateType = A && AnimElem = 6
X        = -1.5
Y        = -4
[State 1000,~速度設定~]
Type     = VelAdd
Trigger1 = StateType = A && AnimElem = 6,>= 1
Y        = 0.3
[State 1000,~地上に着いた~]
Type     = VelSet
Trigger1 = StateType = A && Vel Y = 0 || StateType = A && Pos Y >= 5
Y        = 0

