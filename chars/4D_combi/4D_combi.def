; 四次元殺法コンビの定義ファイルです。
;
; ※説明文などで左の部分に半角でセミコロン（;）が付いていますが、
; 　これが付いた後の行や文章は全て『コメント化』されます。
; （プログラムとして処理はされない）
; 　作成中のメモを残しておいたり、ステート間の区切りを設ける時などに便利です。
;
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "PENTAGON & BLACK HOLE"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "PENTAGON & BLACK HOLE"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 11,02,2012     ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002     ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "haguremono"     ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,4,       ;ＣＰＵで出てきた時のカラーパレットの順番
;-----------------------------------------------------------------------------
[Files]
movelist = movelist.dat
Cmd     = 4D_combi.cmd 
Cns     = state/4D_combi.cns
St       = state/4D_combi.cns
St0      = state/normal.cns 
St1      = state/special.cns
St2      = state/hyper.cns 
St3      = state/-2.cns 
St4      = state/4D_AI.cns
StCommon = state/4D_common.cns 
Sprite  = 4D_combi.sff 
Anim    = 4D_combi.air 
Sound   = 4D_combi.snd 
;-----------------------------------------------------------------------------

Pal1 =   act3.act ;Ａボタンで決定した色が使えます
Pal2 =   act2.act ;Ｂ
Pal3 =   act5.act ;Ｃ
Pal4 =   act1.act;Ｘ
Pal5 =   act4.act ;Ｙ
Pal6 =   act6.act ;Ｚ

Pal7 =   act3.act ;Ｓ押しながらＡボタンで決定した色が使えます
Pal8 =   act2.act ;Ｓ押しながらＢ
Pal9 =   act5.act ;Ｓ押しながらＣ
Pal10=   act1.act ;Ｓ押しながらＸ
Pal11=   act4.act ;Ｓ押しながらＹ
Pal12=   act1.act ;Ｓ押しながらＺ　　強化カラー
;-----------------------------------------------------------------------------

