;trigger4 = (stateno = 811) && (time = 0)
v = 18
value = 1
ignorehitpause = 1

; get rid of trailing anims when hit
[state -2, 1]
type = afterimagetime
trigger1 = movetype != a
trigger2 = stateno = 2002
trigger3 = stateno = 100
trigger3 = stateno = 0
time = 1
ignorehitpause = 1

[state -2, hurt sound randomizer]
type = varrandom
trigger1 = 1
v = 7
range = 0,1

