type    = A
movetype= a
physics = n
ctrl = 1
anim = 110
sprpriority = 1

[state 100, 1]
type = velset
trigger1 = time = 0
x = 7
y = 0

[state 192, 2]
type = playsnd
trigger1 = animelem = 1
value = 0, 17

[state 100, 4]
type = explod
trigger1 = time = 4
id = 100
anim = 9100
postype = p1
pos = 0,0
ownpal = 1
bindtime = 1
sprpriority = 5
persistent = 0
removeongethit = 1

[state 100, 6]
type = playsnd
trigger1 = animelem = 2
value = s5547, 0
persistent = 0

[state 100, 1]
type = varset
trigger1 = statetype = A
v = 6
value = 1

[state 100, 7]
type = changestate
triggerall = statetype = A
trigger1 = time = 25
value = 460

; RUN_FWD
[statedef 100]
type    = s
movetype= a
physics = n
ctrl = 1
anim = 100
sprpriority = 1

[state 192, 2]
type = screenbound
trigger1 = prevstateno = 710
value = 0

[state 192, 2]
type = playsnd
trigger1 = animelem = 1
value = s5547, 0

[State 0, Explod]
type = Explod
trigger1 = animelem = 1
anim = 9100
pos = 0,0
postype = p1  ;p2,front,back,left,right
sprpriority = 4
ownpal = 1


[state 100, 1]
type = velset
trigger1 = time = 0
x = 7

[state 100, 5]
type = assertspecial
trigger1 = 1
flag = nowalk

[state 100, 7]
type = changestate
trigger1 = time = 20
value = 101

;------------------------
; Dash Forward (land)
[statedef 101]
type    = s
physics = s
velset = 3,0
ctrl = 0
anim = 101

[State 100, 8] ;Slide Dust
type = explod
trigger1 = Time % 4 = 0
anim := 9185
sprpriority = 5
ownpal = 1

[state 100, 7]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------;
; Dash back
[statedef 105]
type    = s
movetype= I
physics = n
ctrl = 0
anim = 105
sprpriority = 1

[state 100, 1]
type = velset
trigger1 = time = 0
x = -7

[state 192, 2]
type = playsnd
trigger1 = animelem = 1
value = s5547, 0


[State 100, 8] ;Slide Dust
type = explod
trigger1 = Time % 4 = 0
anim := 9185
sprpriority = 5
ownpal = 1
pos = -20,0
vel = .8,0

[state 105, 1]
type = velset
trigger1 = time = 0
x = const(velocity.run.back.x)

[state 105, 4]
type = assertspecial
trigger1 = 1
flag = nowalk

[State 105,5]
