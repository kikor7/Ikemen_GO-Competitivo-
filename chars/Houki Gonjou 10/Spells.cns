;---------------------------------------------------------------------------
; Fire Charge Effect
[Statedef 1050]
type    = S
movetype= I                
velset = 0,0
ctrl = 0
anim = 8044
sprpriority = 10

[State 1050, BindToParent] ; Keeps the helper attached the to player.
type = BindToParent
trigger1 = !time
time = 999
pos = -40,-85

[State 1050, Trans]
type = Trans
trigger1 = 1
trans = add

[State 1050, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S1000,13

[State 1050, AngleDraw] ; This is for a slow get bigger scaling, starting with the sprite ratio 1:1 then enlarges to 2:2
type = AngleDraw
trigger1 = time <100
scale = 1+time*0.01,1+time*0.01

[State 1050, AngleDraw] ; This is to maintain and keep the scale at 2:2 instead of it keep enlarging.
type = AngleDraw
trigger1 = time >= 100
scale = 2,2

[State 1050, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 1050, DestroySelf] ; It works alot better in a single state, so now the fire disappears when you let go, get hit, or attack.
type = DestroySelf
trigger1 = command != "holdc"
trigger1 = parent,stateno = 1001 || parent,stateno = 1005 || parent,stateno = 1010 || parent,stateno = 1011
trigger2 = Parent,movetype = H
