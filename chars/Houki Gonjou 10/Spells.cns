;---------------------------------------------------------------------------
; Fireball 
[Statedef 1000]
type    = S
poweradd = 20
movetype= I
physics = S                 
velset = 0,0
ctrl = 0
anim = 1000
sprpriority = 1

[State 1000, PowerAdd]
type = PowerAdd
trigger1 = Time = [1,100]
value = -10

[State 1000, Snd]
type = null;playsnd
trigger1 = time = 50

[State 1000, Snd]
type = playsnd
trigger1 = time = 25 || time = 50 || time = 100
value = 2000,0

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = Time = 1
value = S1000,11

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = time = 25
value = S2000,1
channel = -1

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = time = 50
value = S2000,2
channel = -1

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = time = 100
value = S2000,3
channel = -1

[State 1000, VarSet]
type = VarSet
trigger1 = time = 0
v = 10
value = 0
[State 1000, VarAdd]
type = VarAdd
trigger1 = time = 25 || time = 50 || time = 100
v = 10
value = 1

[State 1000, PalFX]
type = PalFX
trigger1 = time = 25 || time = 50 || time = 100
time = 2
add = 128,128,128
mul = 256,256,256

[State 1000, EnvShake]
type = EnvShake
trigger1 = time = 100
time = 10
freq = 60
ampl = -2
phase = 90

[State 1000, Explod]
type = Explod
trigger1 = time = 25
anim = 8025
ID = 1002
pos = -50,-75
postype = p1
removetime = -2
pausemovetime = 0
supermovetime = 0
scale = .25,.25
sprpriority = 5
ownpal = 1
removeongethit = 1

[State 1000, Explod]
type = Explod
trigger1 = time = 50
anim = 8025
ID = 1002
pos = -50,-75
postype = p1
removetime = -2
pausemovetime = 0
supermovetime = 0
scale = .5,.5
sprpriority = 5
ownpal = 1
removeongethit = 1

[State 1000, Explod]
type = Explod
trigger1 = time = 100
anim = 8025
ID = 1002
pos = -50,-75
postype = p1
removetime = -2
pausemovetime = 0
supermovetime = 0
scale = .75,.75
sprpriority = 5
ownpal = 1
removeongethit = 1

[State 1000, Helper]
type = Helper
trigger1 = Animelem = 6 && var(10)=0
name = "Fire Fx"
ID = 1000
stateno = 1050
pos = -40,-85
postype = p1
facing = 1
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0

[State 1000, ChangeState]
type = ChangeState
trigger1 = power = 0 && var(10)= 0
trigger2 = command != "holdc" && animtime=0 && var(10)=0
value = 1001
ctrl = 0

[State 1000, ChangeState]
type = ChangeState
trigger1 = power = 0 && var(10)=0
trigger2 = command != "holdc" && animtime=0 && var(10)=1
value = 1005
ctrl = 0

[State 1000, ChangeState]
type = ChangeState
trigger1 = power = 0 && var(10)=1
trigger2 = command != "holdc" && animtime=0 && var(10)=2
value = 1010
ctrl = 0

[State 1000, ChangeState]
type = ChangeState
trigger1 = power = 0 && var(10)>=2
trigger2 = command != "holdc" && animtime=0 && var(10)>=3
value = 1011
ctrl = 0

