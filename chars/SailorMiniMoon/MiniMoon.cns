trigger1 = Time = 0
value = 105,0

[State 5400, 5]
type = VelAdd
trigger1 = command = "holdback"
trigger1 = command != "holdfwd"
trigger1 = Time >= 0
trigger1 = Vel X <= 0
trigger1 = Vel X > -2
x = -.05

[State 5400, 5]
type = VelAdd
trigger1 = command = "holdfwd"
trigger1 = command !="holdback"
trigger1 = Vel X < 5
trigger1 = Time >= 0
x = .10

[State 5400, 5]
type = VelSet
trigger1 = command != "holdfwd"
trigger1 = command != "holdback"
trigger1 = Time >= 0
trigger1 = Vel X = 0
x = 0

