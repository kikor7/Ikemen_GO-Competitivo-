;空中ダッシュ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;空中なのでtypeとphysicsがＡ、つまり空中です。
;phisicsをＡにすると地上についた瞬間強制的に立ち状態に戻ります。
;途中からctrl = 1にすることで空中ダッシュ中に攻撃ができるようにしてます。

[Statedef 103]
type    = A
movetype= I
physics = N
anim    = 315315   ;前方ジャンプと同じ
velset  = 0,0   ;速度リセット
ctrl    = 0     ;初めは0に
sprpriority = 1

