; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 5


[State 5110, 相手消滅]
type = AssertSpecial
trigger1 = PrevStateNo = 3910
flag = invisible

[State 40, 5]
type = varSet
trigger1 = time = 0
trigger1 = var(15) = 1
v = 15
value = 0

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = [1,11]
var(40) = 1

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = [1,11]
var(29) = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 12Pカラー強化オプション
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;------------------------------------------------------------------------------
;基礎強化
;------------------------------------------------------------------------------
;var(40) = x
;xの値で以下の補正うけます。1~7のうち一つを選んでください。7以上を書いても7の補正になります
;x= 1　攻撃力１　    超必殺技火力１　   パワーゲージ１　    一撃ゲージ1
;x= 2　攻撃力１．１　超必殺技火力１.１　パワーゲージ１．１　一撃ゲージ1.1
;
;
;x= 3　攻撃力１．２　超必殺技火力１．１５　パワーゲージ１．２　一撃ゲージ1.2
;　　　　
;
;x= 4  攻撃力１．３　超必殺技火力１．１５　パワー１．３　一撃1.3
;　　　
;
;x= 5  攻撃力１．４　超必殺技火力１．２　パワー１.４　一撃1.4
;　　　　
;x= 6  攻撃力１．５　超必殺技火力１．２　パワー１．５　一撃1.5
;　　　　　発生に攻撃判定が出るギリギリまで無敵判定付与、パワーゲージ徐々に回復
;
;x= 7  攻撃力２　　超必殺技火力１．４　パワー２　一撃ゲージ2
;　　　　　全技に発生保障、パワーゲージ、体力、一撃ゲージが徐々に回復
;初期値は1に設定してあります

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(40) = 1

;-------------------------------------------------------------------------------
;神気解放カラー
;-------------------------------------------------------------------------------
;var(12) = x
;xを0か1に設定してください。
;x =0 通常通り
;x =1 神気解放カラー。俗に言う強化カラー。技が強化される
;初期値は1に設定してあります。

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(12) = 1

;--------------------------------------------------------------------------------
;パワーゲージ
;--------------------------------------------------------------------------------
;var(11) = x
;xを0か1に設定してください。
;x = 0　通常通り
;x = 1 ゲジマユ
;初期値は0に設定してあります。

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(11) = 0

;--------------------------------------------------------------------------------
;一撃ゲージ
;--------------------------------------------------------------------------------
;var(49) = x
;xを0-2のどれかに設定してください。
;x =0 通常通り
;x =1 １ラウンド目から一撃必殺技が使えるようになる
;x =2 １ラウンド目から一撃が使えるようになり、常時ゲージMAX
;初期値は0に設定してあります

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(49) = 0

;--------------------------------------------------------------------------------
;キャロ
;--------------------------------------------------------------------------------
;var(29) = x
;xを0-2のどれかに設定してください。
;x =0 キャロ召喚できない。経験値たまらない
;x =1 標準
;x =2 キャロ自動回復経験値２倍
;x =3 キャロ常時星５
;初期値は1に設定してあります

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(29) = 1
