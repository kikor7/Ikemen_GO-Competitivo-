[StateDef 8000]
Type = A
MoveType = I
Physics = N
Anim = 8000

[State 8000, PosAdd];本体に貼り付く
Type = PosAdd
TriggerAll = Time >= 0
Trigger1 = Floor(ParentDist X) != 0
Trigger2 = Floor(ParentDist Y) != 0
X = Floor(ParentDist X)
Y = Floor(ParentDist Y)

[State 8000, ParentVarSet]
Type = ParentVarSet
Trigger1 = Parent,Var(50) < 0
V = 50
Value = 0

;--------------------　ＰＰゲージ表示
[State 8000, PalFX]
Type = PalFX
Trigger1 = Time >= 0
Trigger1 = Parent,Var(50) = [0, 150]
Trigger1 = Parent,Var(51) = 0
Time = 1
Add = 0, 0, 0
Mul = 255, Floor(255.0*Parent,Var(50)/150), 0

[State 8000, PalFX]
Type = PalFX
Trigger1 = Time >= 0
Trigger1 = Parent,Var(50) = [151, 300]
Trigger1 = Parent,Var(51) = 0
Time = 1
Add = 0, 0, 0
Mul = Floor(255.0*(300-Parent,Var(50))/150), 255, 0

[State 8000, PalFX]
Type = PalFX
Trigger1 = Time >= 0
Trigger1 = Parent,Var(50) = [301, 450]
Trigger1 = Parent,Var(51) = 0
Time = 1
Add = 0, 0, 0
Mul = 0, 255, Floor(255.0*(Parent,Var(50)-300)/150)

[State 8000, PalFX]
Type = PalFX
Trigger1 = Time >= 0
Trigger1 = Parent,Var(50) = [451, 600]
Trigger1 = Parent,Var(51) = 0
Time = 1
Add = 0, 0, 0
Mul = 0, Floor(255.0*(600-Parent,Var(50))/150), 255

[State 8000, PalFX]
Type = PalFX
Trigger1 = Time >= 0
Trigger1 = Parent,Var(51) = 1
Time = 1
Add = 0, 0, 0
Mul = 255, 0, 0

