trigger1 = var(40) = 4
fv = 6
value = 1.3

[state a]
type = varset
trigger1 = var(40) = 5
fv = 6
value = 1.4

[state a]
type = varset
trigger1 = var(40) = 6
fv = 6
value = 1.5

[state a]
type = varset
trigger1 = var(40) >= 7
fv = 6
value = 2

