;矢はこちらにまとめてください
;2000-2020　立 2030-2050 しゃがみ　2660-2080 空中
;2100～必殺技主に青系
;2200～
;------------------弱　って放物線
[statedef 2000]
type    = a
movetype= A
physics = n
poweradd= 0
ctrl = 0
velset = 8,-8
anim = 11150
hitcountpersist = 1

;--------------------剣気ゲージ関連、めんど
[state 200x,defencetime];けんきゲージ  まず発射時点の係数を取得、以後自var
type = varset
trigger1 = time = 0
fvar(0) = root,fvar(0)
persistent = 0

[state 200x,defencetime];けんきゲージ  ガードヒット消費　１HITにつき1度だけ！気をつけないとめっちゃへる
type = parentvaradd
trigger1 = movecontact
fvar(2) = ifelse(movehit,-0.3,-0.2)
persistent = 0

[state 200x,defencetime];剣モード　おんりー　　怒りゲージ増加
type = parentvaradd
triggerall = var(1) = 6
trigger1 = movecontact
fvar(10) = ifelse(movehit,150,75)
persistent = 0
ignorehitpause = 1

[state 8000x,]
type = nothitby
trigger1 = 1
value = sca,na,nt,np,sa,sp,st,ha,hp,ht
time = 1
ignorehitpause = 1

[State 8000x, ride];テスト結果:P2stateno無効？すりぬける
type = HitOverride
trigger1 =1
attr = sca,na,sa,ha,np,sp,hp,nt,st,ht
slot = 0
stateno =2007
time = 1
ignorehitpause = 1

[state 8000x,]
type = playerpush
trigger1 = 1
time = 1
value = 0
ignorehitpause = 1

[State 3620,];
type = AssertSpecial
trigger1 =1
time = 1
flag = noshadow
flag2 = noautoturn
ignorehitpause = 1

[State 200, 1];LV1?
type = HitDef
trigger1 = time = 0
attr = a, sp                   
damage = floor(16 * fvar(0)),0                
animtype = medium              
guardflag = MA                  
hitflag = MAP                  
priority = 5            
pausetime = 0, 10
guard.pausetime = 0,10          
sparkno =s6200   
guard.sparkno =S6140
sparkxy = -10, -55  
guardsound = s150, random % 3
ground.type = High              
ground.slidetime = 15
ground.hittime  = 15             
ground.velocity = -3           
air.type = High                
air.velocity = -3,-5
fall = 0
air.fall = 1                 
air.hittime = 20                
getpower = 0,0
fall.recover =0
ground.cornerpush.veloff = 0
air.cornerpush.veloff    = 0
guard.cornerpush.veloff  = 0
airguard.cornerpush.veloff= 0

[state -3,test];blood
type = Explod
trigger1 = numtarget
trigger1 =movehit
anim = 6710
id = 6710
postype = p2
pos = 0, -55
sprpriority = 4
bindtime = -1
removetime = -2
ownpal=1
ignorehitpause = 1
persistent = 0 

[state 200x,];ヒット音　とどめの時の。またhitdef使用不可・・
type = playsnd
trigger1 = numtarget
trigger1 = movehit
value = s205,ifelse(target,gethitvar(damage) < target,life ,random % 5,10)
channel = 2
ignorehitpause = 1
persistent = 0 

[state 1110,]
type = changestate
trigger1 =movecontact
value = 2007
ignorehitpause = 1

;--------------------放物線特殊
[state 1110,]
type = veladd
trigger1 =1
y = 0.25
ignorehitpause = 0

[state 1110,]
type = changeanim
trigger1 =anim = 11150
trigger1 = vel y > -1
value = 11152
ignorehitpause = 0
persistent = 0
;---------------------------
[state 1130,]
type = posset
trigger1 = pos y >= -20 && vel y > 0
y = -20

[state 1130,]
type = changestate
trigger1 = pos y >= -20 && vel y > 0
trigger2 = pos y = -20
value = 2007

;---------------------
;あたった場合など、矢本体しばらく表示ー＞消える   のぼりとくだり、２種類あり！
[statedef 2007]
type    = a
movetype= i
physics =n
poweradd= 0
ctrl = 0
velset = 0,0
hitcountpersist = 1

[state 1110,];斜め上や
type = changeanim
trigger1 =anim = 11150
trigger1 = time = 0
value = 11155
ignorehitpause = 1
persistent = 0

[state 1110,];水平や
type = changeanim
trigger1 =anim = 11152
trigger1 = animelem = 1
trigger1 = time = 0
value = 11175
ignorehitpause = 1
persistent = 0

[state 1110,];斜め下矢
type = changeanim
trigger1 =anim = 11152
trigger1 = animelem >= 2
trigger1 = time = 0
value = 11154
ignorehitpause = 1
persistent = 0

[State 3620,];
type = AssertSpecial
trigger1 =random % 2 = 0
time = 1
flag = noshadow
flag2 = noautoturn
flag3 = invisible
ignorehitpause = 1

[State 3620,];
type = AssertSpecial
trigger1 =1
time = 1
flag = noshadow
flag2 = noautoturn
ignorehitpause = 1

[state 1130,]
type = destroyself
trigger1 = animtime = 0
value = 0

