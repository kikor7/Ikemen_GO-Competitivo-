[state 200x,defencetime];剣モード　おんりー　　怒りゲージ増加
type = varadd
triggerall = var(1) = 6
trigger1 = time = 0
fvar(10) = 100
persistent = 0

[State 3150,hit]
type = HitDef
trigger1 = time = 0
attr = s, HA                     ;立ち状態で、通常の攻撃(ｓは立ち、ｎは通常、aは攻撃を表す)
damage = floor(20 * fvar(0)),1                   ;ダメージ量（左が当たった時、右はガードした時）
animtype = hard                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = L                   ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MA                   ;当てる事のできる条件
priority = 7, Hit                ;攻撃の優先権（0弱い　4通常　7強い
pausetime = 0, 15                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
sparkno = S6300                      ;ヒットエフェクトのスプライトステート（無ければ0）
guard.sparkno = S6140
sparkxy = -5, -40               ;ヒットエフェクトを表示する場所（相手の座標で）
guardsound =s205, random % 2 + 30
ground.type = high               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 60             ;相手が後にすべる時間
ground.hittime  = 60             ;コンボが繋がる時間（高くしすぎない事）
ground.velocity = -1,-8             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
guardground.velocity = -5, 0            ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.hittype = back
air.slidetime = 60             ;相手が後にすべる時間
air.hittime  = 60             ;コンボが繋がる時間（高くしすぎない事）
air.velocity = -1, -8            ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
airground.velocity = -5, 0            ;地上で攻撃をくらったpalfx.time = 100
getpower = 30,15
fall = 0
fall.recover = 0
air.fall.recover = 0
ID = 1800

[state 200x,];ヒット音　とどめの時の。またhitdef使用不可・・
