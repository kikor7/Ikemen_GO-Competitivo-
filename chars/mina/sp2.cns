trigge1 = vel x <= 0.7
trigge1 = vel x >= -0.7
x = ifelse(command = "holdfwd",0.2,ifelse(command = "holdback",-0.2,0))
ignorehitpause = 1

[state 200x,defencetime];剣モード　おんりー　　怒りゲージ増加
