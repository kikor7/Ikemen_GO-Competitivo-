;れんぎり　500～
;STA A   A   B   B   C   C   C  *	A   A	 A	* B   B   C	* C   C   D 	
;500,505,510,515,520,525,530,535	505,510,540	  545,550,555	  560,565,570


;--1000　武器捨て　1100~1300通常弓

;-----------------------------------------------連続斬りいりこみスタート５００
[statedef 500]
type = s
poweradd = 0
movetype = a
physics = s
velset = 0,0
anim = 500 + var(0)
ctrl = 0
Hitcountpersist = 1

;--------------------剣気ゲージ関連、めんど
[state 200x,defencetime];けんきゲージ  ガードヒット消費　１HITにつき1度だけ！気をつけないとめっちゃへる
type = varadd
trigger1 = movecontact
fvar(2) = ifelse(movehit,-0.1,-0.05)
persistent = 0

[state 200x,defencetime];けんきゲージ  基本消費   素手と武器のときあるかもめんどい
type = varadd
trigger1 = animelem =2
fvar(2) = -0.05
persistent = 0
;-----------------------

[State 200, 1];れんげきダメージ１６固定。
type = HitDef
trigger1 = time = 0
attr = S, NA                   
damage = floor(16 * fvar(0))                
animtype = hard              
guardflag = M                  
hitflag = MA                  
priority = 4            
pausetime = 12, 12;あたると長い
guard.pausetime = 0,10          
sparkno =s6300   
guard.sparkno =S6140
sparkxy = -10, -85              
guardsound = s150, random % 3
ground.type = High              
ground.slidetime = 35
ground.hittime  = 40             
ground.velocity = -4           
air.type = High                
air.velocity = -3,-4
air.fall = 0
fall = 0                 
air.hittime = 15                
getpower = 3,1
ID=500

[State 2500x, ];よろけで
type = TargetState
trigger1 = Numtarget(500)
trigger1 = target(500),statetype != A
trigger1 = movehit
value = 5600
ID = 500
persistent = 0
ignorehitpause = 1

[state 200x,];ヒット音　とどめの時の。またhitdef使用不可・・
type = playsnd
trigger1 = numtarget
trigger1 = movehit
value = s205,ifelse(target,gethitvar(damage) < target,life ,random % 2 + 30,21)
channel = 2
ignorehitpause = 1
persistent = 0 

[State 200x, guard];はじかれ硬直あり、キャンセル不能
type = varset
trigger1 = 1
var(13) = 0
ignorehitpause = 1

[State 200x, guard];はじかれ硬直あり、キャンセル不能
type = varset
trigger1 = 1
var(14) = 20
ignorehitpause = 1

[State 200x, guard];はじかれ硬直あり、キャンセル不能
type = ChangeState
trigger1 = moveguarded
value = 700
ignorehitpause = 1

[state 500,];CCDルート
type = changestate
trigger1 = command = "s"
trigger1 = animelemtime(2) >= 2
trigger1 = animelemtime(4) < 0
value = 560

[state 500,];BBCルート
type = changestate
trigger1 = command = "m"
trigger1 = animelemtime(2) >= 2
trigger1 = animelemtime(4) < 0
value = 545

[state 500,];AAA AABBCCCルート
type = changestate
trigger1 = command = "w"
trigger1 = animelemtime(2) >= 2
trigger1 = animelemtime(4) < 0
value = 505

[state 500,]
type = changestate
trigger1 = animtime = 0
value = 0
ctrl = 1

