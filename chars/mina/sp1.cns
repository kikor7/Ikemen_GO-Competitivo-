ground.type = low               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 20             ;相手が後にすべる時間
ground.hittime  = 25             ;コンボが繋がる時間（高くしすぎない事）
ground.velocity = -4,-5             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可
guard.velocity = -5          
guard.hittime = 20
guard.slidetime = 25             
air.type = High                
air.velocity = -4,-5
air.hittime = 20
air.sliedtime = 18                 
yaccel = 0.38
fall.envshake.time = 15
fall = 0
