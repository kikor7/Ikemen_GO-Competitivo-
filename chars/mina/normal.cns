; 立ち・P・　s200,swwf13
[Statedef 200];
type    = S                      
movetype= A                      
physics = s  
velset = 0,0
ctrl = 0                         
anim = 200 + var(0)            
sprpriority = 2                 
Hitcountpersist = 1

[state 200x,cancelF];キャンセルOK？フラグ
type = varset
trigger1 = time = 0
trigger2 = animelem = 6 
var(13) = 0

[state 200x,cancelF];キャンセルOK？フラグ
type = varset
trigger1 = var(0)
trigger1 = animelemtime(4) >= 0 
trigger1 = movecontact
var(13) = 1
ignorehitpause = 1

[state 200x,defencetime];弾かれ硬直時間設定
type = varset
trigger1 = time = 0
var(14) = 18

;--------------------剣気ゲージ関連、めんど
[state 200x,defencetime];けんきゲージ  ガードヒット消費　１HITにつき1度だけ！気をつけないとめっちゃへる
type = varadd
trigger1 = movecontact
fvar(2) = ifelse(movehit,-0.2,-0.1)
persistent = 0

[state 200x,defencetime];けんきゲージ  基本消費   素手と武器のときあるかもめんどい
type = varadd
trigger1 = var(0)
trigger1 = animelem =5
trigger2 = !var(0)
trigger2 = animelem =3 
fvar(2) = -0.1
persistent = 0
;-----------------------

[state 200x,defencetime];剣モード　おんりー　　怒りゲージ増加
type = varadd
triggerall = var(1) = 6
trigger1 = movecontact
fvar(10) = ifelse(movehit,80,40)
persistent = 0
ignorehitpause = 1

