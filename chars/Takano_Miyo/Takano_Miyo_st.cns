Trigger1 = Var(11) = 0
Trigger1 = time = 0
Trigger1 = Var(50)!=0
Value    = s9,3
Channel  = 4

[State -3];■アニメ：あなたには聞こえないでしょうね。～賛歌が■■
Type     = changeanim
Trigger1 = Var(11) = 1
Trigger1 = time = 0
Trigger1 = Var(50)!=0
Value    = 2

[State -3];■音声：私がタタリを起こすの■■
Type     = PlaySnd
Trigger1 = Var(11) = 1
Trigger1 = time = 0
Trigger1 = Var(50)!=0
Value    = s9,2
Channel  = 4

[State -3];■アニメ：私がタタリを起こすの■■
Type     = changeanim
Trigger1 = Var(11) = 0
Trigger1 = time = 0
Trigger1 = Var(50)!=0
Value    = 2

[State 181, 特殊効果] 
type = AssertSpecial
trigger1 = Var(11) = 0
trigger1 = Time <= 290
trigger2 = Var(11) = 1
trigger2 = Time <= 150
flag = RoundNotOver


