;---------------------------------------------------------------------------
; PREINTRO
[Statedef 190]
type = S
ctrl = 0
velset = 0,0
poweradd = 1000

[State 190];初戦から覚醒するか判断
type = varset
triggerall = time = 0
trigger1 = palno = 7
trigger2 = palno = 8
trigger3 = palno = 9
trigger4 = palno = 10
trigger5 = palno = 11
trigger6 = palno = 12
v =50
value = 1

[State 190];初戦から覚醒するか判断
type = ChangeState
triggerall = time = 0
trigger1 = palno = 7
trigger2 = palno = 8
trigger3 = palno = 9
trigger4 = palno = 10
trigger5 = palno = 11
trigger6 = palno = 12
value = 193

[State 190, 3] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 191

[State 190, 4] ;Intro for round 2 after
type = ChangeState
;trigger1 = Time = 0
trigger1 = roundno >= 2
trigger1 = var(50) = 1
value = 193

