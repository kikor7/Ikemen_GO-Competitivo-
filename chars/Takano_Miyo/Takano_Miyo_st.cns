;---------------------------------------------------------------------------
; 覚醒前後の立ち絵判断
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && var(50)=0
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
trigger3 = Anim != 1 && Anim != 5 && var(50)!=0
value = 0+(var(50)!=0)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; 基本行動のステート
;---------------------------------------------------------------------------
; タイムオーバー時
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1 ;1にするといかなる条件でも有効で、0にするといかなる条件でも無効
value = SCA
time = 1

;---------------------------------------------------------------------------
; 勝利ポーズ分岐
; CNS レベル: 基本
[Statedef 180]
type = S

[State 180, ステート変更]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; 勝利ポーズ
; CNS レベル: 基本
[Statedef 181]
type = S
ctrl = 0
anim = 0+(var(50)!=0)
velset = 0,0

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State -1]
Type     = VarRandom
Trigger1 = Time = 0
V        = 11
Range    = 0,1



[State -3];■音声：あら、楽しませてくれんじゃなかったの■■
Type     = PlaySnd
Trigger1 = Var(11) = 0
Trigger1 = animelem = 5
Trigger1 = Var(50)=0
Value    = s9,0
Channel  = 4

[State -3];■アニメ：あら、楽しませてくれんじゃなかったの■■
Type     = changeanim
Trigger1 = Var(11) = 0
Trigger1 = time = 0
Trigger1 = Var(50)=0
Value    = 181

[State -3];■音声：ごめんねー■■
Type     = PlaySnd
Trigger1 = Var(11) = 1
Trigger1 = animelem = 5
Trigger1 = Var(50)=0
Value    = s9,1
Channel  = 4

[State -3];■アニメ：ごめんねー■■
Type     = changeanim
Trigger1 = Var(11) = 1
Trigger1 = time = 0
Trigger1 = Var(50)=0
Value    = 182

[State -3];■音声：あなたには聞こえないでしょうね。～賛歌が■■
