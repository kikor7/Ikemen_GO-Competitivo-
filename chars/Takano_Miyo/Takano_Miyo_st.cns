triggerall = statetype = C
trigger1 = var(59)=0
Trigger1 = command != "holddown"
trigger2 = var(59)!=0
trigger2 = EnemyNear,StateType = A
trigger2 = Random <= var(59)*100
statetype = S
physics = S

[State 151, 4]
type = ChangeState
trigger1 = HitOver
value = 130
ctrl = 1

