;　通常技、－2，－3,  
;v(0-5),システム予約　var(10)ママハハ攻撃命令 var(18)シラル判定
;v(13)キャンセル可フラグ v(14)弾かれ硬直time v(15)弾かれ硬直time (予備）
;var(30)シクルゥ命令 var(31) 乗ってるかどうか　v49=char var(50)氷砕タイムvar(51)introキャラC
;AI var(52),fvar(32)以降 
;fvar(0)=攻撃係数　7.8125=ss3（inS5900）
;h,p,e(200)コンル攻撃時

;---------------------------------------------------------------------------
; 立ち・弱・武器　遠距離・の動作　s200,swwf
[Statedef 200];テクサムトゥクノタク
type    = S                      
movetype= A                      
physics = S                      
velset = 0,0                     ;このステートが始まった時に移動するか（0,0で動かない）
ctrl = 0                         ;このステート中に他のコマンドを受け付けるか(1で受け付ける)
anim = 200                       ;このステートで表示するスプライトステート番号(0で変化無し)
sprpriority = 2                  ;表示した絵の重なり具合(2一番前　0通常　-1奥)
hitcountpersist = 1

