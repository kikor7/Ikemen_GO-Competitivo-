;　s1000,qu_w　天咆輪・　　　　　　　　　　
[statedef 1000]
type    = a
movetype=A
physics = A
poweradd= 0
ctrl = 0
velset = 0.2,-6
anim = 1000
sprpriority = 2

[State 200, 1]
type = HitDef
trigger1 = time = 0
attr = A, sA                      
damage = floor(15 * fvar(0)),1              
animtype = back             
guardflag = M                  
hitflag = MA                   
priority = 7,hit            
pausetime = 12, 12
guard.pausetime = 10, 8 
sparkno = s6200    
guard.sparkno = S6140
sparkxy = 0, -70               
hitsound = s205,ifelse(p2life - floor(15 * fvar(0)) <= 0, 11,random % 3 + 5)      
guardsound = s150, random % 3     
ground.type = High             
ground.slidetime = 25           
ground.hittime  = 20             
ground.velocity = -3,-6             
air.type = High                
air.velocity = -1.4,-5          
air.hittime = 20                 
getpower = 60,30
fall = 1
fall.revover = 0

[state 1000,]
type = playerpush
trigger1 = 1
value =1
time = 1

[state 1000,]
type = nothitby
trigger1 = animelemtime(4) < 0
time = 1
value = sca,na,np,nt,sa,st,sp,ha,ht,hp

[state 1000,]
type = veladd
trigger1 = vel y < 0
x = 0.1

