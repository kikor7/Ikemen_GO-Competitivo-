[statedef 1300]
type    = a
movetype= A
physics = N
poweradd= 0
ctrl = 0
velset = 0,0
anim = 1300
sprpriority = 2

[state 1300,]
type = posfreeze
trigger1 = time <= 10
time = 1
valiue = 1

[state 1300,]
type = velset
trigger1 = time = 10
x = 4
y = 15

[State 200x,];dash
type = Afterimage
trigger1 = time >= 10
trigger1 = time % 5= 0
trans = add
TimeGap = 2
FrameGap = 3
length = 20
time = 5
PalBright = 0,0,0
PalContrast = 100,100,100
PalAdd = 150,0,150

[state 1300,end next];近くにきたら斬る
type = changestate
trigger1 = p2bodydist x <= 25
trigger1 = p2bodydist y = [-30,90]
value = 1320

[state 1300,end next];技が出なかった場合、共通硬直ステートヘ
type = changestate
trigger1 = pos y >= 0 && vel y > 0
value = 1390

;--------------------------
[statedef 1320]
type    = A
movetype= A
physics = n
ctrl = 0
anim = 1320
sprpriority = 2
velset = 4,15

[state 1305, hit ]
type = HitDef
trigger1 = time = 0
attr = A, SA                     ;立ち状態で、通常の攻撃(ｓは立ち、ｎは通常、aは攻撃を表す)
damage = floor(18 * fvar(0)) ,1    ;ダメージ量（左が当たった時、右はガードした時）
animtype = hard                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = M                   ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MA                   ;当てる事のできる条件
priority = 4             ;攻撃の優先権（0弱い　4通常　7強い
pausetime = 15, 15                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
sparkno = S6200  
guard.sparkno = S6140
sparkxy = -5, -55               ;ヒットエフェクトを表示する場所（相手の座標で）
hitsound = s205,ifelse(p2life - floor(18 * fvar(0)) <= 0, 11,random % 3 + 4)                  
guardsound = s150, random % 3                ;ガードした時の音（同上）
ground.type = high               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 20             ;相手が後にすべる時間
ground.hittime  = 15             ;コンボが繋がる時間（高くしすぎない事）
ground.velocity = -4             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.type = low                  ;空中で相手がくらった場所（上と同じ）
air.velocity = -3,-2           ;空中で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.hittime = 20                 ;空中でコンボが繋がる時間
getpower = 60,30

[state 000,bloodw];
type = Explod
trigger1 = movehit
anim = 6710
id = 6710
postype = p2
pos = -5,-60
sprpriority = 3
supermove = 1
bindtime = 20
removetime = -2
persistent = 0
ownpal = 1

[state 1300,end next];共通硬直ステートヘ
type = changestate
trigger1 = pos y >= 0 && vel y > 0
value = 1390

