[statedef 1410]
type    = a
movetype= a
physics = a
poweradd= 0
velset = 4,-5
ctrl = 0
anim = 1405
sprpriority = 2

[state 1410, hit ]
type = HitDef
trigger1 = time = 0
attr = c, SA                     ;立ち状態で、通常の攻撃(ｓは立ち、ｎは通常、aは攻撃を表す)
damage = floor(18 * fvar(0)) ,1    ;ダメージ量（左が当たった時、右はガードした時）
animtype = back                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = M                   ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MA                   ;当てる事のできる条件
priority = 4             ;攻撃の優先権（0弱い　4通常　7強い
pausetime = 8, 10                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
sparkno = s6300                      ;ヒットエフェクトのスプライトステート（無ければ0）
guard.sparkno = S6140
sparkxy = -5, -55               ;ヒットエフェクトを表示する場所（相手の座標で）
hitsound = s205,ifelse(p2life - floor(18 * fvar(0)) <= 0,22,30+ random % 2)       
guardsound = s205, 30+ random % 2
ground.type = high               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 25             ;相手が後にすべる時間
ground.hittime  = 20             ;コンボが繋がる時間（高くしすぎない事）
ground.velocity = -3,-3             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.type = low                  ;空中で相手がくらった場所（上と同じ）
air.velocity = -3,-2           ;空中で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.hittime = 20                 ;空中でコンボが繋がる時間
getpower = 60,30
fall = 1

[state 1405,end next];共通硬直ステートヘ
type = changestate
trigger1 = pos y >= 0 && vel y > 0
value = 1490

