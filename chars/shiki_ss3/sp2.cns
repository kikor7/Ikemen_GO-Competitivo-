;--------test 洗脳探偵 start state
[statedef 3300]
type    = S
movetype=A
physics = N
poweradd= 0
ctrl = 0
velset = 0,0
anim =2000

[state 3300,];洗脳探偵捜査時間　＆　このvarが偽でなければ再捜査不能（commadファイルで設定）
type = parentvarset
trigger1 = time = 0
var(33) = 600

[State 3300, start1];一番始め
type = HitDef
trigger1 = time =0
attr = S, NA                     ;立ち状態で、通常の攻撃(ｓは立ち、ｎは通常、aは攻撃を表す)
damage = 0                   ;ダメージ量（左が当たった時、右はガードした時）
animtype = hard                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = -1                  ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MAFD                    ;当てる事のできる条件
priority = 7, hit                ;攻撃の優先権（0弱い　4通常　7強い
pausetime = 0, 0                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
sparkno = s6300 + random % 10    ;ヒットエフェクトのスプライトステート（無ければ0）
guard.sparkno = S6150
sparkxy = -10, -86               ;ヒットエフェクトを表示する場所（相手の座標で）
hitsound   = s205, 2
guardsound = s150, 0
ground.type = High               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 5             ;相手が後にすべる時間
ground.hittime  = 12             ;コンボが繋がる時間（高くしすぎない事）
p1stateno = 3305
p2stateno =3350

[state -2, displayb]
type = displaytoclipboard
trigger1 = 1
text = "detective valid time Rvar(33)=%d\n"
params =root,var(33)

[state 3250,]
type = destroyself
trigger1 = animtime = 0
trigger2 = root,movetype = h
trigger3 = playerID(var(4)),stateno = [5000,5300]

;-------------------loop 3005->3010->3015->3005---------------
[statedef 3305]
movetype= A
ctrl = 0

[state 350,]
type = nothitby
trigger1 = 1
time = 1
value = sca

[state 3310,]
type = parentvaradd
trigger1 = 1
var(33) = -1

[state 3305,]
type = posset
trigger1 = 1
x = playerID(var(4)),pos x
y = playerID(var(4)),pos y

[state 3305,var];loop敵攻撃状態になったら待機ステートへ
type =changestate 
trigger1 =playerID(var(4)),movetype = A
trigger2 =playerID(var(4)),stateno = [5000,5300]
;trigger3 =playerID(var(4)),stateno = [0,52]
;trigger3 =playerID(var(4)),ctrl
value = 3310
 
[state 3300,]
type = targetstate
trigger1 = root,var(33) <= 0
trigger2 = root,movetype = h
trigger2 = root,stateno != [120,155]
value = 3396

[state 3300,]
type = destroyself
trigger1 = root,var(33) = 0
trigger2 = root,movetype = h
trigger2 = root,stateno != [120,155]
trigger3 = playerID(var(4)),stateno = [5000,5300]

