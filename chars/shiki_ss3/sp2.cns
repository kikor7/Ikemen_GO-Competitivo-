value = 0
ctrl = 1
triggerall = command != "holdup"
trigger1 = command = "holda"
trigger2 = command = "holdb"
trigger3 = command = "holdc"
trigger4 = command = "holdx"
trigger5 = command = "holdy"
trigger6 = command = "holdz"
trigger7 = command = "holds"

[state 3350,]
