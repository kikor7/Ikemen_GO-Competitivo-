;---------------------------吹き飛び　ＡＩ受身対策
[statedef 2160]
type    = A
movetype= h
physics = n
poweradd= 0
ctrl = 0
velset = -5,-5
sprpriority = -2

[state 2160,]
type = gravity
trigger1 = 1

[state 2160,]
type = changeanim
trigger1 = time = 0
value = ifelse(authorname = "R-R",5050 + var(0),5050)

[state 2160,]
type = changeanim
trigger1 = vel y > 2
trigger1 = selfanimexist(5060)
value = ifelse(authorname = "R-R",5060 + var(0),5060)
persistent = 0

[state 2160,]
type = selfstate
trigger1 = pos y >= -10 && vel y > 0
value =5100

