;-------刹那　ワープ技
[statedef 2000]
type    = S
movetype= I
physics = S
poweradd= 0
ctrl = 0
velset = 0,0
anim = 1500
sprpriority = 2

[state 2000x,voice];
type = playsnd
trigger1 = time = 0
value = s2000,0
channel = 0
persistent  =0

[state 2000x,voice];
type = playsnd
trigger1 = time = 0
value = s2000,10
channel = 1
persistent  =0

[state 2000,]
type = nothitby
trigger1 = 1
value = sca,na,np,nt,sa,st,sp,ht,ha,hp
time = 1

[state -3, efe];オーラ
type = Explod
trigger1 = time = 5
anim =1530
id = 1530
postype = p1
pos = 0,-50
sprpriority = 4
bindtime = -1
removetime = -2
ownpal=1

[State 2000,pal]
type = Palfx
trigger1 = animelem = 5
add = 100,100,100
sinadd = 50, 50, 50
time = 10

[State 2000,pal]
type = Palfx
trigger1 = animelem = 7
add = 255,255,255
sinadd = 0, 0, 0
time = 20

[State -2, 4]
type = AssertSpecial
trigger1 = animelemtime(8) >= 10
flag = invisible
flg2 = noshadow

[state 2000,]
type = changestate
trigger1 = animtime = 0
value = 2010
ctrl = 0 

