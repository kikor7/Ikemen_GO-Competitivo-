attr = S, SA                     ;立ち状態で、通常の攻撃(ｓは立ち、ｎは通常、aは攻撃を表す)
damage = 0                   ;ダメージ量（左が当たった時、右はガードした時）
animtype = light                 ;当てた時の相手のポーズ（light/midium/hard/back）から選択
guardflag = -1                  ;ガードできる状態（ｍaは全ての状態でガード可能）
hitflag = MAF                    ;当てる事のできる条件
priority = 7, hit                ;攻撃の優先権（0弱い　4通常　7強い
pausetime = 0, 0                 ;攻撃が当たった時の硬直時間（左が自分、右が相手）
sparkno = -1;0                      ;ヒットエフェクトのスプライトステート（無ければ0）
sparkxy = -10, -86               ;ヒットエフェクトを表示する場所（相手の座標で）
hitsound   = 0
guardsound = 0
ground.type = High               ;相手のくらった場所（High：頭、体, Low：足, Trip：足払い）
ground.slidetime = 5             ;相手が後にすべる時間
ground.hittime  = 12             ;コンボが繋がる時間（高くしすぎない事）
ground.velocity = -4             ;地上で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
airguard.velocity = -1.9,-.8     ;空中で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.type = High                  ;空中で相手がくらった場所（上と同じ）
air.velocity = -1.4,-3           ;空中で攻撃をくらった場合の相手の移動状況（ｘとｙで小数点可）
air.hittime = 12                 ;空中でコンボが繋がる時間
p2stateno = 3350
p1stateno = 3305

[state 3315,]
type = parentvaradd
trigger1 = 1
var(33) = -1

[state 3315,]
type = targetstate
trigger1 = root,var(33) <= 0
trigger2 = root,movetype = h
trigger2 = stateno != [120,155]
value = 3396

[state 3315,]
type = parentvarset
trigger1 = root,var(33) <= 0
trigger2 = root,movetype = h
trigger2 = stateno != [120,155]
var(33) = 0

[state 3315,]
type = destroyself
trigger1 = root,var(33) <= 0
trigger2 = root,movetype = h
trigger2 = stateno != [120,155]
trigger3 = playerID(var(4)),stateno = [5000,5300]

;----------------------敵側地上
[statedef 3350]
type = A
movetype= H
physics = N
ctrl = 0;1
velset = 0,0

[state 3350,]
type = turn
trigger1 = enemy,facing = facing
;trigger1 = p2bodydist x < 5

[state 3500,]
type = posset
trigger1 = 1
y = 0

[state 3500,guard]
type = changestate
triggerall = p2bodydist x <= const(size.attack.dist)
trigger1 = command = "holdfwd" || command = "holdDF"
trigger1 = p2movetype = A
value =120

[state 3350,];立ち絵変更
type = changeanim
triggerall = !authorname = "R-R"
triggerall = anim != 0
trigger1 = command != "holddown" && command != "holdup"
trigger1 = command != "holdfwd" && command != "holdback"
value = 0

[state 3350,];立ち絵変更
type = changeanim
triggerall = authorname = "R-R"
triggerall = command != "holddown" && command != "holdup"
triggerall = command != "holdfwd" && command != "holdback"
trigger1 = anim != var(0) + 0
value = 0 + var(0)

[state 3350,];歩き逆転 速度ｘ
type = velset
triggerall = command != "holddown" && command != "holdup"
triggerall = command = "holdfwd" || command = "holdback"
trigger1 = 1
x = ifelse(command = "holdback", const(velocity.walk.fwd.x),const(velocity.walk.back.x) )

[state 3350,];ｘを0に戻す
type = velset
triggerall = 1
trigger1 = command != "holddown" && command != "holdup"
trigger1 = command != "holdfwd" && command != "holdback"
trigger2 = !authorname = "R-R"
trigger2 = anim = 11
trigger3 = authorname = "R-R"
trigger3 = anim = 11 + var(0)
x = 0

[state 3350,];ジャンプ逆転 ステートチェンジ
type = changestate
value = 3355
triggerall = command = "holddown" && command != "holdup"
trigger1 = 1

[state 3350,];前歩き絵変更
type = changeanim
triggerall = !authorname = "R-R"
triggerall = vel x > 0
trigger1 = anim != 20
value = 20 

[state 3350,];前歩き絵変更
type = changeanim
triggerall = authorname ="R-R"
triggerall = vel x > 0
trigger1 = anim != var(0) + 20
value = 20 + var(0)

[state 3350,];後ろ歩き絵変更
type = changeanim
triggerall = !authorname = "R-R"
triggerall = vel x < 0
trigger1 = anim != 21
value = 21 

[state 3350,];後ろ歩き絵変更
type = changeanim
triggerall = authorname = "R-R"
triggerall = vel x < 0
trigger1 = anim != var(0) + 21
value = 21 + var(0)

[state 3350,];しゃがみ絵変更
type = changeanim
trigger1 = command = "holdup"
;trigger1 = command = "holdfwd" ||  command = "holdback"
trigger1 = 1
value = 11 + ifelse(authorname = "R-R",var(0),0)

[state 3350,]
