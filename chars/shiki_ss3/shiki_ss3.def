[Info]
name = "SHIKI SS3"        ;キャラの名前
displayname = "shiki" ;表示されるキャラの名前
versiondate =11,26,2003    ;キャラの更新情報
mugenversion = 04,14,2001   ;キャラが動くmugenのバージョン
author = "R-R"         ;キャラの製作者名
pal.defaults = 1,2,3,4,5,6     ;敵としてでるキャラのパレット

; Files for the player
[Files]
movelist = movelist.dat
cmd     = com.cmd   ;コマンド
cns     = base.cns   ;基本データ
st	= base.cns	;イントロ
st1     = normal.cns   ;通常技,-2,-3
st2     = sp1.cns	;必殺技1
st3     = sp2.cns	;必殺技2
st4     = sp3.cns	;超必殺技	
st5     = defence.cns	;防御関連、エフェクト
st6     = minus.cns	;AI?
st7     = partG.cns	;シクルゥ
stcommon = common.cns	;
sprite  = shiki.sff   ;キャラの絵
anim    = shikiA.air   ;キャラの動き
sound   = sound.snd   ;キャラの音声 
pal1    = 1p.act	;
pal2   = 2p.act	;
pal3   = 3p.act	;

; Arcade mode
[Arcade]
intro.storyboard = D:\MUGEN\extrastuff\add-ons\Intros&Endings\svc_intro/scv_intro.def
ending.storyboard = end/svcshiki.def