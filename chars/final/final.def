; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name ="Final"
displayname ="FINAL"
versiondate =04,14,2002
mugenversion =04,14,2002
author ="Andres Borghi"
pal.defaults =1

; Files for the player
[Files]
movelist = movelist.dat
cmd     =final.cmd
cns     =final.cns
st      =final.cns
stcommon =common1.cns
sprite  =final.sff
anim    =final.air
sound   =final.snd
pal1=final1.act
pal2=final2.act
pal3=final3.act
pal4=final4.act
pal5=final5.act
pal6=final6.act
st1=final-common.cns
st2=final-intros-eng.cns
;^ to change intros to spanish, replace with "st2=final-intros-esp.cns"

; Arcade mode
[Arcade]
intro.storyboard =intro.def
ending.storyboard =ending.def
