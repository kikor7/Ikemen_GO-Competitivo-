; HITA_FALL (knocked up, falling)
[Statedef 17650]
type    = A
movetype= H
physics = N

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)



[State 176176, 1] ;Change anim when done with transition
