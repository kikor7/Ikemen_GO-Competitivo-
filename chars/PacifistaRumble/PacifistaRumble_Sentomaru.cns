;---------------------------------------------------------------------------
; Jump Start
[Statedef 17040]
type    = S
physics = S
anim = 17040
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)-(ifelse(var(3) = 1,0.7,0)), const(velocity.jump.back.x)+(ifelse(var(3) = 1,0.7,0))))
y = -6

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S1,5
volume = 50

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 17050
ctrl = 0

