value = 17044

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(17044)
value = 17041

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 17050
ctrl = 0

