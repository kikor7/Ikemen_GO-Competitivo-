;---------------------------------------------------------------------------
; Stand
[Statedef 17000]
type = S
physics = S
sprpriority = 0

[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr=SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=17600
ignorehitpause=1


[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 17000 && Anim != 17005)
trigger2 = (Anim = 17005) && AnimTime = 0
value = 17000


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30



;------------------------------

[State 0, Winpose]
type = ChangeState
triggerall = parent, numhelper(182) = 1
trigger1 = 1
value = 17181
ctrl = 0
[State 0, Lose by Time]
type = ChangeState
triggerall = parent, numhelper(172) = 1
trigger1 = 1
value = 17900
ctrl = 0

;-----------------------------------------------------------

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = parent,var(31) <= 0
value = 17700
;------------------------------------------------------------

[State 0, Golpes]
type = ChangeState
triggerall = power > 2000
trigger1 = p2bodydist x < 150
trigger1 = time%50 = 0 && random = [200,700]
value = 17250
ctrl = 1



[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x > 100
trigger1 = time%50 = 0 && random = [200,700]
value = 17100
ctrl = 1

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x > 100
trigger1 = time%50 = 0 && random = [300,700]
value = ifelse(random> 500,17350,17040)
ctrl = 1

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x < 100
trigger1 = time%50 = 0 && random = [200,700]
value = ifelse(random> 600,17300,17200)
ctrl = 1


[State 0, Walk] ; caminar
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 10
trigger1 = time%50 = 0 &&  random = [100,700]
value = ifelse(random >= 650, 17021,17020)
ctrl = 1


[State 0, Salto]
type = ChangeState
;trigger1 = p2movetype = A
trigger1 = time%50 = 0 && random = [100,700]
value = 17040
ctrl = 0



