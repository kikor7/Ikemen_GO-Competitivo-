triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 17810 ;HITFALL_AIRRECOVER

[State 17650, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [17651,17659]) || (anim = [17661,17669]), 0, 10)
value = 17700

