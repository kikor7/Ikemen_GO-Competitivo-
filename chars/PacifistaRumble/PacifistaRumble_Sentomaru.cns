; HITG_SHAKE
[Statedef 17600]
type    = S
movetype= H
physics = N
velset = 0,0

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)



[State 17600, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),17600,17610) + GetHitVar(animtype)

[State 17600, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = var(30) <= 0
value = 17630

[State 17600, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(17647 + GetHitVar(animtype)))
value = 17647 + GetHitVar(animtype) ;17651 - 4 + type

[State 17600, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 17600, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 17600, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 17601 ;HITG_SLIDE

[State 17600, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger2 = var(30) <= 0
value = 17630

[State 17600, FFB Light]
type = ForceFeedback
trigger1 = anim = 17600
trigger2 = anim = 17610
persistent = 0
time = 6
waveform = square

[State 17600, FFB Medium]
type = ForceFeedback
trigger1 = anim = 17601
trigger2 = anim = 17611
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 17600, FFB Hard]
type = ForceFeedback
trigger1 = anim = 17612
trigger2 = anim = 17602
trigger3 = anim = 17630
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

