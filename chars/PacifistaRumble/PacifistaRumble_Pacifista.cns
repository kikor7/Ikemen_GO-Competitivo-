;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 10650]
type    = A
movetype= H
physics = N

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 30
value = -gethitvar(damage)


[State 106106, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 10635
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 10635
trigger2 = (Anim != [10651, 10659]) && (Anim != [10661, 10669])
trigger2 = Anim != 10690 ;Not if hit off ground anim
value = 10650

[State 10650, 2] ;Coming down anim
