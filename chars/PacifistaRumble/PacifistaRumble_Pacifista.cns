;---------------------------------------------------------------------------
; Stand
[Statedef 10000]
type = S
physics = S
sprpriority = 0


[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr= SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=10600
ignorehitpause=1

[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 10000 && Anim != 10005)
trigger2 = (Anim = 10005) && AnimTime = 0
value = 10000


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30



;------------------------------

[State 0, Winpose]
type = ChangeState
triggerall = parent, numhelper(182) = 1
trigger1 = 1
value = 10181
ctrl = 0

[State 0, Lose by Time]
type = ChangeState
triggerall = parent, numhelper(172) = 1
trigger1 = 1
value = 10900
ctrl = 0


;-----------------------------------------------------------

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = parent,var(31) <= 0
value = 10700
;------------------------------------------------------------

[State 0, Walk] ; caminar
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 10 &&  p2bodydist x < 125
trigger1 = time%50 = 0 &&  random = [200,700]
value = ifelse(random >= 650, 10021,10020)
ctrl = 1

[State 0, Run] ; correr
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 100
trigger1 = time%50 = 0 &&  random = [200,500]
value = 10100
ctrl = 1

[State 0, Salto]
type = ChangeState
;trigger1 = p2movetype = A
trigger1 = time%50 = 0 && random = [200,500]
value = 10040
ctrl = 0


[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x > 100
trigger1 = time%50 = 0 && random = [300,500]
value = ifelse(random> 275,10400,10300)
ctrl = 1

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x < 100
trigger1 = time%50 = 0 && random = [200,500]
value = ifelse(random < 300,10200,ifelse(random > 300,10410,10201))
ctrl = 1


;---------------------------------------------------------------------------
; Stand to Crouch
