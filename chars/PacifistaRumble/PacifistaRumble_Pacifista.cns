triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 10810 ;HITFALL_AIRRECOVER

[State 10650, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [10651,10659]) || (anim = [10661,10669]), 0, 10)
value = 10700

