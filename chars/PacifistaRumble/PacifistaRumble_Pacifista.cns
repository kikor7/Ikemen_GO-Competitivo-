trigger1 = !time
v = 30
value = -gethitvar(damage)

[State 10635, 1]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(10635)
trigger1 = Anim != [10651,10659] ;Not if in hit up anim
trigger1 = Anim != 10690 ;Not if hit off ground anim
value = 10635

[State 10635, 2]
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 10635, 3]
type = ChangeState
triggerall = !HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Animation over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 10635 ;.
value = 10640 ;HITA_RECOV

[State 10635, 4]
type = ChangeState
triggerall = HitFall
trigger1 = HitOver  ;Hit is over
trigger2 = AnimTime = 0 ;Anim is over
trigger3 = Vel Y > 0    ;Hit ground
trigger3 = Pos Y >= 10  ;.
trigger4 = Time = 0     ;No transition anim
trigger4 = Anim != 10635 ;.
trigger5 = var(30) <= 0
value = 10650 ;HITA_FALL

