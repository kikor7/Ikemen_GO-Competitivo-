;---------------------------------------------------------------------------
; Jump Start
[Statedef 10040]
type    = S
physics = S
anim = 10040
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(random < 300,1.25,ifelse(random > 300,-1.25,0))
y = const(velocity.jump.y)+(ifelse(var(3) = 1,0.7,0))

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S1,5
volume = 50

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 10050
ctrl = 0

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 10045]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(10044)
value = 10044

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(10044)
value = 10041

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = random = [200,300]
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 10050
ctrl = 0

;---------------------------------------------------------------------------
; Jump Up
[Statedef 10050]
type    = A
physics = N

[State 0, VelAdd]
type = VelAdd
trigger1 = 1
y = 0.3

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 10041, ifelse((vel x)>0, 10042, 10043))



[State 0, Golpes]
type = ChangeState
triggerall = prevstateno != 10300
triggerall = prevstateno != 10310
triggerall = prevstateno != 10420
trigger1 = p2bodydist x < 250
trigger1 = time%10 = 0 && random = [200,700]
value = ifelse(random> 500,10310,10420)
ctrl = 1


[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 1005, end]
type = changestate
triggerall = time >= 5
trigger1 = pos y >-1
value = 10012

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 10051]
type    = A
physics = N

[State 0, VelAdd]
type = VelAdd
trigger1 = 1
y = 0.3

[State 51, 1]
type = Null
trigger1 = 1

[State 1005, end]
type = changestate
triggerall = time >= 5
trigger1 = pos y >-1
value = 10012
