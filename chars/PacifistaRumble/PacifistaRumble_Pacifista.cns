triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 10800 ;HITFALL_RECOVER

[State 10650, 5]; Recover in mid air
