;---------------------------------------------------------------------------
;Reflector Effect
[Statedef 951]
type   = A
ctrl   = 0
velset = 0,0
sprpriority = 4
anim   = 951

[State 1]
type = AssertSpecial
trigger1 = 1
flag = NoShadow

[State 1]
type = angledraw
trigger1 = 1
value = 0
scale = 0.45+0.055*(time), 0.45+0.055*(time)

[State 1]
type = trans
trigger1 = time = [0,9]
trans = addalpha
alpha = 256, 256

[State 1]
type = trans
trigger1 = time = [9,14]
trans = addalpha
alpha = 256-(time*16), 256

[State 1]
type=destroyself
trigger1 = time >= 14

