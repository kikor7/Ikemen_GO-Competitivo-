;===================================
;　基本設定・基本動作・通常技 の設定
;===================================
[Data]
life              = 1000  ;スタート時の体力総計
attack            = 100   ;攻撃力パーセンテージ （多いほど強くなります Def:100%）
defence           = 100   ;防御力パーセンテージ （多いほど強くなります Def:100%）
power             = 3000  ;ゲージの最大値
fall.defence_up   = 50    ;ダウン時に攻撃された時に一時的に上がる防御力のパーセンテージ
liedown.time      = 60    ;ダウンしてから起き上がるまでの時間
airjuggle         = 30    ;ジャグルポイント数
sparkno           = 2     ;ディフォルトのスパーク番号
guard.sparkno     = 40    ;ガード時のディフォルトスパーク番
KO.echo           = 0     ;1にするとKOされた時に声にエコーがかかります
volume            = 0     ;ボリュームオフセット (negative for softer)
intpersistindex   = 59,59 ;Varを次のラウンドに持ってく

[Size]
xscale            = 1     ;水平方向の縮尺
yscale            = 1     ;垂直方向の縮尺
ground.back       = 13    ;キャラクターの幅（後方、地上）
ground.front      = 17    ;キャラクターの幅（前方、地上）
air.back          = 13    ;キャラクターの幅（後方、空中）
air.front         = 17    ;キャラクターの幅（前方、空中）
z.width           = 3     ;Player width (into and out)（現在使用されていないと思われます）
height            = 60	  ;キャラクターの高さ
attack.width      = 4,4   ;Default attack width: back, front（現在使用されていないと思われます）
attack.dist       = 60    ;攻撃時に相手がガード体勢に入る最低距離（最大320）
proj.attack.dist  = 100   ;相手がガード体勢に入る発射物との最低距離（最大320）
proj.doscale      = 0     ;xscale, yscaleの設定が発射物にも適用するかどうか（1で有効）
head.pos          = 0,-85 ;頭の大体の座標（BindToTarget使用時に必要です。）
mid.pos           =-4,-60 ;体中心の大体の座標（BindToTarget使用時に必要です。）
shadowoffset      = 0     ;影の垂直方向オフセット

[Movement]
airjump.num       = 0     ;空中ジャンプの回数 （オプション）
airjump.height    = 0     ;空中ジャンプに必要な最低限の高さ （オプション）
yaccel            = .99   ;垂直方向にかかる加速度（重力）
stand.friction    = .99   ;立ち状態での摩擦係数
crouch.friction   = .99   ;しゃがみ状態での摩擦係数

[Velocity]
walk.fwd          = 0.0   ;前に歩く時の速度
walk.back         =-0.0   ;後ろに歩く時の速度
run.fwd           = 0,0   ;前に走る時の速度 (x, y) ホップさせる時はyを0以下にします
run.back          =-0.0   ;後ろに走る時の速度 (x, y) 走らせる時はyを0にします
jump.neu          = 0,-0  ;ジャンプ時の垂直移動速度 (x, y)
jump.back         = 0     ;後ろにジャンプした時の水平移動速度
jump.fwd          = 0     ;前にジャンプした時の水平移動速度
runjump.back      =-0,-0  ;後ろに走りながらのジャンプ時の速度指定 (オプション)
runjump.fwd       = 0,-0  ;前に走りながらのジャンプ時の速度指定 (オプション)
airjump.neu       = 0,-0  ;空中ジャンプ時の垂直移動速度  (オプション)
airjump.back      =-0,-0  ;空中で後ろにジャンプした時の水平移動速度
airjump.fwd       = 0,-0  ;空中で前にジャンプした時の水平移動速度



