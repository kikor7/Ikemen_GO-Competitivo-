;===============================================================
;Dragonfire Projectile

;Var(0) = no. of movehits
;Var(1) = no. of moveguardeds
;Var(2) = no. of times hit
;Var(3) = pausetime
;Var(4) = movecontact adjusted for pausetime
;var(5) = random element, 0 = fire, 1 = ice, 2 = lightning,
;	  3 = poison, 4 = petrification
;var(6), var(7), var(8) = rgb mul of palfx
;var(9), var(10), var(11) = rgb add of palfx
;var(12), var(13), var(14) = rgb sinadd of palfx
;var(59) = light/med/heavy
[Statedef 1005]
type = S
physics = N
movetype = A
sprpriority = 3
juggle = 15
movehitpersist = 1

[State 1005, VarSet]
type = VarSet
triggerall = !prevstateno
trigger1 = time = 0
var(59) = root, var(16)

[State 1005, VarSet]
type = VarSet
triggerall = !prevstateno
trigger1 = time = 0
var(5) = random%5

[State 1005, VarSet]
type = null
triggerall = root, var(59) < 1
triggerall = !prevstateno
triggerall = time = 0
trigger1 = root, command = "holdfwd"
trigger1 = root, command = "holddown"
trigger1 = var(5) := 2
trigger2 = root, command = "holdback"
trigger2 = root, command = "holddown"
trigger2 = var(5) := 3
trigger3 = root, command = "holdfwd"
trigger3 = var(5) := 0 || 1
trigger4 = root, command = "holddown"
trigger4 = var(5) := 4
trigger5 = root, command = "holdback"
trigger5 = var(5) := 1

[State 1005, SprPriority]
type = SprPriority
trigger1 = 1
Value = 3
ignorehitpause = 1

[State 1005, End]
type = ChangeState
trigger1 = frontedgedist < -120
trigger2 = var(0) + var(1) + var(2)> 2
Value = 1007

[State 1005, ChangeAnim]
type = ChangeAnim
trigger1 = anim != 1005
value = 1005

[State 1005, NotHitBy]
type = NotHitBy
trigger1 = 1
value = , AA, AT

[State 1005, HitOverride]
type = HitOverride
trigger1 = 1
stateno = 1006
attr = SCA, AA, AP, AT
time = -1

[State 1005, VarSet]
type = VarSet
trigger1 = root, projcontacttime(1006 + var(1)*(var(59) = 2 || root, var(17) = 0)) = 1
var(4) = 9 + 3*var(59)

[State 1005, RGB Fire Default]
type = null
triggerall = var(5) = 0
triggerall = time = 0
triggerall = !prevstateno
triggerall = root, var(17) = 0
trigger1 = var(6) := 256
trigger1 = var(7) := 64
trigger1 = var(8) := 0 || 1
trigger1 = var(9) := 0 || 1
trigger1 = var(10) := 0 || 1
trigger1 = var(11) := 0 || 1
trigger1 = var(12) := -64
trigger1 = var(13) := -64
trigger1 = var(14) := 0 || 1

[State 1005, RGB Fire Custom]
type = null
triggerall = var(5) = 0
triggerall = time = 0
triggerall = !prevstateno
triggerall = root, var(17)
trigger1 = root, palno = 1
trigger1 = var(6) := 128
trigger1 = var(7) := 256
trigger1 = var(8) := 256
trigger1 = var(9) := 64
trigger1 = var(10) := 96
trigger1 = var(11) := 32
trigger1 = var(12) := -64
trigger1 = var(13) := -64
trigger1 = var(14) := -64
trigger2 = root, palno = 2
trigger2 = var(6) := 256
trigger2 = var(7) := 256
trigger2 = var(8) := 64
trigger2 = var(9) := 96
trigger2 = var(10) := 96
trigger2 = var(11) := 32
trigger2 = var(12) := -64
trigger2 = var(13) := -64
trigger2 = var(14) := -64
trigger3 = root, palno = 3
trigger3 = var(6) := 256
trigger3 = var(7) := 256
trigger3 = var(8) := 256
trigger3 = var(9) := 0 || 1
trigger3 = var(10) := 0 || 1
trigger3 = var(11) := 0 || 1
trigger3 = var(12) := -96
trigger3 = var(13) := -96
trigger3 = var(14) := -96
trigger4 = root, palno = 4
trigger4 = var(6) := 256 
trigger4 = var(7) := 0 || 1
trigger4 = var(8) := 0 || 1
trigger4 = var(9) := 64
trigger4 = var(10) := 0 || 1
trigger4 = var(11) := 0 || 1
trigger4 = var(12) := -64 || 1
trigger4 = var(13) := -64|| 1
trigger4 = var(14) := -64 || 1
trigger5 = root, palno = 5
trigger5 = var(6) := 256
trigger5 = var(7) := 256
trigger5 = var(8) := 256
trigger5 = var(9) := 96
trigger5 = var(10) := 96
trigger5 = var(11) := 96
trigger5 = var(12) := 32
trigger5 = var(13) := 32
trigger5 = var(14) := 32
trigger6 = root, palno = 6
trigger6 = var(6) := 128
trigger6 = var(7) := 128
trigger6 = var(8) := 256
trigger6 = var(9) :=  64
trigger6 = var(10) := 64
trigger6 = var(11) := 96
trigger6 = var(12) := -64
trigger6 = var(13) := -64
trigger6 = var(14) := -64
trigger7 = root, palno = 7
trigger7 = var(6) := 256
trigger7 = var(7) := 200
trigger7 = var(8) := 64
trigger7 = var(9) :=  96
trigger7 = var(10) := 64
trigger7 = var(11) := 64
trigger7 = var(12) := -96
trigger7 = var(13) := -96
trigger7 = var(14) := -96
trigger8 = root, palno = 8
trigger8 = var(6) := 64
trigger8 = var(7) := 0 || 1
trigger8 = var(8) := 128
trigger8 = var(9) :=  32
trigger8 = var(10) := 0 || 1
trigger8 = var(11) := 32
trigger8 = var(12) := -64
trigger8 = var(13) := 0
trigger8 = var(14) := -128

[State 1005, RGB Shock]
type = null
triggerall = var(5) = 2
triggerall = time = 0
triggerall = !prevstateno
trigger1 = var(6) := 256
trigger1 = var(7) := 256
trigger1 = var(8) := 256
trigger1 = var(9) := -64 || 1
trigger1 = var(10) := -96 || 1
trigger1 = var(11) := -160 || 1
trigger1 = var(12) := 64 || 1
trigger1 = var(13) := 96
trigger1 = var(14) := 128

[State 1005, RGB Poison]
type = null
triggerall = var(5) = 3
triggerall = time = 0
triggerall = !prevstateno
trigger1 = var(6) := 128
trigger1 = var(7) := 64
trigger1 = var(8) := 160
trigger1 = var(9) := 160 
trigger1 = var(10) := 0 || 1
trigger1 = var(11) := 128
trigger1 = var(12) := 64 || 1
trigger1 = var(13) := 64
trigger1 = var(14) := 64

[State 1005, VelSet]
type = VelSet
trigger1 = time = 0
trigger1 = prevstateno != 1006
x = 6.5

[State 1005, VelSet]
type = VelSet
trigger1 = var(3) > 0
trigger2 = var(4) > 3
x = 0

[State 1005, VelSet]
type = VelSet
trigger1 = 1
x = (vel x - 6.5)*0.75 + 6.5

[State 1005, PosFreeze]
type = PosFreeze
trigger1 = var(3) > 0
trigger2 = var(4) > 4

[State 1005, Projectile No Juggle on 1st Hit]
type = Projectile
triggerall = root, projcontacttime(1006 + var(1)*(var(59) = 2 || root, var(17) = 0)) != [0, 1]
triggerall = var(5) != 1
triggerall = var(5) != 4
trigger1 = !root, var(22)
trigger1 = !var(0)
trigger1 = !var(4)
projanim = 1006
projid = 1006 + var(1)*(var(59) = 2 || root, var(17) = 0)
projremovetime = 1
offset = vel x, vel y
id = 1006 + var(1)*(var(59) = 2 || root, var(17) = 0)
attr = S, SP
animtype  = back
damage    = 45 + 20*var(59), 8 + 4*var(59)
getpower = 15,7
hitflag = MA
guardflag = MA
pausetime = 0,6 + 3*var(59)
sparkno = 3
sparkxy = 0,0
hitsound   = s5,2
guardsound = s6,0
ground.type = High
ground.slidetime = 15
ground.hittime  = 16
ground.velocity = -5, -5
ground.cornerpush.veloff = 0;-6.5*(var(1) < 2)
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
air.type = Low
air.cornerpush.veloff = 0;-6.5*(var(1) < 2)
palfx.time = 50
palfx.color = 128*(var(5) = 3)
palfx.invertall = (var(5) = 2)
palfx.mul = var(6), var(7), var(8)
palfx.add = var(9), var(10), var(11)
palfx.sinadd = var(12), var(13), var(14), ifelse(var(5) = 2, 10, 20)
fall = 1
fall.recover = 0

