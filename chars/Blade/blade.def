; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Blade"        ;Name of character
displayname = "Blade" ;Name in English version of Warzard
;displayname = "Jihad" ;Name in Japanese version of Warzard
versiondate = 14,04,2010    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Doggiedoo"         ;Character author name
pal.defaults = 1      ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd     = blade.cmd   ;Command set
cns     = blade.cns   ;Constants
st      = blade.cns   ;States
st2      = helpers.cns   ;States
st3	= hyper1.cns
st4	= hyper2.cns
st5	= config.txt  ;Config settings
stcommon = common1.cns ;Common states
sprite  = blade.sff   ;Sprite
anim    = blade.air   ;Animation
sound   = blade.snd   ;Sound
pal1    = blade.act
pal2    = blade2.act
pal3    = blade3.act
pal4    = blade4.act
pal5    = blade5.act
pal6    = blade6.act
pal7    = blade7.act
pal8    = blade8.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
