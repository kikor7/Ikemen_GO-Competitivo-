; Intro Stand
[Statedef 194]
type = S
physics = S
sprpriority = 0

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour Velset]
type = VelSet
trigger1 = prevstateno = 9000
x = fvar(0)
y = fvar(1)

[State 194, Helper]
type = Helper
trigger1 = !numhelper(10003)
name = "Blade's Lance"
id = 10003
stateno = 10003
supermovetime = 9999

[State 194, Helper]
type = Helper
trigger1 = !numhelper(10002)
name = "Blade's Mantle"
id = 10002
stateno = 10002
supermovetime = 9999

[State 194, Helper]
type = Helper
trigger1 = !numhelper(10001)
name = "Blade's Gem"
id = 10001
stateno = 10001
supermovetime = 9999

[State 194, Helper]
type = Helper
trigger1 = !numhelper(10000)
name = "Blade's Armour"
id = 10000
stateno = 10000
supermovetime = 9999

[State 194, RemoveExplod]
type = RemoveExplod
trigger1 = time = 0

[State 194, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim != 5120 && Anim != 5301
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 194, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

[State 194, Intro] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro
flag2 = NoMusic

[State 194, End]
type = ChangeState
trigger1 = time > 60
value = 0

