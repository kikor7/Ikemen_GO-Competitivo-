;---------------------------------------------------------------------------
; Standing uppercut

[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 15
;Commonly-used controllers:
ctrl = 0    
poweradd = 0
sprpriority = 2
hitdefpersist = 1
movehitpersist = 1

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 200

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(0)*prevstateno = 9000
y = fvar(1)*prevstateno = 9000

[State 200, Width]
type = Width
trigger1 = animelemno(0) <= 49
player = floor(ifelse(animelemno(0) < 9, animelemno(0)*3.5 + 3.5, 35)*const(size.xscale) + const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State 200, Width]
type = Width
trigger1 = animelemno(0) > 49
player = floor((55 - animelemno(0))*7*const(size.xscale) + const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State 200, Hitdef Counter]
type = VarSet
trigger1 = 1
var(15) = 0

[State 200, Cleave Control]
type = VarSet
trigger1 = animelem = 1
var(16) = 0
ignorehitpause = 1

[State 200, Cleave Control]
type = VarSet
triggerall = movehit = 1
triggerall = numenemy
trigger1 = enemy(0), gethitvar(hitshaketime) = 13
trigger2 = numenemy > 1
trigger2 = enemy(1), gethitvar(hitshaketime) = 13
var(16) = 1
ignorehitpause = 1

[State 200, HitDef]
type = HitDef
triggerall = !var(22)
triggerall = var(14) < 2
triggerall = !moveguarded
triggerall = !movereversed
trigger1 = !var(16)
trigger1 = var(6) := 300
trigger2 = numenemy > 1
trigger2 = numtarget(var(13))
trigger2 = target(var(13)), stateno = [5000, 5110]
trigger2 = var(6) := 300
attr = S, NA
animtype  = Back
damage    = 130, 26
getpower = 30,15
hitflag = MA
guardflag = MA
pausetime = 13,13
sparkno = 3
sparkxy = -10,floor(const(size.yscale)*ifelse(animelemno(0)<13,-25,ifelse(animelemno(0)<16,-50,ifelse(animelemno(0)<19,-190,-170))))
hitsound   = s5,2
guardsound = s6,0 + 2*(numenemy = 1 && var(26) - var(6) < 0)
ground.type = Low
ground.slidetime = 25
ground.hittime  = 25
ground.velocity = -5, -7.5
ground.cornerpush.veloff = 0
guard.velocity = -10
guard.cornerpush.veloff = -13
air.type = Low
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
fall = 1
fall.recover = 0
fall.xvelocity = -3
fall.yvelocity = -4
id = 2000 + var(14) + id
nochainid = var(13)

[State 200, HitDef]
type = HitDef
triggerall = var(22)
triggerall = var(14) < 2
triggerall = !moveguarded
triggerall = !movereversed
trigger1 = !var(16)
trigger1 = var(6) := 300
trigger2 = numenemy > 1
trigger2 = numtarget(var(13))
trigger2 = target(var(13)), stateno = [5000, 5110]
trigger2 = var(6) := 300
attr = S, NA
animtype  = Back
damage    = 130, 26
getpower = 30,15
hitflag = MA
guardflag = MA
pausetime = 13,13
sparkno = s7002
guard.sparkno = s7006 + (numenemy = 1 && var(26) - var(6) < 0)
sparkxy = -10,floor(const(size.yscale)*ifelse(animelemno(0)<13,-25,ifelse(animelemno(0)<16,-50,ifelse(animelemno(0)<19,-190,-170))))
hitsound   = s5,2
guardsound = s6,0 + 2*(numenemy = 1 && var(26) - var(6) < 0)
ground.type = Low
ground.slidetime = 25
ground.hittime  = 25
ground.velocity = -5, -7.5
ground.cornerpush.veloff = 0
guard.velocity = -10
guard.cornerpush.veloff = -13
air.type = Low
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
fall = 1
fall.recover = 0
fall.xvelocity = -3
fall.yvelocity = -4
id = 2000 + var(14) + id
nochainid = var(13)

[State 200, 1]
type = PlaySnd
trigger1 = AnimElem = 1
trigger1 = prevstateno != 9000
value = 200, 0

[State Idle Anim]
type = StateTypeSet
trigger1 = animelem = 21
movetype = I

[State 200, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

