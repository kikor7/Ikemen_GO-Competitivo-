elem = ifelse( time && animelemno(0) > 1 && animelem = 1, < 3 && ((anim = [5000, 5002]) || (anim = [5010, 5012])), 2, 1)
ignorehitpause = 1

[State 5706, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = GetHitVar(animtype) = [3,5]
value = 5030
ignorehitpause = 1

[State 5706, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(5047 + GetHitVar(animtype)))
value = 5047 + GetHitVar(animtype) ;5051 - 4 + type
ignorehitpause = 1

[State 5706, 0]
type = PalFX
trigger1 = gametime%30 < 15
color = 0
invertall = 1
mul = 64 + (gametime%30)*2, 96 + (gametime%30)*2, 128 + (gametime%30)*4
add = 384, 384, 384
time = 1
ignorehitpause = 1

[State 5706, 0]
type = PalFX
trigger1 = gametime%30 > 14
color = 0
invertall = 1
mul = 64 + (30 - (gametime%30))*2, 96 + (30 - (gametime%30))*2, 128 + (30 - (gametime%30))*4
add = 384, 384, 384
time = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
; Frozen

[Statedef 5707]
type    = A
movetype= H
physics = N
ctrl = 0
sprpriority = 0

[State AntiHelper]
type = DestroySelf
trigger1 = ishelper

[State Safety]
type = SelfState
trigger1 = gethitvar(guarded)
value = ifelse((prevstateno = [5706, 5707]), 150 + 2*(statetype = C) + 4*(statetype = A), prevstateno)

[State 5707, 0]
type = PosFreeze
trigger1 = !hitshakeover
ignorehitpause = 1

[State 5707, 1]
type = VelAdd;Gravity
trigger1 = hitshakeover
y = GetHitVar(yaccel)
ignorehitpause = 1

[State 5707, 2]
type = HitVelSet
trigger1 = !time
x = 1
y = 1
ignorehitpause = 1

[State 5707, 3]
type = SelfState
triggerall = hitshakeover
triggerall = !HitFall
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV
ignorehitpause = 1

[State 5707, 4]
type = SelfState
triggerall = hitshakeover
triggerall = HitFall
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  ;.
value = 5050 ;HITA_FALL
ignorehitpause = 1

[State 5707, ChangeAnim]
type = ChangeAnim
trigger1 = 1
value = 5012
ignorehitpause = 1

[State 5707, 0]
type = PalFX
trigger1 = gametime%30 < 15
color = 0
invertall = 1
mul = 64 + (gametime%30)*3, 96 + (gametime%30)*2, 128 + (gametime%30)*4
add = 384, 384, 384
time = 1
ignorehitpause = 1

[State 5707, 0]
type = PalFX
trigger1 = gametime%30 > 14
color = 0
invertall = 1
mul = 64 + (30 - (gametime%30))*3, 96 + (30 - (gametime%30))*2, 128 + (30 - (gametime%30))*4
add = 384, 384, 384
time = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
; Petrified
[Statedef 5709]
type    = A
movetype= H
physics = N
ctrl = 0

[State 5709, 0]
type = PosFreeze
trigger1 = time <= gethitvar(hittime) + 30

[State 5709, 0]
type = PalFX
trigger1 = time = [10, 33]
color = 256 - (time - 10)*8
mul =  256 - (time - 10)*2, 256 - (time - 10)*3, 256 - (time - 10)*3
add = (time - 10)*3, (time - 10)*3, (time - 10)*3
time = 1

[State 5709, 0]
type = PalFX
trigger1 = time >= 34
color = 64
mul = 208,184,184
add = 72,72,72
time = 1

[State 5709, 1]
type = VelAdd;Gravity
trigger1 = time > gethitvar(hittime) + 30
y = GetHitVar(yaccel)*1.2

[State 5709, 2]
type = HitVelSet
trigger1 = Time = 0
x = 1
y = 1

[State 5709, 3]
type = SelfState
triggerall = time > gethitvar(hittime) + 30
triggerall = !HitFall
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  ;.
value = 5040 ;HITA_RECOV

[State 5709, 4]
type = SelfState
triggerall = time > gethitvar(hittime) + 30
triggerall = HitFall
trigger1 = Vel Y > 0    ;Hit ground
trigger1 = Pos Y >= 10  ;.
value = 5050 ;HITA_FALL

[State 5709, ChangeAnim]
type = ChangeAnim
trigger1 = 1
value = 5012

;---------------------------------------------------------------------------
; Super Armour

[Statedef 9000]
MoveType = H 
hitdefpersist = 1

[State 9000, Cancel]
type = ChangeState
trigger1 = var(0) < 0
value = -var(0)

[State 9000, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA, AA, AP, AT
stateno = 9000
ignorehitpause = 1

[State 9000, PosFreeze]
type = PosFreeze
trigger1 = 1
value = 1
ignorehitpause = 1

[State 9000, Armour Recovery]
type = VarSet
trigger1 = time = 0
trigger1 = var(18) < 5
trigger1 = GetHitVar(animtype) >= var(18)
var(1) = (ifelse(gethitvar(animtype) < 3, gethitvar(animtype), 3) + 1)*var(9)
ignorehitpause = 1

;[State 9000, Hyper Armour] ;At max armour setting, no damage during super,
;type = LifeAdd		   
;triggerall = 1
;trigger1 = gethitvar(damage) >= life
;value = floor(gethitvar(damage)*ifelse(3-gethitvar(animtype) > 0, gethitvar(animtype)/3.0, 0))
;ignorehitpause = 1

;[State 9000, Hyper Armour] ;At max armour setting, no damage during super,
;type = LifeAdd		   
;triggerall = 1
;trigger1 = gethitvar(damage) < life
;trigger1 = var(10)
;value = var(10)
;ignorehitpause = 1

[State 9000, Hyper Armour] ;Cannot (quite) be killed during super moves
type = LifeAdd
trigger1 = var(0) = [2000, 3000]
trigger1 = time = 0
trigger1 = gethitvar(damage) >= life
value = gethitvar(damage) - life + 1
ignorehitpause = 1

;[State 9000, GetHitVar(Damage)]
;type = VarSet
;trigger1 = gethitvar(damage) < life
;var(10) = floor(gethitvar(damage)*ifelse(3-gethitvar(animtype) > 0, gethitvar(animtype)/3.0, 0))
;ignorehitpause = 1

[State -2, Debug Info]
type = DisplayToClipboard
trigger1 = 1
text = "psn %d, anim %d"
params = prevstateno, anim
ignorehitpause = 1

[State 9000, ChangeAnim]
type = ChangeAnim
trigger1 = 1
value = Anim
elem = AnimElemNo(-1) ;-(anim > 99 || (anim = [41, 46]))

[State 9000, Dead]
type = ChangeState
trigger1 = !alive
value = 5000

[State 9000, PalFX]
type = PalFx
trigger1 = time%4 = 0
add = 256, 0, 0
sinadd = -128, 0, 0, 4
time = 2
ignorehitpause = 1

[State 9000, PalFX]
type = PalFx
trigger1 = time%4 = 0
trigger1 = var(18) > 4 || GetHitVar(animtype) < var(18) || var(0) = [2000, 3000]
add = 64, 64, 64
sinadd = -32, -32, -32, 4
time = 2
ignorehitpause = 1

[State 9000, End]
type = ChangeState
trigger1 = !gethitvar(hitshaketime)
value = Var(0)

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;==================================================================================
;======| RELACIONADO ﾀ AI - AI RELATED |===========================================
;==================================================================================

; (Credit to ANMC, Bagaliao, and FlowaGirl for the basic helper method concept.)
;
;------------------
; AI Activation Helper State - Primary Version
; (Credit to YongMing for the basic HitPause bugfix concept.)
;
; var(1) - First tick button activation prevention.
; var(2) - Used for pause/superpause and custom state check, basically.
; var(3) - (Super/)Pause & custom state-triggered dir detection disabler.
; var(4) - Persistent direction command detection enabler (due to 2002.04.14).
; var(9) - AutoTurn bug fixer.
; parent's var(57) - Parent's GameTime var, for pause and custom state check.
; parent's var(59) - Parent's primary AI variable.
;
; The code in this state is mostly simply copy/pasteable.
; But if you're using different indices for the parent's variables,
; or if you change your character's basic commands' names, you'll
; of course need to change the code in this state accordingly.

[StateDef 9741]
type = S
movetype = I
physics = N
anim = 9741
ctrl = 0

[State 9741, Safety]; Just in case your opponent is very poorly coded.
type = SelfState
trigger1 = !IsHelper
value = 0

[State 9741, PauseCheck]
type = VarSet
trigger1 = (GameTime>(Parent,var(57)))
trigger2 = !(Parent,Alive)
trigger3 = (RoundState != 2)
trigger4 = Parent,var(59)
trigger5 = (var(3):=0)
var(2) = (var(3):=1)+(var(4):=0)

[State 9741, Facing]
type = Turn
trigger1 = (var(9):=(Facing != Parent,Facing))

[State 9741, DirTurnOnAI]
type = ParentVarSet
triggerall = !var(3)
triggerall = !var(9)
trigger1 = (Parent,command = "holdfwd")
trigger2 = (Parent,command = "holdback")
trigger3 = (Parent,command = "holdup")
trigger4 = (Parent,command = "holddown")
trigger5 = !(var(4):=1)
var(59) = var(4)

[State 9741, DirTurnOffAI]
type = ParentVarSet
triggerall = !var(3)
triggerall = Parent,var(59)
trigger1 = (command = "holdfwd")
trigger1 = (Parent,command = "holdfwd")
trigger2 = (command = "holdback")
trigger2 = (Parent,command = "holdback")
trigger3 = (command = "holdup")
trigger3 = (Parent,command = "holdup")
trigger4 = (command = "holddown")
trigger4 = (Parent,command = "holddown")
var(59) = (var(4):=0)

[State 9741, ButtonTurnOnAI]
type = ParentVarSet
triggerall = var(1)
triggerall = !var(2)
trigger1 = (Parent,command = "a")
trigger2 = (Parent,command = "b")
trigger3 = (Parent,command = "c")
trigger4 = (Parent,command = "x")
trigger5 = (Parent,command = "y")
trigger6 = (Parent,command = "z")
trigger7 = (Parent,command = "start")
var(59) = 1

[State 9741, ButtonTurnOffAI]
type = ParentVarSet
triggerall = !var(2)
trigger1 = (command = "a")
trigger1 = (Parent,command = "a")
trigger2 = (command = "b")
trigger2 = (Parent,command = "b")
trigger3 = (command = "c")
trigger3 = (Parent,command = "c")
trigger4 = (command = "x")
trigger4 = (Parent,command = "x")
trigger5 = (command = "y")
trigger5 = (Parent,command = "y")
trigger6 = (command = "z")
trigger6 = (Parent,command = "z")
trigger7 = (command = "start")
trigger7 = (Parent,command = "start")
var(59) = -1

[State 9741, UnPauseCheck]
type = VarSet
triggerall = var(2)
trigger1 = (Parent,command = "a")
trigger2 = (Parent,command = "b")
trigger3 = (Parent,command = "c")
trigger4 = (Parent,command = "x")
trigger5 = (Parent,command = "y")
trigger6 = (Parent,command = "z")
trigger7 = (Parent,command = "start")
trigger8 = (var(2) = 2)
trigger8 = (var(2):=0)
var(2) = 2

[State 9741, Goodbye]
type = DestroySelf
triggerall = (var(1):=1)
trigger1 = Parent,var(59)
trigger2 = !(Parent,Alive)
trigger3 = (RoundState != 2)


;------------------
; AI Activation Helper State - Compatibly Partnered Version
;
; var(1) - First tick dir activation prevention
; var(2) - Used for pause/superpause and custom state check, basically.
; var(3) - (Super/)Pause & custom state-triggered dir detection disabler.
; var(4) - Hitpause check.
; var(5) - No button on previous tick.
; var(6) - Any dir on this tick.
; var(7) - Any button on this tick.
; var(8) - Matching partner button detected.
; var(9) - AutoTurn bug fixer.
; parent's var(57) - Parent's GameTime var, for pause and custom state check.
; parent's var(59) - Parent's primary AI variable.
;
; The code in this state is mostly simply copy/pasteable.
; But if you're using different indices for the parent's variables,
; or if you change your character's basic commands' names, you'll
; of course need to change the code in this state accordingly.

[StateDef 9742]
type = S
movetype = I
physics = N
anim = 9741
ctrl = 0

[State 9742, Safety]; Just in case your opponent is very poorly coded.
type = SelfState
trigger1 = !IsHelper
value = 0

[State 9742, PauseCheck]
type = VarSet
trigger1 = (GameTime>Parent,var(57))
trigger2 = !(Parent,Alive)
trigger3 = (RoundState != 2)
trigger4 = Parent,var(59)
trigger5 = (var(3):=0)
var(2) = (var(3):=1)

[State 9742, Facing]
type = Turn
trigger1 = (var(9):=(Facing != Parent,Facing))

[State 9742, ParentDirCheck]
type = VarSet
trigger1 = (Parent,command = "holdfwd")
trigger2 = (Parent,command = "holdback")
trigger3 = (Parent,command = "holdup")
trigger4 = (Parent,command = "holddown")
trigger5 = (var(6):=0)
var(6) = 1

[State 9742, ParentButtonCheck]
type = VarSet
trigger1 = (Parent,command = "a")
trigger2 = (Parent,command = "b")
trigger3 = (Parent,command = "c")
trigger4 = (Parent,command = "x")
trigger5 = (Parent,command = "y")
trigger6 = (Parent,command = "z")
trigger7 = (Parent,command = "start")
trigger8 = (var(7):=0)
var(7) = 1

[State 9742, SameButtonCheck]
type = VarSet
triggerall = var(7)
triggerall = !var(2)
triggerall = NumPartner
trigger1 = (Parent,command = "a")
trigger1 = (Partner,command = "a")
trigger2 = (Parent,command = "b")
trigger2 = (Partner,command = "b")
trigger3 = (Parent,command = "c")
trigger3 = (Partner,command = "c")
trigger4 = (Parent,command = "x")
trigger4 = (Partner,command = "x")
trigger5 = (Parent,command = "y")
trigger5 = (Partner,command = "y")
trigger6 = (Parent,command = "z")
trigger6 = (Partner,command = "z")
trigger7 = (Parent,command = "start")
trigger7 = (Partner,command = "start")
trigger8 = (var(8):=0)
var(8) = 1

[State 9742, DirTurnOnAI]
type = ParentVarSet
trigger1 = var(1)
trigger1 = var(6)
trigger1 = !var(3)
trigger1 = !var(4)
trigger1 = !var(9)
var(59) = 1

[State 9742, DirTurnOffAI]
type = ParentVarSet
triggerall = var(6)
triggerall = !var(3)
triggerall = Parent,var(59)
trigger1 = (command = "holdfwd")
trigger1 = (Parent,command = "holdfwd")
trigger2 = (command = "holdback")
trigger2 = (Parent,command = "holdback")
trigger3 = (command = "holdup")
trigger3 = (Parent,command = "holdup")
trigger4 = (command = "holddown")
trigger4 = (Parent,command = "holddown")
var(59) = 0

[State 9742, ButtonTurnOnAI]
type = ParentVarSet
trigger1 = var(5)
trigger1 = var(7)
trigger1 = !var(2)
trigger1 = !var(8)
var(59) = 1

[State 9742, ButtonTurnOffAI]
type = ParentVarSet
triggerall = var(7)
triggerall = !var(2)
triggerall = !var(8)
trigger1 = (command = "a")
trigger1 = (Parent,command = "a")
trigger2 = (command = "b")
trigger2 = (Parent,command = "b")
trigger3 = (command = "c")
trigger3 = (Parent,command = "c")
trigger4 = (command = "x")
trigger4 = (Parent,command = "x")
trigger5 = (command = "y")
trigger5 = (Parent,command = "y")
trigger6 = (command = "z")
trigger6 = (Parent,command = "z")
trigger7 = (command = "start")
trigger7 = (Parent,command = "start")
var(59) = -1

[State 9742, UnPauseCheck]
type = VarSet
triggerall = var(2)
triggerall = !var(4)
trigger1 = var(7)
trigger2 = (var(2) = 2)
trigger2 = (var(2):=0)
var(2) = 2

[State 9742, Goodbye]
type = DestroySelf
trigger1 = Parent,var(59)
trigger2 = !(Parent,Alive)
trigger3 = (RoundState != 2)

[State 9742, HitPauseCheck]
type = VarSet
trigger1 = var(6)
trigger2 = var(7)
trigger3 = !(Parent,HitPauseTime)
var(4) = Parent,HitPauseTime

[State 9742, Delay]
type = VarSet
trigger1 = (var(1):=1)
var(5) = !var(7)


;------------------
; XOR Method's HitPauseTime Helper State

[StateDef 9743]
type = S
movetype = I
physics = N
anim = 9741
ctrl = 0

[State 9743, Safety]; Just in case your opponent is very poorly coded.
type = SelfState
trigger1 = !IsHelper
value = 0

[State 9743, HitPauseTime]
type = VarSet
trigger1 = !(Parent,HitPauseTime)
trigger2 = (GameTime>Parent,var(57))
var(1) = Parent,HitPauseTime

[State 9742, Goodbye]
type = DestroySelf
trigger1 = (Parent,var(59) = 1)
trigger2 = !(Parent,Alive)
trigger3 = (RoundState != 2)

;==================================================================================
;==================================================================================
;==================================================================================

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[StateDef -2]

;==================================================================================
;======| RELACIONADO ﾀ AI - AI RELATED |===========================================
;==================================================================================

; Within StateDef -2, none of your own AI-related code should be placed
; above these next two controllers.

[State -2, StopAI]
type = VarSet
triggerall = (var(59) > 0)
trigger1 = (RoundState != 2)
trigger2 = !Alive
var(59) = -2
IgnoreHitPause = 1

; This controller is optional.  It allows you treat the AI flag as a boolean
; value rather than an integer value, letting you trigger your AI directives
; with "var(0)" instead of "var(59)>0", and letting you make moves usable only
; by humans by using "!var(0)" instead of "var(59)<1", thus slightly improving
; the size and efficiency of your code.
; Another benefit is that it makes it much easier for users to disable your AI,
; if they so choose.
;[State -2, Simplifier]
;type = VarSet
;trigger1 = (var(59) = 1)
;trigger2 = (var(0):=0)
;var(0) = 1	; Another option is to replace 1 with something like MatchNo, if
;		; you want to design your AI to have varying levels of difficulty.
;IgnoreHitPause = 1

;==================================================================================
;==================================================================================
;==================================================================================

[State -2, StopSnd] ;Stop intro music if intro skipped
type = StopSnd
trigger1 = var(25) > 1
trigger1 = roundstate > 1
trigger1 = !numhelper(10000)
channel = 8

[State -2, Width Scale]
type = Width
trigger1 = statetype != A
player = floor(const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State -2, Width Scale]
type = Width
trigger1 = statetype = A
player = floor(const(size.air.front)*(const(size.xscale) - 1)), floor(const(size.air.back)*(const(size.xscale) - 1))

[State -2, Jump Buffer]
type = VarAdd
triggerall = var(23) > 0
trigger1 = var(23) > 1
trigger2 = command != "holddown"
var(23) = -1
ignorehitpause = 1

[State -2, Jump Buffer]
type = VarSet
triggerall = var(23) = 0
trigger1 = command = "holddown"
var(23) = 12
ignorehitpause = 1

[State -2, NoChainID]
type = VarSet
trigger1 = !movecontact
var(13) = (movetype = A)*(var(0)*10 + var(15)*3 + id)
ignorehitpause = 1

[State -2, NoChainID]
type = VarSet
trigger1 = movecontact = 1
trigger1 = numtarget
var(13) = (movetype = A)*(var(0)*10 + var(14) + var(15)*3 + id)
ignorehitpause = 1

[State -2, Targets Hit]
type = VarAdd
trigger1 = movecontact = 1
trigger1 = numtarget(var(13))
var(14) = numtarget(var(13))

[State -2, Targets Hit]
type = VarSet
trigger1 = movetype != A
trigger1 = stateno != 9000
var(14) = 0

[State -2, Targets Hit]
type = VarSet
trigger1 = var(14) > 2
var(14) = 2

[State -2, Hitdef Counter]
type = VarSet
trigger1 = movetype != A
trigger1 = stateno != 9000
var(15) = 0

[State -2, Guard Break Sound Trigger Reset]
type = VarSet
trigger1 = var(7)
var(7) = 0
ignorehitpause = 1

[State -2, Single Target Guarded]
type = VarAdd
triggerall = moveguarded = 1 || projguardedtime(var(13)) = 0
triggerall = numtarget(var(13)) = 1
triggerall = numenemy
triggerall = target(var(13)), gethitvar(guarded)
triggerall = var(6)
trigger1 = target(var(13)), id = var(2)
trigger1 = var(3) != -1
trigger2 = target(var(13)), id = var(4)
trigger2 = var(5) != -1
v = ifelse(target(var(13)), id = var(2), 3, 5)
value = var(6)
ignorehitpause = 1

[State -2, Multiple Targets Guarded]
type = null
triggerall = moveguarded = 1 || projguardedtime(var(13)) = 0
triggerall = numtarget(var(13)) > 1
triggerall = numenemy
triggerall = var(6)
;triggerall = target(var(13)), id = var(2) || target(var(13)), id = var(4)
trigger1 = var(3) != -1
trigger1 = enemy(0), gethitvar(guarded)
trigger1 = enemy(0), gethitvar(chainid) = var(13)
trigger1 = enemy(0), gethitvar(hitshaketime)
trigger1 = var(3) := var(3) + var(6)
trigger1 = 0
trigger2 = var(5) != -1
trigger2 = numenemy > 1
trigger2 = enemy(1), gethitvar(guarded)
trigger2 = enemy(1), gethitvar(chainid) = var(13)
trigger2 = enemy(1), gethitvar(hitshaketime)
trigger2 = var(5) := var(5) +  var(6)
trigger2 = 0
ignorehitpause = 1

[State -2, Single Target Guard Break]
type = TargetState
triggerall = moveguarded = 1 || projguardedtime(var(13)) = 0
triggerall = var(6)
triggerall = numtarget(var(13)) = 1
triggerall = target(var(13)), alive
triggerall = target(var(13)), gethitvar(guarded)
trigger1 = target(var(13)), id = var(2)
trigger1 = var(3) >= floor(target(var(13)), lifemax*target(var(13)), const(data.defence)*0.01)
trigger1 = var(3) := 0 || 1
trigger1 = var(7) := 1
trigger2 = target(var(13)), id = var(4)
trigger2 = var(5) >= floor(target(var(13)), lifemax*target(var(13)), const(data.defence)*0.01)
trigger2 = var(5) := 0 || 1
trigger2 = var(7) := 1
id = var(13)
value = 5400
ignorehitpause = 1

[State -2, Multiple Target Guard Break]
;Since TargetState can only affect ALL targets, only activates when both enemies meet criteria
;This means if only 1 can be broken, but both are hit at the same time, there will be no guard crush
type = TargetState
triggerall = moveguarded = 1 || projguardedtime(var(13)) = 0
triggerall = var(6)
triggerall = numtarget(var(13)) > 1
triggerall = numenemy > 1
trigger1 = enemy(0), alive
trigger1 = enemy(0), gethitvar(guarded)
trigger1 = enemy(0), gethitvar(chainid) = var(13)
trigger1 = enemy(0), gethitvar(hitshaketime)
trigger1 = enemy(1), alive
trigger1 = enemy(1), gethitvar(guarded) 
trigger1 = enemy(1), gethitvar(chainid) = var(13)
trigger1 = enemy(1), gethitvar(hitshaketime)
trigger1 = var(3) >= floor(enemy(0), lifemax*enemy(0), const(data.defence)*0.01)
trigger1 = var(5) >= floor(enemy(1), lifemax*enemy(0), const(data.defence)*0.01)
trigger1 = var(3) := 0 || 1
trigger1 = var(5) := 0 || 1
trigger1 = var(7) := 2
id = var(13)
value = 5400
ignorehitpause = 1

[State -2, Dragonfire Single Target Guard Break]
type = TargetState
triggerall = projguardedtime(1008) = 0
triggerall = numtarget(1008) = 1
triggerall = target(1008), alive
triggerall = target(1008), gethitvar(guarded)
trigger1 = target(1008), id = var(2)
trigger1 = var(3) := 0 || 1
trigger1 = var(7) := 1
trigger2 = target(1008), id = var(4)
trigger2 = var(5) := 0 || 1
trigger2 = var(7) := 1
id = 1008
value = 5400
ignorehitpause = 1

[State -2, Dragonfire Multiple Target Guard Break]
;Since TargetState can only affect ALL targets, only activates when both enemies meet criteria
;This means if only 1 can be broken, but both are hit at the same time, there will be no guard crush
type = TargetState
triggerall = projguardedtime(1008) = 0
triggerall = numtarget(1008) > 1
triggerall = numenemy > 1
trigger1 = enemy(0), alive
trigger1 = enemy(0), gethitvar(guarded)
trigger1 = enemy(0), gethitvar(chainid) = 1008
trigger1 = enemy(0), gethitvar(hitshaketime)
trigger1 = enemy(1), alive
trigger1 = enemy(1), gethitvar(guarded) 
trigger1 = enemy(1), gethitvar(chainid) = 1008
trigger1 = enemy(1), gethitvar(hitshaketime)
trigger1 = var(3) := 0 || 1
trigger1 = var(5) := 0 || 1
trigger1 = var(7) := 2
id = 1008
value = 5400
ignorehitpause = 1

[State -2, Single Mode Guard Break Spark/Sound]
type = VarSet
trigger1 = var(7) > 0
trigger1 = var(22)
trigger1 = numenemy = 1
trigger1 = numtarget(1008) != 1
var(7) = -1
ignorehitpause = 1

[State -2, Guard Break Spark]
type = Explod
trigger1 = numtarget(var(13)) = 1
trigger1 = var(7) = 1
id = 7007
anim = 7007
sprpriority = 5
bindtime = 1
pos = floor((target(var(13)), pos x - pos x)*facing - target(var(13)), const(size.ground.front) + 10), floor((target(var(13)), pos y - pos y) + target(var(13)), const(size.head.pos.y)*0.3 + target(var(13)), const(size.mid.pos.y)*0.7)
ignorehitpause = 1
supermovetime = 99999
pausemovetime = 99999
ownpal = 1

[State -2, Double Guard Break Spark]
type = Explod
trigger1 = numenemy
trigger1 = var(7) = 2
id = 7007
anim = 7007
sprpriority = 5
bindtime = 1
pos = floor((enemy(0), pos x - pos x)*facing - enemy(0), const(size.ground.front) + 10), floor((enemy(0), pos y - pos y) + enemy(0), const(size.head.pos.y)*0.3 + enemy(0), const(size.mid.pos.y)*0.7)
ignorehitpause = 1
supermovetime = 99999
pausemovetime = 99999
ownpal = 1


[State -2, Double Guard Break Spark]
type = Explod
trigger1 = numenemy > 1
trigger1 = var(7) = 2
id = 7007
anim = 7007
sprpriority = 5
bindtime = 1
pos = floor((enemy(1), pos x - pos x)*facing - enemy(1), const(size.ground.front) + 10), floor((enemy(1), pos y - pos y) + enemy(1), const(size.head.pos.y)*0.3 + enemy(1), const(size.mid.pos.y)*0.7)
ignorehitpause = 1
supermovetime = 99999
pausemovetime = 99999
ownpal = 1


[State -2, Guard Break Sound]
type = PlaySnd
trigger1 = numenemy > 1
trigger1 = numtarget(var(13)) = 1
trigger1 = var(7) = 1
trigger1 = var(7) := 0 || 1
value = 6, 2
abspan = floor(target(var(13)), pos x)
ignorehitpause = 1

[State -2, Double Guard Break Sounds]
type = PlaySnd
trigger1 = var(7) = 2
trigger1 = numenemy
value = 6, 2
abspan = floor(enemy(0), pos x)
ignorehitpause = 1

[State -2, Double Guard Break Sounds]
type = PlaySnd
trigger1 = var(7) = 2
trigger1 = var(7) := 0 || 1
trigger1 = numenemy > 1
value = 6, 2
abspan = floor(enemy(1), pos x)
ignorehitpause = 1

[State -2, Dragonfire Guard Break Sound]
type = PlaySnd
trigger1 = numtarget(1008) = 1
trigger1 = var(7) = 1
trigger1 = var(7) := 0 || 1
value = 6, 2
abspan = floor(target(1008), pos x)
ignorehitpause = 1

[State -2, Dragonfire Double Guard Break Sounds Fail Safe]
type = PlaySnd
trigger1 = numenemy = 1
trigger1 = var(7) = 2
trigger1 = var(7) := 0 || 1
value = 6, 2
abspan = floor(enemy(0), pos x)
ignorehitpause = 1

[State -2, Dragonfire Double Guard Break Sounds]
type = PlaySnd
trigger1 = numenemy > 1
trigger1 = var(7) = 2
value = 6, 2
abspan = floor(enemy(0), pos x)
ignorehitpause = 1

[State -2, Dragonfire Double Guard Break Sounds]
type = PlaySnd
trigger1 = numenemy > 1
trigger1 = var(7) = 2
trigger1 = var(7) := 0 || 1
value = 6, 2
abspan = floor(enemy(1), pos x)
ignorehitpause = 1

[State -2, Guard Break Reset]
type = VarSet
trigger1 = !hitdefattr = SCA, AA
trigger2 = movecontact = 1 || projcontacttime(var(13)) = 0
var(6) = 0
ignorehitpause = 1

[State -2, Enemy 1 Guard Guage]
type = VarAdd
trigger1 = var(3) > 0
trigger1 = gametime%2
trigger1 = numenemy
trigger1 = enemy(0), statetype != A
trigger1 = enemy(0), movetype != H
var(3) = ifelse(var(3) > 2, -3, -var(3))
ignorehitpause = 1

[State -2, Enemy 2 Guard Guage]
type = VarAdd
trigger1 = var(5) > 0
trigger1 = gametime%2
trigger1 = numenemy > 1
trigger1 = enemy(1), statetype != A
trigger1 = enemy(1), movetype != H
var(5) = ifelse(var(5) > 2, -3, -var(5))
ignorehitpause = 1

[State -2, Single Mode Guard Break Spark/Sound]
type = VarSet
trigger1 = var(26)
var(26) = 0
ignorehitpause = 1

[State -2, Single Mode Guard Break Spark/Sound]
type = null
triggerall = numenemy = 1
trigger1 = enemy, id = var(2)
trigger1 = var(26) := floor(enemy, lifemax*enemy, const(data.defence)*0.01) - var(3)
trigger2 = enemy, id = var(4)
trigger2 = var(26) := floor(enemy, lifemax*enemy, const(data.defence)*0.01) - var(5)
ignorehitpause = 1

[State -2, GetHit Sound]
type = StopSnd
trigger1 = movetype = H
trigger1 = stateno != 9000
trigger1 = gethitvar(hitshaketime) = 1
trigger1 = !gethitvar(guarded) || stateno > 155
channel = 0
ignorehitpause = 1

[State -2, GetHit Sound]
type = PlaySnd
triggerall = alive
trigger1 = movetype = H
trigger1 = stateno != 9000
trigger1 = gethitvar(hitshaketime) = 1
trigger1 = random < (gethitvar(animtype) + 1)*100
trigger1 = !gethitvar(guarded)
channel = 0
value = 5000, 0
ignorehitpause = 1

[State -2, Block Sound]
type = PlaySnd
trigger1 = movetype = H
trigger1 = !var(20)
trigger1 = gethitvar(guarded)
trigger1 = gethitvar(hitshaketime) = 1
trigger1 = stateno = [120, 155]
trigger1 = random < 200
trigger1 = var(20) := 600
channel = 0
value = 150, 0
ignorehitpause = 1

[State -2, Block Sound Timer]
type = VarAdd
trigger1 = var(20) > 0
var(20) = -1

[State -2, Disable Armour During Combos/Custom States and when Idle]
type = VarSet
triggerall = !var(1)
trigger1 = movetype = H
trigger1 = stateno != 9000
trigger1 = time > 0 || (stateno != 5000 && stateno != 5010 && stateno != 5020 && stateno != 5070)
trigger2 = !var(19)
var(1) = 1

[State -2, Super Move Hyper Armour]
type = HitOverride
trigger1 = var(0) = [2000, 3000]
trigger2 = !var(1)
trigger2 = var(8) > 4
trigger3 = var(18) > 4
attr = SCA, AA, AP, AT
stateno = 9000
ignorehitpause = 1

[State -2, Custom State Detection]
type = VarSet
trigger1 = 1
var(19) = 0

[State -2, Getup Timer]
type = VarAdd
trigger1 = var(21) > 0
var(21) = -1

[State -2, Getup Timer]
type = VarSet
trigger1 = !ctrl
var(21) = 0

[State -2, AI Hitstun Counter]
type = VarAdd
triggerall = var(56) < 600
trigger1 = movetype = H
trigger1 = p2bodydist x > 120
var(56) = 1
ignorehitpause = 1

[State -2, AI Hitstun Counter]
type = VarAdd
triggerall = var(56) > 0
triggerall = movetype != H
triggerall = statetype != L
triggerall = anim != 9999
trigger1 = p2bodydist x < 120
trigger2 = p2movetype = H
var(56) = ceil(-1 - var(56)/100.0)
ignorehitpause = 1

[State -2, Debug Info]
type = DisplayToClipboard
trigger1 = 1
text = "en.1 guard %d, e.2 guard %d, nochainid %d, targets hit %d, armour %d"
params = var(3), var(5), var(13), var(14), var(7)
ignorehitpause = 1

;[State -2, Debug Info 2]
;type = DisplayToClipboard
;trigger1 = 1
;text = "hitvar damage %d, temp var(16) %d"
;params = var(10), var(16)
;ignorehitpause = 1

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;==================================================================================
;======| RELACIONADO ﾀ AI - AI RELATED |===========================================
;==================================================================================

; Kamek and Luchini appear to have been the first ones to use the IsHomeTeam AI activation concept.
; Feel free to move this controller to your character's intro state for slightly better efficiency.
[State -3, SetAI]
type = VarSet
triggerall = !RoundState
triggerall = IsHomeTeam
trigger1 = (TeamSide = 2)
trigger2 = (MatchNo > 1)
var(59) = 1

; Feel free to move this controller to your character's intro state for slightly better efficiency.
; Note that it may give P2 a slight unfair advantage in simul team vs mode, so you
; may want to disable it.  But then, since when has Mugen been about fairness? =P
[State -3, Unfair]; Is this reliable?
type = VarSet
trigger1 = !RoundState
trigger1 = (var(59) != 1)
trigger1 = NumPartner
trigger1 = (ID > Partner,ID)
trigger1 = (TeamSide = 2)
var(59) = 1

[State -3, AI Helper (Compatibly Partnered Version)]
type = Helper
trigger1 = !var(59)
trigger1 = !NumHelper(9742)
trigger1 = (RoundState = 2)
trigger1 = Alive
trigger1 = NumPartner
trigger1 = Partner,SelfAnimExist(9741)
HelperType = normal
name = "AI Helper (Simul Version)"
ID = 9742
pos = 9999999,99999
StateNo = 9742
KeyCtrl = 1
PauseMoveTime = 999999999
SuperMoveTime = 999999999

; If you want to use the Guard mode, Dummy mode, Distance, or Button jam dummy control
; options in Training mode without activating the dummy's AI while working on your
; character, then all you need to do is temporarily disable this controller.
; Or, if you want to permanently disable this controller in Training mode,
; then you could use the Training mode detection code available on my site
; ( http://www.shinmugen.net/winane/ ), and then just add a "(var(59)&63)>30"
; triggerall to this controller.
[State -3, AI Helper]
type = Helper
triggerall = !var(59)
triggerall = !NumHelper(9741)
triggerall = (RoundState = 2)
triggerall = Alive
trigger1 = !NumPartner
trigger2 = !(Partner,SelfAnimExist(9741))
HelperType = normal
name = "AI Helper"
ID = 9741
pos = 9999999,99999
StateNo = 9741
KeyCtrl = 1
PauseMoveTime = 999999999
SuperMoveTime = 999999999

[State -3, TurnBackOnAI]
type = VarSet
trigger1 = (var(59) = -2)
trigger1 = (RoundState = 2)
trigger1 = Alive
var(59) = 1

[State -3, HitPauseTime Helper]
type = Helper
triggerall = var(59)!=1
triggerall = !NumHelper(9743)
triggerall = (RoundState = 2)
triggerall = Alive
trigger1 = (MatchNo = 1)
trigger2 = NumPartner
trigger2 = (ID > Partner,ID)
HelperType = normal
name = "HitPauseTime"
ID = 9743
pos = 9999999,99999
StateNo = 9743
PauseMoveTime = 999999999
SuperMoveTime = 999999999

; According to Roque, this method works in Linux Mugen version 2002.04.14,
; whereas the old humanly-impossible commands method does not.
; It is very important that this controller NOT be moved to State -2.
; Note that this part won't work if AI.Cheat is turned off in mugen.cfg.
[State -3, XOR]
type = VarSet
triggerall = var(59)!=1
triggerall = (var(57) = GameTime-1)
triggerall = NumHelper(9743)
triggerall = !(Helper(9743),var(1))
trigger1 = (command = "a") ^^ (command = "a2")
trigger2 = (command = "b") ^^ (command = "b2")
trigger3 = (command = "c") ^^ (command = "c2")
trigger4 = (command = "x") ^^ (command = "x2")
trigger5 = (command = "y") ^^ (command = "y2")
trigger6 = (command = "z") ^^ (command = "z2")
trigger7 = (command = "start") ^^ (command = "start2")
trigger8 = (command = "holda") ^^ (command = "holda2")
trigger9 = (command = "holdb") ^^ (command = "holdb2")
trigger10 = (command = "holdc") ^^ (command = "holdc2")
trigger11 = (command = "holdx") ^^ (command = "holdx2")
trigger12 = (command = "holdy") ^^ (command = "holdy2")
trigger13 = (command = "holdz") ^^ (command = "holdz2")
trigger14 = (command = "holdstart") ^^ (command = "holdstart2")
trigger15 = (command = "holdfwd") ^^ (command = "holdfwd2")
trigger16 = (command = "holdback") ^^ (command = "holdback2")
trigger17 = (command = "holdup") ^^ (command = "holdup2")
trigger18 = (command = "holddown") ^^ (command = "holddown2")
trigger19 = (command = "recovery") ^^ (command = "recovery2")
trigger20 = (command ="Split1") ^^ (command = "AISplit1")
trigger21 = (command ="Split2") ^^ (command = "AISplit2")
trigger22 = (command ="Split3") ^^ (command = "AISplit3")
trigger23 = (command ="Mirror1") ^^ (command = "AIMirror1")
trigger24 = (command ="Mirror2") ^^ (command = "AIMirror2")
trigger25 = (command ="Mirror3") ^^ (command = "AIMirror3")
trigger26 = (command ="DragonFirea") ^^ (command = "AIDragonFirea")
trigger27 = (command ="DragonFireb") ^^ (command = "AIDragonFireb")
trigger28 = (command ="DragonFirec") ^^ (command = "AIDragonFirec")
trigger29 = (command ="EmeraldArca") ^^ (command = "AIEmeraldArca")
trigger30 = (command ="EmeraldArcb") ^^ (command = "AIEmeraldArcb")
trigger31 = (command ="EmeraldArcc") ^^ (command = "AIEmeraldArcc")
trigger32 = (command ="FF") ^^ (command = "AIFF")
trigger33 = (command ="BB") ^^ (command = "AIBB")
;Add more as desired. (See my notes in the CMD.)
var(59) = 1

; It is very important that this controller NOT be moved to State -2, as putting
; it there would defeat the entire purpose of the controller, allowing the
; helper method or the XOR method to erroneously set the AI variable.
; And within State -3, don't put any ChangeState controllers before this
; controller, lest you unnecessarily delay your character's AI activation.
[State -3, GameTimeVar]
type = VarSet
trigger1 = 1
var(57) = GameTime
IgnoreHitPause = 1

; Within StateDef -3, none of your own AI-related code should come after the code
; provided here (and putting it before the code is also generally a bad idea).
; It's better to use State -1 (or, in special circumstances, State -2) instead.

;==================================================================================
;==================================================================================
;==================================================================================

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 101 ;run-fwd land
trigger3 = stateno = 106 ;hop-back land
value = 52, 0

[State -3, VarSet]
type = VarSet
trigger1 = MoveType != H
var(0) = StateNo 

[State -3, VarSet]
type = VarSet
trigger1 = MoveType != H || stateno = [120, 155]
fvar(0) = vel x

[State -3, VarSet]
type = VarSet
trigger1 = MoveType != H || stateno = [120, 155]
fvar(1) = vel y

[State -3, Armour Tick]
type = VarAdd
trigger1 = movetype != H
trigger1 = var(1) > 0
var(1) = -1

[State -3, Custom State Detection]
type = VarSet
trigger1 = 1
var(19) = 1

[State -3, Hyper Armour No Guard]
type = AssertSpecial
trigger1 = var(8) > 4
trigger1 = !var(1)
trigger2 = var(18) > 4
flag = NoStandGuard
flag2 = NoCrouchGuard
flag3 = NoAirGuard