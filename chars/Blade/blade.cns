;Vars:
;	0  = superarmour state no.
;	1  = superarmour ticks
;	2  = enemy 1 id
;	3  = enemy 1 guardcrush guage
;	4  = enemy 2 id
;	5  = enemy 2 guardcrush guage
;	6  = guard break strength
;	7  = guard break sound trigger
;	8  = superarmour strength setting
;	9  = superarmour recovery setting
;	10 = gethitvar(damage)
;	11 = guard crush strength setting (not implemented yet)
;	12 = guard crush recovery setting (not implemented yet)
;	13 = current nochainid, and id of most recent hitdef
;	14 = targets hit (from 0 to 2)
;	15 = nochainid mod (for multihit moves)
;	16 = temp(used in states, don't use in -3,-2,-1)
;	17 = custom gameplay setting
;	18 = full resistance setting
;	19 = custom state detector
;	20 = voice timer
;	21 = knockdown timer
;	22 = warzard hitspark setting
;	23 = highjump buffer
;	24 = trance background setting
;	25 = warzard intro setting
;	26 = guard crush fx check
;	27 = hit tracking

;	56 = hitstun counter (long range)
;	57 = (Winane) GameTime var, for pause and custom state check
;	58 = ai action select
;	59 = (Winane) AI

;Fvars:
;	0  = superarmour vel x
;	1  = superarmour vel y
;	2  = temp(used in states, don't use in -3,-2,-1)
;	3  = ai aggressiveness setting



; KFM's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

; これはKFMの定数と状態のファイルです。
; このファイルの中には注釈が散らされているので、CNSを習いたいお方は
; 読んでみたらいいです。

[Data]
;Amount of life to start with
;体力ゲージの初期値
life = 1100
;attack power (more is stronger)
;攻撃ダメージ
attack = 100
;defensive power (more is stronger)
;体力パワー
defence = 110
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 60
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 200
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 59
FloatPersistIndex = 40

[Size]
;Adapted scale large (direct conversion from CPS-3)
	xscale=0.83333333333333333333333333333333
	yscale=1.0714285714285714285714285714286

;Adapted scale small (bit smaller to avoid pixellation)
;	xscale = 0.801           ;Horizontal scaling factor.
;	yscale = 1

;Original scale (no scaling, may appear "squashed")
;	xscale = 1           ;Horizontal scaling factor.
;	yscale = 1           ;Vertical scaling factor.

ground.back = 30     ;Player width (back, ground)
ground.front = 25    ;Player width (front, ground)
air.back = 25        ;Player width (back, air)
air.front = 20       ;Player width (front, air)
height = 100          ;Height of player (for opponent to jump over)
attack.dist = 320    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 1     ;Set to 1 to scale projectiles too
head.pos = 0, -110   ;Approximate position of head
mid.pos = 3, -80    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2      ;Walk forward
walk.back = -2     ;Walk backward
run.fwd  = 7, -4.5    ;Run forward (x, y)
run.back = -5,-4.4 ;Hop backward (x, y)
jump.neu = 0,-10    ;Neutral jumping velocity (x, y)
jump.back = -2.55,0    ;Jump back Speed (x, y)
jump.fwd = 3,0       ;Jump forward Speed (x, y)
runjump.back = -2.55, -15   ;Running jump speeds (opt)
runjump.fwd = 4, -15      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 0      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .6         ;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
; CNS レベル: 基本
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 182

;---------------------------------------------------------------------------

[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0
sprpriority = -1

[State 182, Helper]
type = Helper
trigger1 = time = 0
name = "Blade's Arms"
id = 10182
stateno = 10182

[State 182, RoundNotOver]
type = AssertSpecial
trigger1 = time < 90
flag = roundnotover

[State 182, ChangeAnim]
type = ChangeAnim
trigger1 = animtime = 0
value = 182
elem = 7

[State 182, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 180, 0

[State 182, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

