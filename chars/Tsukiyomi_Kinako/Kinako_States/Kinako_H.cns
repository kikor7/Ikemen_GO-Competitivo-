persistent = 0

[State 1210]
type = HitDef
triggerall = ifelse(enemynear,ID=enemy,ID,var(20)%10<3,var(20)/10%10<3)||enemynear,statetype=L&&ifelse(enemynear,ID=enemy,ID,var(20)/10%10<3,var(20)%10<3)
