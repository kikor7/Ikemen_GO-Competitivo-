givepower = 240,60
pausetime = 14,13
hitsound = s4,3
guardsound = s3,0
guard.slidetime = 13
guard.hittime = 21
guard.ctrltime = 22
fall = 1
yaccel = 0
ground.velocity = -17.5,0
guard.velocity = -7.7
air.velocity = -17.5,0
fall.xvelocity = 0
fall.yvelocity = 0
fall.recover = 0
down.bounce = 1
ground.cornerpush.veloff = 0
p2facing = 1
