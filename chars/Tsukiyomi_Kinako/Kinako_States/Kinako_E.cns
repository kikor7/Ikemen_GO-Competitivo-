hitflag = MAF
guardflag = M
animtype = Hard
ground.type = High
priority = 7,Hit
damage = ifelse(root,fvar(0)>.25,floor(250*root,fvar(0)),62)-62*(numenemy=1)+floor(fvar(11)),floor(root,fvar(10))
