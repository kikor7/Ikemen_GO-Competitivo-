fvar(11) = root,fvar(10)+(.1*floor(2500*root,fvar(0))-floor(250*root,fvar(0)))*(floor(250*root,fvar(0))>.25)
persistent = 0

[State 2010]
type = HitDef
triggerall = ifelse(enemynear,ID=enemy,ID,root,var(20)%10<3,root,var(20)/10%10<3)||enemynear,statetype=L&&ifelse(enemynear,ID=enemy,ID,root,var(20)/10%10<3,root,var(20)%10<3)
triggerall = !movecontact && !movereversed
trigger1 = AnimElemTime(9) >= 0
trigger1 = AnimElemTime(12) < 0
