[Info]
name = "Tsukiyomi Kinako"        ;Name of character
displayname = "TSUKIYOMI Kinako" ;Name of character to display
versiondate = 8,22,2014    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Songfu"         ;Character author name
pal.defaults = 1      ;Default palettes in order of preference

[Files]
movelist = movelist.dat
cmd      = Kinako_States/Kinako.cmd		;Command set
cns      = Kinako_States/Kinako_N.cns		;Constants
st       = Kinako_States/Kinako_N.cns		;States
st1      = Kinako_States/Kinako_H.cns		;Super&Hyper Moves
st2      = Kinako_States/Kinako_A.cns		;-2 state
st3      = Kinako_States/Kinako_E.cns		;Helper
st4      = Kinako_States/BBBR_Helper.cns	;Common Helper
st5      = Kinako_config.txt
stcommon = Kinako_States/Kinako_C.cns		;Common states
sprite   = Media/Kinako.sff			;Sprite
anim     = Media/Kinako.air			;Animation
sound    = Media/Kinako.snd			;Sound
pal1     = Act/Kinako01.act			;Palettes
pal2     = Act/Kinako02.act
pal3     = Act/Kinako03.act
pal4     = Act/Kinako04.act

[Arcade]
intro.storyboard = ;intro.def
ending.storyboard = ;ending.def
