[Statedef -2]

[State -2, KO sound]
type = PlaySnd
trigger1 = !Alive && (var(50) != -9999)
trigger1 = var(50):=-9999
value = 11,50
channel = 11

[State 0, StopSnd]
type = StopSnd
trigger1 = numhelper(4998)
channel = 11
