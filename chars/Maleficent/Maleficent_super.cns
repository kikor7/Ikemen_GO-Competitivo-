;*Fire Control Start
[Statedef 1449]
type    = S
movetype= I
physics = S
juggle  = 8
poweradd= 0
ctrl = 0
velset = 0,0
anim = 1449
sprpriority = 2

[state a]
type = varset
triggerall = time = 0
triggerall = prevstateno != 1450
trigger1 = command = "x"
trigger1 = !var(30)
trigger2 = var(30) && p2bodydist X < 180;
v = 5
value = 0

[state a]
type = varset
triggerall = time = 0
triggerall = prevstateno != 1450
trigger1 = command = "a"
trigger1 = !var(30)
trigger2 = var(30) && p2bodydist X = [90,240]
trigger2 = random = [500,999]
v = 5
value = 1

[state a]
type = varset
triggerall = time = 0
triggerall = prevstateno != 1450
trigger1 = command = "y"
trigger1 = !var(30)
trigger2 = var(30) && p2bodydist X > 180
trigger2 = random = [0,500]
v = 5
value = 2

[state a]
type = varset
triggerall = time = 0
triggerall = prevstateno != 1450
trigger1 = command = "b"
trigger1 = !var(30)
trigger2 = var(30) && p2bodydist X > 240 && random = [500,999]
v = 5
value = 3

[state a]
type = varset
trigger1 = time != 0
trigger1 = command = "x"
v = 5
value = 0

[state a]
type = varset
triggerall = time != 0
trigger1 = command = "a"
trigger1 = !var(30) || var(30) && p2bodydist X > 60
trigger2 = var(30)&&random<160&&p2bodydist X > 60&&var(5)=[0,4]
v = 5
value = 1

[state a]
type = varset
triggerall = time != 0
trigger1 = command = "y"
trigger1 = !var(30) || var(30) && p2bodydist X > 120
trigger2 = var(30)&&random<150&&p2bodydist X > 120&&var(5)=[0,4]
v = 5
value = 2

[state a]
type = varset
triggerall = time != 0
trigger1 = command = "b"
trigger1 = !var(30) || var(30) && p2bodydist X > 180
trigger2 = var(30)&&random<150&&p2bodydist X > 180&&var(5)=[0,4]
v = 5
value = 3

[state a]
type = varset
trigger1 = time = 0
trigger1 = prevstateno != 1450
v = 18
value = 10
[state a]
type = varset
trigger1 = time = 0
trigger1 = prevstateno != 1450
v = 18
value = 6
[state a]
type = varadd
trigger1 = time = 0
trigger1 = prevstateno = 1450
v = 18
value = -1

[state a]
type = varset
trigger1 = prevstateno != 1450
v = 13
value = 0
[state a]
type = varset
trigger1 = prevstateno = 1450
v = 13
value = 1

[state a]
type = varset
trigger1 = time = 0
v = 7
value = 0
[state a]
type = varset
triggerall = time != 0
trigger1 = (command = "x")||(command = "a")||(command = "y")||(command = "b")
trigger2 = var(30)
v = 7
value = 1
[state a]
type = varset
triggerall = var(30) = 1
trigger1 = time != 0
v = 7
value = 1

[State 240, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 1450
ctrl = 1

