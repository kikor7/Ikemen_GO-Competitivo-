[Info]
name = "baki";キャラの名前
displayname = "baki-hanma";表示されるキャラの名前
versiondate = 7,6,2014    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "tokage"         ;キャラの製作者名
pal.defaults = 1,2,3      ;敵としてでるキャラのパレット

; Files for the player
[Files]
