;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, Finish]
type = ScreenBound
trigger1 = StateNo = 5150
value = 0
MoveCamera = 0,0
ignorehitpause = 1

[State -3, Ultimate Dark Meta Knight]
type = PalFX
triggerall = PalNo = 12
trigger1 = (GameTime%60)=0
time = 100
sinadd = 50, 50, 50, 60 ;60, 60, 60, 60 ;50, 50, 50, 60

[State -2, Ultimate Dark Mode Afterimage]
type = Afterimage
triggerall = PalNo = 12
trigger1 = TIME = 0 ;1
trans = add
PalContrast =  250, 250, 250
paladd = 0,255,255 ;213,240,247
palmul = 0, .255, .255
PalBright = 0,0,0
time    =  -1
length  = 30
TimeGap = 1

[State -2, •ƒhƒiƒ‹ƒhUŒ‚—ÍƒAƒbƒv]
type = attackmulset
triggerall = 1
trigger1 = PalNo = 12
value = 999999

[State -2, ]
