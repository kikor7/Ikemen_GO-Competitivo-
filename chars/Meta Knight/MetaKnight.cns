;-[ Get Hit Sounds ]-
[State -2]
type = PlaySnd
triggerall = LoseKO = 0
triggerall = alive && time = 1
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020 || StateNo = 5001 || StateNo = 5011 || StateNo = 5021 ||StateNo = 5002 || StateNo = 5012 || StateNo = 5022
trigger1 = enemynear,hitdefattr = SCA,NA,SA,HA,NP,SP
value = 5000,0 + (random%20)
channel = -1
persistent = 0

[State -2, AssertSpecial]
type = AssertSpecial
triggerall = anim = 2000 || anim = 6320 || anim = 6020 || anim = 4550
trigger1 = win = 1
flag = nobardisplay
flag2 = noBG
flag2 = noFG
flag3 = globalnoshadow

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, GetUp Frustration]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5120 ;Jump land
value = 5120, 0
channel = 1

[State -3, Wing Flap Sound]
type = PlaySnd
triggerall = stateno = 100
trigger1 = animelem = 2
trigger1 = stateno != 0 
value = s45, 0
channel = 0

[state -3, super g] ; super bg
type = RemoveExplod
trigger1 = numexplod(3001) = 1
trigger1 = anim != 2000
value = 3001

;-[ Get Hit Sounds ]-
[State -3, Hit Light]
type = PlaySnd
triggerall = LoseKO = 0
triggerall = random <= 400
trigger1 = time = 1
trigger1 = StateNo = 5000 || StateNo = 5010 || StateNo = 5020
value = 5000,2

[State -3, Hit Medium]
type = PlaySnd
triggerall = LoseKO = 0
triggerall = random <= 500
trigger1 = time = 1
trigger1 = StateNo = 5001 || StateNo = 5011 || StateNo = 5021
value = 5000,4

[State -3, Hit Hard]
type = PlaySnd
triggerall = LoseKO = 0
triggerall = random <= 600
