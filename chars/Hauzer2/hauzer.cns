; Constants and state file.
; Vars:
;	0  = superarmour state no.
;	1  = superarmour ticks
;	2  = enemy 1 id
;	3  = enemy 1 guardcrush guage
;	4  = enemy 2 id
;	5  = enemy 2 guardcrush guage
;	6  = guard break strength
;	7  = guard break sound trigger
;	8  = guard crush fx check
;	9  = armour level
;	10 = gethitvar(damage)

;	11 = temp var
;	12 = temp var

;	13 = l/m/h var

;	14 = id of most recent hitdef
;	15 = highjump buffer
;	16 = custom gameplay on/off
;	17 = guarding on/off
;	18 = hit tracking
;	19 = custom state detection

;	19 = custom state detection
;	22 = warzard hitsparks off/on
;	23 = custom fx off/on

;	25 = hitsound flag
;	26 = movehit/fx sound flag
;	27 = fx element flag
;	28 = previous hitpausetime
;	29 = throw buffer
;	30 = temp var
;	31 = life last frame
;	32 = previous facing

;	43 = juggle flag
;	44 = hyper armour timer
;	45 = previous power

;	53 = hitstun balance

;	57 = (Winane) GameTime var, for pause and custom state check
;	58 = ai action select
;	59 = (Winane) AI

; Fvars:
;	0  = superarmour vel x
;	1  = superarmour vel y
;	2  = superarmour hitvel x
;	3  = temp var
;	4  = temp var
;	5  = math var
;	6  = math var
;	7  = superarmour combined vel x

;	10 = AI aggression setting

;	12 = guard crush strength setting

;       39 = AI guard jump/crouch response

;Channels:
;	1 = voice
;	2 = swing
;	3 = smash
;	4 = fx

; Constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1250			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 110		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 1		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 200			;Volume offset (negative for softer)
IntPersistIndex = 58	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
;Adapted scale large (direct conversion from CPS-3)
	xscale=0.83333333333333333333333333333333
	yscale=1.0714285714285714285714285714286
	head.pos = 50, -139	;Approximate position of head
	mid.pos = 21, -64	;Approximate position of midsection

;Adapted scale small (bit smaller to avoid pixellation)
;	xscale = 0.801           ;Horizontal scaling factor.
;	yscale = 1
;	head.pos = 48, -130	;Approximate position of head
;	mid.pos = 20, -60	;Approximate position of midsection

;Original scale (no scaling, may appear "squashed")
;	xscale = 1           ;Horizontal scaling factor.
;	yscale = 1           ;Vertical scaling factor.
;	head.pos = 60, -130	;Approximate position of head
;	mid.pos = 25, -60	;Approximate position of midsection

ground.back = 56		;Player width (back, ground)
ground.front = 40		;Player width (front, ground)
air.back = 24		;Player width (back, air)
air.front = 24		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 240		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 1		;Set to 1 to scale projectiles too   
shadowoffset = -1		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.5		;Walk forward
walk.back = -2.5		;Walk backward
run.fwd  = 5, 0		;Run forward (x, y)
run.back = -3.333,0	;Hop backward (x, y)
jump.neu = 0,-10.8		;Neutral jumping velocity (x, y)
jump.back = -2.5		;Jump back Speed (x, y)
jump.fwd = 2.5		;Jump forward Speed (x, y)
runjump.back = -3,-10.8;Running jump speeds (opt)
runjump.fwd = 3,-10.8	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .536		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 180, 1]
type = ChangeAnim
triggerall = !time || anim != 20
triggerall = animtime >= 0
trigger1 = anim = [5005, 5007]
trigger2 = anim = [5016, 5017]
value = anim + 600

[State 180, 1]
type = ChangeAnim
triggerall = !time || anim != 20
trigger1 = Anim != 0 && Anim != [5, 6]
trigger1 = anim != 5120
trigger1 = anim != 5125
trigger1 = anim != [5005, 5007]
trigger1 = anim != [5605, 5607]
trigger1 = anim != [5015, 5017]
trigger1 = anim != [5615, 5617]
trigger2 = anim
trigger2 = animtime >= 0
value = 0

[State 180, 1]
type = ChangeAnim
trigger1 = time > 1 ;let enemy start defeat anim before approaching, if they have one
trigger1 = !anim
value = 20

[State 180, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, 2]
type = AssertSpecial
trigger1 = time < 180
flag = RoundNotOver

[State 180, 1]
type = ChangeState
triggerall = time
triggerall = anim = 20
trigger1 = time > 300
trigger2 = enemynear, statetype != L
trigger3 = enemynear, anim != 5110
trigger3 = enemynear, anim != 5140
trigger3 = enemynear, anim != 5150
trigger4 = enemynear, anim = 5140 
trigger4 = enemynear, name = "Geese Howard"
trigger4 = enemynear, authorname = "Phantom.of.the.Server"
trigger5 = enemynear, anim = 5150 
trigger5 = enemynear, name = "Char's Zugock"
trigger5 = enemynear, authorname = "GM"
value = 182

[State 180, 1]
type = ChangeState
triggerall = time
triggerall = anim = 20
trigger1 = (enemynear, pos x - pos x)*facing < 80*const(size.xscale)
value = 181

[State 180, 1]
type = PosAdd
trigger1 = anim = 20
x = const(velocity.walk.fwd.x)

[State 180, step]
type = PlaySnd
triggerall = anim = 20
trigger1 = animelem = 25
trigger2 = !animtime
value = 2, 0
channel = 2

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0
sprpriority = 2

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, ChangeAnim]
type = ChangeAnim
trigger1 = animelem = 10
value = 180
elem = 8

[State 181, 2]
type = AssertSpecial
trigger1 = time < 180
flag = RoundNotOver

[State 181, Explod]
type = Explod
trigger1 = time > 52
trigger1 = (time-52)%36 = 7
anim = 25116
pos = floor(88*const(size.xscale)), floor(-72*const(size.yscale))
sprpriority = 3
bindtime = 1
ownpal = 1
scale = const(size.xscale), const(size.yscale)

[State 181, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = 200, 0
channel = 1

;---------------------------------------------------------------------------
; Win pose 2
; CNS difficulty: basic
[Statedef 182]
type = S
ctrl = 0
anim = 181
velset = 0,0
sprpriority = 0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, ChangeAnim]
type = ChangeAnim
trigger1 = animelem = 11
value = 181
elem = 5

[State 181, 2]
type = AssertSpecial
trigger1 = time < 180
flag = RoundNotOver

[State 181, Explod]
type = Explod
trigger1 = animelem = 6
anim = 25116
pos = floor(-6*const(size.xscale)), floor(-118*const(size.yscale))
sprpriority = 1
bindtime = 1
ownpal = 1
scale = const(size.xscale), const(size.yscale)

[State 181, PlaySnd]
type = PlaySnd
trigger1 = animelem = 4
value = 190, 0
channel = 1

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeState
trigger1 = !time
trigger1 = random%2
value = 191

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, VarAdd]
type = VarAdd
triggerall = var(23)
trigger1 = var(11)
trigger2 = animelem = 3
var(11) = 1

[State 190, Trans]
type = Trans
trigger1 = var(11) = [1, 31]
trans = addalpha
alpha = 0, 255 - var(11)*8

[State 190, Trans]
type = Trans
trigger1 = var(11) = [32, 46]
trans = addalpha
alpha = (var(11) - 31)*16, 0

[State 190, Explod]
type = Explod
trigger1 = animelem = 2
anim = ifelse(var(23), 11190, 10190)
sprpriority = 2
bindtime = 1
ownpal = 1
scale = const(size.xscale), const(size.yscale)

[State 190, Explod]
type = Explod
trigger1 = animelem = 2
anim = ifelse(var(23), 11191, 10191)
sprpriority = -1
bindtime = 1
ownpal = 1
scale = const(size.xscale), const(size.yscale)

[State 190, Explod]
type = Explod
trigger1 = animelem = 2
anim = 10192
sprpriority = 1
bindtime = 1
ownpal = 1
scale = const(size.xscale), const(size.yscale)

[State 190, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
value = 190, 1
channel = 2

[State 190, PlaySnd]
type = PlaySnd
trigger1 = animelem = 7
value = 190, 0
channel = 1

[State 190, Explod]
type = Explod
trigger1 = animelemno(0) = [2, 4]
trigger1 = time%12 = 0
trigger1 = fvar(3) := 0.25 + random*0.0005
anim = 10194
sprpriority = random%2
bindtime = 1
ownpal = 1
scale = const(size.xscale)*fvar(3), const(size.yscale)*fvar(3)
pos = 0, floor(-28*const(size.yscale))
random = floor(96*const(size.xscale)), floor(16*const(size.yscale))
removetime = 100
vel = 0, -6 - random*0.004

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 190, 2]
type = AssertSpecial
triggerall = !var(23)
trigger1 = animelemno(0) < 7
trigger1 = time%4 < 2
flag = Invisible

[Statedef 191]
type = S
ctrl = 0
anim = 191
velset = 0,0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 191

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

[State 191, 2]
type = PosAdd
triggerall = animelemno(0) = [2, 21]
trigger1 = animelemno(0) != 8 
trigger1 = animelemno(0) != 14 
trigger1 = animelemno(0) != 20 
x = 2

[State 191, step]
type = PlaySnd
trigger1 = animelem = 8 
trigger2 = animelem = 14 
trigger3 = animelem = 20 
trigger4 = animelem = 25 
value = 1110, 0
channel = 2

[State 191, 2]
type = PosAdd
trigger1 = animelem = 22
x = 16

[State 191, 2]
type = PosAdd
trigger1 = animelem = 23
x = 8

[State 191, 2]
type = PosAdd
trigger1 = animelem = 24
x = 4

[State 191, Landing Shake]
type = EnvShake
trigger1 = animelem = 8 
trigger2 = animelem = 14 
trigger3 = animelem = 20 
trigger4 = animelem = 25 
time = 9
freq = 50
ampl = 2
phase = 270

[State 191, 1]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0, 0

[State 191, 2]
type = PosAdd
trigger1 = animelem = 2
x = -232

[State 191, PlaySnd]
type = PlaySnd
trigger1 = animelem = 4
trigger2 = animelem = 25
value = 190, 0
channel = 1

[State 191, Explod]
type = Explod
trigger1 = animelem = 27
anim = 25116
pos = floor(88*const(size.xscale)), floor(-72*const(size.yscale))
sprpriority = 1
bindtime = 1
ownpal = 1
scale = const(size.xscale), const(size.yscale)

