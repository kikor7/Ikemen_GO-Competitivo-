;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[StateDef -2]

;==================================================================================
;======| RELACIONADO À AI - AI RELATED |===========================================
;==================================================================================

; Within StateDef -2, none of your own AI-related code should be placed
; above these next two controllers.

[State -2, StopAI]
type = VarSet
triggerall = (var(59) > 0)
trigger1 = (RoundState != 2)
trigger2 = !Alive
var(59) = -2
IgnoreHitPause = 1

; This controller is optional.  It allows you treat the AI flag as a boolean
; value rather than an integer value, letting you trigger your AI directives
; with "var(0)" instead of "var(59)>0", and letting you make moves usable only
; by humans by using "!var(0)" instead of "var(59)<1", thus slightly improving
; the size and efficiency of your code.
; Another benefit is that it makes it much easier for users to disable your AI,
; if they so choose.
;[State -2, Simplifier]
;type = VarSet
;trigger1 = (var(59) = 1)
;trigger2 = (var(0):=0)
;var(0) = 1	; Another option is to replace 1 with something like MatchNo, if
		; you want to design your AI to have varying levels of difficulty.
;IgnoreHitPause = 1

;==================================================================================
;==================================================================================
;==================================================================================


[State -2, Armour]
type = VarAdd
trigger1 = var(1) > 1
trigger2 = movetype != H
trigger2 = var(1) = 1
var(1) = -1

[State -2, Armour]
type = VarSet
trigger1 = !var(1)
var(9) = 0

[State -2, Armour]
type = VarSet
trigger1 = stateno != 9000
fvar(2) = 0

[State -2, Armour]
type = VarSet
trigger1 = stateno != 9000
fvar(7) = 0

[State -2, Disable Armour During Custom States]
type = VarSet
trigger1 = !var(19)
var(0) = -1

[State -2, Defence during custom states]
type = LifeAdd
triggerall = var(44)
triggerall = !var(19) || var(0) = -1
trigger1 = life > 1
trigger1 = life < var(31)
trigger1 = alive
value = (var(31) - life)/2 ;def
ignorehitpause = 1

[State -2, Var Helper]
type = Helper
trigger1 = !numhelper(9999)
id = 9999
stateno = 9999
ignorehitpause = 1
pausemovetime = 99999
supermovetime = 99999
ownpal = 0
postype = left
pos = 0, 128

[State -2, GetHit Sound]
type = StopSnd
triggerall = movetype = H
trigger1 = stateno != 9000
trigger1 = gethitvar(hitshaketime) = 1
trigger1 = !gethitvar(guarded) || stateno > 155
trigger2 = !var(19)
channel = 1
ignorehitpause = 1

[State -2, Custom State Detection]
type = VarSet
trigger1 = 1
var(19) = 0
ignorehitpause = 1

[State -2, Width Scale]
type = Width
trigger1 = statetype != A
player = floor(const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State -2, Width Scale]
type = Width
trigger1 = statetype = A
player = floor(const(size.air.front)*(const(size.xscale) - 1)), floor(const(size.air.back)*(const(size.xscale) - 1))

[State -2, Single Target Guarded]
type = VarAdd
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = numtarget(var(14)) = 1
triggerall = numenemy
triggerall = target(var(14)), gethitvar(guarded)
triggerall = var(6)
trigger1 = target(var(14)), id = var(2)
trigger1 = var(3) != -1
trigger2 = target(var(14)), id = var(4)
trigger2 = var(5) != -1
v = ifelse(target(var(14)), id = var(2), 3, 5)
value = var(6)
ignorehitpause = 1

[State -2, Multiple Targets Guarded]
type = null
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = numtarget(var(14)) > 1
triggerall = numenemy
triggerall = var(6)
;triggerall = target(var(14)), id = var(2) || target(var(14)), id = var(4)
trigger1 = var(3) != -1
trigger1 = enemy(0), gethitvar(guarded)
trigger1 = enemy(0), gethitvar(chainid) = var(14)
trigger1 = enemy(0), gethitvar(hitshaketime)
trigger1 = var(3) := var(3) + var(6)
trigger1 = 0
trigger2 = var(5) != -1
trigger2 = numenemy > 1
trigger2 = enemy(1), gethitvar(guarded)
trigger2 = enemy(1), gethitvar(chainid) = var(14)
trigger2 = enemy(1), gethitvar(hitshaketime)
trigger2 = var(5) := var(5) +  var(6)
trigger2 = 0
ignorehitpause = 1

[State -2, Single Target Guard Break]
type = TargetState
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = var(6)
triggerall = numtarget(var(14)) = 1
triggerall = target(var(14)), alive
triggerall = target(var(14)), gethitvar(guarded)
trigger1 = target(var(14)), id = var(2)
trigger1 = var(3) >= floor(target(var(14)), lifemax*target(var(14)), const(data.defence)*0.01)
trigger1 = var(3) := 0 || 1
trigger1 = var(7) := 1
trigger2 = target(var(14)), id = var(4)
trigger2 = var(5) >= floor(target(var(14)), lifemax*target(var(14)), const(data.defence)*0.01)
trigger2 = var(5) := 0 || 1
trigger2 = var(7) := 1
id = var(14)
value = 5400
ignorehitpause = 1

[State -2, Multiple Target Guard Break]
;Since TargetState can only affect ALL targets, only activates when both enemies meet criteria
;This means if only 1 can be broken, but both are hit at the same time, there will be no guard crush
type = TargetState
triggerall = moveguarded = 1 || projguardedtime(var(14)) = 0
triggerall = var(6)
triggerall = numtarget(var(14)) > 1
triggerall = numenemy > 1
trigger1 = enemy(0), alive
trigger1 = enemy(0), gethitvar(guarded)
trigger1 = enemy(0), gethitvar(chainid) = var(14)
trigger1 = enemy(0), gethitvar(hitshaketime)
trigger1 = enemy(1), alive
trigger1 = enemy(1), gethitvar(guarded) 
trigger1 = enemy(1), gethitvar(chainid) = var(14)
trigger1 = enemy(1), gethitvar(hitshaketime)
trigger1 = var(3) >= floor(enemy(0), lifemax*enemy(0), const(data.defence)*0.01)
trigger1 = var(5) >= floor(enemy(1), lifemax*enemy(0), const(data.defence)*0.01)
trigger1 = var(3) := 0 || 1
trigger1 = var(5) := 0 || 1
trigger1 = var(7) := 2
id = var(14)
value = 5400
ignorehitpause = 1

[State -2, Single Mode Guard Break Spark/Sound]
