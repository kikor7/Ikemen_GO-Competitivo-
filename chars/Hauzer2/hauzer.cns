;---------------------------------------------------------------------------
; Standing Light Punch
; CNS difficulty: easy
[Statedef 200]
type    = S
movetype= A
physics = S
ctrl = 0
sprpriority = 2
movehitpersist = 1

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
trigger1 = var(11) := 0 || 1
trigger1 = var(12) := 0 || 1
value = 200

[State Armour PowerAdd]
type = PowerAdd
trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 40*(var(44) = 0)

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(7)*(prevstateno = 9000)
y = fvar(1)*(prevstateno = 9000)

[State 200, 1]
type = HitDef
triggerall = var(22)
triggerall = !var(43)
trigger1 = !var(18)
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
attr = S, NA
damage = 114, 0
getpower = 30,15
animtype = Up
guardflag = MA
hitflag = MA
pausetime = 13, 13
sparkno = s27002
guard.sparkno = s27006 + 2*(numenemy = 1 && var(8) - var(6) < 1)
sparkxy = ifelse(p2bodydist x < 10, ifelse(p2bodydist x < 0, -30, ceil(p2bodydist x - 30)), -20), floor(-112*const(size.yscale) + p2dist y/2)
hitsound   = s5,2
guardsound = s6,0 + 2*(numenemy = 1 && var(8) - var(6) < 1)
ground.type = Low
ground.velocity = -0.83, -15
ground.hittime  = 16
ground.slidetime  = 16
ground.cornerpush.veloff = 0
guard.velocity = -10
guard.hittime = 15
guard.cornerpush.veloff = -13
guard.kill = 1
;air.hittime = 999
airguard.ctrltime = 999
air.type = Low
air.velocity = -0.83, -13.75
airguard.velocity = -3, -6.43
fall = 1
fall.recover = 0
fall.yvelocity = -4
yaccel = .536

[State 200, 1]
type = HitDef
triggerall = !var(22)
triggerall = !var(43)
trigger1 = !var(18)
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
attr = S, NA
damage = 114, 0
getpower = 30,15
animtype = Up
guardflag = MA
hitflag = MA
pausetime = 13, 13
sparkno = 2
sparkxy = ifelse(p2bodydist x < 10, ifelse(p2bodydist x < 0, -30, ceil(p2bodydist x - 30)), -20), floor(-112*const(size.yscale) + p2dist y/2)
hitsound   = s5,2
guardsound = s6,0 + 2*(numenemy = 1 && var(8) - var(6) < 1)
ground.type = Low
ground.velocity = -0.83, -15
ground.hittime  = 16
ground.slidetime  = 16
ground.cornerpush.veloff = 0
guard.velocity = -10
guard.hittime = 15
guard.cornerpush.veloff = -13
guard.kill = 1
;air.hittime = 999
airguard.ctrltime = 999
air.type = Low
air.velocity = -0.83, -13.75
airguard.velocity = -3, -6.43
fall = 1
fall.recover = 0
fall.yvelocity = -4
yaccel = .536

[State 200, StateTypeSet]
type = StateTypeSet
trigger1 = animelemno(0) > 23
movetype = I
persistent = 0

[State 200, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 200, Width]
type = Width
trigger1 = animelemno(0) = [4, 15]
player = floor(40*const(size.xscale) + const(size.ground.front)*(const(size.xscale) - 1)), floor(const(size.ground.back)*(const(size.xscale) - 1))

[State 200, PlaySnd]
