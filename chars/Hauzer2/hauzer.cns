trigger1 = time = 0
trigger1 = prevstateno != 9000
value = 195

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(7)*(prevstateno = 9000)
y = fvar(1)*(prevstateno = 9000)

[State 195, PlaySnd]
