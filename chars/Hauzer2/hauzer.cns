;---------------------------------------------------------------------------
; Throw - Attempt
; CNS difficulty: medium-advanced
; Description: Throws are not difficult to make, although then can be
;     tedious at times. Throw attempt states have a HitDef of a
;     special format. The key parameters in a throw are p1stateno
;     and p2stateno. If the HitDef successfully connects, then
;     the attacker will change to the state number specified by
;     p1stateno, and the opponent will be change to the state
;     number assigned to p2stateno. The special thing about p2stateno
;     is that the opponent will be temporarily brought into the
;     attacker's state file. In this case, no matter who the
;     opponent is, he will be taken to state 820 of this file (kfm.cns)
;     and remain here until the end of the throw (look at his debug
;     information when he is being thrown; the text changes to yellow
;     to mean that he is in another player's state file).
[Statedef 800]
type    = S
movetype= A
physics = S
ctrl = 0

[State Armour StateNo]
type = VarSet
trigger1 = time = 0
var(0) = StateNo 

[State Armour ChangeAnim]
type = ChangeAnim
trigger1 = time = 0
trigger1 = prevstateno != 9000
trigger1 = var(11) := 0 || 1
trigger1 = var(12) := 0 || 1
value = 800

[State Armour Velset]
type = VelSet
trigger1 = time = 0
x = fvar(7)*(prevstateno = 9000)
y = fvar(1)*(prevstateno = 9000)

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 800, 1]
type = HitDef
getpower = 60,30
trigger1 = animelem = 1
trigger1 = p2bodydist x < 88*const(size.xscale) - const(size.ground.front)*const(size.xscale)
id = 800
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
numhits = 0
sparkno = -1          ;No spark
hitsound = s8,0
sprpriority = 1       ;Draw in front of p2
p1facing = 1
p2facing = 1          ;Force p2 to face player
p1stateno = 810       ;On success, player changes to state 810
p2stateno = 820       ;If hit, p2 changes to state 820 in player's cns
fall = 1              ;Force p2 into falling down
fall.damage = 96
fall.recover = 0
yaccel = .536

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = animelem = 6
value = 200, 0
channel = 1

;---------------------------------------------------------------------------
; Throwing the opponent
; Description: In this state, the player throws the opponent by binding him to
;     various offsets based on his current frame of animation. For
;     example, [State 810, Bind 1] binds the opponent to an offset of
;     28 pixels in front of the player. That puts him around where the hand
;     is at. Is is important to keep the opponent bound using a
;     TargetBind controller at all times, until you let him go. This
;     is especially important if your player has a Clsn2 box that
;     allows him to get hit while throwing someone. Each time a player
;     gets hit, all his bound targets will be set to a fall state. If
;     the opponent is not bound, then he might get stuck in his thrown
;     state when his attacker is knocked out of the throw halfway.
; Notes: There is a TargetLifeAdd controller to decrease the opponent's
;     life, and a TargetState controller to change his state to a
;     falling state when KFM lets go of him.
[Statedef 810]
type    = S
movetype= A
physics = N
velset = 0, 0

[State 810, State End]
type = ChangeState
trigger1 = AnimTime = 0
trigger1 = anim = 810
value = 0
ctrl = 1

[State 810, ChangeAnim]
type = ChangeAnim
trigger1 = anim != 810
trigger2 = !animtime
value = 810

[State 810, Helper]
type = Helper
trigger1 = animelem = 2
name = "screenbounder"
id = 811
stateno = 811
facing = -1

[State 810, VarSet]
type = VarSet
trigger1 = time = 0
var(11) = floor(-150*const(size.yscale)) + 25

[State 810, VarSet]
type = VarSet
trigger1 = time = 0
var(12) = floor(ifelse(facing = 1, target, screenpos x, 320 - target, screenpos x) - target, frontedgebodydist)

[State 810, Bind]
type = TargetBind
trigger1 = AnimElemNo(0) = 1
pos = floor(83*const(size.xscale)), 0

[State 810, Bind]
type = TargetBind
trigger1 = AnimElemNo(0) = 2
pos = floor(50*const(size.xscale)), floor(-105*const(size.yscale))

[State 810, Bind]
type = TargetBind
trigger1 = AnimElemNo(0) = 3
pos = floor(-105*const(size.xscale)), floor(-177*const(size.yscale))

[State 810, Bind]
type = TargetBind
trigger1 = AnimElemNo(0) = 4
pos = floor(-83*const(size.xscale)), floor(-165*const(size.yscale))

[State 810, Bind]
type = TargetBind
trigger1 = AnimElemNo(0) = 5
pos = floor(2*const(size.xscale)), floor(-175*const(size.yscale))

[State 810, Bind]
type = TargetBind
trigger1 = animelem = 6
pos = floor(160*const(size.xscale)), var(11)

[State 810, Turn]
type = Turn
trigger1 = animelem = 3

[State 810, PosAdd]
type = PosAdd
trigger1 = animelem = 6
trigger2 = animelem = 7
trigger3 = animelem = 8
trigger4 = animelem = 9
x = 8*const(size.xscale)

[State 810, TargetState]
type = TargetState
trigger1 = animelem = 6
value = 821

[State 810, Width]
type = Width
trigger1 = animelemno(0) = 2
edge = 0, floor(16*const(size.xscale))

[State 810, Width]
type = Width
trigger1 = animelemno(0) = 3
edge = floor(32*const(size.xscale)), 0

[State 810, Width]
type = Width
trigger1 = animelemno(0) = 4
edge = floor(48*const(size.xscale)), 0

[State 810, Width]
type = Width
trigger1 = animelemno(0) > 4
edge = floor(64*const(size.xscale)), 0

;---------------------------------------------------------------------------
; Screenbound Helper
[Statedef 811]
type    = S				;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I				;Move-type: A-attack, I-idle, H-gethit
physics = N				;Physics: S-stand, C-crouch, A-air
;Commonly-used controllers:
velset = 0,0			;Set velocity (x,y) (Def: no change)
ctrl = 0				;Set ctrl (Def: no change)
anim = 9999				;Change animation (Def: no change)

[State 811, VarAdd]
type = VarAdd
trigger1 = parent, animelemno(0) = [2,3]
fvar(1) = parent,var(11)/13.0

[State 811, VarAdd]
type = varAdd
trigger1 = parent, animelemno(0) = [4,5]
fvar(0) = floor(176*const(size.xscale))/16.0

[State 811, VelSet]
type = VelSet
trigger1 = 1
x = fvar(0) + rootdist x
y = fvar(1) + rootdist y

[State 811, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1, 1

[State 811, Width]
type = Width
trigger1 = 1
edge = parent, var(12) - const(size.ground.front), 0

[State 811, DestroySelf]
type = DestroySelf
trigger1 = root, stateno != 215
trigger1 = root, stateno != 810
trigger2 = root, anim != 215
trigger2 = root, anim != 810
trigger3 = parent, animelemno(-1) > 5

;---------------------------------------------------------------------------
; Opponent Thrown
; (a custom gethit state)
; Description: This is the state that the opponent changes to after being
;     hit by the throw HitDef. The important thing here is to use a
;     ChangeAnim2 controller. The difference between ChangeAnim2 and
;     ChangeAnim is that ChangeAnim2 changes the player's animation to
;     an action in the AIR file of the attacker (in this case, kfm.air),
;     whereas ChangeAnim always changes the player to an action in his
;     own AIR file. Look at Action 820 in kfm.air for some extra
;     comments.
[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

[State 820, 2]
type = SelfState
trigger1 = !gethitvar(isbound)
value = 5050

[State 820, 1]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0, 0

;---------------------------------------------------------------------------
; Opponent thrown into the air
; (a custom gethit state)
; Description: This state has the opponent flying through the air and
;     falling down onto the ground. The SelfState controller sets the
;     opponent back using to his own state file when he his the ground.
;     Controllers 821,2 and 821,3 allow the opponent to recover by
;     hitting his recovery command when he is falling.
[Statedef 821]
type    = A
movetype= H
physics = N
velset = 5, -3.21

[State 821, ChangeAnim]
type = ChangeAnim2
trigger1 = time = 0
value = 821

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
y = .536

[State 821, 4] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 25
value = 5100 ;Hit ground

