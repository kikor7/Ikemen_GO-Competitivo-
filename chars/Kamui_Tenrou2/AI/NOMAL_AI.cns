;---------------------------------------------------------------------------
;立ちパンチ

[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 0
ctrl = 0
;anim = 200
poweradd = 0
sprpriority = 2
facep2 = 1

[State -1]
type = ChangeAnim
triggerall = palno = 12
trigger1 = time = 0
value = 2001

[State -1]
type = ChangeAnim
triggerall = palno = [1,11]
trigger1 = time = 0
value = 200

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 2
value = 0, 4
Channel = 1

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 1
value = 200, 0+random%3
Channel = 0

[State 200, 補正用var];通常攻撃補正
type = varset
trigger1 = fvar(6) = 1.0
trigger1 = movehit = 1
ignorehitpause = 1
fvar(6) = 0.6

