ground.type = High
ground.slidetime = 9
ground.hittime  = 9
guard.hittime  = 9
ground.velocity = -4
airguard.velocity = -4,-4
air.velocity = -2,-4
air.type = High
fall = 0
air.fall = 1
fall.recover = 1
fall.recoverTime = 19
down.bounce = 1
yaccel = 0.35
persistent = 0
ground.cornerpush.veloff = 0
air.cornerpush.veloff = 0
down.cornerpush.veloff = 0
guard.cornerpush.veloff = 0
airguard.cornerpush.veloff = 0
fall.yvelocity = 0

