trigger1 = !Alive
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
;trigger1 = Anim != [5110,5119]
value = 5150

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
trigger1 = Alive
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
;trigger1 = Anim != [5110,5119]
value = 5110

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

