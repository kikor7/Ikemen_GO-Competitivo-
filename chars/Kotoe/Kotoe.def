; Player information
[Info]
name = "Kotoe Kashima"        ;Name of character
displayname = "Kotoe" ;Name of character to display
versiondate = 12,27,2007    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "NS"         ;Character author name
pal.defaults = 1,3,4,2      ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd     = Kotoe.cmd.cns   ;Command set
cns     = Kotoe-P.cns   ;Constants
st      = Kotoe-P.cns   ;States
st1     = Kotoe-N.cns
st2     = Kotoe-S.cns
st3     = Kotoe-H.cns
st4     = Kotoe-2.cns
st5     = Kotoe-AI.cns
stcommon = common1.cns ;Common states
sprite  = Kotoe.sff   ;Sprite
anim    = Kotoe.air   ;Animation
sound   = Kotoe.snd   ;Sound
pal1    = Kotoe-1.act  ;Palettes (can have up to 12)
pal2    = Kotoe-2.act
pal3    = Kotoe-3.act
pal4    = Kotoe-4.act
pal5    = Kotoe-5.act
pal6    = Kotoe-6.act


; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
