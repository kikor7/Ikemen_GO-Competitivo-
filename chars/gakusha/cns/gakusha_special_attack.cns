;===========================================================================
; 必殺技
;===========================================================================

;---------------------------------------------------------------------------
; 天撃
;---------------------------------------------------------------------------
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 1
velset  = 0,0
ctrl    = 0
anim    = 800 + IfElse(var(2) < fvar(25), 2, 0) + IfElse((var(2) <= fvar(13)) || (var(2) <= fvar(14)), 1, 0)
poweradd = 0
hitdefpersist = 1
hitcountpersist = 1
facep2 = 0

[State 800, パウダーエフェクト]
type = Explod
trigger1 = AnimElemTime(2) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14))
anim = IfElse((var(2) <= fvar(13)) && (var(2) > fvar(14)), 16004, 17004)
pos = 0, 0
postype = p1
bindtime = -1
sprpriority = 2
ownpal = 1
scale = const(size.xscale) * 1, const(size.yscale) * 1
ignorehitpause = 0

[State 800, パウダーエフェクト]
type = Explod
trigger1 = AnimElemTime(2) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14))
anim = IfElse(var(2) <= fvar(13), 16005, 17005)
pos = 0, 0
postype = p1
bindtime = -1
sprpriority = 1
ownpal = 1
scale = const(size.xscale) * 1, const(size.yscale) * 1
ignorehitpause = 0

[State 800, クールタイムアイコン表示(1P側)]
type = Explod
trigger1 = Time = 0
trigger1 = var(4) = 1
trigger1 = var(5) = 0
ID = 20000
anim = 20000
pos = ceil(fvar(6) + 75), ceil(fvar(5) + 30)
postype = left
scale = 0.5, 0.5
bindtime = -1
sprpriority = 5
ownpal = 1

[State 800, クールタイムアイコン表示(2P側)]
type = Explod
trigger1 = Time = 0
trigger1 = var(4) = 2
trigger1 = var(5) = 0
ID = 20000
anim = 20000
pos = ceil(-fvar(6) - 59), ceil(fvar(5) + 30)
postype = right
scale = 0.5, 0.5
bindtime = -1
sprpriority = 5
ownpal = 1

[State 800, 速度設定]
type = VelSet
trigger1 = Time = 0
x = 20

[State 800, ボイス再生]
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
channel = 0
value = 1, 3

[State 800, SE]
type = PlaySnd
trigger1 = AnimElemTime(1) = 0
channel = 1
value = 6, 0

[State 800, ボイス再生]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
channel = 0
value = 1, 4

[State 800, SE]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) > fvar(13)) && (var(2) > fvar(14))
channel = 1
value = 6, 1

[State 800, パウダー音]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14))
channel = 1
value = 7, IfElse(var(2) <= fvar(13), 4, 3)

[State 800, エフェクト]
type = Explod
trigger1 = AnimElemTime(3) = 0
anim = 32000
pos = ceil(15 * const(size.xscale)), ceil(0 * const(size.yscale))
postype = p1
facing = 1
ignorehitpause = 0
sprpriority = 3
ownpal = 1
removeongethit = 1
bindtime = -1
scale = const(size.xscale) * 1, const(size.yscale) * 1

[State 800, 幅変更]
type = Width
triggerall = (StateType != A)
trigger1 = (AnimElemTime(2) > 0) && (AnimElemTime(6) < 0)
player = ceil(40 * const(size.xscale)), ceil(0 * const(size.yscale))
edge = ceil(55 * const(size.xscale)), ceil(0 * const(size.yscale))

[State 800, 魔法ダメージ倍率 初期値設定]
type = VarSet
trigger1 = AnimElemTime(3) = 0
fvar(7) = 1

[State 800, 魔法ダメージ倍率計算１ 古代の記憶]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = var(2) <= fvar(10) ;古代の記憶効果時間中の場合
fvar(7) = 0.5

[State 800, 魔法ダメージ倍率計算２ 古代の図書館]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = var(2) <= fvar(11) ;古代の図書館効果時間中の場合
fvar(7) = 0.2

[State 800, 魔法ダメージ倍率計算３ シュルル]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = NumEnemy > 0
trigger1 = NumHelper(27020) > 0
trigger1 = (enemynear(0),ID = Helper(27020),var(38)) || (enemynear(0),ID = Helper(27020),var(39))
fvar(7) = 0.1

[State 800, ダメージ計算 基本ダメージ] 
type = VarSet
trigger1 = AnimElemTime(3) = 0
fvar(2) = 10 ;基本ダメージ

[State 800, ダメージ計算 チリパ加算ダメージ]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) ;チリングパウダー状態の場合
fvar(2) = 10

[State 800, ダメージ計算 デスパ加算ダメージ]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(14)) ;デスパウダー状態の場合
fvar(2) = 12

[State 800, ダメージ計算 倍率加算]
type = VarSet
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14)) ;パウダー状態の場合
fvar(2) = fvar(2) * fvar(7)

[State 800, ダメージ計算 雨デバフつき物理]
type = VarSet
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) > fvar(13)) && (var(2) > fvar(14))
trigger1 = (var(2) < var(26)) || (var(2) < var(27))
fvar(2) = fvar(2) * 1.2

[State 800, ヒット定義]
type = HitDef
trigger1 = AnimElemTime(3) = 0
attr = S, SA
animtype = Up
hitflag = MAFD
damage = ceil(fvar(2)), 0
getpower = 30,15
guardflag = MA
pausetime = 3, ceil(10 * IfElse(var(2) <= fvar(13), 1.3, 1) * IfElse(var(2) <= fvar(14), 1.6, 1))
guard.pausetime = 3,3
sparkno = s(IfElse(Random < 500, 30000, 30010))
guard.sparkno = s(IfElse(Facing = -1, 30021, 30020))
sparkxy = -10, -70
hitsound = s8, IfElse(Random < 400, 0, IfElse(Random < 600, 1, 2))
guardsound = s8, 3
ground.type = High
ground.slidetime = 50
guard.slidetime = 3
ground.hittime = 50
guard.hittime = 3
air.hittime = 50
guard.dist = 250
ground.velocity = -1.5, -16
air.velocity = -2,-16
airguard.velocity = -2, 0
air.juggle = 1
yaccel = 0.6
fall = 1
fall.recovertime = 56
down.velocity = -1, -3

[State 800, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


