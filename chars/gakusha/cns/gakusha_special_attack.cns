trigger3 = (Vel X < 0) && (facing = 1)
trigger3 = (Enemy(0),ScreenPos X + ((90 * Enemy(0),const(size.xscale)) * Enemy(0),facing)) - ScreenPos X > 0
trigger4 = (Vel X > 0) && (facing = 1)
trigger4 = (Enemy(0),ScreenPos X + ((90 * Enemy(0),const(size.xscale)) * Enemy(0),facing)) - ScreenPos X < 0
x = 0

[State 2810, 速度変更]
