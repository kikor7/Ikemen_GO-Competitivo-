;===========================================================================
; 通常攻撃技
;===========================================================================

;---------------------------------------------------------------------------
;通常１
;---------------------------------------------------------------------------
[Statedef 200]
type    = S
movetype= A
physics = S
juggle  = 1
velset = 0,0
ctrl = 0
anim = 200 + IfElse(var(2) < fvar(25), 2, 0) + IfElse((var(2) <= fvar(13)) || (var(2) <= fvar(14)), 1, 0)
poweradd = 0
facep2 = 1
hitdefpersist = 1
hitcountpersist = 1

[State 200, パウダーエフェクト]
type = Explod
trigger1 = AnimElemTime(1) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14))
anim = IfElse(var(2) <= fvar(13), 16000, 17000)
pos = 0, 0
postype = p1
bindtime = -1
sprpriority = 1
ownpal = 1
scale = const(size.xscale) * 1, const(size.yscale) * 1

[State 200, パウダーエフェクト]
type = Explod
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14))
anim = IfElse((var(2) <= fvar(13)) && (var(2) > fvar(14)), 16001, 17001)
pos = 0, 0
postype = p1
bindtime = -1
sprpriority = 2
ownpal = 1
scale = const(size.xscale) * 1, const(size.yscale) * 1
ignorehitpause = 0

[State 200, パウダーエフェクト]
type = Explod
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14))
anim = IfElse(var(2) <= fvar(13), 16002, 17002)
pos = 0, 0
postype = p1
bindtime = -1
sprpriority = 1
ownpal = 1
scale = const(size.xscale) * 1, const(size.yscale) * 1
ignorehitpause = 0

[State 200, パウダー音]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14))
channel = 1
value = 7, IfElse(var(2) <= fvar(13), 4, 3)

[State 200, ボイス再生]
type = PlaySnd
trigger1 = Time = 2
channel = 0
value = 0, IfElse(Random < 400 , 4,IfElse(Random < 600, 2, 3))

[State 200, SE]
type = PlaySnd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) > fvar(13)) && (var(2) > fvar(14))
channel = 1
value = 5, IfElse(Random < 400, 4, IfElse(Random < 600, 5, 6))

[State 200, 幅変更]
type = Width
triggerall = (StateType != A)
trigger1 = (AnimElemTime(1) > 0) && (AnimElemTime(5) < 0)
player = ceil(30 * const(size.xscale)), ceil(0 * const(size.yscale))
edge = ceil(45 * const(size.xscale)), ceil(0 * const(size.yscale))

[State 200, 魔法ダメージ倍率 初期値設定]
type = VarSet
trigger1 = AnimElemTime(3) = 0
fvar(7) = 1

[State 200, 魔法ダメージ倍率計算１ 古代の記憶]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = var(2) <= fvar(10) ;古代の記憶効果時間中の場合
fvar(7) = 0.5

[State 200, 魔法ダメージ倍率計算２ 古代の図書館]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = var(2) <= fvar(11) ;古代の図書館効果時間中の場合
fvar(7) = 0.2

[State 200, 魔法ダメージ倍率計算３ シュルル]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = NumEnemy > 0
trigger1 = NumHelper(27020) > 0
trigger1 = (enemynear(0),ID = Helper(27020),var(38)) || (enemynear(0),ID = Helper(27020),var(39))
fvar(7) = 0.1

[State 200, ダメージ計算 基本ダメージ] 
type = VarSet
trigger1 = AnimElemTime(3) = 0
fvar(2) = 6 ;基本ダメージ

[State 200, ダメージ計算 チリパ加算ダメージ]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) ;チリングパウダー状態の場合
fvar(2) = 6

[State 200, ダメージ計算 デスパ加算ダメージ]
type = VarAdd
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(14)) ;デスパウダー状態の場合
fvar(2) = 7

[State 200, ダメージ計算 倍率加算]
type = VarSet
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) <= fvar(13)) || (var(2) <= fvar(14)) ;パウダー状態の場合
fvar(2) = fvar(2) * fvar(7)

[State 200, ダメージ計算 雨デバフつき物理攻撃]
type = VarSet
trigger1 = AnimElemTime(3) = 0
trigger1 = (var(2) > fvar(13)) && (var(2) > fvar(14))
trigger1 = (var(2) < var(26)) || (var(2) < var(27))
fvar(2) = fvar(2) * 1.2


[State 200, ヒット定義]
type = HitDef
trigger1 = AnimElemTime(3) = 0
attr = S, NA
damage = ceil(fvar(2)), 0
getpower = 30,15
animtype = Light
guardflag = MA
hitflag = MAF
pausetime = 8, ceil(12 * IfElse(var(2) <= fvar(13), 1.3, 1) * IfElse(var(2) <= fvar(14), 1.6, 1))
sparkno = s(IfElse(Random < 500, 30000, 30010))
sparkxy = -10, -76
hitsound = s8, IfElse(Random < 400, 0, IfElse(Random < 600, 1, 2))
guardsound = s8,3
guard.sparkno = s(IfElse(Facing = -1, 30021, 30020))
ground.type = High
ground.slidetime = 5
ground.hittime  = 20
ground.velocity = -4
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -1.4,-3
air.hittime = 20

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1


