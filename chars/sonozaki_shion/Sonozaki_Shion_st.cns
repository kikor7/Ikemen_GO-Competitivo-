; Recuperacion del esquive (X): sin control y golpeable unos frames,
; para que el esquive no se pueda encadenar sin riesgo.
;---------------------------------------------------------------------------
[Statedef 1001]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0+(var(50)!=0)*30000
velset = 0,0

[State 1001, Fin de la recuperacion]
type = ChangeState
trigger1 = Time >= 14
value = 0
ctrl = 1

