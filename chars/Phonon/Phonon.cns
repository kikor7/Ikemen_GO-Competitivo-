[Statedef 8999]
type    = S
movetype= H
physics = N

[State 0, HitFallSet]
type = HitFallSet
trigger1 = !time
value = 0
persistent = 0

[State 0,]
type = Turn
trigger1 = !time
trigger1 = facing * enemynear(0),facing = 1

[State 0, HitVelSet]
type = VelSet
trigger1 = !time
x = -1.6

[State 0, HitVelSet]
type = Velmul
trigger1 = time
x = .95

[State 0, HitVelSet]
type = posset
trigger1 = 1
y = 0

[State 0, HitVelSet]
type = velset
trigger1 = 1
y = 0

[State 8999, Anim]
type = ChangeAnim
triggerall = time=0
trigger1 = selfanimexist(5180)
value = 5180

[State 8999, Anim]
type = ChangeAnim
triggerall = time=0
triggerall = anim!=5180
trigger1 = selfanimexist(5003)
value = 5003

[State 8999, Anim]
type = ChangeAnim
trigger1 = time=0
triggerall = !selfanimexist(5003)
triggerall = !selfanimexist(5180)
value = 5012

[State 0, SelfState]
type = SelfState
trigger1 = !alive
value =5050

[State 8999, State]
type = selfstate
trigger1 = time = 53
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Cancel Stand
[Statedef 6060]
type    = S
physics = N  
ctrl = 1
 
[State 6060, PosSet]
type = PosSet
trigger1 = !time  
y = 0
ignorehitpause = 1

[State 6060]
type = poweradd
;triggerall = var(13) = 0
trigger1 = !time
trigger1 = prevstateno != 3000
trigger1 = prevstateno != 3001
trigger1 = prevstateno != 3050
value = -1000

[State 6060]
type = poweradd
;triggerall = var(13) = 0
trigger1 = !time
trigger1 = prevstateno = 3000 || prevstateno = 3001 || prevstateno = 3050 
value = -500

[State 6060]
type = null;poweradd
triggerall = var(13) = 1
trigger1 = !time
value = -500
 
[State 6060]
type = VelSet
trigger1 = !time
x = 0
y = 0
ignorehitpause = 1

[State 6060, Cancel SFX]
type = PlaySnd
trigger1 = !time
value = 6060, 0

[State 230, 1]
type = stopSnd
trigger1 = Time = 0
channel = 2

[State 1200, 6]
type = removeexplod
trigger1 = time= 0
id = 6621

[State 6060, Effect]
type = PalFX
;triggerall = var(13) = 0
trigger1 = time = 0
trigger1 = prevstateno != 3000
trigger1 = prevstateno != 3001
trigger1 = prevstateno != 3050
time = 5
add = 100,100,100

[State 6060, Effect]
type = PalFX
;triggerall = var(13) = 0
trigger1 = time = 0
trigger1 = prevstateno = 3000 || prevstateno = 3001 || prevstateno = 3050 
time = 5
add = 0,0,250

[State 6060, Effect]
type = null;PalFX
triggerall = var(13) = 1
trigger1 = time = 0
time = 5
add = 250,0,0

[State 6060, Effect]
type = Explod
trigger1 = time = 0
anim = 6113
scale = 1,1
postype = p1
pos = 2,-77
sprpriority = 3
ownpal = 1
removeongethit = 1
pausemovetime = 99999
supermovetime = 99999
ignorehitpause = 1
persistent = 0
bindtime = 1

[State 6060]
type = PosSet
trigger1 = Time = 1
y = 0
 
[State 6060, ChangeAnim]
type = ChangeAnim
trigger1 = pos y < 0
value = 0
ignorehitpause = 1

[State 6060, ChangeAnim]
type = Changestate
trigger1 = command = "holdfwd"
trigger1 = command != "holdup"
trigger1 = command != "holddown"
value = 100
ignorehitpause = 1

[State 6060, ChangeAnim]
type = Changestate
trigger1 = command = "holdback"
trigger1 = command != "holdup"
trigger1 = command != "holddown"
value = 105
ignorehitpause = 1

[State 6060, DestroySelf]
type = ChangeState
trigger1 = time >2
value = 0
ignorehitpause = 1

