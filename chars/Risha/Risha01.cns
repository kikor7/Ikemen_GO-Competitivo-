
;-------------------------------------------------------------------------------

;DodgeF
;---------------------------------------------------------------------------
; Recuperacion tras esquivar/rodar: sin control y golpeable unos frames,
; para que no se pueda encadenar sin riesgo.
;---------------------------------------------------------------------------
[Statedef 1003]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0
velset = 0,0

[State 1003, Fin de la recuperacion]
type = ChangeState
trigger1 = Time >= 12
value = 0
ctrl = 1

[Statedef 700]
type     = S
movetype = I
physics  = S
velset   = 0,0
anim     = 700
ctrl     = 0
velset   = 0,0
sprpriority = -2

[State 700,]
type = Poweradd
triggerall = time = 0
trigger1 = prevstateno = [150,151]
value = -1000

[State 799]
type = NotHitBy
trigger1 = 1
trigger1 = prevstateno = [150,152]
value = SCA
time = 1

[State 0, Pause]
type = Pause
trigger1 = prevstateno = [150,152]
trigger1 = time = 0
time = 5
movetime = 5
ignorehitpause = 1

[State a]
type = EnvColor
triggerall = time = 0
trigger1 = prevstateno = [150,152]
persistent = 0
ignorehitpause = 1
time = 3
value = 255,255,255
under = 2

[State 70]
type = AfterImage
trigger1 = time = 0
time = 18
length = 7
framegap = 3
trans = add1
palcontrast = 120,120,120
PalAdd = 0,0,0
palmul = 1,1,1

[State 0, sd]
type = PlaySnd
trigger1 = AnimElem = 2
value = -1,-1
channel = 4

[State 0, ]
type = notHitBy
trigger1 = AnimElem = 5, <= 0
value = SCA

[State 0, ]
type = VelSet
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(5) <= 0
x = 7.7

[State 0, ]
type = VelSet
trigger1 = AnimElem = 6
x = 0

[State 0, ]
type = PlayerPush
trigger1 = AnimElemTime(1) > 0
value = 0

[State 0, ]
type = ChangeState
trigger1 = AnimTime = 0
value = 1003
ctrl = 0

