trigger1 = 1
value = SCA
time = 1

;------------------------------------------------------------------------------
;-| 挑発 |---------------------------------------------------------------------
:------------------------------------------------------------------------------
[Statedef 160]
type = S
ctrl = 0
anim = 160
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 160, PlaySnd]
type = PlaySND
trigger1 = AnimElem = 3
value = 195, (random%3)
channel = 0

[State 160, CtrlSet]
type = CtrlSet
trigger1 = Time = 40
value = 1

[State 160, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

