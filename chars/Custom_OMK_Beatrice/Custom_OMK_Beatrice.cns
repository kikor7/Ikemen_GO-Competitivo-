;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 180, 1]
type = null;ChangeState
trigger1 = EnemyNear,alive = 0
trigger1 = Time = 0
value = ifelse(P2Dist X > 500, 185, ifelse(random > 500, 181, 182))

[State 180, 1]
type = ChangeState
trigger1 = numenemy
trigger1 = facing*enemy,facing = 1
trigger2 = !numenemy
trigger3 = !NumHelper(9050)
value = ifelse(random > 500, 181, 182)

[State 180, 1]
type = ChangeState
trigger1 = facing*enemy,facing != 1
trigger1 = NumHelper(9050)
value = ifelse(life < 200, 185, 182)

