;---------------------------------------------------------------------------
; Stand
[Statedef 16000]
type = S
physics = S
sprpriority = 0

[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr=SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=16600
ignorehitpause=1


[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 16000 && Anim != 16005)
trigger2 = (Anim = 16005) && AnimTime = 0
value = 16000


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30



;------------------------------

[State 0, Winpose]
type = ChangeState
triggerall = parent, numhelper(182) = 1
trigger1 = 1
value = 16181
ctrl = 0

[State 0, Lose by Time]
type = ChangeState
triggerall = parent, numhelper(172) = 1
trigger1 = 1
value = 16900
ctrl = 0




;-----------------------------------------------------------

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = parent,var(31) <= 0
value = 16700
;------------------------------------------------------------

[State 0, Run] ; correr
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 100
trigger1 = time%50 = 0 &&  random = [200,300]
value = 16100
ctrl = 1

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = time%50 = 0 && random = [200,300]
value = ifelse(random > 500,16200,ifelse(random < 300, 16210, 16220))
ctrl = 1

[State 0, Walk] ; caminar
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 10
trigger1 = time%50 = 0 &&  random = [100,700]
value = ifelse(random >= 650, 16021,16020)
ctrl = 1


[State 0, Salto]
type = ChangeState
;trigger1 = p2movetype = A
trigger1 = time%50 = 0 && random = [200,300]
value = 16040
ctrl = 0

