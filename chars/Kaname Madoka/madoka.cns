;trigger5 = target,authorname="sakuraka"
;trigger5 = target,name="Sailor Jupiter"||target,name="Sailor Mars"||target,name="Sailor Mercury"||target,name="Sailor Venus"
;var(33) = 1
;
;に
;trigger6 = target,authorname="おりりん" 
;trigger6 = target,name="Madoka Kaname"
;この場合はtriggerナンバーは6ですが、追加している場合は任意に変更してください。
;
;stateno 1836内
