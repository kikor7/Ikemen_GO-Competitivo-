Trigger1 = (Enemy(0),Name = "Reisen Udongein Inaba")*((Enemy(0),AuthorName = "mikage_th105")||(Enemy(0),AuthorName = "mikage_th"))*(Enemy(0),fvar(21 + ifelse(Enemynear,AuthorName = "mikage_th",14,0)))
Trigger2 = (Enemy(1),Name = "Reisen Udongein Inaba")*((Enemy(0),AuthorName = "mikage_th105")||(Enemy(0),AuthorName = "mikage_th"))*(Enemy(1),fvar(21 + ifelse(Enemynear,AuthorName = "mikage_th",14,0)))
value = -floor(Enemy(0),fvar(21 + ifelse(Enemynear,AuthorName = "mikage_th",14,0)))*2-floor(Enemy(1),fvar(21 + ifelse(Enemynear,AuthorName = "mikage_th",14,0)))*2
