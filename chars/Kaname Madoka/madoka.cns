;パワーチャージ
;===============================================================
;始動
[Statedef 270]
type = S
ctrl = 0
anim = 270
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 270,0]
type = ChangeState
trigger1 = animtime = 0
value = 271


;チャージ中
[Statedef 271]
type = S
ctrl = 0
anim = 271
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 271,0];チャージ音
type = Playsnd
trigger1 = time = 0
value = 0,22
channel = 1

[State 271,1];パワーチャージ
type = powerAdd
triggerall = timemod = 2,0
;trigger1 = const(data.power) = 3000;ゲージが3000モードの時
trigger1 = power < 3000
value = 20

[State 271,2]
type = explod
trigger1 = time = 0
persistent = 0
id = 275
anim = 275
vel = 0,0
ownpal = 1
pos = ceil(25*const(size.xscale)),ceil(-80*const(size.yscale))
postype = p1
sprpriority = 3
bindtime = 1
supermove = 1
removetime = -1

[State 272,3]
type = RemoveExplod
trigger1 = movetype = H
id = 275

[State 271,4]
type = ChangeState
triggerall = Var(51) = 0
;trigger1 = const(data.power) = 3000;ゲージが3000モードの時
trigger1 = power >= 3000
trigger2 = power < 3000
trigger2 = command != "hold_b"
trigger2 = command != "hold_a"
value = 272
ctrl = 1

