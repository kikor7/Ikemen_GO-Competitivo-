;trigger1 = Time = 5
;trigger1 = authorname="おりりん" 
;trigger1 = name="Madoka Kaname"
;anim = 8000
;sprpriority = -1
;postype = p1
;pos = -13,-45
;facing = 1
;removetime = -1
;bindtime = -1
;ownpal = 1
;scale = const(size.xscale)*1,const(size.yscale)*1
;id = 1815
;
;を入れてください。

