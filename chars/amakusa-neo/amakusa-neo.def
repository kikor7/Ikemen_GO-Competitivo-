
;-----基本情報------------------------------------------------------

[Info]
Name         = "amakusa-neo"    ;キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "Amakusa" ;ゲーム中表示される名前（省略可能）
VersionDate  = 10,18,2005       ;このキャラの最終更新日
MugenVersion = 06,14,2003       ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "y"           ;このキャラの作成者の名前
Pal.Defaults = 5,2,6,3          ;CPUで出てくるキャラカラー

[Files]
movelist = movelist.dat
Cmd      = amakusa-neo.cmd    
Cns      = amakusa-neo.cns         ;基本ステータス情報を含むファイルの登録
St       = amakusa-neo.cns         ;動作プログラムファイルの登録 ※1
St0      = amakusa-neo-N.cns       ;最大１０個くらい増やせます
St1      = amakusa-neo-2,-3.cns       ;（St,St0,St1......St9）
St2      = amakusa-neo-tama.cns       ; ※1 … Cnsはステートが記述されていても無視します。
St3      = amakusa-neo-H.cns       ;　　　　Stに同じNAOK.cnsが書かれているのはそのためです。
St4      = amakusa-neo-S.cns
;St8      = NAOK-2-3.cns     ;St9は予備に残しておいた（ここを必要とした前例もあるため）
StCommon = common1.cns      ;コモン動作プログラムファイルの登録
Sprite   = amakusa-neo.sff  
Anim     = amakusa-neo.air      
Sound    = amakusa-neo.snd  

;---カラーパレットファイルの設定（最大１２個まで可能）---

Pal1 = 002.act        ;Ａボタンで決定した色が使えます
Pal2 = 005.act        ;Ｂボタンで決定
Pal3 = 006.act        ;Ｃボタンで決定
Pal4 = 001.act       ;Ｘボタンで決定
Pal5 = 003.act       ;Ｙボタンで決定
Pal6 = 004.act       ;Ｚボタンで決定

;※ここから設定する下のカラーを選ぶ時は、キャラクターセレクト時に
;スタートボタン（Ｓボタン）を押しながら各攻撃ボタンで決定すれば使えます。

Pal7 = 007.act         ;Ｓ押しながらＡボタンで決定した色が使えます
Pal8 = 007.act         ;Ｓ押しながらＢボタンで決定
Pal9 = 008.act         ;Ｓ押しながらＣボタンで決定
Pal10= 007.act         ;Ｓ押しながらＸボタンで決定
Pal11= 007.act         ;Ｓ押しながらＹボタンで決定
Pal12= 009.act         ;Ｓ押しながらＺボタンで決定


;[Arcade]
;Intro.Storyboard  = Option/intro.def
;Ending.Storyboard = Option/ending.def
