;【通常技のステート】
;
;200	 弱パンチ・立ち/弱キックA・立ち
;201	 中パンチ・立ち/中キックA・立ち
;202	 強パンチ・立ち/強キックA・立ち
;
;250	 弱キック・立ち/弱キックB・立ち
;251	 中キック・立ち/中キックB・立ち
;252	 強キック・立ち/強キックB・立ち
;
;300	 弱パンチ・屈み/弱キック・屈み
;301	 中パンチ・屈み/中キック・屈み
;302	 強パンチ・屈み/強キック・屈み
;
;350	 スライドキック
;
;400	 弱パンチ・空中/弱キックA・空中
;401	 中パンチ・空中/中キックA・空中
;402	 強パンチ・空中/強キックA・空中
;
;450	 弱キック・空中/弱キックB・空中
;451	 中キック・空中/中キックB・空中
;452	 強キック・空中/強キックB・空中
;
;500	 ダッシュパンチ/ダッシュキックA
;501	 ダッシュパンチアーマー①/ダッシュキックAアーマー
;502	 ダッシュパンチアーマー②
;
;550	 ダッシュキック/ダッシュキックB
;551	 ダッシュキックアーマー/ダッシュキックBアーマー
;
;800	 投げ
;801	 投げ成功
:802	 投げられ
;803	 壁跳ね返り
;==========================================================================
;==========================================================================
;==========================================================================
;弱パンチ・立ち/弱キックA・立ち
[Statedef 200]
type = S
movetype = A
physics = S
juggle = 1
velset = 0,0
ctrl = 0
poweradd = 0

[State 200, チェーンコンボ用var50]
type = VarSet
trigger1 = !var(59) && (Time = 0)
var(50) = 0
IgnoreHitPause = 1

[State 200, アニメ]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((Facing = 1),200,203)+ifelse((var(0) < 0),7000,0)

[State 200, ダメージ]
type = HitDef
trigger1 = (var(55) < 30) && (Animelem = 2)
attr = S,NA
hitflag = MAF
guardflag = MA
guard.dist = 80
animtype = Light
ground.type = High
air.type = Low
priority = 2,Dodge
damage = ceil(20*fvar(38)-0.4),0
getpower = ceil(20*fvar(38)-0.4),0
givepower = ceil(20*fvar(38)-0.4),ceil(10*fvar(38)-0.4)
sparkno = Sifelse((var(0) < 0),6001,6000)
sparkxy = -ifelse((var(0) < 0),10,20),-ifelse((var(0) < 0),30,50)
hitsound = S100,1
guardsound = F6,0
pausetime = 8,ifelse((var(51) = 1),11,9)
ground.slidetime = 2
ground.hittime = ifelse((var(51) = 1),12,10)
guard.hittime = ifelse((var(51) = 1),11,9)
guard.ctrltime = ifelse((var(51) = 1),11,9)
air.hittime = ifelse((var(51) = 1),12,10)
ground.velocity = -2
air.velocity = -1,-0.5
ID = ifelse((var(0) < 0),7200,200)
guard.kill = 0

[State 200, 効果音]
type = PlaySnd
trigger1 = Time = 0
value = S100,0

[State 200, 立ちへ]
type = SelfState
trigger1 = Animtime = 0
value = 0
ctrl = 1

