movetype= H
physics = N
velset = -8.5,-7

[State 206, 相手のアニメ変更]
type = nothitby
trigger1 = 1
value = SCA

[State 207, 速度加算];重力
type = gravity
trigger1 = 1

[State 207, スクロール]
type = ScreenBound
triggerall = Pos y < -15
trigger1 = BackEdgeBodyDist < 5
trigger2 = FrontEdgeBodyDist < 5
value = 1         ;画面スクロールの影響を受けるか否か。0=受けない・1=受ける
movecamera = 0,1  ;カメラの動きをキャラに依存させるか否か。0=させない・1=させる（Ｘ軸,Ｙ軸）

[State 207, ステート変更];壁に激突するステートへ
type = ChangeState
triggerall = Pos y < -15
trigger1 = BackEdgeBodyDist <= 5
trigger2 = FrontEdgeBodyDist <= 5
value = 208

[State 207, 相手ステートに戻す]
type = SelfState
trigger1 = (Vel y > 0) && (Pos y >= 0)
value = 5100


