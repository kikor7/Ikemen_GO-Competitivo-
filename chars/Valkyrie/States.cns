trigger1 = 1
value = SCA
time = 1

[State 170, Anim]
type = ChangeAnim
trigger1 = Time <= 0
trigger1 = Anim != 170
value = 170

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 0, VarRandom]
type = VarRandom
trigger1 = 1
v = 0
range = 0,1

[State 0, VarSet]; Win Pose Indicator. 0 when fighting herself, 1 when other player
type = VarSet
trigger1 = Enemy,name = "Lenneth Valkyrie"&& Enemy,authorname = "Bluecross"
v = 11
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = !Enemy,name = "Lenneth Valkyrie"
v = 11
value = 1

[State 180, 1]
type = ChangeState
triggerall = var(0) = 0
triggerall = var(11) = 0
trigger1 = Time = 150
value = 181

[State 180, 1]
type = ChangeState
triggerall = var(11) = 0
triggerall = var(0) = 1
trigger1 = Time = 150
value = 182

[State 180, 1]
type = ChangeState
triggerall = var(11) = 1
triggerall = var(0) = 0
trigger1 = Time = 0
value = 181

[State 180, 1]
type = ChangeState
triggerall = var(11) = 1
triggerall = var(0) = 1
trigger1 = Time = 0
value = 182
