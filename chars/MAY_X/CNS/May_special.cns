type    = S
movetype= A
physics = N
velset = 0,0
anim = 1010
poweradd = 0

[State 3000, 0]
type = NotHitBy
trigger1 = time >= 0
value = SCA
time = 1

[State 810, Grab Sound] ;相手をつかんだ音
type = PlaySnd
trigger1 = AnimElem = 2
value = 170, 0

[State 1000, 0];声
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,2

[State 1000, 1] 
type = PlaySnd
trigger1 = Var(1) = 0
trigger1 = animelem = 2
value = 1000, 0

[State 1000, 1] 
type = PlaySnd
trigger1 = Var(1) = 1
trigger1 = animelem = 2
value = 1000, 1

[State 1000, 1] 
type = PlaySnd
trigger1 = Var(1) = 2
trigger1 = animelem = 2
value = 1000, 2

[State 810, Bind 1] ;相手を自分から一定距離に固定
type = TargetBind
trigger1 = AnimElemTime(2) < 0
pos = 17, 0

[State 810, Width 2-11] ;画面端から押し返される幅を変更する
type = Width
trigger1 = AnimElemTime(1) >= 0 && AnimElemTime(3) < 0
edge = 45,0

[State 810, Bind 2-4] ;相手を自分から一定距離に固定
type = TargetBind
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
pos = 17, 0

[State 810, Throw 11] ;相手のstateを変更（自分のstate）
type = TargetState
trigger1 = AnimElem = 3
value = 1021

[State 810, State End] ;終了
type = ChangeState
trigger1 = AnimTime = 0
value = 1011
ctrl = 0

