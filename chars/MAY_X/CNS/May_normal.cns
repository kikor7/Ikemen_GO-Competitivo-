getpower = 60,30
Trigger1 = animelem = 1
attr = S, NT						;立ち通常投げ
hitflag = M-						;hit中の相手には当たらず空中の相手にも当たらない
priority = 1, Miss					;優先度最低で相打ちになった場合攻撃は当たらない
sparkno = -1						;hitスパークを表示しない
sprpriority = 1 					;hitした場合自分を手前に表示
p1facing = ifelse (command = "holdback", -1, 1)	
							;押されていない場合自分の向きを反転させる
p2facing = 1						;hitした場合相手を自分の向きと逆方向を必ず向くようにする
p1stateno = 810					;hitした場合自分をstate810へ
p2stateno = 820					;hitした場合相手を「自分」のstate820へ
guard.dist = 0					;相手がガードモーションにならないようにする
fall = 1						;相手をふっとび状態にする

[State 800, 2] ;終了
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;投げが当たった場合（自分）
[Statedef 810]
type    = S
movetype= A
physics = N
anim = 810
poweradd = 0

[State 810, Grab Sound] ;相手をつかんだ音
type = PlaySnd
trigger1 = AnimElem = 2
value = 170, 0

[State 810, Throw Sound] ;投げる音
type = PlaySnd
trigger1 = AnimElem = 3
value = 0, 6

[State 1000, 0];声
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,2

[State 1000, 1] 
type = PlaySnd
trigger1 = Var(1) = 0
trigger1 = animelem = 3
value = 800, 0

[State 1000, 1] 
type = PlaySnd
trigger1 = Var(1) = 1
trigger1 = animelem = 3
value = 800, 1

[State 1000, 1] 
type = PlaySnd
trigger1 = Var(1) = 2
trigger1 = animelem = 3
value = 800, 2

[State 810, Bind 1] ;相手を自分から一定距離に固定
type = TargetBind
trigger1 = AnimElemTime(2) < 0
pos = 17, 0

[State 810, Width 2-11] ;画面端から押し返される幅を変更する
type = Width
trigger1 = AnimElemTime(1) >= 0 && AnimElemTime(3) < 0
edge = 45,0

[State 810, Bind 2-4] ;相手を自分から一定距離に固定
type = TargetBind
trigger1 = AnimElemTime(2) >= 0 && AnimElemTime(3) < 0
pos = 27, 0

[State 200, 1]
type = varrandom
trigger1 = StateNo = 810
v = 6
range = -78,-69

[State 810, Hurt 11] ;相手のlifeを減らす
type = TargetLifeAdd
trigger1 = AnimElem = 3
value = var(6)

[State 810, Throw 11] ;相手のstateを変更（自分のstate）
type = TargetState
trigger1 = AnimElem = 3
value = 821

[State 810, State End] ;終了
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;投げられている相手（つかまれている状態）
[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1] ;自分の設定したアニメに変更
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

;※このstateには終了命令は無いが
;　自分がTargetStateを使い強引に相手を次のstateへ飛ばしているので問題はない

;---------------------------------------------------------------------------
;投げられている相手（空中へ投げられた状態）
[Statedef 821]
type    = A
movetype= H
physics = N
velset = 0,0

[State 821, 1] 
type = Velset
Trigger1 = time = 0
x = 3.3
y = -12.5

[State 821, 1] ;重力
type = VelAdd
Trigger1 = time >= 0
y = .52

[State 852 , 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(5070)
value = 5070

[State 821, 1] 
type = turn
Trigger1 = time = 0
trigger1 = !SelfAnimExist(5070)

[State 852 , 1]
type = ChangeAnim
trigger1 = time = 0
trigger1 = !SelfAnimExist(5070)
value = 5030

[State 852 , 1]
type = ChangeAnim
trigger1 = time = 10
trigger1 = !SelfAnimExist(5070)
value = 5050

[State 821, 2] 
type = SelfState
trigger1 = time >= 10
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground


