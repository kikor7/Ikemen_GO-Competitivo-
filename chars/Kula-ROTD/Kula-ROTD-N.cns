;==============================================================================
;-| 通常動作 |-----------------------------------------------------------------
;==============================================================================

;var(6)  = 追加コマンド入力判定
;var(7)  = コンビネーション ヒット判定
;var(8)  = イントロ分岐判定
;var(9)  = ジャンプ関連 
;var(24) = 壁激突音関連

;------------------------------------------------------------------------------
;-| クーラ・ダッシュ |---------------------------------------------------------
:------------------------------------------------------------------------------
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
sprpriority = 1

[State 100, VelSet]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 10,0
channel = 4
loop = 1

[State 100, ChangeState]
type = ChangeState
trigger1 = command = "holdfwd" && command = "holdup"
value = 40

[State 100, ChangeState]
type = ChangeState
trigger1 = command != "holdfwd" 
value = 101

;======================================
;ダッシュ・停止
[Statedef 101]
type = S
movetype = I
physics = S
anim = 101
ctrl = 0

[State 101, VelSet]
type = VelSet
trigger1 = animelem = 1
x = 5.5

[State 101, VelSet]
type = VelSet
trigger1 = animelem = 2
x = 0

[State 101, VelMul]
type = VelMul
trigger1 = Animelem = 1,>= 0
x = .90

[State 101,End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;------------------------------------------------------------------------------
;-| クーラ・バックステップ |---------------------------------------------------
:------------------------------------------------------------------------------
[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1

[State 105, PlaySnd]
type = PlaySnd
trigger1 = Time= 0
value = 1, 1

[State 105, PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5
value = 0, 1

[State 105, VelSet]
type = VelSet
trigger1 = animelem = 2
x = -6

[State 105, VelSet]
type = VelSet
trigger1 = animelem = 5
x = 0

[State 105, VelMul]
type = VelMul
trigger1 = Animelem = 3,>= 0
x = .95

[State 105, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 1
StateType = A

[State 105, StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 5
StateType = S

[State 105, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 105, AssertSpecial]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 105, ChangeState]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

