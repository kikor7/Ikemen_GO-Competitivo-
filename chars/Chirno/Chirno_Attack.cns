;--------------------------------------------------------------------------------
;A
;--------------------------------------------------------------------------------
[Statedef 200]
Type    = S
Movetype= A
Physics = S
Anim = 200
Ctrl = 0

[State 200]
type = varset
trigger1 = time = 0
trigger1 = var(10) := 0 || 1
var(11) = 0
ignorehitpause = 1

[State 200]
type = varset
trigger1 = MoveHit
fvar(1) = 0.98 * fvar(1)
ignorehitpause = 1
persistent = 0

[State 200]
type = Playsnd
trigger1 = AnimElem = 4
value = S0, 0
ignorehitpause = 1
persistent = 0

[State 200]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 200]
type		= HitDef
triggerall 	= var(12) = 1
trigger1	= AnimElem = 4
attr		= S, NA
hitflag		= MAF
guardflag	= M
damage		= ceil(fvar(0)*20)
animtype	= Light
air.animtype	= Back
ground.type	= High
priority	= 4, Hit
pausetime	= 10, 10
fall		= 0		;1だと自動立ち直りなし
fall.recover	= 1		;0だと受身不可能
fall.recovertime= ceil(fvar(1)*15) + 9
air.fall	= 1		;1だと自動立ち直りなし
getpower = 30,15
givepower	= 20, 0
yaccel		= 0.4
ground.slidetime	= 10
ground.hittime		= 10
guard.hittime 		= 9
air.hittime 		= 10
guard.ctrltime 		= 9
airguard.ctrltime 	= 19
ground.velocity		= -3, 0
guard.velocity		= -3
air.velocity		= -3,-5
airguard.velocity	= -3,-5
ground.cornerpush.veloff= -5
air.cornerpush.veloff	= -5
down.cornerpush.veloff	= -5
guard.cornerpush.veloff = -5
airguard.cornerpush.veloff = -5
sparkno		= S4000
guard.sparkno	= S4950
sparkxy		= -30+random%20,-55+random%20
hitsound	= S1, 0
guardsound	= S5, 0

