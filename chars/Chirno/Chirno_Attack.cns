[State 220]
type = varset
trigger1 = time = 0
trigger1 = var(10) := 0 || 1
var(11) = 0
ignorehitpause = 1

[State 220]
type = varset
trigger1 = MoveHit
fvar(1) = 0.96 * fvar(1)
ignorehitpause = 1

[State 220]
type = Playsnd
trigger1 = AnimElem = 6
value = S6, 0
ignorehitpause = 1
persistent = 0

[State 220]
type = Helper
trigger1 = AnimElem = 6
name = "ice"
ID = 225
postype = p1
pos = 50,-54
Stateno = 225
size.xscale = 1
size.yscale = 1
ownpal = 1
pausemovetime = 0
supermovetime = 0
ignorehitpause = 1
persistent = 0

[State 220]
type = Helper
trigger1 = var(0) = 1
trigger1 = var(10) = 1 && NumTarget > 0
trigger1 = (Target,IsHelper = 0) && (Target,Stateno != [120, 155])
name = "Effect"
ID = 4060
postype = p1
pos = 32, 0
Stateno = 4060
size.xscale = 1
size.yscale = 1
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 220]
type = varset
trigger1 = 1
var(0) = var(4)
ignorehitpause = 1

[State 220]
type = varset
trigger1 = time = 0
var(1) = 0

[State 220]
type = MoveHitReset
trigger1 = MoveContact || MoveReversed
trigger1 = var(1) := var(1) + 1 || 1
ignorehitpause = 1

[State 220]
type = StateTypeSet
trigger1 = AnimElem = 5
Physics = N

[State 220]
type = velset
trigger1 = AnimElem = 5
X = 3.75

[State 220]
type = veladd
trigger1 = AnimElemTime(6) >= 0
trigger1 = AnimElemTime(11) < 0
X = -0.25

[State 220]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State 220]
type		= HitDef
triggerall 	= var(12) = 1
triggerall	= var(1) < 3
trigger1	= AnimElem = 6 || AnimElem = 7
trigger2	= AnimElem = 8 || AnimElem = 9
attr		= S, NA
hitflag		= MAF
guardflag	= H
damage		= ceil(fvar(0)*25*(1+0.33*var(4)))
animtype	= Medium
air.animtype	= Back
ground.type	= High
priority	= 4, Hit
pausetime	= 10, 10
fall		= 0		;1だと自動立ち直りなし
fall.recover	= 1		;0だと受身不可能
fall.recovertime= ceil(fvar(1)*25*(1+0.5*var(4))) + 9
air.fall	= 1		;1だと自動立ち直りなし
getpower = 30,15
givepower	= 20, 0
yaccel		= 0.4
ground.slidetime	= 17+7*var(4)
ground.hittime		= 17+7*var(4)
guard.hittime 		= 15
air.hittime 		= 17+7*var(4)
guard.ctrltime 		= 15
airguard.ctrltime 	= 19
ground.velocity		= -3, 0
guard.velocity		= -3
air.velocity		= -3,-6
airguard.velocity	= -3,-6
ground.cornerpush.veloff= -5.5
air.cornerpush.veloff	= -5.5
down.cornerpush.veloff	= -5.5
guard.cornerpush.veloff = -5.5
airguard.cornerpush.veloff = -5.5
sparkno		= S4010
guard.sparkno	= S4950
sparkxy		= -30+random%20,-60+random%20
hitsound	= S1, 1+3*var(4)
guardsound	= S5, 0

