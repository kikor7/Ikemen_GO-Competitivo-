[Statedef 225]
Type    = A
Movetype= I
Physics = N
Anim = 8120
Ctrl = 0
Sprpriority = 5

[State 225]
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State 225]
type = AngleDraw
trigger1 = 1
scale = 0.25*(1+ceil(time%4<2)), 0.25*(1+ceil(time%4<2))
ignorehitpause = 1

[State 225]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256, 256
ignorehitpause = 1

[State 225]
type = BindtoRoot
trigger1 = 1
pos = 50,-54
ignorehitpause = 1

[State 225]
type = Explod
trigger1 = time >= 1
trigger1 = time%4 = 0
anim = 8110 + ceil(Random%3)
ID = 8110
pos = 0, 0
postype = p1
bindtime = 1
removetime = -2
ontop = 1
sprpriority = 5
pausemovetime = 0
supermovetime = 0
scale = 0.4, 0.4
vel = -1.5+0.15*(Random%21), 1+0.1*(Random%10)
accel = 0, 0.05
ignorehitpause = 1

[State 225]
type = Explod
trigger1 = time = 1 || time = 2
trigger2 = time = 3 || time = 4
anim = 8130
ID = 8130
pos = 0, 0
postype = p1
bindtime = 1
removetime = -2
ontop = 1
sprpriority = 5
pausemovetime = 0
supermovetime = 0
scale = 0.2, 0.2
vel = 2*cos((115-15*time)*Pi/180),-4*sin((115-15*time)*Pi/180)
accel = 0, 0.25
ignorehitpause = 1

[State 225]
type = Explod
trigger1 = time = 1 || time = 2
trigger2 = time = 3 || time = 4
anim = 8130
ID = 8130
pos = 0, 0
postype = p1
bindtime = 1
removetime = -2
ontop = 1
sprpriority = 5
pausemovetime = 0
supermovetime = 0
scale = 0.2, 0.2
vel = -2*cos((115-15*time)*Pi/180),-4*sin((115-15*time)*Pi/180)
accel = 0, 0.25
ignorehitpause = 1

[State 225]
type = DestroySelf
trigger1 = root,Anim != 220 && root,Anim != 240
ignorehitpause = 1

