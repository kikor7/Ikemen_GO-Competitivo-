; Player information
[Info]
name = "CINNAMON"        ;Name of character
displayname = "CINNAMON" ;Name of character to display
versiondate = 03,06,2007    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "KomoD"         ;Character author name
pal.defaults = 1     ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd     = cinnamon.cmd   ;Command set
cns     = cinnamon.cns   ;Constants
st      = cinnamon.cns   ;States
st1      = cinnamonsummon.cns   
stcommon = common1.cns ;Common states
sprite  = cinnamon.sff   ;Sprite
anim    = cinnamon.air   ;Animation
sound   = cinnamon.snd   ;Sound
pal1    = cinnamon.act  ;Palettes (can have up to 12)
pal2    = cinnamon2.act
pal3    = cinnamon3.act
pal4    = cinnamon4.act
pal5    = cinnamon5.act
pal6    = cinnamon6.act


; Arcade mode
[Arcade]
ending.storyboard = Ending.def


