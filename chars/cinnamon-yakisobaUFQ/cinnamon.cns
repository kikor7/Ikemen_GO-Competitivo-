type = ChangeState
value = 700
triggerall = stateno = 101
Triggerall = Var(59) = 1 ;ここからAI条件
triggerall = pos Y <= -30
triggerall = statetype = A
triggerall = p2statetype = S || p2statetype = A
triggerall = movetype = I
triggerall = p2movetype = I
trigger1 = p2bodydist X >= 50
trigger1 = p2bodydist X <= 100;ここまで条件
trigger1 = ctrl

;AI空中ヘッドアタック（追い討ち）
[State -3, Head2]
type = ChangeState
value = 710
triggerall = stateno = 610 || stateno = 640
triggerall = movehit
triggerall = var(52) = 1
Triggerall = Var(59) = 1
trigger1 = statetype = A


