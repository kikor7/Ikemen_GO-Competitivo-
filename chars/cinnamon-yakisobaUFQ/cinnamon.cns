;使用変数
;var(5)←ジャンプ回数
;var(6)←敗退時キティのセリフに使用
;var(51)←テレビの表示ランダム、「カップのなか」の当たり外れ
;var(52)←空中の追い討ちが蹴り上げてからでないと発動しないようにする
;var(58)←２回目の勝利でシナモンフレンズが落ちてくるようにする変数
;var(59)←AIスイッチ
;そんだけ。変数を59フルに使い切れる奴が凄い…。


[Data]
;Amount of life to start with
;体力ゲージの初期値
life = 1100
;attack power (more is stronger)
;攻撃ダメージ
attack = 130
;defensive power (more is stronger)
;体力パワー
defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 0
;Time which player lies down for, before getting up
liedown.time = 60
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 255

IntPersistIndex = 58
FloatPersistIndex = 40

[Size]
xscale = 1.5           ;Horizontal scaling factor.
yscale = 1.5           ;Vertical scaling factor.
ground.back = 18     ;Player width (back, ground)
ground.front = 13    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 50          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -50   ;Approximate position of head
mid.pos = -5, -25    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd     = 3.4         ;前進歩行速度
walk.back    = -3.4        ;後退歩行速度
run.fwd      = 10, 8      ;前に走る時の速度（Ｘ軸,Ｙ軸）
run.back     = -8.8, -3.5   ;後ろに走る時の速度（Ｘ軸,Ｙ軸）
jump.neu = 0,-9.0   ;-8.4    ;Neutral jumping velocity (x, y)
jump.back = -3.4     ;Jump back Speed (x, y)
jump.fwd = 3.4        ;Jump forward Speed (x, y)
runjump.back = -6, -3  ;後ろに走りながらのジャンプ速度（オプション）
runjump.fwd  = 10, -3      ;前に走りながらのジャンプ速度（オプション）
airjump.neu = 0,-8.2       ;-8.1      ;.
airjump.back = -3.4       ;空中後ジャンプ速度（オプション）
airjump.fwd  = 3.4         ;空中前ジャンプ速度（オプション）

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .44         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching


