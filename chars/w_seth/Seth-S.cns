;Houkou no Segment A
[Statedef 1000]
type     = S
movetype = A
physics  = N
juggle   = 0
poweradd = 0
ctrl     = 0
anim     = 1000
facep2 = 1

[State 0]
type = playsnd
trigger1 = animelem = 1
value = 50,random%5
channel = 0

[State 5100, 6] ;Reduce speed
type = VelMul
triggerall = vel x != 0
trigger1 = 1
x = 0.85
[State 0]
type = velset
triggerall = prevstateno = 20
trigger1 = time = 0
x = 0

[state 0]
