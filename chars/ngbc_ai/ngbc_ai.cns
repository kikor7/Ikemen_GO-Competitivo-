; NGBC - Kisarah Westfield CNS

;----------------------------------------------------------
;       Índice de Variáveis (Player)
;----------------------------------------------------------
; var(1) = winstate decider
; var(2) = Special Attacks Strenght
; var(3) = Baseball Stars Refflect Properties
; var(4) = Baseball Stars 2 Controller
; var(5) = 2020 Super Catch Controller
; var(6) = Balloon Time Controller
; var(7) = Power! Unit! Controller
; var(8) = ASO II - Last Guardian Controller
;----------------------------------------------------------
;       Índice de Variáveis (Helper)
;----------------------------------------------------------
; var(1) =
; var(2) = Joy Joy Block Velocity
; var(3) = Joy Joy Block Animations
; var(4) = Joy Joy Balloon Animations
; var(5) = Joy Joy Balloon Animations

 
[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 255
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           
yscale = 1           
ground.back = 15     
ground.front = 16    
air.back = 12        
air.front = 12       
height = 60      
attack.dist = 160    
proj.attack.dist = 90 
proj.doscale = 0     
head.pos = -5, -90   
mid.pos = -5, -60    
shadowoffset = 0    
draw.offset = 0,0    

[Velocity]
walk.fwd  = 2.5
walk.back = -2.1
run.fwd  = 5.0, 0    
run.back = -4.5,-3.8 
jump.neu = 0,-8.5
jump.back = -3
jump.fwd = 3
runjump.back = -4.5,-8.5
runjump.fwd = 4.5,-8.5
airjump.neu = 0,-8.8     
airjump.back = -2.55      
airjump.fwd = 2.5         

[Movement]
airjump.num = 0      
airjump.height = 35  
yaccel = .44         
stand.friction = .85  
crouch.friction = .82 

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, 2]
type = playsnd
trigger1 = animelem = 2
value = s170,0

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0, 2

[State 180, 2]
type = ChangeState
trigger1 = Time = 1
value = 180 + var(1)

;---------------------------------------------------------------------------
; Win pose 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = playsnd
trigger1 = animelem = 1
value = s182,0

[State 181, 2]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
 Win pose 2
[Statedef 182]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 182, 1]
type = playsnd
trigger1 = animelem = 1
value = s182,1

[State 182, 1]
type = playsnd
trigger1 = animelem = 5
value = s182,2

[State 182, 2]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Introduction
[Statedef 191]
type = S
ctrl = 0
anim = 193
velset = 0,0

[State 191, 1]
type = ChangeAnim
trigger1 = RoundState = 0
value = 193

[State 191, 2]
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3]
type = AssertSpecial
trigger1 = time <= 39
flag = noshadow
flag2 = invisible

[State 191, 5]
type = playsnd
trigger1 = animelem = 9
value = s180,2

[State 191, 6]
type = Helper
trigger1 = time = 0
helpertype = normal
name = "car"
ID = 192
pos = 0,0
postype = p1
facing = 1
stateno = 192
keyctrl = 0
ownpal = 1

[State 191, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

