;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------
[Statedef -3]

; Stop Run FWD sound
[State -3, StopSnd]
type = StopSnd
trigger1 = stateno != 101
channel = 2

; Play Crouching sound
[State -3, snd]
type = Playsnd
triggerall = anim = 11
trigger1 = animelem = 12
value = s10,0
loop = 1
channel = 3

; Stop Crouching sound
[State -3, StopSnd]
type = StopSnd
trigger1 = anim != 11
channel = 3

; Remove After Images
[State -3, removeafterimage]
type = AfterImageTime
triggerall = Movetype = H
trigger1 = Time = 0
time = 0

; Baseball Reflect Controller
[State -3, Varset]
type = varset
triggerall = !stateno = 1100
trigger1 = 1
var(3) = 0

; Baseball Stars 2 Controller
[State -3, Varset]
type = varset
triggerall = !stateno = 1105
trigger1 = 1
var(4) = 0

; 2020 Super Catch Controller
[State -3, Varset]
type = varset
triggerall = !stateno = 1200
trigger1 = 1
var(5) = 0

; Joy Joy Balloon Time Controller
[State -3, Varset]
type = varset
triggerall = !stateno = 1405
trigger1 = 1
var(6) = 0

; Power! Unit! Controller
[State -3, Varset]
type = varset
triggerall = numhelper(3111) = 0
trigger1 = 1
var(7) = 0

; ASO II - Last Guardian Controller
[State -3, Varset]
type = varset
triggerall = !stateno = 3205
trigger1 = 1
var(8) = 0

; Hurting Sounds
[State -3,PlaySnd]
type = PlaySnd
triggerall = Time = 1 && Alive && Random <= 500
triggerall = StateNo = 5000 || StateNo = 5010   || StateNo = 5035 || StateNo = 5070
trigger1 = Anim = 5000 || Anim = 5001 || Anim = 5002 || Anim = 5010 || Anim = 5011 || Anim = 5012 || Anim = 5020 || Anim = 5021 || Anim = 5022 || Anim = 5035 || Anim = 5070
value = s5000,0 + (random%4)


