;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "Catherine_kyohbashi"       ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Catherine"       ;M.U.G.E.Nで実際に表示される名前（省略可能）

Author       = "barai"	       ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1	       ;ＣＰＵで出てきた時のカラーパレットの順番

[Files]
movelist = movelist.dat
Cmd      = Catherine.cmd
Cns      = Catherine.cns
St       = Catherine_Common.cns
St2      = Catherine_-2.st
St3      = Catherine_Helper.st
St4      = Catherine_Attack.st
St5      = Catherine_Skill.st
St6      = Catherine_Spell.st
st7      = Catherine_System.st

stcommon = common1.cns			;MUGEN共通コモン


Sprite   = Catherine.sff      ;
Anim     = Catherine.air      ;
Sound    = Catherine.snd


;--| カラーパレットファイル |-------------------------------------------------

pal1     =  act/Catherine1P.act	;レッド
pal2	 =  act/Catherine2P.act	;ブルー
pal3     =  act/Catherine3P.act	;オレンジ
pal4     =  act/Catherine4P.act	;紫
