;-------------------------------------------------------------------------------
[Statedef 400]; 屈み弱攻撃（落花掌）                                                                             ３秒
;-------------------------------------------------------------------------------
type = S
movetype = A
physics = S
velset = vel x,0
anim = 400
ctrl = 0

[State 400, -/CT]; 臨時無敵（クールタイム処理）
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 1

[State 400, -/CT]; 屈み弱攻撃（落花掌）：開始
type = VarSet
trigger1 = Time = 0
var(32) = 1

[State 400, -/CT]; 屈み弱攻撃（落花掌）：スロット値セット
type = VarSet
trigger1 = Time = 0
V = var(0)+1
Value = 6320

[State 400, -/CT]; 屈み弱攻撃（落花掌）：アイコン表示
type = Explod
trigger1 = Time = 0 && !NumExplod(6320)
anim = 6320
ID = 6320
pos = var(55)+IfElse(var(54)=1,19,106)+(15*var(0)*var(54)),var(56)-5
postype = left
scale = 0.5,0.5
sprpriority = 7
bindtime = 9999
ownpal = 1
supermovetime = 9999
pausemovetime = 9999

[State 400, -1/Var]; 移動速度変数１
type = VarSet
trigger1 = var(59) <= 0 && Command = "holdback"
var(17) = 0

[State 400, -1/Var]; 移動速度変数２
type = VarSet
trigger1 = var(59) <= 0 && Command != "holdback"
var(17) = 1+var(18)

[State 400, 0/Var]; 充填レベル初期化
type = VarSet
trigger1 = Time = 0
var(18) = 0

[State 400, 0/EX1]; 軌跡エフェクト１
type = Explod
trigger1 = AnimElem = 1,0
anim = 7310
ID = 7310
postype = p1
pos = 22,-47
scale = 1,1
sprpriority = 3
ownpal = 1
removeongethit = 1
removetime = 12
bindtime = 12

[State 400, 4/EX2]; 軌跡エフェクト２
type = Explod
trigger1 = AnimElem = 4,0 && !NumExplod(7311)
anim = 7311
ID = 7311
postype = p1
pos = -13,-96
scale = 1,1
sprpriority = 3
ownpal = 1
removeongethit = 1
removetime = -1
bindtime = 999

[State 400, 4/EX3]; 充填エフェクト
type = Explod
trigger1 = AnimElem = 4,0 && !NumExplod(7315)
anim = 7315
ID = 7315
postype = p1
pos = -24,-57
scale = 1,1
sprpriority = 3
ownpal = 1
removeongethit = 1
removetime = 30
bindtime = 30

[State 400, 4/EX4]; 充填完了エフェクト
type = Explod
trigger1 = AnimElem = 4,30 && !NumExplod(7316)
anim = 7316
ID = 7316
postype = p1
pos = -24,-57
scale = 1,1
sprpriority = 3
ownpal = 1
removeongethit = 1
removetime = 15
bindtime = 15

[State 400, 4/Snd]; フルチャージ音
type = PlaySnd
trigger1 = AnimElem = 4,30
value = s21,21

[State 400, 4/Var]; 充填レベル増加
type = VarSet
trigger1 = AnimElem = 4,30
var(18) = 1

[State 400, F/CHs]; 攻撃パートへ
type = ChangeState
triggerall = AnimElem = 3,>0
trigger1 = var(59) <= 0 && Command != "holdx"
value = 401
ctrl = 0

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
