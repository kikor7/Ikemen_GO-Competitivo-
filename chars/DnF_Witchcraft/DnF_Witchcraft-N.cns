trigger1 = AnimElem = 3,0
;- - - - - - - - - - - - - - - -
attr = S,NA
hitflag = HLAFD
guardflag = HL
priority = 2,Hit
numhits = 1
damage = Ceil((var(50)*1.0)*(fvar(38)*0.01))
getpower = 15,7
givepower = Ceil((var(50)*1.0)*(fvar(38)*0.01)),0
;- - - - - - - - - - - - - - - -
animtype = medium
ground.type = high
fall.recovertime = 42
pausetime = 7,10
guard.pausetime = 7,7
ground.slidetime = 10
ground.hittime = 21
guard.ctrltime = 21
ground.velocity = -2,IfElse((Enemy,StateNo=[5101,5110]),-0.5,0)
air.velocity = -0.5,IfElse((Enemy,StateNo=[5101,5110]),-0.5,-2)
;- - - - - - - - - - - - - - - -
hitsound = s31,10
guardsound = s31,999
sparkno = s6000
guard.sparkno = s6008+facing
sparkxy = -30,-80

[State 210, 3/Uni]; ユニオンヒットフラグ
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(13) = 3
ignorehitpause = 1
persistent = 0

[State 210, 3/Uni]; ユニオンターゲット記憶
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(14) = Target,ID
ignorehitpause = 1
persistent = 0

[State 210, 3/Dmg]; 防御無視攻撃力のダメージ／粉無し
type = TargetLifeAdd
trigger1 = MoveHit = 2
value = -1*Ceil((var(51)*1.0)*0.01)
absolute = 1

[State 210, F/CHs]; 動作終了
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

