ground.type = low
fall = 1
fall.recover = 0
pausetime = 10,13
guard.pausetime = 10,10
ground.slidetime = 10
ground.hittime = 21
guard.ctrltime = 21
ground.velocity = -6-4*var(18),IfElse((Enemy,StateNo=[5101,5110]),-1,-4)
air.velocity = -6-4*var(18),IfElse((Enemy,StateNo=[5101,5110]),-1,-4)
p2facing = 1
;- - - - - - - - - - - - - - - -
hitsound = -1
guardsound = s31,999
sparkno = s6000
guard.sparkno = s6008+facing
sparkxy = -30,-65

[State 401, 2/Uni]; ユニオンヒットフラグ
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(13) = 3
ignorehitpause = 1
persistent = 0

[State 402, 2/Uni]; ユニオンターゲット記憶
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(14) = Target,ID
ignorehitpause = 1
persistent = 0

[State 401, 2/Dmg]; 防御無視攻撃力のダメージ／粉無し
type = TargetLifeAdd
trigger1 = MoveHit = 2
value = -1*Ceil((var(51)*(1.5+var(18)))*0.01)
absolute = 1

[State 401, 2/tar]; ステート奪取
type = TargetState
trigger1 = MoveHit = 1 && var(18) = 1
value = 409
ctrl = 0

[State 401, 2/Env]; 画面を揺らす
type = EnvShake
trigger1 = var(18) = 1 && MoveHit = 1
time = 10
freq = 40
ampl = 6

[State 401, 3/EX1R]; 攻撃エフェクト消去
type = RemoveExplod
trigger1 = AnimElem = 3,0 && NumExplod(7312)
ID = 7312

[State 401, F/CHs]; 攻撃パートへ
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;-  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -  -
