;教材用カンフーマンを元に製作しています。

;===============================================================================
; 通常攻撃
;===============================================================================

;-------------------------------------------------------------------------------
[Statedef 200]; 立ち弱攻撃（通常１）
;-------------------------------------------------------------------------------
type = S
movetype = A
physics = S
velset = vel x,0
anim = 200
ctrl = 0

[State 200, 1/Snd]; ボイス
type = PlaySnd
trigger1 = Time = 1
value = s20,0
channel = 0

[State 200, 3/Snd]; スイング音
type = PlaySnd
trigger1 = AnimElem = 3,0
value = s30,0

[State 200, 3/Hit]; ヒット定義／粉無し
type = HitDef
trigger1 = AnimElem = 3,0
;- - - - - - - - - - - - - - - -
attr = S,NA
hitflag = HLAFD
guardflag = HL
priority = 2,Hit
numhits = 1
damage = Ceil((var(50)*0.8)*(fvar(38)*0.01))
getpower = 15,7
givepower = Ceil((var(50)*0.8)*(fvar(38)*0.01)),0
;- - - - - - - - - - - - - - - -
animtype = medium
ground.type = low
fall.recovertime = 42
pausetime = 7,10
guard.pausetime = 7,7
ground.slidetime = 10
ground.hittime = 21
guard.ctrltime = 21
ground.velocity = -2,IfElse((Enemy,StateNo=[5101,5110]),-0.5,0)
air.velocity = -0.5,IfElse((Enemy,StateNo=[5101,5110]),-0.5,-2)
;- - - - - - - - - - - - - - - -
hitsound = s31,0
guardsound = s31,999
sparkno = s6000
guard.sparkno = s6008+facing
sparkxy = -20,-45

[State 200, 3/Uni]; ユニオンヒットフラグ
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(13) = 3
ignorehitpause = 1
persistent = 0

[State 200, 3/Uni]; ユニオンターゲット記憶
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(14) = Target,ID
ignorehitpause = 1
persistent = 0

[State 200, 3/Dmg]; 防御無視攻撃力のダメージ／粉無し
type = TargetLifeAdd
trigger1 = MoveHit = 2
value = -1*Ceil((var(51)*0.8)*0.01)
absolute = 1

[State 200, F/CHs]; 動作終了
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;-------------------------------------------------------------------------------
[Statedef 210]; 立ち中攻撃（通常２）
;-------------------------------------------------------------------------------
type = S
movetype = A
physics = S
velset = vel x,0
anim = 210
ctrl = 0

[State 210, 1/Vel]; レバー入れによる前進
