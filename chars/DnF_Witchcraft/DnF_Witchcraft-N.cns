anim = 7312
ID = 7312
postype = p1
pos = 77,-67
scale = 1,1
sprpriority = 3
ownpal = 1
removeongethit = 1
removetime = 23
bindtime = 23

[State 401, 1]; ボイス
type = PlaySnd
trigger1 = Time = 1
value = s20,5+var(18)
channel = 0 

[State 401, 1]; 効果音
type = PlaySnd
trigger1 = Time = 1
value = s21,5

[State 401, 2/Hit]; ヒット定義／粉無し
