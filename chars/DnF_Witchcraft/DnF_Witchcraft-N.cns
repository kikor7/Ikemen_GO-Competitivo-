triggerall = Time = 1
trigger1 = var(59) <= 0 && Command = "holdfwd"
X = 5

[State 210, 1/Snd]; ボイス
type = PlaySnd
trigger1 = Time = 1
value = s20,IfElse(Random<500,11,10)
channel = 0

[State 210, 3/Snd]; スイング音
type = PlaySnd
trigger1 = AnimElem = 3,0
value = s30,10

[State 210, 3/Hit]; ヒット定義／粉無し
