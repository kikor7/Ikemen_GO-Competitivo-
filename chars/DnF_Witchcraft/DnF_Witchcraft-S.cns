;教材用カンフーマンを元に製作しています。

;===============================================================================
; スキル攻撃
;===============================================================================

;-------------------------------------------------------------------------------
[Statedef 1000]; ブラックマント　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　　 ９秒
;-------------------------------------------------------------------------------
type = S
movetype = A
physics = S
velset = vel x,0
anim = 1000
ctrl = 0
poweradd = Ceil((var(52)*1.32+960)*(fvar(39)*0.01)*0.5)

[State 1000, -/CT]; 臨時無敵（クールタイム処理）
type = NotHitBy
trigger1 = Time = 0
value = SCA
time = 1

[State 1000, -/CT]; ブラックマント：開始
type = VarSet
trigger1 = Time = 0
var(35) = 1

[State 1000, -/CT]; ブラックマント：スロット値セット
type = VarSet
trigger1 = Time = 0
V = var(0)+1
Value = 6350

[State 1000, -/CT]; ブラックマント：アイコン表示
type = Explod
trigger1 = Time = 0 && !NumExplod(6350)
anim = 6350
ID = 6350
pos = var(55)+IfElse(var(54)=1,19,106)+(15*var(0)*var(54)),var(56)-5
postype = left
scale = 0.5,0.5
sprpriority = 7
bindtime = 9999
ownpal = 1
supermovetime = 9999
pausemovetime = 9999

[State 1000, -1/Ass]; ガード不能フラグ
type = AssertSpecial
trigger1 = 1
flag = UnGuardable

[State 1000, 0/Pal]; 通常キャンセル時のフラッシュ
type = PalFX
triggerall = Time = 0
trigger1 = PrevStateNo = [200,220]
time = 5
add = 256,256,256

[State 1000, 1/Snd]; ボイス
type = PlaySnd
trigger1 = Time = 1
value = s20,100
channel = 0

[State 1000, 6/Hit]; ヒット定義
type = HitDef
trigger1 = Animelem = 6,0
;- - - - - - - - - - - - - - - -
attr = S,ST
hitflag = HLAF
guardflag = HL
priority = 1,Miss
numhits = 0
hitonce = 0
kill = 0
damage = Ceil((var(52)*1.32+960)*(fvar(39)*0.01))
getpower = 30,15
givepower = Ceil((var(52)*1.32+960)*(fvar(39)*0.01)),0
;- - - - - - - - - - - - - - - -
animtype = hard
ground.type = low
pausetime = 0,0
guard.pausetime = 0,0
ground.slidetime = 8
ground.hittime = 14
guard.ctrltime = 14
ground.velocity = 0,0
air.velocity = 0,0
p2facing = 1
;- - - - - - - - - - - - - - - -
hitsound = s31,100
guardsound = -1
sparkno = -1
guard.sparkno = -1
sparkxy = -1

[State 1000, 6/Uni]; ユニオンヒットフラグ
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(13) = 3
ignorehitpause = 1
persistent = 0

[State 1000, 6/Uni]; ユニオンターゲット記憶
type = VarSet
trigger1 = MoveHit = 1 && NumEnemy
var(14) = Target,ID
ignorehitpause = 1
persistent = 0

[State 1000, 6/Dmg]; 防御無視攻撃力のダメージ
type = TargetLifeAdd
trigger1 = MoveHit = 2
value = -1*Ceil((var(53)*1.32)*0.01)
absolute = 1
kill = 0

[State 1000, 7/Dmg]; ＫＯ用
type = TargetLifeAdd
triggerall = NumEnemy && AnimElem = 7,13
trigger1 = Enemy,Life = 1
value = -1
absolute = 1

[State 1000, 7/NHB]; ヒット時の無敵
type = NotHitBy
trigger1 = MoveHit >= 1
value = SCA
time = 20

[State 1000, 7/Tar]; ヒット時の相手位置固定
type = TargetBind
trigger1 = AnimElem = 7,>1 && AnimElem = 7,<40 && MoveHit
time = 2
pos = 95,0
ignorehitpause = 1

[State 1000, 7/Tar]; ステートを奪い続ける
type = TargetState
trigger1 = AnimElem = 7,<40 && MoveHit
value = 1099
ignorehitpause = 1

[State 1000, a/EX1]; マントエフェクトＡ
type = Explod
trigger1 = AnimElem = 1,0
anim = 7210
ID = 7210
postype = p1
pos = -7,0
scale = 1,1
sprpriority = 3
ownpal = 1
removeongethit = 1

[State 1000, a/EX2]; マントエフェクトＢ
type = Explod
trigger1 = AnimElem = 1,0
anim = 7211
ID = 7211
postype = p1
pos = -7,0
scale = 1,1
sprpriority = 3
ownpal = 1
removeongethit = 1

[State 1000, a/EX3]; マントエフェクトＣ
type = Explod
trigger1 = AnimElem = 1,0
anim = 7212
ID = 7212
postype = p1
pos = -7,0
scale = 1,1
sprpriority = 0
ownpal = 1
removeongethit = 1

[State 1000, a/EX4]; マントエフェクトＤ
