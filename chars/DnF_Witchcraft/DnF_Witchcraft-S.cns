[Statedef 1099]; ブラックマント／相手側ステート
type = A
movetype = H
physics = N
velset = 0,0
anim = 5010
ctrl = 0

[State 1099, 0/NHB]; 投げ無敵
type = NotHitBy
trigger1 = Time < 2
value = ,AT
time = 2

[State 1099, 0/Pos]; 座標固定
type = PosSet
trigger1 = Time < 2
X = Pos X
Y = -5

[State 1099, 0/Vel]; 速度固定
type = VelSet
trigger1 = Time < 2
X = 0
Y = -4

[State 1099, 2/Vel]; 重力
type = VelAdd
trigger1 = Time >= 2
Y = .35

[State 1099, 2/CHa]; アニメ変更
type = ChangeAnim
trigger1 = Vel Y > 0 && Anim != 5050
value = 5050

[State 1099, F/Slf]; ステート返還
type = SelfState
trigger1 = Pos Y >= -5 && Vel Y > 0
value = 5100

