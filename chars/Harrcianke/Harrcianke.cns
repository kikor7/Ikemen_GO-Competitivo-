[ja.Quotes]
victory0 = "喰ってやる…脳みそからバリバリとな！"
victory1 = "俺は怨霊だ。\n蹂躙されし無数の牙無き者どもの呪詛の言葉だ！"
victory2 = "見えたか？真実が。\n人間が美しい世界と呼ぶものが、いかに悍ましいもので出来ているかが！"
victory3 = "「理想郷」とは「理想人」の集合によってしか成り立ち得ない… \n「理想郷にとって理想的な人間」の、な…フフフ…"
victory4 = "狂気への逃避、白痴の夢こそ幸福か？"
victory5 = "死を超えた無、完全なる忘却と静寂こそが我らの真の救い主さ"
victory6 = "我らが生、この駄作たる世界に救いは無く\n不完全なる我らに幸福と正しさを得る術は無く\nただ吾らに叶う唯一は「否」を唱え続けることだけだ"
victory7 = "君の無念と怨念が俺の糧となるか？\n違うな、これより君が俺となりその怨嗟と怒りを以て\nこの世界を燃やし尽くすのだ！"
victory8 = "君の絶望は些か淡白だな\nもっと人間や世界を信じてみてはどうかね？"
victory9 = "『戦って勝ち取る』そう思うことがすでに邪悪に満ちている…\nそうは思わないか？"
victory10 = "神、梵天、根源、自己(セルフ)…… \nいずれ目指すことはできても辿り着くことは絶対にありえんのさ"
victory11 = "ふははははははは！阿呆が！"



