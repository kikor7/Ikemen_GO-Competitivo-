triggerall = numenemy
triggerall = enemy,teammode = single || enemy,teammode = turns
triggerall = !teammode = simul
triggerall = var(3) = 1
trigger1 = moveguarded
var(25) = floor(49*fvar(7)*fvar(8))
ignorehitpause = 1
persistent = 0

[state 920, ガードクラッシュ]
