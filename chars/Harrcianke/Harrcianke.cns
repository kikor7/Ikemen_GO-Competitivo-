;パワー溜め動作
[statedef 860]
type = S
movetype = I
physics = S
velset = 0,0
ctrl = 0
anim = 860
poweradd = 0
sprpriority = 2

[state 860, パワー蓄積]
type = poweradd
trigger1 = anim = 860
trigger1 = 1
value = 6+time/16

[state 860, パワー溜め終了]
type = changeanim
trigger1 = command != "chargec" || command != "chargez"
trigger2 = power >= 1000
value = 861
persistent = 0

[state 860, 行動可能]
type = ctrlset
triggerall = ctrl = 0
trigger1 = anim = 861
value = 1

[state 860, 動作終了]
type = changestate
trigger1 = anim = 861 && animtime = 0
value = 0
ctrl = 1


