;---------------------------------------------------------------------------
;Crouching medium Attack
; CNS difficulty: easy
; Description: This is a 2-hit move. It is done by having two HitDefs
;     triggered, one for each frame of animation that hits.
;     Notice how the first hit cannot be guarded by an opponent in the
;     air, because of the "M" in the guardflag, meaning it can only
;     be guarded "middle". The second hit has an "MA" guardflag, so
;     it can be guarded both on the ground and in the air.
[Statedef 410]
type    = C
movetype= A
physics = C
juggle  = 1
poweradd= 20
ctrl = 0
anim = 400
sprpriority = 2

[State 0, Projectile]
type = Projectile
trigger1 = animelem = 2
projanim = 411
projscale = 1.5,1.5
projremove = 0
projremovetime = 9
projedgebound = 100
velocity = 4,3
offset = 38,-36
postype = p1
attr = C,NP
hitflag = MAF
guardflag = MA
animtype = medium
priority = 4,Hit
damage = 19,5
getpower = 30,15
pausetime = 0,5
sparkno = s8001
guard.sparkno = s8040
sparkxy = 0,0
hitsound = s5,1
guardsound = s6,0
ground.type = Low
air.type = Low
ground.slidetime = 15
ground.hittime = 20
air.hittime = 20
ground.velocity = -2
air.velocity = -1,-2
air.juggle  = 1

[State 200, 2]
type = PlaySnd
trigger1 = animelem = 2
value = 200, 0

[State 410, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

