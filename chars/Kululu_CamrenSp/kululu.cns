;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, StopSnd]
type = StopSnd
trigger1 = stateno != 191
channel = 1

[State -2, StopSnd]
type = StopSnd
trigger1 = stateno != 1300
channel = 10

[State -2, StopSnd]
type = StopSnd
trigger1 = stateno != 1310
channel = 11

[State -2, DisplayToClipboard]
type = DisplayToClipboard
trigger1 = 1
text = "This Character was by Camren Springer, and just don't spriteswap or paletteswap or some crap.. He'll be watching..  ~Camren Springer"
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Helper]
type = Helper
triggerall = NumHelper(13580) = 0
triggerall = (WinKO) && (NumHelper(13580) < 1)
trigger1 = (StateNo = [3000,3999]) && (Time >= 0)
helpertype = normal ;player
name = "GJ COMBO FINISH Helper"
id = 13580
pos = 0,0
postype = p1
facing = 0
stateno = 13580
keyctrl = 0
ownpal = 1
supermovetime = 99999999999999999
pausemovetime = 99999999999999999
ignorehitpause = 1

[State -3, 2]
type = PlaySnd
triggerall = Time = 1
triggerall = Life
triggerall = random < 700
trigger1 = stateno = 5000 || stateno = 5020
trigger1 = anim != 5000 && anim != 5010
trigger2 = stateno = 5010
trigger2 = anim != 5020
value = 5000,0+Random%2
channel = 0
ignorehitpause = 1
volume = 255

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
value = 40, 0
