trigger1 = Time = 0
attr = A, NA ;空中通常打撃（Air, Normal Attack）
damage    = 20*(1+ceil(Fvar(11)))
guardflag = HA ;相手はしゃがみガードが出来ない
priority = 3
getpower = 30,15
givepower = 5,1
pausetime = 7,8
sparkno = s4007
sparkxy = -10,-58
hitsound = s1,0+random%3
guardsound = s3, 21+random%2
