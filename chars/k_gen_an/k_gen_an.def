; サンプルキャラクター『カンフーマン』の定義ファイルです。
; キャラクターに必要なファイルを全て登録してください。
;
; ※説明文などで左の部分に半角でセミコロン（;）が付いていますが、
; 　これが付いた後の行や文章は全て『コメント化』されます。
; （プログラムとして処理はされない）
; 　作成中のメモを残しておいたり、ステート間の区切りを設ける時などに便利です。
;
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         ="gen_an"
DisplayName  ="gen_an"
VersionDate  =08,05,2011
MugenVersion =04,14,2002
Author       ="KusareMiyabi"
Pal.Defaults =6,3,4,2

;--| 必要なファイルの設定 |---------------------------------------------------
;
; def・sff・snd・act以外のファイルは全てメモ帳などで書き換えられる
; テキスト形式のファイルなので、拡張子は何でもＯＫです。
; しかしファイルの認識で不正終了が起こる可能性もあるので、
; 無難に行くならM.U.G.E.Nでサポートされている拡張子にしておきましょう。
;
; def（定義ファイル）のみ、テキスト形式のファイルですが拡張子の変更は不可です。
;
; ※StCommonは書き換えない限り、dataフォルダにある「common1.cns」を
; 　直接読み込んでますが、あなたが独自に作ったコモンファイルを設定する場合は
; 　各キャラクターの「defファイルのあるフォルダ」を基準に
; 　ディレクトリ階層が認識されます。
;
;-----------------------------------------------------------------------------

[Files]
movelist = movelist.dat
Cmd     =k_gen_an.cmd
Cns     =k_gen_an.cns
St      =k_gen_an.cns
                        ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
                        ;「St」のみ必要な項目なので省略出来ません
StCommon =common1.cns
Sprite  =k_gen_an.sff
Anim    =k_gen_an.air
Sound   =k_gen_an.snd
pal1=k_gen_an.act
pal2=k_gen_an2.act
pal3=k_gen_an6.act
pal4=k_gen_an3.act
pal5=k_gen_an4.act
pal6=k_gen_an5.act
pal7=k_gen_an.act
pal8=k_gen_an2.act
pal9=k_gen_an6.act
pal10=k_gen_an3.act
pal11=k_gen_an4.act
pal12=k_gen_an5.act

;--| カラーパレットファイル |-------------------------------------------------
;
; キャラクターの色を定義するファイルは最大１２個まで登録が可能です。
;
; なお、Pal7～12（７Ｐ～１２Ｐカラー）を選びたい時は、
; スタートボタン（Ｓボタン）を押しながらキャラクターを決定すれば使えます。
; この要素を利用して『裏キャラ』や『殺意の波動に目覚めたリュウ』などの
; 別性能バージョンも１体のキャラの中で作る事が可能。
;
;-----------------------------------------------------------------------------



;--| ストーリーボード設定 |---------------------------------------------------
;
; キャラクター固有のオープニングやエンディングのファイル（ストーリーボード）を
; 登録する場合はここで設定をします。
;
; ※ここで設定したストーリーボードが有効になるゲームモードは
; 「アーケードモード（ARCADE）」
; 「チームアーケードモード（TEAM ARCADE）」
; 「１Ｐと２ＰがペアになってＣＰＵと闘うモード（TEAM CO-OP）」の三種類のみ。
;
; 　しかしチームを組んだ場合、有効になるのは『選んだ最初の一人目』のみ。
;
;-----------------------------------------------------------------------------

[Arcade]
Intro.Storyboard =intro.def
Ending.Storyboard =ending.def

;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------
;-----------------------------------------------------------------------------

