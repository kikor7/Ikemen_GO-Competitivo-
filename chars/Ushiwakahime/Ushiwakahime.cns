;SamSho Mode [Stance]
[Statedef 250]
type    = S
movetype= I
physics = S
juggle  = 8
poweradd= 0
ctrl = 0
velset = 0,0
anim = 250
sprpriority = 2

[State 250, PlaySnd]
type = PlaySnd
triggerall = prevstateno = [260,266]
trigger1 = time = 0
value = S6,1
[State 250, PlaySnd]
type = PlaySnd
triggerall = prevstateno = [251,252]
trigger1 = time = 0
value = S6,1
[State 250, PlaySnd]
type = PlaySnd
triggerall = prevstateno = 258
trigger1 = time = 0
value = S6,1

[state 250 turn]	;Turn
type = changestate
trigger1 = p2dist X < -10
value = 249
ctrl = 0

[State 250]	;FWD
type = ChangeState
triggerall = animelemtime(3) >= 0
trigger1 = command = "FF"
value = 251
ctrl = 0

[State 250]	;BKWD
type = ChangeState
triggerall = animelemtime(3) >= 0
trigger1 = command = "BB"
value = 252
ctrl = 0

[State 250]	;End
type = ChangeState
triggerall = animelemtime(3) >= 0
trigger1 = command = "DD"
trigger2 = win || lose
value = 253
ctrl = 0

[State 250]	;To High Attack
type = ChangeState
triggerall = animelemtime(5) >= 0
trigger1 = command = "x"
value = 255
ctrl = 0

[State 250]	;To Low Attack
type = ChangeState
triggerall = animelemtime(5) >= 0
trigger1 = command = "a"
value = 256
ctrl = 0

[State 250]	;To SamSho Style Hard Attack
type = ChangeState
triggerall = animelemtime(5) >= 0
trigger1 = command = "y"
value = 257
ctrl = 0

[State 250]	;To Back Dash
type = ChangeState
triggerall = animelemtime(5) >= 0
trigger1 = command = "b"
value = 258
ctrl = 0

[State 250]	;To Jump Still
type = ChangeState
triggerall = animelemtime(3) >= 0
triggerall = command != "holdfwd" && command != "fwd"
triggerall = command != "holdback" && command != "back"
trigger1 = command = "up" || command = "holdup"
value = 260
ctrl = 1

[State 250]	;To Jump FWD
type = ChangeState
triggerall = animelemtime(3) >= 0
triggerall = command = "fwd" || command = "holdfwd"
trigger1 = command = "up" || command = "holdup"
value = 261
ctrl = 1

[State 250]	;To Jump BKWD
type = ChangeState
triggerall = animelemtime(3) >= 0
triggerall = command = "back" || command = "holdback"
trigger1 = command = "up" || command = "holdup"
value = 262
ctrl = 1

