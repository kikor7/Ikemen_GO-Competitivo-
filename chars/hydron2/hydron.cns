;Vars:
;	0  = temp var
;	1  = temp var
;	2  = enemy 1 id
;	3  = enemy 1 guardcrush guage
;	4  = enemy 2 id
;	5  = enemy 2 guardcrush guage
;	6  = guard break strength
;	7  = guard break sound trigger
;	8  = guard crush fx check

;	13 = button strength var
;	14 = id of most recent hitdef
;	15 = highjump buffer
;	16 = custom gameplay off/on

;	18 = hit tracking

;	22 = warzard hitsparks off/on
;	23 = hitsound flag
;	24 = target pos
;	25 = helper pos
;	26 = movehit/fx sound flag
;	27 = fx element flag
;	28 = previous hitpausetime
;	29 = custom fx

;	33 = delay damage dampening

;	37 = previous uniqhitcount
;	38 = combo counter
;	39 = helper combo counter
;	40 = helper has target

;	43 = juggle flag
;	44 = juggle level

;	51 = walk timer
;	52 = enemy cornered
;	53 = hitstun balance

;	56 = pause/superpause check
;	57 = (Winane) GameTime var, for pause and custom state check
;	58 = ai action select
;	59 = (Winane) AI

;Fvars:
;	0  = temp var
;	1  = temp var

;	3  = math var
;	4  = math var

;	10 = AI aggression setting

;	12 = guard crush strength setting
;	13 = overall damage mod
;	14 = damage dampening setting

;       39 = AI guard jump/crouch response

;Channels:
;	0 = voice
;	1 = swing
;	2 = smash
;	3 = fx

[Data]
life = 1000			;Amount of life to start with
attack = 100		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 1		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 200			;Volume offset (negative for softer)
IntPersistIndex = 58	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
;Adapted scale large (direct conversion from CPS-3)
	xscale=0.83333333333333333333333333333333
	yscale=1.0714285714285714285714285714286

;Adapted scale small (bit smaller to avoid pixellation)
;	xscale = 0.801           ;Horizontal scaling factor.
;	yscale = 1

;Original scale (no scaling, may appear "squashed")
;	xscale = 1           ;Horizontal scaling factor.
;	yscale = 1           ;Vertical scaling factor.

ground.back = 24		;Player width (back, ground)
ground.front = 24		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 200		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = -8, -92	;Approximate position of head
mid.pos = 8, -50		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 5.0		;Walk forward
walk.back = -2.5		;Walk backward
run.fwd  = 6.667, 0		;Run forward (x, y)
run.back = -4.5,-3.8	;Hop backward (x, y)
jump.neu = 0,-9.64		;Neutral jumping velocity (x, y)
jump.back = -2.5		;Jump back Speed (x, y)
jump.fwd = 2.5		;Jump forward Speed (x, y)
runjump.back = -3.33,-9.64;Running jump speeds (opt)
runjump.fwd = 4.167,-9.64	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 2.5		;.

[Movement]
airjump.num = 0		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .536		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
[Statedef 180]
type = S
sprpriority = 0
velset = 0,0

[State 180, 1]
type = ChangeState
trigger1 = !time
trigger1 = random%5 < 2
value = 181

[State 180, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 180, RoundNotOver]
type = AssertSpecial
trigger1 = time < 120
flag = RoundNotOver

[State 180, ChangeAnim]
type = ChangeAnim
trigger1 = !time
value = 180

[State 180, ChangeAnim]
type = ChangeAnim
trigger1 = animelem = 13
value = 180
elem = 12

[State 180, Explod]
type = Explod
trigger1 = animelem = 12
id = 10180
bindtime = -1
ownpal = 0
anim = 10180
sprpriority = 1
scale = const(size.xscale), const(size.yscale)
persistent = 0

[State 180, PlaySnd]
type = PlaySnd
trigger1 = animelem = 11
value = 180, 0
channel = 0

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, RoundNotOver]
type = AssertSpecial
trigger1 = time < 300
flag = RoundNotOver

[State 181, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
trigger3 = anim = 20
x = 0

[State 181, 1]
type = ChangeAnim
triggerall = anim != [182, 183]
triggerall = animtime >= 0
trigger1 = anim = [5005, 5007]
trigger2 = anim = [5016, 5017]
value = anim + 600

[State 181, 1]
type = ChangeAnim
triggerall = anim != [182, 183]
trigger1 = Anim != 0 && Anim != [5, 6]
trigger1 = anim != 5120
trigger1 = anim != 5125
trigger1 = anim != [5005, 5007]
trigger1 = anim != [5605, 5607]
trigger1 = anim != [5015, 5017]
trigger1 = anim != [5615, 5617]
trigger2 = anim
trigger2 = animtime >= 0
value = 0
elem = 3

[State 181, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 181, Explod]
type = Explod
trigger1 = !time
id = 185
removetime = 100
bindtime = 1
ownpal = 0
anim = 185
sprpriority = 0
scale = const(size.xscale), const(size.yscale)
persistent = 0
pos = -333 - floor(11*const(size.xscale) + 0.5),0
vel = 3.33,0

[State 181, Explod]
