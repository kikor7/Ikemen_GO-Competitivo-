;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, ChangeAnim]
type = ChangeAnim
trigger1 = !roundstate
trigger1 = animelem = 6
value = 190
elem = 1

[State 190, PlaySnd]
type = PlaySnd
trigger1 = animelem = 2
trigger2 = animelem = 7
trigger3 = animelem = 12
;trigger4 = animelem = 16, = 3
value = 1100, 1
channel = 1

[State 190, PlaySnd]
type = PlaySnd
trigger1 = animelem = 18
value = 220, 0
channel = 0

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

