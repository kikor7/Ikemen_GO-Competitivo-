;---------------------------------------------------------------------------
; Standing Light Punch
; CNS difficulty: easy
[Statedef 200]
type    = S				;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A				;Move-type: A-attack, I-idle, H-gethit
physics = S				;Physics: S-stand, C-crouch, A-air
;Commonly-used controllers:
velset = 0,0			;Set velocity (x,y) (Def: no change)
ctrl = 0				;Set ctrl (Def: no change)
anim = 200				;Change animation (Def: no change)
poweradd = 0			;Power to add (Def: 0)
sprpriority = 2			;Set layering priority to 2 (in front)

[State 200, VarSet]
type = Null
trigger1 = !time
trigger1 = var(0) := 0 || 1
trigger1 = var(1) := 0 || 1

[State 200, 1]
type = HitDef
triggerall = var(22)
triggerall = !var(43)
trigger1 = !movecontact && !movereversed
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
attr = S, NA
damage = 104, 0
getpower = 30,15
animtype = Medium
guardflag = MA
hitflag = MA
pausetime = 9, 9
sparkno = s27001
guard.sparkno = s27006 + 2*(numenemy = 1 && var(8) - var(6) < 1)
sparkxy = ifelse(p2bodydist x < 40, ifelse(p2bodydist x < 0, -50, ceil(p2bodydist x - 50)), -10), floor(-58*const(size.yscale))
hitsound   = -1 + (var(23) := 6)*0 ;s5,1
guardsound = s6,0 + 2*(numenemy = 1 && var(8) - var(6) < 1)
ground.type = Low
ground.velocity = -5
ground.hittime  = 16
ground.slidetime  = 16
guard.hittime = 15
air.hittime = 999
airguard.ctrltime = 999
air.type = Low
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
sprpriority = 2

[State 200, 1]
type = HitDef
triggerall = !var(22)
triggerall = !var(43)
trigger1 = !movecontact && !movereversed
trigger1 = var(6) := floor(fvar(12)*500) || 1
id = 0*(var(14) := stateno + (var(18)%1000)*10000 + id%10) + var(14)
attr = S, NA
damage = 104, 0
getpower = 30,15
animtype = Medium
guardflag = MA
hitflag = MA
pausetime = 9, 9
sparkno = 1
sparkxy = ifelse(p2bodydist x < 40, ifelse(p2bodydist x < 0, -50, ceil(p2bodydist x - 50)), -10), floor(-58*const(size.yscale))
hitsound   = -1 + (var(23) := 6)*0 ;s5,1
guardsound = s6,0 + 2*(numenemy = 1 && var(8) - var(6) < 1)
ground.type = High
ground.velocity = -5
ground.hittime  = 16
ground.slidetime  = 16
guard.hittime = 15
air.hittime = 999
airguard.ctrltime = 999
air.type = Low
air.velocity = -3, -6.43
airguard.velocity = -3, -6.43
yaccel = .536
sprpriority = 2

[State 200, 5]
type = ChangeAnim
trigger1 = !animtime
value = 0
elem = ((var(0)+1)%36)/3 + 1

[State 200, 5]
type = ChangeState
trigger1 = !anim
value = 0
ctrl = 1

[State 200, Helper]
type = Helper
trigger1 = !numhelper(205)
id = 205
stateno = 205
ignorehitpause = 1
pausemovetime = 99999
supermovetime = 99999
ownpal = 0

[State 200, Helper]
type = Helper
trigger1 = !numhelper(10205)
id = 10205
stateno = 10205
ignorehitpause = 1
