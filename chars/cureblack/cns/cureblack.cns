;タイムオーバーで負けた時
[Statedef 170]
type=S
ctrl=0
anim=194
velset=0,0

[State ]
type=NotHitBy
trigger1=1
value=SCA
time=1

[State ]
type=AssertSpecial
trigger1=time<=60
flag=roundnotover

[State ]
type=PlaySnd
trigger1=time=1
value=s0,46

;DRAWGAME(Time over)
[Statedef 175]
type=S
ctrl=0
anim=194
velset=0,0

[State ]
type=AssertSpecial
trigger1=time<=60
flag=roundnotover

[State ]
type=NotHitBy
trigger1=1
value=SCA
time=1

[State ]
type=PlaySnd
trigger1=time=1
value=s0,21

;開始前の動作～分岐
[Statedef 191]
type=S
ctrl=0
velset=0,0

[State ]
type=varset
trigger1=time=0&&(p2name="chamballoon"||p4name="chamballoon")
var(13)=413

[State ]
type=VarRandom
trigger1=time=0
v=21
range=0,2

[State ];ナハトズィーガー
type=ChangeState
trigger1=P2name="NachtSieger"&&enemynear,authorname="Hanyu-maru"
trigger2=numenemy>=2
trigger2=P4name="NachtSieger"&&enemynear(1),authorname="Hanyu-maru"
value=1050

[State ]
type=ChangeState
trigger1=RoundsExisted=0&&enemy,roundsexisted>0&&teammode=turns
value=1000

