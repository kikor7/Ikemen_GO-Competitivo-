;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; 基本行動のステート

;---------------------------------------------------------------------------
; ラウンド開始前初期化専用ステート
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = 1
value = 9999

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = !RoundsExisted;roundno = 1
value = 190

;---------------------------------------------------------------------------
; ジャンプ開始
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 1990, 投げ無敵]
type = NotHitBy
trigger1 = 1
value = ,AT
time = 1

[State 40, 6]
type = ChangeState
trigger1 = var(59)
value = 0
ctrl = 1


[State 40, ハイジャンプ]
type = VarSet
trigger1 = !var(59)
trigger1 = (command = "jump")
var(1) = 1

[State 40, 1]
type = VarSet
trigger1 = !var(59)
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 移動速度]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*ifelse(var(1) = 1,1.5,1), const(velocity.jump.back.x)*ifelse(var(1) = 1,1.5,1)))
y = const(velocity.jump.y)*ifelse(var(1) = 1,1.2,1)

[State 40, 移動速度]
type = VelSet
trigger1 = (AnimTime = 0)
trigger1 = (PrevStateNo = 100)
trigger1 = (sysvar(1) = 1)
x = const(velocity.runjump.fwd.x)
y = const(velocity.jump.y)

[State 40, 振り返る]
type = Turn
triggerall = (PrevStateNo = 52)
trigger1 = (Time = 0) && (P2Dist X < 0)
Persistent = 0

[State 40, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; ジャンプ
[Statedef 50]
type    = A
physics = A

[State 40, ハイジャンプ音]
type = PlaySnd
trigger1 = var(1) = 1
trigger1 = Time = 0
value = 40,3

[State 40, ハイジャンプ残像]
type = AfterImage
trigger1 = var(1) = 1
trigger1 = Time = 0
time = 30
trans = add1

[State 50, 1]
type = VarSet
trigger1 = Time = 5
var(1) = 0

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))


;---------------------------------------------------------------------------
; 着地
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = var(40)
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; ダッシュ
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State -3, ]
type = PlaySnd
trigger1 = AnimElem = 8||AnimElem = 18
value = 40,0
channel = 5


[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = !var(59)
trigger1 = command = "holdback"
trigger1 = time > 17
trigger2 = var(59)
trigger2 = time > 17
value = 0
ctrl = 1

[State 100, 4]
type = ChangeState
trigger1 = !var(59)
trigger1 = command != "holdfwd"
trigger1 = time > 17
trigger2 = var(59) && roundstate != 2
trigger3 = var(59) && Win
value = 101
ctrl = 0

;---------------------------------------------------------------------------
; ダッシュ
[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1


[State 100, 1]
type = VelSet
trigger1 = time <= 3
x = const(velocity.run.fwd.x) - 1

[State -3, ]
type = PlaySnd
trigger1 = time = 0
value = 40,1
channel = 5

[State 800,]
type = Explod
trigger1 =AnimElem = 1
anim = 30034
id = 30034
pos = 0,0
postype = P1
sprpriority = 2
bindtime = 6
ownpal = 1
scale = 0.25,0.25

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; バック
[Statedef 105]
type    = S
physics = S
ctrl = 0
anim = 105
poweradd = 0
sprpriority = 1

[State 40, 残像]
type = AfterImage
trigger1 = Time = 0
time = 15
trans = add
add = 150,150,0
sinadd = 64,32,5,3
TimeGap = 1
length = 30

[State 771, 画像の色]
type = PalFX
trigger1 = Time = 0
time = 15
add = 50,50,150
sinadd = 64,64,64,3

[State 702, ]
type = notHitBy
trigger1 = time <= 15
value = SCA,AA,AP,AT

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.back.x)

[State 2, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 40, 2

[State 106, 4]
type = ChangeState
trigger1 = Time = 20
value = 0
ctrl = 1

