value = 7,3
channel = 0

;---------------------------------------------------------------------------
; 勝利ポーズ分岐
[Statedef 180]
type = S

[State 1200,カメラ制御ヘルパー]
type = helper
trigger1 = pos X != 0
trigger1 = P2bodydist X >= 200
trigger1 = Time = 0
name = "helper1"
id = 6001
pos = 0,0
postype = p1
stateno = 6001
helpertype = normal
ownpal = 1
keyctrl = 1

[State 1001, 強弱]
Type = VarRandom
trigger1 = Time = 0
v = 1
Range = 0,2
IgnoreHitPause = 1
Persistent = 1

[State 180, ラウンド]
type = ChangeState
triggerall = RoundState != 0
trigger1 = MatchOver = 0
value = 181

[State 180, 最終ラウンド辛勝]
type = ChangeState
triggerall = (100*life/const(data.life))<=30
trigger1 = MatchOver = 1
trigger2 = RoundState = 0
value = 182

[State 180, 最終ラウンドなかなか]
type = ChangeState
triggerall = (100*life/const(data.life))>=30&&(100*life/const(data.life))<=70
trigger1 = MatchOver = 1
trigger2 = RoundState = 0
value = 183

[State 180, 最終ラウンド余裕]
type = ChangeState
triggerall = (100*life/const(data.life))>=70
trigger1 = MatchOver = 1
trigger2 = RoundState = 0
value = 184
