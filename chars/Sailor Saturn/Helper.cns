;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 1ゲージ時
[Statedef 8000]
type        = S
anim        = 99999
velset      = 0,0
ctrl        = 0
sprpriority = 0

[State 8000, 無敵]
Type     = NotHitBy
Trigger1 = 1
Value    = ,AT,AA,AP

[State 8000, Explod]
Type           = Explod
Trigger1       = Time = [0,20]
Anim           = 8000
ID             = 8000
Postype        = back
Pos            = -240+(statetime*12) ,0 
scale          = .5,.5
Ownpal         = 1
SprPriority    = -4
IgnoreHitPause = 1
SuperMoveTime  = 9999
PauseMoveTime  = 9999

[State 8000, Explod]
Type           = Explod
Trigger1       = Time = [21,40]
Anim           = 8000
ID             = 8000
Postype        = back
Pos            = 0,0 
scale          = .5,.5
Ownpal         = 1
SprPriority    = -4
IgnoreHitPause = 1
SuperMoveTime  = 9999
PauseMoveTime  = 9999

[State 8000, Explod]
Type           = Explod
Trigger1       = Time > 40
Anim           = 8000
ID             = 8000
Postype        = back
Pos            = 0,0
scale          = 0.5+(statetime-40)*0.02,.5+(statetime-40)*0.02
Ownpal         = 1
SprPriority    = -4
IgnoreHitPause = 1
Trans          = AddAlpha
Alpha          = 256-25*(statetime-40),25*(statetime-40)
SuperMoveTime  = 9999
PauseMoveTime  = 9999

[State 8000, 背景ハレーション]
type           = Explod
trigger1       = !NumExplod(8100)
trigger1       = time = 0
anim           = 8100
id             = 8100
pos            = 0,0
postype        = back
ownpal         = 1
supermovetime  = 999
pausemovetime  = 999
bindtime       = 999
removeongethit = 1
scale          = 0.55,0.55
sprpriority    = -99
persistent     = 0
trans          = add

[State -1, AssertSpacial]
Type           = AssertSpecial
Trigger1       = 1
Flag           = Noshadow
Flag1          = invisible
IgnoreHitPause = 1

[State -1, DestroySelf]
Type           = DestroySelf
Trigger1       = time >= 62
IgnoreHitPause = 1
