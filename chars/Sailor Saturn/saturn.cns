;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
;セーラーサターン(Ver.0.6)                              コンスタンツ（定数）
;〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓〓
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;			基本データ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Data]
life              = 1000         ;ライフ(体力ゲージ)最大値(デフォ:1000)       
power             = 5000         ;パワーゲージ最大値（デフォ:5000=Lv.5）
attack            = 100          ;攻撃力(デフォ:100) 
defence           = 100          ;防御力(デフォ:100) 
fall.defence_up   = 50           ;横に倒れている時に一時的に加える防御力  
liedown.time      = 60           ;横に倒れている時間
airjuggle         = 20           ;ジャグルポイント限界値(高くすると無限コンボになるので注意)
sparkno           = 2            ;デフォルトのヒットスパーク（fightfxから）
guard.sparkno     = 40           ;デフォルトのガードスパーク（fightfxから） 
KO.echo           = 0            ;ＫＯ時の音声（11,0）にエコーを掛けるか否か(1でON)
volume            = 255          ;キャラの標準の音量（最小-255・最大255）
IntPersistIndex   = 60           ;次のラウンドへ持ち越せる「Var」のアドレスの範囲
FloatPersistIndex = 40           ;次のラウンドへ持ち越せる「FVar」のアドレスの範囲
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;			　サイズ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Size]
xscale          = .89            ;水平方向の縮尺（通常１）
yscale          = .89            ;垂直方向の縮尺（通常１）
ground.back     = 15             ;キャラの幅(後方,地上)
ground.front    = 16             ;キャラの幅(前方,地上)
air.back        = 12             ;キャラの幅(後方,空中)
air.front       = 12             ;キャラの幅(前方,空中)
height          = 60             ;キャラの高さ
attack.dist     = 160            ;攻撃をした時相手がガード体制に入る最低距離
proj.attack.dist= 90             ;攻撃をした時相手がガード体制に入る最低距離（飛び道具）
proj.doscale    = 0              ;上で設定した縮尺を飛び道具にも適用するか（１でＯＮ）   
head.pos        = -5,-90         ;頭の大体の座標
mid.pos         = -5,-60         ;体の中心の大体の座標
shadowoffset    = 0              ;影の垂直方向のオフセット
draw.offset     = 0,0            ;使用しない
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;			移動速度
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Velocity]
walk.fwd        = 1.3            ;前進の速度
walk.back       = -1.3           ;後退の速度
run.fwd         = 6,0            ;前ダッシュの速度（ホップする時はyを-にする）
run.back        = -5,0           ;後ダッシュの速度（ホップする時はyを-にする）
jump.neu        = 0,-10.1        ;垂直ジャンプの速度
jump.back       = -2.5           ;後ジャンプの速度
jump.fwd        = 2.5            ;前ジャンプの速度
runjump.back    = -2.5,-10.1     ;後ダッシュしながらのジャンプ速度(オプション)
runjump.fwd     = 2.5,-10.1      ;前ダッシュしながらのジャンプ速度(オプション)
airjump.neu     = 0,-9.2         ;２段ジャンプ以降の垂直ジャンプの速度(オプション)
airjump.back    = -2.5,-9.2      ;２段ジャンプ以降の後ジャンプの速度(オプション)
airjump.fwd     = 2.5,-9.2       ;２段ジャンプ以降の前ジャンプの速度
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;			運動関係
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Movement]
airjump.num     = 1              ;空中でジャンプする回数
airjump.height  = 35             ;空中でジャンプする最低限の高さ
yaccel          = .52            ;重力
stand.friction  = .85            ;立ち状態の摩擦係数
crouch.friction = .82            ;屈み状態の摩擦係数
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;			通常攻撃技
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;立切り(弱)
;━━━━━━━━━━━━━━━━
[Statedef 200]
type     = S
movetype = A
physics  = S
juggle   = 1
ctrl     = 0
anim     = 200

[State 200, ボイス]
type     = PlaySnd
trigger1 = AnimElemTime(2) = 0
value    = s200+(10000*ifelse(var(45)=0,0,1)),0
channel  = 0

[State 200, SE]
type     = PlaySnd
trigger1 = AnimElem = 2
value    = s0,0
channel  = 1

[State 200, 移動速度]
type     = VelSet
trigger1 = ((AnimElemTime(2)>0)&&(AnimElemTime(4)<0))
x        = 1

[State 200, ヒット定義]
Type              = HitDef
Trigger1          = AnimElem = 3
attr              = S,NA
animtype          = Medium
damage            = 30,1
getpower = 30,15
hitflag           = MAF
guardflag         = MA
priority          = 2,Hit
pausetime         = 10,10
sparkno           = -1
sparkxy           = 0,-70
guard.sparkno     = -1
hitsound          = s5,3
guardsound        = S6,1
ground.type       = High
ground.slidetime  = 13
ground.hittime    = 13
ground.velocity   = -3
air.velocity      = -2,-3
yaccel            = .48

[State 200, ヒット確認]
Type           = VarAdd
trigger1       = MoveHit
V              = 25
value          = 1
IgnoreHitPause = 1
Persistent     = 0

[State 200, ステ変更]
type     = Changestate
trigger1 = AnimTime = 0
value    = 0
ctrl     = 1
