trigger8 = 1
trigger8 = fvar(2):=0
ignorehitpause = 1
persistent = 1

[State 400,チェーンコンボフラグ]
type = varset
trigger1 = movecontact||movereversed
var(0) = 1+(movehit>=1)
ignorehitpause = 1
persistent = 0

[State カウンターヒット判定]
type=Varset
trigger1=1
var(15)=(p2movetype=A)*(!numtarget(400))
ignorehitpause=0

;--------------------[動作]

;--------------------[音声]

[State 400, 抜く音]
type     = PlaySnd
trigger1 = animelemtime(3) = 0
value    = s1, 0
persistent=0

[State 400, 振る音]
type     = PlaySnd
trigger1 = animelemtime(3) = 1
value    = s1003, 1
persistent=0

[State 400, 声]
type     = PlaySnd
trigger1 = animelemtime(3) = 1
trigger1 = random%18>=9
value    = s3, 0+(random%3)
channel=0
persistent=0

[State 400, しまう音]
type     = PlaySnd
trigger1 = animelemtime(6) = 0
value    = s1, 1
persistent=0

;--------------------[ヒット定義]

[State 400, HitDef];発生7F レベルA 800ダメージ 復帰不能17
type                = HitDef
fall.yvelocity      =(-2.5+(enemynear,pos y)*0.010)*(!var(19))
triggerall          = !movecontact&&!movereversed&&roundstate=2
trigger1            = AnimElemtime(3) >= 1
givepower           = floor(800*0.027),floor(800*0.008)
getpower = 30,15
attr                = C, NA
hitflag             = MAFD
guardflag           = L
damage              = ceil(800*fvar(6)*ifelse(var(15)=1,1.25,1)/24),0
animtype            = Light
ground.type         = low
priority            = 3, hit
pausetime           = 9, 8
sparkno             = -1
sparkxy             = 0, 0
guard.sparkno       = -1
hitsound            = s1002, 1
guardsound          = s1004, 0
ground.slidetime    = 11
ground.hittime      = 11
guard.slidetime     = 11
guard.ctrltime      = 11
airguard.ctrltime   = 13

ground.velocity     = -4
guard.velocity      = -4
air.velocity        = ifelse((!var(19)),-2,-4),-1
airguard.velocity   = -2,-1
down.velocity       = -4,-1
air.fall            = 1
fall.recovertime    = 17*ifelse(var(15)>=1,2,1)+8
yaccel              = 0.48
Ground.CornerPush.VelOff   = -8
Air.CornerPush.VelOff      = -8
Down.CornerPush.VelOff     = -8
Guard.CornerPush.VelOff    = -8
id = 400

;--------------------[変数処理2]

