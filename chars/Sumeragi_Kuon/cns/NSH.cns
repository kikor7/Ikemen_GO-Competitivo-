trigger1 = animelemtime(1) = 0
value    = s1, 0
persistent=0

[State 2020, 振る音]
type     = PlaySnd
trigger1 = animelemtime(2) = 0
trigger2 = animelemtime(13) = 0
value    = s1, 3
persistent=10

[State 2020, 声]
type     = PlaySnd
trigger1 = animelemtime(2) = 0
value    = s3, 1015
channel=0
persistent=0

[State 2020, しまう音]
type     = PlaySnd
trigger1 = !movehit
trigger1 = animelemtime(15) = 0
value    = s1, 1
persistent=0

;--------------------[ヒット定義]

[State 2020, ヒットフラグ取り消し]
