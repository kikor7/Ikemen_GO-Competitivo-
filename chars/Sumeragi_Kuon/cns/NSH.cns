movetype=A
physics=C
ctrl=0
anim=400
sprpriority=2

;--------------------[変数処理1]

[State 400,汎用変数リセット]
type = null
triggerall = !time
trigger1 = 1
trigger1 = var(0):=0
trigger2 = 1
trigger2 = var(3):=0
trigger3 = 1
trigger3 = var(22):=0
trigger4 = 1
trigger4 = var(23):=0
trigger5 = 1
trigger5 = var(24):=0
trigger6 = 1
