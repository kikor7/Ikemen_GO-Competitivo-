trigger1=animelemtime(13)=0
persistent=0

[State 2020, HitDef1];発生6F レベルD 1000ダメージ 復帰不能30 地上でも吹っ飛び
type                = HitDef
fall.yvelocity      = (-6+(enemynear,pos y)*0.010)*(!var(19))
triggerall          = !movecontact&&!movereversed&&roundstate=2
trigger1            = AnimElemtime(2) >= 2
trigger1            = AnimElemno(0) = [2,4]
givepower           = floor(1000*0.027),floor(1000*0.008)
getpower            = 0,0
attr                = A, SA
hitflag             = MAFD
guardflag           = MA
damage              = ceil(1000*fvar(6)*ifelse(var(15)=1,1.25,1)/24),ceil(1000*fvar(6)/fvar(7)/240)
animtype            = Hard
ground.type         = High
priority            = 6, hit
pausetime           = 8, 7
sparkno             = -1
sparkxy             = 0, 0
guard.sparkno       = -1
hitsound            = s1002, 3
guardsound          = s1004, 0
ground.slidetime    = 22
ground.hittime      = 22
guard.slidetime     = 22
guard.ctrltime      = 22
airguard.ctrltime   = 24

ground.velocity     = ifelse((!var(19)),-1.2,-6),ifelse((!var(19)),-12,-1.5)
guard.velocity      = -8
air.velocity        = ifelse((!var(19)),-1.2,-6),ifelse((!var(19)),-12,-1.5)
airguard.velocity   = ifelse((!var(19)),-1.2,-6),ifelse((!var(19)),-12,-1.5)
down.velocity       = -6,-1.5
fall                = 1
air.fall            = 1
fall.recovertime    = 30*ifelse(var(15)>=1,2,1)+7
yaccel              = 0.48
guard.kill          = (var(35)&128)
Ground.CornerPush.VelOff   = -12
Air.CornerPush.VelOff      = -12
Down.CornerPush.VelOff     = -12
Guard.CornerPush.VelOff    = -12
id = 2020

