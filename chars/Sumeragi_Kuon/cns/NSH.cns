type=C
movetype=A
physics=C
ctrl=0
anim=410
sprpriority=2

;--------------------[変数処理1]

[State 410,汎用変数リセット]
type = null
triggerall = !time
trigger1 = 1
trigger1 = var(0):=0
trigger2 = 1
trigger2 = var(3):=0
trigger3 = 1
trigger3 = var(22):=0
trigger4 = 1
trigger4 = var(23):=0
trigger5 = 1
trigger5 = var(24):=0
trigger6 = 1
trigger6 = fvar(0):=0
trigger7 = 1
trigger7 = fvar(1):=0
trigger8 = 1
trigger8 = fvar(2):=0
ignorehitpause = 1
persistent = 1

[State 410,チェーンコンボフラグ]
type = varset
trigger1 = movecontact||movereversed
var(0) = 1+(movehit>=1)
ignorehitpause = 1
persistent = 0

[State カウンターヒット判定]
type=Varset
trigger1=1
var(15)=(p2movetype=A)*(!numtarget(410))
ignorehitpause=0

;--------------------[動作]

[State 410, 前進]
type     = velset
trigger1 = animelemtime(3) >= 1
trigger1 = animelemtime(8) < 0
x = 0.25

;--------------------[音声]

[State 410, 抜く音]
type     = PlaySnd
trigger1 = animelemtime(3) = 0
value    = s1, 0
persistent=0

[State 410, 振る音]
type     = PlaySnd
trigger1 = animelemtime(4) = 0
value    = s1003, 2
persistent=0

[State 410, 声]
type     = PlaySnd
trigger1 = animelemtime(4) = 0
trigger1 = random%18>=9
value    = s3, 20+(random%3)
channel=0
persistent=0

[State 410, しまう音]
type     = PlaySnd
trigger1 = animelemtime(10) = 0
value    = s1, 1
persistent=0

;--------------------[ヒット定義]

[State 410, HitDef];発生9F レベルC 1800ダメージ 復帰不能56 地上でも吹っ飛び
type                = HitDef
fall.yvelocity      = (-2.5+(enemynear,pos y)*0.010)*(!var(19))
triggerall          = !movecontact&&!movereversed&&roundstate=2
trigger1            = AnimElemtime(4) >= 0
givepower           = floor(1800*0.027),floor(1800*0.008)
getpower = 30,15
attr                = C, NA
hitflag             = MAFD
guardflag           = L
damage              = ceil(1800*fvar(6)*ifelse(var(15)=1,1.25,1)/24),0
animtype            = Hard
ground.type         = low
priority            = 5, hit
pausetime           = 12, 11
sparkno             = -1
sparkxy             = 0, 0
guard.sparkno       = -1
hitsound            = s1002, 3
guardsound          = s1004, 0
ground.slidetime    = 20
ground.hittime      = 20
guard.slidetime     = 20
guard.ctrltime      = 20
airguard.ctrltime   = 22

ground.velocity     = ifelse((!var(19)),-2,-5),-1.5
guard.velocity      = -8
air.velocity        = ifelse((!var(19)),-2,-5),-1.5
airguard.velocity   = -2,-1
down.velocity       = -5,-1.5
fall                = 1
air.fall            = 1
fall.recovertime    = 56*ifelse(var(15)>=1,2,1)+11
yaccel              = 0.48
Ground.CornerPush.VelOff   = -12
Air.CornerPush.VelOff      = -12
Down.CornerPush.VelOff     = -12
Guard.CornerPush.VelOff    = -12
id = 410

;--------------------[変数処理2]

[State ]
type=Varset
triggerall=var(25)=0&&movehit
trigger1=numtarget(410)
var(13)=1
ignorehitpause=1
persistent=0

[State ]
type=Varset
triggerall=var(15)=1&&var(13)=0&&movehit
trigger1=numtarget(410)
var(13)=2
ignorehitpause=1
persistent=0

[State ダメージ補正]
type=Varset
triggerall=movehit
trigger1=numtarget(410)
fvar(7)=fvar(7)*ifelse(var(15)=1,0.935,0.87)
ignorehitpause=1
persistent=0

[State 初段判定削除]
type=Varadd
triggerall=movehit
trigger1=numtarget(410)
var(30)=1
ignorehitpause=1
persistent=0

[State ラヴゲージ上昇]
type=Varadd
trigger1=movecontact&&var(46)=0
var(50)=ifelse(movehit>=1,3,2)
persistent=0
ignorehitpause=1

