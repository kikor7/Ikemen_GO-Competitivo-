trigger1=animelemno(0)=4
statetype=A
physics=N

[State 無敵1]
type=nothitby
trigger1=animelemtime(6)<0
value = SCA,AA,AP,AT
time = 1

[State 無敵2]
type=nothitby
trigger1=animelemtime(6)>=0
trigger1=animelemtime(13)<6
value = ,AP,AT
time = 1

[State 無敵2]
type=nothitby
trigger1=animelemtime(13)>=6
trigger1=animelemtime(15)<0
value = ,AT
time = 1

[State ジャンプ]
type=velset
trigger1=animelemtime(2)=0
x=1
y=-8.3

[State 重力1]
type=veladd
trigger1=animelemtime(2)>=1
trigger1=animelemtime(17)<0
y=const(Movement.yaccel)*0.5

[State 重力2]
type=veladd
trigger1=animelemno(0)>=17
y=const(Movement.yaccel)+0.06

