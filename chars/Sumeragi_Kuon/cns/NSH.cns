type=S
movetype=A
physics=S
ctrl=0
anim=200
sprpriority=2

;--------------------[変数処理1]

[State 200,汎用変数リセット]
type = null
triggerall = !time
trigger1 = 1
trigger1 = var(0):=0
trigger2 = 1
trigger2 = var(3):=0
trigger3 = 1
trigger3 = var(22):=0
trigger4 = 1
trigger4 = var(23):=0
trigger5 = 1
trigger5 = var(24):=0
trigger6 = 1
trigger6 = fvar(0):=0
trigger7 = 1
trigger7 = fvar(1):=0
trigger8 = 1
trigger8 = fvar(2):=0
ignorehitpause = 1
persistent = 1

[State 200,チェーンコンボフラグ]
type = varset
trigger1 = movecontact||movereversed
var(0) = 1+(movehit>=1)
ignorehitpause = 1
persistent = 0

[State カウンターヒット判定]
type=Varset
trigger1=1
var(15)=(p2movetype=A)*(!numtarget(200))

;--------------------[動作]

[State 前進]
type=velset
trigger1=animelemno(0)=[3,5]
x=1

;--------------------[音声]

[State 200, 抜く音]
type     = PlaySnd
trigger1 = animelemtime(2) = 0
value    = s1, 0
persistent=0

[State 200, 振る音]
type     = PlaySnd
trigger1 = animelemtime(4) = 0
value    = s1003, 1
persistent=0

[State 200, 声]
type     = PlaySnd
trigger1 = animelemtime(4) = 0
trigger1 = random%18>=9
value    = s3, 10+(random%3)
channel=0
persistent=0

[State 200, しまう音]
type     = PlaySnd
trigger1 = animelemtime(7) = 0
value    = s1, 1
persistent=0

;--------------------[ヒット定義]

[State 200, HitDef];発生9F レベルB 1000ダメージ 復帰不能20
type                = HitDef
fall.yvelocity      = (-3.5+(enemynear,pos y)*0.010)*(!var(19))
triggerall          = !movecontact&&!movereversed&&roundstate=2
trigger1            = AnimElemno(0) = 4
givepower           = floor(1000*0.027),floor(1000*0.008)
getpower = 30,15
attr                = S, NA
hitflag             = MAFD
guardflag           = M
damage              = ceil(1000*fvar(6)*ifelse(var(15)=1,1.25,1)/24),0
animtype            = Midium
ground.type         = High
priority            = 4, hit
pausetime           = 11, 10
sparkno             = -1
sparkxy             = 0, 0
guard.sparkno       = -1
hitsound            = s1002, 2
guardsound          = s1004, 0
ground.slidetime    = 15
ground.hittime      = 15
guard.slidetime     = 15
guard.ctrltime      = 15
airguard.ctrltime   = 17

ground.velocity     = -6
guard.velocity      = -6
air.velocity        = ifelse((!var(19)),-2.8,-4.2),ifelse((!var(19)),-5,-1.3)
airguard.velocity   = -2.8,-5
down.velocity       = -4.2,-1.3
air.fall            = 1
fall.recovertime    = 20*ifelse(var(15)>=1,2,1)+10
yaccel              = 0.48
Ground.CornerPush.VelOff   = -10
Air.CornerPush.VelOff      = -10
Down.CornerPush.VelOff     = -10
Guard.CornerPush.VelOff    = -10
id = 200

;--------------------[変数処理2]

[State ]
type=Varset
triggerall=var(25)=0&&movehit
trigger1=numtarget(200)
var(13)=1
ignorehitpause=1
persistent=0

[State ]
type=Varset
triggerall=var(15)=1&&var(13)=0&&movehit
trigger1=numtarget(200)
var(13)=2
ignorehitpause=1
persistent=0

[State ダメージ補正]
type=Varset
triggerall=movehit
trigger1=numtarget(200)
fvar(7)=fvar(7)*ifelse(var(30)=0,ifelse(var(15)=1,0.9,0.8),ifelse(var(15)=1,0.955,0.91))
ignorehitpause=1
persistent=0

[State 初段判定削除]
type=Varadd
trigger1=movehit
var(30)=1
ignorehitpause=1
persistent=0

[State ラヴゲージ上昇]
