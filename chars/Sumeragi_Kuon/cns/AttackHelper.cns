Trigger1 = !time
Stateno  = 226
ID       = 226
Pos      = 0,0
PosType  = P1
SuperMoveTime = 0
PauseMoveTime = 0
IgnoreHitPause = 1
persistent=0

[State ヒットエフェクト]
