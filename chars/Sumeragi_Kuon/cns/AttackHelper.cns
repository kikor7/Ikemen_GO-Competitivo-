;--------------------[動作]

[State 無敵]
type=nothitby
trigger1=1
value=SCA,AA,AP,AT
ignorehitpause=1
time=9999

[State 移動1]
type=velset
trigger1=animelemtime(2)=0
x=-(pos x)*0.2*facing
y=(pos y - screenpos y +210)*0.2

[State 移動2-1]
type=velset
trigger1=animelemtime(2)=4
x=0
y=-1*root,fvar(33)

[State 移動2-2]
type=posset
trigger1=animelemtime(2)=4
x=0
y=pos y - screenpos y +210

[State 移動2-3]
type=veladd
trigger1=animelemtime(2)>=4
trigger1=animelemtime(6)<5
y=0.03*(root,fvar(33))**2

[State 移動4]
type=velset
trigger1=animelemtime(6)=5
x=parentdist x/9
y=parentdist y/9

[State 移動5-1]
type=velset
trigger1=animelemtime(8)=1
x=0
y=0

[State 移動5-2]
type=bindtoparent
trigger1=animelemtime(8)>=1
time=1
pos=0,0

