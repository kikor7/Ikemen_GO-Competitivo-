guardsound          = s1004, 0
ground.slidetime    = 15
ground.hittime      = 15
guard.slidetime     = 15
guard.ctrltime      = 15
airguard.ctrltime   = 17

ground.velocity     = -6
guard.velocity      = -6
air.velocity        = ifelse((root,var(19)=0),-1.5,-4),ifelse((root,var(19)=0),-7,-1.2)
airguard.velocity   = -5,-4
down.velocity       = -4,-1.2
air.fall            = 1
fall.recovertime    = 25*ifelse(var(25)>=1,2,1)+4
