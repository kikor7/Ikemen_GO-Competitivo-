[Statedef 627]
type=A
movetype=A
physics=N
ctrl=0
anim=222
sprpriority=7

[State ];透過適応用のお守り
type = trans
trigger1 =root,var(34)=0
trans=add
ignorehitpause=1

[State ];発生保障削除フラグ
type = varadd
trigger1 = root,movetype=H
trigger1 = !(root,var(35)&8)
trigger1 = (root,stateno!=[120,159])
var(0)=1

[State ];影を消す
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State ];無敵
type = nothitby
trigger1 = 1
value = ,AA,AT
time = 9999
ignorehitpause=1

[State ];相殺用
type = hitoverride
trigger1 = 1
attr = SCA,AA,AP,AT
stateno = 225
time = 9999
ignorehitpause=1

;--------------------[変数処理1]

[State カウンターヒット判定]
type=Varset
trigger1=!movecontact
var(25)=(p2movetype=A)*(!numtarget(624))
ignorehitpause=0

[State 角度決定]
type=varset
trigger1=!time
var(1) = (random**(random%3+1))%41-20

[State ずらす]
type=posadd
trigger1=!time
x=floor(var(1)*0.34)
y=-floor(var(1)*0.34)

[State 直線移動判定1]
type=varset
trigger1=!time
trigger1=abs(var(1))>=15
var(2)=ifelse(var(1)>=1,1,-1)

[State 角度-45]
type=varadd
trigger1=!time
var(1) = -45

[State 直線移動判定2]
type=varset
trigger1=var(1)=-45
trigger1=abs(var(2))=1
var(2)=var(2)*2

[State 角度を正す]
type=Varadd
trigger1=time
trigger1=var(1)!=-45
trigger1=var(2)=[-1,1]
var(1) = ifelse(var(1)>-45,-1,1)

[State 角度を正す]
type=Varadd
trigger1=time%2
trigger1=var(2)!=[-1,1]
var(1) = ifelse(var(2)>0,-1,1)

;--------------------[動作]

[State 速度]
type     = velset
trigger1 = 1
x = (9+time*0.2)*cos(var(1)*1.0/(180*1.0/pi))
y = -(9+time*0.2)*sin(var(1)*1.0/(180*1.0/pi))

[State ブレーキ]
type     = velset
trigger1 = movecontact
x = 0
y = 0
ignorehitpause=1

[State 大きさと回転]
type     = angledraw
trigger1 = 1
value = var(1)
scale = (1*root,fvar(32)),(0.75*root,fvar(33))
ignorehitpause=1

;--------------------[音声]

[State 627, 発射音]
type     = PlaySnd
trigger1 = !time
value    = s110, 1
persistent=0

;--------------------[ヒット定義]

[State ];判定削除1
type = attackdist
trigger1 = var(0)
value = 0

[State ];判定削除2
type = statetypeset
trigger1 = var(0)
movetype = I

[State ];判定削除3
type = reversaldef
trigger1 = var(0)
persistent          = 1
reversal.attr       = 
pausetime           = 0,0

[State 627, HitDef];レベルB 400ダメージ 復帰不能25
type                = HitDef
fall.yvelocity      = (-3.5+(enemynear,pos y)*0.010)*(root,var(19)=0)
triggerall          = !movecontact&&!movereversed&&roundstate=2&&!var(0)
trigger1            = ishelper(625)
trigger2            = ishelper(627)
givepower           = floor(400*0.027),floor(400*0.008)
getpower = 30,15
attr                = A, NP
hitflag             = MAFD
guardflag           = MA
damage              = ceil(400*root,fvar(6)*ifelse(var(25)=1,1.25,1)/24),ceil(400*root,fvar(6)/root,fvar(7)/240)
animtype            = midium
ground.type         = Low
priority            = 4, hit
pausetime           = 0, 5
sparkno             = -1
sparkxy             = 0, 0
guard.sparkno       = -1
