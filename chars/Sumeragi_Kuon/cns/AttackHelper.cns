[Statedef 421]
type=A
movetype=A
physics=N
ctrl=0
anim=421
sprpriority=7

[State ];透過適応用のお守り
type = trans
trigger1 =root,var(34)=0
trans=addalpha
ignorehitpause=1

[State ];発生保障削除フラグ
type = varadd
trigger1 = root,movetype=H
trigger1 = !(root,var(35)&8)
trigger1 = (root,stateno!=[120,159])
var(0)=1

[State ];消える
type = changeanim
trigger1 = animtime = 0
value = 1860
persistent = 0

[State ];影を消す
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State ];保険
type = nothitby
trigger1 = 1
value = SCA,AA,AP,AT
time = 9999
ignorehitpause=1

[State ];保険2
type = hitoverride
trigger1 = 1
attr = SCA,AA,AP,AT
stateno = 0
time = 9999
ignorehitpause=1

[State ];保険3
type = RemoveExplod
trigger1 = !time
ignorehitpause=1

[State ];攻撃判定を解く
type = Statetypeset
trigger1 = movereversed
trigger2 = anim = 1860
ignorehitpause=1

;--------------------[変数処理1]

[State カウンターヒット判定]
type=Varset
trigger1=!movecontact
var(25)=(p2movetype=A)*(!numtarget(420))
ignorehitpause=0

;--------------------[動作]

[State 最初の位置]
type     = posadd
trigger1 = !time
y = -20*root,fvar(33)

[State 速度]
type     = velset
trigger1 = time
y = (-4-(root,var(50)>=300)-(root,var(50)>=600))*root,fvar(33)

[State 大きさ1]
type     = angledraw
trigger1 = time<5
scale = ((time+4)*root,fvar(32)/32),((time+5)*root,fvar(33)/10)
ignorehitpause=1

[State 大きさ2]
type     = angledraw
trigger1 = time=[5,13]
scale = (root,fvar(32)/4),((time+5)*root,fvar(33)/10)
ignorehitpause=1

[State 大きさ3]
type     = angledraw
trigger1 = time>13
scale = ((26-time)*root,fvar(32)/52),((time+5)*root,fvar(33)/10)
ignorehitpause=1

;--------------------[音声]

[State 421, 発射音]
type     = PlaySnd
trigger1 = !time
value    = s110, 1
persistent=0

;--------------------[ヒット定義]

[State ];判定削除1
type = attackdist
trigger1 = var(0)
value = 0

[State ];判定削除2
type = statetypeset
trigger1 = var(0)
movetype = I

[State ];判定削除3
type = reversaldef
trigger1 = var(0)
persistent          = 1
reversal.attr       = 
pausetime           = 0,0

[State 421, HitDef];レベルC 1000～1400ダメージ 復帰不能30 地上でも吹っ飛び
type                = HitDef
fall.yvelocity      = (-4.5+(enemynear,pos y)*0.010)*(root,var(19)=0)
triggerall          = !movecontact&&!movereversed&&roundstate=2&&!var(0)
trigger1            = Anim=421
givepower           = floor((1000+200*((root,var(50)>=300)+(root,var(50)>=600)))*0.027),floor((1000+200*((root,var(50)>=300)+(root,var(50)>=600)))*0.008)
getpower = 30,15
attr                = C, NP
