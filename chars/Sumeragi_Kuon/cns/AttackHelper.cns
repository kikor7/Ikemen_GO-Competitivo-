trans=addalpha
ignorehitpause=1

[State ];発生保障削除フラグ
type = varadd
trigger1 = root,movetype=H
trigger1 = !(root,var(35)&8)
trigger1 = (root,stateno!=[120,159])
var(0)=1

[State ];影を消す
type = AssertSpecial
trigger1 = 1
flag = noshadow
ignorehitpause = 1

[State ];無敵
type = nothitby
trigger1 = 1
value = ,AA,AT
time = 9999
ignorehitpause=1

[State ];相殺用
type = hitoverride
trigger1 = 1
attr = SCA,AA,AP,AT
stateno = 232
time = 9999
ignorehitpause=1

;--------------------[変数処理1]

[state 追尾する相手を決める]
type     = varset
trigger1 = !time
trigger2 = time
trigger2 = !playeridexist(var(1))
var(1)  = enemynear,id
ignorehitpause=1

[state 相手の位置をサーチ 速度]
type     = varset
trigger1 = playeridexist(var(1))
fvar(0)  = abs((PlayerID(var(1)),pos y + PlayerID(var(1)),const(size.mid.pos.y)) - pos y)*0.01
ignorehitpause=1

[state 相手の位置をサーチ 向き]
type     = varset
trigger1 = playeridexist(var(1))
var(2)  = ifelse(((PlayerID(var(1)),pos y + PlayerID(var(1)),const(size.mid.pos.y)) - pos y)>0,1,-1)
ignorehitpause=1

[State カウンターヒット判定]
type=Varset
trigger1=!movecontact
var(25)=(p2movetype=A)*(!numtarget(231))
ignorehitpause=0

;--------------------[動作]

[State 初速]
type     = velset
trigger1 = !time
x = 3.5*root,fvar(32)
y = 0

[state 加速1]
type     = veladd
trigger1 = time<20
y = fvar(0)*var(2)*abs(vel x*0.05)*root,fvar(33)
ignorehitpause=1

[state 加速2]
type     = veladd
trigger1 = time>=20
x = -0.05*root,fvar(32)
y = fvar(0)*var(2)*abs(vel x*0.05)*root,fvar(32)
ignorehitpause=1

[state 上限越え防止]
type     = velset
trigger1 = abs(vel y) > root,fvar(33)*abs(vel x*0.3)
y = ifelse(vel y >=0 ,1,-1)*root,fvar(33)*abs(vel x*0.3)
ignorehitpause=1

[State 大きさ1]
type     = null;angledraw
trigger1 = time<5
scale = ((time+4)*root,fvar(32)/32),((time+5)*root,fvar(33)/10)
ignorehitpause=1

;--------------------[音声]

[State 231, 発射音]
type     = PlaySnd
trigger1 = !time
value    = s110, 1
persistent=0

;--------------------[ヒット定義]

[State ];判定削除1
type = attackdist
trigger1 = var(0)
value = 0

[State ];判定削除2
type = statetypeset
trigger1 = var(0)
movetype = I

[State ];判定削除3
type = reversaldef
trigger1 = var(0)
persistent          = 1
reversal.attr       = 
pausetime           = 0,0

[State 231, HitDef];レベルC 800ダメージ 復帰不能30 地上でも吹っ飛び
type                = HitDef
fall.yvelocity      = (-4.5+(enemynear,pos y)*0.010)*(root,var(19)=0)
triggerall          = !movecontact&&!movereversed&&roundstate=2&&!var(0)
trigger1            = 1
givepower           = floor(800*0.027),floor(800*0.008)
getpower = 15,7
attr                = A, NP
hitflag             = MAFD
guardflag           = MA
damage              = ceil(800*root,fvar(6)*ifelse(var(25)=1,1.25,1)/24),ceil(800*root,fvar(6)/root,fvar(7)/240)
animtype            = Hard
ground.type         = Low
priority            = 5, hit
pausetime           = 0, 6
sparkno             = -1
sparkxy             = 0, 0
guard.sparkno       = -1
hitsound            = s1002, 3
guardsound          = s1004, 0
ground.slidetime    = 20
ground.hittime      = 20
guard.slidetime     = 20
guard.ctrltime      = 20
airguard.ctrltime   = 22

ground.velocity     = ifelse((root,var(19)=0),-3,-5),ifelse((root,var(19)=0),-8.5,-1.5)
guard.velocity      = -8
air.velocity        = ifelse((root,var(19)=0),-3,-5),ifelse((root,var(19)=0),-8.5,-1.5)
airguard.velocity   = -5,-5
down.velocity       = -5,-1.5
fall                = 1
air.fall            = 1
fall.recovertime    = 30*ifelse(var(25)>=1,2,1)+6
yaccel              = 0.48
guard.kill          = (root,var(35)&128)
Ground.CornerPush.VelOff   = 0
Air.CornerPush.VelOff      = 0
Down.CornerPush.VelOff     = 0
Guard.CornerPush.VelOff    = 0
id = 231

[State ゲージ回収]
type=poweradd
trigger1=movecontact
value = ifelse(movehit,floor(800*0.09),floor(800*0.041))
persistent=0
ignorehitpause=1

