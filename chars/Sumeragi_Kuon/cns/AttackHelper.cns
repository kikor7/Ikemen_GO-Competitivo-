trans=addalpha
alpha=(time+1)*32,256

[State ];透過2
type = trans
trigger1 = time=[7,12]
trans=addalpha
alpha=256,256

[State ];透過3
type = trans
trigger1 = time>=13
trans=addalpha
alpha=(20-time)*32,256

[State ];終わり
type=DestroySelf
trigger1=!playeridexist(var(0))
trigger2=playerid(var(0)),stateno!=930
trigger3=time>=20

