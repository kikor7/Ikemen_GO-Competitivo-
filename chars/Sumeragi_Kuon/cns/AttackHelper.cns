Trigger1 = MoveHit=1
Trigger1 = numtarget(220)
Trigger1 = var(25)
Name     = "counter"
Stateno  = 7115
ID       = 220
Pos      = 0,0
PosType  = P1
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1
persistent=0

[State ガードエフェクト]
Type     = Helper
Trigger1 = MoveGuarded=1
Name     = "Guard"
Stateno  = 7150
ID       = 220
Pos      = 5,ifelse(enemynear,statetype=C,-50,-100)
PosType  = P2
OwnPal   = 1
size.xscale = 1
size.yscale = 1
SuperMoveTime = 99999
PauseMoveTime = 99999
IgnoreHitPause = 1
persistent=0

;--------------------[終わり]

[State ];破裂する
type=changestate
trigger1=movecontact
trigger2=movereversed
trigger3=pos y > 0
trigger3=vel y > 0
trigger4=var(0)
trigger5=frontedgedist < -100
trigger5=time>=20
value = 225
IgnoreHitPause = 1

