attr = S, HP               ;攻撃の属性「(状態), (属性１)(属性２)」の順番に分かれています
                           ;(状態):S=立ち・C=しゃがみ・A=空中
                           ;(属性１):N=通常技・S=必殺技・H=超必殺技
                           ;(属性２):A=打撃・P=飛び道具・T=投げ
ID = 3502                           
damage = 10, 4              ;ダメージ（ﾋｯﾄ，ｶﾞｰﾄﾞ）
getpower = 30,15;ゲージ回収（ヒット，ガード）

animtype = Hard            ;攻撃を当てた時の「相手の食らいアニメの強さ」を指定
                           ;Light=弱・Medium=中・Hard=強・Back=最強
                           ;Up=垂直吹っ飛び・DiagUp=対角吹っ飛び（錐揉み）
                           
pausetime = 5,5            ;ヒット時の硬直時間（自分，相手）
offset = 45,-72            ;発射位置の座標指定（X，Y）
velocity = 20,0            ;移動速度
remvelocity = 0,0          ;消滅時の移動速度
accel = 0,0                ;加速度

projID =1350             ;飛び道具のID番号
projanim = 1350            ;飛び道具のアニメNo
projhitanim = 1352         ;ヒット時のアニメNo
projremanim = 1352         ;消滅時のアニメNo
projcancelanim = 1352      ;相殺時のアニメNo
projscale = 1,1          ;飛び道具のサイズ
projhits = 1               ;ヒット数
projmisstime = 0           ;ミス時間
projremovetime = -1        ;消えるまでの時間、-1で消えない
projpriority = 1           ;飛び道具の優先度
priority = 5,Hit           ;ヒット優先度、数が多いほど飛び道具を消します

sparkno		= s8010
guard.sparkno	= s8010
sparkxy		= -10, 0
hitsound = S1,2
guardsound = s1,2

guardflag = MA             ;相手がガードに入れる体勢
ground.type = High         ;攻撃がヒットした時の地上の相手の食らいアニメの種類
                           ;High=上段・Low=下段・Trip=足払いでこける・None=何も無し
                           
ground.slidetime = 5      ;攻撃がヒットしたときの相手の仰け反り時間
ground.hittime = 15        ;攻撃がヒットしたときの相手の食らい状態の時間
ground.velocity = -2,0     ;ガード状態のヒット時の移動速度（X,Y)
air.velocity = -3,0        ;ヒット時の相手の食らいの移動速度（X,Y)


