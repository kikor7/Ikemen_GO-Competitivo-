;■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■
;	仮面ライダー鎧武　キャラクターデータセッティング
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━|　 　　基本情報 　　　|━━━━━━━━━━━━━━━━━━━━━━━━
[Info]
name		= "仮面ライダー鎧武"	;キャラの名前
displayname	= "Kamen Rider Gaim"	;表示されるキャラの名前
versiondate	= 03,10,2014		;キャラの更新情報
mugenversion	= 11,22,2000		;キャラが動くmugenのバージョン
author		= "Team Gaim"		;キャラの製作者名
pal.defaults	= 6,3,4,2		;敵としてでるキャラのパレット



;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;━| 必要なファイルの設定 |━━━━━━━━━━━━━━━━━━━━━━━━

[Files]
movelist = movelist.dat
cmd	= gaim.cmd
cns	= gaim.cns
st      = gaim.cns
st0     = SuperArts.cns
st1     = AI.cns
stcommon= common1.cns 
sprite  = gaim.sff
anim    = gaim.air
sound   = gaim.snd
pal1    = gaim.act
pal2    = gaim02.act
pal3    = gaim03.act
pal4    = gaim04.act
pal5    = gaim05.act
pal6    = gaim.act
pal7    = gaim.act
pal8    = gaim.act
pal9    = gaim.act
pal10   = gaim.act
pal11   = gaim.act
pal12   = gaim.act

