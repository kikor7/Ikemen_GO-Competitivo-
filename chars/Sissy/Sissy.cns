trigger1 = vel x > 0
x = -0.72

[State 00]
type = VelSet
trigger1 = vel x <= 0
x = 0

[State 01]
type = PosSet
trigger1 = Time = 0
y = 0

[State 03]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1


