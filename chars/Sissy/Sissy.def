; ここにキャラ情報を書いてください
[Info]
name = "SISSY"        ;キャラの名前
displayname = "SISSY" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ahuron"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
movelist = movelist.dat
cmd     = Sissy.cmd   ;キャラのコマンド
cns     = Sissy.cns   ;キャラのプログラム
st      = Sissy.cns   ;基本動作、必殺技、特殊ゲージ、-2、-3
st2     = Sissy2.cns  ;超必殺技
stcommon = common1.cns 
sprite  = Sissy.sff   ;キャラの絵
anim    = Sissy.air   ;キャラの動き
sound   = Sissy.snd   ;キャラの音
pal1    = Sissy2.act
pal2    = Sissy4.act
pal3    = Sissy6.act
pal4    = Sissy.act
pal5    = Sissy3.act
pal6    = Sissy5.act