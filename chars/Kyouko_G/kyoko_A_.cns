
;______________________________________________________________________________
;==============================================================================
;-| 通常攻撃 |-----------------------------------------------------------------
;==============================================================================
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;---------------------------------------------------------------------------
; Recuperacion tras esquivar/rodar: sin control y golpeable unos frames,
; para que no se pueda encadenar sin riesgo.
;---------------------------------------------------------------------------
[Statedef 1003]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0
velset = 0,0

[State 1003, Fin de la recuperacion]
type = ChangeState
trigger1 = Time >= 12
value = 0
ctrl = 1

[Statedef 700, ev-y]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 700                       ;Change animation (Def: no change)
sprpriority = -1                  ;Set layering priority to 2 (in front)

[State 0, ]
type = AfterImage
trigger1 = Time = 0
time = 20
length = 30
palcolor = 128
palbright = 30,30,30
palcontrast = 120,120,220
palpostbright = 5,5,5
paladd = 10,10,10
palmul = .65,.65,.65
timegap = 1
framegap = 4
trans = add

[State 0, ]
type = SprPriority
trigger1 = 1
value = -1

[State 0, ]
type = VelSet
trigger1 = 1
x = 0
y = 0

[State 0, ]
type = PosSet
trigger1 = 1
y = 0

[State 0, ]
type = NotHitBy
trigger1 = 1
value = SCA,AA,AP
time = 1
ignorehitpause = 1

[State 0, ]
type = PlayerPush
trigger1 = 1
value = 0
ignorehitpause = 1

[State 200, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 1003
ctrl = 0


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Statedef 200, sa/2]
type = S
movetype = A
physics = S
juggle = 1
;velset = 0, 0
ctrl = 0
anim = StateNo
poweradd = 0
sprpriority = 2

[State -1, Width]
type = Width
trigger1 = AnimElemTime(2) < 0
player = 20, 0

[State -1, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State -1, HitDef]
type = HitDef
trigger1 = Time = 0
trigger2 = AnimElemTime(2) = -1
;基礎設定
attr = S, NA	;SCA, NSH, ATP
hitflag = HLA	;HLAFD+- ("+"コンボ中のみhit可,"-"コンボ中Hit不可
guardflag = HLA	;HLA
animtype = Medium	;Light, Medium, Hard, Back, Up, DiagUp
priority = 4, Hit	;1-7(def4), Hit, Miss, Dodge(引き分け)
damage = 43, 0
getpower = 30,15
givepower = 20, 0
pausetime = 9, 9
;スパーク、音
sparkno = s6040 +Random%4
guard.sparkno = s6100
sparkxy = -10, -60	;相手基準
hitsound = s10, 21
guardsound = s10, 101
;相手状態
ground.type = Low	;High, Low, Trip, None
ground.hittime = 12	;与dm時間(硬直後の全体数値
ground.slidetime = 12	;硬直後の押し戻し数値(hittime以下にする
ground.velocity = -3.0
guard.hittime = 8
air.hittime = 15	;項目消すと20固定
air.velocity = -3.0


;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Statedef 210, sb/4]
type = S
movetype = A
physics = S
juggle = 2
;velset = 0, 0
ctrl = 0
anim = StateNo
poweradd = 0
sprpriority = 2

[State -1, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

[State -1, HitDef]
type = HitDef
trigger1 = Time = 0
trigger2 = AnimElemTime(4) = -1
;基礎設定
attr = S, NA	;SCA, NSH, ATP
hitflag = HLAF	;HLAFD+- ("+"コンボ中のみhit可,"-"コンボ中Hit不可
guardflag = HL	;HLA
animtype = Medium	;Light, Medium, Hard, Back, Up, DiagUp
priority = 4, Miss	;1-7(def4), Hit, Miss, Dodge(引き分け)
damage = 58 +(P2StateType=A)*15, 0
getpower = 30,15
givepower = 20, 0
pausetime = 10, 10
;スパーク、音
sparkno = s6020 +Random%4
guard.sparkno = s6100
sparkxy = -15, -80	;相手基準
hitsound = s10, 12
guardsound = s10, 100
;相手状態
ground.type = High	;High, Low, Trip, None
ground.hittime = 17	;与dm時間(硬直後の全体数値
ground.slidetime = 17	;硬直後の押し戻し数値(hittime以下にする
ground.velocity = -3.5
guard.hittime = 11
air.hittime = 24	;項目消すと20固定
air.velocity = -3.0, -4.0


