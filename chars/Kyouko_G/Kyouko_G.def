[Info]
name = "Kyoko_Sakura"			;Name of character
displayname = "Kyouko Sakura"		;Name of character to display
versiondate = 09, 20, 2013	;Version date of character (MM-DD-YYYY)
mugenversion = 04, 14, 2002	;Version of M.U.G.E.N character works on
author = "Waribashi"		;Character author name
pal.defaults = 6, 7, 8, 9	;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
sprite   = kyoko.sff		;Sprite
anim     = kyoko.air		;Animation
sound    = kyoko.snd		;Sound
cmd      = kyoko_cmd_.cns	;Command set
cns      = kyoko.cns		;Constants
stcommon = common1.cns		;Common states
st       = kyoko.cns		;States
st1      = kyoko_-2_.cns
st2      = kyoko_-3_.cns
st3      = kyoko_A_.cns
st4      = kyoko_B_.cns
st5      = kyoko_C_.cns
;st5      = kyoko_D_.cns
;st1      = kyoko_H_.cns
;st8      = kyoko_P2_.cns
;st9      = Config.cns

;Palettes (can have up to 12)
pal1	= act/pal1.act
pal2	= act/pal2.act
pal3	= act/pal3.act
pal4	= act/pal4.act
pal5	= act/pal5.act
pal6	= act/pal6.act
pal7	= act/pal7.act
pal8	= act/pal8.act
pal9	= act/pal9.act
pal10	= act/pal10.act
pal11	= act/pal11.act
pal12	= act/pal12.act

; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
