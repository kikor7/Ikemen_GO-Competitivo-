trigger1=!ishelper
trigger1=teamside=2
trigger1=enemy,authorname="nomucoke-th145"
var(25)=enemy,var(25)
ignorehitpause=1
[state ]
type=varset
trigger1=var(22)
trigger1=var(24)=299
var(25)=1
ignorehitpause=1
[state ]
type=null
trigger1=var(24)=299
;=======================================
;設定
;=======================================
;trigger1=var(25):=( 1 )
;発生するスポットを固定します。
;0~7の間で有効
;0                無効
;1     ピラミッド オカルト必殺技が強化される
;2 ストーンヘンジ 両画面端から壁が迫りフィールドを狭める
;3     バベルの塔 ボールに触れた側の飛び道具化
;4 ナスカの地上絵 ボールに触れるたびに体力とスペルカードゲージが回復する
;5     黄泉比良坂 中央に近寄るほど体力が減少し、減った分はスポット終了時リセットされる
;6         地獄谷 画面下に近寄るほど体力が減少する
;7         月の都 射撃の弾速が下がる(例外あり)

;=======================================
;設定ここまで
;=======================================
ignorehitpause=1
[state ]
type=varrandom
trigger1=var(25)>7
v=25
range=1,7
ignorehitpause=1
;-------------------
;スポット時間
[state ]
type=varadd
trigger1=(var(23)=(0,5000))+(var(23)>5000)
trigger1=!(var(23)%1000)
trigger1=var(24)<841
var(24)=1
ignorehitpause=1
[state ]
type=varset
trigger1=var(24)=841
trigger2=!roundstate
var(24)=0
ignorehitpause=1
[state ]
type=assertspecial
trigger1=var(22)
trigger1=(var(23)=(0,5000))+(var(23)>5000)
trigger1=!(var(23)%1000)
trigger1=var(24)
flag=timerfreeze
ignorehitpause=1
;-------------------
;試合経過時間
[state ]
type=varset
trigger1=!roundstate
var(23)=-101
ignorehitpause=1
[state ]
type=varadd
trigger1=!var(24)
trigger1=roundstate=2
var(23)=1
ignorehitpause=1
;-------------------
;スポット準備
