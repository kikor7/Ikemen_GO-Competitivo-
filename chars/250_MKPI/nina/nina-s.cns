
;---------------------------------------------------------------------
; Pizoton
;---------------------------------------------------------------------

[Statedef 655]
type = A
movetype = A
physics = A
juggle = 4
poweradd = 0
ctrl = 0
anim = 655
sprpriority = 2


[State 0]
	type = PlaySnd
	trigger1 = AnimElem = 3
	value = s500, 4
	channel = 0

[State 0]
	type = PlaySnd
	trigger1 = AnimElem = 3
	value = s200, 2

[State 0]
	type = HitDef
	trigger1 = animelem = 3, = 1
	attr = A, NA
	hitflag = MAF
	damage = 25
	guardflag = HA
	priority = 4
	pausetime = 11,11
	sparkno = s6301
	guard.sparkno = s6401
	sparkxy = ifelse(enemynear, facing = facing, -1 * (enemynear, const(size.ground.back) + enemynear, const(size.ground.front)), 0), -22
	hitsound = s300, 2
	guardsound = s400, 0
	animtype = Med
	ground.type = High
	ground.slidetime = 10
	ground.hittime = 10
	ground.velocity = -5.3
	air.velocity = -3.7, -7.05
	air.hittime = 15
	yaccel = .5

[State 0]
	type = VelSet
	trigger1 = movecontact = 1
	y = fvar(0)

[State 0]
	type = velmul
	trigger1 = movecontact = 1 && vel x && (command = "holdfwd" || command = "holdback" || command = "holdup")
	x = ifelse(command = "holdfwd", 1, ifelse(command = "holdback", -1, 0)) * ifelse(vel x > 0, 1, -1)

[State 0]
	type = VelSet
	trigger1 = movecontact = 1 && frontedgebodydist >= 30 && backedgebodydist >= 30 && !vel x && (command = "holdfwd" || command = "holdback")
	x = ifelse(command = "holdfwd", 1, -1) * ifelse(fvar(0) = const(velocity.jump.y) && var(1), 5, ifelse(fvar(0) = const(velocity.jump.y) && !var(1), 3.33, ifelse(fvar(0) = .8 * const(velocity.jump.y) && var(1), .8 * 5, .8 * 3.33)))

[State 0]
	type = velmul
	trigger1 = 0
	x = ifelse((frontedgebodydist < 30 && vel x > 0) || (backedgebodydist < 30 && vel x < 0), -1, 1)

[State 0]
	type = VelSet
	trigger1 = 0
	x = ifelse(backedgebodydist < 30, 1, -1) * ifelse(fvar(0) = const(velocity.jump.y) && var(1), 5, ifelse(fvar(0) = const(velocity.jump.y) && !var(1), 3.33, 	ifelse(fvar(0) = .8 * const(velocity.jump.y) && var(1), .8 * 5, .8 * 3.33)))

[State 0]
	type = CtrlSet
	trigger1 = movecontact = 1
	value = 1

[State 0]
	Type = StateTypeSet
	Trigger1 = movecontact = 1 || AnimElem = 10
	MoveType = I

