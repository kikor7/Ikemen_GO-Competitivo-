value = 460

; RUN_FWD
[statedef 100]
type    = s
movetype= a
physics = n
ctrl = 1
anim = 100
sprpriority = 1

[state 192, 2]
type = screenbound
trigger1 = prevstateno = 710
value = 0

[state 192, 2]
type = playsnd
trigger1 = animelem = 1
value = s5547, 0

[State 0, Explod]
type = Explod
trigger1 = animelem = 1
anim = 9100
pos = 0,0
postype = p1  ;p2,front,back,left,right
sprpriority = 4
ownpal = 1


[state 100, 1]
type = velset
trigger1 = time = 0
x = 7

[state 100, 5]
type = assertspecial
trigger1 = 1
flag = nowalk

[state 100, 7]
type = changestate
