;立ちA射撃
[Statedef 200]
type     = S
poweradd = 20
movetype = A
physics  = S
juggle   = 1
velset   = 0,0
ctrl     = 0
anim     = 200
sprpriority = 2
facep2   = 1

[State 200, 弾がないならリロードしなさい]
