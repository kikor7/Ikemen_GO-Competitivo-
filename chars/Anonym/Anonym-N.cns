trigger1 = var(6)=6
trigger1 = prevstateno = [0,199];キャンセルリロードはダメよ
value = 260

[State -2, キャンセルフラグOFF]
type = VarSet
trigger1 = Time = 0
var(17) = 0

[State -2, キャンセルフラグON]
type = VarSet
trigger1 = AnimElem = 5, >= 0
var(17) = 1

[State 200, 発射]
type = PlaySnd
trigger1 = var(6)!=6
trigger1 = AnimElem = 4
value = 6,0

[State 200, 空砲]
type = PlaySnd
trigger1 = var(6)=6
trigger1 = AnimElem = 4
value = 6,1

[State 200,銃弾ヘルパー呼び出しその一(下段)]
