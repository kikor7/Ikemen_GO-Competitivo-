trigger1 = var(6)!=6
trigger1 = AnimElem = 4
id = 200
name = "Stand_A1"
pos = 22,-69
postype = P1
stateno = 4000
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[State 200,銃弾ヘルパー呼び出しその二(上段)]
type = Helper
trigger1 = var(6)!=6
trigger1 = AnimElem = 4
id = 201
name = "Stand_A2"
pos = 0,-90
postype = P1
stateno = 4001
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[State -2,弾消費]
type = Varadd
triggerall = var(6) != 6
triggerall = RoundState = 2
trigger1   = AnimElem = 4
v = 6
value = 1

[State 200, ステート変更]
type = ChangeState
triggerall = AnimElem = 5
trigger1 = var(59)<=0
trigger1 = command="holda"
trigger2 = var(59)>0
trigger2 = (p2statetype=L)||(random<200*(var(6)<6))
value = 201

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

