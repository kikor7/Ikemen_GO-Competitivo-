; WinMUGEN専用キャラクター、「アノニム」の定義ファイルです。
; このファイルでキャラクターに必要なファイルを登録しています。

; ※全てのプログラムファイル内においてセミコロン（;）の後に入力した文字は
; 　『コメント化』され、プログラムとして処理されなくなります。
; 　ステート間の区切りを設けたり、メモや注釈を残したりするのに利用できます。

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;	キャラクターインフォメーション
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Info]
name = "Anonym"
displayname = "Anonym"
versiondate = 10,3,??
mugenversion = 06,14,2003
author = "NS"
pal.defaults = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;	キャラを構成するファイルの定義
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Files]
movelist = movelist.dat
Cmd     = Anonym.cmd    		   ;コマンドファイルの登録
StCommon = common1.cns    		  ;コモンステートファイルの登録
Sprite  = Anonym.sff     		  ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = Anonym.air     		  ;アニメーションファイルの登録
Sound   = Anonym.snd     		  ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録
Cns     = Anonym-P.cns       ;コンスタンツファイルの登録
St	= Anonym-N.cns;ステートファイルの登録・最大１１個まで増やせます
St0 = Anonym-S.cns
St1 = Anonym-H.cns
St2 = Anonym-KOSEI.cns
St3 = Anonym-2.cns
St4 = Anonym-P.cns 
St5 = Anonym-AI.cns

;━━━━━━━━━━━━━━━━━━カラーパレットファイル

Pal1 = ano1.act  ;Ａボタンで決定した色が使えます
Pal2 = ano2.act           ;Ｂ
Pal3 = ano3.act           ;Ｃ
Pal4 = ano4.act           ;Ｘ
Pal5 = ano5.act           ;Ｙ
Pal6 = ano6.act           ;Ｚ

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;	ストーリーボード設定
;	・キャラ固有のOP・EDを設定したい場合は、この項目で登録します。
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

[Arcade]
intro.storyboard=
ending.storyboard=
