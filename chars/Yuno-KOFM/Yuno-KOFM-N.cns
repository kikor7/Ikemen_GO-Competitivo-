type = A
movetype= H
physics = N
velset = 0,0
ctrl = 0

[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 0
movecamera = 0,0
ignorehitpause = 1

[State 1000, VelSet]
type = VelSet
triggerall = Hitshakeover
trigger1 = Anim != [5400,5410]
x = -8
y = -6.5

[State 5050, 3]
type = VelAdd
triggerall = Hitshakeover
trigger1 = 1
y = .50

[State 1000, VelMul]
