trigger1 = 1
x = 8

[State 5401, 0]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,0

[State 5401, 1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 5401, 2]
type = PlayerPush
trigger1 = 1
value = 0

[State 5401,3]
type = AfterImage
trigger1 = time = 5
time = 20
TimeGap = 1
FrameGap = 4
length = 10
trans = add1
PalBright = 0, 0, 0
PalContrast = 128,128,128
PalAdd = 0, 0, 0
PalMul = 1,1,1

[State 5401, 4]
