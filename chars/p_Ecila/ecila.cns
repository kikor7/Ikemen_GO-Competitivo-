triggerall = NumPartner = 1
triggerall = command = "holdfwd"
trigger1 = !(partner,name = "Hina_Bardy")
trigger2 = partner,name = "Hina_Bardy"
trigger2 = partner,var(50) <= 0 || partner,alive = 0
x = const(velocity.walk.fwd.x)+((var(40)-1)*0.3)+(var(12)*1)+((var(40)=7)*1.5)
;----------------------------------------

[State 20, 2]
