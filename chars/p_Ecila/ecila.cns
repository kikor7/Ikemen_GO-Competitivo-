[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[state 0,0]
type = stopsnd
trigger1 = prevstateno = 321
trigger1 = time = 0
channel = 3

[state 0,0]
type = stopsnd
trigger1 = prevstateno = 321
trigger1 = time = 0
channel = 2

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State -2, nothitby]
