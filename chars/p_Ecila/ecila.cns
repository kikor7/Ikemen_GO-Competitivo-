;---------------------------------------------------------------------------
; HIT_GETUP 起き上がり
[Statedef 5120]
type    = L
movetype= I
physics = N

[State 103];低ダ先行入力
type = varset
trigger1 = fvar(9) != 0
trigger1 = time = 0
v = 23
value = 0
ignorehitpause = 1

[state a]
type = Turn
trigger1 = Time = 0
trigger1 = ceil(p2dist x) < 0 && EnemyNear,Alive = 1 ;一番近く、生きてる相手が裏に居る時


[State 5120, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 5120, 1b] ;Get up anim (for hit up/diag-up)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim = [5111,5119]
trigger1 = SelfAnimExist(5120 + (anim % 10))
value = 5120 + (anim % 10)

[State 5120, 2]
type = VelSet
trigger1 = Time = 0
x = 0

[State 5120, 3]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 5120, 4]
type = HitFallSet
trigger1 = AnimTime = 0
value = 1

[State 5120, 5] ;Can't be thrown right after getting up 起き上がり後の投げ無敵
type = NotHitBy
trigger1 = AnimTime = 0
value = , NT,ST,HT
time = 5

[State 5120, 6] ;Can't be hit right after getting up (short time) 起き上がり後の打撃無敵
type = NotHitBy
trigger1 = AnimTime = 0
value2 = SCA
time = 1


[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(4) = 0



[State 103, ステート変更]
type = ChangeState
trigger1 = fvar(9) != 0
trigger1 = time > 18
value = fvar(9)


[State 5120, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;空中ダッシュ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;空中なのでtypeとphysicsがＡ、つまり空中です。
;phisicsをＡにすると地上についた瞬間強制的に立ち状態に戻ります。
;途中からctrl = 1にすることで空中ダッシュ中に攻撃ができるようにしてます。

[Statedef 103]
type    = A
movetype= I
physics = N
anim    = 315315   ;前方ジャンプと同じ
velset  = 0,0   ;速度リセット
ctrl    = 0     ;初めは0に
sprpriority = 1

[State 103];低ダ先行入力
type = varset
trigger1 = var(23) != 0
trigger1 = time = 0
v = 23
value = 0
ignorehitpause = 1

[State 103, VarSet]
type = VarSet
trigger1 = var(24) != 0
trigger1 = time = 0
v = 24
value = 0
ignorehitpause = 1

[State 103, VarSet]
type = VarSet
trigger1 = var(59) = 0
trigger1 = time >= 6
trigger1 = command = "x"
v = 24
value = 600
ignorehitpause = 1

[State 103, VarSet]
type = VarSet
trigger1 = var(59) = 0
trigger1 = time >= 6
trigger1 = command = "y"
v = 24
value = 610
ignorehitpause = 1

[State 103, VarSet]
type = VarSet
trigger1 = var(59) = 0
trigger1 = time >= 6
trigger1 = command = "z"
v = 24
value = 620
ignorehitpause = 1

[State 103, VarSet]
type = VarSet
trigger1 = var(59) = 0
trigger1 = time >= 6
trigger1 = command = "2z"
v = 24
value = 650
ignorehitpause = 1

[State -3, ダメージボイス]
type = PlaySnd
trigger1 = time = 1
value = 1234,15

[State 620, Effect]
type = Explod
trigger1 = time = 1
anim = 102
scale = 1,1
postype = p1
pos = 0,0
sprpriority = 2
supermove = 1
ownpal = 1
ID = 102

[State 620, Effect]
type = Explod
trigger1 = time = 1
anim = 104
scale = 1,1
postype = p1
pos = 0,0
sprpriority = 2
supermove = 1
ownpal = 1
ID = 104

[State 103, 回数減]
type = VarAdd
trigger1 = Time = 0
v = 4       ;Var(4)が残り空中ダッシュ回数
value = -1  ;一回ダッシュしたので-1

[State 103, 停止]
type = PosFreeze
trigger1 = Time = [0,1] ;空中で一瞬止まる(Time0から1)

[State 103, 速度決定]
type = VelSet
trigger1 = Time = 2  ;Time2で移動開始
trigger1 = var(40) != 7
x = 5+(var(40)*0.4)

[State 103, 速度決定]
type = VelSet
trigger1 = Time = 2  ;Time2で移動開始
trigger1 = var(40) = 7
x = 9

[State 3900, NotHitBy];１２カラーだと出始め無敵
type = HitBy
triggerall = Time = [0,15]
trigger1 = var(40) = 7
value = SCA,AT
time = 1

[State 103, コマンドOK]
type = CtrlSet
trigger1 = Time = 12  ;Time3で行動可能に
value = 1
[State 103, ステート変更]
type = ChangeState
trigger1 = var(24) != 0
trigger1 = time > 12 && ctrl
value = var(24)

[State 1100, ステート変更]
type = ChangeState
trigger1 = time = 20
value = 110
ctrl = 1

