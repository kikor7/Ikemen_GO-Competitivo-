;勝利時のサウンドストップ
;//////////////////////////////////////////////////////////////////////////
;
[State 1]
type = AssertSpecial
;triggerall = Win
trigger1 = var(21) = 1
trigger2 = var(23) = 1
trigger3 = var(24) = 1
flag = nomusic
ignorehitpause = 1

[State 1]
type = varset
;triggerall = Win
trigger1 = RoundState != 2
v = 26
value = 0


[state a]
type = stopsnd
trigger1 = RoundState = 2
channel = 2
ignorehitpause = 1

[State -2, アーマーヘルパー呼び出し]
type = Helper
triggerall = !NumHelper(9000) && MoveType != H
trigger1 = StateNo = 2300  
trriger1 = AnimElem = 3
name = "Armor"
stateno = 9000
ID = 9000
size.xscale = 1
size.yscale = 1
postype = p1
pos = 0,0
ownpal = 1
supermovetime = 99999
pausemovetime = 99999

[State -2, アーマー中の投げ以外無敵]
type = NotHitBy
trigger1 = NumHelper(9000)
value2 = ,AA,AP
time = 2

[State -2, アーマー中に被弾した時の無敵時間延長（２重被弾抑制処置）]
type = NotHitBy
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = SCA
time = Helper(9000),GetHitVar(hitshaketime)+5

[State -2, アーマー受けした時の点滅]
type = PalFX
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
time = 5
add = 256,10,10

[State -2, アーマー受けした時のライフ減少]
type = LifeAdd
trigger1 = NumHelper(9000)
trigger1 = Helper(9000),GetHitVar(damage)
value = -1*Helper(9000),GetHitVar(damage)
absolute = 1
ignorehitpause = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;カラーによる変化
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;７カラー　攻撃力１．１　超必殺技火力１.１　パワーゲージ１．１　一撃ゲージ1.1
;
;
;８カラー　攻撃力１．２　超必殺技火力１．１５　パワーゲージ１．２　一撃ゲージ1.2
;　　　　
;
;９カラー　攻撃力１．３　超必殺技火力１．１５　パワー１．３　一撃1.3
;　　　
;
;１０カラー攻撃力１．４　超必殺技火力１．２　パワー１.４　一撃1.4
;
;　　　　
;１１カラー攻撃力１．５　超必殺技火力１．２　パワー１．５　一撃1.5
;　　　　　発生に攻撃判定が出るギリギリまで無敵判定付与、パワーゲージ徐々に回復
;
;１２カラー攻撃力２　　超必殺技火力１．４　パワー２　一撃ゲージ2
;　　　　　全技に発生保障、パワーゲージ、体力、一撃ゲージが徐々に回復
;
;var(40) = 1 ;通常カラー
;var(40) = 2 ;7カラー
;var(40) = 3 ;8カラー
;var(40) = 4 ;9カラー
;var(40) = 5 ;10カラー
;var(40) = 6 ;11カラー
;var(40) = 7 ;12カラー
;fvar(0) →攻撃力
;fvar(1) →パワーゲージ
;fvar(6) →一撃ゲージ
;fvar(17)→超必殺技補正
;=============================================================================
;攻撃力、防御力の変数
;=============================================================================
[state a]
type = varset
trigger1 = var(40) = 1
fv = 0
value = 1

[state a]
type = varset
trigger1 = var(40) = 2
fv = 0
value = 1.1

[state a]
type = varset
trigger1 = var(40) = 3
fv = 0
value = 1.2

[state a]
type = varset
trigger1 = var(40) = 4
fv = 0
value = 1.3

[state a]
type = varset
trigger1 = var(40) = 5
fv = 0
value = 1.4

[state a]
type = varset
trigger1 = var(40) = 6
fv = 0
value = 1.5

[state a]
type = varset
trigger1 = var(40) >= 7
fv = 0
value = 2.0

;=============================================================================
;超必殺技の変数
;=============================================================================
[state a]
type = varset
trigger1 = var(40) = 1
fv = 17
value = 1

[state a]
type = varset
trigger1 = var(40) = 2
fv = 17
value = 1.1

[state a]
type = varset
trigger1 = var(40) = 3
fv = 17
value = 1.15

[state a]
type = varset
trigger1 = var(40) = 4
fv = 17
value = 1.15

[state a]
type = varset
trigger1 = var(40) = 5
fv = 17
value = 1.2

[state a]
type = varset
trigger1 = var(40) = 6
fv = 17
value = 1.2

[state a]
type = varset
trigger1 = var(40) >= 7
fv = 17
value = 1.4

;=============================================================================
;パワーゲージ
;=============================================================================
[state a]
type = varset
trigger1 = var(40) = 1
fv = 1
value = 1

[state a]
type = varset
trigger1 = var(40) = 2
fv = 1
value = 1.1

[state a]
type = varset
trigger1 = var(40) = 3
fv = 1
value = 1.2

[state a]
type = varset
trigger1 = var(40) = 4
fv = 1
value = 1.3

[state a]
type = varset
trigger1 = var(40) = 5
fv = 1
value = 1.4

[state a]
type = varset
trigger1 = var(40) = 6
fv = 1
value = 1.5

[state a]
type = varset
trigger1 = var(40) >= 7
fv = 1
value = 2

;１１カラー以上で徐々に回復
[state -2]
type = poweradd
triggerall = !powermax
triggerall = gametime % 1 = 0
trigger1 = var(40) = 6
value = 1

;---------------------------------------------------------------------
;１２カラー用のパワーゲージ回復
;---------------------------------------------------------------------
[state -2]
type = poweradd
triggerall = ((power*1000)/powermax) < 334
triggerall = gametime % 1 = 0
trigger1 = var(40) >= 7
value = 4

[state -2]
type = poweradd
triggerall = ((power*1000)/powermax) = [334,666]
triggerall = gametime % 1 = 0
trigger1 = var(40) >= 7
value = 3

[state -2]
type = poweradd
triggerall = ((power*1000)/powermax) > 666
triggerall = gametime % 1 = 0
trigger1 = var(40) >= 7
value = 2

[state -2]
type = powerset
trigger1 = var(11) = 1
trigger1 = power != powermax
value = powermax

;---------------------------------------------------------------------
;１２カラー用の体力回復
;---------------------------------------------------------------------
;３分の２以上だと回復速度は１Ｆ毎に0.25
;被ダメージ中は上の５分の１の速度で回復する
[state -2]
type = lifeadd
triggerall = alive
triggerall = ((life*1000)/lifemax) >= 667
triggerall = var(40) >= 7
trigger1 = gametime % 4 = 0
trigger1 = movetype != H
trigger2 = gametime % 16 = 0
trigger2 = movetype = H
value = 1

;３分の１以上だと回復速度は１Ｆ毎に0.5
[state -2]
type = lifeadd
triggerall = alive
triggerall = ((life*1000)/lifemax) = [334,666]
triggerall = var(40) >= 7
trigger1 = gametime % 2 = 0
trigger1 = movetype != H
trigger2 = gametime % 8 = 0
trigger2 = movetype = H
value = 1

;３分の１以下だと回復速度は１Ｆ毎に１
[state -2]
type = lifeadd
triggerall = alive
triggerall = ((life*1000)/lifemax) <= 333
triggerall = var(40) >= 7
trigger1 = gametime % 1 = 0
trigger1 = movetype != H
trigger2 = gametime % 4 = 0
trigger2 = movetype = H
value = 1

