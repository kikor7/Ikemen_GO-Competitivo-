physics = S
anim = 40
ctrl = 0
sprpriority = 1

[state a]
type = Turn
trigger1 = ceil(p2dist x) < 0 && EnemyNear,Alive = 1 ;一番近く生きてる相手が裏に居る時

[State 1400, NotHitBy];投げ無敵
