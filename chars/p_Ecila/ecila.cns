;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;          エシリアの基本データ　　　　　　　　　　　　　　　THE.ecilacns.file
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Data]
life              = 1000  ;体力ゲージの最大値を決めます
power             = 3000  ;パワーゲージ最大値（デフォルトは 3000 = Lv.3 になります・オプション）
attack            = 88   ;攻撃力パーセンテージ（デフォルトは 100% になります）
defence           = 97   ;防御力パーセンテージ（デフォルトは 100% になります）
fall.defence_up   = 50    ;一時的に上昇するダウン時の防御力パーセンテージ
liedown.time      = 60    ;倒れてから起き上がるまでの時間
airjuggle         = 80    ;ジャグルポイント限界値　★１
sparkno           = 2     ;デフォルトのヒットスパーク番号（fightfx.airか、キャラのairから呼び出す）
guard.sparkno     = 40    ;デフォルトのガードスパーク番号（fightfx.airか、キャラのairから呼び出す）
KO.echo           = 0     ;ＫＯ時の声にエコーを掛けるかどうか（0=しない・1=する）
volume            = 115   ;キャラの音量　255が最高
intpersistindex   = 0    ;Varを次のラウンドへ持ち越しが可能 (最小=0, 最大=59)  ★２
floatpersistindex = 15    ;FVarを次のラウンドへ持ち越しが可能 (最小=0, 最大=39) ★２
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Size]
xscale           = 0.36
yscale           = 0.36
ground.back      = 16       ;キャラの幅（地上後方）
ground.front     = 14      ;キャラの幅（地上前方）
air.back         = 16       ;キャラの幅（空中後方）
air.front        = 20      ;キャラの幅（空中前方）
height           = 58       ;跳び越す相手のためのキャラの高さ
attack.dist      = 160      ;攻撃を出した時に相手がガード体勢に入る最低の距離
proj.attack.dist = 90       ;相手がガード体勢に入る発射物との最低の距離
proj.doscale     = 0        ;xscaleとyscaleが発射物のスケールにも影響するかどうか（0=しない・1=する）
head.pos         = -5, -90  ;BindToTargetの時に必要な頭の座標
mid.pos          = -5, -60  ;BindToTargetの時に必要な体中心の座標
shadowoffset     = 0        ;影の垂直方向の位置
draw.offset      = 0,0      ;キャラ描画表示位置（Ｘ軸,Ｙ軸）
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
[Velocity]
walk.fwd     = 2.8,1.5         ;前進歩行速度
walk.back    = -2.8,1      ;後退歩行速度
run.fwd      = 10, 2      ;前に走る時の速度（Ｘ軸,Ｙ軸）
run.back     = -6.6, 0   ;後ろに走る時の速度（Ｘ軸,Ｙ軸）
jump.neu     = 0,-9    ;垂直ジャンプ速度（Ｘ軸,Ｙ軸）
jump.back    = -3,8.5        ;後ジャンプ速度
jump.fwd     = 3,8.5     ;前ジャンプ速度
runjump.back = -4.5,-9  ;後ろに走りながらのジャンプ速度（オプション）
runjump.fwd  = 4.5,-9     ;前に走りながらのジャンプ速度（オプション）
airjump.neu  = 0,-7      ;空中垂直ジャンプ速度（オプション）
airjump.back = -3,6      ;空中後ジャンプ速度（オプション）
airjump.fwd  = 3,6     ;空中前ジャンプ速度（オプション）

[Movement]
airjump.num     = 1      ;空中ジャンプが出来る回数（オプション）
airjump.height  = 33     ;空中ジャンプするために必要な最低限の高さ（オプション）
yaccel          = .42    ;重力（垂直下降加速度）
stand.friction  = .85    ;立ち状態の摩擦係数
crouch.friction = .82    ;しゃがみ状態の摩擦係数

;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 5


[State 5900, 0]
type = VarSet
Trigger1 = PalNo = [1,11]
var(40) = 1

;画面端めくり制限
[State -3]
type = Width
trigger1 = movetype != H
edge = 5,0
IgnoreHitPause = 1

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = [1,11]
var(29) = 1

;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; 12Pカラー強化オプション
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;------------------------------------------------------------------------------
;基礎強化
;------------------------------------------------------------------------------
;var(40) = x
;xの値で以下の補正うけます。1~7のうち一つを選んでください。7以上を書いても7の補正になります
;x= 1　攻撃力１　    超必殺技火力１　   パワーゲージ１　    一撃ゲージ1
;x= 2　攻撃力１．１　超必殺技火力１.１　パワーゲージ１．１　一撃ゲージ1.1
;
;
;x= 3　攻撃力１．２　超必殺技火力１．１５　パワーゲージ１．２　一撃ゲージ1.2
;　　　　
;
;x= 4  攻撃力１．３　超必殺技火力１．１５　パワー１．３　一撃1.3
;　　　
;
;x= 5  攻撃力１．４　超必殺技火力１．２　パワー１.４　一撃1.4
;　　　　
;x= 6  攻撃力１．５　超必殺技火力１．２　パワー１．５　一撃1.5
;　　　　　発生に攻撃判定が出るギリギリまで無敵判定付与、パワーゲージ徐々に回復
;
;x= 7  攻撃力２　　超必殺技火力１．４　パワー２　一撃ゲージ2
;　　　　　全技に発生保障、パワーゲージ、体力、一撃ゲージが徐々に回復
;初期値は1に設定してあります

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(40) = 1

;-------------------------------------------------------------------------------
;神気解放カラー
;-------------------------------------------------------------------------------
;var(12) = x
;xを0か1に設定してください。
;x =0 通常通り
;x =1 神気解放カラー。俗に言う強化カラー。技が強化される
;初期値は1に設定してあります。

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(12) = 1

;--------------------------------------------------------------------------------
;パワーゲージ
;--------------------------------------------------------------------------------
;var(11) = x
;xを0か1に設定してください。
;x = 0　通常通り
;x = 1 ゲジマユ
;初期値は0に設定してあります。

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(11) = 0

;--------------------------------------------------------------------------------
;一撃ゲージ
;--------------------------------------------------------------------------------
;var(49) = x
;xを0-2のどれかに設定してください。
;x =0 通常通り
;x =1 １ラウンド目から一撃必殺技が使えるようになる
;x =2 １ラウンド目から一撃が使えるようになり、常時ゲージMAX
;初期値は0に設定してあります

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(49) = 0

;--------------------------------------------------------------------------------
;キャロ
;--------------------------------------------------------------------------------
;var(29) = x
;xを0-2のどれかに設定してください。
;x =0 キャロ召喚できない。経験値たまらない
;x =1 標準
;x =2 キャロ自動回復経験値２倍
;x =3 キャロ常時星５
;初期値は1に設定してあります

[State 5900, 0]
type = VarSet
Trigger1 = PalNo = 12
var(29) = 1
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;オプション終わり
