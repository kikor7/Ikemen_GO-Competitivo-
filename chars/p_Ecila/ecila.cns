;---------------------------------------------------------------------------------
[Statedef -3];常時監視ステート(p2statenoなどで相手に行動を制御された時は実行しない)
;---------------------------------------------------------------------------------

;これはジャンプ後とバックステップ後に着地音を鳴らすコントローラです。
[State -3, 音を鳴らす]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;ジャンプ後の着地
trigger2 = stateno = 106 ;バックステップ後の着地
value = 40, 0


;以下のいくつかの項目は、大部分のボイスを設定しています。

[State -3,ダメージボイス ランダム]
type = varrandom
triggerall = alive = 1
triggerall = time = 0
trigger1 = stateno=5000 || stateno=5010 || stateno=5020 ;ダメージの瞬間
trigger2 = stateno = 5070 || stateno = 5080             ;ダメージの瞬間
v = 7
range = 0,2

[State -3,ダメージボイス ランダム]
type = varrandom
triggerall = alive = 1
triggerall = time = 0
trigger1 = stateno = 5200 || stateno = 5210 ;受身直後
trigger1 = stateno = 5120
v = 7
range = 0,3

[State -3, ダメージボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive
triggerall = Random < 600
trigger1 = stateno=5000 || stateno=5010 || stateno=5020 ;ダメージの瞬間
trigger2 = stateno = 5070 || stateno = 5080             ;ダメージの瞬間
value = 5000,var(7)
channel = 0 ;チャンネルを決定しています。同じチャンネルの音は重なりません。

[State -3, 受身ボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive
trigger1 = stateno = 5200 || stateno = 5210 ;受身直後
value = 5200,0
channel = 0 ;そのおかげで、各ボイスが同時に発せられることがなくなります。

[State -3, 起き上がりボイス]
type = PlaySnd
triggerall = Time = 1
triggerall = Alive
trigger1 = stateno = 5120
value = 5200,0
channel = 0

;ここで空中ダッシュ回数を決定・リセットしてます。
[State -3, 空中ダッシュ回数]
type = VarSet
trigger1 = floor(pos Y) >= 0 ;着地すると回数が戻る
trigger2 = stateno = [0,20]  ;立ち～歩きステートでもリセット
v = 4
value = 1

;空中ガード
[State -3]
type = ChangeState
value = 132
triggerall = statetype = A
triggerall = ctrl
trigger1 = command = "holdback"
trigger1 = inguarddist
trigger1 = Stateno != [120,154]



;================================================================================
;AI殺しに対策
;=============================================================================
[State -2, AttackDist Support]; AttackDistが届かないところは補助ヘルパー設置
type = Helper
triggerall = !NumHelper(2500) && MoveType = A
trigger1 = StateNo = 3101
trigger2 = StateNo = 3121
trigger3 = StateNo = 3000
trigger4 = StateNo = 3200
name = "AttackDist"
ID = 2500
stateno = 2500
ownpal = 1
postype = p1
pos = 0,0
size.xscale = 1
size.yscale = 1
supermovetime = 99999
pausemovetime = 99999

;==============================================================================
[Statedef 2500]; AttackDist補助ヘルパー
;==============================================================================
type = A
movetype = A
physics = N
anim = 410598 ;;０番アニメでもいいけど出来ればやられ判定の無いActionNo
ctrl = 0

;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
[State 9100, -1/NotHitBy]; 無敵
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 9100, -1/AssertSpecial]; 影消し＋非表示
type = AssertSpecial
trigger1 = 1
flag = NoShadow
flag2 = Invisible

[State 9100, -1/BintToParent]; 本体に追従
type = BindToParent
trigger1 = 1
pos = 0,0 ;設置地点を変える場合はここを弄る
facing = 1 ;向きを変える時（逆方向にAttackDistを出現させる場合等）はここを -1 に

[State 9100, -1/AttackDist]; ガード認識距離
type = AttackDist
trigger1 = 1
value = 300

;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
[State 9100, F/DestroySelf]; 消滅処理
type = DestroySelf
trigger1 = Root,StateNo != 3101 ;親が該当ステートじゃなくなったらゴミ箱
trigger1 = Root,StateNo != 3121 ;同上／複数ステートが該当する場合も全部 trigger1
trigger1 = Root,stateno != 3000
trigger1 = Root,stateno != 3200

;- - - - - - - - - - - - - - - - - - - - - - - - - - - - - 
[State 9100, F/SelfState]; 間違いで本体が来たら立ちへ移行
type = SelfState
trigger1 = !IsHelper
value = 0
ctrl = 1

