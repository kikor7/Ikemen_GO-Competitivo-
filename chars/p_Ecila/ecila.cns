trigger1 = roundstate != 2
trigger2 = roundstate = 2 && !ctrl
value = SCA
time = 1

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
triggerall = !NumPartner
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)+((var(40)-1)*0.3)+(var(12)*1)+((var(40)=7)*1.5)

;----------------------------------------
;シンフォニーバフ対応
[State 20, 1-1]
type = VelSet
triggerall = NumPartner = 1
triggerall = partner,name = "Hina_Bardy"
trigger1 = command = "holdfwd"
trigger1 = partner,var(50) >= 5
trigger1 = partner,var(50) > 4
trigger1 = partner,alive = 1  ;パートナーが生きている時のみ有効
x = (const(velocity.walk.fwd.x)+((var(40)-1)*0.3)+(var(12)*1)+((var(40)=7)*1.5))*2.5

[State 20, 1-2]
type = VelSet
triggerall = NumPartner = 1
triggerall = partner,name = "Hina_Bardy"
trigger1 = command = "holdfwd"
trigger1 = partner,var(50) <= 4
trigger1 = partner,var(50) > 3
trigger1 = partner,alive = 1  ;パートナーが生きている時のみ有効
x = (const(velocity.walk.fwd.x)+((var(40)-1)*0.3)+(var(12)*1)+((var(40)=7)*1.5))*2

[State 20, 1-3]
type = VelSet
triggerall = NumPartner = 1
triggerall = partner,name = "Hina_Bardy"
trigger1 = command = "holdfwd"
trigger1 = partner,var(50) <= 3
trigger1 = partner,var(50) > 2
trigger1 = partner,alive = 1  ;パートナーが生きている時のみ有効
x = (const(velocity.walk.fwd.x)+((var(40)-1)*0.3)+(var(12)*1)+((var(40)=7)*1.5))*1.8

[State 20, 1-4]
type = VelSet
triggerall = NumPartner = 1
triggerall = partner,name = "Hina_Bardy"
trigger1 = command = "holdfwd"
trigger1 = partner,var(50) <= 2
trigger1 = partner,var(50) > 1
trigger1 = partner,alive = 1  ;パートナーが生きている時のみ有効
x = (const(velocity.walk.fwd.x)+((var(40)-1)*0.3)+(var(12)*1)+((var(40)=7)*1.5))*1.6

[State 20, 1-5]
type = VelSet
triggerall = NumPartner = 1
triggerall = partner,name = "Hina_Bardy"
trigger1 = command = "holdfwd"
trigger1 = partner,var(50) <= 1
trigger1 = partner,var(50) > 0
trigger1 = partner,alive = 1  ;パートナーが生きている時のみ有効
x = (const(velocity.walk.fwd.x)+((var(40)-1)*0.3)+(var(12)*1)+((var(40)=7)*1.5))*1.4

[State 20, 1-6]
