; SGUARDHIT (shaking)
[Statedef 150]
type    = S
movetype= U
physics = N
velset = 0,0

[State 120, 2]
type = varset
trigger1 = time = 0
var(3) = ifelse((var(2) = [1,6]),1,0)
[State 120, 2]
type = StateTypeSet
trigger1 = time = 0
trigger1 = var(2) = [1,6]
movetype = I
ignorehitpause = 1
[State 120, 2]
type = StateTypeSet
trigger1 = time = 0
trigger1 = var(2) >= 7
movetype = H
ignorehitpause = 1

[State 901 , 4]
type = lifeadd
trigger1 = time = 0
trigger1 = var(2) = [1,6]
value = ceil(gethitvar(damage) * (0.75+fvar(31))) + ceil(5*(1+fvar(31))*(1+fvar(31)))
ignorehitpause = 1
[State 901 , 4]
type = poweradd
trigger1 = time = 0
trigger1 = var(2) = [1,6]
value = ceil(gethitvar(damage) * (4+fvar(31))) + ceil(25*(1+fvar(31))*(1+fvar(31)))
ignorehitpause = 1

[State 901 , 4]
type = varset
trigger1 = time = 0
var(4) = ifelse((var(2) = [1,6]) ,0,1)

[State 210 , 1]
type = playsnd
trigger1 = time = 0
trigger1 = var(2) = [1,6]
value = 150,0
volume = 180

[State 1001,2]
type = explod
trigger1 = var(2) = [1,6]
trigger1 = time = 0
anim = F3
postype = p1
pos = 10,-50
sprpriority = 3
trans = addalpha
alpha = 250,256
ownpal = 1
facing = -1
ignorehitpause = 1
pausemovetime = 9999

[State 1001,2]
type = allpalfx
trigger1 = var(2) = [1,6]
trigger1 = time = 0
add = -100,0,0
time = 2
[State 1001,2]
type = pause
trigger1 = var(2) = [1,6]
trigger1 = time = 0
time = 10

[State 1001,2]
type = removeexplod
trigger1 = time = 0
id = 120
ignorehitpause = 1

[State 1001,2]
type = explod
trigger1 = time = 0
anim = 156
id = 120
postype = p1
pos = 0,0
bindtime = -1
sprpriority = 3
trans = addalpha
alpha = 250,256
ownpal = 1
ignorehitpause = 1

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

