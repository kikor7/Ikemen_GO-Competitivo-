;v00 = color palette
;v01 = 110
;v02 = JD
;v03 = JD_flag
;v04 = JD_HitVelSet X
;v05 = JD_HitVelSet Y
;v06 = JD_life
;v07 = JD_power
;v08 = 1200
;v09 = 1300X
;v10 = 1300X'
;v11 = 2100
;v12 = ID
;v13 = あきらめ子
;v14 = Win
;v15 = 33333
;v16 = 195
;v17 = 2270
;v18 = 2200
;v19 = 2210
;v20 = 3100
;v21 = 3000
;v22 = 191
;v23 = 1211
;v24 = 1500_kabe
;v25 = 空中技ヒットフラグ
;v30 = Life保存
;v56 = AI_1300
;v57 = superline
;v58 = lose
;v59 = AI
;--------------------------
;fv02 = scale x
;fv03 = scale y
;fv04 = angle
;fv05 = 補正
;fv06 = pow
;fv07 = def
;fv08 = 補正2
;fv09 = vel x
;fv10 = vel y
;fv31 = ゲージ補正(赤)
;fv32 = ゲージ補正(青1)
;fv33 = ゲージ補正(青2)
;fv37 = 毒
;fv38 = 投げ抜け
[Data]
life=1000
attack=100
power=3000
defence=100
fall.defence_up=50
liedown.time=60
airjuggle=12
sparkno = 2
guard.sparkno = 40
volume=0
ko.echo = 1
IntPersistIndex = 57
FloatPersistIndex = 30

[Size]
xscale=1.0
yscale=1.0
z.width=3
ground.back=10
ground.front=10
air.back=12
air.front=12
height=75
head.pos = 2, -58
mid.pos = 10, -28
attack.width=0
attack.dist=160
proj.attack.dist=90
proj.doscale=0

[Movement]
airjump.num=0
airjump.height=60
yaccel=0.43
crouch.friction=0.82
stand.friction=0.85

[Velocity]
walk.fwd  = 4.2
walk.back = -3.2
run.fwd = 4.6
run.back = -4.6
jump.neu = 0,-8
jump.back = -3
jump.fwd = 3
runjump.fwd = 3,-6.5
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != [0,5]
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0+var(16)

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdfwd"
trigger2 = var(59)
trigger2 = !inguarddist
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdback"
trigger2 = var(59)
trigger2 = inguarddist
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 2]
type = ChangeAnim
trigger1 = time = 0
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdfwd"
trigger2 = var(59)
trigger2 = !inguarddist
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = !var(59)
trigger1 = command = "holdback"
trigger2 = var(59)
trigger2 = inguarddist
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)*0.7

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = animtime = 0
trigger1 = Vel y > 1
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 3]
type = velset
trigger1 = Vel y > 1
trigger1 = command != "holddown"
y = 2.5

[State 50, 3]
type = veladd
triggerall = Vel y > 1
triggerall = time >= 0
triggerall = vel X <= 0
trigger1 = !var(59)
trigger1 = command = "holdfwd"
trigger2 = var(59)
trigger2 = p2bodydist x < - 5
x = 0.1

[State 50, 3]
type = veladd
trigger1 = Vel y > 1
trigger1 = command = "holdback"
trigger1 = time >= 0
trigger1 = vel X >= 0
x = -0.1
;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
movehitpersist = var(59)
facep2 = var(59)

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
[Statedef 100]
type    = S
movetype= I
anim = 100
ctrl = 0
velset = const(velocity.run.fwd.x),0

[State 100, 0]
type = assertspecial
trigger1 = 1
flag = nowalk

[State 101, 4]
type = ctrlset
trigger1 = time > 5
value = 1

[State 101, 4]
type = ChangeState
triggerall = time > 10
trigger1 = command = "holdback" || command = "holdup" || command = "holddown"
trigger2 = command != "holdfwd"
trigger2 = command != "holdback"
trigger2 = command != "holdup" 
trigger2 = command != "holddown"
value = 0
ctrl=1
;---------------------------------------------------------------------------
[Statedef 105]
type    = S
movetype= I
anim = 105
ctrl = 0
velset = const(velocity.run.back.x),0

[State 100, 0]
type = assertspecial
trigger1 = 1
flag = nowalk

[State 101, 4]
type = ctrlset
trigger1 = time > 5
value = 1

[State 101, 4]
type = ChangeState
triggerall = time > 10
trigger1 = command = "holdfwd" || command = "holdup" || command = "holddown"
trigger2 = command != "holdfwd"
trigger2 = command != "holdback"
trigger2 = command != "holdup" 
trigger2 = command != "holddown"
value = 0
ctrl=1
;---------------------------------------------------------------------------
[Statedef 110]
type    = A
movetype= I
anim = 100
ctrl = 0
velset = 5.5,0

[State 132, 3]
type = VarSet
trigger1 = time = 0
var(1) = 1

[State 210 , 1]
type = playsnd
trigger1 = time = 0
value = 110,0

[State 101, 4]
type = ctrlset
trigger1 = time >= 3
value = 1

[State 101, 4]
type = ChangeState
triggerall = time > 10
trigger1 = command != "holdfwd"
trigger2 = time > 30
value = 50
ctrl=1
;---------------------------------------------------------------------------
[Statedef 111]
type    = A
movetype= I
anim = 105
ctrl = 0
velset = -5.5,0

[State 132, 3]
type = VarSet
trigger1 = time = 0
var(1) = 1

[State 210 , 1]
type = playsnd
trigger1 = time = 0
value = 110,0

[State 101, 4]
type = ctrlset
trigger1 = time >= 3
value = 1

[State 101, 4]
type = ChangeState
triggerall = time > 10
trigger1 = command != "holdback"
trigger2 = time > 30
value = 50
ctrl=1
;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 50, 3]
type = veladd
trigger1 = statetype = A
trigger1 = command = "holdfwd"
trigger1 = time >= 0
trigger1 = vel X <= 0
x = 0.1

[State 50, 3]
type = veladd
trigger1 = statetype = A
trigger1 = command = "holdback"
trigger1 = time >= 0
trigger1 = vel X >= 0
x = -0.1

[State 1001,2]
type = explod
trigger1 = !numexplod(120)
trigger1 = time = 0
anim = 155
id = 120
postype = p1
pos = ifelse(statetype = C,10,0),ifelse(statetype = C,30,0)
bindtime = -1
sprpriority = 3
trans = addalpha
alpha = 220,256
ownpal = 1

[State 1001,2]
type = modifyexplod
trigger1 = 1
id = 120
pos = ifelse(statetype = C,10,0),ifelse(statetype = C,30,0)
trans = addalpha
alpha = 220,256
ownpal = 1
bindtime = -1

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
[Statedef 130]
type    = S
physics = S

[State 1001,2]
type = modifyexplod
trigger1 = time = 0
id = 120
anim = 156
trans = addalpha
alpha = 250,256
bindtime = -1

[State 130, Hi to Lo]
type = ChangeState
trigger1 = command = "holddown"
value = 131

[State 130, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

