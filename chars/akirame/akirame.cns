[State 毒];これが毒解除のフラグになります。トリガーはキャラによって任意でどうぞ。
type = null;varset
trigger1 = movetype = H
fvar(37) = 0

[State 投げ抜け]
type = varset
trigger1 = movetype = A
fvar(38) = 0
[State 投げ抜け];ここが投げ抜け可能タイミングになります。トリガーはキャラによってお好きでいいのよ
type = varset
trigger1 = stateno = [0,99]
trigger1 = movetype = I
trigger2 = ctrl
trigger2 = stateno = [120,159]
fvar(38) = 4
[State 投げ抜け]
type = varadd
trigger1 = movetype != H
trigger1 = fvar(38) > 0
fvar(38) = -1


[State 空中フラグリセット]
type = varset
trigger1 = stateno = [0,99]
var(25) = 0
ignorehitpause = 1
persistent = 0

;-------------------------------------------------------------------------------
;ダメージボイスとか

[State 通常ダメージ]
type = PlaySnd
triggerall = Alive
triggerall = movetype = H
triggerall = stateno != [120,159]
trigger1 = random%5 = 0||(var(30)-life)<100
trigger1 = var(30) > life
trigger2 = hitfall = 0
trigger2 = random%5 = 0
trigger2 = stateno=5000||stateno=5010||stateno=5020||stateno=5070
trigger2 = time = 1
value = 10000+var(0),5000+random%2
channel = 0
lowpriority = 1

[State 大ダメージ]
type = PlaySnd
triggerall = Alive
triggerall = movetype = H
triggerall = stateno != [120,159]
trigger1 = random%5 = 0
trigger1 = stateno=5000||stateno=5010||stateno=5020
trigger1 = time = 1
trigger1 = hitfall = 1
trigger2 = random%5 = 0
trigger2 = (var(30)-life)>=100
value = 10000+var(0),5010
channel = 0
lowpriority = 1

[State ガード]
type = PlaySnd
triggerall = Alive
trigger1 = stateno = [150,159]
trigger1 = time = 1
trigger1 = random%4 = 0
value = 10000+var(0),0+random%3+(random%3*50)
channel = 0
lowpriority = 1

[State 起き上がり]
type = PlaySnd
triggerall = Alive
trigger1 = stateno=5120||stateno=5200||stateno=5210
trigger1 = time = 1
value = 10000+var(0),5120+random%2
channel = 0
lowpriority = 1

[State 試合負け]
type = PlaySnd
trigger1 = !Alive
trigger1 = var(30) > 0
value = 10000+var(0),11
channel = 0

[State 試合負け]
type = PlaySnd
trigger1 = !Alive
trigger1 = stateno = 5150
trigger1 = time = 1
value = 10000+var(0),5150+random%3
channel = 0

[State 1F前のライフ]
type = varset
trigger1 = 1
var(30) = life

