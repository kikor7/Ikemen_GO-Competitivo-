flag2 = noshadow

;var(1)（フェード用の変数）を設定する
[State var]
type = varset
trigger1 = time = 0
var(1) = 0

;5フレーム目までフェードインさせる
[State var]
type = varadd
trigger1 = time < 5
var(1) = 20

;5フレーム目でフェード終了
