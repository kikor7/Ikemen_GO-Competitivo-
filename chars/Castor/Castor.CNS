trigger1 = animelem = 1
value = 20, 0
volume = 50000
channel = -1

[State 194, Pollux]
type = explod
trigger1 = time = 0
anim = 185
postype = p1
pos = 30,0
bindtime = 10
sprpriority = 1
ignorehitpause = 0
removeongethit = 1
ownpal = 1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Introduction
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 191, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 1310, 1]
type = PlaySnd
trigger1 = AnimElem = 2
value = 20, 1

[State 194, Pollux]
type = explod
trigger1 = time = 0
anim = 191
postype = p1
pos = 30,0
bindtime = 10
sprpriority = 1
ignorehitpause = 0
removeongethit = 1
ownpal = 1

[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

