;--------------------------------------------------------------------------
; Dizzy
[StateDef 5300]
type = S
movetype = I
physics = S
sprpriority = 1
velset = 0,0
ctrl = 0

[State 5300, animation]
type = ChangeAnim
trigger1 = anim != 5300
value = 5300

[State 5300, 3]
type = Ctrlset
triggerall = var(50) != 1
trigger1 = time >= 30
value = 1

[State 5300, end state]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

