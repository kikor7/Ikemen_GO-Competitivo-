;===========================================================================
; 通常攻撃技
;===========================================================================
;
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
;立ち弱パンチ
:::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::::
[Statedef 200]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 200
poweradd = 0
sprpriority = 2
facep2 = 1

[State 1];コウモリGO
type = varset
triggerall = var(4) = 0
trigger1 = time = 0
v = 4
value = 1

[State 1];コウモリ溜めリセット
type = varset
trigger1 = var(11) = 1
trigger1 = time = 0
v = 11
value = 0

[State 1];コウモリ溜めない
type = varset
trigger1 = command != "hold_x"
v = 11
value = 1

[State 1]
type = PlaySnd
trigger1 = AnimElem = 4
value = 300,0

[State 1]
type = PlaySnd
trigger1 = AnimElem = 1
value = 200,0
channel = 1

[State 1];ラキラキ
type = ChangeState
triggerall = Roundstate = 2
triggerall = AnimTime = 0
triggerall = helper(102),stateno = [3002,3004]
trigger1 = var(59) = 0
trigger1 = var(11) = 0
trigger2 = var(59) = 1
trigger2 = Roundstate = 2
trigger2 = P2bodydist X = [0,100]
trigger2 = Random <333
value = 1900

[State 1]
type = StateTypeSet
triggerall = NumHelper(102) = 1
triggerall = Helper(102),stateno != 3006
trigger1 = AnimElemtime(2) >= 0
movetype = I

[State 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
