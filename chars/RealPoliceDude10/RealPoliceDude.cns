[State 152, 1]
type = ChangeAnim
trigger1 = 1
value = 151
 
[State ]
type = StateTypeSet
triggerall = !var(59)
trigger1 = statetype = S && command = "holddown"
trigger2 = var(59)
trigger2 = (enemynear,statetype = C) || (enemynear,hitdefattr = C,AA,AP) || enemy,numproj > 0
statetype = C
physics = C
 
[State ]
type = StateTypeSet
triggerall = !var(59)
trigger1 = statetype = C && command != "holddown"
