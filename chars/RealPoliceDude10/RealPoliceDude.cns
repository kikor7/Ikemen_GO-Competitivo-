trigger1 = time = 0
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
time = 8

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = S100,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
trigger1 = random <= 500
value = S190,1
volumescale = 180
channel = 0

[State 0, Explod]
type = Explod
trigger1 = time = 0
anim = 102
ID = 102
pos = 10,0
postype = p1  ;p2,front,back,left,right
facing = -1
vfacing = 1
bindtime = 1
vel = 0.5,0
accel = 0.09,0
random = 0,0
removetime = -2
pausemovetime = 0
scale = 0.4,0.4
sprpriority = 5
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0

[State 0, VelAdd]
