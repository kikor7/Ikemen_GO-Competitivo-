;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S
ctrl = 0

[State 0, PosSet]
type = PosSet
trigger1 = pos y != 0
y = 0

[State 180]
Type = VarSet
Trigger1 = 1
var(17) = Random%5

[State 180]
Type = Null
TriggerAll = (Floor(Var(18))) != 31
TriggerAll = ((Floor(Var(18))) & 31) != 31
TriggerAll = ((Floor(Var(18))) & (Floor(exp(Floor(Var(17))*ln(2)) + 0.50))) = 0
TriggerAll = Var(18) := ((Floor(Var(18))) | Floor(exp(Floor(Var(17))*ln(2)) + 0.50))
Trigger1 = Var(17) = 0
Trigger1 = 1 || Var(17) := 181
Trigger2 = Var(17) = 1
Trigger2 = 1 || Var(17) := 182
Trigger3 = Var(17) = 2
Trigger3 = 1 || Var(17) := 183
Trigger4 = Var(17) = 3
Trigger4 = 1 || Var(17) := 184
Trigger5 = Var(17) = 4
Trigger5 = 1 || Var(17) := 185

[State 180]
Type = ChangeState
Trigger1 = Time >= 0
Trigger1 = Var(17) >= 181
Value = Floor(Var(17))

[State 180]
Type = ChangeState
TriggerAll = Time >= 0
Trigger1 = Var(18) = 31
Trigger2 = ((Floor(Var(18)))&31) = 31
Value = ((Random%5) * 1) + 181

[State 180]
Type = ChangeState
Trigger1 = Time >= 0
Trigger1 = Var(17) < 181
Value = 180

