ctrl = 1
;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
 
[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2
 
[state 120, Turn]
type = Turn
trigger1 = var(59)
trigger1 = ctrl=0
trigger1 = p2dist x < 0
 
[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S
 
[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C
 
[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A
 
[State ]
type = StateTypeSet
triggerall = !var(59)
triggerall = statetype != A
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C
 
[State ]
type = StateTypeSet
triggerall = !var(59)
triggerall = statetype != A
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S
 
[State ]
type = ChangeState
triggerall = var(59)
triggerall = statetype != A
trigger1 = (enemynear,statetype = C) || (enemynear,hitdefattr = C,AA,AP) || enemy,numproj > 0
value = 131
 
[State ]
type = ChangeState
triggerall = var(59)
triggerall = statetype != A
trigger1 = (enemynear,statetype != C) || (enemynear,hitdefattr = A,AA,AP)
trigger1 = enemy,numproj = 0
value = 130
 
[State ]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2
 
[State ]
type = ChangeState
triggerall = !var(59)
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140
 
[State ]
type = ChangeState
triggerall = var(59)
triggerall = !enemynear,numproj
trigger1 = enemy,movetype != A
trigger1 = p2bodydist x < 0
trigger1 = !inguarddist
trigger2 = P2Bodydist x >= 0
trigger2 = !inguarddist
value = 140
 
;---------------------------------------------------------------------------
; Stand guard (guarding)
[Statedef 130]
type    = S
physics = S
 
[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130
 
[state 130, Turn]
type = Turn
trigger1 = var(59)
trigger1 = ctrl=0
trigger1 = p2dist x < 0
 
[State ]
type = ChangeState
trigger1 = !var(59)
trigger1 = command = "holddown"
value = 131
 
[State ]
type = ChangeState
triggerall = !var(59)
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140
 
[State ]
type = ChangeState
triggerall = var(59) && time > 1
trigger1 = (enemynear,statetype = C) || (enemynear,hitdefattr = C,AA,AP) || enemy,numproj > 0
value = 131
 
[State ]
type = ChangeState
triggerall = var(59)
trigger1 = enemy,movetype != A
trigger1 = p2bodydist x < 0
trigger1 = !inguarddist
trigger2 = P2Bodydist x >= 0
trigger2 = !inguarddist
value = 140
 
;---------------------------------------------------------------------------
; Crouch guard (guarding)
[Statedef 131]
type    = C
physics = C
 
[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 131
value = 131
 
[state 131, Turn]
type = Turn
trigger1 = var(59)
trigger1 = ctrl=0
trigger1 = p2dist x < 0
 
[State ]
type = ChangeState
trigger1 = !var(59)
trigger1 = command != "holddown"
trigger2 = var(59)
trigger2 = (enemynear,statetype != C) || (enemynear,hitdefattr = A,AA,AP)
trigger2 = enemy,numproj = 0
value = 130
 
[State ]
type = ChangeState
trigger1 = !var(59)
trigger1 = command = "holddown"
trigger2 = var(59)
trigger2 = (enemynear,statetype = C) || (enemynear,hitdefattr = C,AA,AP) || enemy,numproj > 0
value = 140
 
[State ]
type = ChangeState
triggerall = var(59)
trigger1 = enemy,movetype != A
trigger1 = p2bodydist x < 0
trigger1 = !inguarddist
trigger2 = P2Bodydist x >= 0
trigger2 = !inguarddist
value = 140
 
;---------------------------------------------------------------------------
; Air guard (guarding)
[Statedef 132]
type    = A
physics = N
 
[State 132, 1]
type = ChangeAnim
trigger1 = Anim != 132
value = 132
 
[state 132, Turn]
type = Turn
trigger1 = var(59) = 1 && ctrl = 0
trigger1 = p2dist x < 0
 
[State 132, 2]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)
 
[State 132, 3]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)
 
[State 132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0
 
[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0
 
[State ]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command != "holdback"
value = 52
 
[State ]
type = ChangeState
trigger1 = sysvar(0)
value = 130
 
[State ]
type = ChangeState
triggerall = var(59)
trigger1 = enemy,movetype != A
trigger1 = p2bodydist x < 0
trigger1 = !inguarddist
trigger2 = P2Bodydist x >= 0
trigger2 = !inguarddist
value = 140
 
;---------------------------------------------------------------------------
; Guard (end)
[Statedef 140]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
ctrl = 1
 
[State ]
type = StateTypeSet
Trigger1 = !var(59)
trigger1 = Time = 0 && statetype = S
Trigger2 = var(59)
trigger2 = anim = 140
physics = S
 
[State ]
type = StateTypeSet
Trigger1 = !var(59)
trigger1 = Time = 0 && statetype = C
Trigger2 = var(59)
trigger2 = anim = 141
physics = C
 
[State ]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A
 
[State ]
type = StateTypeSet
Trigger1 = !var(59)
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C
 
[State ]
type = StateTypeSet
Trigger1 = !var(59)
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S
 
[State ]
type = StateTypeSet
Triggerall = var(59)
trigger1 = anim = 141
physics = C
statetype = C
 
[State ]
type = StateTypeSet
Triggerall = var(59)
trigger1 = anim = 140
physics = S
statetype = S
 
;---------------------------------------------------------------------------
; Stand guard hit (shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0
 
[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150
 
[State ]
type = StateTypeSet
triggerall = !var(59)
trigger1 = statetype = S && command = "holddown"
trigger2 = var(59)
trigger2 = (enemynear,statetype = C) || (enemynear,hitdefattr = C,AA,AP) || enemy,numproj > 0
statetype = C
physics = C
 
[State ]
type = StateTypeSet
triggerall = !var(59)
trigger1 = statetype = C && command != "holddown"
trigger2 = var(59)
trigger2 = (enemynear,statetype != C) || (enemynear,hitdefattr = A,AA,AP)
trigger2 = enemy,numproj = 0
statetype = S
physics = S
 
[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3
 
[State ]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(statetype = C)
ctrl = 1
 
;---------------------------------------------------------------------------
; Stand guard hit (knocked back)
[Statedef 151]
type    = S
movetype= H
physics = S
anim = 150
 
[State 151, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1
 
[State 151, 2]
type = VelSet
trigger1 = Time = GetHitVar(slidetime)
trigger2 = HitOver
x = 0
 
[State 151, 3]
type = CtrlSet
trigger1 = Time = GetHitVar(ctrltime)
value = 1
 
[State ]
type = StateTypeSet
triggerall = !var(59)
trigger1 = statetype = S && command = "holddown"
trigger2 = var(59)
trigger2 = (enemynear,statetype = C) || (enemynear,hitdefattr = C,AA,AP) || enemy,numproj > 0
statetype = C
physics = C
 
[State ]
type = StateTypeSet
triggerall = !var(59)
trigger1 = statetype = C && command != "holddown"
trigger2 = var(59)
trigger2 = (enemynear,statetype != C) || (enemynear,hitdefattr = A,AA,AP)
trigger2 = enemy,numproj = 0
statetype = S
physics = S
 
[State ]
type = ChangeState
trigger1 = Time >= GetHitVar(hittime)
value = 130 + (statetype=C)
ctrl = 1
 
;---------------------------------------------------------------------------
