 ; Definition file for Real Police Dude
; Contains all the filenames needed for the character

; Player information
[Info]
name = "LEON!!! HAAAALP!!!"        ;Name of character
displayname = "Real Police Dude" ;Name of character to display
versiondate = 11,14,2018    ;Version date of character (MM-DD-YYYY or X.XX) ;Production Started on 07,20,2018
mugenversion = 1.0          ;Version of M.U.G.E.N character works on (X.XX)
author = "Brergrsart"       ;Character author name
pal.defaults = 1,2,3,4      ;Default palettes in order of preference (up to 4)
                            ;Numbering starts from 1
localcoord = 320,240        ;Local coordinate space width and height

; Files for the player
[Files]
movelist = movelist.dat
cmd     = RealPoliceDude.cmd           ;Command set
cns     = RealPoliceDude.cns           ;Constants
st      = RealPoliceDude.cns           ;States
stcommon = common1.cns      ;Common states (from data/ or motif)
sprite  = RealPoliceDude.sff           ;Sprite
anim    = RealPoliceDude.air           ;Animation
sound   = RealPoliceDude.snd           ;Sound
ai      = RealPoliceDude.ai            ;AI hints data (not used?)

; Maps character selection buttons to palette numbers.
[Palette Keymap]
a = 1 ;Press button X to select palette 1, etc.
b = 2
c = 3
x = 4
y = 5
z = 6
a2 = 7 ;Hold Start and press button X for palette 7, etc.
b2 = 8
c2 = 9
x2 = 10
y2 = 11
z2 = 12

; Arcade mode
;[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
