


; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1000			;Amount of life to start with
power = 3000		;Amount of maximum power
attack = 90		;attack power (more is stronger)
defence = 100		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 45		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 5000			;Volume offset (negative for softer)
IntPersistIndex = 60	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = 1			;Horizontal scaling factor.
yscale = 1			;Vertical scaling factor.
ground.back = 15		;Player width (back, ground)
ground.front = 16		;Player width (front, ground)
air.back = 12		;Player width (back, air)
air.front = 12		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too   
head.pos = -5, -90	;Approximate position of head
mid.pos = -5, -60		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 5.4		;Walk forward
walk.back = -5.4		;Walk backward
run.fwd  = 6.6, 0		;Run forward (x, y)
run.back = -4.5,-4.9	;Hop backward (x, y)
jump.neu = 0,-8.4		;Neutral jumping velocity (x, y)
jump.back = -2.55		;Jump back Speed (x, y)
jump.fwd = 3.5		;Jump forward Speed (x, y)
runjump.back = -3.55,-8.1;Running jump speeds (opt)
runjump.fwd = 5,-8.1	;.
airjump.neu = 0,-8.1	;.
airjump.back = -2.55	;Air jump speeds (opt)
airjump.fwd = 3.5		;.

[Movement]
airjump.num = 1		;Number of air jumps allowed (opt)
airjump.height = 35	;Minimum distance from ground before you can air jump (opt)
yaccel = .42		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
;
[Statedef 0]
type = S
physics = S

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5 && Anim  != 5300 && Anim != 170
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Switch to near dead state
type= changeanim
triggerall= life <= 400
triggerall= anim != 5300 && Anim != 5 
trigger1= anim != 5
trigger2= anim = 5
trigger2= animelem =1, > 8
value= 5300

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
ctrl = 0
velset = 0,0

[State 200, 1]
type = PlaySnd
trigger1 = Time = 1
value = 0, 6

[State 100, 1]
type = VelSet
trigger1 = animelem = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, AfterImage]
type = AfterImage
trigger1 = animelem = 1
time = 25
;timeGap = 2
FrameGap = 3
length = 10
PalBright = 0,0,0
palcolor = 0
PalContrast = 136,136,256
PalAdd = 0,0,0
PalMul = 1,1,1
trans = none

[State 100, 1]
type = VelSet
trigger1 = animelem = 6
x = 0

[State 100, 4]
type = Changestate
trigger1 = command = "holdup"
value = 40
ctrl = 1

[State 100, 22]
type = ChangeState
trigger1 = Animtime = 0
value = 101

;---------------------------------------------------------------------------
[Statedef 101 STOP]
type    = S
physics = S
ctrl = 0
anim = 101

[State 104, 1]
type = VelMul
trigger1 = AnimElem = 1
x = 1
;y = .05

[State 104, a]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 104, b]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 104, 1]
type = VelMul
trigger1 = AnimElem = 2
x = .05
;y = .01

[State 104, 3]
type = PosSet
trigger1 = animelem = 2
y = 0

[State 104, 2]
type = VelSet
trigger1 = animelem = 2
y = 0

[State 104, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Running Back
[Statedef 105]
type    = A
physics = A

[State 105, 1]
type = CtrlSet
trigger1 = Time = 0
value = 0

[State 105, 2]
type = ChangeAnim
trigger1 = Time = 0
value = 105

[State 105, 3.1]
type = AfterImageTime
trigger1 = Time = [2,68]
time = 2

[State 105, Sound]
type = PlaySnd
trigger1 = Time = 5
value = 0,6

[State 105, 4] ;Invunerable to normal and special attacks for a bit
type = NotHitBy
trigger1 = Time = 0
value = , NA, SA, AT
time = 6

[State 105, Move]
type = VelSet
trigger1 = time = 0
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 5]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52

;---------------------------------------------------------------------------
; Lose by Time Over
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
[Statedef 180]
type = S

[State 180, Random]
type = VarRandom
trigger1 = time >= 0
v = 4
range = 0,120

[State 180, 3]
type = ChangeState
trigger1 = time = 2
trigger1 = var(4) = [0,33]
;trigger1 = MatchOver = 0
value = 181

[State 180, 3]
type = ChangeState
trigger1 = time = 2
trigger1 = var(4) = [34,66]
;trigger1 = MatchOver = 0
value = 182

[State 180, 3]
type = ChangeState
trigger1 = time = 2
trigger1 = var(4) = [67,120]
;trigger1 = MatchOver = 0
value = 183

[State 180, 1]
type = varrandom
triggerall = Numhelper(10006) = 1
triggerall = Numhelper(10006) = 0
trigger1 = time = 0
v = 4
range = 0,120

;---------------------------------------------------------------------------
; Win pose 1
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, 1]
type = PlaySnd
trigger1 = AnimElem = 5
value = 1, 4

[State 181, 1]
type = AssertSpecial
trigger1 = Time = [0,100]
flag = RoundNotOver

[State 181, cut_in];
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = Time = 130
value = 10000

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win pose 2
[Statedef 182]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 182, 1]
type = PlaySnd
trigger1 = AnimElem = 4
value = 1, 3

[State 182, 1]
type = PlaySnd
trigger1 = AnimElem = 10
value = 2, 0

[State 2120, 6]
type = AfterImage
trigger1 = AnimElem = 10
time = 50
trans = add1
framegap = 1
length = 5

[State 182, 1]
type = AssertSpecial
trigger1 = Time = [0,100]
flag = RoundNotOver

[State 182, cut_in];
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = Time = 130
value = 10010

[State 182, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win pose 3
[Statedef 183]
type = S
ctrl = 0
anim = 182
velset = 0,0

[State 3052,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 6
value = 1, 7
channel = -1

[State 3052,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 2, 5
channel = -1

[State 183, 1]
type = AssertSpecial
trigger1 = Time = [0,100]
flag = RoundNotOver

[State 3000, Velocity]
type = VelSet
trigger1 = AnimElemTime(7) >= 0
x = 2
y = -1

[State 183, cut_in];
type = ChangeState
trigger1 = MatchOver = 1
trigger1 = Time = 180
value = 10020

[State 183, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Intro state decider

[Statedef 190]
type = S

[State 190, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 0,100

[State 190, 2]
type = ChangeState
trigger1 = Time = 1
trigger1 = var(1) = [0,33]
value = 191

[State 190, 3]
type = ChangeState
trigger1 = Time = 1
trigger1 = var(1) = [34,66]
value = 192

[State 190, 3]
type = ChangeState
trigger1 = Time = 1
trigger1 = var(1) = [67,100]
value = 193

;---------------------------------------------------------------------------
; Introduction
[Statedef 191]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 190, PlaySnd]
type = PlaySnd
trigger1 = animelem = 4
value = 1, 4
volume = 50000
channel = -1

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Introduction 2
