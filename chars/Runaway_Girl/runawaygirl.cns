PalContrast =  80, 80, 80  ;残像の色合い　　（赤,緑,青・ＲＧＢ）
PalAdd      =  0,0,0          ;残像の色の加算値（赤,緑,青・ＲＧＢ）
PalMul      =  1,1,1          ;残像の色の乗算値（赤,緑,青・ＲＧＢ・float）
