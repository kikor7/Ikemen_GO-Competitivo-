TimeGap  = 4                  ;残像の表示をスキップする間隔（デフォルトは1）
FrameGap = 1                  ;残像の形を変化させる間隔（デフォルトは4）
length = 3                    ;残像の表示する長さ（最大60・デフォルト20）
