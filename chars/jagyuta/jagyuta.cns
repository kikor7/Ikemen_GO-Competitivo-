;type = ChangeState
;trigger1 = AnimTime = 0
;value = (statetype = C)*11 + (statetype = A)*51

;---------------------------------------------------------------------------
; SGUARDHIT (shaking)
[Statedef 150]
type    = S
movetype= H
physics = N
velset = 0,0

[State 150,]
type = Varset
triggerall = var(21) = 0
trigger1 = command = "c"
trigger1 = power >= 1000
v = 2
value = 1

[State 150,]
type = Varset
triggerall = var(21) = 0
trigger1 = command = "c"
trigger1 = command = "holdfwd"
trigger1 = power >= 1000
v = 2
value = 2

[State 150,]
type = Varset
triggerall = var(21) = 0
trigger1 = command = "c"
trigger1 = command = "holdback"
trigger1 = power >= 1000
v = 2
value = 3

[State 150, 無敵]
type = NotHitBy
trigger1 = Var(2) != 0
value = SCA
time = 1

[State 150,]
type = poweradd
trigger1 = Var(2) != 0
value = -1000
persistent=0

[State 150]
type = palfx
Trigger1 = Var(2) != 0
time = 5
add = 255,255,255
sinadd = 0,0,0,0
color = 0
invertall = 0

[State 150, 音を鳴らす]
type = PlaySnd
trigger1 = Var(2) != 0
volume = 80
value = 2, 1
persistent=0

[State 150,]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = Var(2) = 1
value = 700

[State 150,]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = Var(2) = 2
value = 705

[State 150,]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = Var(2) = 3
value = 710
[State 150,リスクポイント増加]
type = Varadd
triggerall = var(18) = 0
triggerall = time = 0
triggerall = fvar(3) <= 70
trigger1 = var(9) = 1
trigger2 = var(8) = [1,8]
fv = 3
value = 1

[State 150,ゲージ増加]
type = poweradd
triggerall = var(18) = 0
triggerall = time = 0
triggerall = fvar(3) >= 70
trigger1 = var(9) = 1
trigger2 = var(8) = [1,8]
value = 50

[State 150,ライフ増加]
type = lifeadd
triggerall = var(18) = 0
triggerall = time = 0
triggerall = fvar(3) >= 70
triggerall = power = (PowerMax)
trigger1 = var(9) = 1
trigger2 = var(8) = [1,8]
value = 10

[State 150,リスキーガード表示]
type = Varset
triggerall = var(18) = 0
triggerall = time = 0
trigger1 = var(9) = 1
trigger2 = var(8) = [1,8]
v = 10
value = 1

[State 150,リスキーガードエフェクト]
type = Explod
triggerall = var(18) = 0
triggerall = time = 0
trigger1 = var(9) = 1
trigger2 = var(8) = [1,8]
persistent = 0
sprpriority = 3
anim = 6032
postype = p1
pos = 40, -60
scale = 1,1
removetime = 8
bindtime = 8
supermovetime = 1000000
pausemovetime = 1000000

[State 150, 音を鳴らす]
type = PlaySnd
triggerall = var(18) = 0
triggerall = time = 0
trigger1 = var(9) = 1
trigger2 = var(8) = [1,8]
value = 2, 2

[State 150,リスキーガード点滅]
type = palfx
triggerall = var(18) = 0
triggerall = time = 0
trigger1 = var(9) = 1
trigger2 = var(8) = [1,8]
time = 3
add = 255,255,255
sinadd = 0,0,0,0
color = 0
invertall = 0
ignorehitpause=1

[State 150,リスキーガード]
type = Varset
triggerall = var(18) = 0
trigger1 = time = 1
v = 8
value = 10

[State 150,リスキーガード]
type = Varset
triggerall = var(18) = 0
trigger1 = time = 1
v = 9
value = 0

[State 150, 1]
type = ChangeAnim
trigger1 = 1
value = 150

[State 150, 2]
type = ChangeState
trigger1 = HitShakeOver
value = 151 + 2*(command = "holddown")

[State 150, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 150, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 150, 3]
type = ForceFeedback
trigger1 = time = 0
waveform = square
time = 3

;---------------------------------------------------------------------------
; SGUARDHIT2 (knocked back)
[Statedef 151]
type    = S
movetype= H
physics = S
anim = 150

[State 151,]
type = Varset
triggerall = var(21) = 0
trigger1 = command = "c"
trigger1 = power >= 1000
v = 2
value = 1

[State 151,]
type = Varset
triggerall = var(21) = 0
trigger1 = command = "c"
trigger1 = command = "holdfwd"
trigger1 = power >= 1000
v = 2
value = 2

[State 151,]
type = Varset
triggerall = var(21) = 0
trigger1 = command = "c"
trigger1 = command = "holdback"
trigger1 = power >= 1000
v = 2
value = 3

[State 151, 無敵]
type = NotHitBy
trigger1 = Var(2) != 0
value = SCA
time = 1

[State 151,]
type = poweradd
trigger1 = Var(2) != 0
value = -1000
