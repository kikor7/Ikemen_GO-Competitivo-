; このCNSは教材用カンフーマンを元に作成しています。
;---------------------------------------------------------------------------
;var(0) = 空中ジャンプ・ダッシュ回数
;var(1) = ダッシュ慣性
;var(2) = ガードキャンセル
;var(3) = カウンターヒット判定
;var(4) = カウンターヒット判定2
;var(5) = DJC
;var(6) = リスキーストライク表示
;var(7) = ハイジャンプ
;var(8) = リスキーガード1
;var(9) = リスキーガード2
;var(10) = リスキーガード表示
;var(11) = フリーダムブラスト表示
;var(12) = 天撃・楼開脚・七旋牙追加攻撃
;var(13) = HJ入力判定
;var(14) = 
;var(15) = 被カウンターヒット
;var(16) = タッグ時リスクライン被り防止
;var(17) = 雷肘強弱
;var(18) = チャージディフェンス
;var(19) = 牙来入力制御
;var(20) = 雷肘地上空中区別
;var(21) = 

;var(23) = 永久防止補正
;var(24) = 多段ジャンプ
;var(25) = カオストリガー

;var(27) = ガード硬直後相手投げ無敵
;var(28) = ヒット重複防止
;var(29) = 飛び道具カウンター用
;var(30) = 超必殺カウンター用
;var(31) = ダッシュ慣性2

;var(55) = 

;var(59) = 空き

;fvar(0) = ダッシュジャンプ
;fvar(1) = コンボ補正
;fvar(2) = 特殊補正
;fvar(3) = ビートレベル
;fvar(4) = 永久防止補正
;fvar(5) = 
;fvar(6) = ピンチ時リスク増量
;fvar(7) = 

;helper(6000),var(0) = 先行入力
;helper(6000),var(1) = 先行入力

;helper(8004),var(0) = カウンターヒット

;helper(10000),var(0) = 空き
;helper(10000),var(1) = デフォモード

;helper(10000),var(11) = リスクラインX軸
;helper(10000),var(12) = リスクラインY軸

;helper(10000),var(22) =

;---------------------------------------------------------------------------
;基本データ部分
[Data]
life              = 1000
power             = 3000
attack            = 100
defence           = 100
fall.defence_up   = 50
liedown.time      = 33
airjuggle         = 100000
sparkno           = 2
guard.sparkno     = 40
KO.echo           = 0
volume            = 0
IntPersistIndex   = 55
FloatPersistIndex = 40

;---------------------------------------------------------------------------
;サイズ設定
[Size]
xscale           = 0.5
yscale           = 0.5
ground.back      = 20
ground.front     = 20
air.back         = 20
air.front        = 20
height           = 80
attack.dist      = 320
proj.attack.dist = 90
proj.doscale     = 0
head.pos         = 0, -115
mid.pos          = 0, -75
shadowoffset     = 0
draw.offset      = 0,0

;---------------------------------------------------------------------------
;移動速度設定
[Velocity]
walk.fwd     = 2.3
walk.back    = -2.0
run.fwd      = 7.6, 0
run.back     = -5.5,-3.3
jump.neu     = 0,-10.8
jump.back    = -2.6
jump.fwd     = 2.8
runjump.back = -2.55
runjump.fwd  = 6.5,-8.8
airjump.neu  = 0,-8.1
airjump.back = -2.55
airjump.fwd  = 2.5

;---------------------------------------------------------------------------
;動作設定
[Movement]
airjump.num     = 0
airjump.height  = 35
yaccel          = .55
stand.friction  = .85
crouch.friction = .82

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 0,]
type = DestroySelf
trigger1 = IsHelper

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = ifelse(PalNo = 11,6,const(velocity.walk.fwd.x))

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = ifelse(PalNo = 11,-5,const(velocity.walk.back.x))

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, ifelse(PalNo = 11,4,const(velocity.jump.fwd.x)), ifelse(PalNo = 11,-3.5,const(velocity.jump.back.x))))
y = const(velocity.jump.y)

[State 40, 5]
type = VelSet
triggerall = AnimTime = 0
triggerall = sysvar(1) = 1
trigger1 = prevstateno = 100 || prevstateno = 102
x = fvar(0)

[State 40, 5]
type = Veladd
triggerall = AnimTime = 0
triggerall = sysvar(1) = 1
trigger1 = prevstateno != 100
trigger1 = prevstateno != 102
trigger1 = var(5) = 1
x = 4

[State 40, 5]
type = Velset
triggerall = AnimTime = 0
triggerall = sysvar(1) = 1
trigger1 = prevstateno != 100
trigger1 = prevstateno != 102
trigger1 = var(5) = 1
y = -9

[State 40, 音を鳴らす]
type = PlaySnd
trigger1 = AnimTime = 0
value = 3, 0

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(44)
value = 44

[State 45, 2]
type = ChangeAnim
trigger1 = !SelfAnimExist(44)
value = 41

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = ifelse(sysvar(1)=0, const(velocity.airjump.neu.x), ifelse(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)

[State 45, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 2
value = 3, 0

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50,]
type = Width
trigger1 = 1
player = 0,-30

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

;---------------------------------------------------------------------------
; Jump Down (empty state for compatibility)
[Statedef 51]
type    = A
physics = A

[State 51, 1]
type = Null
trigger1 = 1

;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47

[State 52, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 3, 4

[State 52, 1]
type = VelSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 3]
type = CtrlSet
trigger1 = Time = 3
value = 1

[State 52, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl = 0
sprpriority = 1

[State 100,]
type = Varset
trigger1 = 1
v = 31
value = 1

[State 100, 音を鳴らす]
type = PlaySnd
trigger1 = (AnimElemTime (1) = 0)
value = 3, 2

[State 100,]
type = Explod
trigger1 = (AnimElemTime (2) = 0)
trigger2 = (AnimElemTime (4) = 0)
trigger3 = (AnimElemTime (6) = 0)
trigger4 = (AnimElemTime (8) = 0)
sprpriority = 0
anim = 6005
postype = p1
pos = -50, 0
scale = 0.5,0.5
removetime = 10
bindtime = 1
pausemovetime = 0

[State 100, 1]
type = VelSet
trigger1 = 1
trigger1 = PalNo != 11
trigger1 = Vel X <= 10.2
x = 4.5 + (time/4)

[State 100, 1]
type = VelSet
trigger1 = 1
trigger1 = PalNo != 11
trigger1 = Vel X >= 10.2
x = 10.3

[State 100, 1]
type = VelSet
trigger1 = 1
trigger1 = PalNo = 11
x = 14 + (time/4)

[State 100,]
type = Varset
trigger1 = 1
fv = 0
value = 3 + (Vel X/1.7)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 4]
type = ChangeState
trigger1 = time >= 10
trigger1 = command != "holdfwd"
trigger2 = command = "holdup"
value = 102

;---------------------------------------------------------------------------
; ダッシュストップ

[Statedef 102]
type    = S
physics = N
anim = 102
ctrl = 0
sprpriority = 1

[State 102,]
type = Varset
trigger1 = Time < 5
v = 31
value = 1

[State 102,]
type = Varset
trigger1 = Time >= 6
v = 31
value = 0

[State 102,]
type = StateTypeSet
trigger1 = Time > 5
statetype = S
physics = S

[State 102, 移動速度]
type = VelSet
trigger1 = Time >= 0 && Time < 5
x = 3

[State 102, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 3, 3

[State 102, 1]
type = ChangeState
triggerall = 1
trigger1 = command = "holdup"
value = 40

[State 102,]
type = Varset
trigger1 = 1
fv = 0
value = 0 + (Vel X/1.5)

[State 102,]
type = Explod
trigger1 = Time = 0
facing = -1
sprpriority = 0
anim = 6005
postype = p1
pos = 70, 0
scale = 0.5,0.5
removetime = 10
bindtime = 1
pausemovetime = 0

[State 102, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 102, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = A
physics = A
ctrl = 0
anim = 105
sprpriority = 1

[State 105,]
type = Explod
trigger1 = Time = 0
facing = -1
sprpriority = 0
anim = 6005
postype = p1
pos = 70, 0
scale = 0.5,0.5
removetime = 10
bindtime = 1
pausemovetime = 0

[State 105, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 0
value = 3, 0

[State 105, 無敵]
type = NotHitBy
trigger1 = Time >= 0 && Time <= 4
value = SCA
time = 1

[State 105, 1]
type = VelSet
trigger1 = Time = 0
x = ifelse(PalNo = 11,-10,const(velocity.run.back.x))
y = const(velocity.run.back.y)

[State 105, 3]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 52
;---------------------------------------------------------------------------
; GUARD (start)
[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; STAND GUARD (guarding)
[Statedef 130]
type    = S
physics = S

[State 130,リスキーガード]
type = Varset
triggerall = var(18) = 0
trigger1 = var(8) = [1,8]
v = 9
value = 1

[State 130,リスキーガード]
type = Varset
triggerall = var(18) = 0
trigger1 = var(8) >= 9
v = 9
value = 0

[State 130, 1]
type = ChangeAnim
trigger1 = Anim != 130
value = 130

[State 130, Hi to Lo]
type = ChangeState
trigger1 = command = "holddown"
value = 131

[State 130, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; CROUCH GUARD (guarding)
[Statedef 131]
type    = C
physics = C

[State 131,リスキーガード]
type = Varset
triggerall = var(18) = 0
trigger1 = var(8) = [1,8]
v = 9
value = 1

[State 131,リスキーガード]
type = Varset
triggerall = var(18) = 0
trigger1 = var(8) >= 9
v = 9
value = 0

[State 131, 1]
type = ChangeAnim
trigger1 = Anim != 131
value = 131

[State 131, Lo to Hi]
type = ChangeState
trigger1 = command != "holddown"
value = 130

[State 131, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; AIR GUARD (guarding)
[Statedef 132]
type    = A
physics = N

[State 132,リスキーガード]
type = Varset
trigger1 = var(8) = [1,8]
v = 9
value = 1

[State 132,リスキーガード]
type = Varset
trigger1 = var(8) >= 9
v = 9
value = 0


[State 132, 1]
type = ChangeAnim
trigger1 = Anim != 132
value = 132

[State 132, 2]
type = VelAdd
trigger1 = 1
y = Const(movement.yaccel)

[State 132, 3]
type = VarSet
trigger1 = 1
sysvar(0) = (pos y >= 0) && (vel y > 0)

[State 132, 4]
type = VelSet
trigger1 = sysvar(0)
y = 0

[State 132, 5]
type = PosSet
trigger1 = sysvar(0)
y = 0

[State 132, 6]
type = ChangeState
trigger1 = sysvar(0)
trigger1 = command = "holdback"
trigger1 = inguarddist
value = 130

[State 132, 7]
type = ChangeState
trigger1 = sysvar(0)
value = 52

[State 132, Stop Guarding]
type = ChangeState
trigger1 = command != "holdback"
trigger2 = !inguarddist
value = 140

;---------------------------------------------------------------------------
; GUARD (end)
[Statedef 140]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged
ctrl = 1

[State 140,]
type = Varset
trigger1 = command = "GC"
trigger1 = power >= 1000
v = 2
value = 1

[State 140, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 140 + (statetype = C) + (statetype = A)*2

[State 140, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 140, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 140, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 140, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = S && command = "holddown"
statetype = C
physics = C

[State 140, Lo to Hi]
type = StateTypeSet
trigger1 = statetype = C && command != "holddown"
statetype = S
physics = S

