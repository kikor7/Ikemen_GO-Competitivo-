;---------------------------------------------------------------------------
;--------------------------------------------------------------------------

;---------------------------------------------------------------------------
;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, 変数];板投げ用
type = VarSet
trigger1 = (StateNo != 1300)
var(5) = 0

[State -2, 音止め];オーケストラ用
type = StopSnd
trigger1 = (StateNo != 7300)
channel = 1

;[State -2, 音を鳴らす];くっ、まだまだです！
;type = PlaySnd
;trigger1 = life <= 500
;trigger1 = life != 0
;trigger1 = var(10) != 1
;trigger1 = RoundState = 2
;value = 9999, 0
;;channel = 2
;
;[State -2, 変数];半減時の台詞が一回だけになるように。
;type = VarSet
;trigger1 = life <= 500
;trigger1 = var(10) != 1
;var(10) = 1

[State -2, パワーゲージ自動回復1000まで]
type = PowerAdd
trigger1 = Power < 1000
trigger1 = var(0) = 1
trigger1 = StateNo != [3000, 7370]
trigger1 = StateNo != 9999;[160, 162]
trigger1 = StateNo != 7400
trigger1 = Time % 1 = 0
value = 4

[State -2, パワーゲージ自動回復2000まで]
type = PowerAdd
trigger1 = Power >= 1000 && Power < 2000
trigger1 = var(0) = 1
trigger1 = StateNo != [3000, 7370]
trigger1 = StateNo != 9999;[160, 162]
trigger1 = StateNo != 7400
trigger1 = Time % 1 = 0
value = 3

[State -2, パワーゲージ自動回復3000まで]
type = PowerAdd
trigger1 = Power >= 2000 && Power < 3000
trigger1 = var(0) = 1
trigger1 = StateNo != [3000, 7370]
trigger1 = StateNo != 9999;[160, 162]
trigger1 = StateNo != 7400
trigger1 = Time % 1 = 0
value = 2

[State -2, パワーゲージ自動回復4000まで]
type = PowerAdd
trigger1 = Power >= 3000 && Power < 4000
trigger1 = var(0) = 1
trigger1 = StateNo != [3000, 7370]
trigger1 = StateNo != 9999;[160, 162]
trigger1 = StateNo != 7400
trigger1 = Time % 1 = 0
value = 2

[State -2, パワーゲージ自動回復5000まで]
type = PowerAdd
trigger1 = Power >= 4000 && Power < 5000
trigger1 = var(0) = 1
trigger1 = StateNo != [3000, 7370]
trigger1 = StateNo != 9999;[160, 162]
trigger1 = StateNo != 7400
trigger1 = Time % 1 = 0
value = 1

[State -2, 攻撃力アップ]
type = AttackMulSet
trigger1 = var(0) = 1
value = 1.2

[State -2, 防御力アップ]
type = DefenceMulSet
trigger1 = var(0) = 1
value = 0.8

[State 191, 点滅]
type = PalFX
trigger1 = var(0) = 1
trigger1 = StateNo != [701, 702]
trigger2 = StateNo = 3000
trigger3 = StateNo = [3001, 3004]
time = 10;99999
add = 160,0,0
mul = 256,220,250;256,230,250
sinadd = 90,0,0,120
invertall = 0
color = 256

[State -2, 106];エアダッシュをキャンセルすると速度変更（できてないみたい）
type = VelSet
triggerall = stateno = 106
trigger1 = time = 23
trigger2 =command = "x"
trigger3 =command = "y"
trigger4 =command = "a"
trigger5 =command = "b"
trigger6 =command = "QCF_x"
trigger7 =command = "QCF_y"
trigger8 =command = "QCF_xy"
x = 3;0

[State -2, 111];後エアダッシュをキャンセルすると速度変更
type = VelSet
triggerall = stateno = 111
trigger1 = time = 23
trigger2 =command = "x"
trigger3 =command = "y"
trigger4 =command = "a"
trigger5 =command = "b"
trigger6 =command = "QCF_x"
trigger7 =command = "QCF_y"
trigger8 =command = "QCF_xy"
x = -3;0



;-----------------------------------
;ここは「パワー溜め」のステートで発生させた「Explod」のエフェクト画像を
;特定の条件が有効になれば消す、という処理をしています。

[State -2, エフェクトを消す];パワー溜めステート用
type = RemoveExplod
triggerall = NumExplod(130) > 0
                          ;↑はＩＤナンバー「130」のExplodの画面中の数が0よりも多い、
                          ;つまり１枚以上表示されている時
trigger1 = StateNo != 700 ;ステートが７００（パワー溜め）以外の時
trigger2 = MoveType != I  ;MoveTypeが「I（何もしてない）」以外の時
ID = 130                  ;消すExplodの特定のＩＤナンバーを指定

;-----------------------------------
[State -2, クリップボード]
type = DisplayToClipboard
trigger1 = 1
text = "Cancel=%d, Throw=%d, Button=%d, Body-Distance X=%d,Y=%d \n"
params = var(1),var(2),var(5),floor(P2BodyDist X),floor(P2BodyDist Y)

[State -2, クリップボード（追加専用）]
type = AppendToClipboard
trigger1 = 1
text = "Position X=%d,Y=%d, Velocity X=%f,Y=%f, Hit=%d \n"
params = floor(Pos X),floor(Pos Y),(Vel X),(Vel Y),(MoveHit)

;===========================================================================
; 準常時監視ステート（－３）
;===========================================================================
;---------------------------------------------------------------------------
; こちらは通常の食らい状態以外の「P2StateNo」や「TargetState」等で制御された、
; 作成者が任意に指定した相手側の食らいステートに限り、
; 登録したステートコントローラが有効にはなりません。
; －１や－２と上手く使い分けて行きましょう。
;---------------------------------------------------------------------------

[Statedef -3]

;-----------------------------------
;ここは「ジャンプ」か「バックステップ」をした後に
;着地する音を鳴らす設定をしています。

[State -3, 音を鳴らす];着地音
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52  ;着地ステート
trigger2 = stateno = 106 ;バックステップ後の着地ステート
value = 40, 0

[State 1905, 音を鳴らす];ダッシュ・バックステップ音
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 100
trigger2 = stateno = 105
value = 1905, 0

[State -3, 音を鳴らす];ダメージ時の声
type = PlaySnd
triggerall = Time = 1
triggerall = life != 0 ;ライフが０でないとき
triggerall = enemy,hitdefattr = S,NA || enemy,hitdefattr = C,NA || enemy,hitdefattr = A,NA
triggerall = !GetHitVar(fall)
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
value = 5000, 0
channel = 0
ignorehitpause = 1

[State -3, 音を鳴らす];吹っ飛び時の声
type = PlaySnd
triggerall = Time = 1
triggerall = life != 0 ;ライフが０でないとき
triggerall = GetHitVar(fall)
trigger1 = stateno = 5000
trigger2 = stateno = 5010
trigger3 = stateno = 5020
value = 5030, 0
channel = 0
ignorehitpause = 1

[State -3, 音を鳴らす];足払いやられ時の声
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5070
trigger1 = life != 0 ;ライフが０でないとき
value = 5070, 0
channel = 0
ignorehitpause = 1

[State -3, 音を鳴らす];くっ、まだまだです！
type = PlaySnd
triggerall = Time = 1
trigger1 = life <= 500
trigger1 = life != 0
trigger1 = stateno = 5120
;trigger1 = var(10) != 1
;trigger1 = RoundState = 2
value = 9999, 0
channel = 0
ignorehitpause = 1

;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
; ■最後に『コモンステート』について■
; コモンステートとは、全キャラ共通の基本動作のステートです。
; 通常は特に変更しない限り、M.U.G.E.N本体のdataフォルダにある
;「common1.cns（コモンステートファイル）」を使います。
;
; しかし、もしもあなたのキャラのステートファイルでcommon1.cnsと同じ番号の
; 基本動作のステートを作った場合は処理が上書きされ、
; common1.cns側の同じ番号のステートは無効になります。
;
; common1.cnsのプログラム優先度は最低に属しているので、
; ステートの作成には番号に注意しないといけません。
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
;---------------------------------------------------------------------------
