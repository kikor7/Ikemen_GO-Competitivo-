; ここにキャラ情報を書いてください
[Info]
name = "Kabuki Danjurou"        ;キャラの名前
displayname = "Kabuki" ;表示されるキャラの名前
versiondate = 01,24,2006    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "shimon"         ;キャラの製作者名
pal.defaults = 1      ;敵としてでるキャラのパレット

; Files for the player
[Files]
movelist = movelist.dat
cmd     = kabuki.cmd.cns   ;キャラのコマンド
cns     = kabuki.cns   ;キャラのプログラム
st      = kabuki.cns   ;キャラのプログラム
stcommon = common1.cns 
sprite  = kabuki.sff   ;キャラの絵
anim    = kabuki.air   ;キャラの動き
sound   = kabuki.snd   ;キャラの音
pal1    = kabuki2.act  ;キャラの色（最大１２個）
pal2    = kabuki2.act
pal3    = kabuki2.act
pal4    = kabuki.act
pal5    = kabuki.act
pal6    = kabuki.act



[Arcade]
ending.storyboard = kabuki_end.def