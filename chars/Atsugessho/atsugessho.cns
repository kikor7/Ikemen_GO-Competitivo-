type = S

[State 190, 1]
type = VarRandom
trigger1 = Time = 0
v = 1
range = 1,2

[State 191, 1]
type = ChangeState
trigger1 = Var(1) = 1
value = 191

[State 192, 2]
type = ChangeState
trigger1 = Var(1) = 2
value = 192

