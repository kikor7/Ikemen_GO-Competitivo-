;---------------------------------------------------------------------------
;Poster
[Statedef 6193]
type = A
ctrl = 0
anim = 192
velset = 0,0
movetype = I
physics = N
sprpriority = -4

[State 19000,]
type=selfstate
trigger1=!ishelper
value=0

[state 19000]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[state 19000,]
type = varset
trigger1 = !time
var(1) = 1

[state 19000,]
type = varset
trigger1 = (time%15=0)
var(1) = var(1)*-1

[state 19000,]
type = varadd
trigger1 = var(1) = 1
fvar(2) = .006

[state 19000,]
type = varadd
trigger1 = var(1) = -1
fvar(2) = -.006

[state 19000,]
type = varadd
trigger1 = var(1) = 1
fvar(3) = .003

[state 19000,]
type = varadd
trigger1 = var(1) = -1
fvar(3) = -.003

[state 19000,]
type = angledraw
trigger1 = time
scale = 1+fvar(2),1+fvar(3)

[state 19000]
type = DestroySelf
trigger1 = time >= 70

