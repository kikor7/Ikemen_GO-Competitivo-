; FileName : Princess_Athena.def
;------------------------------------------------------------------------------;

;====================================================================;
; 基本情報
;====================================================================;
[Info]
  Name         = "Princess_Athena"      ; キャラの名前
  DisplayName  = "Athena"               ; 表示されるキャラの名前
  VersionDate  = 10,03,2011             ; キャラの更新情報
  MugenVersion = 11,22,2000             ; キャラが動くmugenのバージョン
  Author       = "hilune"               ; キャラの製作者名
  Pal.Defaults = 1                      ; 敵としてでるキャラのパレット

;====================================================================;
; ファイルの設定
;====================================================================;
[Files]
movelist = movelist.dat
  Sprite   = sys/Athena.sff             ; 画像ファイル
  Anim     = sys/Athena.air             ; アニメーションファイル
  Sound    = sys/Athena.snd             ; 音声ファイル
  Cmd      = sys/Athena.cmd             ; コマンドファイル
  Cns      = sys/Athena.ch              ; キャラのコンスタンツファイル
  StCommon = sys/Athena.cns             ; キャラのコモンステートファイル
  St       = st/-2.st                   ; 常時監視ステート
  St0      = st/Athena.st               ; イントロ
  St1      = st/Normal.st               ; 通常攻撃
  St2      = st/Super.st                ; 必殺技
  St3      = st/Hyper.st                ; 超必殺技
  St4      = st/System.st               ; システム関連

;====================================================================;
; キャラのカラーパレット
;====================================================================;
  Pal1    = act/Athena02.act
  pal2    = act/Athena04.act
  pal3    = act/Athena05.act
  pal4    = act/Athena01.act
  pal5    = act/Athena03.act
  pal6    = act/Athena06.act
  pal7    = act/Athena07.act
  pal8    = act/Athena08.act
  pal9    = act/Athena09.act
  pal10   = act/Athena10.act
  pal11   = act/Athena11.act
  pal12   = act/Athena12.act
