;===========================================================================
;通常技
;===========================================================================

;---------------------------------------------------------------------------
; 5a
[Statedef 200]
type     = S
movetype = A 
physics  = N 
juggle   = 0
velset   = 0,0
ctrl     = 0
anim     = 200
sprpriority = 2
facep2 = 1

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
value = s0,10

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem = 3
value = S3,1
channel = 1

[State 210, 2]
type = HitDef
trigger1 = animelem = 3,>=0
trigger1 = !movecontact&&!movereversed
attr = S, NA
animtype  = light
getpower = 30,15
givepower = 15,15
damage    = ceil(56*fvar(2))
guardflag = MA
hitflag = MAF
pausetime = 11,11
guard.pausetime = 11,11
sparkno = s6000
guard.sparkno = s6010
sparkxy = -20+ceil(var(30)/2.0),-40
hitsound   = s1,0
guardsound = s1,20
ground.type = high
ground.slidetime = 11
ground.hittime  = 11
guard.hittime = 10
ground.velocity = -5.2
ground.cornerpush.veloff = -6.2
air.velocity = -3,-8
yaccel = 0.5 
air.hittime = 120
fall.recovertime = 20

[State 200, MoveType]
type = StateTypeSet
trigger1 = AnimElem = 5
MoveType = I

[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0 ;アニメーション時間が０、つまりアニメが終了した時に有効になります。
value = 0
ctrl = 1

