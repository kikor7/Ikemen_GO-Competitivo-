ctrl = 0
anim = 195
velset = 0,0
movetype = I
physics = S
sprpriority = 2

[State 195, 1]
type = CtrlSet
trigger1 = Time = 40
value = 1

[State 195, sound]
type = PlaySnd
trigger1 = AnimElem = 1
value = 20, 1

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;--------------------------------------------------------------------------
; Dizzy
[StateDef 5300]
type = S
movetype = I
physics = S
sprpriority = 1
velset = 0,0
ctrl = 0

[State 5300, animation]
type = ChangeAnim
trigger1 = anim != 5300
value = 5300

[State 5300, 3]
type = Ctrlset
triggerall = var(50) != 1
trigger1 = time >= 30
value = 1

[State 5300, end state]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

