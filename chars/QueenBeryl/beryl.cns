[Statedef 108];避け
type    = S
movetype = I
physics = S
anim = 108
velset = 0,0
sprpriority = 1
ctrl = 0

[State Pause]
type = Pause
trigger1 = Time = 0 && (var(1) > 1 || PrevStateNo = [150,153])
time = 4
movetime = 4
ignorehitpause = 1

[State ChangeAnim]
type = ChangeAnim
trigger1 = Time <= 5 && (var(1) > 1 || PrevStateNo = [150,153])
value = 108
elem = 1

[State PalFX]
type = PalFX
trigger1 = Time = 0 && (var(1) > 1 || PrevStateNo = [150,153])
time = 14 + (var(1) > 1 || PrevStateNo = [150,153]) * 5
add = 256,256,-256
ignorehitpause = 1

[State VelSet]
type = VelSet
trigger1 = Time = 0 && (var(1) <= 1 && PrevStateNo != [150,153])
trigger2 = Time = 5 && Vel X = 0
x = -10

[State 106, Sound]
type = PlaySnd
trigger1 = Time = 0
value = 10,3

[State 106, 4]
type = nothitby
trigger1 = time = 0
value = ,AA,AP
time = 15 + (var(1) > 1 || PrevStateNo = [150,153]) * 5

[State 106, 4]
type = velset
trigger1 = animelem = 2
x = 0

[State 106, 4]
type = ChangeState
trigger1 = animtime = 0 && Command = "holdfwd"
value = 100
ctrl = 1

[State 106, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1

