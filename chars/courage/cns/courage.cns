trigger1 = stateno != [3000,4999]
time = 0

[State -3, ctrl set]
type = ctrlset
trigger1 = roundstate = 4
value = 0

;--------------------------------------------------------------------------- Custom Combo

[State -3, Timer]
type = VarAdd
trigger1 = Var(15) > 0
v = 15
value = -1
ignorehitpause = 1

[State -3, Cancel] ;Cancel CC Mode if you get hit or win the round
type = VarSet
trigger1 = (MoveType = H) || (Roundstate = 3)
v = 15
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = 1
v = 17
value = ifelse(var(15),4,0)

;Sorrowedge's Haste Code (tm)
;Modified for faster anims
[State -3, Speed]
type = ChangeAnim
triggerall = (Var(15) > 0) && (RoundState = 2) && (MoveType != H) && (Stateno !=[800,899])
trigger1 = AnimElemTime(AnimElemNo(0) + 1) < 0
trigger1 = AnimElemTime(AnimElemNo(0)) > floor ((AnimElemTime(AnimElemNo(0)) - AnimElemTime(AnimElemNo(0) + 1))/3)
ignorehitpause = 1
value = anim
elem = AnimElemNo(0) + 1

[State -3, AfterImageTime] ;This ensures that afterimages are displaying during mode
type = AfterimageTime
trigger1 = var(15) > 0
time = 2

[State -3, NoJuggleCheck] ;Infinnite juggle points!
type = AssertSpecial
trigger1 = var(15) > 0
flag = nojugglecheck

[State -3, AttDwn] ;Tone down the damage
type = AttackMulSet
trigger1 = Var(15) > 0
value = 0.5

[State -3, AttUp] ;Back to normal
type = AttackMulSet
trigger1 = Var(15) = 0
value = 1

[State -3, velset no CC]
type = Velset
triggerall = Statetype != A && (Stateno !=[800,899])
trigger1 = Var(15) > 0 && (Stateno != [6000,11000])
x = 4

[State 0, RemoveExplod]
type = RemoveExplod
triggerall = NumExplod(9910)
trigger1 = P2Dist Y < 50
id = 9910

[State 0, RemoveExplod]
type = RemoveExplod
triggerall = NumExplod(9912)
trigger1 = P2Dist Y < 50
id = 9912

[State -3: Helper]
type = Helper
triggerall = (WinKO) && (NumHelper(8400) = 0)
trigger1 =  (hitdefattr = SCA, HA,HP)
trigger2 = Stateno = 3000
trigger3 = Stateno = 3101
trigger4 = Stateno = 3201
trigger5 = Stateno = 6102
helpertype = Normal
name = "Hyper WinKO"
id = 8400
pos = 0,0
postype = p1
facing = 0
stateno = 8400
keyctrl = 0
ownpal = 1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1

[State -3, Special Finish]
type = Helper
triggerall = (WinKO) && (!NumHelper(8740)) && (!NumHelper(8787))
trigger1 =(StateNo = [200,600])
helpertype = Normal
name = "SpecialFinish"
id = 8740
pos = 0,-1500
postype = back
facing = 0
stateno = 8740
keyctrl = 0
ownpal = 1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1

[State -3, Special Finish]
type = Helper
triggerall = (WinKO) && (!NumHelper(8740)) && (!NumHelper(8787))
trigger1 =(StateNo = [200,600])
trigger2 =(StateNo = [1000,6307])
helpertype = Normal
name = "SpecialFinish"
id = 8740
pos = 0, -1500
postype = back
facing = 0
stateno = 8740
keyctrl = 0
ownpal = 1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1

[State -3, WinKO]
type =Helper
triggerall = (WinKO) && (!NumHelper(8787)) && (enemy,time=1)
trigger1 =(StateNo = [3000,3005])
helpertype = Normal
name = "WinKO"
id = 8787
pos = 0,-1500
postype = back
bindtime = -1
facing = 0
stateno = 8787
keyctrl = 0
ownpal = 1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1

;-------------------------------------------------------------------------------
;This controller plays a sound everytime Courage lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
value = S0,21

[State -3, Explod]
type = Explod
trigger1 = Anim = 5300 && time = 1
anim = 5310
id = 5310
pos = 0,-79
postype = p1
removetime = 999
scale = 1.1,1.1
sprpriority = 4
bindtime = 999

[State -3, RemoveExplod]
type = RemoveExplod
trigger1 = Anim !=5300
id = 5310

[State -3, PlaySnd]
type = PlaySnd
trigger1 = Anim = 5300 && time = 1
value = S5301,0
channel = 20

[State -3, StopSnd]
type = StopSnd
trigger1 = Anim != 5300
channel = 20

[State -3, Pain Sound]
type = PlaySnd
triggerall = Time = 1
triggerall = Life
triggerall = random < 700
trigger1 = stateno = 5000 || stateno = 5020
trigger1 = anim != 5000 && anim != 5010
trigger2 = stateno = 5010
trigger2 = anim != 5020
value = 5000,0+random%10
channel = 0
ignorehitpause = 1
volume = 255

[State -3, Pain Sound2]
type = PlaySnd
triggerall = Time = 1
triggerall = Time = 1
triggerall = Life
triggerall = random < 700
trigger1 = stateno = 5100
trigger2 = stateno = 5170
value = S5000,7

[State -3, Pain Sound3]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5100
trigger2 = stateno = 5170
value = S5100,0

[State -3, Pain Sound3]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 5070
value = S5000,1

[State -4, Hitsound]
type = PlaySnd
triggerall = Time = 50
trigger1 = anim = 5150
channel = 3
value = s5500,0

[State -4, Hitsound2]
type = PlaySnd
triggerall = Time = 50
trigger1 = anim = 5080
channel = 3
value = s5110,1

[State -4, Hitsound3]
type = PlaySnd
triggerall = Time = 50
trigger1 = anim = 5100
channel = 3
value = s5110,0

