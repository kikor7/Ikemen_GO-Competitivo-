;===========================================================================
;Super Marvel vs. Capcom - Eternity of Heroes - Constants Template
;===========================================================================

;---------------------------------------------------------------------------
;Variable List+-
;---------------------------------------------------------------------------
;Var(1 ~ 5) = Temp Var
;Var(8)     = Combo Announcer, Text Display
;Var(9)     = Combo Announcer, Sound
;Var(10)    = Combo Announcer, Danger
;Var(11)    = Combo Announcer, Normalize Score
;Var(12)    = Super Jump
;Var(13)    = Super Jump Direction

;Var(14)    = Gummi Ship

;Var(17)    = Shortcut Menu
;Var(18)    = Shortcut Menu Scroll
;Var(19)    = Ground Combo Plus
;Var(20)    = Air Combo Plus
;Var(21)    = XP Level
;Var(22)    = Finisher Plus

;Var(59)    = Artificial Intelligence

;fVar(8)    = Life/Defense Variable
;fVar(10)   = Damage Dampener
;fVar(12)   = Damage Dampener Hit Counter

;fVar(15)    = Strength
;fVar(16)    = Magic
;fVar(17)    = Defense


[Data]
life = 1000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 50
airjuggle = 15
sparkno = s2
guard.sparkno = s9745
KO.echo = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = .43
yscale = .43
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -100
mid.pos = -5, -60
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd = 1.8
walk.back = -1.1
run.fwd = 6
run.back = -8,-3
jump.neu = 0,-9.0
jump.back = -3.7
jump.fwd = 3.2
runjump.fwd = 4.4
runjump.back = -4.4
airjump.neu = 0, -8.9
airjump.fwd = 2.5
airjump.back = -2.55
air.gethit.groundrecover = -.15,-3.5
air.gethit.airrecover.mul = .5,.2
air.gethit.airrecover.add = 0,-4.5
air.gethit.airrecover.back = -1
air.gethit.airrecover.fwd = 0
air.gethit.airrecover.up = -2
air.gethit.airrecover.down = 1.5

[Movement]
airjump.num = 1
airjump.height = 35
yaccel = .41
stand.friction = .80
crouch.friction = .80
stand.friction.threshold = 2
crouch.friction.threshold = .05
air.gethit.groundlevel = 25
air.gethit.groundrecover.ground.threshold = -20
air.gethit.groundrecover.groundlevel = 10
air.gethit.airrecover.threshold = -1
air.gethit.airrecover.yaccel = .35
air.gethit.trip.groundlevel = 15
down.bounce.offset = 0, 20
down.bounce.yaccel = .4
down.bounce.groundlevel = 12
down.friction.threshold = .05

;-----------------------------------------------------------------------------
;Win Quotes - You can have up to 100 win quotes

[Quotes]
victory0  = "You need a little break-time."
victory1  = "That's the power of the Keyblade!"
victory2  = "CHEEEEEEEEEEEEESE!"
victory3  = "Whoops.    Guess I should ease back."
victory4  = "Believe in yourself."
victory5  = "Better put this in the mail."
victory6 = "My friends are my power!"
victory7 = "Wow!      Donald and Goofy would love this."
victory8 = "My friends are my power, and I'm theirs."
victory9 = "Now stay conscious for the camera!"

;Vs Thanos
victory10 = "I need more Titan friends."
victory11 = "You should learn to relax and maybe not snap so much."
victory12 = "I guess that was inevitable."

;Vs Mario
victory13 = "Sweet party, Mario!"
victory14 = "Lemme guess. Kairi's in another temple?"
victory15 = "Sora for Smash would be cool."

;Vs Wonder Woman
victory16 = "I hope I didn't upset the Justice League."
victory17 = "I've always wanted to be a superhero.     Guess I should bulk up."
victory18 = "Do you think Hades has something to do with this?"

;Vs Superman
victory19 = "Good guys watch out for each other!     Gotta stay on our toes!"
victory20 = "We should get back to fighting crime, Superman!"
victory21 = "Pretty sure the Justice League didn't like that."

;Vs Batman
victory22 = "Cool suit.     Does it change colors?"
victory23 = "The Justice League won't be the same if you keep letting me win!"
victory24 = "Now I know what it's like to fight a human Keyblade."

;Vs Dante
victory25 = "You have to have a heart to cry."
victory26 = "Your style won't beat me that easily."
victory27 = "For the last time,     don't call me 'kid'."

;Vs Vergil
victory28 = "Looks like I'm motivated, too."
victory29 = "Nice moves.      I just can't wait for you to be a good guy!"
victory30 = "Power has a way of corrupting people."

;Vs Nero
victory31 = "You were stylish, but I'm floaty."
victory32 = "Gotta let it out, gotta let it out."
victory33 = "Maybe next time, we can 2 v 2, with Kairi and Kyrie."

;Vs Mickey
victory34 = "Excellent training, Your Majesty."
victory35 = "Let's visit other worlds sometime, King Mickey!"
victory36 = "So where did the whole 'Lucky Emblems' thing come from?"

;Vs Cloud
victory37 = "Let's rematch in 3D."
victory38 = "Great swordplay. I'll see you back at the coliseum, Cloud!"
victory39 = "Hey, can you explain the whole Aerith vs Aeris thing again?"

;Vs Sephiroth
victory40 = "I'm not letting you beat me, Sephiroth."
victory41 = "Maybe don't bother Cloud so much?"
victory42 = "Aerith says hi."

;Vs Goku
victory43 = "Great fight, Son Goku."
victory44 = "Let's have a rematch at the world tournament."
victory45 = "Too bad.    Winner gets to fight Beerus."

;Tifa
victory46 = "Do you still serve lemonade at the bar?"
victory47 = "You did great, Tifa!     Next time, I won't hold back."
victory48 = "I don't get slugged easily.     Yeah, yeah...     Except the one time."

;Squall
victory49 = "I think we've both gotten stronger, Leon!    Way to go!"
victory50 = "I've come a long way since Traverse Town.    Be a shame if I lost all my power again."
victory51 = "I can also shoot fire and ice.    Does that make it a Key - Gunblade?"

;-----------------------------------------------------------------------------
;Run Forward

[Statedef 100]
type    = S
physics = N
anim    = 100
sprpriority = 1
;velset = 4, 0

[State 100, Don't Walk]
type = AssertSpecial
trigger1 = 1
flag = NoWalk
flag2 = NoAutoTurn

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, Dash Sound]
type = PlaySnd
triggerall = random <= 999
trigger1 = time = 1
value = s301,95
channel = 5

[State 100, Dash Sound]
type = PlaySnd
triggerall = random <= 749
trigger1 = time = 1
value = s301,96
channel = 5

[State 100, Dash Sound]
type = PlaySnd
triggerall = random <= 499
trigger1 = time = 1
value = s301,97
channel = 5

[State 100, Dash Sound]
type = PlaySnd
triggerall = random <= 249
trigger1 = time = 1
value = s301,99
channel = 5

;[State 100, Dash Spark]
;type = Explod
;trigger1 = time < 15
;trigger1 = (time % 4) = 1
;ID = 41
;anim = 2222
;postype = p1
;pos = -20, -40
;bindtime = 1
;removetime = -2
;vel = -1, 0
;ownpal = 1
;random = 20, 60
;sprpriority = 2
;
;[State 100, Dash Spark]
;type = Explod
;trigger1 = time < 15
;trigger1 = (time % 4) = 0
;ID = 42
;anim = 2222
;postype = p1
;pos = -20, -40
;bindtime = 1
;removetime = -2
;vel = -.8, 0
;ownpal = 1
;random = 20, 60
;sprpriority = 2

[State 100, 4]
type = ChangeState
Trigger1 = !var(59)
trigger1 = command != "holdfwd"
value = 101
ctrl = 1

; RUN_END
[Statedef 101]
type    = S
movetype = I
physics = S
anim = 101
sprpriority = 1

[State 101, 4]
type = ChangeState
trigger1 = animtime = 0
value = 0



