triggerall = anim = 2300
trigger1 = pos y = -100
trigger2 = time >= 180
trigger3 = var(1) = 1 && (time >= 60)
y = 0
ignorehitpause = 1 
persistent = 1

[State ]
type = velset
triggerall = anim = 2300
trigger1 = var(1) = 1
trigger2 = time >= 180
X = 0
ignorehitpause = 1 
persistent = 1

[State ]
