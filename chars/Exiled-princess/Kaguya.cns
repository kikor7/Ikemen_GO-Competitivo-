triggerall = anim = 2300
triggerall = var(1)!= 1
trigger1 = pos x = [85,90]
trigger2 = time >= 180
var(1) = 1
ignorehitpause = 1

[State ]
type = selfState
triggerall = ishelper
trigger1 = time >= 300
trigger2 = var(1) = 1
value = 2302
ctrl = 1
