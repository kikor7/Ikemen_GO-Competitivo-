triggerall = time <= 180
triggerall = anim = 2300
triggerall = facing = 1
trigger1 = pos x!= [85,90]
x = cond(pos x > 85, -4, 4)
ignorehitpause = 1 
persistent = 1

[State ]
type = velset
triggerall = time <= 180
triggerall = anim = 2300
triggerall = facing = -1
trigger1 = pos x!= [85,90]
x = cond(pos x > 85, 4, -4)
ignorehitpause = 1 
persistent = 1

[State ]
type = velset
triggerall = time <= 180
triggerall = anim = 2300
triggerall = var(1) != 1
trigger1 = pos y!= -100
y = cond(pos y > -100, -1.5, 1.5)
ignorehitpause = 1 
persistent = 1

[State ]
