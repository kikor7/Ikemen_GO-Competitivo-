trigger1 = Var(35) = 1
physics = N

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Var(35) = 0
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, 2]
type = VelSet
trigger1 = Var(35) = 1
trigger1 = Time = 0
x = 0
y = 0

[State 120, 最低位置]
