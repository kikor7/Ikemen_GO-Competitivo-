trigger1 = Time = 1
value    = s0, 4

;■RUN_FWD  ダッシュがすぐ終わらないように(ステップインのイメージで)
[Statedef 100]
type    = S
physics = S
anim = 100
ctrl     = 0
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 755, 動ける]
type = CtrlSet
trigger1 = Time = 7
value    = 1

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
trigger1 = Time > 7
value = 0

;■GUARD (start)変更まがかみ
