trigger1 = Time = 0
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value    = IfElse((Vel X)= 0, 41, IfElse((Vel X)> 0, 42, 43))

[State 50, 3]
