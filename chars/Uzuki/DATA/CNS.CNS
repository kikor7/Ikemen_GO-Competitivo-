triggerall = Var(47) = [0,4]           ;パワーボムが0～4
trigger1 = Power >= 1000 && Time = 1
var(17)  = 1
[State 199,パワーボム増える]
type = VarAdd
trigger1 = Var(17) = 1 && Time = 1
v        = 47
value    = 1
[State 199,パワーボムパワー減_パワーゲージ増減]
type = PowerAdd
trigger1 = Var(17) = 1 && Time = 1
value    = -1000

[State 199, 動ける]
type = CtrlSet
trigger1 = Time >= 20
value    = 1

[State 199, 終了]
type = ChangeState
trigger1 = AnimTime = 0
value    = 0
ctrl     = 1




