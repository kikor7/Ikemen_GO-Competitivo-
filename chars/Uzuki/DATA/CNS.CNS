;■CNSの索引です。
;うづき基本データ
;開始～勝ちポーズ等の演出、挑発
;特殊動作
;commonの上書き
;通常技等のステート
;必殺技のステート
;投げのステート
;超必殺技のステート
;オーバードライヴ
:ODまがかみ
;ヘルパー
;(Statedef -2とStatedef -3は0uzuki.defにあります)


;パラメータの説明をちょこっとつけてます。間違っている所もあると思いますが、
;キャラ作成の参考になればと。mugen本体docs内のsctrlsとtriggerと見比べながら
;確認してください。

;****************うづき基本データ*************************

[Data]
life    = 1000            ;初期体力(最大値)
attack  = 100             ;攻撃力 %
defence = 100             ;防御力 %
power   = 3000            ;パワーゲージ最大値
fall.defence_up = 50      ;空中コンボ補正(防御力UP)
liedown.time    = 60      ;ダウン回復時間
airjuggle       = 30      ;ジャグル(空中コンボ)ポイント最大値
sparkno         = 2       ;基本ヒットスパーク
guard.sparkno   = 40      ;基本ガードスパーク
KO.echo         = 1       ;１でKO時に声にエコー
 volume           = 90
IntPersistIndex   = 39    ;リセットするVar(type = VarRangeSetで0にリセットする範囲?) Def60
FloatPersistIndex = 40    ;IntPersistIndexはVar、FloatPersistIndexはfvar

[Size]
xscale       = 1          ;水平サイズ 倍
yscale       = 1          ;垂直サイズ 倍
ground.back  = 13         ;キャラの幅(後方,地上)             投げられ時などの位置に影響
ground.front = 14         ;キャラの幅(前方,地上)
air.back     = 12         ;キャラの幅(後方,空中)
air.front    = 12         ;キャラの幅(前方,空中)
height       = 50         ;キャラの高さ(相手が飛び越えるなどの位置に影響)
attack.dist  = 160        ;攻撃時相手がガード体制に入る最低距離
proj.attack.dist = 90     ;飛び道具攻撃時相手がガード体制に入る最低距離
proj.doscale = 0          ;１で上で設定したサイズを飛び道具にも適用する  
head.pos     = -4, -85    ;頭の座標                          投げられ時などの位置に影響
mid.pos      = -4, -60    ;体の中心の座標                    投げられ時などの位置に影響
shadowoffset = 0          ;影の垂直方向の表示位置
draw.offset  = 0,0        ;キャラの表示位置(x, y)

[Velocity]
walk.fwd  =   2.2         ;歩き前進速度
walk.back =  -2.0         ;歩き後退速度
run.fwd   =   4.6, 0      ;前ダッシュ（ラン）の速度(x,y)
run.back  =  -5.2,-3.3    ;バックステップ(yがマイナスなので)の速度
jump.neu  =     0,-8.4    ;垂直ジャンプの速度
jump.back = -2.55         ;後ジャンプの速度
jump.fwd  =   2.5         ;前ジャンプの速度
runjump.back = -2.55,-8.1 ;後ダッシュしながらのジャンプ速度(opt)
runjump.fwd  = 4,-8.1     ;前ダッシュしながらのジャンプ速度(opt)
airjump.neu  = 0,-8.1     ;垂直空中ジャンプの速度(opt)
airjump.back = -2.55      ;後空中ジャンプの速度(opt)
airjump.fwd  =  2.5        ;前空中ジャンプの速度(opt)

[Movement]
airjump.num     = 1       ;空中ジャンプ回数(opt)             0で空中ジャンプしない
airjump.height  = 49      ;空中ジャンプできる最低高さ
yaccel          = .44     ;重力 落下速度                     physics = Aに反映
stand.friction  = .85     ;立ち状態の摩擦係数(地面との抵抗)  physics = Sに反映
crouch.friction = .86     ;屈み状態の摩擦係数                physics = Cに反映




;****************開始～勝ちポーズ等の演出、挑発***********
;-----------------------------------------------------------------------------------
;■タイムオーバー負け
[Statedef 170]
type   = S
ctrl   = 0
anim   = 170
velset = 0, 0

[State 170, 無敵]
type = NotHitBy
trigger1 = 1
value    = SCA               ;(立ち(S)/屈み(C)/空中(A)攻撃に対して)
time     = 1

[State 170, 軸移動]
type = PosAdd
trigger1 = AnimElem = 2       ;アニメ2枚目
x = 10                        ;前方へ10移動

[State 170, 敗北var]
type = VarSet                 ;VariableSet
trigger1 = Var(45) = 0
var(45)  = 1                  ;var(45)に1を入力。trigger1 = var(45)  = 1とあるStateで実行させる

;-----------------------------------------------------------------------------------
;■勝ち動作分岐
[Statedef 180]
type   = S
ctrl   = 0
velset = 0, 0

[State 180, 最終R勝ち動作走る！へ]
type = ChangeState
trigger1 = MatchOver = 1           ;1ラウンド目以外
trigger1 = Time = 0
value    = 184

[State 180, Statedef 188パーフェクトへ]
type = ChangeState
trigger1 = MatchOver = 0           ;1ラウンド目
trigger1 = WinPerfect = 1          ;パーフェクト勝利
value    = 188

[State 180,1R目ランダム]
type = VarRandom
trigger1 = Time = 0
v        = 1
range    = 1,3                     ;(Var(1)に1～3をランダム代入)
[State 180,Statedef 181へ]
type = ChangeState
trigger1 = Time = 1 && Var(1) = 1  ;(VarRandomでVar(1)が1なら実行)
value    = 181
[State 180,Statedef 182へ]
type = ChangeState
trigger1 = Time = 1 && Var(1) = 2
value    = 182
[State 180,Statedef 183へ]
type = ChangeState
trigger1 = Time = 1 && Var(1) = 3
value    = 183

;■勝ち動作ガッツポーズ
[Statedef 181]
type = S
ctrl = 0
anim = 181

[State 181, 無敵]
type = NotHitBy
trigger1 = 1
value    = SCA
time     = 1

[State 181, 声「やった」_音鳴らす]
type = PlaySnd
trigger1 = AnimElemTime(4) = 0
value    = s5, 6                   ;S*,*で自分(snd.snd)、F*,*でcommon.sndより音を使用

;■勝ち動作手ぱたぱた
[Statedef 182]
type = S
ctrl = 0
anim = 182

[State 182,声]
type = PlaySnd
trigger1 = Time = 0
value    = s5, 3

[State 182, 無敵]
type = NotHitBy
trigger1 = 1
value    = SCA
time     = 1

;■勝ち動作いえい！
[Statedef 183]
type = S
ctrl = 0

[State 183, アニメ変更]
type = ChangeAnim
trigger1 = Anim != 1830 && Anim != 1831  ;アニメNo.1830と1831以外
trigger1 = Time = 0
value    = 183
sprpriority = 2

[State 183, アニメ変更H]
type = ChangeAnim
trigger1 = Var(59) >= 3 && Life < 300 && Random < 60 ;Random 60/1000
trigger1 = Anim = 183 && AnimElem = 5
value    = 1831
sprpriority = 2

[State 183, アニメ変更H2]
type = ChangeAnim
trigger1 = Var(59) >= 3 && Life < 500  && Random < 120
trigger1 = Anim = 183 && AnimElem = 5
value    = 1830
sprpriority = 2

[State 183, 制服_画像を表示]
type = Explod
trigger1 = Anim = [1830,1831]  ;アニメNo.1830～1831
trigger1 = AnimElem = 1
anim     = 1832            ;アニメナンバー
ID       = 1832            ;画像IDナンバー
postype   = P1             ;基準位置p1,p2,front(p1前),back(p1後),left(画面左上),right(画面右上)
pos       = 0, 0
;random   = 0, 0            10で-5～5 ?
;velocity = 0, 0            速度 x,y
;accel    = 0, 0            加速 x,y
removetime  = -1           ;表示時間
facing      = 1            ;表示向き(vfacingは縦方向) -1で反転
scale      = 1,1           ;表示サイズ倍率 x,y
sprpriority = 3            ;表示順位(数が大きい程手前)
ontop = 1                  ;表示重ね 1でキャラより手前
ownpal = 1                 ;自分の色 1でプレイヤーパレット変化に影響しない
shadow = 255, 255, 255     ;影 0,0,0でナシ
persistent  = 0            ;継続しない 1で trigger1 = 1 と同じ効果
removeongethit = 1         ;1でやられ中も表示

[State 183, 無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 183, 声「やった」]
type = PlaySnd
trigger1 = Time = 2
value = s5, 6

;■最終ラウンド勝ち動作走る！
[Statedef 184]
type = S
ctrl = 0
sprpriority = -2

[State 184, 特殊命令]
type = AssertSpecial
trigger1 = Time = [0, 180]        ;Timeが0～180　(0,180)と書くと1～179
flag     = roundnotover           ;ラウンド終了延長

[State 184, 勝利時位置_Varに加算]
type = VarAdd
trigger1 = Var(44) > 50
trigger1 = 1
v        = 44
value    = -3

[State 184, 分岐]
type = ChangeState
triggerall = 1
trigger1 = Floor(Var(44)) <= 50     ;Floor=小数切捨て
trigger2 = FrontEdgeBodyDist <= 50  ;画面前方端からキャラの前までの距離50以下
value    = 185

[State 184, アニメ変更]
type = ChangeAnim
trigger1 = Time = 0
value    = 100

[State 184, 移動速度]
type = VelSet
trigger1 = Time = 0
x        = Const(Velocity.run.fwd.x)  ;Const(基本データ[Velocity].前ダッシュの速度)

