;****************commonの上書き***************************
;以下はmugen本体data内のcommon1.cnsのStatedefを変更しています。
;common1.cnsにある[Statedef]と同じ番号を使えば、こちらが優先されます。
;-----------------------------------------------------------------------------------
;うづきオーバードライヴ Statedef 0書換え、パワーアップ専用立ち絵を表示
;変身キャラなどはこれの応用です。
;■Stand
[Statedef 0]
type    = S
physics = S
sprpriority = 0

[State 8000, 5]
type = ChangeState
trigger1 = Var(35) = 1
trigger1 = Time = 0
value = 8510

[State 0, 1]
type = ChangeAnim
triggerall = Var(11) > 0
trigger1 = Anim != 8010 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 8010
[State 0, 1]
type = ChangeAnim
triggerall = Var(11) = 0
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(Vel X) < 2             ;abs その引数の絶対値
trigger2 = Time = 4
x = 0

;■Stand to Crouch    しゃがみ時慣性で移動します
[Statedef 10]
type    = C
physics = N;C
anim = 10

[State 10, 1]
type = Null;VelMul        Nullによってこのパラメータは実行されない
trigger1 = Time = 0
x = .75

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;■Jump Start  大ジャンプ開始用に追加したState(書き換えでは無い)
[Statedef 39]
type    = S
physics = S
ctrl    = 0

[State 39, Var大ジャンプ]
type = VarSet
trigger1 = Time = 0
trigger1 = Var(10) = 0
v     = 10
value = 2

[State 39, ジャンプ]
type = ChangeState
trigger1 = Time = 1
value = 40

;■Jump Start 大ジャンプ、小ジャンプ追加の為、Statedef 40と50を変更
[Statedef 40]
type    = S
physics = S
ctrl    = 0
anim    = 40
sprpriority = 1

[State 40, Var小ジャンプ]
type = VarSet
trigger1 = command != "holdup"      ;上を入れていない
trigger1 = Time > 0 && Var(10) = 0
v        = 10
value    = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0
[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1
[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, ジャンプ]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(10) = 0
x = IfElse(sysvar(1)=0, Const(velocity.jump.neu.x), IfElse(sysvar(1)=1, Const(velocity.jump.fwd.x), Const(velocity.jump.back.x)))
y = Const(velocity.jump.y)
[State 40, 大ジャンプ]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(10) = 2
x = IfElse(sysvar(1)=0, Const(velocity.jump.neu.x), IfElse(sysvar(1)=1, Const(velocity.jump.fwd.x), Const(velocity.jump.back.x)))*2.3
y = Const(velocity.jump.y) * 1.3
[State 40, 小ジャンプ]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = Var(10) = 1
x = IfElse(sysvar(1)=0, Const(velocity.jump.neu.x), IfElse(sysvar(1)=1, Const(velocity.jump.fwd.x), Const(velocity.jump.back.x)))
y = Const(velocity.jump.y) * 0.65

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = PrevStateNo = 100        ;前Stateがダッシュ(RUN_FWD)の時
trigger1 = sysvar(1) = 1
x        = const(velocity.runjump.fwd.x)

[State 40, Jump Up]
type = ChangeState
trigger1 = AnimTime = 0
value    = 50
ctrl     = 1

;■Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 残像]
type = AfterImage
trigger1 = Time = 0
trigger1 = Var(10) != 0
time     = 30
trans    = add1
timegap  = 1
framegap = 2
length   = 8
palbright   = 12,12,12
palcontrast = 225,225,225
palpostbright = 0,0,0
paladd        = 0,0,0
palmul        = 1,1,1

[State 50, ジャンプVarOFF]
type = VarSet
trigger1 = Var(10) != 0
trigger1 = Time = 2
v        = 10
value    = 0
ignorehitpause = 1

[State 50, 1]
