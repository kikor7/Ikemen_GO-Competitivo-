trigger1 = Var(46) = 0
trigger1 = Time = 30
trigger1 = !NumHelper(187)   ;ヘルパーID=186が使用されて無い(師匠が出ていない)
ID       = 187               ;ヘルパーID
name     = "sisyo"           ;ヘルパー名前
facing   = 1                 ;向き -1で逆向き
pos      = -315,0            ;出現位置 x,y
postype  = P1                ;出現位置 (P1/P2/Front/Back/Left/Right)
stateno  = 187               ;ヘルパーStateNo
helpertype  = Normal         ;playerだと画面端で止まる(プレイヤーキャラと認識)
keyctrl     = 0              ;コントロール不可  
ownpal      = 1              ;色を独立
sprpriority = 1              ;絵の重なり(数が大きい程手前)

[State 185, Statedef 9105へ]
