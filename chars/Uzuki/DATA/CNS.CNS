trigger1 = Var(35) = 1
trigger1 = Pos y > -7
y = -7
[State 120, 最高位置]
type = PosSet
trigger1 = Var(35) = 1
trigger1 = Pos y < -170
y = -170

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0 && Life > 0
value = 130 + (statetype = C) + (statetype = A)*2

;■AIR GUARD (guarding)変更まがかみ
