;****************投げのステート***************************
; 投げは自分の他に相手の分も記述しなくてはなりません
;-----------------------------------------------------------------------------------
;■うづきスロー発動 投げの発生と失敗した時
[Statedef 800]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800

[State 800, 掴み]
type = HitDef
trigger1 = Var(14) = 0
trigger1 = P2life > 0 && p2movetype != H
Trigger1 = Time = 0
attr = S, NT          ;S(立ち),N(通常)投げ(T)
hitflag = M-          ;-をつけ、のけぞり中に投げが入らないようにしてある
priority = 1, Miss    ;１は優先順位が低いので、相打ち時技がでないかミスする
sparkno = -1          ;-をつけるとヒットスパーク無し
sprpriority = 1
p1facing = IfElse (command = "holdfwd", -1, 1) ;前を押したらターンする
p2facing = 1          ;相手の向き　-1なら背向け(ジャーマン等の時はこれ)
p1stateno = 801       ;攻撃ヒットしたら、自分はStatedef 801へ
p2stateno = 805       ;相手はStatedef 805へ移動
fall = 1

[State 800, 投げ失敗時の移動ステート]
type = ChangeState
Trigger1 = AnimTime = 0
value = 0
ctrl = 1

