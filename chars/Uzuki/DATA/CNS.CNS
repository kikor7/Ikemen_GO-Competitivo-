[State 850,残像]
type = AfterImage
trigger1 = Time = 0
time     = 16              ;残像表示時間
length   = 15              ;表示時間 timegapとframegapに影響 Def=20最大60
TimeGap  = 1               ;飛ばすフレーム
FrameGap = 5               ;表示画像のフレーム数 2なら、1フレームおき表示
Trans    = Add             ;透明度タイプ (none,add, add1,sub)
PalBright   = 120,120,120  ;明るさ Def=30,30,30
PalContrast = 80,80,120  ;コントラスト Def=120,120,220
PalMul      = 0.5,0.5,0.5
;palcolor      = 256        256色『256』か白黒『0』
;palinvertall  = 1          色の反転 -の場合反転 Def=0
;palpostbright = 0,0,0      Def=0,0,0

[State 850, パレット変更]
type = PalFX               ;BGPalFXは背景、AllPalFXは全ての色
trigger1 = Time = 0
time     = 30              ;効果時間 -1なら持続時間無限
add      = -40,-40,-40     ;pal = add赤,add緑,add青
mul      = 215,215,215     ;pal = mul赤,mul緑,mul青
;sinadd  = 30,30,30,4       pal = ampl赤,ampl緑,ampl青,ゲーム時間sin(2*pi*t/period)点滅状態
;                           計算式は、(pal赤 + add赤 + ampl赤*sin(2*pi*t/period))*mul赤/256
invertall = 0              ;0以外ならネガ反転
color     = 256            ;カラー256、白黒0

