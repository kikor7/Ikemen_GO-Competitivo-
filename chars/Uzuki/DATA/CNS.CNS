;■やぶれる 超必殺技やられ用に追加したState(書き換えでは無い)
[Statedef 5400]
type     = U
movetype = H
physics  = N
ctrl     = 0
sprpriority = -3

[State 5400, アニメ変更] 
type = ChangeAnim
trigger1 = Time = 0
value    = 5400

[State 5400, 超技負けvar]
type = VarSet
trigger1 = 1
var(45)  = 2

[State 5400,無敵]
type = NotHitBy
trigger1 = 1
value = SCA
time  = 1

[State 5400,幅調整]
type = Width
trigger1 = 1
value    = 10, 10

[State 5400,速度]
type = VelSet
trigger1 = Anim = 5400
trigger1 = AnimElem = 1, 0
x        = -5
y        = -7.8
[State 5400,加速]
type = VelAdd
trigger1 = 1
y        = 0.32

[State 5400,アニメ変更]
type = ChangeAnim
trigger1 = Anim = 5400
trigger1 = Time >= 10 && Pos Y >= -2
value    = 5401

[State 5400,StateType設定]
type = StateTypeSet
trigger1 = Anim =5400
statetype = A
[State 5400,StateType設定]
type = StateTypeSet
trigger1 = Anim =5401
statetype = L

[State 5400,速度]
type = VelSet
trigger1 = Anim = 5401 && AnimElem = 1, 0
x        = 0
y        = 0
[State 5400,速度]
type = VelSet
trigger1 = Anim = 5401 && AnimElem = 1, 1
x        = -1.8
y        = -3.8

[State 5400, 振動]
type = EnvShake
trigger1 = Anim =5401 && AnimElem = 2
time     = 6                ;振動時間
ampl     = -4               ;振動の大きさ -は最初に下に揺れる Def=-4
freq     = 50               ;0(遅い振り)～ 60 ～180(速い振り)
phase    = 90               ;振動の初期位置の設定 90以上でない限り0

[State 5400,終了]
type = ChangeState
trigger1 = Anim =5401
trigger1 = Vel Y > 0 && Pos Y >= -1
value    = 5150

;■敗北後・・・やるぞ！ common1.cnsのStatedef 5150を変更
; HIT_LIEDEAD
[Statedef 5150]
type     = L
movetype = H
physics  = N
sprpriority = -3

[State 5150, 必殺技やられアニメ]
type = ChangeAnim
trigger1 = PrevStateNo = 5400
trigger1 = Var(45) = 2 && Time = 0
value    = 5402

[State 5150, 必殺技やられ接地]
type = VelSet
trigger1 = Var(45) = 2 && Time = 0
y        = 0
persistent = 0

[State 5150, チームバトルやられて勝つアニメ]
type = ChangeAnim
trigger1 = TeamMode = Simul           ;TeamMode = (Single,Simul,Turns)
trigger1 = RoundState = 4             ;勝利ポーズ時
trigger1 = Var(45) = 2 && Win && Anim != 5410
value    = 5410
[State 5150, 声]
type = PlaySnd
trigger1 = Anim = 5410 && AnimElemTime(5) = 0
value    = s5, 1

[State 5150, 敗北var]
type = VarSet
trigger1 = Var(45) = 0
var(45)  = 1

[State 5150, 1] ;Normal anim
type = ChangeAnim
triggerall = Var(45) != 2
triggerall = Time = 0
triggerall = SelfAnimExist(5140)
trigger1 = (anim != [5111,5119]) && (anim != [5171,5179])
trigger2 = !SelfAnimExist(5140 + (anim % 10))
value    = 5140

[State 5150, 3] ;Hit up type anim
type = ChangeAnim
triggerall = Var(45) != 2
trigger1 = Time = 0
trigger1 = (anim = [5111,5119]) || (anim = [5171,5179])
trigger1 = SelfAnimExist(5140 + (anim % 10))
value    = 5140 + (anim % 10)

[State 5150, 4] ;Match over anim
type = ChangeAnim
triggerall = Var(45) != 2
trigger1 = MatchOver = 1
trigger1 = Anim = [5140,5149]
trigger1 = SelfAnimExist(anim+10)
value    = anim+10
persistent = 0

[State 5150, 5] ;Switch to 5110 if liedead anim does not exist
type = ChangeAnim
triggerall = Var(45) != 2
trigger1 = Time = 0
trigger1 = Anim != [5140,5159]
trigger1 = Anim != [5110,5119]
value    = 5110

[State 5150, 6] ;Friction
type = VelMul
trigger1 = 1
x        = 0.85

[State 5150, 7] ;Friction
type = VelSet
trigger1 = Vel X < .05
x        = 0
persistent = 0

[State 5150, 8]
type = NotHitBy
trigger1 = 1
value    = SCA
time     = 1

;■開始時設定とポーズ持ち越し common1.cnsのStatedef 5900を変更
;■Initialize (at the start of the round)
[Statedef 5900]
type = S
sprpriority = -3

[State 5900, もう負けない！]   ;Round2以降開始時ポーズとる
type = ChangeAnim
triggerall = Var(45) != 0      ;自分が負けた事を認識するVar
trigger1 = RoundState = 0      ;開始フェードイン
trigger1 = Anim != 197
value    = 197

[State 5900, 次も勝つよ！]         ;Round2以降開始時ポーズとる
type = ChangeAnim
triggerall = Var(45) = 0 && RoundNo != 1
trigger1 = RoundState = 0
trigger1 = Anim != 196
value    = 196

[State 5900,勝ちポーズ相手との距離]
type = VarSet
trigger1 = RoundState = 0
var(44)  = 0

[State 5900, Varリセット] ;Clear all int variables
type = VarRangeSet
trigger1 = RoundNo = 1      ;Round１の時
first    = 0                ;first(def=0)～last(def=59)で範囲が指定されなければ持ち越し?
last     = 39
value    = 0

[State 5900, FVarリセット] ;Clear all float variables
type = VarRangeSet
trigger1 = RoundNo = 1
fvalue   = 0

[State 5900,ストライカーボム]
type = VarSet
trigger1 = RoundNo = 1
var(47)  = 3

[State 5900, Intro(開始時)]
type = ChangeState
trigger1 = RoundNo = 1
value    = 190

[State 5900, 3] ;Intro
type = ChangeState
trigger1 = AnimTime = 0
value    = 0




;****************通常技等のステート***********************
;-----------------------------------------------------------------------------------
;■立ち弱パンチ
[Statedef 200]
type    = S                 ;状態 立ち(S)/屈み(C)/空中(A)/ダウン(L)
movetype= A                 ;行動  通常(I)/攻撃(A)/ダメージをくらってる(H)
                            ; これがAでないとHitDefは実行されない
physics = S                 ;物理学？ 立ち(S)/屈み(C)/空中(A)/無し(N)
                            ; 行動時に基本データ[Velocity[Movement]]の影響を受ける 地上でのふんばりと空中での重力
juggle   = 14               ;ジャグル(空中コンボ)ポイント
                            ; 基本データ[Data[airjuggle]]の値を超えるようなら、攻撃はヒットしない
;Commonly-used controllers:
velset   = 0, 0             ;ステート開始時の移動速度
ctrl     = 0                ;0で操作受け付け不可
anim     = 200              ;このステートで表示するアニメ番号 AIR参照
poweradd = 0               ;パワー増加量 20プラス
sprpriority = 2             ;絵の重なり(数が大きい程手前)
;hitdefpersist  = 0          1で前StateのHitDefを引き継ぐ
;movehitpersist = 0          1で前StateのMoveHitを引き継ぐ
;hitcountpersist= 0          1で前StateのHitCountを引き継ぐ


[State 200, 音シュ]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0

[State 200, 攻撃]
type = HitDef                ;攻撃用ステート
trigger1 = AnimElem = 3      ;アニメ3枚目に実行
;↓Required parameters
attr = S, NA             　  ;ステートタイプ(S/C/A), 通常(N)/特殊(S)/超必(H)
                             ;  攻撃(A)/投げ(T)/飛び道具(P)
                             ; 相手の行動(特に当身技)に影響するので重要
damage = IfElse (Var(14) = 1, 0, 23), 0    ;ダメージ（ヒット,ケズリ）
                             ; ここではザ・ワールド発動時(Var(14) = 1)と切り替えのため、IfElseを使用(damage = 23, 0)
hitflag   = MAF              ;当てられる状態 +はGetHit(くらい)中の相手に当る（MはH+L）
                             ; 上段(H)/下段(L)/中段(M)/空中(A)/落下(F)/ダウン(D)
guardflag = MA               ;ガードできる状態（MはH+L MAで全ガード可能）
;↓Optional parameters(省略可)
priority  = 3, Hit           ;攻撃優先度（0～7),Hit(ヒット)>Dodge(避け)>Miss(失敗)
sparkno  = 0                 ;ヒットスパーク（ｓ*,*で自分のヒットスパーク）(Def: set above)
;guard.sparkno  = 0          ;ガードスパーク（ｓ*,*で自分のヒットスパーク）(Def: set above)
sparkxy  = -5, -76           ;ヒットスパーク座標（X-offset相手,Y-offset自分の座標）
hitsound   = s1, 1           ;ヒット音（ｓ*,*で自分の音fならcommon.sndから）
guardsound = s6, 1           ;ガード音（同上）
pausetime = 10, 10           ;攻撃ヒット時の硬直時間(自分,相手)
ground.slidetime= 5          ;ヒット時の滑り時間(pausetime含まない)
ground.hittime  = 12+Var(32) ;食らい状態時間(高くしすぎない) Def=0
                             ; Var(32)はカウンター時使用のため
ground.velocity = -2.4       ;地上で攻撃をくらった相手のふっとび（ｘ,ｙ 小数点可）
ground.type     = High       ;くらい場所（High,頭=Def/体/Low,足/Trip,足払い/None/Back)
guard.pausetime = 10, 10     ;攻撃ガード時の硬直時間(自分,相手)
;guard.hittime  = 12+Var(32)  ガード状態時間               Def=ground.hittime
;guard.slidetime= 5           ガード時の滑り時間           Def=guard.hittime
;guard.ctrltime = 5           ガード後操作できるまでの時間 Def=guard.slidetime
;guard.dist     = 160         相手のガードポーズのとれる距離
air.type        = High       ;空中で相手のくらい場所       Def=ground.type
air.velocity    = -1.4,-3    ;空中で攻撃をくらった相手のふっとび
air.hittime     = 12         ;空中食らい回復までの時間     Def=20
airguard.velocity= -1.9,-.8  ;空中ガードした場合のふっとび
;airguard.ctrltime = 5        ガード後操作できるまでの時間 Def=guard.ctrltime
animtype = Light             ;ヒット時相手ポーズ(Light/Medium/Hard/Back/Up/Diagup)
                             ; air.animtype, fall.animtype 
;ID           = 200           target(ID)
;P1facing     = 1             ヒット時、1なら向き合い、-1なら自分背向け
;P1stateno    = 1
;P2facing     = 1             ヒット時、1なら向き合い、-1なら相手背向け
;affectteam   = E             両チームB、敵チームE、味方チームF
;forcestand   = 0             1で強制的に立たせる
;fall         = 0             1で相手をFall(落下ダウン状態)状態にする air.hittimeは無視される
;fall.recover = 1             0で相手をFall状態から回復させない
;fall.recovertime = 0         Fall状態から回復できる時間
;air.juggle   = 7             空中コンボポイント(Statedefで指定しない場合 飛び道具)
;getpower     = 0,0           自分パワー増加 上記poweradd
;givepower    = 0,0           相手パワー増加
;yaccel       = 0             相手落下時加速
;numhits      = 0             0でヒット数カウントしない
;hitonce      = 1             1人の敵にだけ影響を及ぼす

[State 200, 終了]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

