;Var List:

; - Var(2) = 4 Tails Mode
; - Var(3) = Sennin Mode
; - Var(4) = Bijuu Mode
; - Var(5) = Limitador Air Jump
; - Var(6) = Sennin Capa
; - Var(7) = NO TOCAR
; - Var(8) = NO TOCAR
; - Var(10) = Apariencia Transformaciones
; - Var(11) = Golpeado Transformaciones
; - Var(12) = Oscurecer Pantalla
; - Var(14) = Specials Transformaciones
; - Var(15) = Sennin Activado
; - Var(16) = Lifedd Kurama Mode

