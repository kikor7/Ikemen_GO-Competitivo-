; Definition file for Kung Fu Man
; Contains all the filenames needed for the character
; Player information
[Info]
name = "Floren"        ;Name of character
displayname = "Floren" ;Name of character to display
versiondate = 04,14,2002    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Elecbyte"         ;Character author name
pal.defaults = 1      ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd     = flor.cmd   ;Command set
cns     = flor.cns   ;Constants
st      = flor.cns   ;States
sound   = flor.snd   ;Sound
stcommon = flor_common.cns ;Common states
sprite  = flor.sff   ;Sprite
anim    = flor.air   ;Animation

pal1    = flor.act  ;Palettes (can have up to 12)