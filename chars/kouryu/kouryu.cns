id = 13040
sprpriority = 2
name = "parfect"
pos = 0,0
postype = p1
stateno = 13040
helpertype = normal
pausemovetime = 99
keyctrl = 1 
ownpal = 1

[State 181]
type = ChangeState
trigger1 = NumHelper(13040) = 0
trigger1 = time >= 0
trigger2 = NumPartner && Time = 0 
value = 181

