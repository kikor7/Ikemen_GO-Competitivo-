; ここにキャラ情報を書いてください
[Info]
name = "pikaman_R"        ;キャラの名前
displayname = "pikaman_R" ;表示されるキャラの名前
versiondate = 11,22,2000    ;キャラの更新情報
mugenversion = 11,22,2000   ;キャラが動くmugenのバージョン
author = "ryun"         ;キャラの製作者名
pal.defaults = 6,3,4,2      ;敵としてでるキャラのパレット

; Files for the player
[Files]
movelist = movelist.dat
cmd     	= 		pikaman_R_CNS/pikaman.cmd.cns   ;キャラのコマンド
cns     	= 		pikaman_R_CNS/pikaman.cns   ;キャラのプログラム
st      	= 		pikaman_R_CNS/pikaman.cns   ;キャラのプログラム
st1     	= 		pikaman_R_CNS/-3.cns
st2     	= 		pikaman_R_CNS/pikaman_R_H.cns
st3     	= 		pikaman_R_CNS/power.cns
st4     	= 		pikaman_R_CNS/away.cns
st5     	= 		pikaman_R_CNS/pikaman_R_S.cns
st6     	= 		pikaman_R_config.cns 
stcommon	= 		pikaman_R_CNS/common1.cns 
sprite  	= 		pikamanc.sff   ;キャラの絵
anim    	= 		pikamanc.air   ;キャラの動き
sound   	= 		pikaman.snd   ;キャラの音



pal1    	= 	act/01.act
pal2    	= 	act/02.act
pal3    	= 	act/03.act
pal4    	= 	act/04.act
pal5    	= 	act/05.act
pal6    	=	act/06.act	
pal7    	= 	act/07.act