;---------------------------------------------------------------------------
;シールド（特殊行動）:地上
[Statedef 700] 
type     = U ;前のステートの状態を引き継ぐ
movetype = A
physics  = S
ctrl     = 0
anim     = 700+(statetype = C)

[State ]
type = attackdist
trigger1 = 1
value = 0

;--------------------------------
[State 1052, 2] 
type = PlaySnd
trigger1 = Time = 3
value = 816, 0

[State 701, 画像の色]
type = PalFX
trigger1 = Time = [3,18]
trigger1 = time%4 = 0
time = 2
add = 20,70,150

;--------------------------------

;こちらは相手のHitDef用
[State 701, 受け止め定義];（※８）
type = ReversalDef
trigger1 = (Time = [3,18]) && statetype = S
reversal.attr = SCA, AA
;reversal.attr = SCA, NA,SA,HA,NP,SP,HP ;（↑と意味は同じ）
pausetime     = 15,15
numhits       = 0
sparkno       = -1
sparkxy       = 0,0
hitsound      = -1,0
getpower = 50,0

;こちらは相手のHitDef用
[State 701, 受け止め定義];（※８）
type = ReversalDef
trigger1 = (Time = [3,18]) && statetype = C
reversal.attr = SC, AA
;reversal.attr = SCA, NA,SA,HA,NP,SP,HP ;（↑と意味は同じ）
pausetime     = 15,15
numhits       = 0
sparkno       = -1
sparkxy       = 0,0
hitsound      = -1,0
getpower = 50,0

;こちらは相手のProjectile用
[State 701, 食らい上書き];（※９）
type = HitOverRide
trigger1 = (Time = [3,18])
time = 1
attr = SCA, AP              ;上書き出来る相手の攻撃属性を指定
;attr = SCA, NA,SA,HA,NP,SP,HP ;（↑と意味は同じ）
;forceair = 1                  ;上書きしたら「空中状態」にするか否か（デフォルトは０）
stateno = 710                  ;上書き先のステート
;slot = 0                      ;このHitOverRideのスロットナンバー（デフォルトは０）

;--------------------------------

[State 702, 音を鳴らす]
type = PlaySnd
trigger1 = Movehit
value = 812, 0
persistent = 0
IgnoreHitPause = 1


[State 105, 3]
type = NotHitBy
value = SCA
trigger1 = Movehit = [1,10] 
trigger2 = Prevstateno = 700 && time < 3
IgnoreHitPause = 1

[State 70002,1]
type = Explod
trigger1 = Movehit
anim = 10700
postype = p1
pos = 25, -70+(stateType=C)*30
random =0,0
ontop = 1
bindtime = 1
ownpal = 1
scale = 0.25,0.25
removetime =-2
persistent = 0
IgnoreHitPause = 1
supermovetime = 2024
pausemovetime = 2024

;--------------------------------

[State 701, ステート変更]
type = ChangeState
trigger1 = animtime = 0
value = ifelse(StateType=C,11,0)
ctrl = 1

