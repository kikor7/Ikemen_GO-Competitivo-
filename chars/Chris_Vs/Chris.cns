;Default language victory quotes (optional).  **MUGEN 1.0**
;If this section is included, the default language victory quotes must be in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "Don't let the loss get to you. I've taken down bigger things than you in my time."
victory2 = "Compared to fighting zombies and B.O.W.s, this was like a vacation."
victory3 = "Good work, team! Let's head on home."
victory4 = "I'll root out bioterrorists wherever they may hide!"
victory5 = "I'm not going to lose any more teammates. I will protect them."
victory6 = "The BSAA was formed so that scum like you would never threaten the innocent!"
victory7 = "You know why you guys lost? It's because you lack the teamwork that we have."

;==============================================================================================
;                                       AERIAL RAVE! - by Sabaki
;==============================================================================================
;Beginning of the super jump
[Statedef 110]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 110, Corner Push]
type= varset
trigger1= fvar(5)
trigger1= 1
fvar(5)= 0

[State 110, Helper]   ;this determines whether an aerial rave comes into play or not
type = Helper
triggerall = prevstateno = 420 ;include all the states that are launchers
trigger1 = time = 0
helpertype = normal
name = "Rave_Timer"
ID = 7003
stateno =114
pos = 0,0
postype = p1
facing = 1

[State 110, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 111
ctrl = 1

;---------------------------------------------------------
;Super Jump
[Statedef 111]
type = A
physics = A
anim=41
velset = 0,0
ctrl=1

[State 111, Corner Push]
type= varset
trigger1= fvar(5)
trigger1= 1
fvar(5)= 0

[State 111, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 111, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 111, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 111, 4]
type = VelSet
trigger1 =time = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x)*1.1, const(velocity.jump.back.x)*1.1))
y = const(velocity.jump.y)*1.7 ; you can change these value, to make it fit how you want the superjump

[State 0, VelAdd]
type = VelAdd
triggerall = Vel X =0
trigger1 = 1
x = ifelse(Command = "holdfwd", 2.3, ifelse(Command = "holdback", -2.3, 0))
y = 0
;ignorehitpause =
;persistent =


[State 111]
type = ChangeAnim
trigger1 = sysvar(1) = 0
trigger1 = Time = [0,5]
value = 41

[State 111]
type = ChangeAnim
trigger1 = sysvar(1) = 1
trigger1 = Time = [0,5]
trigger1 = Command = "holdfwd"
value = 42

[State 111]
type = ChangeAnim
trigger1 = sysvar(1) = -1
trigger1 = Time = [0,5]
trigger1 = Command = "holdback"
value = 43

;---------------------------------------------------------
;Aerial Rave Timer
[Statedef 114]
physics = N
anim = 9500
sprpriority = -3

[State 114]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = invisible

[State 114]
type = NotHitBy
trigger1 = 1
value = SCA

[State 114]
Type = Destroyself
trigger1 = time = 50 || time > 10 && parent, vel y > 0 || parent, movetype = H

