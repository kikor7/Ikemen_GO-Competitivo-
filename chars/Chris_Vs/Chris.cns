; Aerial Rave Finisher State (Dash after AR Finisher) - by FerchogtX
[Statedef 7600]
type     = A
movetype = I
physics  = N
ctrl = 0

[State 6500, 2] ;Change to going down anim
type = ChangeAnim
trigger1 = AnimTime = 0
value = 48

[State 6500, 3] ;Don't follow me
type = ScreenBound
trigger1 = 1
value = 0
ignorehitpause = 1

[State 6500, 4] ;Reset My pos to 0
type = VelSet
trigger1 = time >= 0
x = 0
y = 0

[State 6500, 5] ;I'm offscreen
type = PosSet
trigger1 = time >= 0
x = (Pos X - (ScreenPos X + 100)*(facing))
y = 0
ignorehitpause = 1

[State 6500, xR] ;I'm on land
type = StateTypeSet
trigger1 = Pos Y >= 0
statetype = S

[State 6500, 6] ;Dash Onscreen now!!!
type = ChangeState
trigger1 = !var(6)
trigger2 = time >= 200
value = 102
ctrl = 0

