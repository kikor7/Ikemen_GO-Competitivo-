; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, Hyper Combo Finish FX]
type = Helper
trigger1 = var(10)=1 && !NumHelper(9600)
helpertype = normal ;player
name = "Hyper Combo Finish FX"
ID = 9600
stateno = 9600
pos = 0,0
postype = p1    ;p2,front,back,left,right
facing = 1
ownpal = 0
supermove=9999
pausemove=9999

[State -2, VarSet]
type = VarSet
trigger1 = Numhelper(9600)
v = 10
value = 2

; ------------------------------------------
; Damage Dampener  - by Vin
; ------------------------------------------

[State -2, Damage based on hits]
type=varset
trigger1= numenemy
fvar(12)= enemynear,gethitvar(hitcount)
ignorehitpause=1

[State -2, Reset var when the opponent recovers]
type=varset
trigger1= numenemy
trigger1= (enemynear,movetype!=H)
trigger2= !numenemy
fvar(12)=1

[State -2, Dampener]
type=varset
trigger1=1
fvar(10)= ifelse(fvar(12)=0, 1, ifelse(fvar(12)=1, .96, .86**fvar(12)))
ignorehitpause=1


[State -2, Dampener itself]
type=attackmulset
trigger1= 1
value=fvar(10)
ignorehitpause=1


; ------------------------------------------
; Flying Screen Effect (Vs series feature)  - TUTORIAL By FerchogtX
; ------------------------------------------
[State -2, Flying Screen Var Reset]
type = VarSet
triggerall = numenemy > 0
trigger1 = P2MoveType != H
trigger2 = (enemy, alive = 0) && roundstate > 2
var(5) := var(6) := 0

[State -2, Flying Screen ScreenBound]
type = ScreenBound
trigger1 = (stateno = [620, 625]) && (var(6)) && (FrontEdgeDist > 35) ;added frontedgedist
trigger2 = (stateno = [650, 655]) && (var(6)) && (FrontEdgeDist > 35)
trigger3 = (stateno = [660, 665]) && (var(6)) && (FrontEdgeDist > 35)
value = 0
movecamera = 0,0
ignorehitpause = 1

[State -2, Don't exchange Positions with foe if AR in corner]
type = PosAdd
triggerall = stateno != [3000, 4999]
trigger1 = (PrevStateNo = [620, 625]) && (FrontEdgeDist < 35)
trigger2 = (PrevStateNo = [650, 655]) && (FrontEdgeDist < 35)
trigger3 = (PrevStateNo = [660, 665]) && (FrontEdgeDist < 35)
x = -5
ignorehitpause = 1

[State -2, Dash On Screen after Flying Screen]
type = ChangeState
triggerall = (BackEdgeDist < 5) && (Pos Y < -50)
trigger1 = (stateno = [620, 625]) && (var(6))
trigger2 = (stateno = [650, 655]) && (var(6))
value = 7600
ctrl = 0

[State -2, Dash On Screen after Flying Screen]
type = ChangeState
trigger1 = (stateno = [660, 665]) && (var(6))
value = 7700
ctrl = 0

[State -2, Flying Screen (Aerial Rave)]
type = Helper
triggerall = !NumHelper(7500)
triggerall = P2Stateno != [150, 155]
trigger1 = (stateno = [620, 625]) && (var(6))
trigger2 = (stateno = [650, 655]) && (var(6))
trigger3 = (stateno = [660, 665]) && (var(6))
name = "FS Effect (Aerial Rave)"
ID = 7500
stateno = 7500
pos = 0,0
postype = p2
ownpal = 1
bindtime = 1
size.air.back = 20
size.air.front = 20
ignorehitpause = 1
persistent = 0



;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 47, 0

[State 0, StopSnd]
type = StopSnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
channel = 1

[State -3, Super Jump]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 110 ;Jump land
value = 40, 0

[State -3, Super Jump FX]
type = Explod
triggerall = stateno = 110
trigger1 = time=1
anim = 8670
pos = -160,-214
id = 8670
supermovetime = -1
pausemovetime = -1
postype = p1
bindtime = 1
removetime = -2
removeongethit = 1
scale = 0.5, 0.5
sprpriority=3
facing = 1
ownpal = 1
ignorehitpause = 1

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno!=1050
id = 1051

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno!=1060
id = 1061

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno!=1070
id = 1071

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno!=226
id = 226

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno!=225
id = 6065

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno!=226
id = 6066

[State 0, RemoveExplod]
type = RemoveExplod
trigger1 = stateno!=227
id = 6067


;================================================================================================
;                                   KO/CHEAP DEATH SOUND TRIGGERS
;================================================================================================
[State -3, KO snd]
type = varset
trigger1 = alive && var(13) > 0
trigger2 = !alive && var(13) < 2
var(13) = ifelse(alive, 0, var(13) + 1)
ignorehitpause = 1

;THIS WILL PLAY YOU KO SOUND WHEN KILLED, IT COULD ALSO PLAY THE CHEAP DEATH SOUND WHEN IN STATE 5130 BUT USUALLY
;THE CHEAP DEATH SOUND IS NOT PLAYED AT THE VERY BEGINNING OF THE CHEAP DEATH STATE, IF IT IS THEN PUT IT HERE
[State -3, KO snd]
type =playsnd
trigger1 = !alive && var(13) = 1
trigger1 = var(13) := 2
value =S2,ifelse(stateno=5130,-1,0)
channel=0



;---------------------------------------------------------------------------

[State -3, Fake helper];FOR FIRST ATTACK
type = helper
trigger1 = roundstate = 2 && !numhelper(8500)
helpertype = Normal
id = 8500
pos = 0,0
postype = p1
name = "First Attack Prevent"
stateno = 8500
supermovetime = 9999999999
pausemovetime = 9999999999

[State -3, Dummy Helper];FOR PERFECT!
type = helper
triggerall = !numpartner
trigger1 = time = 1 && !numhelper(8550)
helpertype = normal
name = "Perfect Helper"
ID = 8550
stateno = 8550
;pos = 0,-99999999999999999
postype = left    ;p2,front,back,left,right
ownpal = 0
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause = 1
persistent = 0






[State -3, Helper]
type = Helper
;triggerall = var(22) = 0
triggerall = !numhelper(890)
triggerall = anim = 810 ||anim = 831
trigger1 = time = 1
helpertype = normal ;player
name = "T_Escape/Recover"
ID = 890
stateno = 890
pos = 100,100
postype = p1    ;p2,front,back,left,right
facing = 1
keyctrl = 0
ownpal = 0
ignorehitpause = 1


;================================================================================================
;                                         GetHit Sounds
;================================================================================================
[State -3, light]
type = PlaySnd
triggerall = stateno = 5000 && life >= 200
trigger1 = anim = 5000 || anim = 5010 || anim = 5020
trigger1 = time = 1
trigger1 = random < 900
value = 2,ifelse(random<600, ifelse(random <300, 1, 2 ),3)
channel=0

[State -3, medium]
type = PlaySnd
triggerall = stateno = 5000 && life >= 200
trigger1 = anim = 5001 || anim = 5011 || anim = 5021
trigger1 = random < 900
trigger1 = time = 1
value = 2,ifelse(random<600, ifelse(random <300, 4, 5 ),6)
channel=0

[State -3, heavy]
type = PlaySnd
triggerall = stateno = 5000 && life >= 200
trigger1 = anim = 5002 || anim = 5012 || anim = 5022
trigger1 = random < 900
trigger1 = time = 1
value = 2,ifelse(random<600, ifelse(random <300, 7, 8 ),9)
channel=0




