trigger1 = !Time
anim = 8210
sprPriority = 3
posType = p1
pos = 8, -95
scale = 0.5, 0.5
pauseMoveTime = -1
superMoveTime = -1
ownPal = 1

[State 1005, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 500,0
channel = 2

[State 1005, Voice]
type = PlaySnd
trigger1 = AnimElem = 6
value = 500,1
channel = 3

[State 1005, snd]
type = PlaySnd
trigger1 = AnimElem = 6
value = 1,9
channel = 4

[State 1005, Width]
type = Width
trigger1 = AnimElemTime(6) < 0
player = 50,0

[State 1005, Projectile]
type = Helper
trigger1 = AnimElem = 6
helperType = Normal
stateNo = 2030
ID = 2030
name = "Tiara Ex"
posType = P1
pos = 0,0
keyctrl = 1
ownpal = 1
facing = 1
persistent = 0
ignorehitpause = 1

[State 1005, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

;Spiral Uppercut
[Statedef 1010]
type = S
movetype = A
physics = S
anim = 1010
ctrl = 0
velset = 0,0
poweradd = 0 * !var(20)
sprpriority = 2
facep2 = 1

[State 1010, Button Detect]
type = VarSet
trigger1 = !Time && !AILevel
var(10) = ifElse((command = "x" || command = "rlsx"), 0, ifElse((command = "y" || command = "rlsy"), 1, 2))

[State 1010, Button Detect (AI)]
type = VarSet
trigger1 = !Time && AILevel
var(10) = ifElse((P2MoveType = H || PrevStateNo = 750 || Random < 333), 2, ifElse(Random < 500, 1, 0))

[State 1010, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 501,0
channel = 0

[State 1010, Swing Snd]
type = PlaySnd
trigger1 = Animelem = 4
value = 1, 2

[State 1010, Jump Snd]
type = PlaySnd
trigger1 = AnimElem = 4
value = 40,0
channel = 3

[State 1010, Muteki]
type = Nothitby
trigger1 = AnimElemTime(3) < 0
time = 1
value = SCA

[State 1010, PosAdd]
type = PosAdd
trigger1 = !Time
x = 18

[State 1010, StateTypeSet: Air, No Phys]
type = StateTypeSet
trigger1 = AnimElem = 4
stateType = A
physics = N

[State 1010, Rising Velocity]
type = VelSet
trigger1 = AnimElemTime(4) = 0
x = ifelse(var(10)=2,8, ifelse(var(10)=1, 6, 4))
y = ifelse(var(10)=2,-8, ifelse(var(10)=1, -6, -4))

[State 1010, Gravity/Friction]
type = VelAdd
trigger1 = AnimElemTime(8) > 0
x = ifElse(Vel X <= 0, 0, -.25)
y = .5

[State 1010, Dust Helper]
type = Helper
trigger1 = AnimElem = 4
helperType = Normal
stateNo = 8100
ID = 8100
name = "Jump Dust"
posType = P1
ownPal = 1

[State #, Resist]
type = NotHitBy
trigger1 = Animelem = 4
time = 10
value = SCA

[State 1010, Hit]
type = HitDef
trigger1 = !var(16) && var(15) < 4
trigger1 = !Time
attr = A, SA
damage = ceil(ifElse(fvar(11) * ifElse(var(10) = 2, 80, ifElse(var(10), 60, 40)) < 7, 7, fvar(11) * ifElse(var(10) = 2, 80, ifElse(var(10), 60, 40)))), 7
priority = 4, hit
animtype = Hard
getpower = 60,30
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,2
guardsound = S130,0
pausetime = 10,10
guard.pausetime = 10,10
sparkNo = -1 + 0 * (var(33) := 8013)
guard.sparkNo = -1 + 0 * (var(34) := 8001)
sparkXY = -10 + 0 * (var(35) := 10), var(36) := -125
air.animtype = Back
fall.animtype = Back
ground.type = High
air.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -6, -14
air.velocity = -6, -14
guard.velocity = -5
airguard.velocity = -5, -5
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .5
fall = 1
fall.recover = 0
palFX.time = 12 * var(9)
palFX.add = 255,255,255
palFX.sinAdd= -255,-255,-255,48
envshake.time = 14
envshake.ampl = 4
envShake.freq = 120

[State 1010, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(8) >= 0
moveType = I

[State 1010, End]
type = ChangeState
trigger1 = pos y > -vel y
value = 47

