trigger1 = 1
x = ((Partner, Pos X - Pos X > 20) * 2 - 1) * .1
y = ((Partner, Pos Y - Pos Y > 10) * 2 - 1) * .1

[State VelAdd]
type = VelAdd
trigger1 = Abs(Vel X) > 2 && Abs(Partner, Pos X - Pos X - 20) < 60
x = ifelse(Vel X > 0, -.1, .1)

[State VelAdd]
type = VelAdd
trigger1 = Abs(Vel Y) > 2 && Abs(Partner, Pos Y - Pos Y - 10) < 10
y = ifelse(Vel Y > 0, -.1, .1)

[State VelSet]
type = VelSet
trigger1 = Abs(Vel X) > 6
x = ifelse(Vel X > 0, 6, -6)

[State VelSet]
type = VelSet
trigger1 = Abs(Vel Y) > 6
y = ifelse(Vel Y > 0, 6, -6)

