;===============================================================================================
;                                          VARIABLE LIST                    
;===============================================================================================
; Var(0) 	- AI
; Var(1) 	- Used in Leo.cmd for combo condition (updated every tick)
; var(2)        - Win - Random 
; Var(3) 	- Intro - Random
; Var(4) 	- Taunt - Random
; Var(5) 	- Aerial Rave Finisher
; Var(6) 	- Aerial Rave Finisher - HIT COUNTER
; Var(7) 	- Air Dash System
; Var(8) 	- Dizzy
; Var(9)        - Dizzy Button Mash
; var(10)       - Used in Hyper Combo Finish BG
; var(11)       - Guard Push
; var(12)       - Danger sound and text display
; var(13)       - KO/Cheap Death Sounds
; var(14)       - DHC Activator
; var(15)       - Random X
; var(16)       - random Y
; var(17)       - Super Jump Velset Detector
; var(18)       - No Spam

; var(26)       -  

; var(30)       - 
; var(31)       - 



; var(41)       - Sparkxy
; var(42)       - Sparkxy
; var(43)       - Sparkxy
; var(44)       - Sparkxy
; var(45)       - Sparkxy
; var(46)       - Sparkxy
; var(47)       - Sparkxy


; Var(50)       - Partner Stateno
; Var(51)       - Simul TAG flag
; Var(52)       - Player Ctrsets
; Var(53)       - Player Ctrsets
; Var(54)       - P2 Ctrsets
; Var(57)       - DHC Command Varset
; Var(58) 	- Normal & Special KO Sounds
; Var(59) 	- AI

; fvar(5) - Corner Push
; fvar(10) - Sets the Damage Dampener in the AttackMulSet sctrl...
; fvar(12) - Counts how many hit s you got in current combo





[state -2, DHC Activator]
type = varset
trigger1 =1
v = 14
value = (partner,var(14))

[state -2, DHC Safety Reset]
type = varset
trigger1 =var(14)!=0&&statetype!=A&&stateno=[0,2999]
v = 14
value =0 


