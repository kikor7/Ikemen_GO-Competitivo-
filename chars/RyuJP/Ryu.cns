;Throwing the opponent
[Statedef 805]
type    = S
movetype= A
physics = N
anim = 805
poweradd = 0

; Here a variable, var(2), is used to remember whether or not the
; player was holding forward at the start of the state. This variable
; is checked later on to turn KFM around if necessary.
[State 805, Holding fwd?]
type = VarSet
trigger1 = Time = 0
var(2) = command = "holdfwd"

[State 805, Throw Sound]
type = PlaySnd
trigger1 = AnimElem = 1
value = 800, 0

[State 805, holdfwd - Turn 6] ;If was holding fwd before, turn now
type = Turn
trigger1 = var(2)
trigger1 = AnimElem = 1

[State 805, holdfwd - Pos 6] ;If was holding fwd before, move a little
type = PosAdd
trigger1 = var(2)
trigger1 = AnimElem = 1
x = -37

[State 805, holdfwd - Turn Target 1] ;If was holding fwd before, turn target too
type = TargetFacing
trigger1 =  var(2)
trigger1 = AnimElem = 1
value = -1

[State 805, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(2)<0
pos = 38, 0

[State 805, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(2)>=0 && AnimElemTime(3)<0
pos = -20, -20

[State 805, Bind 2]
type = TargetBind
trigger1 = AnimElemTime(3)>=0 && AnimElemTime(4)<0
pos = -0, -55

[State 805, Bind 2]
type = TargetBind
trigger1 = AnimElemTime(4)>=0 && AnimElemTime(5)<0
pos = 70, -70

[State 805, holdfwd - Turn 6]
type = Turn
trigger1 = AnimElem = 2

[State 805, Throw 11]
type = TargetState
trigger1 = AnimElem = 5
value = 811

[State 805, Width]
type = Width
trigger1 = animElem=4
edge = 30,0
player = 0,0

[State 0, PlaySnd]
type = PlaySnd
trigger1 = animelem=2
value = S2,19
channel = 0

[State 805, State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
