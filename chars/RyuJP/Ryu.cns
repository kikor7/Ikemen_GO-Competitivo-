value=fvar(10)
ignorehitpause=1
;===============================================================================================
;              Flying Screen Effect (Vs series feature)  - TUTORIAL By FerchogtX
;===============================================================================================
[State -2, Flying Screen Var Reset]
type = VarSet
triggerall = numenemy > 0
trigger1 = P2MoveType != H
trigger2 = (enemy, alive = 0) && roundstate > 2
var(5) := var(6) := 0

[State -2, Flying Screen ScreenBound]
type = ScreenBound
trigger1 = (stateno = [620, 625]) && (var(6))
trigger2 = (stateno = [650, 655]) && (var(6))
trigger3 = (stateno = [660, 665]) && (var(6))
value = 0
movecamera = 0,0
ignorehitpause = 1

[State -2, Don't exchange Positions with foe if AR in corner]
type = PosAdd
triggerall = stateno != [3000, 4999]
trigger1 = (PrevStateNo = [620, 625]) && (FrontEdgeDist < 35)
trigger2 = (PrevStateNo = [650, 655]) && (FrontEdgeDist < 35)
trigger3 = (PrevStateNo = [660, 665]) && (FrontEdgeDist < 35)
x = -5
ignorehitpause = 1

[State -2, Dash On Screen after Flying Screen]
type = ChangeState
triggerall = (BackEdgeDist < 5) && (Pos Y < -50)
trigger1 = (stateno = [620, 625]) && (var(6))
trigger2 = (stateno = [650, 655]) && (var(6))
value = 7600
ctrl = 0

[State -2, Dash On Screen after Flying Screen]
type = ChangeState
trigger1 = (stateno = [660, 665]) && (var(6))
value = 7700
ctrl = 0

[State -2, Flying Screen (Aerial Rave)]
type = Helper
triggerall = !NumHelper(7500)
triggerall = P2Stateno != [150, 155]
trigger1 = (stateno = [620, 625]) && (var(6))
trigger2 = (stateno = [650, 655]) && (var(6))
trigger3 = (stateno = [660, 665]) && (var(6))
name = "FS Effect (Aerial Rave)"
ID = 7500
stateno = 7500
pos = 0,0
postype = p2
ownpal = 1
bindtime = 1
size.air.back = 20
size.air.front = 20
ignorehitpause = 1
persistent = 0

;=============================================================================================
;           States that are executed when in self's state file (use statedef -3)
;=============================================================================================

[Statedef -3]

; Run into the screen (tagged in)
[State -3, enter the screen]
type = ChangeState
triggerall = Var(51) = 1      		; Partner TAG mode activated
triggerall = NumPartner
triggerall = stateno = 4512		; Player waiting outside the screen
trigger1 = (partner, stateno = 4510) ;|| (partner, stateno = 4600) ;|| (partner, stateno = 4601)	; Partner leaving the screen
trigger1 = Life		                ; And you're alive
value = 4500

; Jump into the screen (partner was KOed)
[State -3, enter the screen]
type = ChangeState
triggerall = Var(51)      		; Partner TAG mode activated
triggerall = NumPartner
triggerall = StateNo = 4512	; Player waiting outside the screen
trigger1 = !(Partner, Life)	; Partner dead
trigger1 = Life			; And you're alive
trigger1 = partner, stateno = 5150
trigger2 = roundstate >= 3	; the match is over
trigger2 = Win || LoseTime || WinTime || drawgame
trigger2 = partner, stateno = 0
trigger3 = partner, stateno = 4511
value = 4520

; KEEPS PARTNER OFFSCREEN 
[State -2, ctrl]
type = ChangeState
triggerall = Var(51)        ; Partner TAG mode activated
triggerall = NumPartner
triggerall = ID > Partner,ID
triggerall = movetype != H
triggerall = partner, stateno!=[3000,3999]
triggerall = stateno!=[4400,4449]
triggerall = partner,stateno!=[4400,4449]
trigger1 = partner, movetype != H
trigger1 = partner, var(51) != 2
trigger1 = partner, var(52) != 1
trigger1 = RoundState = 2
trigger1 = Life && Partner, Life		; Team is alive
trigger1 = partner, stateno != [4500,4999]
trigger1 = stateno != [4500,5999]
value = ifelse(backEdgeDist <= -40,4512,4511)
persistent = 0

; This sends your Partner to his Assist Call In Taunt state (means not the leader of the team).
[State -3, ChangeState]
type = ChangeState
triggerall = Var(51)&&pos y =0
triggerall = NumPartner
triggerall = partner,stateno=4800
triggerall = partner,time<=1
triggerall = roundstate = 2
triggerall = movetype != H
triggerall = ID>partner,ID
trigger1 = Life && Partner, Life
value =4900
ctrl = 0

;due to the tag system you must have controll to enter the win poses, this keeps you from being able to move during 
;the win poses  
[State -3, no controll during win poses]
type = ChangeState
trigger1 = (roundstate>2)&&(time=0)
trigger1 = partner,stateno=180
value=180
ctrl=0

; This sends your Partner to his intro state (means not the leader of the team).
[State -3, ChangeState]
type = ChangeState
triggerall = partner,stateno=5900
triggerall = numenemy
triggerall = roundstate < 2
triggerall = time = 0
trigger1 = numpartner
trigger1 = ID>partner,ID
value = 199
ctrl = 0

;KEEPS PARTNER FROM TURNING WHEN YOU JUMP ONSCREEN OR OFFSCEEN OR HAVE DIED
[State -3]
type = AssertSpecial
trigger1 = (enemynear,stateno=[4800,4810])||(enemynear,stateno=4511)
trigger1 = 1
trigger2 = life=0
flag = NoAutoTurn
;===============================================================================================
;This controller plays a sound everytime KFM lands from a jump or from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 47, 0
;===============================================================================================
;SUPER JUMP STATES
[State -3,veladd]
type = Veladd
triggerall =command = "holdfwd"
triggerall = prevstateno = 111 ; the superjumo state
trigger1 = stateno = 50; jump state
x = .05 ; maybe you need to modify these value

[State -3,veladd]
type = Veladd
triggerall =command = "holdback"
triggerall = prevstateno = 111
trigger1 = stateno = 50
x = -.05
;===============================================================================================

[State -3, Fake helper];FOR FIRST ATTACK
type = helper
trigger1 = roundstate = 2 && !numhelper(8500)
helpertype = Normal
id = 8500
pos = 0,0
postype = p1
name = "Fake Helper"
stateno = 8500
supermovetime = 9999999999
pausemovetime = 9999999999

[State -3, Dummy Helper];FOR PERFECT!
type = helper
triggerall = !numpartner
trigger1 = time = 1 && !numhelper(8550)
helpertype = normal
name = "Dummy Helper"
ID = 8550
stateno = 8550
;pos = 0,-99999999999999999
postype = left    ;p2,front,back,left,right
ownpal = 0
supermovetime = 999999999999
pausemovetime = 999999999999
ignorehitpause = 1
persistent = 0
;=============================================================================================
;           States that are executed when in self's state file (use statedef -3)
;=============================================================================================

[State -3, resetAI]
type=varset
trigger1=var(0)&&(!alive||roundstate!=2)
var(0)=0
ignorehitpause=1
[State -3, AIactivation]
type=helper
trigger1=!numhelper(9741)&&roundstate=2&&alive&&!var(0)
helpertype=normal
name="Characters's AI"
stateno=9741
ID=9741
pos=9999,9999
keyctrl=1
pausemovetime=2147483647
supermovetime=2147483647

[State -3: ChangeState]
type = ChangeState
triggerall = (Var(0)) && (StateType != A) && (Ctrl) && (EnemyNear, Facing != Facing)
trigger1 = (P2StateType != C) && (P2MoveType = A) && ((InGuardDist) || (EnemyNear, NumProj > 0))
trigger2 = (p2bodydist X <= 150) && (Facing = 1) && (EnemyNear, Facing = -1) && (P2MoveType = A)
trigger3 = (p2bodydist X <= 150) && (Facing = -1) && (EnemyNear, Facing = 1) && (P2MoveType = A)
trigger4 = (stateno=0) && (prevstateno=5120) && (EnemyNear, Stateno=[3000,3999])
value = 130

[State -3: ChangeState]
type = ChangeState
triggerall = (Var(0)) && (StateType != A) && (Ctrl) && (EnemyNear, Facing != Facing)
trigger1 = (P2StateType = C) && (P2MoveType = A) && ((InGuardDist) || (EnemyNear, NumProj > 0))
value = 131

[State -3: ChangeState]
type = ChangeState
triggerall = (Var(0)) && (StateType = A) && (Ctrl) && (EnemyNear, Facing != Facing)
trigger1 = (P2MoveType = A) && ((InGuardDist) || (EnemyNear, NumProj > 0))
trigger1 = (vel x !=const(velocity.airjump.fwd.x)) && (vel y >=1) && (p2statetype=A)
value = 132

;===============================================================================================
;                                          Corner Push 
;===============================================================================================
[State -3, Corner Push1]
type= varset
trigger1= fvar(5)
trigger1= numtarget
trigger1= target,hitover || (target,gethitvar(hitshaketime)>0 && target,time<=0)
fvar(5)= 0

[State -3, Corner Push2]
type= varset
trigger1= movecontact=1 && numtarget
fvar(5)= target,gethitvar(xvel)
ignorehitpause= 1

[State -3, Corner Push4]
type= posadd
triggerall= fvar(5)
triggerall= statetype!=L && numtarget
triggerall= (target,statetype!=L)
triggerall= !hitpausetime && target,gethitvar(hitshaketime)<=0
trigger1= target,frontedgebodydist<=abs(target,vel x)
trigger1= (target,gethitvar(xvel) * target,facing)>0
trigger2= target,backedgebodydist<=abs(target,vel x)
trigger2= (target,gethitvar(xvel) * target,facing)<0
x= ifelse(target,frontedgebodydist<=0, -1, 1) * (target,facing) * fvar(5)

[State -3, Corner Push5]
type= varset
trigger1= numtarget
trigger1= target,gethitvar(hitshaketime)<=0
fvar(5)= fvar(5)*.85
;================================================================================================
;                                         COLLAPSE/CHEAP DEATH
;================================================================================================
[State -3, Cheap KO]
type=changestate
trigger1=(partner,life=0)
trigger1= !alive && (stateno=[5000,5010])
trigger1= (prevstateno=[130,131]) || (prevstateno=[140,141]) || (prevstateno=[150,153])
value=5130
ignorehitpause=1
;===============================================================================================
;                                       Variable State Set 
;===============================================================================================
;THIS PREVENTS YOU FROM BEING ABLE TO TAG WHEN THE FIGHT IS OVER
[State -3, PARTNER TAG MODE NOT ACTIVE]
type=varset
trigger1=roundstate >=3
var(51)=0

;THIS ACTIVATES THE TAG MODE IN SIMULTANIOUS MODE
[State -3, activate tag]
type = VarSet
trigger1 = teammode = simul
trigger1 = roundstate < 1
trigger1 = time = [0,1]
v = 51
value = 1

;THIS TAKES AWAY CONTROL 
[state -3]
type = ctrlset
trigger1 = var(52) = 1
value = 0

;THIS JUST LET YOU SEE YOUR PARTNERS STATENO
[State -3, PARTNER STATENO]
type=varset
trigger1=1
var(50)=(partner,stateno)

;THIS MAKES SURE THE DHC IS RESET AND NOT ACTIVE IF YOU DO NOT REACH THE VAR(14) RESET IN THE HYPER STATE
[State -3, DHC RESET]
type=varset
trigger1=(stateno=0)||(partner,stateno=0)
var(14)=0

;THIS SETS VARIABLE FOR PARTNER TO YOUR VARIABLE
[state -3]
type =NULL; varset
trigger1 = ID > partner, ID
v = 31
value = (partner,var(31))

;THIS SETS YOU AS THE FIRST PLAYER
[State -3]
type = Varset
triggerall = numpartner != 0
trigger1 = var(53)=0
trigger2 = roundstate = 0 
v = 53
value=1+((partner, id) < id)

;THIS KEEPS YOUR PARTNER FROM HAVING CONTROL SO HE USES YOUR COMMANDS
[State -3, 2nd character always no ctrl]
type = CtrlSet
trigger1 = Var(53)= 2 
value =0
ignorehitpause = 1

;THIS TAKES CONTROL AWAY FROM YOUR PARTNER 
[State -3, 2nd character always no ctrl]
type = VarSet
triggerall = Var(53)=2
trigger1 = (StateNo !=0 && StateNo !=10 &&StateNo !=11 &&StateNo!=12 &&StateNo!=20 &&StateNo!=50&&stateno!=100)
trigger1 = (StateNo !=120 &&StateNo !=130 &&StateNo !=131 &&StateNo !=460 &&StateNo !=5040)
trigger1 = StateNo !=52
trigger2 = movetype =h
trigger3 = StateNo = 5 && time = 0
var(54)=0 

;THIS KEEPS YOUR PARTNER FROM HAVING CONTROL SO HE USES YOUR COMMANDS
[State -3, 2nd character always no ctrl]
type = VarSet
triggerall = movetype !=h
triggerall = Var(53)=2 && RoundState = 2
trigger1 = (StateNo =0 ||StateNo =10 ||StateNo =11 ||stateno=12 ||stateno=20 ||stateno=50||stateno=100)
trigger2 = (StateNo =120 ||StateNo =130 ||StateNo =131 ||StateNo =460 ||StateNo =5040)
trigger3 = StateNo = 5 && time = 1
var(54)=1

