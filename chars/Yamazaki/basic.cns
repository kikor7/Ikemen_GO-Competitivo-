[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "What a loser.  Don't show your face again!"
victory2 = "Take a hike.  I don't have time for scum like you!"
victory3 = "Being this strong is a natural buzz.  Kids, don't do drugs!"
victory4 = "Done so soon?  It was just getting fun!"
victory5 = "Heh, heh, heh.  Your time is over!"
victory6 = "Get lost, or I'll kill you!"
victory7 = "I hate guys who don't bathe!  now I'll clean your clock!"
victory8 = "I fought tougher steaks.  Take a hike you dog!"
victory9 = "I'm in a good mood.  You can keep your spleen!"
victory10 = "You won't see tomorrow Gyah hah hah haaaah!"
victory11 = "Looking to be busted up again?"
victory12 = "You ain't enough for me!"
victory13 = "You ain't shit!"
victory14 = "You're outta your league!"
victory15 = "Hahahahahaha...Yea!!!"
victory16 = "Shut your face!  You amateur!!!"
victory17 = "You look like a splattered pomegranate, pinhead!"
victory18 = "I'll skin you and feed you to the sharks!"
victory19 = "Even if I fillet you it won't do diddley for me!"
victory20 = "Enough "KOR" crud!  I'm gonna tenderize you!"
victory21 = "Man you're a pain!  Act like a parking meter and expire!"
victory22 = "You're busted.  Literally!"
victory23 = "Gyah ha ha!  Just look!  Quaking with shame!  Gya!  Ha!"
victory24 = "That's all you got, eh?  Give me a little resistance!"
victory25 = "You?  Has your new look turned you into a sissy?"
victory26 = "What?  What makes you believe I will forgive you if you apologize?"
victory27 = "Ha, ha, ha!  You look better now, than you did before!"
victory28 = "You won't understand how stupid you are until I beat it into you!"
victory29 = "Hey wait!  You can't quit yet!!  I still have more for you!"
victory30 = "What?  Was I fighting unfairly?  Do you think I really care about that!"
victory31 = "Look at my shoes!  They got dirty!  Lick them!  I said lick my shoes clean!!"


