; KFM's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

; これはKFMの定数と状態のファイルです。
; このファイルの中には注釈が散らされているので、CNSを習いたいお方は
; 読んでみたらいいです。

[Data]
life = 1105
power = 5000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 20
airjuggle = 10
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 250
IntPersistIndex = 50
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 22    ;Player width (back, ground)
ground.front = 18   ;Player width (front, ground)
air.back = 18        ;Player width (back, air)
air.front = 18       ;Player width (front, air)
height = 50          ;Height of player (for opponent to jump over)
attack.dist = 200    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 30, -87   ;Approximate position of head
mid.pos = 6, -54    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 1.4
walk.back = -1.2
run.fwd  = 4.2, 0    
run.back = -5,-6
jump.neu = 0,-10
jump.back = -1.2
jump.fwd = 1.5       
runjump.back = -4,-10
runjump.fwd = 4,-10           

[Movement]
airjump.num = 0      
airjump.height = 35  
yaccel = .56         
stand.friction = .85  
crouch.friction = .82

;---------------------------------------------------------------------------
; Variable usage:
; This is a record of the variables that KFM uses. Keeping a record of your
; variable usage helps you avoid careless mistakes later.
; var(1)  - Used in kfm.cmd for combo condition (updated every tick)
; var(2)  - Used in Kung Fu Throw (state 800) to remember if fwd was being
;           held (remembered from state 800 through state 810).

;---------------------------------------------------------------------------
; 立ち4弱斬り
[Statedef 200]
type    = S
movetype= A
physics = N
juggle  = 1
velset = 0,0
ctrl = 0
anim = 200
poweradd = 0
sprpriority = 2

[State 200, 1]
type = statetypeset
triggerall = teammode = single || teammode = turns
trigger1 = enemy,gethitvar(fall) = 0 && p2statetype = A && p2movetype = H && (p2stateno != [120,159]) 
trigger2 = p2stateno = 5040
movetype = I
[State 200, 1]
type = statetypeset
trigger1 = teammode = single || teammode = turns
trigger1 = p2statetype != A || p2movetype != H 
trigger1 = p2stateno != 5040
movetype = A
[State 200, 1]
type = targetstate
trigger1 = teammode = single || teammode = turns
trigger1 = numtarget
trigger1 = movehit=1&&p2statetype=A&&target,stateno!=59100&&target,gethitvar(fall)=1&&roundstate=2&HitPauseTime<=1
value = 88100
persistent = 0
ignorehitpause=1
[State 200, 1]
type = statetypeset
trigger1 = animelemtime(4) >= 0
trigger1 = var(9) >= 1
movetype = I

[State 200, 1]
type = varadd
trigger1 = movehit = 1
var(2) = 1
ignorehitpause=1
persistent = 0
[State 200, 1];気絶値
type = varadd
trigger1 = movehit = 1
var(33) = 14
ignorehitpause=1
persistent = 0

[State 200, 2]
type = HitDef
trigger1 = AnimElem = 3
attr = S, NA
getpower = 30,15
givepower = 0,0
animtype  = mid
damage    = ceil(ifelse(var(50)=1,10.0,12.0)*fvar(14)),ceil(ifelse(var(50)=1,0.0,12.0)*fvar(16))
guardflag = M
hitflag = MAF
id = 200
guard.kill = 0
pausetime = 8,8
guard.pausetime = 8,8
sparkxy = -20,-75
sparkno = s10050
guard.sparkno = s10102
hitsound   = s3,0+random%6
guardsound = s5,2+random%2
ground.type = high
ground.slidetime = 21
ground.hittime  = 21
guard.hittime  = 12
guard.ctrltime  = 12
guard.velocity = -4
ground.velocity = -4
ground.cornerpush.veloff = -4
air.hittime  = 21
air.velocity = -3,-7.5
airguard.velocity = -3,-7.5
yaccel = 0.47
fall.recovertime = 21

[State 200, 3]
type = PlaySnd
trigger1 = animelem = 2
value = 0, 1
volume = 100
[State 200, 4]
type = PlaySnd
trigger1 = animelem = 1
value = 20,0+random%5
volume = 255
channel = 0

[State 200, 7]
type = ChangeState
trigger1 = animtime = 0
trigger1 = var(6) != 0
value = var(6)
[State 200, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

