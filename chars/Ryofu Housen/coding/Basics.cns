trigger1 = Time = 0
value = SCA
time = 10

[State 890, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 1002
ctrl = 0

[State 890, Dead]
type = ChangeState
trigger1 = alive = 0
value = 5150
ctrl = 0

