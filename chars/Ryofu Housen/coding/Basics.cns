trigger1 = 1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT
value2 = S,NA
time = 15

[State 890, 1]
type = PlayerPush
trigger1 = Time >= 0
value = 0

[State 0, PlaySnd]
