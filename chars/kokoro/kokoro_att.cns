type = A
movetype = A
physics = N
ctrl = 0
anim = 10330

[State 000]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 000]
type = Trans
trigger1 = 1
Trans = Addalpha
Alpha = 256,256
time = 1

[State 000]
type = SprPriority
trigger1 = 1
value = 3

[State 10600, 2]
Type = Explod
Trigger1 = 1
Anim = 10331  ;炎エフェクト
ID = 10331
Pos = 0,0
PosType = P1
Scale = 0.48,0.48
Ownpal = 1
SprPriority = 2
IgnoreHitPause = 1
Persistent = 1
vel = -Random%10*0.2,-1+(Random%20*0.1)

[State 000]
type = AngleDraw
trigger1 = Time < 10
scale = Time*0.06,Time*0.06

[State 00]
type = AngleDraw
trigger1 = Time >= 10
Scale = 0.6,0.6

[State -1]
Type     = VelSet
trigger1 = Time = 0
X        = 10
Y        = -3+(Random%60)*0.1

[State 00, NotHitby];飛び道具だけあたる
type = NotHitBy
trigger1 = 1
value = ,AT

[State 00, Override]
type = HitOverride
trigger1 = 1
attr = SCA,AP,AA,AT
stateno = 10602 ;飛び道具が当った場合、10610ステートへ飛ぶ
IgnoreHitPause = 1
time = -1

[State 000]
type = HitDef
trigger1 = Time%4 = 0
attr = A, NP
damage = ceil(root,fvar(1)*20), 0
animtype = Medium
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 4, 9
sparkno = s20100
sparkxy = 0, 0
hitsound = s1, 8
guardsound = s4, 2
ground.type = Low
ground.slidetime = 22
ground.hittime  = 22
ground.velocity = -3*ifElse(Vel x < 0, -1,1),-3
air.velocity = -2.4*ifElse(Vel x < 0, -1,1),-3
Fall = 1

[State 補正]
Type = ParentVarSet
Trigger1 = MoveHit
fvar(1) = root,fvar(1) * 0.9
Persistent = 0
IgnoreHitPause = 1

[State 攻撃無効]
Type = StateTypeSet
TriggerAll = NumEnemy > 0
Trigger1 = (EnemyNear,StateNo) = [100,119]
Trigger2 = (((EnemyNear,StateNo) = [5210,5219]) && ((EnemyNear,Time) < 10))
movetype = I

[State 攻撃有効]
Type = StateTypeSet
TriggerAll = NumEnemy > 0
Trigger1 = (EnemyNear,StateNo) != [100,119]
Trigger2 = (((EnemyNear,StateNo) = [5210,5219]) && ((EnemyNear,Time) >= 10))
movetype = A

[State エフェクト]
Type = Explod
TriggerAll = NumEnemy > 0
TriggerAll = movetype = I
Trigger1 = P2Dist X = [-25-(EnemyNear,Const(Size.Ground.Front)), 25+(EnemyNear,Const(Size.Ground.Back))]
Trigger1 = P2Dist Y = [-25, 25-(EnemyNear,Const(Size.Head.Pos.Y))]
Anim = 20095
ID = 20095
Pos = 0,0
PosType = P1
Scale = 0.5,0.5
Ownpal = 1
SprPriority = 3
IgnoreHitPause = 1

[State グレイズ音]
Type = PlaySnd
TriggerAll = NumEnemy > 0
TriggerAll = movetype = I
Trigger1 = P2Dist X = [-25-(EnemyNear,Const(Size.Ground.Front)), 25+(EnemyNear,Const(Size.Ground.Back))]
Trigger1 = P2Dist Y = [-25, 25-(EnemyNear,Const(Size.Head.Pos.Y))]
Value = 0, 8

[State グレイズ]
Type = ChangeState
TriggerAll = NumEnemy > 0
TriggerAll = movetype = I
Trigger1 = P2Dist X = [-25-(EnemyNear,Const(Size.Ground.Front)), 25+(EnemyNear,Const(Size.Ground.Back))]
Trigger1 = P2Dist Y = [-25, 25-(EnemyNear,Const(Size.Head.Pos.Y))]
Value = 10600

[State 10240, 消滅]
type = DestroySelf
trigger1 = Pos Y > 120
trigger2 = ScreenPos Y < -360
trigger3 = abs(Pos X) > 360
trigger4 = time > 120

[State 10240, 消滅]
type = ChangeState
trigger1 = movecontact
Trigger2 = Root,MoveType = H && Root,StateNo != [120,159]
value = 10602




