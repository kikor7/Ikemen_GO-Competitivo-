trigger1 = AnimElem = 4
attr = S, NA ;立ち通常打撃（Standing, Normal Attack）
damage = ceil(fvar(1)*12), 0
animtype = Light
guardflag = MA
hitflag = MAF
priority = 3, Hit
pausetime = 10, 10
sparkno = s20100
sparkxy = -15, -21
hitsound = s1, 0
guardsound = s4, 2
ground.type = High
ground.slidetime = 15
ground.hittime  = 15
air.hittime = 15
