trigger1 = animelem = 8,>=0
trigger2 = numhelper(2000)
trigger2 = command = "SG" && POWER >= 2000
trigger2 = helper(2000),stateno = 20201
trigger2 = animelem = 13,>=0
value = 3000

[state 00]
