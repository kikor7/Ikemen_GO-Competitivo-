[state a]
type = changestate
triggerall = var(30) = 1
triggerall = p2statetype != L
triggerall = power >=2000
trigger1 = var(22) = 1
trigger1 = p2bodydist X = [-35,55]
trigger1 = p2bodydist Y = [-80,0]
value = 3000
ctrl = 0

[state a]
type = changestate
trigger1 = numhelper(2000)
trigger1 = command = "S1" && POWER >= 1000
trigger1 = helper(2000),stateno = 2020
trigger1 = animelem = 13,>=0
trigger2 = numhelper(2000)
trigger2 = command = "S1" && POWER >= 1000
trigger2 = helper(2000),stateno = 20201
trigger2 = animelem = 13,>=0
value = 2050

[state a]
type = changestate
