; ごろごろアタックの設定
[Statedef 1000]
type    = A
movetype= A
physics = N
juggle  = 1
velset = 8,0
ctrl = 0
anim = 1000
poweradd = 0

[State 1000 , 1]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA
damage    = 50,5
animtype = Hard
getpower = 60,30
givepower = 15,8
guardflag = H
hitflag = MAF
priority = 3, Hit
pausetime = 7,8
numhits = 1
sparkno = -1
sparkxy = -10,-68
hitsound = S9,6
guardsound = S0,6
ground.type = Low
ground.slidetime = 5
ground.hittime  =  15
ground.velocity = -4
airguard.velocity = -1.9    
air.velocity = 0,0
fall = 1                        ;攻撃命中時、相手が空中復帰させない
fall.recover = 0                ;リカバリー不能にさせる

[State 1000 , 1]
type = PlaySnd
trigger1 = Time = 1
value = 4, 1

[State 1000, 4]
type = Explod
trigger1 = MoveHit
trigger1 = P2MoveType = H
persistent = 0
anim = 7020
pos = 10,-55
postype = p1
sprpriority = 2
bindtime = 1
ignorehitpause = 1
vel = 0,0
accel = 0,0
scale = 1,1
ownpal = 1
;;supermove = 1


[State 1000 , 6]
type = ChangeState
trigger1 = stateno = 1000
trigger1 = MoveContact
value = 1001
ctrl = 1

[State 1000 , 7]
type = ChangeState
trigger1 = stateno = 1000
trigger1 = statetime >= 10
value = 50
ctrl = 1


