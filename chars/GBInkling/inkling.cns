;AURA
[Statedef 8800]
type = S
movetype = I
physics = N
sprpriority = 155
velset = 0,0
ctrl = 0
;
[state 8800, noshadow]; aura has no shadow
type = assertspecial
trigger1 = 1
flag = noshadow
;
[state 8800, playerpush]; the aura can go right through you
type = playerpush
trigger1 = 1
ignorehitpause = -1
persistent = 1
value = 0
;
[state 8800, canthit]; not able to hit the aura and vice versa
type = nothitby
trigger1 = 1
time = -1
persistent = 1
value = SCA
;
[State 8800, ChangeAnim]; makes the aura do what you do
type = ChangeAnim
trigger1 = !time
trigger1 = selfanimexist(parent,anim)
elem = parent,animelemno(0)
value = parent, anim

[State 8800, ChangeAnim]; makes the aura do what you do
type = ChangeAnim
trigger1 = time>0
elem = animelemno(0)
value = anim
;
[State 8800, bindtoroot]; binds the auras position to the player using it
type = bindtoroot
trigger1 = 1
facing = 1
pos = 0, 0
time = -1
ignorehitpause = -1
persistent = 1
;
[State 8800, color]; change to whatever color you want the aura to be
type = palfx
trigger1 = 1
add = 100, 100, 100
mul = 256, 256, 256
sinadd = 256, 256, 256, 50
invertall = 0
color = 256
time = -1
ignorehitpause = -1
persistent = 1
;
[State 8800, trans]; makes the aura see through
type = trans
trigger1 = 1
trans = addalpha
alpha = 256 - (20*time), (20*time)
ignorehitpause = -1
persistent = 1
;
[State 8800, angledraw]; how big the aura radiates over time
type = angledraw
trigger1 = 1
value = 0
scale = 1 + (.013*time), 1 + (.013*time)
ignorehitpause = -1
persistent = 1
;
[State 8800, destroyself]; time to restart the hazing animations of the aura
type = Destroyself
trigger1 = time >= 15


