;=========================================================================
; KO VOICES
;=========================================================================
; Set the variable to null when the player is alive
[State -2, KO Voices: Set Variable]
type = Null
trigger1 = alive
trigger1 = var(3) := 0
ignorehitpause = 1
; Play knockout cry when the player is not alive while the variable is still null
[State -2, KO Voices: Voice]
type = PlaySnd
trigger1 = !alive && !var(3) && stateno != 5950
value = 5150, 0
volumescale = 100
channel = -1
ignorehitpause = 1
; Set the variable to 1 when the player is not alive to only allow the cry to play once
[State -2, KO Voices: Set Variable]
type = Null
trigger1 = !alive
trigger1 = var(3) := 1
ignorehitpause = 1
