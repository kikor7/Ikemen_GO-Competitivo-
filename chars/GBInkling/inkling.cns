;;---------------------------------------------------------------------------
; Astral Ready Aura
[Statedef 7000] 
physics = N                      
sprpriority = -4 ; Spawn behind the player. Typical player sprpriority doesn't go below 0.  

[State 0, NotHitBy]
type = NotHitBy
trigger1=1
value = SCA,NA,SA,HA,NP,SP,HP,NT,ST,HT

[State 7000, ChangeAnim]
type = ChangeAnim
trigger1 = 1 || anim != root,anim ; Safety! 
value = root,Anim
elem = root,Animelemno(0) ; Capture the player's animelem
     
[State 7000, BindToRoot]
type = BindToRoot ; This is to ensure the proper position for the helper.
trigger1 = 1
ignorehitpause = 1
     
[State 7000, AngleDraw]
type = AngleDraw
trigger1 = 1
scale = 1 + .05 * (time),1 + .05 * (time) ; Adjust the decimal value to control the size of the "Afterimage"
     
[State 40700000]
type = PalFX
trigger1 = 1 
time = 1
add = 100,10,-120
mul = 256,256,256
color = 0 
sinadd=40,30,0,10                                        

[State 7000, Trans]
type = Trans
trigger1 = 1
trans = addalpha
alpha = 256 - 16* (time) ,256  ; You can decrease the integer that is next to the multiplication symbol to control the fading of the "Afterimage".
persistent = 1
     
[State 7000, DestroySelf]
type = DestroySelf
trigger1 = time > 30 ; Destroy after 6 ticks to respawn and recreate time! You can increase this value to increase the life of the "Afterimage".
trigger2 = root,movetype = H ; Prevent custom state angle stuff
