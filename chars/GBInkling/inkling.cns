trigger1=!var(39)&&var(38)<500
trigger1=(root,command="holdup"||root,command="holddown"||root,command="holdback"||root,command="holdfwd")
var(38)=25
 
[State 12345, Varadd]
type=varadd
trigger1=!var(39)
trigger1=(root,command="holdup"||root,command="holddown"||root,command="holdback"||root,command="holdfwd")
var(36)=1-(root,command="holddown"||root,command="holdback"&&facing=1||root,command="holdfwd"&&facing=-1)*2
 
[State 12345, Varadd]
type=varadd
trigger1=(root,command="holdup"||root,command="holddown"||root,command="holdback"||root,command="holdfwd")&&!var(39)||var(39)
var(39)=1
 
[State 12345, Varset]
type=varset
trigger1=!time||var(39)>=13
var(39)=0

[State 0, RemoveExplod]
