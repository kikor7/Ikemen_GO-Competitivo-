; Definition file for player
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Inkling Girl"        ;Name of character
displayname = "Inkling Girl" ;Name of character to display
versiondate = 7/6/2024   ;Version date of character
mugenversion = 1.0   ;Version of M.U.G.E.N character works on
author = "GB Shades & thebestmlTBM"      ;Character author name
pal.defaults = 1  ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd     = inkling.cmd   ;Command set
cns     = inkling.cns   ;Constants
st      = inkling.cns   ;States
stcommon = common1.cns ;Common states
sprite  = inkling.sff   ;Sprite
anim    = inkling.air   ;Animation
sound  = inkling.snd   ;Sound
;pal1   = player.act   ;Palettes (can have up to 12)
;pal2   =
;pal3   =
;pal4   =
;pal5   =
;pal6   =
;pal7   =
;pal8   =
;pal9   =
;pal10  =
;pal11  =
;pal12  =
