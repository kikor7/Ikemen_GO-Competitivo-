;--------------Deslocamento para frente
[Statedef 100]
type = S
movetype = I
physics = S
anim = 100
ctrl = 0
velset = 0, 0

;Spark do Dash 
[State 100,poe]
type = Helper
trigger1 = animelem = 3
helpertype = Normal
name = "Poeirat"
postype = P1
pos = -10,0
stateno = 1012
ownpal = 1

; personagem estÅEno ar (muda parametro)
[State 100,p2noar]
type = StateTypeSet
trigger1 = AnimElem = 3, >0
statetype = A
physics = N

[State 100,gravidade]
type = VelAdd
trigger1 = AnimElem = 3, > 0
y = .39

[State 100,constante]
type = VelSet
trigger1 = AnimElem = 3
x = Const(velocity.run.fwd.x)
y = Const(velocity.run.fwd.y)

[State 100,som]
type = PlaySnd
trigger1 = AnimElem = 3
value = 0,15

[State 100,aterrizar]
type = ChangeState
trigger1 = AnimElem = 2,>=0
trigger1 = Vel Y > 0 && Pos Y >= 0
value = 101

[State 100, dashFAtaque]
type = ChangeState
triggerall = RoundState = 2 && var(59) = 1
trigger1 = animelem = 2, >0
trigger1 = p2bodydist X < 60 && p2movetype != A && p2stateno != [505,506]
value = 210

[State 100, dashFAtaque]
type = ChangeState
triggerall = RoundState = 2 && var(59) = 0
trigger1 = animelem = 2, >0
trigger1 = command = "z" || command = "b"
value = 210

