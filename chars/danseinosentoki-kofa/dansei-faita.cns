; KFM's constants and state file.
; There are comments scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

; 偙傟偼KFM偺掕悢偲忬懺偺僼傽僀儖偱偡丅
; 偙偺僼傽僀儖偺拞偵偼拲庍偑嶶傜偝傟偰偄傞偺偱丄CNS傪廗偄偨偄偍曽偼
; 撉傫偱傒偨傜偄偄偱偡丅

[Data]
life = 1500
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 0
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = .9          ;Horizontal scaling factor.
yscale = .9           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 5.6, 0    ;Run forward (x, y)
run.back = -5.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-9.4    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-9.1 ;Running jump speeds (opt)
runjump.fwd = 4,-9.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.

[Movement]
airjump.num = 1      ;Number of air jumps allowed (opt)
airjump.height = 35  ;Minimum distance from ground before you can air jump (opt)
yaccel = .55         ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching






;---------------------- dodge forward 110 ------------------------------

[Statedef 700]
type    = S
movetype= I
physics = N
velset = 0,0
ctrl = 0
anim = 700
sprpriority = -1

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = S9,0 + (random % 3)

[State 110, 1]
type = Afterimage
trigger1 = Time = 3
time = 10
length = 5
PalBright = 0, 0, 0
PalContrast = 128,128,128
PalAdd = 0, 0, 0
PalMul = 1,1,1
FrameGap = 4
Trans = Add1

[State 110, Vel Y]
type = VelSet
trigger1 = animelem = 2
x = 5

[State 110, 3]
type = VelSet
trigger1 = animelem = 8
x = 0

[State 110, 4]
type = PlayerPush
trigger1 = Time >= 0
value = 0

[State 110, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 1001
ctrl = 0

;---------------------- dodge backward 120 ------------------------------

;屻曽嬞媫夞旔
;---------------------------------------------------------------------------
; Recuperacion tras esquivar/rodar: sin control y golpeable unos frames,
; para que no se pueda encadenar sin riesgo.
;---------------------------------------------------------------------------
[Statedef 1001]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0
velset = 0,0

[State 1001, Fin de la recuperacion]
type = ChangeState
trigger1 = Time >= 12
value = 0
ctrl = 1

[Statedef 701]
type    = S
movetype= I
physics = N
velset = 0,0
ctrl = 0
anim = 701

[State 1000, PlaySnd]
type = PlaySnd
trigger1 = animelem = 1
value = S9,0 + (random % 3)

[State 110, Vel Y]
type = VelSet
trigger1 = animelem = 2
x = -5

[State 110, 3]
type = VelSet
trigger1 = animelem = 8
x = 0

[State 355, 1]
type = NotHitBy
trigger1 = Time >= 0
value = SCA
time = 1

[State 355, 1]
type = Afterimage
trigger1 = Time = 5
time = 10
length = 5
PalBright = 0, 0, 0
PalContrast = 128,128,128
PalAdd = 0, 0, 0
PalMul = 1,1,1
FrameGap = 4
Trans = Add1



[State 355, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 1001
ctrl = 0

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
; CNS 儗儀儖: 婎杮
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 191,]
type = PlaySnd
trigger1 = time = 1
value = s170,0



[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
; CNS 儗儀儖: 婎杮
[Statedef 180]
type = S

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win pose 1 - Bow
; CNS difficulty: basic
; CNS 儗儀儖: 婎杮
[Statedef 181]
type = S
ctrl = 0
anim = 181 + (random % 2)
velset = 0,0

[State 191,]
type = PlaySnd
triggerall = anim = 181
trigger1 = time = 1
value = s180,0

[State 191,]
type = PlaySnd
triggerall = anim = 182
trigger1 = time = 1
value = s180,1

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = !MatchOver
trigger1 = Time = [0,200]
flag = RoundNotOver

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = MatchOver
trigger1 = Time = [0,200]
flag = RoundNotOver

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
; CNS 儗儀儖: 婎杮
[Statedef 191]
type = S
ctrl = 0
anim = 191 + (random % 2)
velset = 0,0


[State 191,]
type = PlaySnd
trigger1 = time = 1
value = s190,0 + (random % 2)



[State 191, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 191, 3] ;Change to stand state when done
type = ChangeState
trigger1 = AnimTime = 0
value = 0


