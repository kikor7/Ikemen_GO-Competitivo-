; HITA_FALL (knocked up, falling)
[Statedef 19650]
type    = A
movetype= H
physics = N

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 20
value = -gethitvar(damage)


[State 0, PlaySnd]
