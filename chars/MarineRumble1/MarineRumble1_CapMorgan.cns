triggerall = Var(20) <= 0
trigger1 = Time = 0
value = S4,2
volume = 100
channel = -1


[State 196196, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 19635
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 19635
trigger2 = (Anim != [19651, 19659]) && (Anim != [19661, 19669])
trigger2 = Anim != 19690 ;Not if hit off ground anim
value = 19650

[State 19650, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [19650,19659]
trigger1 = Vel Y >= ifelse(anim = 19650, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 19650, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 19650, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 19800 ;HITFALL_RECOVER

[State 19650, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 19810 ;HITFALL_AIRRECOVER

[State 19650, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [19651,19659]) || (anim = [19661,19669]), 0, 10)
value = 19700

