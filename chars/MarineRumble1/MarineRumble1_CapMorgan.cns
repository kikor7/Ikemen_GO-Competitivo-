;---------------------------------------------------------------------------
; Stand
[Statedef 19000]
type = S
physics = S
sprpriority = 0

[State 1000, hitoverride]
type=hitoverride
trigger1=1
attr=SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=19600
ignorehitpause=1


[State 0, 1]
type = ChangeAnim
trigger1 = (Anim != 19000 && Anim != 19005)
trigger2 = (Anim = 19005) && AnimTime = 0
value = 19000


[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < 2
trigger2 = Time = 4
x = 0

[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30



;-----------------------------------------------------------
[State 0, Winpose]
type = ChangeState
triggerall = parent, numhelper(182) = 1
trigger1 = 1
value = 19181
ctrl = 0

[State 0, Lose by Time]
type = ChangeState
triggerall = parent, numhelper(172) = 1
trigger1 = 1
value = 19900
ctrl = 0

;-----------------------------------------------------------

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = parent,var(21) <= 0
value = 19700
;------------------------------------------------------------

[State 0, Super Marine Slash]
type = ChangeState
triggerall = time%200 = 0 &&  random = [200,600]
triggerall = numhelper(19270) = 0
trigger1 = p2bodydist x > 50
trigger1 = power >= 2000
value = 19250
ctrl = 1


[State 0, Golpes]
type = ChangeState
triggerall = time%50 = 0 &&  random = [200,300]
trigger1 = p2bodydist x > 50
trigger2 = p2bodydist y < -50
value = 19230
ctrl = 1

[State 0, Golpes]
type = ChangeState
trigger1 = p2bodydist x < 50
trigger1 = time%50 = 0 &&  random = [200,600]
value = ifelse(random >= 450, 19200,19220)
ctrl = 1

[State 0, Walk] ; caminar
type = ChangeState
triggerall = p2movetype != H
trigger1 = p2bodydist x > 10
trigger1 = time%50 = 0 &&  random = [100,700]
value = ifelse(random >= 650, 19021,19020)
ctrl = 1


[State 0, Salto]
type = ChangeState
;trigger1 = p2movetype = A
trigger1 = time%50 = 0 && random = [200,300]
value = 19040
ctrl = 0






