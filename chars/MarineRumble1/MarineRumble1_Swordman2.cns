;==========<JUMP IN>====================================================
;-----------------------------------------------------------------------

[Statedef 12099]
type = A
physics = N
anim = 12041

[State 1200, hitoverride]
type=hitoverride
trigger1=1
attr= SCA,NA,SA,HA,NP,SP,HP
time=-1
stateno=12600
ignorehitpause=1


[State 0, Turn]
type = Turn
trigger1 = P2BodyDist X < -30

[State 1205, vel]
type = veladd
trigger1 = 1
y =.3

[State 1205, Not Bound]
type=screenbound
trigger1= 1
value=0
ignorehitpause = 1


[State 1205, vel]
type = velset
trigger1 = time = 0
x = 1+(Random%3)
y = -3-(Random%3)

[State 0, VarSet] ; esto es lo que le da la vida
type = VarSet
trigger1 = !time
v = 20
value = 100 ; tiene 100 de vida (valor recomendado para clones)

[State 0, Varset] ; cuenta la cantidad de veces que se invoca el helper
type = Varset     ; para no invocar mas de los que permite la vida total
trigger1 = time = 0
v = 23
value = 1
[State 0, Varset]
type = Varset
trigger1 = time = 1
v = 23
value = 0

[State 1005, end]
type = changestate
trigger1 = Pos y > -1
value = 12012


;=======================================================================
;------ CAIDAS ---------------------------------------------------------
;=======================================================================

;---------------------------------------------------------------------------
; HITG_SHAKE
[Statedef 12600]
type    = S
movetype= H
physics = N
velset = 0,0

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 20
value = -gethitvar(damage)



[State 12600, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = ifelse((GetHitVar(groundtype) = 1),12600,12610) + GetHitVar(animtype)

[State 12600, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = var(20) <= 0
value = 12630

[State 12600, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(12647 + GetHitVar(animtype)))
value = 12647 + GetHitVar(animtype) ;12651 - 4 + type

[State 12600, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 12600, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
trigger1 = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 12600, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 12601 ;HITG_SLIDE

[State 12600, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger2 = var(20) <= 0
value = 12630

[State 12600, FFB Light]
type = ForceFeedback
trigger1 = anim = 12600
trigger2 = anim = 12610
persistent = 0
time = 6
waveform = square

[State 12600, FFB Medium]
type = ForceFeedback
trigger1 = anim = 12601
trigger2 = anim = 12611
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 12600, FFB Hard]
type = ForceFeedback
trigger1 = anim = 12612
trigger2 = anim = 12602
trigger3 = anim = 12630
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

;---------------------------------------------------------------------------
; HITG_SLIDE
[Statedef 12601]
type    = S
movetype= H
physics = S

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 20
value = -gethitvar(damage)


[State 12601, 1]
type = HitVelSet
trigger1 = Time = 0
x = 1

[State 12601, 2]
type = ChangeAnim
trigger1 = AnimTime = 0
value = 12605 + GetHitVar(animtype) + (GetHitVar(groundtype)=2)*10

[State 12601, 3] ;Stop sliding back
type = VelMul
trigger1 = Time >= GetHitVar(slidetime)
x = .6

[State 12601, 4]
type = VelSet
trigger1 = HitOver
x = 0

[State 12601, 5]
type = DefenceMulSet
trigger1 = HitOver
value = 1

[State 12601, 6]
type = ChangeState
trigger1 = HitOver
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; HITC_SHAKE
[Statedef 12610]
type    = C
movetype= H
physics = N
velset = 0,0

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 20
value = -gethitvar(damage)


[State 12610, 1] ;Anim for HIT_LIGHT to HIT_HARD
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) != [3,5]
value = 12620 + GetHitVar(animtype)

[State 12610, 2] ;Anim for HIT_BACK
type = ChangeAnim
trigger1 = Time = 0
trigger1 = GetHitVar(animtype) = [3,5]
trigger2 = var(20) <= 0
value = 12630

[State 12610, 3] ;Anim for HIT_UP/HIT_DIAGUP (only if it exists)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = (GetHitVar(animtype) = [4,5]) && (SelfAnimExist(12647 + GetHitVar(animtype)))
value = 12647 + GetHitVar(animtype) ;12651 - 4 + type

[State 12610, 4] ;Freeze anim
type = ChangeAnim
trigger1 = Time > 0
value = anim

[State 12610, 5] ;State type gets set to aerial if getting hit up
type = StateTypeSet
triggerall = Time = 0
trigger1 = GetHitVar(yvel) != 0 || GetHitVar(fall)
trigger2 = Pos Y != 0
statetype = a

[State 12610, 6]
type = ChangeState
trigger1 = HitShakeOver
trigger1 = GetHitVar(yvel) = 0 && !GetHitVar(fall)
value = 12611 ;HITC_SLIDE

[State 12610, 7]
type = ChangeState
trigger1 = HitShakeOver
trigger2 = var(20) <= 0
value = 12630

[State 12610, FFB Light]
type = ForceFeedback
trigger1 = anim = 12620
persistent = 0
time = 6
waveform = square

[State 12610, FFB Medium]
type = ForceFeedback
trigger1 = anim = 12621
persistent = 0
time = 8
waveform = sinesquare
ampl = 110,-1,-.3

[State 12610, FFB Hard]
type = ForceFeedback
trigger1 = anim = 12622
persistent = 0
time = 15
waveform = sinesquare
ampl = 140

