triggerall = Anim = 12020
trigger1 = Animelem = 3
value = S40,0
volume = 50

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = (Anim != 12020 && Anim != 12005)
trigger2 = (Anim = 12005) && AnimTime = 0
