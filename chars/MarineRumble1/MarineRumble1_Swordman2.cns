;---------------------------------------------------------------------------
; HITA_FALL (knocked up, falling)
[Statedef 12650]
type    = A
movetype= H
physics = N

[State 0, VarAdd] ;para restar vida del Swordman
type = VarAdd
trigger1 = !time
v = 20
value = -gethitvar(damage)



[State 126126, 1] ;Change anim when done with transition
type = ChangeAnim
trigger1 = AnimTime = 0
trigger1 = Anim = 12635
trigger2 = Time = 0     ;If no transition anim
trigger2 = Anim != 12635
trigger2 = (Anim != [12651, 12659]) && (Anim != [12661, 12669])
trigger2 = Anim != 12690 ;Not if hit off ground anim
value = 12650

[State 12650, 2] ;Coming down anim
type = ChangeAnim
trigger1 = anim = [12650,12659]
trigger1 = Vel Y >= ifelse(anim = 12650, 1, -2)
trigger1 = SelfAnimExist(anim+10)
value = anim+10
persistent = 0

[State 12650, 3] ;Gravity
type = VelAdd
trigger1 = 1
y = GetHitVar(yaccel)

[State 12650, 4] ;Recover near ground
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 12800 ;HITFALL_RECOVER

[State 12650, 5]; Recover in mid air
type = ChangeState
triggerall = Vel Y > -1
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 12810 ;HITFALL_AIRRECOVER

[State 12650, 6]
type = ChangeState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= ifelse((anim = [12651,12659]) || (anim = [12661,12669]), 0, 10)
value = 12700

