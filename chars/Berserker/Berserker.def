[Info]
Name         = "Berserker"  ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Berserker"  ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 04,25,2015   ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002   ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = ""           ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,1          ;ＣＰＵで出てきた時のカラーパレットの順番


[Files]
movelist = movelist.dat
Cmd     = etc/Berserker.cmd   ;コマンドファイルの登録
Cns     = cns/Berserker.cns   ;コンスタンツファイルの登録
St      = cns/Berserker.cns   ;ステートファイルの登録・最大１１個まで増やせます
St0     = cns/config.txt      ;（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
St1     = cns/Berserker_N.cns ;「St」のみ必要な項目なので省略出来ません
St2     = cns/Berserker_S.cns
St3     = cns/Berserker_S2.cns
St4     = cns/HAHelper.cns
St5     = cns/ninsin.cns
StCommon = common1.cns        ;コモンステートファイルの登録
Sprite  = etc/Berserker.sff   ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim    = etc/Berserker.air   ;アニメーションファイルの登録
Sound   = etc/Berserker.snd   ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

Pal1 = act/Berserker.act

;[Arcade]
;Intro.Storyboard = intro.def   ;オープニングのファイルを登録します
;Ending.Storyboard = ending.def