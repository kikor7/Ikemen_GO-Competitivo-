value = 4218, 23
channel = 0

[State 207, 音を鳴らす]                     ;悲鳴設定
type = PlaySnd
trigger1 = Time = 0
value = 5000, 20
channel = 0

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
Trigger1 = const(movement.yaccel) >= .58
y = const(movement.yaccel)

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
Trigger1 = const(movement.yaccel) < .58
y = 0.58

[State 1028, Anim 5050] ;Self falling animation
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !SelfAnimExist(5052)
value = 5050

[State 1028, Anim 5052] ;Self falling animation (diagup type)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5052)
value = 5052

[State 1028, Anim 5060] ;Coming down - normal
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5050
trigger1 = SelfAnimExist(5060)
persistent = 0
value = 5060

[State 1028, Anim 5062] ;Coming down - diagup type
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5052
trigger1 = SelfAnimExist(5062)
persistent = 0
value = 5062

[State 200]
type = Screenbound
trigger1 = 1
value = 0
ignorehitpause = 1

[State 821, 4] ;Hit ground
type = ChangeState
trigger1 = alive = 0
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 105100

[State 821, 4] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground

