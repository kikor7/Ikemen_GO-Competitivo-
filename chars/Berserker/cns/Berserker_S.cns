;---------------------------------------------------------------------------

;アングリーハンマー
;マッスルバスター

;---------------------------------------------------------------------------


;---------------------------------------------------------------------------
;アングリーハンマー 1段
[Statedef 1000]
type    = S
movetype= A
physics = S
velset = 0,0
ctrl = 0
anim = 1000
poweradd = 0
sprpriority = 2

[State 170, 無敵]
type = NotHitBy
trigger1 = time < 21
value = SCA
time = 1

[State 200, 物理的なキャラの幅]
type = null;Width
trigger1 = time >= 15
value = 100,0

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 3
value = 1, 2

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 6
value = 0, 12


[State 200, ヒット定義]
type = HitDef
triggerall = (P2stateno != 1002) || (P2movetype != H)
trigger1 = var(10) < var(12)
trigger1 = AnimElem = 8
attr = S, HA
damage = 100, 10
getpower = 15,7
animtype = hard
guardflag = M
hitflag = MAFD
priority = 3, Hit
pausetime = 8, 8
sparkno = s3101
sparkxy = -10, -30
hitsound = s0, 7
guardsound = s0, 15
ground.type = High
ground.slidetime = 1
ground.hittime  = 25
ground.velocity = -0.2
airguard.velocity = -0.2,-14
air.type = High
air.velocity = -0.2,-14
air.hittime = 20
fall.recover = 0
fall = 1
p2facing = 1
p2stateno = 1002


[State 200,helper] ;飛び道具消し用ヘルパー呼び出し
type = Helper
trigger1 = 1
trigger1 = NumHelper(1001) < 1
stateno = 1001
ID = 1001
name = "1001"
helpertype = Normal
keyctrl = 0
pos = 0,0
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)
postype = p1
ownpal = 1
sprpriority = 9
ignorehitpause=1

[State 200, varadd10]
type = varadd
trigger1 = movehit = 1
var(10) = 1
persistent=0

[State 1020, 画像の色]
type = null;PalFX
trigger1 = Time = 0
time = 39
add = 50,-65,-50
sinadd = 155,40,55,5

[State 1020, 画像の色]
type = PalFX
trigger1 = Time = 0
time = 39
add = 32,16,0
sinadd = 64,32,5,3



[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;アングリーハンマー　飛び道具消しヘルパー
[statedef 1001]
movetype = A
ctrl = 0
sprpriority = 9
movehitpersist=1

[State 8800, 本体がきたら場合立ちへ移行]
type = ChangeState
trigger1 = !IsHelper
value = 0
ignorehitpause = 1

[State 8800, アニメ変更]; 食らい判定アニメ
type = ChangeAnim
trigger1 = 1
value = 1001
Elem = Root, AnimElemNo(0)
ignorehitpause = 1

[State 8800, 親の位置に固定]
type = BindToRoot
trigger1 = 1
time = 1
facing = 1
pos = 0, 0
ignorehitpause = 1


[State 200]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2 = noshadow
ignorehitpause = 1

[State 200]
type = Screenbound
trigger1 = 1
value = 0
ignorehitpause = 1

[State 200]
type = HitOverride
trigger1 = 1
attr = SCA,AA,AT,AP
stateno = stateno
ignorehitpause = 1

[State 200, ヒット定義]
type = HitDef
trigger1 = 1
attr = S, SA
damage = 0, 0
getpower = 15,7
animtype = hard
hitflag = MAF
priority = 3, Hit
pausetime = 8, 8
sparkno = -1
guard.sparkno = -1
sparkxy = 0, -60
ground.type = none
ground.slidetime = 0
ground.hittime  = 0
ground.velocity = 0
airguard.velocity = 0,0
air.type = none
air.velocity = 0,0
air.hittime = 0


[State 206]
type = DestroySelf
trigger1 = movecontact
trigger1 = numtarget
trigger1 = !target,ishelper ;敵本体に当たったら消える。即座に消さないと酷いことになる
trigger2 = root,stateno != 1000
trigger3 = AnimTime = 0
ignorehitpause=1

;---------------------------------------------------------------------------
;アングリーハンマー　相手
[Statedef 1002]
type    = A
movetype= H
physics = N
velset = -0.2,-18
poweradd = 40
ctrl = 0

[State 207, 音を鳴らす]                     ;悲鳴設定
type = PlaySnd
trigger1 = Time = 0
value = 4218, 23
channel = 0

[State 207, 音を鳴らす]                     ;悲鳴設定
type = PlaySnd
trigger1 = Time = 0
value = 5000, 20
channel = 0

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
Trigger1 = const(movement.yaccel) >= 0.58
y = const(movement.yaccel)

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
Trigger1 = const(movement.yaccel) < 0.58
y = 0.58


[State 1028, Anim 5050] ;Self falling animation
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !SelfAnimExist(5052)
value = 5050

[State 1028, Anim 5052] ;Self falling animation (diagup type)
type = ChangeAnim
trigger1 = Time = 0
trigger1 = SelfAnimExist(5052)
value = 5052

[State 1028, Anim 5060] ;Coming down - normal
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5050
trigger1 = SelfAnimExist(5060)
persistent = 0
value = 5060

[State 1028, Anim 5062] ;Coming down - diagup type
type = ChangeAnim
trigger1 = Vel Y > -2
trigger1 = Anim = 5052
trigger1 = SelfAnimExist(5062)
persistent = 0
value = 5062

[State 200]
type = Screenbound
trigger1 = 1
value = 0
ignorehitpause = 1

[State 821, 4] ;Hit ground
type = ChangeState
trigger1 = alive = 0
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 105100

[State 821, 4] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground


