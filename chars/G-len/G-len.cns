trigger1 = numhelper(2) = 1
trigger1 = numhelper(6) = 1
trigger1 = helper(1),stateno = 1
trigger1 = helper(2),stateno = 2
trigger1 = helper(6),stateno = 6
value = 1

[State 1000,0]
type = AssertSpecial
trigger1 = time >= 0
flag = invisible

[State 0, 2]
type = VelSet
trigger1 = Time = 0
trigger1 = numhelper(6) = 1
