triggerall = palno = [7,12]
trigger1 = command = "down"
add = 50,50,200
time = 10

[State 9000, CtrlSet]
type = CtrlSet
triggerall = numhelper(1) = 1
triggerall = numhelper(2) = 1
triggerall = numhelper(6) = 1
