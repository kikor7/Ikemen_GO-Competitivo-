;---------------------------------------------------------------------------
;ダッシュ
[Statedef 100]
type    = A
physics = N
ctrl = 0
anim = 100
sprpriority = 2

[State 100, エフェクト]
type = Explod
trigger1 = AnimElem = 1
anim = 8400
facing = 1
postype = p1
pos = -25,-75
sprpriority = 3
ownpal = 1
scale = .5,.5
vel = -2,0
pausemovetime = 73640
supermovetime = 73640
supermove = 1
bindtime = 1
persistent = 0
ignorehitpause = 1

[State 100, エフェクト]
type = Explod
trigger1 = AnimElem = 1
anim = 8450
facing = 1
postype = p1
pos = -25,-75
sprpriority = -3
ownpal = 1
scale = .5,.5
vel = -2,0
pausemovetime = 73640
supermovetime = 73640
supermove = 1
bindtime = 1
persistent = 0
ignorehitpause = 1

[State 100, 残像]
type = AfterImage
trigger1 = AnimElemTime(1) = 0
time = 12
PalBright = 0,0,0
PalContrast =  222,222,222
PalAdd      = -1,-1,-1
PalMul      = .5,.5,.5
Trans = Add
TimeGap  = 1
FrameGap = 2
length = 13

[State 100, 物理的なキャラの幅]
type = Width
trigger1 = FrontEdgeDist <= 5
value = 5,0

[State 100, 停止]
type = VelSet
trigger1 = FrontEdgeDist <= 5
x = 0

[State 100, 加速]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)
y = const(velocity.run.fwd.y)

[State 100, 重力]
type = VelAdd
trigger1 = Time >= 2
y = const(movement.yaccel)

[State 100, 残像]
type = AfterImage
trigger1 = AnimElemTime(1) = 0
time = 10
PalBright = 0,0,0
PalContrast =  222,222,222
PalAdd      = -1,-1,-1
PalMul      = .5,.5,.5
Trans = Add
TimeGap  = 1
FrameGap = 2
length = 13

[State 100, ステート変更]
type = ChangeState
triggerall = time > 5
trigger1 = Vel Y > -1
trigger1 = Pos Y >= -1
value = 52

