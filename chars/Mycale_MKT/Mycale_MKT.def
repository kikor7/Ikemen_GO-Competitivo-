;--| 基本情報 |---------------------------------------------------------------
[Info]
Name         = "Mycale"    ;キャラクターの名前（必要な項目なので省略不可）
DisplayName  = "Mycale"    ;M.U.G.E.Nで実際に表示される名前（省略可能）
VersionDate  = 02,22,2013  ;キャラクターの最終更新日（変えなくてもＯＫ）
MugenVersion = 04,14,2002  ;キャラクターが動作出来るM.U.G.E.Nの改訂版
Author       = "Mikita"    ;キャラクターの作成者（必要な項目なので省略不可）
Pal.Defaults = 1,2,3,4,5,6 ;ＣＰＵで出てきた時のカラーパレットの順番

[Files]
movelist = movelist.dat
Cmd     = Mycale.cmd
Cns     = Mycale.cns
St      = Mycale.cns
St1     = Reflector.cns
St2     = Super.cns
St3     = -2_-3.txt
StCommon = common1.cns
Sprite  = Mycale.sff
Anim    = Mycale.air
Sound   = Mycale.snd

