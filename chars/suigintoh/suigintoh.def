pal1    = suigin1.act         ; a    ノーマルカラー
pal2    = c3.act         ; b    ダークな感じ
pal3    = c4.act         ; c    紅い。
pal4    = suigin1.act         ; x    
pal5    = c3.act         ; y    
pal6    = c2.act         ; z    金髪
pal7    = suigin1.act         ; s+a  
pal8    = c3.act         ; s+b  
pal9    = c4.act         ; s+c  
pal10   = suigin1.act         ; s+x  
pal11   = c3.act         ; s+y  
pal12   = c2.act         ; s+z  

; Arcade mode
