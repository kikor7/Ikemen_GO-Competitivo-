;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Jump Up Sound]
type = PlaySnd
triggerall = stateno = 40 || stateno = 45 && !time
trigger1 = time =0
value = S0,1
volumescale = 250

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = S0,0
volumescale = 250

[State -3, Jump Land FX]
type = Explod
trigger1 = stateno = 52
anim = 8000
pos = 5,10
postype = p1  ;p2,front,back,left,right 
scale = .5,.5
sprpriority = 0
ownpal = 1
removeongethit = 1

[State -3, Jump FX]
type = Explod
trigger1 = stateno = 40 | stateno = 45 | stateno = 43
anim = 8001
pos = 5,0
postype = p1  ;p2,front,back,left,right 
scale = .5,.5
sprpriority = 0
ownpal = 1
removeongethit = 1

[State -3, Walk Forward Sound]
type = PlaySnd
triggerall = anim = 20    
trigger1 = animelemtime(6) = 1 |  animelemtime(12) = 1 
value = s0,0
volumescale = 250

[State -3, Walk Backward Sound]
type = PlaySnd
triggerall = anim = 21   
trigger1 = animelemtime(6) = 1 |  animelemtime(12) = 1 
value = s0,0
volumescale = 250

[State -3, Hurt Sound]
