[State 動作終了時、現在位置が保存した数値と違う場合に移動する]
type = VelSet
trigger1 = fVar(22) != pos x
trigger1 = facing = 1
trigger2 = fVar(22) != pos x
trigger2 = facing = -1
x = const(velocity.jump.back.x)

[State 保存位置を過ぎたら停止]
type = VelSet

trigger1 = fVar(22) >= pos x
trigger1 = facing = 1
trigger2 = fVar(22) <= pos x
trigger2 = facing = -1
x = 0

[State 保存位置を過ぎたら停止]
type = posSet

trigger1 = fVar(22) >= pos x
trigger1 = facing = 1
trigger2 = fVar(22) <= pos x
trigger2 = facing = -1
x = fVar(22)


