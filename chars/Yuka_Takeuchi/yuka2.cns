type    = L
movetype= H
physics = N

[State 1335, 1a] ;Get up anim (normal)
type = ChangeAnim
triggerall = time = 0
trigger1 = anim != [5111,5119]
trigger2 = !SelfAnimExist(5120 + (anim % 10))
value = 5120

[State 1335, 1b] ;Get up anim (for hit up/diag-up)
