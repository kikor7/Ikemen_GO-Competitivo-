;触手樹液a版---------------------------------------------------------------
[Statedef 1000]
type     = U
movetype = A
physics  = N
ctrl     = 0
anim     = 1000
juggle  = 4
sprpriority = -3
poweradd = 20


[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = animelemtime(2) = 0
value = 1000,0


;***********************************
[State 1000, Projectile]
type = Projectile
triggerall = NumProjID(1000) = 0 && NumProjID(1001) =0
trigger1 = animelem >= 4
projanim = 4020
projhitanim = 4021
projscale = 1,1
velocity = 2,-2
accel = 0,0.08+(Time/30)
offset = -5,-60
postype = p1         ;p2,front,back,left,right
hitflag = MAFPD
guardflag = MA
attr = S, SP
damage = ceil(72*fvar(0)*fvar(1)), ceil(10*fvar(0)*fvar(1))
getpower = 30,15
animtype = medium
pausetime = 0, 10
hitsound = S200,7                 ;Time attacker pauses, time opponent shakes
guardsound        = s120,0
sparkno = -1
guard.sparkno = -1                    ;Spark anim no (Def: set above)
sparkxy = -20, -50               ;X-offset for the "hit spark" rel. to p2,
;Y-offset for the spark rel. to p1
ground.type = High               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 16             ;Time that the opponent slides back
ground.hittime  = 16             ;Time opponent is in hit state
ground.velocity = -3,0           ;Velocity at which opponent is pushed     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.velocity = -3,-0           ;X-velocity at which opponent is pushed,
fall = 0
fall.recover = 1
air.fall = 0
air.fall.recover = 1
palfx.time = 2
palfx.mul = 80, 200, 142
projedgebound = 80
projstagebound = 80
projID = 1000

[State 200, ヒット時ゲージ]
type = PowerAdd
trigger1 = MoveHit
value = 0




;***********************************
[State 1000, ステート変更]
type = ChangeState
triggerall = (StateType != A)
trigger1 = AnimTime = 0
value = 0
ctrl = 1


