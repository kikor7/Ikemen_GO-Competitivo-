
;--| 基本情報 |---------------------------------------------------------------

[Info]
Name         = "biollente"
DisplayName  = "biollente"
VersionDate  = 27,10,2011
MugenVersion = 04,14,2002
Author       = "furikake"
Pal.Defaults = 1,4,7,10


;-----------------------------------------------------------------------------

[Files]
movelist = movelist.dat
Cmd      = biollente.cmd      ;コマンドファイルの登録
Cns      = biollente.cns      ;コンスタンツファイルの登録
St       = biollente.cns      ;｝
St0      = Normal.cns  ;｝
St1      = Special.cns        ;｝ステートファイルの登録・最大１１個まで増やせます
St2      = SuperArts.cns        ;｝（St,St0,St1,St2,St3,St4,St5,St6,St7,St8,St9）
St3      = -2.cns      
St4      = ;   ;｝「St」のみ必要な項目なので省略出来ません
St5      = ;state/SuperArts.cns ;｝
St6      = ;state/Helper.cns    ;｝
StCommon = common1.cns         ;コモンステートファイルの登録
Sprite   = biollente.sff      ;複数のＰＣＸ画像をまとめたスプライトファイルの登録
Anim     = biollente.air      ;アニメーションファイルの登録
Sound    = biollente.snd      ;複数のＷＡＶＥ音声をまとめたサウンドファイルの登録

;--| カラーパレットファイル |-------------------------------------------------


