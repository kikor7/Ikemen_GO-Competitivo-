[State 1259, Ledge]
type = ChangeState
trigger1 = NumHelper(100000) > 0
trigger1 = helper(100000),var(3) != 0
trigger1 = Vel Y >= 0
trigger1 = playerID(var(15)),StateNo != 950 ;Don't grab if the nearest player is grabbing the ledge.
trigger1 = facing = helper(100000),var(4) ;Only grab if we're facing the same direction!
value = 950

[State 1259, Shaking]
type = EnvShake
trigger1 = AnimElem = 10
freq = 100
ampl = -3
time = 60

;Set proper state type.
[State 1259, Stand]
type = StateTypeSet
trigger1 = Pos Y >= 0
statetype = S

[State 1259, Air]
type = StateTypeSet
trigger1 = Pos Y < 0
statetype = A

[State 1020, Scream]
type = PlaySnd
trigger1 = Time = 0
value = 1020,0
;Controllable jump.
[State 1259, MoveFwd]
type = VelSet
trigger1 = Vel Y != 0
trigger1 = Command = "holdfwd"
X = IfElse(Vel X < Const(velocity.jump.fwd.x)*0.5, Vel X+0.3, Const(velocity.jump.fwd.x)*0.5)

[State 1259, MoveBack]
type = VelSet
trigger1 = Vel Y != 0
trigger1 = Command = "holdback"
X = IfElse(Vel X > -Const(velocity.jump.fwd.x)*0.5, Vel X-0.3, -Const(velocity.jump.fwd.x)*0.5)

;Don't move.
[State 1259, VelCancel]
type = VelMul
trigger1 = Vel Y != 0
trigger1 = Command != "holdfwd"
trigger1 = Command != "holdback"
trigger1 = Vel X != 0
X = IfElse(Abs(Vel X) > 50.3, fvar(3), 0)

