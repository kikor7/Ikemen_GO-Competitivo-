; Definition file for Kung Fu Man
; Contains all the filenames needed for the character

; Player information
[Info]
name = "spooo"        ;Name of character
displayname = "spooo" ;Name of character to display
versiondate = 04,14,2002    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "souken"         ;Character author name
pal.defaults =              ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd     = spooo.cmd.cns   ;Command set
cns     = spooo.cns   ;Constants
st      = spooo.cns   ;States
st1     = N-CNS.cns   ;í èÌãZ
st2     = S-CNS.cns   ;ïKéEãZ
st3     = H-CNS.cns   ;í¥ïKãZ
stcommon = spooocommon.cns ;Common states
sprite  = spooo.sff   ;Sprite
anim    = spooo.air   ;Animation
sound   = spooo.snd   ;Sound
pal1    = spoo2.act  ;Palettes (can have up to 12)
pal2    = spoo2.act  ;Palettes (can have up to 12)
pal4    = spoo.act  ;Palettes (can have up to 12)



; Arcade mode
[Arcade]
;intro.storyboard = intro.def
;ending.storyboard = ending.def
