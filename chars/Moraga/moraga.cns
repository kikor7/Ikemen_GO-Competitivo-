;ハイジ??プ
[Statedef 199]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 199, 1]
type = PlaySnd
trigger1 = Time = 0
channel = 1
value = 200,0

[State 199, 2]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(command = "holdfwd",const(velocity.jump.fwd.x)*1.7,ifelse(command = "holdback",const(velocity.jump.back.x)*1.2,0))
y = const(velocity.jump.y)*1.1

[State 199, 3]
type = afterimage
trigger1 = AnimTime = 0
time = 300
TimeGap  = 1
length = 12
palcolor = 200
palBright   =   0, 20,180
palContrast = 150,220,255
palAdd      = -150,-70,-50
palMul      =   1,  1,  1
trans = none

[State 199, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = RoundsExisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = RoundsExisted = 0
fvalue = 0

[State 5900, 3] ;Intro for round 1
type = ChangeState
trigger1 = RoundNo = 1
trigger2 = RoundsExisted = 0
trigger2 = TeamMode = Turns
trigger2 = RoundNo > 0
value = 190

