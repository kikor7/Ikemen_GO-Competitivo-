;---------------------------------------------------------------------------
; FIN SUPER SCREEN
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]
; Super BG (por B-kun)
[State -2, Helper]
type = Helper
triggerall = WinKO && !var(20)
trigger1 = movehit
trigger1 = stateno=3600
name = "SuperKO"
ID = 8040
stateno = 8040
supermovetime = 99999
pausetime = 99999
ignorehitpause = 1

[State -2, Helper]
type = Helper
triggerall = WinKO && !var(20)
trigger1 = movehit
trigger1 = stateno=1000||stateno=1005||stateno=1010||stateno=1030||stateno=2100||stateno=2200
name = "SuperKO2"
ID = 8045
stateno = 8045
supermovetime = 99999
pausetime = 99999
ignorehitpause = 1

[State -2, VarSet]
type = VarSet
trigger1 = WinKO
var(20) = 1

;---------------------------------------------------------------------------
[State -2, Clipboard]
type = DisplayToClipboard
trigger1 = 1
text = "vel(%f,%f)%d %d"
params = Vel X,Vel Y,var(3),RoundState
ignorehitpause = 1
;---------------------------------------------------------------------------
; トレーニングモード
; -アーケードモードの第1戦とVSモードで、ラウンド開始直後にF3を押して
; -パワーを満タンにすると暴発します。
[State -2, Training]
type = VarSet
trigger1 = !var(9)
trigger1 = ctrl
trigger2 = RoundNo > 1
var(9) = 1

[State -2, Training]
type = VarSet
trigger1 = !var(9)
trigger1 = Power >= 3000
trigger1 = RoundNo = 1 && MatchNo = 1 && NumPartner = 0 && NumEnemy = 1
var(9) = 2

[State -2, Training]
type = VarSet
trigger1 = var(9) = 2
var(8) = 3
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]
; 友情パワー
[State -3, Friendship]
type = PowerAdd
trigger1 = NumPartner
trigger1 = ctrl && StateType != A
trigger1 = !partner,Alive && !var(10)
value = 1000

[State -3, Friendship]
type = VarSet
trigger1 = NumPartner
trigger1 = ctrl && StateType != A
trigger1 = !partner,Alive && !var(10)
var(10) = 1

[State -3, Friendship]
type = VarSet
trigger1 = RoundState < 2
var(10) = 0
;---------------------------------------------------------------------------
; 怒り爆発
[State -3, Burst]
type = ChangeState
triggerall = floor(power / 1000) > var(8)
triggerall = RoundState < 3
trigger1 = StateType != A && ctrl
trigger2 = RoundState = 1 && (StateNo = 0 || StateNo = 5900)
value = 810

[State -3, Burst]
type = VarSet
trigger1 = floor(power / 1000) < var(8)
var(8) = floor(power / 1000)
;---------------------------------------

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0