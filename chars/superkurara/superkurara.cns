;================================================
; Constants and state file for Super Kurara
;================================================

[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 60
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 128
IntPersistIndex = 0
FloatPersistIndex = 39

[Size]
xscale = 1
yscale = 1
ground.back = 15
ground.front = 16
air.back = 12
air.front = 12
height = 60
attack.dist = 160
proj.attack.dist = 90
proj.doscale = 0
head.pos = -5, -95
mid.pos = -5, -55
shadowoffset = 0
draw.offset = 0,0

[Velocity]
walk.fwd  = 3.5
walk.back = -3
run.fwd  = 6, 0
run.back = -7,0
jump.neu = 0,-8.3
jump.back = -2.5
jump.fwd = 3
runjump.back = 0,0
runjump.fwd = 0,0
airjump.neu = 0,0
airjump.back = 0
airjump.fwd = 0

[Movement]
airjump.num = 0
airjump.height = 35
yaccel = .45
stand.friction = .85
crouch.friction = .82
;---------------------------------------------------------------------------
Var
0 : 汎用
1 : ジャンプフラグ
2 : ジャンプフラグ
3 : MoveHitTime
4 : MoveGuardedTime
5 : MoveContactTime
6 : 2段ジャンプフラグ(上押しっぱなしチェック)
7 : 2段ジャンプフラグ
8 : 怒り爆発管理
9 : トレーニングモードチェック
;---------------------------------------------------------------------------
; 時間切れ負け
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 182, 1]
type = AssertSpecial
trigger1 = Time < 200
flag = RoundNotOver
;---------------------------------------------------------------------------
; Win States
[Statedef 180]
type = S
ctrl = 0
velset = 0,0

[State 180, 1]
type = ChangeAnim
trigger1 = SelfAnimExist(180)
value = 180

[State 180, VarRandom]
type = VarRandom
trigger1 = Time = 0
v = 10
range = 0,20

[State 180, Win 1] 
type = ChangeState
trigger1 = Time = 1
trigger1 = var(10) = [0,10]
value = 181

[State 180, Win 2] 
type = ChangeState
trigger1 = Time = 1
trigger1 = var(10) = [11,20]
value = 182

;---------------------------------------------------------------------------
; Win 1
[Statedef 181]
type = S
ctrl = 0
anim = 181
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 182 voice]
type = PlaySND
trigger1 = AnimElem =5
value = 180,0

