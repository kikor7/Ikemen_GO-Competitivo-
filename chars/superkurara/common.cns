;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0
velset = 0,0

[State 0, 1]
type = ChangeAnim
trigger1 = Anim != 0 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10
velset = 0,0

[State 10, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
trigger1 = vel x &&  Anim != [20,21]
value = 20+(vel x < 0)

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
velset = 0,0

[State 40, 2]
type = Turn
trigger1 = NumEnemy && Time = 0 && PrevStateNo != [100,101]
trigger1 = (enemynear,Pos X - Pos X) * facing < 0

[State 40, 2]
type = VarSet
trigger1 = Time = 1
sysvar(1) = ifelse(command = "holdfwd",1,ifelse(command = "holdback",-1,0))

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(6) = 1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(7) = 0

[State 40, 4]
type = VarSet
trigger1 = Time = 0
trigger1 = PrevStateNo = 100
var(1) = 1

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(2) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(2) = 1

[State 40, 6]; ジャンプ・小ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 40, 7]; 中ジャンプ・大ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1)
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 4.5, -4))

[State 40, 8]; ジャンプ・大ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = !var(2)
y = const(velocity.jump.y)

[State 40, 9]; 小ジャンプ・中ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(2)
y = -5.5

[State 40, 10]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; AirJump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
anim = 51
velset = 0,0

[State 40, 4]
type = NotHitBy
trigger1 = 1
value = SCA

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(7) = 1

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = ifelse(command = "holdfwd",1,ifelse(command = "holdback",-1,0))

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(2) = 0

[State 40, 5]
type = VarSet
trigger1 = command != "holdup"
var(2) = 1

[State 40, 6]; ジャンプ・小ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1) = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 40, 7]; 中ジャンプ・大ジャンプX軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(1)
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 4.5, -4))

[State 40, 8]; ジャンプ・大ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = !var(2)
y = const(velocity.jump.y)

[State 40, 9]; 小ジャンプ・中ジャンプY軸速度設定
type = VelSet
trigger1 = AnimTime = 0
trigger1 = var(2)
y = -5.5

[State 45, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1
;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 1]
type = AfterImage
trigger1 = Time = 0
trigger1 = var(1) && Vel X && PrevStateNo != 45
time = 10
length = 10
framegap = 3
palcontrast = 160,160,160
paladd = 0,0,0
palmul = 1,1,1

[State 50, 2]; ジャンプ・大ジャンプアニメ設定
type = ChangeAnim
trigger1 = Time = 0
trigger1 = !var(2)
value = ifelse(vel x = 0 || PrevStateNo = 45,41,ifelse(vel x > 0,42,43))

[State 50, 2]; 小ジャンプ・中ジャンプアニメ設定
type = ChangeAnim
trigger1 = Time = 0
trigger1 = var(2)
value = 48
;---------------------------------------------------------------------------
; Jump Land
[Statedef 52]
type    = S
physics = S
ctrl = 0
anim = 47
velset = 0,0

[State 52, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 52, 2]
type = CtrlSet
trigger1 = !var(2) && Time = 1
trigger2 = var(2) && time = 9
value = 1

[State 52, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;RUN FORWARD
[Statedef 100]
type    = S
physics = N
anim = 100
sprpriority = 1
ctrl = 1

[State 100, snd]
type = PlaySnd
trigger1 = Time = 1
value = s100, 0

[State 100, 1]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 2]
type = VelSet
trigger1 = Time = 0
x = const(velocity.run.fwd.x)

[State 100, 3]
type = VelMul
trigger1 = Time = 0
x = .8

[State 100, 4]
type = ChangeState
trigger1 = AnimElem = 5
value = 101
;-----------------------------------------------------------------------
;RUN FORWARD [Land]
[Statedef 101]
type    = S
physics = S
anim = 101
sprpriority = 1
velset = 0,0

[State 100, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; RUN_BACK
;---------------------------------------------------------------------------
; Recuperacion tras esquivar/rodar: sin control y golpeable unos frames,
; para que no se pueda encadenar sin riesgo.
;---------------------------------------------------------------------------
[Statedef 1002]
type = S
movetype = I
physics = S
ctrl = 0
anim = 0
velset = 0,0

[State 1002, Fin de la recuperacion]
type = ChangeState
trigger1 = Time >= 8
value = 0
ctrl = 1

[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105
sprpriority = 1
velset = 0,0

[State 105, 1]
type = NotHitBy
trigger1 = 1
value = SCA

[State 105, 1]
type = VelSet
trigger1 = AnimElem = 2
x = const(velocity.run.back.x)

[State 105, 2]
type = VelAdd
trigger1 = AnimElem = 2,> 0 && AnimElem = 12,< 0
x = .23

[State 105, 2]
type = VelSet
trigger1 = AnimElem = 12
x = 0

[State 105, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 1002
ctrl = 0
;---------------------------------------------------------------------------
; HIT_FALLRECOVER (still falling)
[Statedef 5200]
type    = S
movetype= H
physics = N
anim = 5200+(command="holdfwd")
velset = 0,0

[State 50, 1]
type = AfterImage
trigger1 = Time = 0
time = 10
length = 10
framegap = 3
palcontrast = 160,160,160
paladd = 0,0,0
palmul = 1,1,1

[State 5200, 1]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5200, 2]
type = VelSet
trigger1 = Time = 0
x = ifelse(command="holdfwd",4,-4)

[State 5200, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
; HIT_AIRFALLRECOVER
[Statedef 5210]
type    = A
movetype= I
physics = N
anim = 5210
velset = 0,0
ctrl = 0

[State 5210, 1] ;Blink white
type = PalFX
trigger1 = Time = 0
time = 3
add = 128,128,128 ;256,256,256

[State 40, 4]
type = NotHitBy
trigger1 = 1
value = SCA

[State 40, 4]
type = VarSet
trigger1 = Time = 0
var(7) = 1

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = ifelse(command = "holdfwd",1,ifelse(command = "holdup",0,-1))

[State 40, 7]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, 4.5, -4))

[State 40, 9]
type = VelSet
trigger1 = AnimTime = 0
y = -5.5

[State 45, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Continue?
[Statedef 5500]
type = S
ctrl = 0
anim = 5300
velset = 0,0

[State 5500, 1] ;Use continue animation if available
type = ChangeAnim
trigger1 = time = 0
trigger1 = SelfAnimExist(5500)
value = 5500

;---------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundno = 1
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundno = 1
fvalue = 0

[State 5900, 3] ;Intro
type = ChangeState
trigger1 = roundno = 1
value = 190

