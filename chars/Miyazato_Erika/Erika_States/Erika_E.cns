;ショーコバウンド
[Statedef 1014]
type    = A
movetype= I
physics = N
anim = 1014
velset = 5,-6.5
movehitpersist = 1

[state a]
type = VelAdd
trigger1 = time > 0
y = 0.2

[state a]
type = ChangeState
trigger1 = vel Y > 0
trigger1 = pos Y >= 0
value = 1014

[state a]
type = ParentVarSet
trigger1 = movehit
var(14) = 1000*floor(parent,var(14)/1000)+parent,var(14)%10
ignorehitpause = 1

[state a]
type = ParentVarSet
trigger1 = movehit
trigger1 = !parent,numtarget
trigger1 = frontedgedist < -66
var(14) = 1000*floor(parent,var(14)/1000)+10*(parent,var(25)%100)+parent,var(14)%10
persistent = 0

[state a]
type = DestroySelf
trigger1 = frontedgedist < -66

