;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;                             基礎データ
;━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
;--------------------------------------------------------------------------
;  0 =
;  1 =
;　2 = 生存判別用
;　3 = 
;　4 = 多段攻撃用ステート内変数
;　5 = ステート内変数（投げ,Bエスケープ,受身）
;  6 = 
;  7 = VarRandom
;  8 = カウンター
;  9 =
; 10 = 持続速度系制御
; 11 = Invalid Combo判別
; 12 = 宮里軍団招聘不可時間 [ショーコ<3>,サキ<3>]
; 13 = PrevAnim
; 14 = movehit+ [経過F,本体hitpause,ヒット数調整<2>,1F間のヒット数]
; 15 = ハイジャンプ制御
; 16 = 
; 17 = ダッシュ系コマンド制御
; 18 = 地上BダッシュAnimElemTime(2),コンボ中Bダッシュ回数,残像制御
; 19 = AnimElemTime(1)改
; 20 = バウンド制限
; 21 = コマンド先行入力 [cmdbuftime,同時押しコマンド無効化,コマンド<2>,方向キー]
; 22 = 画面端ノックバック
; 23 = 
; 24 = 空中ジャンプ制御
; 25 = ヒット数
; 26 = 
; 27 = 
; 28 = 相手リバーサル投げ無敵時間
; 29 = BIGBANG MODE 残りF
; 30 = ダメージ量算出
; 31 = 
; 32 = 
; 33 = 直前ガード
; 34 = Bストーン管理 [敵獲得分,限度超個数(小)<2>,限度超個数(大)<2>]
; 35 = 
; 36 = Bストーン･対応用 [P2対応,1P側]

; 43 = [AI(オートガード)] 立ち下段認識
; 44 = [AI(オートガード)] 地上中段認識

; 54 = 勝敗,KOサウンド
; 55 = 
; 56 = 
; 57 = 各種設定 [技性能,Bストーン表示,エフェクト制限,補正表示,(勝利演出),ボイス]
; 58 = ゲージ＆カウンター表示
; 59 = AI判定

; f(0) = 補正値
; f(1) = 逆根性値補正
; f(2) = ヒット数補正
; f(3) = (強制)基底ダメージ補正
; f(4) = 
; f(5) = 
; f(6) = 
; f(7) = Bダッシュ補正

; f(20) = 直前ガード
; f(21) = GameHeight

; channel = 10   ボイス
; channel = 11   ボイス(サキ＆ショーコ)

;--------------------------------------------------------------------------
[Data]
life = 1000
power = 3000
attack = 100
defence = 100
fall.defence_up = 50
liedown.time = 15
airjuggle = 15
sparkno = -1
guard.sparkno = -1
KO.echo = 0
volume = 100
IntPersistIndex = 43,59
FloatPersistIndex = 39

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 15    ;Player width (front, ground)
air.back = 15        ;Player width (back, air)
air.front = 15       ;Player width (front, air)
height = 70          ;Height of player (for opponent to jump over)
attack.dist = 320    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 0,-85     ;Approximate position of head
mid.pos = 0,-50      ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 2.5           ;Walk forward
walk.back = -2.0          ;Walk backward
run.fwd  = 9.0,-1.4       ;Run forward (x, y)
run.back = -5.0,-4.2      ;Run backward (x, y)
jump.neu = 0,-11.0        ;Neutral jumping velocity (x, y)
jump.back = -2.5          ;Jump back Speed
jump.fwd = 2.75           ;Jump forward Speed
airjump.neu = 0,-11.0
airjump.back = -2.5       ;Air jump speeds (opt)
airjump.fwd = 2.75

[Movement]
airjump.num = 1       ;Number of air jumps allowed (opt)
airjump.height = 5    ;Minimum distance from ground before you can air jump (opt)
yaccel = .6           ;Vertical acceleration
stand.friction = .85   ;Friction coefficient when standing
crouch.friction = .85  ;Friction coefficient when crouching

