[Statedef 510]
type    = S
physics = N
anim = 510
velset = 0,0
ctrl = 0
sprpriority = 1

;---------------------[]
[state a];はあっ、とうっ、えいっ
type = PlaySnd
trigger1 = var(57)%10 > 0
trigger1 = time = 3
trigger1 = Random%2 = 0
value = 20,ifelse(Random%3=0,0,1+Random%3)
volume = 150
channel = 10
persistent = 0

[state a]
type = PlaySnd
trigger1 = time = 15
value = 0,7
persistent = 0

[state a]
type = PlaySnd
trigger1 = time >= 43
trigger1 = (time-43)%12 = 0
value = 510,2

;---------------------[Test Mode]
[state a]
type = VarSet
triggerall = var(59) <= 0
triggerall = RoundState = 2
trigger1 = command = "s"
var(59) = -2+(var(59)=[-4,-3])-(var(59)=-2)

[state a]
type = VarSet
triggerall = var(59) <= 0
triggerall = RoundState = 2
trigger1 = (command = "s") && (command = "z")
var(59) = -4

[state a]
type = PlaySnd
triggerall = var(59) <= 0
triggerall = RoundState = 2
trigger1 = command = "s"
value = 0,9

[state a]
type = Helper
triggerall = var(59) <= 0
triggerall = RoundState = 2
trigger1 = command = "s"
name = "Shine"
ID = 6511
pos = 0,-50
postype = p1
stateno = 6510
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

;---------------------[ヘルパー]
[state a]
type = Helper
trigger1 = time = 2
name = "chargeC"
ID = 6025
pos = 0,-5
postype = p1
stateno = 6025
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1
persistent = 0

[state a]
type = Helper
trigger1 = time = 14
name = "charge1"
ID = 6020
pos = 2,-5
postype = p1
stateno = 6020
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[state a]
type = Helper
trigger1 = time >= 43
trigger1 = (time-43)%12 = 0
name = "charge2"
ID = 6021
pos = 0,10
postype = p1
stateno = 6021
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1

[state a]
type = PowerAdd
triggerall = Power != PowerMax
trigger1 = time > 42
trigger1 = time%2 = 1
value = 10+10*(time%10=9)

[state a]
type = ChangeState
triggerall = var(59) <= 0
triggerall = !((var(59) < -1) && (command = "holdy"))
trigger1 = time >= 42
value = 0
ctrl = 1

;---------------------------------------------------------------------------
; Bカウンター
[Statedef 530]
type    = S
movetype= A
physics = S
anim = 530
velset = 0,0
ctrl = 0
poweradd = -1000

[state a]
type = NotHitBy
trigger1 = AnimElemTime(7) < 0
value = SCA
ignorehitpause = 1

[state a];なめんじゃないよ！
type = PlaySnd
trigger1 = var(57)%10 > 0
trigger1 = time = 0
value = 21,0
volume = 150
channel = 10
persistent = 0

[state a]
type = PlaySnd
trigger1 = time = 0
value = 0,8
persistent = 0

[state a]
type = PlaySnd
trigger1 = time = 0
value = 0,9
persistent = 0

[state a]
type = PlaySnd
trigger1 = AnimElemTime(5) = 0
value = 1,176
persistent = 0

[state a]
type = PlaySnd
trigger1 = AnimElemTime(5) = 0
value = 1,184
persistent = 0

[state a]
type = VarAdd
trigger1 = time = 3
var(29) = -189
persistent = 0

[State 530]
type = HitDef
triggerall = ifelse(enemynear,ID=enemy,ID,var(20)%10<3,var(20)/10%10<3)||enemynear,statetype=L&&ifelse(enemynear,ID=enemy,ID,var(20)/10%10<3,var(20)%10<3)
triggerall = !movecontact && !movereversed
trigger1 = AnimElemTime(6) >= 0
trigger1 = AnimElemTime(8) < 0
attr = S,HA
hitflag = MAF
guardflag = M
animtype = Hard
ground.type = High
priority = 6,Hit
damage = ifelse(floor(10*fvar(0))>1,floor(10*fvar(0)),1),0
getpower = 0,0
givepower = 0,0
pausetime = 11+(enemynear(var(2)),movetype=A),10+(enemynear(var(2)),movetype=A)
guard.pausetime = 11,10
hitsound = s4,2
guardsound = s3,0
guard.slidetime = 9
air.hittime = 18
guard.hittime = 17
guard.ctrltime = 18
fall = 1
yaccel = 0
ground.velocity = -17.5,0
guard.velocity = -5.7
air.velocity = -17.5,0
fall.xvelocity = 0
fall.yvelocity = 0
fall.recover = 0
down.bounce = 1
ground.cornerpush.veloff = 0
maxdist = 10000,0
p2facing = 1
ID = 530
kill = 0

[state a]
type = TargetState
trigger1 = numenemy = 1
trigger1 = movehit = 1
trigger2 = numenemy = 2
trigger2 = movecontact = 1
ID = 530
value = 5720
ignorehitpause = 1
persistent = 0

[state a]
type = EnvShake
trigger1 = movecontact = 1
time = 5
freq = 180
ampl = 2
ignorehitpause = 1
persistent = 0

[state a]
type = Helper
trigger1 = time = 0
name = "Shine"
ID = 6511
pos = 0,-50
postype = p1
stateno = 6510
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1
persistent = 0

[state a]
type = Helper
trigger1 = movehit && numtarget
trigger1 = var(34) := var(34)+201
name = "hit"
ID = 7100
pos = floor((p2dist X+p2bodydist X)/2)+10,floor(p2dist Y/2)-50-Random%16
postype = p1
stateno = 7100
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1
persistent = 0

[state a]
type = Helper
trigger1 = moveguarded
name = "Guard"
ID = 7200
pos = -7,-44-Random%16
postype = p2
facing = -1
stateno = 7200
ownpal = 1
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1
persistent = 0

[state a]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

