[Info]
name = "Miyazato Erika"        ;Name of character
displayname = "MIYAZATO Erika" ;Name of character to display
versiondate = 05,01,2013    ;Version date of character (MM-DD-YYYY)
mugenversion = 04,14,2002   ;Version of M.U.G.E.N character works on
author = "Songfu"         ;Character author name
pal.defaults = 1      ;Default palettes in order of preference

[Files]
movelist = movelist.dat
cmd      = Erika_States/Erika.cmd		;Command set
cns      = Erika_States/Erika_N.cns		;Constants
st       = Erika_States/Erika_N.cns		;States
st1      = Erika_States/Erika_H.cns		;Super&Hyper Moves
st2      = Erika_States/Erika_A.cns		;-2 state
st3      = Erika_States/Erika_E.cns		;Helper
st4      = Erika_States/BBBR_Helper.cns		;Common Helper
st5      = Erika_config.txt
stcommon = Erika_States/Erika_C.cns		;Common states
sprite   = Media/Erika.sff			;Sprite
anim     = Media/Erika.air			;Animation
sound    = Media/Erika.snd			;Sound
pal1     = Act/Erika01.act			;Palettes
pal2     = Act/Erika02.act
pal3     = Act/Erika03.act
pal4     = Act/Erika04.act

[Arcade]
intro.storyboard = ;intro.def
ending.storyboard = ;ending.def
