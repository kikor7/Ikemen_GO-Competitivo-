[Statedef 1071]
type    = A                      ;キャラクターの状態　　[S-直立 / C-しゃがみ / A-空中 / L-ダウン]
movetype= A                      ;動作の種類　　[I-どちらでもない / A-攻撃 / H-やられ状態]
physics = N                      ;影響される重力＆加速度: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
