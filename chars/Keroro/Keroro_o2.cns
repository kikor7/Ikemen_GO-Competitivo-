type = HitDef                     ;攻撃判定です
trigger1 = time%5 = 0
attr = S, SA                     ;攻撃の種類, 属性　[S/C/A], [N/S/H][A/T/P] 
damage    = 23,25                   ;与えるダメージ, ガード時のダメージ 
animtype = Light                 ;攻撃の強さ　[Light/Medium/Hard/Back] 
getpower = 8,4;自分のパワー増分, ガード時のパワー増分 
