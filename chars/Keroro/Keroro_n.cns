;-----------------------
;地上・切り
[Statedef 200]
type    = S                      ;キャラクターの状態　　[S-直立 / C-しゃがみ / A-空中 / L-ダウン]
movetype= A                      ;動作の種類　　[I-どちらでもない / A-攻撃 / H-やられ状態]
physics = S                      ;影響される重力＆加速度: S-stand, C-crouch, A-air
juggle  = 1                      ;Number of air juggle points move takes
velset = 0,0                     ;キャラクターの移動状況
ctrl = 0                         ;コントロール不能か否か。基本的に0
anim = 200                       ;呼び出すアニメ番号
poweradd = 0                    ;パワーの増加値

[State 200 , 1]
type = HitDef                     ;攻撃判定です
trigger1 = AnimElem = 2          ;２枚目から以下の設定を有効に
attr = S, NA                     ;攻撃の種類, 属性　[S/C/A], [N/S/H][A/T/P] 
damage    = 30,35                   ;与えるダメージ, ガード時のダメージ 
animtype = Light                 ;攻撃の強さ　[Light/Medium/Hard/Back] 
getpower = 30,15;自分のパワー増分, ガード時のパワー増分 
givepower = 20,5                 ;相手のパワー増分, ガード時のパワー増分 
guardflag = LHA                    ;ガード可能な状態の指定　[H/L/A/M(HL)/MA] 
hitflag = HMLA                    ;攻撃が当たる状態の指定[H/M/L/A/F/D]
priority = 4, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default 相打ち時の優先順位
pausetime = 6,8                  ;フリーズ時間（自分）,フリーズ時間（相手） 
numhits = 1                      ;Number of hits to count as (Def: 1)
              ;攻撃が当たった時のエフェクトの位置
hitsound = s0,2                 ;攻撃が当たった時になる音の指定
guardsound = s0,3             ;相手がガードした時に鳴らす音 
sparkno = s100000                     ;攻撃Hit時に表示させるヒットスパークの指定
sparkxy = -10,-45            ;ヒットスパークの表示位置の指定
ground.type = High               ;地上にいる相手に攻撃が当たった時の相手の動作　[High/Low/Trip/None] 
ground.slidetime = 3             ;相手を後ずさりさせる時間 
ground.hittime  =  30             ;相手をヒット状態に保持する時間 
ground.velocity = -3             ;相手が地上にいる時に攻撃がヒットした場合の相手に与える初速度
airguard.velocity = -1         ;相手が空中にいる時にガードされた場合の相手に与える初速度
air.velocity = -1.3,0           ;相手が空中にいる時に攻撃がヒットした場合の相手に与える初速度
;fall = 1                        ;攻撃命中時、相手が空中復帰させない
;fall.recover = 0                ;リカバリー不能にさせる

