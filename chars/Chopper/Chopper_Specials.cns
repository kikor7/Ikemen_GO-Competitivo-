;-------------------------------------------------------------------------------
; Poción de Veneno - lanzamiento desde el piso
[Statedef 1050]
type    = S
movetype= A
physics = N
ctrl = 0
anim = 1050
sprpriority = 2
Juggle = 0


[State 200, 2]
type = PlaySnd
trigger1 = time = 0
trigger2 = time = 10
trigger3 = time = 20
trigger4 = time = 30
trigger5 = time = 40
trigger6 = time = 50
value = 0, 0
volume = 100
channel = 5



[State VarAdd - GIRAR]
type = Varadd
trigger1 = time >= 0
v = 10
value = -25
[State 0, AngleDraw]
type = AngleDraw
trigger1 = time >= 0
value = var(10)
scale = 0.4,0.4
Ignorehitpause = 1


[State 0, VelSet]
type = VelSet
trigger1 = time = 0
x = ifelse(prevstateno = 1050,-4,2+(random%3))
y = ifelse(prevstateno = 1050,-3,-5)

[State 0, VelAdd]
type = VelAdd
trigger1 = TIME >= 0
y = 0.3



[State 210, 1]
type = HitDef
triggerall = time > 1
trigger1 = !movecontact
attr = A, SP
animtype  = Light
getpower = 15,7
damage    = 10
guardflag = MA
pausetime = 0,0
sparkno = -1;s6000
guard.sparkno = s7000
sparkxy = -8,-25
hitsound   = S0,5
guardsound = S0,8
ground.type = High
ground.slidetime = 15
ground.hittime  = 15
ground.velocity = -2,0
air.velocity = -2.5,-4


[State 200, Spark CVS]
type = Explod
triggerall = Numexplod(7004) = 0
trigger1 = Movehit = 1
anim = F7004
ID = 7004
postype = P1
pos = 0,0
facing = -1
sprpriority = 2
supermove = 1
removetime = -2
bindtime = 1
ownpal = 1
scale = 0.3,0.3
removeongethit = 1
ontop = 1
supermovetime 	= 999
ignorehitpause  = 1

[State 0, HitOverride]
type = HitOverride
trigger1 = 1
attr = SCA,NP,SP,HP
slot = 1
stateno = 1060
time = 1
Ignorehitpause = 1

[State 1050]
type = NotHitBy
trigger1 = Time >= 0
value = SCA,NA,SA,HA,NT,ST,HT
time = 1

[State 1050]
type = HitBy
trigger1 = Time >= 0
value = SCA,NP,SP,HP
time = 1






;-- Reflect effect ---------

[State 0, Turn]
type = Turn
triggerall = prevstateno = 1050
trigger1 =  time = 0

[State 0, ChangeState]
type = ChangeState
triggerall = prevstateno != 1050
trigger1 = p2name = "Bartholomew Kuma"
trigger1 = p2stateno = 1620
trigger1 = p2bodydist x < 20
trigger2 = p2name = "Monkey D. Luffy"
trigger2 = p2stateno = 1920
trigger2 = p2bodydist x < 20
trigger3 = p2name = "Nico Robin" ;"Spider Net - Mano"
trigger3 = p2stateno = 1505 || p2stateno = 1506
trigger4 = p2name = "Tashigi"
trigger4 = p2stateno = 1610
trigger4 = p2bodydist x < 20
value = 1050
ctrl = 0


[State 210, 1]
type = HitDef
Triggerall = prevstateno = 1050
trigger1 = !movecontact
attr = A, SP
animtype  = Light
getpower = 15,7
damage    = 10
guardflag = MA
pausetime = 0,0
sparkno = -1;s6000
guard.sparkno = s7000
sparkxy = -8,-25
hitsound   = S0,5
guardsound = S0,8
ground.type = High
ground.slidetime = 15
ground.hittime  = 15
ground.velocity = -2,0
air.velocity = -2.5,-4
affectteam = F  ; Friendly Fire after Refelct

;-------------------------






[State 0, StopSnd]
type = StopSnd
Triggerall = time > 10
trigger1 = pos y >= 0
channel = 5

[State 200, End]
type = changestate
Trigger1 = time > 10
trigger1 = pos y >= 0
trigger2 = movecontact = 1
value = ifelse(prevstateno = 1050,1061,1060)



