;===============================================================================
; Lanzamiento de Poción - Stand
;===============================================================================
; lanzamiento de poción de Veneno
[Statedef 1000]
type    = S
physics = S
juggle  = 7
velset = 0,0
ctrl = 0
anim = 1000
sprpriority = 2
poweradd = 20

[State 0, VelSet]
type = VelSet
trigger1 = animelem = 1
x = 7.5

[State 200, 2]
type = PlaySnd
trigger1 = Time = 0
value = 4, 4
volume = 10

[State 3250: Sello]
type		= Helper
trigger1 = animelem = 5
helpertype	= Normal
name		= "Poción"
id		= 1050
pos		= 10,-15
postype		= p1
facing		= 1
stateno		= 1050
keyctrl		= 0
ownpal		= 1
supermovetime	= 0
pausemovetime	= 0
size.xscale     = 1
size.yscale     = 1

[State 0, Velset]
type =  Velset
triggerall = FrontEdgeBodydist <= 100
triggerall = numhelper(1050) = 1
trigger1 = helper(1050), movecontact = 1
trigger2 = helper(1050), movehit = 1
trigger3 = helper(1050), moveguarded = 1
x = -3.5


[State 60, Arena Grande atras]
type = Explod
trigger1 = animelem = 5
anim = F7103
ID =  7103
pos = 5,5
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
removetime = -2
supermove = 1
pausemove =1
scale = 0.3, 0.3
sprpriority = 1
ontop = 0
shadow = 0,0,0
ownpal = 1
removeongethit = 0
ignorehitpause = 1

[State 200, End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

