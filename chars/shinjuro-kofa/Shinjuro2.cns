;---------------------------------------------------------------------------
------------------------------------------------------------------------
; Initialize (at the start of the round)
[Statedef 5900]
type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 5900, 3] ;Change palette
type = RemapPal
trigger1 = 1
source = 1,1
dest = 1,palno

[State 5900, 4] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
value = 190

[State 5900, 5] ;All other rounds
type = ChangeState
trigger1 = 1
value = 0

;-| ゲージ |---------------------------------------------------------
[StateDef 8500]
physics = N
anim = 9999

;====================================== config start
[State ,ストレスメーター表示フラグ]
type = VarSet
trigger1 = Time = 0
var(5) = 1;0
;ignorehitpause = 1

[State ,ガードゲージ表示フラグ]
type = VarSet
trigger1 = Time = 0
var(6) = 1;0
;ignorehitpause = 1

[State ,ストレスメーター表示X座標補正]
type = VarSet
trigger1 = 1
var(0) = 0
;ignorehitpause = 1

[State ,ストレスメーター表示Y座標補正]
type = VarSet
trigger1 = 1
var(1) = 0
;ignorehitpause = 1

[State ,ガードゲージ表示X座標補正]
type = VarSet
trigger1 = 1
var(2) = -50
;ignorehitpause = 1

[State ,ガードゲージ表示Y座標補正]
type = VarSet
trigger1 = 1
var(3) = 20
;ignorehitpause = 1
;====================================== config end

[State ]
type = VarSet
trigger1 = var(5)
trigger1 = RoundState = 1
trigger1 = root,RoundsExisted && Cond(NumPartner,partner,RoundsExisted,1) && Cond(NumEnemy>1,enemy(0),RoundsExisted&&enemy(1),RoundsExisted,enemy(0),RoundsExisted)
var(5) = 5
;ignorehitpause = 1
persistent = 0
[State ]
type = VarAdd
trigger1 = var(5) = [1,4]
trigger1 = RoundState = 1
trigger1 = !root,stateno
var(5) = 1+!NumPartner
;ignorehitpause = 1
persistent = 0
[State ]
type = VarAdd
trigger1 = var(5) = [1,4]
trigger1 = RoundState = 1
trigger1 = NumPartner
trigger1 = !partner,stateno
var(5) = 1
;ignorehitpause = 1
persistent = 0
[State ]
type = VarAdd
trigger1 = var(5) = [1,4]
trigger1 = RoundState = 1
trigger1 = !enemy(0),stateno
var(5) = 1+(NumEnemy<2)
;ignorehitpause = 1
persistent = 0
[State ]
type = VarAdd
trigger1 = var(5) = [1,4]
trigger1 = RoundState = 1
trigger1 = NumEnemy > 1
trigger1 = !enemy(1),stateno
var(5) = 1
;ignorehitpause = 1
persistent = 0

[State ]
type = VarSet
trigger1 = var(6)
trigger1 = RoundState = 1
