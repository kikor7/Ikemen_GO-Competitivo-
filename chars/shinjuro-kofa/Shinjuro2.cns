[State ]
type = VarSet
trigger1 = Time = 0 && !fvar(0) && root,RoundsExisted
fvar(0) = power
;ignorehitpause = 1

[State ]
type = VarSet
trigger1 = power > fvar(0)
fvar(0) = ifelse(fvar(0)+1000/27>=power,power,fvar(0)+1000/27)
;ignorehitpause = 1

[State ]
type = VarSet
trigger1 = fvar(0) > power
fvar(0) = ifelse(fvar(0)-62.375<=power,power,fvar(0)-62.375)
;ignorehitpause = 1

[State ]
type = VarSet
trigger1 = Time = 0 && fvar(0) >= 3000 && root,RoundsExisted
var(7) = 13
;ignorehitpause = 1

[State ]
type = Explod
trigger1 = var(5)
trigger1 = root,var(2) > 1
trigger1 = IsHelper(8500) && TeamSide = 1
