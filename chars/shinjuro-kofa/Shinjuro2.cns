pos = 0+var(0),ceil(GameHeight)+var(1)
postype = left
bindtime = -1
removetime = -1
supermovetime = -1
pausemovetime = -1
sprpriority = 9
ontop = 1
ownpal = 1
;ignorehitpause = 1
trans = AddAlpha
alpha = 96*(RoundState=[1,3]),256

