;[State -3];■アニメ：あたしと圭ちゃん、相性ばっちり■■
;Type     = changeanim
;Trigger1 = Var(11) = 2
;Trigger1 = time = 1
;Value    = 4300

[State 184, 特殊効果] 
type = AssertSpecial
trigger1 = helper(1760),Var(11) = 0
trigger1 = Time <= 300
trigger2 = helper(1760),Var(11) = 1
trigger2 = Time <= 360
trigger3 = helper(1760),Var(11) = 2
trigger3 = Time <= 180
flag = RoundNotOver




