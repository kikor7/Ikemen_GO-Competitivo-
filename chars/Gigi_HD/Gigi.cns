;-----------------------------------
;SUPER JUMP START
;-----------------------------------
; Jump Start
[Statedef 900]
type    = S
physics = S
anim = ifelse(var(5) = 1,40,44)
ctrl = 0
sprpriority = 1

[State 7000, VarSet]
type = VarSet
trigger1 = Time = 0
v = 11
value = 0

[State 7000, VarSet]
type = VarSet
trigger1 = command = "holdfwd"
v = 11
value = 1

[State 7000, VarSet]
type = VarSet
trigger1 = command = "holdback"
v = 11
value = -1

[State 7000, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 7001
ctrl = 1


;---------------------------------------------------------------------------------------------
;Super Jump

[Statedef 7001]
type = A
physics = A
ctrl = 1
anim = 41
velset = 0,-13

[State 7001, VelAdd]
type = VelAdd
triggerall = Vel X >= -2
trigger1 = command = "holdback"
trigger1 = Anim != 43 && Anim != 48
x = -0.1

[State 7001, VelAdd]
type = VelAdd
triggerall = Vel X <= 2.5
trigger1 = command = "holdfwd"
trigger1 = Anim != 42 && anim != 46
x = 0.25

[State 7001, VelSet]
type = VelSet
trigger1 = Anim = 42 || Anim = 46
trigger1 = Time = [0,5]
x = 4

[State 7001, VelSet]
type = VelSet
trigger1 = Anim = 43 || Anim = 48
trigger1 = Time = [0,5]
x = -3.5

[State 7001, ChangeAnim]
type = ChangeAnim
trigger1 = Var(11) = 0
trigger1 = Time = [0,4]
value = ifelse(var(5)=1,41,45)

[State 7001, ChangeAnim]
type = ChangeAnim
trigger1 = Var(11) = 1
trigger1 = Time = [0,4]
value = ifelse(var(5)=1,42,46)

[State 7001, ChangeAnim]
type = ChangeAnim
trigger1 = Var(11) = -1
trigger1 = Time = [0,4]
value = ifelse(var(5)=1,43,48)

[State 900, jumpsnd]
type = playsnd
trigger1 = time = 1
value = s600,0

[State 7001, AfterImage]
type = AfterImage
trigger1 = time = 0
time = 23
length = 20 ;45
;palcolor = 256
;palinvertall = 1
palbright = 0,0,0
palcontrast = 256,256,256
timegap = 1
framegap = 5
trans = add1

[State 7001, Variavelzinha muito 偀il]
type = VarSet
trigger1 = Time = 0
v = 12
value = 1

;---------------------------------------------------------------------------------------------
;Super Jump

[Statedef 7002]
type    = A
physics = A
ctrl = 1

[State 7005, Vel]
type = VelAdd
triggerall = Vel X >= -2
trigger1 = command = "holdback"
trigger1 = Anim != 43
x = -0.1

[State 7005, Vel]
type = VelAdd
triggerall = Vel X <= 2.5
trigger1 = command = "holdfwd"
trigger1 = Anim != 42
x = 0.25








;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, custom state correction... not as instant as I'd like]
type = changeanim
triggerall = var(5) != 1
trigger1 = anim >= 5000 && anim < 6000
value = anim+1000

[State -2, Debug]
type=displaytoclipboard
trigger1= 1
text="var(19) = %d"; vel y = %f"
params=var(19);, vel y

;[State -2, die when you're dead]
;type = changestate
;triggerall = life = 0
;trigger1 = stateno != 5150
;value = 5150

[State -2, reflection projectile variable fix]
type = varset
trigger1 = stateno > 160
trigger2 = stateno < 120
var(16) = 0

[State -2, reflection projectile variable fix2]
type = varset
trigger1 = stateno > 160
trigger2 = stateno < 120
var(19) = 0


[State -2, reflection projectile]
type = projectile
triggerall = life > 0
triggerall = numprojID(13000)=0
trigger1 = var(16) = 10 && time > 2
projID = 13000
projanim = 13000
projhitanim = 13001
projpriority = 1
projheightbound = -240, 100
projedgebound = 100
projscreenbound = 100
projshadow = 0
offset = 50, -70
sparkno=s7030
;sparkxy = (target,pos x), 0+(target,pos y)
velocity = 4
attr = S, SP
damage   = 75,8
animtype = heavy
guardflag = MA
hitflag = MAFDP
pausetime = 18,18
hitsound   = s800,1
guardsound = s6,0
ground.type = Low
ground.slidetime = 25
ground.hittime  = 25
ground.velocity = -6
air.animtype = Back
air.velocity = -4,-6
air.juggle = 3
air.fall = 1
down.velocity = -4,-6
down.hittime = 30
down.bounce = 0




;REMOVE BLOCK EXPLODS IF IN A CUSTOM STATE!!!!!
[State -2, Remove block gate air]
type = RemoveExplod
trigger1 = stateno != 132 && stateno != 155
id =  1292

[State -2, Remove block gate hit air]
type = RemoveExplod
trigger1 = stateno != 154
id =  1297

[State -2, Remove crouch block gate hit]
type = RemoveExplod
trigger1 = stateno != 152 ;&& stateno != 130
id =  1296

[State -2, Remove CROUCH block gate]
type = RemoveExplod
trigger1 = stateno != 131 && stateno != 153 ;&& stateno != 153
id =  1291

[State -2, Remove block gate hit]
type = RemoveExplod
trigger1 = stateno != 150
id =  1295

[State -2, Remove block gate]
type = RemoveExplod
trigger1 = stateno != 130 && stateno != 140 && stateno != 120 && stateno != 151
id =  1290

[State -2, Remove block bubble hit air]
type = RemoveExplod
trigger1 = stateno != 154 && stateno != 143
id =  1287

[State -2, Remove block bubble air]
type = RemoveExplod
trigger1 = stateno != 132 && stateno != 155
id =  1282

[State -2, Remove crouch block bubble hit]
type = RemoveExplod
trigger1 = stateno != 152 && stateno != 142
id =  1286

[State -2, Remove CROUCH block bubble]
type = RemoveExplod
trigger1 = stateno != 131 && stateno != 153
id =  1281

[State -2, Remove block bubble hit]
type = RemoveExplod
trigger1 = stateno != 150 && stateno != 141
id =  1285

[State -2, Remove block bubble]
type = RemoveExplod
trigger1 = stateno != 130 && stateno != 140 && stateno != 120 && stateno != 151
id =  1280










;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, ColorVar 1]
;If the color is already red
type = varset
trigger1 = anim = 0 && prevstateno != 52
trigger2 = anim = 7
trigger3 = anim = 47 && p2dist x < 0
trigger4 = anim = 17 && animtime = 0
var(5) = 1

[State -3, ColorVar 2]
;If the color is already blue
type = varset
trigger1 = anim = 1 && prevstateno != 52
trigger2 = anim = 6
trigger3 = anim = 49 && p2dist x < 0
trigger4 = anim = 16 && animtime = 0
var(5) = 0

[State -3, holddown correction for dashing... ugh...]
type = varset
triggerall = prevstateno = 100
triggerall = p2dist x < 0
trigger1 = command = "holddown"
;trigger2 = command = "Jump"
var(5) = ifelse(var(5) = 1,0,1)


[state 130, varset]
type = varset
triggerall = stateno = 130 || stateno = 131 || stateno = 132
trigger1 = time = 1
var(19) = life

[state 140, varset]
type = varset
triggerall = stateno = 140
trigger1 = time = 1
var(19) = life


[State -3, block bubble]
type = Explod
triggerall = var (5) = 1
triggerall = numexplod(1280) = 0
trigger1 = stateno =  130 && time = 1
trigger2 = stateno = 140 && time = 1
trigger3 = stateno = 120 && time = 1
trigger4 = stateno = 151 && time = 1
anim = 128
ID = 1280
pos = 0,0
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = -1
vel = 0,0
accel = 0,0
random = 0,0
removetime = -1
supermove
pausemove
