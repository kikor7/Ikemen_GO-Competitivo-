;Spray Can Light
[StateDef 1000]
type = S
physics = S
moveType = A
anim = 1000
ctrl = 0
velset = 0,0
sprPriority = 2
poweradd = 0 * !var(20)
faceP2 = 1

[State 1000, Voice]
type = PlaySnd
trigger1 = AnimElem = 1
value = 0,(Random % 6)
channel = 0

[State 1000, Swing Snd]
type = PlaySnd
trigger1 = Animelem = 2
value = 1, 6

[State 1000, FX]
type = Explod
trigger1 = AnimElem = 2
anim = 1001
ID = 1001
postype = p1
pos = 40,-60
bindtime = -1
sprpriority = 2
ownpal = 1
removeongethit = 1
ignorehitpause = 0
persistent = 0
ontop = 1
scale = .3,.3

[State 1000, HitDef] 
type = HitDef
trigger1 = !var(16) && var(15) < 3
trigger1 = Animelem = 2 || Animelem = 3
attr = S, SA
damage = ceil(ifElse(fvar(11) * 50 < 7, 7, fvar(11) * 50)), 5
priority = 4, hit
animtype = Hard
getpower = 60,30
givepower = 35, 35
guardflag = MA
hitflag = MAF
hitsound = S2,6
guardsound = S130, 0
pausetime = 8,8
guard.pausetime = 10,10
sparkNo = -1 + 0 * (var(33) := 8014)
guard.sparkNo = -1 + 0 * (var(34) := 8000)
sparkXY = -10 + 0 * (var(35) := 105), var(36) := -81
air.animtype = Up
fall.animtype = Up
ground.type = High
air.type = High
ground.slidetime = 18
ground.hittime  = 18
guard.hittime = 18
ground.velocity = -2, -2
air.velocity = -2, -2
guard.velocity = -5
airguard.velocity = -5, 0
airguard.ctrlTime = 16
ground.cornerPush.velOff = 0
guard.cornerPush.velOff = 0
air.cornerPush.velOff = 0
yaccel = .5
fall = 1
fall.recover = 0
forcestand = 0
palFX.time = 50
palFX.add = 150,200,250
palFX.sinAdd= -255,-255,-255,50
envshake.time = 20
envshake.ampl = 4
envShake.freq = 140

[State 1000, StateTypeSet: Idle]
type = StateTypeSet
trigger1 = AnimElemTime(7) >= 0
movetype = I

[State 1000, End]
type = ChangeState
trigger1 = !AnimTime
value = 0
ctrl = 1

