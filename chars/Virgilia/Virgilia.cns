[Data]
life = 1000
attack = 100
defence = 100
power = 5000
fall.defence_up = 50
liedown.time = 9
airjuggle = 15
sparkno = 2
guard.sparkno = 40
KO.echo = 0
volume = 1
IntPersistIndex = 0
FloatPersistIndex = 0

[Size]
xscale = 1
yscale = 1
ground.back = 45   ;Player width (back, ground)
ground.front = 45    ;Player width (front, ground)
air.back = 45        ;Player width (back, air)
air.front = 45       ;Player width (front, air)
height = 165        ;Height of player (for opponent to jump over)
attack.dist = 320    ;Default attack distance
proj.attack.dist = 180 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = 1, -227   ;Approximate position of head
mid.pos = -0, -147   ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y). Recommended 0,0

[Velocity]
walk.fwd  = 2.5      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 9, 0    ;Run forward (x, y)
run.back = -7.6,-10.35 ;Hop backward (x, y)
jump.neu = 0,-15.5;-19.2   ;Neutral jumping velocity (x, y)
jump.back = -4.2,-15.5   ;Jump back Speed (x, y)
jump.fwd = 4.5,-15.5       ;Jump forward Speed (x, y)
runjump.back = -5.2,-17 ;Running jump speeds (opt)
runjump.fwd = 5.5,-17   
airjump.neu = 0,-22.82  
airjump.back = -5.2     ;Air jump speeds (opt)
airjump.fwd = 5.5         ;.
air.gethit.groundrecover = -0.8,-14.25  ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = 0,-14.25    ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,0   ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -5      ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 5       ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = 0       ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 0     ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 0     ;Number of air jumps allowed (opt)
airjump.height = 0   ;Minimum distance from ground before you can air jump (opt)
yaccel = .6;Vertical acceleration
stand.friction = .81  ;Friction coefficient when standing
crouch.friction = .79 ;Friction coefficient when crouching
stand.friction.threshold = 0.1          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = 0.1       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 90           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -10 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -15  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .934    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 25	      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, -5            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = 1.2               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 0          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .1        ;If the player's speed drops below this threshold while lying down, stop his movement

;Default language victory quotes (optional).  **MUGEN 1.0**
;If this section is included, the default language victory quotes must be in English.
[Quotes]
; Up to 100 victory quotes can be specified per language (victory0 - victory99)
victory1 = "Real magic is the power to repair, to revive.\nTo call back happiness which has disappeared, to call back love which has gotten cold.\nAnd it can call back a forgotten smile to a princess' face."
victory2 = "Corpses are fine, we can just revive them anyway."
victory3 = "I'll make you pay in full for bullying these cute rabbits."
victory4 = "Why are kids so bad at waking up these days?"
victory5 = "When you learn that you cannot withstand a siege, you must consider abandoning the castle."
