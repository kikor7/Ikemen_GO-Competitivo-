type = HitDef           ;攻击定义
trigger1=UniqHitCount<=7
attr = S, NA            ;攻击类型(这里表示站立,正常攻击)
getpower = 0           ;击中得Power
givepower = 0          ;击中给敌人Power
damage = 93, 15         ;击中敌人损伤值！（前面是打中，后面是防御）
animtype = Light       ;等级：  Light轻 Medium中 Hard重 Back后退 
guardflag = MA         ;防御方式： 站立MA 蹲下L 空击HA
hitflag = MAF          ;攻击方式： 站立MAF 蹲下MAFD
priority = 24, Hit      ;攻击的优先度，同时作用的话优先度高的有效（这个参数
                        我开始也不明白！最后能过Kyoung的解答后已经知道了！
                        如果两个人同时出招的话，谁的这个值高谁的攻击才会有效）
pausetime = 2, 0       ;击中时停止时间（前面自己,后面敌人）
sparkno = S923         ;击中后的火花（系统默认0,0 到 0,7 可以选择，加上S是使用自己在air中定义的）
guard.sparkno = S907   ;敌人防御的火花
sparkxy = 10,-(25+time/1)
hitsound = s3, 0        ;攻击击中声音（系统黠认5,0 到 5,4）
guardsound = s0, 1      ;敌人防御声音 （系统黠认是 6,0）
ground.type = low     ;击中后敌人的效应（Low正常 High抛高 Trip击倒）
ground.slidetime = 25   ;敌人向后滑后时间
ground.hittime  = 22   ;敌人在地受击状态时间
ground.velocity = 0,-7   ;敌人在地被击后退距离
airguard.velocity = -1.9,-.8   ;敌人在空防御后退抛高距离
air.type = High        ;在空中击中后敌人的效应
p2stateno = 3402
air.velocity = 0,-6 ;;敌人在空被击后退距离
air.hittime = 12       ;敌人在空中受击状态时间
guard.velocity = -2    ;在墙壁击中敌人后自己后退的距离
fall.recover = 0       ;当敌人Fall时不让他受身

