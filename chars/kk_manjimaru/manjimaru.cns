trigger1 = time = 20
value = 0, 29

[State 200, 1]
type = HitDef           ;攻击定义
trigger1 = animelem = 1 ;第4个动作（这里表示第三个动作打中敌人）
attr = S, NA            ;攻击类型(这里表示站立,正常攻击)
getpower = 0           ;击中得Power
givepower = 0          ;击中给敌人Power
damage = 140, 40         ;击中敌人损伤值！（前面是打中，后面是防御）
animtype = Light       ;等级：  Light轻 Medium中 Hard重 Back后退 
guardflag = AL         ;防御方式： 站立MA 蹲下L 空击HA
hitflag = MAF          ;攻击方式： 站立MAF 蹲下MAFD
priority = 22, Hit
pausetime = 0, 0       ;击中时停止时间（前面自己,后面敌人）
sparkno = S923         ;击中后的火花（系统默认0,0 到 0,7 可以选择，加上S是使用自己在air中定义的）
guard.sparkno = S907   ;敌人防御的火花
sparkxy = 10, -45       ;火花的位置X轴,Y轴 (X轴是敌人的)
hitsound = s22, 4        ;攻击击中声音（系统黠认5,0 到 5,4）
guardsound = s0, 1      ;敌人防御声音 （系统黠认是 6,0）
ground.type = low     ;击中后敌人的效应（Low正常 High抛高 Trip击倒）
ground.slidetime = 25   ;敌人向后滑后时间
ground.hittime  = 22   ;敌人在地受击状态时间
ground.velocity = -7,-1   ;敌人在地被击后退距离
airguard.velocity = -1.9,-.7   ;敌人在空防御后退抛高距离
air.type = High        ;在空中击中后敌人的效应
air.velocity = -7,-.5 ;;敌人在空被击后退距离
p2stateno = 3605
air.hittime = 12       ;敌人在空中受击状态时间
guard.velocity = -12    ;在墙壁击中敌人后自己后退的距离
fall.recover = 0       ;当敌人Fall时不让他受身
fall=1

