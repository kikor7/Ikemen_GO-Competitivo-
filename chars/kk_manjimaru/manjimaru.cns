[Data]
life = 1000       ;生命值，一般都是1000，觉得你的人物有特别原因的，就随意增减吧。
power = 1000
attack = 100        ;攻击力，以后设定的伤害数值都会乘上该值作为实际效果，当然是百分比。
defence = 100       ;防御力，越大就是防御力强，对方对己方的伤害效果也会减少。
fall.defence_up = 50     ;被打倒时防御力临时上升的百分比。
liedown.time = 10       ;击倒在地后，躺在地上的时间。
airjuggle = 15        ;空中juggle值
sparkno = 2          ;默认的击中火花号(觉得好像没用)。
guard.sparkno = 40     ;默认的防中火花号。
KO.echo = 0        ;被KO时有没有回声。
volume = 255         ;音量调整(负数就是变轻)。
IntPersistIndex = 60
FloatPersistIndex = 40
;整形/浮点型变量的生存期指标。默认值为60和40，
;如果IntPersistIndex=60则有从0到59排列的60个整形变量，
;而高于60号的变量将不受VarRangeSet控制；不会在rounds或matches中被复位。

[Size]
xscale = 1      ;横向缩放值。
yscale = 1      ;纵向缩放值。
ground.back = 15       ;人物宽度--站立后点。
ground.front = 16      ;人物宽度--站立前点。
;上两个值会确定人物的宽度，在Debug模式下可以看到一条黄线。
;当人物有存在判定(Clsn2)，且没有实现PlayerPush控制语句时，
;双方黄线交叠时会互相弹开。
air.back = 12      ;人物宽度--空中后点。
air.front = 12     ;人物宽度--空中前点。
height = 60       ;人物身高(与对方跳跃过顶有关)。
attack.dist = 160     ;攻击效果距离(与对方摆防御动作有关)。
proj.attack.dist = 90   ;发射弹(Projectiles，常为飞行道具)攻击效果距离。
proj.doscale = 0        ;Projectiles是否也受人物缩放比例影响。
head.pos = -5, -90      ;近似的头部位置
mid.pos = -5, -60       ;近似的中身部位置
shadowoffset = 0       ;影子的垂直偏离象素。
draw.offset = 0,0      ;人物的偏离象素(x,y)。

[Velocity]
walk.fwd  = 2     ;步行前进速度。
walk.back = -1.7    ;步行后退速度。
run.fwd  = 5.6, 0    ;跑步前进速度。
run.back = -4,-4.8   ;跑步后退速度。
;上两个值的y如不是0，则为小跳前进/后退速度。
jump.neu = 0,-11.4      ;正上跳起速度。
jump.back = -3       ;向前跳起速度。
jump.fwd = 2.5          ;向后跳起速度。
;上两个值的y大多不设，即等同于jump.neu的y值
runjump.back = -2.55,-8.1     ;向前跑跳起速度。
runjump.fwd = 4,-8.1       ;向后跑跳起速度。
airjump.neu = 0,-8.1     ;正上空中连跳速度。
airjump.back = -2.55    ;向前空中连跳速度。
airjump.fwd = 2.5     ;向后空中连跳速度。

[Movement]
airjump.num = 0     ;空中能连跳数。
airjump.height = 65     ;空中能启动连跳的最低高度。
yaccel = .55            ;下落加速度。
stand.friction = .85        ;站立摩擦系数。
crouch.friction = .82        ;蹲态摩擦系数。

;---------输了,但还没有死------------------------------------------------------------------
[Statedef 170]
type = S          ;状态：  Ｓ站立 Ｃ蹲下 Ａ空中
ctrl = 0          ;限制行动 ctrl 要设 0
anim = 170        ;执行 AIR檔 动作200
velset = 0,0      ;移动数值设 0

[State 170, 1]
type = NotHitBy    ;表示该动作不能被攻击
trigger1 = 1
value = SCA        ;这个表示站立、空中、蹲下动作
time = 1
;这一段基本的意思是：当敌人用站立、空中、蹲下动作攻击这个动作时不会被击到）

