;------ 轻拳 -----------------
[Statedef 200]    ;动作编号（不要随便定义，因为它是和CMD连在一起用的） 
type    = S       ;状态：  Ｓ站立 Ｃ蹲下 Ａ空中
movetype= A       ;动作：  Ａ攻击 Ｉ不动 Ｈ被打
physics = S       ;物理作用：  Ｓ站立 Ｃ蹲下 Ａ空中
juggle  = 1       ;空中连续攻击次数
velset = 0,0      ;移动数值设 0
ctrl = 0          ;限制行动 ctrl 要设 0
anim = 200        ;执行 AIR檔 动作200
;poweradd = 20     ;增加 Power 数值（使用次招式后自己会增加多少气力）
sprpriority = 2   ;层次（MUGEN中几乎每个地方都会用到这个！~层次的意思基本
;上可以理解是Photoshop等图片软件的层次！数值越大这个物体在的位置越向内！）

[State 210, Width]
type = Width
trigger1 = (AnimElemTime (2) >= 0) && (AnimElemTime (8) < 0)
value = 0,0
;（Kyoung兄解释：有效宽度，这个是很有用的一个参数之一。某个动作发动时，
;因为身体前移。如果不把width加大些的话，一般情况还可以，但是如果靠墙或
;者和对手贴的很近的话，可能就有问题了)

[State 200, 1]          ;编号（可以随便定义）
type = HitDef           ;攻击定义
trigger1 = AnimElem = 4 ;第4个动作（这里表示第三个动作打中敌人）
attr = S, NA            ;攻击类型(这里表示站立,正常攻击)
getpower = 30,15;击中得Power
givepower = 0          ;击中给敌人Power
damage = 78, 0         ;击中敌人损伤值！（前面是打中，后面是防御）
animtype = Light       ;等级：  Light轻 Medium中 Hard重 Back后退 
guardflag = MA         ;防御方式： 站立MA 蹲下L 空击HA
hitflag = MAF          ;攻击方式： 站立MAF 蹲下MAFD
priority = 3, Hit      ;攻击的优先度，同时作用的话优先度高的有效（这个参数
                        我开始也不明白！最后能过Kyoung的解答后已经知道了！
                        如果两个人同时出招的话，谁的这个值高谁的攻击才会有效）
pausetime = 5, 5       ;击中时停止时间（前面自己,后面敌人）
sparkno = S904         ;击中后的火花（系统默认0,0 到 0,7 可以选择，加上S是使用自己在air中定义的）
guard.sparkno = S908   ;敌人防御的火花
sparkxy = 10, -45       ;火花的位置X轴,Y轴 (X轴是敌人的)
hitsound = s0, 34        ;攻击击中声音（系统黠认5,0 到 5,4）
guardsound = s0, 33      ;敌人防御声音 （系统黠认是 6,0）
ground.type = low     ;击中后敌人的效应（Low正常 High抛高 Trip击倒）
ground.slidetime = 25   ;敌人向后滑后时间
ground.hittime  = 22   ;敌人在地受击状态时间
ground.velocity = -6   ;敌人在地被击后退距离
airguard.velocity = -1.9,-.8   ;敌人在空防御后退抛高距离
air.type = High        ;在空中击中后敌人的效应
air.velocity = -1.4,-3 ;;敌人在空被击后退距离
air.hittime = 12       ;敌人在空中受击状态时间
guard.velocity = -4    ;在墙壁击中敌人后自己后退的距离
fall.recover = 0       ;当敌人Fall时不让他受身

[State 200, 2]
type = envcolor                   ;背景变色
trigger1 = win && movehit  ;条件：当win时并且击中敌人时这个变量启用
persistent = 1
ignorehitpause = 1
value = 255, 0, 0                  ;颜色，RGB值
time = 1                    ;效果持续时间
under = 1
darken = 0
supermove = 1

[State 200, 1]
type = PlaySnd         ;播放 SND檔
trigger1 = AnimElem = 2    ;第3个动作时播放
value = 0, 11           ;声音编号

[State 200, 7]
type = ChangeState      ;转换state（完成这个动作进入的动作）
trigger1 = AnimTime = 0 
value = 0               ;动作CNS的编号
ctrl = 1                ;crtl=1表示自己可以行动

