; Constants and scattered through this file, so you may like to
; take a look if would like to learn more about the cns.

[Data]
life = 1050			;Amount of life to start with
power = 5000		;Amount of maximum power
attack = 105		;attack power (more is stronger)
defence = 103		;defensive power (more is stronger)
fall.defence_up = 50	;Percentage to increase defense everytime player is knocked down
liedown.time = 60		;Time which player lies down for, before getting up
airjuggle = 15		;Number of points for juggling
sparkno = 2			;Default hit spark number for HitDefs
guard.sparkno = 40	;Default guard spark number
KO.echo = 0			;1 to enable echo on KO
volume = 0			;Volume offset (negative for softer)
IntPersistIndex = 60	;Variables with this index and above will not have their values
FloatPersistIndex = 40  ;reset to 0 between rounds or matches. There are 60 int variables,
  				;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
  				;If omitted, then it defaults to 60 and 40 for integer and float
  				;variables repectively, meaning that none are persistent, i.e. all
  				;are reset. If you want your variables to persist between matches,
  				;you need to override state 5900 from common1.cns.


[Size]
xscale = 0.45			;Horizontal scaling factor.
yscale = 0.45   		        ;Vertical scaling factor.
ground.back = 45		;Player width (back, ground)
ground.front = 45		;Player width (front, ground)
air.back = 45		;Player width (back, air)
air.front = 45		;Player width (front, air)
height = 60			;Height of player (for opponent to jump over)
attack.dist = 160		;Default attack distance
proj.attack.dist = 90	;Default attack distance for projectiles
proj.doscale = 0		;Set to 1 to scale projectiles too
head.pos = -5, -90	;Approximate position of head
mid.pos = -5, -60		;Approximate position of midsection
shadowoffset = 0		;Number of pixels to vertically offset the shadow
draw.offset = 0,0		;Player drawing offset in pixels (x, y)

[Velocity]
walk.fwd  = 6.0		;Walk forward
walk.back = -6.0		;Walk backward
run.fwd  = 14, -7		;Run forward (x, y)
run.back = -14, -7	        ;Hop backward (x, y)
jump.neu = 0,-17		;Neutral jumping velocity (x, y)
jump.back = -6.0		;Jump back Speed (x, y)
jump.fwd = 6.0		;Jump forward Speed (x, y)
runjump.back = -9.2,-10;Running jump speeds (opt)
runjump.fwd = 9.2,-10	;.
airjump.neu = 0,-10	;.
airjump.back = -6.0	;Air jump speeds (opt)
airjump.fwd = 6.0		;.

[Movement]
airjump.num = 777777777		;Number of air jumps allowed (opt)
airjump.height = 110	;Minimum distance from ground before you can air jump (opt)
yaccel = .8		;Vertical acceleration
stand.friction = .85	;Friction coefficient when standing
crouch.friction = .82	;Friction coefficient when crouching

[Quotes]
victory1 = "Y el ganador esss... EL REY HELADO, ¿¡PUES QUIEN MAS!?"
victory2 = "Guacala de polle, ¡ese escenario olia horrible!"
victory3 = "La diferencia entre tu y yo, est que yo tengo esta asombrosa coronaa ¡¡¡HEHEHEHE!!!"
victory4 = "ahhh, ahhh, nescesito... hacer... mas... ejer...cicio..."
victory5 = "Creo que ahora ire con Marceline... aunque en realidad no estoy seguro de porque."
victory6 = "Te gustaria hacerme compañia en mi castillo... ¡¡¡ESTOY TAAAN SOLO!!!"
victory7 = "Si no fuera por esta barba podriamos habernos divertido aun mas."
victory8 = "¿Haces ejercico?, relmente apestas... AY NO, solo era yo."
victory9 = "Eso fue ivertido, volvamos a hacerlo... Cuando hga menos frio ¡¡¡HAHAHAHAHA!!!"
victory10 = "¡¡¡Y ESA FUE MI HELAAADA IRAAA!!!"
victory11 = "AHAHA, Ahora que te he vencido ire a buscar unas princesitasss."

;---------------------------------------------------------------------------
; Format:
; [Statedef STATENO]
; type = ?      S/C/A/L  stand/crouch/air/liedown
; movetype = ?  I/A/H    idle/attack/gethit
; physics = ?   S/C/A/N  stand/crouch/air/none
; juggle = ?             air juggle points move requires
;
; [State STATENO, ?]     ? - any number you choose
; type = ?
; ...

;---------------------------------------------------------------------------
;Time Over Lose
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

;---------------------------------------------------------------------------
; Win state
[Statedef 180]
type = S

[State 180, 1]
type = Changeanim
trigger1 = Time = 0
value = 180

;---------------------------------------------------------------------------
;Introduction
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190]
type = ChangeState
triggerall = time = 0
trigger1 = p2name = "finn1105" || p4name = "finn1105"
trigger2 = p2name = "Jake el perro" || p4name = "Jake el perro"
trigger3 = p2name = "Jake and Finn" || p4name = "Jake and Finn"
trigger4 = p2name = "Jake The Dog" || p4name = "Jake The Dog"
trigger5 = p2name = "Jake The Magic Dog" || p4name = "Jake The Magic Dog"
value = 191

