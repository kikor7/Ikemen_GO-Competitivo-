type = HitDef
trigger1 = time <205 && time >1
attr = S, HA
damage = 28,15
animtype = Hard
hitflag = MAFD
priority = 4, Hit
pausetime = 0, 4
sparkno = -1 ;ヒットスパーク (デフォルト：[Data]の項目で設定したモノが適用される) 
;guard.sparkno = 40               ;ガードスパーク (デフォルト：[Data]の項目で設定したモノが適用される) 
;sparkxy = -10, 115               ;ヒットスパークの位置（Ｘ軸,Ｙ軸）
