;■かけら集め（ビーム）
[Statedef 3220]
type     = A                     ;キャラの状態を指定（S=立ち・C=しゃがみ・A=空中・L=横に倒れている・U=前のステートの状態を引き継ぐ）
movetype = A                     ;キャラの行動内容を指定（I=何もしない・A=攻撃している・H=攻撃を食らっている）
physics  = N                     ;キャラの物理的な体勢（S=立ち・C=しゃがみ・A=空中・N=重力や摩擦の影響を受けない・U=前のステートの体勢を引き継ぐ）
juggle   = 1                     ;攻撃を当てた時に溜まるジャグルポイントの設定
velset   = 0,0                   ;移動初速度の設定（このステートでは0,0なので移動せず止まります）
anim     = 3211                   ;airファイルの[Begin Action 200]のアニメを使っています
sprpriority = 2                  ;画像表示優先度　数値が多いと手前に、少ないと奥に優先されます


[State 3220, ヒット定義]
type = HitDef                    ;攻撃ヒット定義（Hit Definition）のステートコントローラ
trigger1 = AnimElem >= 1
attr = A, NA                     ;攻撃属性: これは Standing, Normal Attack（立ち通常攻撃）
damage = 25, 1                   ;相手に与えるダメージ（ヒットした時,ガードされた時）
animtype = Light                 ;当たった時の相手のアニメの種類: Light, Medium, Hard, Back, Up, DiagUp (デフォルト：Light)
guardflag = MA                   ;相手が立ち・しゃがみ・空中どのガードが出来るかを決めます（現在はMiddleAir（全部ガードされます））
hitflag = MADF                    ;相手がどの状態の時で攻撃を当てられるかを決めます（現在はMiddleAirFall（立ち・しゃがみ・空中・やられ落下））
priority = 3, Hit                ;攻撃優先度: 0 (最低) 7 (最高) 4がデフォルト・種類はHit/Miss/Dodge (デフォルト：Hit)
pausetime = 8, 20                 ;攻撃を当てた時の自分と相手の硬直時間（自分,相手）
sparkno = s6071                      ;ヒットスパーク (デフォルト：[Data]の項目で設定したモノが適用される) 
guard.sparkno = 40               ;ガードスパーク (デフォルト：[Data]の項目で設定したモノが適用される) 
sparkxy = -10, -38               ;ヒットスパークの位置（Ｘ軸,Ｙ軸）
hitsound = s1, 1                  ;ヒットサウンド（PlaySndと同じやり方）
guardsound = 6, 0                ;ガードサウンド（PlaySndと同じやり方）
ground.type = High               ;当たった時の地上の相手のアニメの属性: High, Low, Trip (デフォルト：High)
ground.slidetime = 12             ;当たった時の地上の相手がのけぞる時間
ground.hittime  = 24             ;当たった時の地上の相手のやられ状態の時間
ground.velocity = -4,0           ;当たった時の地上の相手の初速度（Ｘ軸,Ｙ軸）
airguard.velocity = -1.9,-.8     ;ガードされた時の空中の相手の初速度 (デフォルト：(air.xvel*1.5, air.yvel/2))
air.type = High                  ;当たった時の空中の相手のアニメの属性: High, Low, Trip (デフォルト：ground.typeと同じになる)
air.velocity = -1.4,-3           ;当たった時の空中の相手の初速度（Ｘ軸,Ｙ軸）
air.hittime = 12                 ;当たった時の空中の相手のやられ状態の時間

palfx.time = 20
palfx.add = 50,-50,200
palfx.sinadd = 50,50,0,10
palfx.color = 0
palfx.invertall = 1


envshake.time = 15

[State 3220, VarSet]
type = VarSet
trigger1 = time = 8
fvar(2) = ifelse((root,P2dist x=[0,1]),1,ifelse((root,P2dist x=[-1,0]),-1,root,P2dist x))

[State 3220, VarSet]
type = VarSet
trigger1 = time = 8
fvar(3) = ifelse((root,P2dist y=[0,1]),1,ifelse((root,P2dist y=[-1,0]),-1,root,P2dist y))+20

[State 3220, VelSet]
type = VelSet
trigger1 = time = 8
x = abs(15*cos(atan(fvar(2)/fvar(3))-(.5*pi*ifelse(root,P2dist Y <0,-1,1))))
y = -15*sin(atan(fvar(2)/fvar(3))-(.5*pi*ifelse(root,P2dist Y <0,-1,1)))

[State 3220, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 8
value = s2,4

[State 3220]
type = Afterimage
trigger1 = time= 8
trans = add
TimeGap = 1
FrameGap = 1
time = 30

[State -1]
type = AssertSpecial
trigger1 =1
flag = noshadow

[State 3220, ステート変更]
type = Destroyself
trigger1 = Time = 60

