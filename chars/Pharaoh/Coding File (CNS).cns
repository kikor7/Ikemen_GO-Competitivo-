ground.slidetime = 12
ground.hittime  = 15
ground.velocity = -3,-1
air.velocity = -3,-1
fall = 1
sprpriority = 5
getpower = 20
givepower = 5,0

[State 7001]
type = DestroySelf
trigger1 = Time >= 180
trigger2 = movecontact = 1
ignorehitpause = 1

;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------
;Seeing as you have a copy of common1.cns file in your template folder
;you wont need to override any common states here, instead do it in the
;common1.cns file.

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
;/////////////////////////////////////////////////////

[Statedef -2]

[State -2, Turrent Gun]
type = Helper
triggerall = roundstate = 2
triggerall = NumHelper(7000) = 0
trigger1 = Time = 0
helpertype = normal
name = "Turrent Gun" ; Name of attachment helper.
id = 7000
pos = -10,-95
scale = 2,2
postype = p1
stateno = 7000
keyctrl = 0


[State -2, Turrent Gun]
type = Helper
triggerall = roundstate = 2
triggerall = NumHelper(7003) = 0
trigger1 = Time = 0
helpertype = normal
name = "Turrent Gun 2" ; Name of attachment helper.
id = 7003
pos = -10,-95
postype = p1
stateno = 7003
keyctrl = 0

[State -2]
type = sprpriority
trigger1 = stateno != 233
value = -4

[State -2]
type = Helper
trigger1 = NumHelper(10000) = 0
trigger1 = !lose
ID = 10000
name = "Armor"
pos = 0,0
postype = p1
stateno = 10000
helpertype = normal
keyctrl = 0
ownpal = 1

[State -2]
type = NotHitBy
trigger1 = 1
value = SCA,AA,AT,AP
time = 10000

[state -2]
type = lifeadd
trigger1 = 1
value = ceil((var(1) * -1) * 0.7)
ignorehitpause = 1

[state -2]
type = PalFX
trigger1 = var(1) > 0
time = 2
add = 150,50,50
mul = 256,128,128

[state -2]
type = varset
trigger1 = 1
var(1) = 0
ignorehitpause = 1

[State -2,000]
type = Veladd
triggerall = roundstate = 2
trigger1 = stateno != 191
trigger1 = alive
trigger1 = command = "holdfwd"
trigger1 = Vel X < 1.5
x = 0.5

[State -2,000]
type = Veladd
triggerall = roundstate = 2
triggerall = stateno != 191
trigger1 = alive
trigger1 = Vel X > -1.5
trigger1 = command = "holdback"
x = -0.5

[State -2,000]
type = Veladd
triggerall = roundstate = 2
trigger1 = stateno != 191
trigger1 = alive
trigger1 = Vel Y > -1.5
trigger1 = command = "holdup"
y = -0.15

[State -2,000]
type = Veladd
triggerall = roundstate = 2
trigger1 = stateno != 191
trigger1 = alive
trigger1 = Vel Y < 1.5
trigger1 = command = "holddown"
y = 0.15

[State -2,000]
type = Veladd
triggerall = roundstate >= 2
trigger1 = alive
trigger1 = Pos Y >= 10
trigger2 = Vel Y > 1.5
y = -0.15

[State -2,000]
type = Veladd
triggerall = roundstate >= 2
trigger1 = alive
trigger1 = Pos Y <= -180
trigger2 = Vel Y < -1.5
y = 0.15

[State -2,000]
