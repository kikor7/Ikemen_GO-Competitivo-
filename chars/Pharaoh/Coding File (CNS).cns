triggerall = roundstate >= 2
trigger1 = alive
trigger1 = Vel Y > 0.5
y = -0.01

[State -2,000]
type = Veladd
triggerall = roundstate >= 2
trigger1 = alive
trigger1 = Vel Y < -0.5
y = 0.01

[State -2,000]
