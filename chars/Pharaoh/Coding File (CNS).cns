value = S0,5
volumescale = 100
channel = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 40
value = S100,0
volumescale = 100
channel = 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 140
value = S800,0
volumescale = 100
channel = 1

[State 170, 1]
