[Statedef 10000]
type    = U
movetype= I
physics = N
poweradd= 0
ctrl = 0
anim = 0
sprpriority = 0

[State Armor]
type = AssertSpecial
trigger1 = 1
flag = invisible

[State Damage]
type = HitOverride
trigger1 = ishelper
attr = SCA,AA,AT,AP
time = -1
stateno = 10001

[State Armor]
type = BindToRoot
trigger1 = 1
time = -1
facing = 1
pos = 0, 0

[State Armor]
type = NotHitBy
trigger1 = roundstate != 2
trigger2 = root,alive = 0
value = SCA,AA,AT,AP

[State Armor]
type = changeanim
trigger1 = 1
value = root,anim
elem = root,animelemno(0)

[State Armor]
type = LifeAdd
trigger1 = 1
value = 10000
absolute = 1

[State Armor]
type = Turn
trigger1 = root,facing != facing

