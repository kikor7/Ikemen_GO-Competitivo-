[State 52, 3]
type = CtrlSet
triggerall = roundstate = 2
triggerall = alive
triggerall = time >= 60
trigger1 = statetype = A
trigger2 = statetype = C
trigger3 = movetype = H
value = 1

[State 120, Hi to Lo]
type = StateTypeSet
trigger1 = statetype = C
statetype = S
physics = S

[State -3, 2]
type = assertspecial
trigger1 = 1
flag = nostandguard
flag2 = nocrouchguard
flag3 = noairguard

[State -3]
type = Varrandom
trigger1 = 1
v = 11
range = -70,70

[State -3]
type = Varrandom
trigger1 = 1
v = 12
range = -20,20

[State 1200, 3]
type = MakeDust
trigger1 = life <= 500  
trigger1 = life > 0
pos = var(11), var(12)

[State -3, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
trigger1 = stateno != 170
value = 170
persistent = 0



