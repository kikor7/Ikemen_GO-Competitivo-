;=============================================================================
; Hyper Combo Finish
;---------------------------------------------------------------------------
; PRINCESS Super hypercombo Portrait


;=============================================================================
[Statedef 9801]
type = A
movetype = I
physics = N
anim = 8009                ;blank

[State 9801, Hyper Combo Finish]
type = Explod
trigger1 = time = 5
ID = 8002
Anim = 8002             ;hyper bg
postype = left
bindtime = -1
removetime = 45
supermovetime = 9999
pausemovetime = 9999
sprpriority = -30

[State 9801, Remove Background]
type = AssertSpecial
trigger1 = NumExplod(9802) != 0
flag = NoFG
flag2 = NoBG

; Remove Hyper Combo BKG, if any
[State 9801, Hyper Combo Finish]
type = Removeexplod
trigger1 = Time = 0
trigger1 = numexplod(9)>0
value = 9

[State 9801, Hyper Combo Finish]
type = Removeexplod
trigger1 = Time = 0
trigger1 = numexplod(8)>0
value = 8


;Play a dramatic Hyper Combo Finish Sound
[State 9801, Hyper Combo Finish]
type = PlaySnd
trigger1 = Time = 1
value = 101, 8

; "Hyper Combo FINISH!!"
[State 9801, Hyper Combo Finish]
type = PlaySnd
trigger1 = Time = 60
value = 10, 3
volume = 400

; Remove Hyper Combo Finish BKG
[State 9801, Hyper Combo Finish]
type = Removeexplod
value = 9802
trigger1 = Roundstate = 4

[State 9801, Hyper Combo Finish]
type = DestroySelf
trigger1 = RoundState = 4




[State 9999, Whiteout]
type           = PalFx
trigger1       = Time = 1
add            = 0,0,0
sinadd         = 300,300,300,270
time           = 65
ignorehitpause = 1


[State 9999, Finish SFX]
type = BgPalFX
trigger1 = 1
sinadd = 300,300,300,100
persistent = 0
time =65
ignorehitpause = 1





[State 9999, Fadeout]
type           = BGPalFX
trigger1       = Time = 65
add            = 255,255,255
sinadd         = -255,-255,-255,50
time           = 0
ignorehitpause = 1








[State 9801, Remove]
type = removeexplod
trigger1 = roundstate = 4

[State 9801, Done]
type = DestroySelf
trigger1 = roundstate = 0 || roundstate = 1

















;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]


;[State -2]
;type = VarSet
;trigger1 = Life > 1
;trigger1 = MoveType != H
;trigger1 = StateNo != 9000
;var(46) = StateNo
;ignorehitpause = 1
;
;[State -2]
;type = VarSet
;trigger1 = Life > 1
;trigger1 = StateNo = [120,159]
;trigger1 = StateNo != 9000
;var(46) = StateNo
;ignorehitpause = 1


; Hyper Combo Finish Helper

[State -2, Trigger Vars] ;If opponent dies, set variable 9 to toggle Hyper Combo
type = VarSet           ;Finish sequence.
triggerall = WinKO = 1
triggerall = var(9) = 0
trigger1 = Stateno = 5505  ;initail special move
trigger2 = Stateno = 8000    ;initail special move
trigger3 = Stateno = 2500    ;initail special move

v = 9
value = 1



[State -2, Hyper Combo Finish] ;THE HELPER SEQUENCE
type = Helper
triggerall = RoundState = 3
;triggerall = Win
triggerall = NumHelper(9801)=0
trigger1 = var(9) = 1
name = "Hyper Combo Finish"
ID = 9801
StateNo = 9801
postype = left
pos = 0, 0
ownpal = 1
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999
ownpal = 1

; v1.1
; This state prevents corpse from being hit ater being KO'ed in simul mode,
; if partner is still alive.

[State -2, NotHitBy]
type = NotHitBy
trigger1 = Alive = 0
value = SCA

