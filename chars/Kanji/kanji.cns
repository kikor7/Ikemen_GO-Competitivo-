; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, 5]
type = Playsnd
trigger1 = timemod = 15,0
value = 100,0



[State 100, 4]
type = ChangeState
triggerall = var(24) = 0
trigger1 = command != "holdfwd"
value = 0

[State 100, 4]
type = ChangeState
triggerall = var(24) = 1
trigger1 = P2BodyDist X < 0
trigger2 = p2movetype = A
trigger3 = RoundState != 2
value = 0









;---------------------------------------------------------------------------
; RUN_BACK
[Statedef 105]
type    = S
physics = N
ctrl = 0
anim = 105
velset = 0,0
sprpriority = 1

[State 105, 1]
type = Velset
trigger1 = animelem = 2
x = const(velocity.run.back.x)
y = const(velocity.run.back.y)

[State 105, 2]
type = Veladd
trigger1 = time > 5
trigger1 = vel x < 0
x = 0.33333333333333

[State 105, 3]
type = Velset
trigger1 = vel x > 0
x = 0

[State 105, 4]
type = Playsnd
trigger1 = animelem = 2
value = 40,0

[State 105, 5]
type = Playsnd
trigger1 = animelem = 8
value = 52,0

[State 105, 6]
type = ChangeState
trigger1 = animtime = 0
value = 0
ctrl = 1



;guard states fixed thanks to pots.
;===================<GUARD>================

[Statedef 120]
type = U    ;Leave state type unchanged
physics = U ;Leave physics unchanged

[State 120, 1]
type = ChangeAnim
trigger1 = Time = 0
value = 120 + (statetype = C) + (statetype = A)*2

[State 120, 2]
type = StateTypeSet
trigger1 = Time = 0 && statetype = S
physics = S

[State 120, 3]
type = StateTypeSet
trigger1 = Time = 0 && statetype = C
physics = C

[State 120, 4]
type = StateTypeSet
trigger1 = Time = 0 && statetype = A
physics = A

[State 120, Hi to Lo]
type = StateTypeSet
TriggerAll=Statetype = S
Trigger1 = var(24)<1
Trigger1 = command = "holddown"
Trigger2 = var(24)>0
Trigger2 = EnemyNear,StateType!=A
;Trigger2 = Random<=280;||var(24)>6
statetype = C
physics = C

[State 120, Lo to Hi]
type = StateTypeSet
TriggerAll=Statetype = C
Trigger1 = var(24)<1
Trigger1 = command != "holddown"
Trigger2 = var(24)>0
Trigger2 = EnemyNear,StateType=A
;Trigger2 = Random<=280;||var(24)>6
statetype = S
physics = S

[State 120, 5]
type = ChangeState
trigger1 = AnimTime = 0
value = 130 + (statetype = C) + (statetype = A)*2

[State 120, Stop Guarding]
type = ChangeState
Trigger1 = var(24)<1
Trigger1 = command != "holdback"
Trigger2 = !inguarddist
value = 140

[State 120, Stop Guarding(AI)]
Type = ChangeState
TriggerAll = var(24)>0
TriggerAll = P2MoveType != A
Trigger1 = P2Dist X<0
Trigger2 = P2Dist X>=0
Trigger2 = !InGuardDist
Value = 140
IgnoreHitPause = 1

