;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40, 1]
type = Varset
trigger1 = time = 0
var(9) = ifelse(prevstateno = 100,1,0)

[State 40, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 3]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 4]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 5]
type = AfterImage
trigger1 = prevstateno = 100
trigger1 = time = 0
time = 25
length = 11
palcolor = 192
palbright = 0,0,0
palcontrast = 128,128,128
palpostbright = 72,72,72
paladd = 0,0,0
palmul = 1,1,1
timeGap = 1
frameGap = 5
trans = none

[State 40, 6]
type = VelSet
trigger1 = AnimTime = 0
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y) - 0.5*(prevstateno=100)

[State 40, 7]
type = Playsnd
trigger1 = animtime = 0
value = 40,0

[State 40, 8]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(command="holdup",50,49)
ctrl = 1

;---------------------------------------------------------------------------
; Airjump Start
[Statedef 48]
type    = A
physics = N
anim = 48
velset = 0,0
ctrl = 0
sprpriority = 1

[State 48, 1]
type = Varset
trigger1 = time = 0
var(9) = 0

[State 48, 2]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 48, 3]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 48, 4]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 48, 5]
type = Playsnd
trigger1 = animelem = 1
value = 40,0

[State 48, 6]
type = Playsnd
trigger1 = animtime = 0
value = 40,0

[State 48, 7]
type = ChangeState
trigger1 = AnimTime = 0
value = ifelse(command="holdup",50,49)
ctrl = 1

;---------------------------------------------------------------------------
; Small Jump
[Statedef 49]
type    = A
physics = N
anim = 49
velset = ifelse(var(9)=1, const(velocity.runjump.fwd.x), ifelse(sysvar(1)=1,3,ifelse(sysvar(1)=-1,-2.5,0))),-6.54

[State 49, 1]
type = Afterimagetime
trigger1 = time = 11
time = 0

[State 49, 2]
type = Veladd
trigger1 = time > 0
y = 0.654

[State 49, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 49, 4]
type = Changestate
trigger1 = pos y > 0
value = 52

[State 49, 5]
type = Changestate
trigger1 = prevstateno != 48
trigger1 = command = "up" && command != "up2"
value = 48

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = N
velset = 0,0

[State 50, 1]
type = Afterimagetime
trigger1 = time = 19
time = 0

[State 50, 2]
type = Velset
trigger1 = time = 1
x = ifelse(var(9)=1, const(velocity.runjump.fwd.x), ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x))))
y = const(velocity.jump.y)

[State 50, 3]
type = Gravity
trigger1 = time > 1

[State 50, 4]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse(sysvar(1)=1, 42, ifelse(sysvar(1)=-1, 42, 41))

[State 50, 5]
type = VarSet
trigger1 = Time = 1
sysvar(1) = 0

[State 50, 6]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, 7]
type = Changestate
trigger1 = pos y > 0
value = 52

[State 50, 8]
type = Changestate
trigger1 = prevstateno != 48
trigger1 = command = "up" && command != "up2"
value = 48

