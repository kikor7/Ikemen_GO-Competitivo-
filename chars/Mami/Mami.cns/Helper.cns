trigger1 = 1
value = var(0)

[State ]
type = AngleSet
trigger1 = 1
value = var(0)

[State ]
type = VarSet
trigger1 = time = 0
ignorehitpause = 1
fvar(0) = atan(fvar(2)/fvar(3))-(.5*pi*ifelse(P2dist Y <0,-1,1))

