; クロスブーメランx

[Statedef 1000]
type     = S
movetype = A
physics  = S
juggle   = 4
poweradd = 20
velset   = 0,0
anim     = 1000
ctrl     = 0
sprpriority = 2

[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 12
value = 0, 2

[State 1000, ボイス]
type = PlaySnd
trigger1 = Time = 1
value = 5,1
channel = 0

[State 1000, ヘルパー飛び道具を出す]
type = Helper
trigger1 = AnimElemTime(4) = 0
helpertype = normal
name = "1"
ID = 1000
pos = ceil(const(size.xscale)*50),ceil(const(size.yscale)*-150)
postype = p1
facing = 1
size.xscale = const(size.xscale)
size.yscale = const(size.yscale)
stateno = 1005
keyctrl = 0
ownpal = 1
supermovetime = 0
pausemovetime = 0

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;----------------
;ヘルパー飛び道具

[Statedef 1005]
type     = A
movetype = A
physics  = N
ctrl     = 0
anim     = 1005
sprpriority = 3

[State 1005, 1];殴られたり投げられたりしないように設定
type = NotHitBy
trigger1 = 1
value = , NA, SA, HA, NT, ST, HT

[State 1005, やられ状態上書き];相殺する場合、消滅ステートに移行
type = HitOverRide
trigger1 = 1
time = -1
attr = SCA, AA, AP, AT
slot = 0
stateno = 1006
ignorehitpause = 1

[State 1005, 移動速度]
type = Velset
trigger1 = Time = 0
x = 5.0

[State 1005, ヒット定義]
type = Hitdef
trigger1 = Time = 0
attr = S, SP
animtype  = Hard
damage    = ceil(210*root,fvar(1)/100), 20
getpower = 30,15
priority  = 4
hitflag   = MAF
guardflag = MA
pausetime = 0,8
sparkxy = 0,0
sparkno = s7002
guard.sparkno = s7011
hitsound   = s2, 2
guardsound = s3, 0
ground.type = High
ground.slidetime = 12
ground.hittime  = 12
ground.velocity = -8,0
air.velocity = -3.0,-4
air.hittime = 18
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = 0

[State 1005, ヘルパーを消す]
type = DestroySelf
trigger1 = movecontact
trigger2 = FrontEdgeDist <= -20

