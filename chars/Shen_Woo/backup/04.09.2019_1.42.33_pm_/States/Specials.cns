trigger1 = command != "hold_y" && time = [6,50]
trigger2 = time = 51
value = 1003
ctrl = 0

[State 220,2]
type = Changestate
trigger1 = var(10) = 2
trigger1 = command != "hold_z" && time = [6,50]
trigger2 = time = 51
value = 1003
ctrl = 0

[State 220,2]
