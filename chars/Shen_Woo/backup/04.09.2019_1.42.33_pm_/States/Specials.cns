;----------------------------------------
;Geki-Ken
[Statedef 1000]
type    = S
movetype= A
physics = S
poweradd= 0 * !var(20)
ctrl = 0
anim = 1000
velset = 0
sprpriority = 2
juggle = 10

[State 1000, VarSet]
type=VarSet
trigger1 =!AILevel&& !time
var(10)=ifelse(command="Geki-Ken1",0,ifelse(command="Geki-Ken2",1,2))
ignorehitpause=1

[State 1000, ChangeAnim]
type = ChangeAnim
trigger1 = !Time
value = ifElse(var(10) = 0, 1000, ifElse(var(10) = 1, 1010, 1020))

[State 1000, VarSet]
type=VarSet
trigger1 =AILevel&& !time
var(10)=ifelse(random<700,1,2)
ignorehitpause=1

[State 1000, 6]
type = ChangeState
trigger1 = !AnimTime
value = 1001
ctrl = 0

