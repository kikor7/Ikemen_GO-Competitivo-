trigger1 = p2statetype=A&&movecontact
v =3   ;fv = 10
value = 1
ignorehitpause = 1
[State 410, 1]
type = PlaySnd
trigger1 = Time = 1
value = 1, 1
channel = 1
;This is the first hit, triggered on the 3rd element of animation.
[State 410, 2]
type = HitDef
trigger1 = AnimElem = 2
attr = C, NA
damage    =71
getpower = 30,15
animtype  = Medium
hitflag = MAF
guardflag = M
pausetime = 12,12
sparkno = S6001
guard.sparkno=S6011
sparkxy = -17,-42
hitsound =S5, 1
guardsound = S6, 0
ground.type = Low
ground.slidetime = 16
ground.hittime  = 27
ground.velocity = -7
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -4,-6           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime =99; 15



[State 410, 4]
type = ChangeState
trigger1 = AnimTime = 0
value = 11
ctrl = 1

