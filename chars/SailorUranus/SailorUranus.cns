;Kung Fu Throw - Attempt
[Statedef 799]
type    = S
movetype= A
physics = S
juggle  = 0
velset = 0,0
ctrl = 0
anim = 800
sprpriority = 2
[State 0, VarSet]
type = VarSet
trigger1 = p2movetype=A
v = 6    ;fv = 10
value = 1
[State 0, VarSet]
type = VarSet
trigger1 =time=0
v = 7    ;fv = 10
value = 0
[State 800, 1]
type = HitDef
getpower = 60,30
triggerall = p2movetype!=H
Trigger1 = Time = 0
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
p1facing = ifelse(command="holdfwd",1,-1)
p2facing = 1          ;Force p2 to face KFM
p1stateno = 811       ;On success, KFM changes to state 810
p2stateno = 822       ;If hit, p2 changes to state 820 in KFM's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value =210
ctrl = 0

;---------------------------------------------------------------------------
;Kung Fu Throw - Throwing the opponent

[Statedef 811]
type    = S
movetype= A
physics = N
anim = 810
poweradd = 0

; Here a variable, var(2), is used to remember whether or not the
; player was holding forward at the start of the state. This variable
; is checked later on to turn KFM around if necessary.



[State 810, Throw Sound]
type = PlaySnd
trigger1 = time=0
value = 60, 0
channel=1



[State 0, VarSet]
type = VarSet
triggerall = var(6)=0
trigger1 = random<33*AIlevel&&AIlevel>0&&time=0
trigger2=(enemy,command="z" || enemy,command="y" || enemy,command="b")&& AILevel=0 && time=0
v = 7   ;fv = 10
value = 1

[State 1000, 1]
type = PlaySnd
trigger1 =  AnimElem =2
value = 820, 0
channel=0
[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(1) >= 0&&animelemtime(2)<0
pos =-11, -81
[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(2) >= 0&&animelemtime(3)<0
pos =-2, -81
[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(3) >= 0&&animelemtime(4)<0
pos =38, -57
[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElem = 4
pos = 53,0

[State 1000, 1]
type = PlaySnd
trigger1 =  AnimElem =4
value = 7, 1
channel=2

[State 0, Width]
type = Width
trigger1 =time=0
edge = 70,0


[State 0, EnvShake]
type = EnvShake
trigger1 =AnimElemtime(4) = 1
time = 13
freq = 60
ampl = -2
phase = 120

[State 810, Throw 11]
type = TargetState
trigger1 = AnimElemtime(5) = 1
value = 823


[State 810, State End]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw
; (a custom gethit state)
; Description: This is the state that the opponent changes to after being
;     hit by KFM's throw HitDef. The important thing here is to use a
;     ChangeAnim2 controller. The difference between ChangeAnim2 and
;     ChangeAnim is that ChangeAnim2 changes the player's animation to
;     an action in the AIR file of the attacker (in this case, kfm.air),
;     whereas ChangeAnim always changes the player to an action in his
;     own AIR file. Look at Action 820 in kfm.air for some extra
;     comments.
[Statedef 822]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 820
[State 0, ScreenBound]
type = ScreenBound
trigger1 =1
value = 1
movecamera = 1,0
;In case attacker loses binding on player for any reason, this controller
;guarantees that the player will never get stuck in this thrown state.
[State 820, 2]
type = SelfState
trigger1 = enemy,stateno!=811
value = 5050

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw - thrown into the air
; (a custom gethit state)
; Description: This state has the opponent flying through the air and
;     falling down onto the ground. The SelfState controller sets the
;     opponent back using to his own state file when he his the ground.
;     Controllers 821,2 and 821,3 allow the opponent to recover by
;     hitting his recovery command when he is falling.
[Statedef 823]
type    = A
movetype= H
physics = N
velset = -3,-5
poweradd = 40
[State 0, Turn]
type = Turn
trigger1 =time=0
;ignorehitpause =
;persistent =

[State 0, PosSet]
type = PosSet
trigger1 =time=0
y = 0
[State 820, 1]
type = ChangeAnim
Trigger1 = Time = 0
value = 5110
[State 0, VelSet]
type = VelSet
trigger1 = time=2
x = 3
y = -3
;ignorehitpause =
;persistent =

[State 0, LifeAdd]
type = LifeAdd
trigger1 = time=0
value = ifelse(enemy,var(7),-111,-222)




[State 821, 2] ; Recover near ground (use ChangeState)
type = selfState
triggerall = time=2
triggerall = alive
trigger1 = enemy,var(7)
value = 5201 ;HITFALL_RECOVER
[State 821, 4] ;Hit ground
type = changeState
trigger1 =  time=4
value = 10612


