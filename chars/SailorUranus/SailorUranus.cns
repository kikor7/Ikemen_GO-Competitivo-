getpower = 60,30
triggerall = p2movetype!=H
Trigger1 = Time = 0
attr = S, NT          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 1, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
p1facing = ifelse(command="holdfwd",1,-1)
p2facing = 1          ;Force p2 to face KFM
p1stateno = 810       ;On success, KFM changes to state 810
p2stateno = 820       ;If hit, p2 changes to state 820 in KFM's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down

;ignorehitpause = 
;persistent = 

[State 800, 2]
type = ChangeState
Trigger1 = AnimTime = 0
value = 240
ctrl = 0

;---------------------------------------------------------------------------
;Kung Fu Throw - Throwing the opponent

[Statedef 810]
type    = S
movetype= A
physics = N
anim = 830
poweradd = 0

; Here a variable, var(2), is used to remember whether or not the
; player was holding forward at the start of the state. This variable
; is checked later on to turn KFM around if necessary.



[State 0, VarSet]
type = VarSet
triggerall = var(6)=0
trigger1 = random<33*AIlevel&&AIlevel>0&&time=0
trigger2=(enemy,command="z" || enemy,command="y" || enemy,command="b")&& AILevel=0 && time=0
v = 7   ;fv = 10
value = 1



[State 810, Throw Sound]
type = PlaySnd
trigger1 = time=0
value = 800, 0
channel=1


[State 810, Throw Sound]
type = PlaySnd
trigger1 = AnimElem= 2
value = 5, 3
channel=2

[State 0, Explod]
type = Explod
trigger1 = AnimElem= 2
anim =6001
ID =6001
pos = 35,-62
postype = p1  ;p2,front,back,left,right
facing = 1
vfacing = 1
bindtime = 1
vel = 0,0
accel = 0,0
random = 0,0
pausemovetime = 0
scale = 1,1
sprpriority =3
ontop = 1
shadow = 0,0,0
ownpal =1
removeongethit = 0
;ignorehitpause =
;trans =
;persistent =
;supermove = 0
;pausemove = 0


[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(3) <0
pos = 34, 0

[State 0, Width]
type = Width
trigger1 =time=0
edge = 70,0

[State 240, 2]
type = HitDef
trigger1=animelem=3
attr = S, NA
animtype  = Medium
damage    = 80,100
guardflag = MA
pausetime = 4,4
sparkno = S6001
guard.sparkno=S6011
sparkxy = -10,-77
hitsound =S5, 3
guardsound = S6, 0
ground.type = Low
ground.slidetime = 12
ground.hittime  = 17
ground.velocity = -4,-6
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -4,-6           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime =99; 15
forcenofall=1
id=200

[State 0, TargetState]
type = TargetState
triggerall = p2statetype=A && (var(7)=0 || !enemy,alive)
trigger1 = movehit && enemy,hitfall&& p2stateno!=10612
value =10612
ID = 200
[State 0, VelSet]
type = VelSet
trigger1 = animelem=3
x = -2
y = -6
;ignorehitpause =
;persistent =
[State 0, VarSet]
type = VarSet
trigger1 = animelemtime(4)>0
v =3   ;fv = 10
value = 1
ignorehitpause = 1
[State 0, VelAdd]
type = VelAdd
trigger1 = animelemtime(3)>0
y = .5
;ignorehitpause =
;persistent =

[State 810, State End]
type = ChangeState
trigger1 = pos y >=0 && animelemtime(3)>3
value = 52
ctrl = 1

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw
; (a custom gethit state)
; Description: This is the state that the opponent changes to after being
;     hit by KFM's throw HitDef. The important thing here is to use a
;     ChangeAnim2 controller. The difference between ChangeAnim2 and
;     ChangeAnim is that ChangeAnim2 changes the player's animation to
;     an action in the AIR file of the attacker (in this case, kfm.air),
;     whereas ChangeAnim always changes the player to an action in his
;     own AIR file. Look at Action 820 in kfm.air for some extra
;     comments.
[Statedef 820]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0
value = 840
[State 0, ScreenBound]
type = ScreenBound
trigger1 =1
value = 1
movecamera = 1,0
;ignorehitpause =
;persistent =

;In case attacker loses binding on player for any reason, this controller
;guarantees that the player will never get stuck in this thrown state.
[State 820, 2]
type = SelfState
trigger1 = enemy,stateno!=810
value = 5050

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw - thrown into the air
; (a custom gethit state)
; Description: This state has the opponent flying through the air and
;     falling down onto the ground. The SelfState controller sets the
;     opponent back using to his own state file when he his the ground.
;     Controllers 821,2 and 821,3 allow the opponent to recover by
;     hitting his recovery command when he is falling.
[Statedef 821]
type    = A
movetype= H
physics = N
velset = -2,-8
poweradd = 40

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
y = .4

[State 821, 4] ;Hit ground
type = changeState
trigger1 = animtime=0&&alive
value =824

[State 821, 4] ;Hit ground
type = SelfState
trigger1 = animtime=0 &&!alive
value = 5050

