[Statedef 1050]
type    = S
movetype= A
physics = S
juggle  = 4
poweradd= 0
velset = 0,0
anim = 1050
ctrl = 0
sprpriority = 2

[State 1000, 1]
type = PlaySnd
trigger1 = animelem=3
value = 1, 1
channel=1

[State 0, Turn]
type = Turn
trigger1 =time =0 && p2bodydist x <-10

[State 0, VarSet]
type = VarSet
triggerall = AILevel=0
trigger1 = time=0
v = 2   ;fv = 10
value = ifelse(command = "upper_x",0,1)

[State 0, VarSet]
type = VarSet
triggerall = AILevel>0
trigger1 = time=0
v = 2   ;fv = 10
value = 1


[State 800, 1]
type = HitDef
getpower = 60,30
triggerall = p2bodydist x=[-15,54]
triggerall = p2movetype!=H
Trigger1 = Time = 0
attr = S, ST          ;Attributes: Standing, Normal Throw
hitflag = M-          ;Affect only ground people who are not being hit
priority = 5, Miss    ;Throw has low priority, must be miss or dodge type.
sparkno = -1          ;No spark
p1sprpriority = 1     ;Draw p1's sprite in front of p2
                      ;p2's sprite priority is set to 0 by default
p1facing =1
p2facing = 1          ;Force p2 to face KFM
p1stateno = 1051      ;On success, KFM changes to state 810
p2stateno = 1052      ;If hit, p2 changes to state 820 in KFM's cns
guard.dist = 0        ;This prevents p2 from going into a guard state if close
fall = 1              ;Force p2 into falling down

[State 1050, 5]
type = ChangeState
trigger1 = AnimTime = 0
value =0
ctrl=1
;---------------------------------------------------------------------------
;Kung Fu Throw - Throwing the opponent

[Statedef 1051]
type    = S
movetype= A
physics = N
anim = ifelse(var(2)=1,1060,1051)
poweradd = 0
velset=0,0
; Here a variable, var(2), is used to remember whether or not the
; player was holding forward at the start of the state. This variable
; is checked later on to turn KFM around if necessary.


[State 810, Throw Sound]
type = PlaySnd
trigger1 = time=0
value = 60, 0
channel=1

[State 0, SprPriority]
type = SprPriority
trigger1 =animelem=6 &&(anim=1051 || anim=1060)
value = -9
[State 0, SprPriority]
type = SprPriority
trigger1 =animelem=4 &&(anim=1051 || anim=1060)
trigger2 =animelem=5  &&(anim=1051 || anim=1060)
trigger3 =animelem=7 &&(anim=1051 || anim=1060)
trigger4= anim=1056
value = 9

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(1) >= 0&&animelemtime(3)<0 &&(anim=1051 || anim=1060)
pos = 35,0
[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(3) >= 0&&animelemtime(4)<0&&(anim=1051 || anim=1060)
pos = 10,-98
[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(4) >= 0&&animelemtime(5)<0&&(anim=1051 || anim=1060)
pos = -31,-91

[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(5) >= 0&&animelemtime(7)<0 &&(anim=1051 || anim=1060)
pos = -5,-2
[State 810, Bind 1]
type = TargetBind
trigger1 = AnimElemTime(7) >= 0&&animelemtime(9)<0 &&(anim=1051 || anim=1060)
pos = 3,-9


[State 0, VelSet]
type = VelSet
trigger1 = animelem=2 &&(anim=1051 || anim=1060)
x = -2
y = -ifelse(var(2)=0,10,15)

[State 0, VelAdd]
type = VelAdd
trigger1 =animelemtime(2)>=0&& animelemtime(6)<0 &&(anim=1051 || anim=1060)
y = .33

[State 0, VelAdd]
type = VelAdd
trigger1 =animelemtime(6)>=0  &&(anim=1051 || anim=1060)
y = .6
;ignorehitpause =
;persistent =


[State 0, Width]
type = Width
trigger1 =time=0
edge = 90,90

[State 0, ChangeAnim]
type = ChangeAnim
trigger1 = pos y>=0 && anim!=1056 && animelemtime(5)>0
value = 1056

[State 0, VelSet]
type = VelSet
trigger1 =animelemtime(1)=1 && anim=1056
trigger2 = time >65 && var(2)=1 && anim=1060
x = 0

[State 0, PosSet]
type = PosSet
trigger1 =animelemtime(2)<0 && anim=1056
y = 0
;ignorehitpause =
;persistent =

[State 0, ScreenBound]
type = ScreenBound
trigger1 = 1
value = 1
movecamera = 1,0
;ignorehitpause =
;persistent =


[State 0, VelSet]
type = VelSet
trigger1 =animelem=2 && anim=1056
x = -3
y = -7
[State 0, VelAdd]
type = VelAdd
trigger1 =animelemtime(2)>=0  &&anim=1056
y = .5

[State 810, Hurt 11]
type = TargetLifeAdd
trigger1 =animelemtime(1)=1 && anim=1056
value = -ifelse(var(2)=0,50,100)
kill=1
[State 0, PlaySnd]
type = PlaySnd
trigger1 =animelemtime(1)=1 && anim=1056
value = S1000,3
channel = 1

[State 810, Throw 11]
type = TargetState
trigger1 = AnimElemtime(2) = 1 &&anim=1056
value = 1053


[State 810, State End]
type = ChangeState
trigger1 = pos y >=0 && anim=1056 && animelemtime(3)>0
value = 52
ctrl = 1


;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw
; (a custom gethit state)
[Statedef 1052]
type    = A
movetype= H
physics = N
velset = 0,0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0 &&enemy,var(2)=0
value = 1055

[State 820, 1]
type = ChangeAnim2
Trigger1 = enemy,anim=1056
value = 1057
[State 0, PosSet]
type = PosSet
trigger1 =enemy,animelemtime(2)<0 && enemy,anim=1056
y = 0
[State 0, VelSet]
type = VelSet
trigger1 =enemy,animelemtime(2)<0 && enemy,anim=1056
x = 0
y = 0

[State 820, 1]
type = ChangeAnim2
Trigger1 = Time = 0 &&enemy,var(2)=1
value = 1061
[State 0, ScreenBound]
type = ScreenBound
trigger1 =1
value = 1
movecamera = 0,0
;ignorehitpause =
;persistent =

;In case attacker loses binding on player for any reason, this controller
;guarantees that the player will never get stuck in this thrown state.
[State 820, 2]
type = SelfState
trigger1 = enemy,stateno!=1051
value = 5050

;---------------------------------------------------------------------------
;Thrown by Kung Fu Throw - thrown into the air
; (a custom gethit state)
; Description: This state has the opponent flying through the air and
;     falling down onto the ground. The SelfState controller sets the
;     opponent back using to his own state file when he his the ground.
;     Controllers 821,2 and 821,3 allow the opponent to recover by
;     hitting his recovery command when he is falling.
[Statedef 1053]
type    = A
movetype= H
physics = N
velset = -5,-5
poweradd = 40

[State 821, 1] ;Gravity
type = VelAdd
Trigger1 = 1
y = .48

[State 0, Turn]
type = Turn
trigger1 =time=0


[State 821, 4] ;Hit ground
type = changeState
trigger1 = time=2
value = 10612

