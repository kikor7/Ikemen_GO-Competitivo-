movetype            = H
physics             = N

[State 6001:        HitVelSet]
type                = HitVelSet
trigger1            = Time = 0
x                   = 1
y                   = 1

[State 6001:        VelAdd]
type                = VelAdd
trigger1            = 1
x = -2
y                   = .25

[State 6001:        ScreenBound]
type                = ScreenBound
triggerall          = Pos y < -15
trigger1            = BackEdgeBodyDist < 15
trigger2            = FrontEdgeBodyDist < 15
value               = 1
movecamera          = 0,1

[State 6001:        Changestate]
