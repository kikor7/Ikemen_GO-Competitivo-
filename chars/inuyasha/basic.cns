[State 6001:        SelfState]
type                = SelfState
trigger1            = (Vel y > 0) && (Pos y >= 0)
value               = 5100
;---------------------------------------------------------------------------;
[Statedef 6002]
type                = A
movetype            = H
physics             = N

[State 6002:        Turn]
type                = Turn
trigger1            = (Time = 0) && (FrontEdgeBodyDist <= 30)

[State 6002:        PosAdd]
type                = PosAdd
trigger1            = Time = 0
x                   = 15 - BackEdgeBodyDist

[State 6002:        PosFreeze]
type                = PosFreeze
trigger1            = 1
x                   = 1
y                   = 1

[State 6002:        ScreenBound]
type                = ScreenBound
trigger1            = 1
value               = 1
movecamera          = 0,1

[State 6002:        ChangeAnim2]
type                = ChangeAnim2
trigger1            = Time = 0
value               = 6002

[State 6002:        ChangeState]
type                = ChangeState
trigger1            = AnimTime = 0
value               = 6003
;---------------------------------------------------------------------------;
[Statedef 6003]
type                = A
movetype            = H
physics             = N

[State 6003:        NotHitBy]
type 		    = NotHitBy
trigger1 	    = 1
value 		    = ,NA,NP

[State 6003:        VelSet]
type                = VelSet
trigger1            = Time = 0
y                   = -6

[State 6003:        VelSet]
type                = VelSet
trigger1            = Time = 0
x                   = 1.6

[State 6003:        Turn]
type                = Turn
trigger1            = (Time = 0) && (BackEdgeDist < 30)

[State 6003:        VelAdd]
type                = VelAdd
trigger1            = 1
y                   = .35

[State 6003:        ChangeAnim]
type                = ChangeAnim
trigger1            = Time = 0
trigger1            = !SelfAnimExist(5052)
value               = 5050

[State 6003:        ChangeAnim]
type                = ChangeAnim
trigger1            = Time = 0
trigger1            = SelfAnimExist(5052)
value               = 5052

[State 6003:        ChangeAnim]
type                = ChangeAnim
trigger1            = Vel Y > -2
trigger1            = Anim = 5050
trigger1            = SelfAnimExist(5060)
persistent          = 0
value               = 5060

[State 6003:        ChangeAnim]
type                = ChangeAnim
trigger1            = Vel Y > -2
trigger1            = Anim = 5052
trigger1            = SelfAnimExist(5062)
persistent          = 0
value               = 5062

[State 6003:        SelState]
type                = SelfState
trigger1            = (Vel y > 0) && (Pos y >= 0)
value               = 5100

