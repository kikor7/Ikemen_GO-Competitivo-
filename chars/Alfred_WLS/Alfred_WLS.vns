trigger1 = 1
value = SCA
time = 1

[State 5100, 10]
type = PlaySnd
trigger1 = animelem = 1
value = 171,0
channel = 0

[State 181, AssertSpecial]
type = AssertSpecial
trigger1 = time = [1,170]
flag = roundnotover
