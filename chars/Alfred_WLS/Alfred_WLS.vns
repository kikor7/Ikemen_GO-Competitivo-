type = VarAdd
triggerall = !var(33)
triggerall = fvar(5) = [1000,2000)
trigger1 = roundstate != [0,1]
trigger1 = roundstate != [3,4]
trigger1 = !(Ctrl = 0 && Anim = 0 && MoveType != H)
fvar(5) = 0.68681318681318681318681318681319
ignorehitpause = 1

