trigger1 = (var(31) := 1)||e  ; 1 = 2002 FX, 0 = XI FX
trigger1 = (var(32) := 1)||e  ; 1 = 2002 SND, 0 = XI SND
trigger1 = (var(33) := 1)||e  ; 1 = 2002UM Mode, 0 = XI Mode
