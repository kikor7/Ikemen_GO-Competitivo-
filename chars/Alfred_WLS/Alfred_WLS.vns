triggerall = !var(33)
triggerall = fvar(5) < 1000
trigger1 = roundstate != [0,1]
trigger1 = roundstate != [3,4]
trigger1 = !(Ctrl = 0 && Anim = 0 && MoveType != H)
fvar(5) = 1.3736263736263736263736263736264
ignorehitpause = 1

