;---------------------------------------------------------------------
; 曄悢昞
;僉儍儔僋僞乕梡 var(10-29)
;	var(10) : 梔夦KO僼儔僌
;	var(11) : 僗儘乕儌乕僔儑儞梡
;	var(12) : 嬻拞僐儞儃梡
;	var(15) : 傾儗儞僕偺桳柍
;---------------------------------------------------------------------
[Data]
life = 1500          ; 懱椡僎乕僕丄忋尷抣乮僨僼僅儖僩丗1000乯
power = 3000
attack = 100         ; 峌寕椡乮亾乯
defence = 100        ; 杊屼椡乮亾乯
fall.defence_up   = 30
liedown.time      = 50
airjuggle = 15        ; 嬻拞僐儞儃
sparkno = 				1        ; 弶婜僸僢僩僗僷乕僋斣崋
guard.sparkno = 		41 ; 弶婜僈乕僪僗僷乕僋斣崋
KO.echo = 0          ; 俲俷儃僀僗僄僐乕乮0:OFF丄1:ON乯
volume = 128          ; 僉儍儔儃僀僗儃儕儏乕儉抣
IntPersistIndex = 36
FloatPersistIndex = 38

[Size]
xscale = 1           ; 悈暯僒僀僘攞棪
yscale = 1           ; 悅捈僒僀僘攞棪
ground.back = 16     ; 僉儍儔暆乮抧忋丄屻傠懁乯
ground.front = 16    ; 僉儍儔暆乮抧忋丄慜懁乯
air.back = 12        ; 僉儍儔暆乮嬻拞丄屻傠懁乯
air.front = 12       ; 僉儍儔暆乮嬻拞丄慜懁乯
z.width = 10         ; 僉儍儔暆乮倸幉乯
height = 65	     ; 僉儍儔偺崅偝乮僕儍儞僾偱旘傃墇偣傞崅偝乯
attack.width = 4,4   ;Default attack width: back, front
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too   
head.pos = 5,-80    ; 摢晹嵗昗
mid.pos = 0,-55     ; 懱拞怱晹嵗昗
shadowoffset = 0     ; 僉儍儔偺塭丒僆僼僙僢僩抣

[Velocity]
walk.fwd     = 3.3          ;慜恑曕峴懍搙
walk.back    = -3.1         ;屻戅曕峴懍搙
run.fwd      = 7.2, 0       ;慜偵憱傞帪偺懍搙乮倃幉,倄幉乯
run.back     = -6,-4      ;屻傠偵憱傞帪偺懍搙乮倃幉,倄幉乯
jump.neu     = 0,-10       ;悅捈僕儍儞僾懍搙乮倃幉,倄幉乯
jump.back    = -4           ;屻僕儍儞僾懍搙
jump.fwd     = 4.2          ;慜僕儍儞僾懍搙
runjump.back = -2.55,-8.1   ;屻傠偵憱傝側偑傜偺僕儍儞僾懍搙乮僆僾僔儑儞乯
runjump.fwd  = 4.8,-9.5     ;慜偵憱傝側偑傜偺僕儍儞僾懍搙乮僆僾僔儑儞乯
airjump.neu  = 0,-8.1       ;嬻拞悅捈僕儍儞僾懍搙乮僆僾僔儑儞乯
airjump.back = -2.5         ;嬻拞屻僕儍儞僾懍搙乮僆僾僔儑儞乯
airjump.fwd  = 2.55         ;嬻拞慜僕儍儞僾懍搙乮僆僾僔儑儞乯

;---------------------------------------------------------------------------
;摦嶌愝掕
[Movement]
airjump.num     = 1      ;嬻拞僕儍儞僾偑弌棃傞夞悢乮僆僾僔儑儞乯
airjump.height  = 35     ;嬻拞僕儍儞僾偡傞偨傔偵昁梫側嵟掅尷偺崅偝乮僆僾僔儑儞乯
yaccel          = .54    ;廳椡乮悅捈壓崀壛懍搙乯
stand.friction  = .85    ;棫偪忬懺偺杸嶤學悢
crouch.friction = .82    ;偟傖偑傒忬懺偺杸嶤學悢

;===============================================================================
; Definition of the Basic Action
;===============================================================================
;---------------------------------------------------------------------------
[Statedef 5200]
type = S
movetype = H
physics = N
velset = -7,0
anim = 5200
ctrl = 0

[State 0, NotHitBy]
type = NotHitBy
trigger1 = 1
value = SCA
time = 4

[State 0, VelAdd]
type = VelAdd
trigger1 = 1 && vel x < 0
x = 0.2

[State 0, VelMul]
type = VelMul
trigger1 = 1
x = 1

[State 5201, 3]
type = PosSet
trigger1 = Time = 0
y = 0

[State 5201, 4]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 2110, VelSet]
type = VelSet
trigger1 = AnimElemTime(1) > 0 && AnimElemTime(3) < 0
x = -5

[State 2110, VelSet]
type = VelSet
trigger1 = AnimElem = 3, >= 0
x = 0

[State 0, StateTypeSet]
type = StateTypeSet
trigger1 = animelem = 2,>=1
movetype = I

[State 195, 2]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;---------------------------------------------------------------------------
[Statedef 100]
type    = S
movetype = I
physics = N
anim = 100
ctrl = 0

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.fwd.x)

[State 100,5]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 105,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 8
value = 2, 1

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100,4]
type = ChangeState
trigger1 = Command != "holdfwd" && Time >= 10
value = 101
ctrl = 1

