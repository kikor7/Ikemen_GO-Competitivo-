;-------------------------------------------------------------------------------
; 彑棙
[Statedef 180]
type = S

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State 190, ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 181

;-------------------------------------------------------------------------------
; 彑棙侾
[Statedef 181]
type = S
ctrl = 0
anim = 0
velset = 0,0

[State 5010, 4]
type = ChangeAnim
triggerall = anim != 181 && anim != 182 && RoundState = 4
trigger1 = Numenemy
trigger1 = enemy,anim != 5960
value = ifelse(Random < 500,181,182)

[State -3,PlaySnd]
type = PlaySnd
triggerall = anim = 181 || anim = 182
trigger1 = AnimElem = 3,=1
value = 0,ifelse(anim = 181,10,11)

[State 192,1]
type = AssertSpecial
trigger1 = 1
flag = nobardisplay

[State -3,PlaySnd]
type = PlaySnd
trigger1 = anim = 181 || anim = 182
trigger1 = AnimElem = 3,=1
value = 5, 0

[State 181,3]
type = AssertSpecial
trigger1 = Time = [0,150]
flag = RoundNotOver

;------------------------憡庤摦嶌1
[Statedef 5160]
type    = L
movetype= H
physics = N

[State 5110, 9] ;For hit up type
type = ChangeAnim
persistent = 0
triggerall = anim = [5171,5179]
trigger1 = SelfAnimExist(5110 + (anim % 10))
value = 5110 + (anim % 10)

[State 5110, 10] ;For normal
type = ChangeAnim
persistent = 0
triggerall = Anim != [5111,5119]
trigger1 = !SelfAnimExist(5110 + (anim % 10))
value = 5110

[State 5160, ChangeState]
type = ChangeState
trigger1 = Time = 0
value = 5150

