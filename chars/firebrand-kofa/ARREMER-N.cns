; 僟僢僔儏
[Statedef 110]
type    = S
movetype = I
physics = N
anim = 110
ctrl = 0

[State 100,0]
type = VelSet
trigger1 = AnimElem = 2
x = Const(velocity.run.fwd.x)

[State 105,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1,=3
value = 1, 12

[State 105, VelMul]
type = VelMul
trigger1 = AnimElem = 2, > 0
x = .94

[State 100,6]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100,5]
type = ChangeState
trigger1 = Command = "holdupfwd"
value = 40

[State 100,4]
type = ChangeState
trigger1 = AnimTime = 0
value = 101
ctrl = 1

