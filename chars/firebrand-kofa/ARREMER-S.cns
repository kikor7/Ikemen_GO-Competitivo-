;-------------------------------------------------------------------------------
; ファイアーボール（地上）・弱
[Statedef 1000]
type = S
movetype = A
physics = S
ctrl = 0
anim = 1000
velset = 0, 0
poweradd = 20
juggle  = 8

[State -3,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 1,=0
value = 0, 3
channel = 0

[State -3,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 5,=1
value = 5, 2

[State 3000,Projectile]
type = Projectile
trigger1 = AnimElem = 5,=1
projanim = 1050
ProjHitAnim = -1
projid = 1050
offset = 31,-62
velocity = 4, 0
projmisstime = 3
projhits = ifelse(Var(15)=0,2,1)
projshadow = -1,-1,-1
attr = S, SP
animtype = Back
damage =  60,6
getpower = 30,15
guardflag = M
pausetime = 1,4
guard.pausetime = 1,2
sparkno = S30002
guard.sparkno = s30040
projedgebound = 100
sparkxy = -10,0
hitsound = S3, 7
guardsound = s66,0
ground.type = Low
ground.slidetime = 16
ground.hittime  = 16
ground.velocity = -4.5,-6.5
air.hittime = 13
air.velocity = -4.5,-6.5
guard.velocity = -10
air.juggle = 8
air.cornerpush.veloff = 0
fall = 1
fall.recover = 0
yaccel = .5
Palfx.time = 30
palfx.add = 42,-54,-134
palfx.sinadd = 42,34,0,10
palfx.color = 0
palfx.invertall = 1
envshake.time = 12
envshake.ampl = 6; or 7

[State 1000, ChangeState]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

