;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, LifeSet]
type = LifeSet
triggerall = power >= 3000 ;&& var(12) = 1
trigger1 = Life <= 1
value = 1
ignorehitpause = 1
 
[State -2, AssertSpecial]
type = AssertSpecial
triggerall = power >= 3000 && var(12) = 1
trigger1 = enemy,life > 0
flag = noko
ignorehitpause = 1

[State -2,Switch to False Liedead]
type = changestate
trigger1 = life <= 1 && var(12) = 1 && stateno = 5110 && alive = 1
trigger2 = life <= 1 && var(12) = 1 && stateno = 5120 && alive = 1
value = 53700;5050

[State -2,Switch to False Fall]
type = changestate
trigger1 = life <= 1 && var(12) = 1 && stateno = 5040 && alive = 1
value = 5050


;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, Jump Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = [40,43] 
value = 0, 1


[State -3, Hurt Sound]
type = PlaySnd
;triggerall = Time = 0
triggerall = alive && time = 1
trigger1 = stateno = 5000 || stateno = 5010 
value = 5000, 1+random%3
volume = 255
channel= 8
persistent = 0

[State -3, Hurt Sound]
type = PlaySnd
;triggerall = Time = 0
triggerall = alive && time = 1
trigger1 = stateno = 5020 || stateno = 5030 || stateno = 5070  
value = 5010, 1+random%2
volume = 255
channel= 8
persistent = 0

[State -3, Defeat Sound]
type = PlaySnd
;triggerall = Time = 0
triggerall = alive = 0 && time = 10
trigger1 = roundstate = 4
value = 1000, 25
volume = 255
channel= 8
persistent = 0

;====================================
;Resurrection Variable
;------------------------------------
[State -3, Resurrection Helper]
type = varset
trigger1 = alive && power >= 3000 && enemy,life > 0
var(12) = 1
ignorehitpause = 1

[State -3, Resurrection Helper]
type = varset
trigger1 = alive && power < 3000 && enemy,life > 0
var(12) = 0
ignorehitpause = 1
;=====================================



