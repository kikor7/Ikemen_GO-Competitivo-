;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------
[Statedef -2]

[State -2, Normal]
Type = VictoryQuote
Trigger1 = time = 0
value = 1 + random%3

[State -2, Bowser]
type = VictoryQuote
trigger1 = enemy,name = "Koopa" && enemy, authorname = "Alexander Williams"
trigger2 = enemy,name = "Bowser Koopa"
trigger3 = enemy,name = "Bowser"
value = 4
Ignorehitpause = 1

[State 0, Koopa Troopa]
type = VictoryQuote
trigger1 = enemy,name = "Koopa Troopa Kart Fighter"
trigger2 = enemy,name = "Koopa"
trigger3 = enemy,name = "Sexy Turtle"
trigger4 = enemy,name = "Koopa Troopa"
trigger5 = enemy,name = "Nokonoko"
value = 5
Ignorehitpause = 1

[State -2, StopSnd]
type = StopSnd
trigger1 = movetype = H
channel = 19
ignorehitpause = 1
persistent = 1

[State 0, PalFX]
type = PalFX
trigger1 = var(15) = 1
add = Random/4, Random/4, Random/4
ignorehitpause = 1
time = 1

[State -2, No Power Gain]
type = PowerSet
trigger1 = var(15) = 1
trigger1 = Power > var(32)
value = var(32)

[State -2, Power Set]
type = varSet
trigger1 = var(15) = 1
var(32) = Power

[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = var(15) = 1
value = 1.6

[State 0, AttackMulSet]
type = AttackMulSet
trigger1 = var(15) = 0
value = 1
;ignorehitpause =
;persistent =

[State 0, AttackMulSet]
type = AttackMulSet
triggerall = palno = 12
trigger1 = var(15) = 1
value = 2

[State 0, AttackMulSet]
type = AttackMulSet
triggerall = palno = 12
trigger1 = var(15) = 0
value = 1.5
;ignorehitpause =
;persistent =

[State 0, VarSet]
type = VarSet
triggerall = stateno = 1200
trigger1 = animelem = 2
var(15) = 1

[State 0, VarSet]
type = VarSet
trigger1 = power = 0
var(15) = 0

[State 0, VarSet]
type = VarSet
trigger1 = roundstate != 2
var(15) = 0

[State -2, PowerAdd]
type = PowerAdd
triggerall = var(15) = 1
trigger1 = 1
trigger1 = roundstate = 2
value = -4

[State -2, Reset]
type = varSet
trigger1 = var(15) = 2
trigger2 = command = "hold_z" || (StateNo = 198 && Time = 1)
trigger3 = RoundState > 2
var(15) = 0

[State -2, AfterImageTime]
type = afterimagetime
trigger1 = movetype = H
time = 0

[State 0, Explod]
type = Explod
triggerall = palno = 11
trigger1 = Time%5 = 0
anim = 1050
ID = 1050
pos = -15+random%10,-30+random%10
postype = p1  ;p2,front,back,left,right
facing = 1
random = 40,40
removetime = -2
scale = 1.7,1.7
ownpal = 1
sprpriority = 10
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

;This controller plays a sound everytime the player lands from a jump, or
;from a back-dash.
[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 40
value = 50, 0

[State -3, Helper]
type = Helper
triggerall = (WinKO) && (NumHelper(8400) = 0)
trigger1 =  (hitdefattr = SCA, HA,HP)
trigger2 = numhelper(1003)
trigger3 = numhelper(1103)
trigger4 = stateno = [1302,1306]
helpertype = Normal
name = "Hyper WinKO"
id = 8400
pos = 0,0
postype = p1
facing = 0
stateno = 8400
keyctrl = 0
ownpal = 1
supermovetime = 9999
pausemovetime = 9999
ignorehitpause = 1
