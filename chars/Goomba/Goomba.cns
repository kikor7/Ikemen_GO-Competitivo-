; Run forward
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, 1]
type = playsnd
trigger1 = animelem = 3
trigger2 = animelem = 7
value = 20,1

[State 100, Explod]
type = Explod
trigger1 = AnimElem = 3
trigger2 = AnimElem = 7
anim = 1000
pos = -15,0
postype = p1
velocity = -1.1
sprpriority = 8
removetime = 10
bindtime = 1
ownpal = 1
supermove = 1
scale = 1.3,1.3

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 0];Original Code by Bowser Jr (DS12)
type = ChangeState
triggerall = anim = 100
trigger1 =  enemynear(0),vel y>0 && abs(enemynear(0),pos x-pos x)<30 && (enemynear(0),pos y-pos y=[-35,-5]) && enemynear(0),stateno=50
value = 960

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
trigger2 = Frontedgedist <= 0
trigger3 = Frontedgedist <= 0
value = 0
