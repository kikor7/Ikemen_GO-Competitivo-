walk.back = -3.2     
run.fwd  = 5.3, 0    
run.back = -4.7,-3.9
jump.neu = 0,-8.4    
jump.back = -3.5    
jump.fwd = 3.5      
runjump.fwd = 4,-8.1      
airjump.neu = 0,-8.1     
airjump.back = -2.55     
airjump.fwd = 2.5         

