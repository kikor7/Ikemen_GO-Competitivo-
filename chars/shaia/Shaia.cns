;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

;[Statedef -3]

;This controller plays a sound everytime KFM lands from a jump, or
;from his back-dash.
;[State -3, Landing Sound]
;type = PlaySnd
;triggerall = Time = 1
;trigger1 = stateno = 52 ;Jump land
;trigger2 = stateno = 106 ;Run-back land
;value = 40, 0

;-------------------------------------------------------------------
[Statedef -2]

; "UUUhhh..."
[State -2, 1]
type = VarRandom
trigger1 = stateno = 5000
trigger1 = Time = 1
v = 8

[State -2, 2]
type = PlaySnd
triggerall = Time = 1
triggerall = var(8) < 333
triggerall = Life > 0 ;no sound when she is KO
trigger1 = stateno = 5001
trigger1 = anim = 5000 
trigger1 = anim = 5010 
trigger2 = stateno = 5040
trigger2 = random < 400
trigger3 = stateno = 5050
value = 0,0
volume = 200


[State -2, 2.5]
type = PlaySnd
triggerall = Time = 1
triggerall = var(8) > 665
triggerall = Life > 0
trigger1 = stateno = 5001
trigger1 = anim != 5000 ;Not hit light
trigger1 = anim != 5010 ;Not hit light
trigger2 = stateno = 5040
trigger2 = random < 400
trigger3 = stateno = 5050
value = 0,1
volume = 200


; Play "uhhh3" sound when hit
[State -2, 3]
type = PlaySnd
triggerall = Time = 1
triggerall = var(8) >= 333
triggerall = var(8) <= 665
