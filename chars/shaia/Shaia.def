; Definition file for kfm
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Shaia"        ;Name of character
displayname = "Shaia" ;Name of character to display
versiondate = 07,31,2000    ;Version date of character
mugenversion = 07,31,2000   ;Version of M.U.G.E.N character works on
author = "Fer"  ;nick name, "Cuculero"     ;Character author name
pal.defaults = 1,2,4,3      ;Default palettes in order of preference

; Files for the player
[Files]
movelist = movelist.dat
cmd      = Shaia.cmd        ;Command set
cns      = Shaia.cns        ;Constants
st       = Shaia.cns        ;States
st2      = BLACK.st         ;States
st3      = helperattac.st   ;atacs
st4      = overide.st       ;States nuevos
st5      = reintegro.st     ;Another Helper
;st5     = copia.cns     ;More Power
stcommon = common1.cns      ;Common states
sprite   = Shaia.sff        ;Sprite
anim     = Shaia.air        ;Animation
sound    = shaia.snd       ;Sound 
pal1     = mas_mejor.act    ;Palettes (can have up to 12)
pal2     = morada.act
pal3     = bloody.act
pal4     = white_shaia.act
pal5     = black.act
pal6     = marsblack.act
pal7     = mars.act
