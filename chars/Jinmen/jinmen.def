
;-----基本情報------------------------------------------------------

[Info]
Name         = "jinmen"   ;キャラの名前（後々必要な場合があるので省略不可）
DisplayName  = "jinmen"   ;ゲーム中表示される名前（省略可能）
VersionDate  = 04,03,2009      ;キャラの最終更新日
MugenVersion = 04,14,2001      ;このキャラを使用出来るM.U.G.E.Nのバージョン
Author       = "souken"      ;このキャラの作成者の名前
Pal.Defaults = 1         ;CPUで出てくるキャラカラーの順番

[Files]
movelist = movelist.dat
Cmd      = jinmen.cmd          ;入力コマンド定義ファイルの登録
Cns      = jinmen.cns          ;基本ステータス情報ファイルの登録
St       = jinmen.cns          ;動作プログラムファイルの登録（最大１０個くらい増やせます（St,St0,St1,St2......））
StCommon = jinmencommon.cns      ;コモン動作プログラムファイルの登録
Sprite   = jinmen.sff          ;複数のPCX画像を１パック化したスプライトファイルの登録
Anim     = jinmen.air          ;アニメーションファイルの登録
Sound    = jinmen.snd          ;複数のWAV音声を１パック化したサウンドファイルの登録

Pal1 = jinmen1.act              ;Ａボタンで決定した色が使えます
Pal2 = jinmen3.act             ;Ｂボタンで決定
Pal3 = jinmen2.act             ;Ｃボタンで決定
Pal4 = jinmen2.act             ;Ｘボタンで決定
Pal5 = jinmen4.act             ;Ｙボタンで決定
Pal6 = jinmen1.act             ;Ｚボタンで決定

[Arcade]
Intro.Storyboard  = ;intro.def
Ending.Storyboard = ;ending.def
