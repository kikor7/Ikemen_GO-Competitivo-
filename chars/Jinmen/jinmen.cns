;---------------------------------------------------------------------------
; ここからは通常攻撃技のステート
;---------------------------------------------------------------------------
; 立ち弱パンチ
; CNS レベル: 基本
;
; 攻撃用のステートの書き方はこれが基準になります。
; やれる事はいっぱいなので、ステートコントローラやトリガーを覚えて
; どんどん技などを作っていきましょう。
;
; ※Statedefのmovetypeパラメータが「A」以外になっている場合、
; 　HitDefのステートコントローラを設置しても攻撃判定は無効になります（攻撃が空振る）。
; 　攻撃させたいならば、必ず「movetype = A」にしてください。

[Statedef 210]
type     = S
movetype = A
physics  = S
juggle   = 10
velset   = 0,0
ctrl     = 0
anim     = 200
poweradd = 0
sprpriority = 2

[State 200, ヒット定義]
type = HitDef
trigger1 = AnimElem = 2
attr = S, NA
damage = 25
getpower = 30,15
animtype = Medium
guardflag = MA
hitflag = MA
priority = 5, Hit
pausetime = 8, 8
sparkno = S30000
guard.sparkno = 40
sparkxy = -10, -76
hitsound = s200, 0
guardsound = s201, 0
ground.type = High
air.animtype = Back
ground.slidetime = 10
ground.hittime  = 15
ground.velocity = -4,0
airguard.velocity = -1.9,-.8
air.type = High
air.velocity = -1.4,-4
envshake.time = 9
envshake.ampl = 4; or 5

[State 200, 音を鳴らす]
type = PlaySnd
trigger1 = Time = 1
value = 0, 0



[State 200, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

