[State 180, 2]
type = ChangeState
trigger1 = Random <=300
value = 183
[State 180, 2]
type = ChangeState
trigger1 = Random <=300
value = 181

[State 180, 2]
type = ChangeState
trigger1 = Random <=300
value = 182




