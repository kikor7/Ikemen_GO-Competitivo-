; Definition file for Marceline
; Contains all the filenames needed for the character

; Player information
[Info]
name = "Marceline Abadeer"
displayname = "Marceline"
versiondate = 07,18,2022
mugenversion = 1.0
author = "Shimmering Brony & Jarquin10"
pal.defaults = 1,2,3,4

; Files for the player
[Files]
movelist = movelist.dat
cmd      = Coding/Marceline.cmd
cns      = CNS/Marceline.cns
stcommon = CNS/Marcelinecommon.cns
sprite   = Coding/Marceline.sff
anim     = Coding/Marceline.air
sound    = Coding/Marceline.snd
st       = CNS/Marceline.cns
st1      = CNS/Negatives.cns
st2      = CNS/Normals.cns
st3      = CNS/Specials.cns
st4      = CNS/EXSpecials.cns
st5      = CNS/Hypers.cns
st6      = CNS/BatMonster.cns
st7      = CNS/Helpers.cns
st8      = Options.txt

; Maps character selection buttons to palette numbers.
[Palette Keymap]
x  = 1
y  = 2
z  = 3
a  = 4
b  = 5
c  = 6
x2 = 7
y2 = 8
z2 = 9
a2 = 10
b2 = 11
