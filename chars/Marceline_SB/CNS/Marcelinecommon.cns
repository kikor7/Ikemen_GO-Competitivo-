;---------------------------------------------------------------------------
; Stand
[Statedef 0]
type = S
physics = S
sprpriority = 0

[State 230, ChangeState]
type = ChangeState
trigger1 = var(15) = 1
value = 10010
persistent = 0

[State 0, 1]
type = ChangeAnim
triggerall = time < 20000
trigger1 = Anim != 0 && Anim != 1 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 0

[State 0, 1]
type = ChangeAnim
triggerall = time >= 20000
trigger1 = Anim != 1 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0 ;Turn anim over
value = 1

[State 0, 2]
type = VelSet
trigger1 = Time = 0
y = 0

[State 0, 3] ;Stop moving if low velocity or 4 ticks pass
type = VelSet
trigger1 = abs(vel x) < Const(movement.stand.friction.threshold)
trigger2 = Time = 4
x = 0

[State 0, 4] ;Are you dead?
type = ChangeState
trigger1 = !alive
value = 5050
ctrl = 0

[State 0, StopSnd from intro]
type = StopSnd
trigger1 = prevstateno = [190,194]
channel = 0
persistent = 1

;---------------------------------------------------------------------------
; Stand to Crouch
[Statedef 10]
type    = C
physics = C
anim = 10

[State 230, ChangeState]
type = ChangeState
trigger1 = var(15) = 1
value = 10010
persistent = 0

[State 10, 1]
type = VelMul
trigger1 = Time = 0
x = .75

[State 10, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

[State 10, 3]
type = ChangeState
trigger1 = AnimTime = 0
value = 11

;---------------------------------------------------------------------------
; Crouching
[Statedef 11]
type    = C
physics = C
anim = 11
sprpriority = 0

[State 10, ChangeState]
type = ChangeState
trigger1 = var(17) = 0
trigger1 = var(15) = 1
value = 10010
ctrl = 0
ignorehitpause = 1

[State 11, 1] ;Change from turning animation
type = ChangeAnim
trigger1 = Anim = 6 && AnimTime = 0
value = 11

[State 11, 2] ;Stop moving if low velocity
type = VelSet
trigger1 = abs(vel x) < Const(movement.crouch.friction.threshold)
x = 0

;---------------------------------------------------------------------------
; Crouch to Stand
[Statedef 12]
type    = S
physics = S
anim = 12

[State 12, 1]
type = ChangeState
trigger1 = AnimTime = 0
value = 0

;---------------------------------------------------------------------------
; Run to Crouch
[Statedef 15]
type = C
physics = C
anim = 10
velset = 0,0
ctrl = 0

[State 15, GoToCrouch]
type = ChangeState
trigger1 = !AnimTime
value = ifelse(Command = "holddown",11,0)
ctrl = 1

;---------------------------------------------------------------------------
; Walk
[Statedef 20]
type    = S
physics = S
sprpriority = 0

[State 230, ChangeState]
type = ChangeState
trigger1 = var(15) = 1
value = 10020
persistent = 0

[State 20, 1]
type = VelSet
trigger1 = command = "holdfwd"
x = const(velocity.walk.fwd.x)

[State 20, 2]
type = VelSet
trigger1 = command = "holdback"
x = const(velocity.walk.back.x)

[State 20, 3]
type = ChangeAnim
triggerall = vel x > 0
trigger1 = Anim != 20 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 20

[State 20, 4]
type = ChangeAnim
triggerall = vel x < 0
trigger1 = Anim != 21 && Anim != 5
trigger2 = Anim = 5 && AnimTime = 0
value = 21

;---------------------------------------------------------------------------
; Jump Start
[Statedef 40]
type    = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1
facep2 = 1

[State 40, ChangeState]
type = ChangeState
trigger1 = var(15) = 1
value = 10030
persistent = 0

[State 40, 2]
type = PlaySnd
trigger1 = !animtime
value = 40,0

[State 100, FX]
type = Explod
trigger1 = !Time
anim = 8200
postype = p1
pos = 0,0
sprpriority = 2
scale = 0.50,0.50
ownpal = 1

[State 40, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 40, 2]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 40, 3]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 40, 4]
type = VelSet
trigger1 = AnimTime = 0
x = cond(sysvar(1)=0, const(velocity.jump.neu.x), cond(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))
y = const(velocity.jump.y)*0.76

[State 40, 5]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = prevstateno = 100 ;RUN_FWD
trigger1 = sysvar(1) = 1
x = const(velocity.runjump.fwd.x)

[State 40, 6]
type = ChangeState
trigger1 = AnimTime = 0
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Short Jump
[Statedef 41]
type = A
physics = A

[State 40, ChangeState]
type = ChangeState
trigger1 = var(15) = 1
value = 10030
persistent = 0

[State 1101, pos]
type = Veladd
trigger1 = time > 0
y = const(movement.yaccel)

[State 50, 1]
type = VarSet
trigger1 = Time = 1
sysvar(1) = 0

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 51, ifelse((vel x)>0, 52, 53))

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > -2
trigger1 = SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50, Particle Effect]
type = Explod
trigger1 = time < 7 && timemod = 4, 1
anim = 1058
pos = 0, 0
postype = p1
sprpriority = 2
scale = 0.50,0.50
ownpal = 1

;---------------------------------------------------------------------------
; Air Jump Start
[Statedef 45]
type    = A
physics = N
ctrl = 0
velset = 0,0

[State 45, VarAdd]
type = VarAdd
trigger1 = time = 0
var(6) = 1

[State 45, 3]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 45, 4]
type = VarSet
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 45, 5]
type = VarSet
trigger1 = command = "holdback"
sysvar(1) = -1

[State 45, 6]
type = VelSet
trigger1 = Time = 2
x = cond(sysvar(1)=0, const(velocity.airjump.neu.x), cond(sysvar(1)=1, const(velocity.airjump.fwd.x), const(velocity.airjump.back.x)))
y = const(velocity.airjump.y)*0.76

[State 40, 2]
type = PlaySnd
trigger1 = !time
value = 40,0

[State 100, FX]
type = Explod
trigger1 = !Time
anim = 6970
postype = p1
pos = 0,0
sprpriority = 1
scale = 0.30,0.30
ownpal = 1

[State 45, 7]
type = ChangeState
trigger1 = Time = 2
value = 50
ctrl = 1

;---------------------------------------------------------------------------
; Jump Up
[Statedef 50]
type    = A
physics = A

[State 50, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 50, 3]
type = ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

[State 50, Particle Effect]
type = Explod
trigger1 = prevstateno = 40 || prevstateno = 54
trigger1 = time < 16 && timemod = 4, 1
anim = 1058
pos = 0, 0
postype = p1
sprpriority = 2
scale = 0.50,0.50
ownpal = 1

[State 100, Speed FX]
Type = Explod
triggerall = prevstateno = 54
triggerall = time = [0,20]
Trigger1 = Gametime%10 = 0
Trigger2 = Gametime%10 = 4
Anim = 10004
PosType = P1
Pos = -20+random%48,-18
OwnPal = 1
BindTime = 1
RemoveOnGetHit = 1
SprPriority = 5
removetime = -2

[State 100, Speed FX]
Type = Explod
triggerall = prevstateno = 54
triggerall = time = [0,20]
Trigger1 = Gametime%22 = 0
Trigger2 = Gametime%22 = 8
Anim = 10004
PosType = P1
Pos = -20 + random%36, -42
OwnPal = 1
BindTime = 1
RemoveOnGetHit = 1
SprPriority = 5
removetime = -2

[State 100, FX]
type = Explod
triggerall = prevstateno = 54
trigger1 = AnimElem = 1
trigger2 = fvar(21) >= 3
trigger2 = gametime%12=0
anim = 10004
pos = -1,0
postype = p1
bindtime = 1
scale = 1.1*const(size.xScale),1.1*const(size.yScale)
sprpriority = 2
ownpal = 1
removetime = -2
ignorehitpause = 1

[State 50, 2]
type = ChangeAnim
trigger1 = Time = 0
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50, 3]
type = null;ChangeAnim
trigger1 = Vel y > Const720p(-8)
trigger1 = SelfAnimExist(anim + 3)
trigger1 = anim >= 41 && anim <= 43
persistent = 0
value = Anim + 3

