;---------------------------------------------------------------------------
; Super Jump
[Statedef 54]
type = A
movetype = I
physics = C
anim = 40 
velset = 0,0
ctrl = 0

[State 54, Invuln]
type = NotHitBy
trigger1 = 1
value = ,AT
ignorehitpause = 1

[State 115, VarAdd]
type = VarAdd
trigger1 = time = 0
var(2) = 1

[State 54, PSND]
type = playsnd
trigger1 = time = 0
value = 100,0
persistent = 0

[State 54, 1]
type = VarSet
trigger1 = Time = 0
sysvar(1) = 0

[State 54, 2]
type = VarSet
triggerall = !AIlevel
trigger1 = command = "holdfwd"
sysvar(1) = 1

[State 54, 3]
type = VarSet
triggerall = !AIlevel
trigger1 = command = "holdback"
sysvar(1) = -1

[state 54, AI Jump Direction]
type = varset
trigger1 = AIlevel && !time
trigger1 = p2dist x = [120,180]
sysvar(1) = 1 - random%3

[state 54, AI Jump Direction]
type = varset
triggerall = AIlevel && numenemy
trigger1 = p2movetype = A && frontedgedist >= 120
trigger1 = random < 333
trigger2 = enemy,prevstateno = 5120 && random < 250
trigger3 = backedgedist > frontedgedist
sysvar(1) = -1

[state 54, AI Jump Direction]
type = varset
triggerall = AIlevel
trigger1 = backedgedist < 16 && p2bodydist x < 120
trigger1 = p2movetype = A && p2statetype != A
trigger1 = random < 50
trigger2 = backedgedist = frontedgedist
sysvar(1) = 0

[state 54, AI Jump Direction]
type = varset
triggerall = AIlevel && numenemy
trigger1 = p2bodydist x > 180 && p2movetype = A
trigger1 = random < 80
trigger2 = p2bodydist x > 120
trigger3 = backedgedist < frontedgedist
sysvar(1) = 1

[State 54, 4]
type = VelSet
trigger1 = animtime = 0
x = cond(sysvar(1)=0, const(velocity.jump.neu.x), cond(sysvar(1)=1, const(velocity.jump.fwd.x)*1.4, const(velocity.jump.back.x)*1.4))
y = const(velocity.jump.y)*1.14

[State 54, 5]
type = ChangeState
trigger1 = !animtime
value = 50
ctrl = 1

[State 100, FX]
type = Explod
trigger1 = !Time
anim = 8200
postype = p1
pos = 0,0
scale = 0.50,0.50
ownpal = 1

[State 54, AfterImage]
type = AfterImage
trigger1 = !Time
time = 40
PalBright = 0,0,0
PalContrast = 128,128,128
PalAdd = 0,0,0
PalMul = 1,1,1
TimeGap = 2
FrameGap = 1
Trans = Add1
length = 4

;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1

[State 100, CtrlSet]
type = CtrlSet
trigger1 = AIlevel> 0
value = 0
ignorehitpause = 1

[State 100, CtrlSet]
type = CtrlSet
triggerall = AIlevel
trigger1 = inguarddist
trigger2 = time > 60
value = 1
ignorehitpause = 1

[State 110, AfterImage]
type = AfterImage
trigger1 = !Time
time = -1
PalBright = 0,0,0
PalContrast = 128,128,128
PalAdd = 0,0,0
PalMul = 1,1,1
TimeGap = 2
FrameGap = 1
Trans = Add1
length = 4

[State 40, PlaySnd]
type = PlaySnd
trigger1 = !time 
value = 40,0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100, VarSet]
type = VarSet
trigger1 = !time && prevstateno != 102
var(26) = 0

[State 100, VarSet]
type = VarSet
trigger1 = time > 10
var(26) = 1

[State 100, FX]
type = Explod
trigger1 = AnimElem = 1
trigger2 = fvar(21) >= 3
trigger2 = gametime%12=0
anim = 10002
pos = -1,0
postype = p1
bindtime = 1
scale = 0.5*const(size.xScale),0.5*const(size.yScale)
sprpriority = 2
ownpal = 1
removetime = -2
ignorehitpause = 1

[State 100, Speed FX]
Type = Explod
triggerall = vel x != 0
Trigger1 = Gametime%20 = 0
Trigger2 = Gametime%20 = 4
Anim = 10001
PosType = P1
Pos = -40,-68+random%48
OwnPal = 1
BindTime = 1
RemoveOnGetHit = 1
SprPriority = 5
removetime = -2

[State 100, Speed FX]
Type = Explod
triggerall = vel x != 0
Trigger1 = Gametime%32 = 0
Trigger2 = Gametime%32 = 8
Anim = 10001
PosType = P1
Pos = -40, -92 + random%36
OwnPal = 1
BindTime = 1
RemoveOnGetHit = 1
SprPriority = 5
removetime = -2

[State 100, FX]
type = Explod
trigger1 = AnimElem = 1
trigger2 = fvar(21) >= 3
trigger2 = gametime%12=0
anim = 10001
pos = -1,0
postype = p1
bindtime = 1
scale = 1.1*const(size.xScale),1.1*const(size.yScale)
sprpriority = 2
ownpal = 1
removetime = -2
ignorehitpause = 1

[State 220,2]
type = ChangeState
trigger1 = command = "holdup"
value = 40

[State 101, 6]
type = ChangeState
trigger1 = Time > 9
trigger1 = command != "holdfwd"
value = 101

[State 100, 4]
type = ChangeState
triggerall = time >= 7
trigger1 = !AIlevel
trigger1 = command != "holdfwd"
trigger2 = time >= 7+random%23
trigger2 = AIlevel && inguarddist
trigger3 = AIlevel && p2bodydist x <= 120 && p2statetype != A
trigger4 = AIlevel && p2statetype = L && p2bodydist X <= 60
trigger5 = AIlevel && p2statetype != L && p2bodydist X <= 40
trigger6 = AIlevel && p2movetype = A && p2bodydist X <= 150
trigger7 = AIlevel && roundstate > 2
value = 101
ctrl = 0

[State 100, AI Jump]
type = changestate
triggerall = AIlevel && numenemy && (var(25) != [18,26])
trigger1 = !numtarget && random < cond((p2movetype = A),250,5) && p2movetype != H
trigger2 = enemy,movetype = I && enemy,vel y > 0 && (random < 50*(AILevel**2)/64)
trigger3 = (enemy,stateno = 5120 || enemy,prevstateno = 5120) && ctrl && (random < 80*(AILevel**2)/64)
trigger4 = (p2movetype = H && p2statetype = A || var(25) = 1) && p2bodydist x <= 100
value = 39

