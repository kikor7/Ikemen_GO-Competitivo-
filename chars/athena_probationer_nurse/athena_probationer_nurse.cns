;벽점프
[Statedef 53]
type = A
physics = A
anim = 53
ctrl = 1

[State 53]
type = velset
trigger1 = Time < 7
x = 0
y = 0

[State 53]
type = VelSet
trigger1 = time = 7
x = const(velocity.airjump.fwd.x)
y = const(velocity.airjump.y)

[State 53]
type = PlaySnd
trigger1 = Time = 0
value = 100, 1

[State 53]
type = ChangeAnim
trigger1 = Vel y > -2  && Time > 7 && SelfAnimExist(43)
persistent = 0
value = 43


;RUN_FWD
[Statedef 100]
type = S
physics = S
anim = 100
sprpriority = 1

[State 100]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 100]
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100]
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 100]
type = PlaySnd
trigger1 = AnimElemTime(2) = 0 || AnimElemTime(4) = 0
value = 100, 0
channel = 10

[State 100]
type = ChangeState
trigger1 = command != "holdfwd"
value = 0


