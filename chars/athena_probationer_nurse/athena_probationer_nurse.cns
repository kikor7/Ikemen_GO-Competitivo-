;------------------------------------------------------------------------------------------------------------------


;Jump
[Statedef 40]
type = S
physics = S
anim = 40
ctrl = 0
sprpriority = 1

[State 40]
type = VarSet
trigger1 = Time = 0
sysfvar(1) = 0 

[State 40]
type = VarSet
trigger1 = Time = 0
sysvar(1) = ifelse((command = "holdfwd"), 1 , ifelse((command="holdback"),-1,0))


[State 40]
type = VarSet
triggerall = Time = 0
trigger1 = prevstateno = 100
trigger2 = Command = "longjump"
trigger3 = Command = "longjump" && Command = "holdfwd"
trigger4 = Command = "longjump" && Command = "holdback"
sysfvar(1) = 1 

[State 40]
type = VarSet
trigger1 = command != "holdup"
sysfvar(1) = ifelse(Sysfvar(1)=1, 3, ifelse(Sysfvar(1)=3, 3, 2))

[State 40]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = sysfvar(1)=0 || sysfvar(1)=2 
x = ifelse(sysvar(1)=0, const(velocity.jump.neu.x), ifelse(sysvar(1)=1, const(velocity.jump.fwd.x), const(velocity.jump.back.x)))

[State 40]
type = VelSet
trigger1 = AnimTime = 0
trigger1 = sysfvar(1)=1 || sysfvar(1)=3
x = ifelse(sysvar(1)=0, 0, ifelse(sysvar(1)=1, const(velocity.runjump.fwd.x), const(velocity.runjump.back.x)))

[State 40]
type = VelSet
trigger1 = AnimTime = 0
y = ifelse(sysfvar(1)>=2, -6.5, ifelse(sysfvar(1)=1, const(velocity.runjump.y), const(velocity.jump.y)))

[State 40]
type = ChangeState
trigger1 = AnimTime = 0
ctrl = 1
value = 50



;Jump Up

[Statedef 50]
type = A
physics = A

[State 50]
type = ChangeAnim
trigger1 = Time = 0 && sysfvar(1) < 2
value = ifelse((vel x)=0, 41, ifelse((vel x)>0, 42, 43))

[State 50]
type = ChangeAnim
trigger1 = Time = 0
trigger1 = sysfvar(1)>=2
value = 41

[State 50]
type = ChangeAnim
trigger1 = Vel y > -2 && SelfAnimExist(anim + 3)
persistent = 0
value = Anim + 3

[State 50]
type = AfterImage
trigger1 = Time = 0
trigger1 = sysfvar(1)=1 || sysfvar(1)=3
time = 25
length = 9
FrameGap = 3
PalBright = 1, 1, 1
PalContrast = 128, 128, 128
PalAdd = 0, 0, 0
PalMul = 1, 1, 1
trans = add1

[State 50] ;벽 점프
type = Turn
triggerall = frontedgebodydist < 3 && pos y < -12
trigger1 = command = "holdup" && command = "holdback"

[State 50]
type = PlaySnd
trigger1 = Time = 0
value = 300, 2
channel = 10

[State 50] ;벽 점프
type = ChangeState
triggerall = backedgebodydist < 3  && pos y < -12
trigger1 = command = "holdup" && command = "holdfwd"
value = 53


