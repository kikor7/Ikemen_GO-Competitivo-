;===========================================================================
; 投げ技
;===========================================================================
;---------------------------------------------------------------------------
;魅音投げ
[Statedef 800]
type     = U
movetype = A
physics  = N
juggle   = 0
anim     = 800
ctrl     = 0
velset   = 0,0
sprpriority = 2

[State 800, ヒット定義（投げ用）];地上
type = HitDef
triggerall = (StateType != A)
trigger1 = P2StateNo != 2051
trigger1 = 1
attr = S, NT
hitflag = M-  ;マイナスが付加されてるので相手が食らい中の時は掴めない
priority = 1, Miss
sparkno = -1  ;-1だからヒットスパークは表示しない
sprpriority = 1
p1facing = 1
p2facing = 1
;p1stateno = 801
p2stateno = 803
guard.dist = 0 ;相手のガード態勢に入る距離を０にしてるので、ガード不可
fall = 1

[State 800, ステート変更];投げ成功時
type = ChangeState
trigger1 = MoveHit
value = 801  ;変更先のステートナンバーを指定。この場合コモンの「通常立ち」に変わる。
anim = 801   ;変更先のステートのアニメを指定。この場合[Begin Action 0]になる。
ctrl = 0   ;変更先のステートでキーコントロールを可能にさせるかどうか。1でさせる

[State 1000, 0]
type = TargetState
trigger1 = MoveHit
value = 803
ID = -1

[State 800, ステート変更];投げ成功時
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1
;-----------------------------------------------------------------------------------------------
;成功（殴る）
[Statedef 801];投げ成功時
type     = U
movetype = A
physics  = N
anim     = 801
ctrl     = 0
poweradd = 0
velset   = 0,0

[State 801, エフェクト画像]
type = Explod
trigger1 = AnimElemTime(4) = 1

anim = 6017       ;エフェクトのアニメ（アクションナンバー）                
pos = 50,-60         ;エフェクトの座標（Ｘ軸,Ｙ軸）
postype = p1       ;エフェクトの位置属性（p1・p2・front・back・left・right）
facing = 1         ;エフェクトの左右の向き（1=そのまま,-1=左右反転）
vfacing = 1        ;エフェクトの上下の向き（1=そのまま,-1=上下反転）
scale = 1,1   ;エフェクトの大きさ（Ｘ軸,Ｙ軸）
sprpriority = 2    ;エフェクトの画像表示優先度
ownpal = 1         ;エフェクトの色を独立させるか否か（0=させない,1=させる
ontop = 1          ;エフェクトを常に画面手前に表示させるか否か（0=させない,1=させる）
random = 10,10     ;エフェクトのposで決めた位置からのランダム発生座標範囲（Ｘ軸,Ｙ軸）
bindtime = 1       ;「このエフェクトを発生させた親」に『くっ付ける時間』（フレーム）
removetime = 16     ;このエフェクトが消えるまでの時間（フレーム）
supermove = 1      ;「SuperPause」による時間停止中にもこのアニメが動くかどうか。
supermovetime = 8  ;「SuperPause」での時間停止を無視して有効にする時間を設定。
pausemovetime = 8  ;「Pause」での時間停止を無視して有効にする時間を設定。

;*********************************
[State 801, 物理的なキャラの幅]
type = Width
trigger1 = (AnimElemTime(2) >= 0) && (AnimElemTime(12) < 0)
edge = 70,0

;*********************************
[State 801, 音を鳴らす] 
type = PlaySnd
trigger1 = AnimElem = 1
value = 800,0

[State 801, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 4
value = 0,8
channel = 1

[State 801, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElemTime(3) = 5
value = 5,0

[State 801, 画面を揺らす]
type = EnvShake
trigger1 = AnimElemTime(4) = 4
time = 20
freq = 90
ampl = -4
phase = 90

;*********************************
[State 801, 掴んだ相手の位置１];TargetBindで相手を一時的に拘束
type = TargetBind
trigger1 = AnimElemTime(1) = 1
pos = 40, 0 ;自分の軸位置から相手の軸をX=28・Y=0の位置にする

[State 801, 掴んだ相手の位置２]
