guard.velocity       = -3
air.velocity         = -2,-2.5
air.juggle           = 1 
fall                 = 1
air.fall             = 1
fall.recovertime     = 50
hitonce              = 0
kill                 = 1 
guard.kill           = 1

[State 1000, ステート変更]
type = ChangeState
trigger1 = AnimTime = 0 ;アニメ時間が０になる（アニメの全てのコマの表示が一通り終わる）と有効。
value = 0  ;変更先のステートナンバーを指定。この場合コモンの「通常立ち」に変わる。
anim = 0   ;変更先のステートのアニメを指定。この場合[Begin Action 0]になる。
ctrl = 1   ;変更先のステートでキーコントロールを可能にさせるかどうか。1でさせる。

