value = 5,5

[State 1000, ヒット定義]
type                 = HitDef
trigger1             = AnimElem = 5 
attr                 = S, SA 
damage               = ceil(70*(1-(var(4)*0.05))), 10
guardflag            = MA
hitflag              = MAFD 
animtype 　　     　 = Medium
