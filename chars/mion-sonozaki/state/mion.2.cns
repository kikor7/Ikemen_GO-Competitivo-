type = Projectile
triggerall = (Anim = 1010)
trigger1 = Time = 22
attr             = S, SP
damage           = 60,20
getpower         = 120,8
animtype         = DiagUp
pausetime        = 0,10
guardflag        = MA
animtype         = DiagUp
;-----------------------------------Projectile専用のパラメータ
offset           = 60,-65          ;飛び道具を発射する位置（Ｘ軸,Ｙ軸）
velocity         = 1,0             ;飛び道具の移動速度（Ｘ軸,Ｙ軸）
accel            = 1,0             ;飛び道具の加速度(float)（Ｘ軸,Ｙ軸）
projID           = 1012            ;飛び道具のＩＤナンバー（NumProjIDなどで判断）
projanim         = 1012            ;飛び道具のアニメ（アクションナンバー）
projhitanim      = 1015            ;飛び道具がヒットした時のアニメ（アクションナンバー）
projremanim      = 6012            ;飛び道具が消える時のアニメ（アクションナンバー）
projscale        = 1,1             ;飛び道具の大きさ（Ｘ軸,Ｙ軸）※現在ハイレゾ用にスケールを半分にしてる
projshadow       = 0,0,0           ;飛び道具の影の色合い（赤,緑,青）※現在影無し
projhits         = 2               ;飛び道具のヒット数（２以上なら多段ヒットになる）
projmisstime     = 3               ;飛び道具の連続でヒットしない間隔　※projhitsが２以上の時のみ
projpriority     = 3               ;飛び道具の攻撃優先度・相手のProjectileよりも高いと消しながら進む
projremovetime   = -1              ;飛び道具の消えるまでの時間（フレーム）※-1なら当たるか画面外に出るまで消えない
projsprpriority  = 3               ;飛び道具の画像表示優先度
;-----------------------------------これ以外にまだまだある。docsフォルダ参照。
priority         = 3
sparkno          = s1015
sparkxy          = 30,0 ;Projectileの場合『Projectileの軸位置』からの座標を取る
guard.sparkno    = s6012
hitsound         = s0,30
guardsound       = s0,10
ground.type      = High
ground.slidetime = 10
ground.hittime   = 20
ground.velocity  = -8,-10
air.velocity     = -4.2,-10
air.juggle       = 5 ;Projectileの場合はここで設定しないとヒットした時ジャグルが消費しない
fall              = 1 

