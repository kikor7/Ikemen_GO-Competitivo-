[State 1000, エフェクト画像]
type = Explod
trigger1             = (Time % 6 = 0) 
trigger1             = Time = [3,16];>= 3 
anim = 651       ;エフェクトのアニメ（アクションナンバー）
                   ;ナンバーの横に「f」を付けると『fightfx.air』のものが使える。
pos = 67,-46         ;エフェクトの座標（Ｘ軸,Ｙ軸）
                   ;postypeに依存。
postype = p1       ;エフェクトの位置属性（p1・p2・front・back・left・right）
facing = 1         ;エフェクトの左右の向き（1=そのまま,-1=左右反転）
vfacing = 1        ;エフェクトの上下の向き（1=そのまま,-1=上下反転）
scale = 1,1    ;エフェクトの大きさ（Ｘ軸,Ｙ軸）
                   ;「DoubleRes=4」に対応させる場合、ここを変更する事。
sprpriority = 2    ;エフェクトの画像表示優先度
ownpal = 1         ;エフェクトの色を独立させるか否か（0=させない,1=させる）
ontop = 1          ;エフェクトを常に画面手前に表示させるか否か（0=させない,1=させる）
random = 0,0     ;エフェクトのposで決めた位置からのランダム発生座標範囲（Ｘ軸,Ｙ軸）
bindtime = -1       ;「このエフェクトを発生させた親」に『くっ付ける時間』（フレーム）
                   ;postypeに依存。-1なら常にくっ付ける事になる。
removetime = 8     ;このエフェクトが消えるまでの時間（フレーム）
supermovetime = 999  ;「SuperPause」での時間停止を無視して有効にする時間を設定。
pausemovetime = 999  ;「Pause」での時間停止を無視して有効にする時間を設定。
vel = 0,0          ;エフェクトの移動速度（Ｘ軸,Ｙ軸）
accel = 0,0    ;エフェクトの加速度（Ｘ軸,Ｙ軸）
removeongethit = 1 ;「このエフェクトを発生させた親」が『食らい状態』になった場合に
ignorehitpause = 1 ;「ヒット硬直」を無視して有効にするかどうか。（デフォルトは１）
                   ;「小ネタ.txt」を参照。

