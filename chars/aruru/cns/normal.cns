trigger1 = command != "holdback"
trigger1 = command != "holdfwd"
trigger1 = command != "holddown"
trigger2 = var(59) = 1
trigger2 = time = 0
trigger2 = p2bodydist x < 110
trigger2 = random%5 = 4
v =40
value = 0

