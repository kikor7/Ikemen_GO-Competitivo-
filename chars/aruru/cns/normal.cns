;ぷよ攻撃

[Statedef 200]
type     = S                     
movetype = A                     
physics  = S                     
juggle   = 1                     
velset   = 0,0                   
ctrl     = 0                     
anim     = 200                   
poweradd = 20                    
sprpriority = 2  

[State 7000];緑ぷよ
type = Varset
trigger1 = var(59) = 0
trigger1 = command = "holddown"
trigger2 = var(59) = 1
trigger2 = time = 0
trigger2 = p2bodydist x < 120
trigger2 = random%5 = 0
v =40
value = 1

[State 7000];青ぷよ
