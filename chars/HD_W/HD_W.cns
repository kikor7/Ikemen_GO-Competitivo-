[State 0, SelfState]
type = SelfState
trigger1 = fvar(3) = 0
trigger1 = fvar(1) = 5
trigger2 = fvar(1) = 5 ;Bugsplat
trigger2 = !Ishelper
trigger2 = stateno = [0,3050]
trigger2 = (stateno = 5000) || (stateno = 5010) || (stateno = 5020) || (stateno = 5070)
trigger2 = stateno != 444
trigger2 = stateno != 445
trigger2 = stateno != 1
trigger2 = stateno != 4
trigger3 = fvar(3) > 0 ;Bugsplat
trigger3 = fvar(1) = 5
trigger3 = ctrl
value = 1
ctrl = 0

