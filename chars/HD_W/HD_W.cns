type = S

[State 5900, 1] ;Clear all int variables
type = VarRangeSet
trigger1 = roundsexisted = 0
value = 0

[State 5900, 2] ;Clear all float variables
type = VarRangeSet
trigger1 = roundsexisted = 0
fvalue = 0

[State 0, VarSet] ;Reset Timeline
type = VarSet
trigger1 = time = 0
fv = 1
value = 1

[State 0, VarSet] ;Reset Timeline
type = VarSet
trigger1 = palno = 7
trigger1 = time = 0
fv = 1
value = 4

[State 5900, 3] ;Change palette
type = RemapPal
trigger1 = 1
source = 1,1
dest = 1,palno

[State 5900, 4] ;Intro for round 1
type = ChangeState
trigger1 = roundno = 1
trigger2 = teammode = turns
value = 190

[State 5900, 5] ;All other rounds
type = ChangeState
trigger1 = 1
value = 0

