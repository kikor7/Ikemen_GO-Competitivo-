;---------------------------------------------------------------------------
; Override common states (use same number to override) :
;---------------------------------------------------------------------------

;---------------------------------------------------------------------------
; States that are always executed (use statedef -2)
;---------------------------------------------------------------------------

[Statedef -2]

[State -2]
type = AssertSpecial
trigger1 = 1
flag = Nojugglecheck
ignorehitpause = 1

[State -2, AI-NoJump]
type = ChangeState
triggerall = var(59) = 1
triggerall = roundstate = 2
trigger1 = command = "holdup"
trigger1 = ctrl && statetype != A
trigger1 = stateno != [120,131]
trigger1 = stateno != 100
value = 100
ctrl = 0
;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3]
type = palfx
trigger1 = var(2) = 1
add = 80,80,80
time = 1
ignorehitpause= 1

[State -3]
type=varadd
trigger1 = var(2) > 0
var(2) = -1
ignorehitpause= 1

[State -3, PowerAdd]
type = PowerAdd
trigger1 = GameTime%2
value = 2

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = 40, 0
