;---------------------------------------------------------------------------
; RUN_FWD
[Statedef 100]
type    = S
physics = S
anim = 100
sprpriority = 1
ctrl = 0

[State 100, 1]
type = VelSet
trigger1 = 1
x = const(velocity.run.fwd.x)

[State 0, CtrlSet]
type = CtrlSet
trigger1 = var(59) <= 0
value = 1
;ignorehitpause =
;persistent =


[State 100, 2] ;Prevent run from canceling into walk
type = AssertSpecial
trigger1 = 1
flag = NoWalk

[State 100, 3] ;Prevent from turning
type = AssertSpecial
trigger1 = 1
flag = NoAutoTurn

[State 221, 5]
type = ChangeState
trigger1 = command = "fwd_b"
value = 110
ctrl = 1

[State 100, 4]
type = ChangeState
trigger1 = command != "holdfwd"
trigger1 = var(59) <= 0
value = 0

;---------------------------------------------------------------------------
; Lose by Time Over
; CNS difficulty: basic
[Statedef 170]
type = S
ctrl = 0
anim = 170
velset = 0,0

[State 0, PlaySnd]
type = PlaySnd
triggerall = MatchOver != 1
trigger1 = Time = 0
value = S5150,0
volume = 0
channel = -1

[State 170, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 170, AssertSpecial]
type = AssertSpecial
triggerall = 1
trigger1 = time = [0, 270]
flag = roundnotover

;---------------------------------------------------------------------------
; Win state decider
; CNS difficulty: basic
[Statedef 180]
type = S

[State 0, PlaySnd]
type = PlaySnd
triggerall = MatchOver != 1
trigger1 = Time = 0
value = S180,1
volume = 0
channel = -1

[State 0, AssertSpecial]
type = AssertSpecial
triggerall = MatchOver = 1
trigger1 = 1
flag = nomusic

[State 0, PlaySnd]
type = PlaySnd
triggerall = MatchOver = 1
trigger1 = Time = 0
value = S180,0
volume = 100
channel = -1

[State 180, 1]
type = ChangeState
trigger1 = Time = 0
value = 181

;---------------------------------------------------------------------------
; Win pose 1
; CNS difficulty: basic
[Statedef 181]
type = S
ctrl = 0
anim = 180
velset = 0,0

[State 181, 1]
type = NotHitBy
trigger1 = 1
value = SCA
time = 1

[State 181, AssertSpecial]
type = AssertSpecial
triggerall = MatchOver = 1
trigger1 = time = [0, 270]
flag = roundnotover

;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
anim = 190
velset = 0,0

[State 190, 1] ;Freeze animation until PreIntro is over
type = ChangeAnim
trigger1 = RoundState = 0
value = 190

[State 0, PlaySnd]
type = PlaySnd
trigger1 = Time = 0
value = S190,0
volume = 100

[State 190, 2] ;Assert this until you want "round 1, fight" to begin
type = AssertSpecial
trigger1 = 1
flag = Intro

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = AnimTime = 0
value = 0

