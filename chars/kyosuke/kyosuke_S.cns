;---------------------------------------------------------------------------
;スライド
[Statedef 1010]
	type		= A
	movetype	= H
	physics		= N
	ctrl		= 0
	poweradd	= 0
	velset		= 0,0

	[State 1010, 位置固定]
		type		= posfreeze
		trigger1	= hitshakeover = 0
		time		= 1

	[State 1010, 移動速度]
		type		= HitVelSet
		trigger1	= hitshakeover = 0
		x			= 1
		y			= 1

	[State 1010, 移動速度]
		type		= VelSet
		trigger1	= hitshakeover = 0
		trigger1	= vel Y = 0
		x			= -4
		y			= -4

	[State 1010, 移動速度]
		type		= VelAdd
		trigger1	= hitshakeover
		y			= GetHitVar(yaccel)

	[State 1010, 落下状態]
		type		= HitFallSet
		trigger1	= 1
		value		= 1

	[State 1010, 位置]
		type		= posset
		trigger1	= time = 0
		trigger1	= pos Y > 0
		y			= 0

	[State 1010, アニメ変更]
		type		= ChangeAnim
		trigger1	= Time = 0
		value		= 5052

	[State 1010, アニメ変更]
		type		= ChangeAnim
		trigger1	= !SelfAnimExist(5052)
		value		= 5070

[State 1010, ステート変更]
	type		= changeState
	trigger1	= pos Y >= 0
	trigger1	= vel Y > 0
	value		= 1011

