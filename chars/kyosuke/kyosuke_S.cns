;朧薙_弱
[Statedef 1000]
	type		= S
	movetype	= A
	physics		= S
	anim		= 1000
	ctrl		= 0
	poweradd	= 0

	[State 1000, 軸位置]
		type		= PosSet
		trigger1	= (StateType != A)
		y			= 0

	[State 1300, 音を鳴らす]
		type		= PlaySnd
		trigger1	= AnimElem = 3
		value		= s1000, 0

	[State 1000, 移動速度]
		type		= VelSet
		trigger1	= AnimElem = 3, >= 0 && AnimElem = 7, < 0
		x			= 5.2

	[State 1000, 移動速度]
		type		= VelSet
		trigger1	= MoveContact && AnimElem = 7
		trigger2	= AnimElem = 8
		x			= 0

	[State 1000, 音を鳴らす]
		type		= PlaySnd
		trigger1	= Time = 10
		value		= s220, 0

	[State 1000, ボイス]
		type		= PlaySnd
		trigger1	= AnimElem = 5
		value		= s4000,0

	[State 1000, ヒット定義]
		type				= HitDef
		trigger1			= Time = 0
		attr				= S, SA
		damage				= Ceil(FVar(30)*72),5
		animtype			= Hard
		air.animtype		= Back
		givepower			= 25,25
		guardflag			= MA
		hitflag				= MAF
		priority			= 4,Hit
		pausetime			= 16,15
		sparkno				= -1
		guard.sparkno		= -1
		hitsound			= s220,2
		guardsound			= s220,3
		ground.type			= High
		ground.slidetime	= 16
		ground.hittime		= 20
		ground.velocity		= -2.2
		air.velocity		= -2.6, -7.5
		air.fall			= 1
		fall.recovertime	=  Ceil(100-(FVar(22)*10))
		yaccel				= .5
		ID					= 1000
		envshake.time		= 15
		envshake.freq		= 10
		envshake.ampl		= -5

	[State 1000, エフェクト]
		type			= Explod
		trigger1		= AnimElem = 3
		anim			= 2101
		pos				= 0, 0
		postype			= P1
		scale			= 0.5,0.5
		sprpriority		= 4
		ownpal			= 1
		bindtime		= 4
		supermovetime	= 99999
		pausemovetime	= 99999
		persistent		= 0
		vel				= 0,0
		removeongethit	= 1
		trans			= Add
		ID				= 2101

	[State 1000, エフェクト]
		type			= Explod
		trigger1		= AnimElem = 5
		anim			= 1001
		pos				= 0, 0
		postype			= P1
		scale			= 0.5,0.5
		sprpriority		= 4
		ownpal			= 1
		bindtime		= 99999
		supermovetime	= 99999
		pausemovetime	= 99999
		persistent		= 0
		vel				= 0,0
		removeongethit	= 1
		ignorehitpause	= 0
		trans			= Add1
		ID				= 1001

	[State 1000, ヒットスパーク]
		type			= Explod
		trigger1		= MoveHit
		trigger1		= P2MoveType = H
		anim			= 2010
		pos				= 0, (EnemyNear,Const(size.mid.pos.y))
		postype			= P2
		facing			= 1
		vfacing			= 1
		scale			= 0.5,0.5
		sprpriority		= 5
		ownpal			= 1
		ontop			= 1
		bindtime		= 1
		supermovetime	= 99999
		pausemovetime	= 99999
		persistent		= 0
		vel				= 0,0
		removeongethit	= 1
		ignorehitpause	= 1
		trans			= Add1
		ID				= 2010

	[State 1000, ヒットスパーク]
		type			= Explod
		trigger1		= MoveHit
		trigger1		= P2MoveType = H
		anim			= 2011
		pos				= 0, (EnemyNear,Const(size.mid.pos.y))
		postype			= P2
		facing			= 1
		vfacing			= 1
		scale			= 1,1
		sprpriority		= 5
		ownpal			= 1
		ontop			= 1
		bindtime		= 1
		supermovetime	= 99999
		pausemovetime	= 99999
		persistent		= 0
		vel				= 0,0
		removeongethit	= 1
		ignorehitpause	= 1
		trans			= None
		ID				= 2011

	[State 1000, ガードスパーク]
		type			= Explod
		trigger1		= MoveGuarded
		anim			= 2030
		pos				= 0, (EnemyNear,Const(size.mid.pos.y))
		postype			= P2
		facing			= IfElse(MoveHit,IfElse(Random<500,1,-1),-1)
		vfacing			= IfElse(Random<500,1,-1)
		scale			= 0.5,0.5
		sprpriority		= 5
		ownpal			= 1
		bindtime		= 1
		supermovetime	= 99999
		pausemovetime	= 99999
		persistent		= 0
		vel				= 0,0
		removeongethit	= 1
		ignorehitpause	= 1
		trans			= Add
		ID				= 2030

