; スライドダウン
[Statedef 1011]
	type		= L
	movetype	= H
	physics		= N
	ctrl		= 0
	sprpriority	= 0

	[State 1011, 無敵なし]
		type		= hitby
		trigger1	= 1
		value		= SCA,AA,AT,AP
		time		= 1

	[State 1011, アニメ変更]
		type		= changeanim
		trigger1	= SelfAnimExist(5100)
		trigger1	= SelfAnimExist(5110)
		trigger1	= SelfAnimExist(5170)
		trigger1	= time < 20
		value		= 5100

	[State 1011, アニメ変更]
		type		= changeanim
		trigger1	= SelfAnimExist(5100)
		trigger1	= SelfAnimExist(5110)
		trigger1	= SelfAnimExist(5170)
		trigger1	= time = 20
		value		= 5170

	[State 1011, アニメ変更]
		type	= changeanim
		trigger1	= anim = 5170 || anim = 5160
		trigger1	= animtime = 0
		value		= 5110

	[State 1011, 速度]
		type		= velset
		trigger1	= time = 0
		x			= vel X * 1.75
		y			= 0

	[State 1011, 位置]
		type		= posset
		trigger1	= 1
		y			= 0

	[State 1011, 速度]
		type		= velmul
		trigger1	= 1
		x			= 0.8

[State 1011, 制御権を戻す]
	type		= selfState
	trigger1	= life = 0
	trigger1	= time = 42
	value		= 5110

[State 1011, 制御権を戻す]
	type		= selfState
	trigger1	= time = 42
	value		= 5120

