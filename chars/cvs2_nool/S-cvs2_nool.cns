;------------------------------------------------------------------------------------------
;****************************************
;アークティックストリーム
;****************************************
;弱アークティックストリーム
[Statedef 1000]
type = S
movetype = A
physics = S
ctrl = 0
velset = 0,0
anim = 1000

[State 1000, VarSet]
type = VarSet
trigger1 = Time=0
var(1)=0

[State 1000,2]
type = ChangeState
trigger1 = ifelse((prevstateno=[200,3999]),time=1,Time=0)
value = 1050

;中アークティックストリーム
[Statedef 1010]
type = S
movetype = A
physics = S
ctrl = 0
velset = 0,0
anim = 1000

[State 1000, VarSet]
type = VarSet
trigger1 = Time=0
var(1)=1

[State 1000,2]
type = ChangeState
trigger1 = ifelse((prevstateno=[200,3999]),time=1,Time=0)
value = 1050

;強アークティックストリーム
[Statedef 1020]
type = S
movetype = A
physics = S
ctrl = 0
velset = 0,0
anim = 1000

[State 1000, VarSet]
type = VarSet
trigger1 = Time=0
var(1)=2

[State 1000,2]
type = ChangeState
trigger1 = ifelse((prevstateno=[200,3999]),time=1,Time=0)
value = 1050

;アークティックストリーム
[Statedef 1050]
type = S
movetype = A
physics = S
juggle = 15
poweradd = 4*var(5)
ctrl = 0
velset = 0,0

[State 1000, Spark]
type = Explod
trigger1 = Time=0
Anim = 6060
id = 6060
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
sprpriority = 3
scale = const(size.xscale),const(size.yscale)

[State 1000, 3]
type = PlaySnd
trigger1 = Time=14
value = 1000, 0

[State -3,Super]
type = Helper
trigger1 = Time=13
id = 6000
name = "stream"
pos = 60,0
postype = P1
stateno = 6000
helpertype = normal
keyctrl = 0
ownpal = 1
ignorehitpause = 1
persistent = 0

[state 1000,exit]
type = ChangeState
trigger1 = AnimTime=0
value = 0
ctrl = 1

;---------------------------------------------------------------------------
;アークティックストリーム（飛び道具）
[Statedef 6000]
type    = S
movetype = A
physics = N
ctrl = 0
velset = parent,var(1)+3,0
anim = 6000
sprpriority = 4

[State 6000]
type = AssertSpecial
trigger1 = 1
flag = noshadow

[State 6000]
type = varset
trigger1 = time=0
var(1) = parent,var(1)

[State 200,VarSet]
type = varset
trigger1 = time>=1 && !(!root,var(18)||root,var(56))
var(18) = 1

[State 200,VarSet]
type = varset
trigger1 = time>=1 && (!root,var(18)||root,var(56))
var(18) = 0

[state 199]
type = varset
trigger1 = !root,numprojid(6000) && time>1
var(16) = 1
ignorehitpause=1

[State 1000,Projectile]
type = Projectile
trigger1 = time>=1 && !var(16)
projanim = ifelse(var(18),6015,6010)
projID = 6000
projshadow = -1
velocity = Vel X, 0
accel = 0, 0
projhits = 1
projmisstime = 0
projremovetime = 1
sprpriority = 5
; HitDefs
attr = S, SP
damage    = ifelse(ceil((56+var(1)*7)*parent,fvar(7))<7,7,ceil((56+var(1)*7)*parent,fvar(7))),ifelse(ceil(ceil((56+var(1)*7)*parent,fvar(7))/8)<7,7,ceil(ceil((56+var(1)*7)*parent,fvar(7))/8))
animtype  = Heavy
getpower = ifelse(root,var(16),4,8)*parent,var(5),2*parent,var(5)
givepower = 2*parent,var(6),2*parent,var(6)
guardflag = MA
hitflag = MAF
pausetime = 4,ceil(16-((parent,var(21)>0 && parent,var(59)=1)*16)/2)
guard.pausetime = 4,ceil(8-((parent,var(21)>0 && parent,var(59)=1)*8)/2)
sparkno = s7200+(random%8)
guard.sparkno = s7010
sparkxy = 10, -70
hitsound   = S1,20
guardsound = S0,0
ground.type = High
ground.slidetime = 15
guard.slidetime = 15
ground.hittime  = 15
guard.hittime  = 15
air.hittime = 13
ground.velocity = -10.65
guard.velocity = -10.65
airguard.velocity = -4
air.type = Low
air.velocity = -4,-6
yaccel = .5
air.fall = 1
fall.recover = 0
air.recover = 0
forcestand=1
palfx.color = 0
palfx.time = 31
palfx.add = -32,96,144

[State 200,VarSet]
type = ParentVarSet
trigger1 = 1
var(40) = -10

[State 200,VarSet]
type = ParentVarSet
trigger1 = 1
var(41) = -70

[State 200,VarSet]
type = VarSet
trigger1 = time=0
var(13) = 0

[State 4110, DestroySelf]
type = DestroySelf
triggerall = time > 1
trigger1 = FrontEdgeDist <= -40

[State 900, 4]
type = ChangeState
triggerall = time > 1
trigger1 = root,NumProjID(6000) = 0
value = 6050

;---------------------------------------------------------------------------
;アークティックストリーム（飛び道具）（消滅）
[Statedef 6050]
type    = S
movetype = I
physics = N
ctrl = 0
velset = 0,0
anim = 8050

[State 200,VarSet]
type = VarSet
trigger1 = root,projcontacttime(6000)=[1,15]
var(13) = 1

[State 4110, DestroySelf]
type = PlaySnd
trigger1 = time = 1 && !var(13)
value = 0,10

[State 1000, Spark]
type = Explod
trigger1 = time = 1
Anim = 6050
id = 6050
pos = 0, 0
postype = p1
ownpal = 1
bindtime = 1
sprpriority = 3
scale = 1,1

[State 4110, DestroySelf]
type = DestroySelf
trigger1 = time = 1
;~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
