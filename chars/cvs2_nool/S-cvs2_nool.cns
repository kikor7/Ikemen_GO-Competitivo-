;****************************************
;ベノムファネル
;****************************************
;弱ベノムファネル
[Statedef 1100]
type = S
movetype =A 
physics = S
juggle = 15
ctrl = 0
velset = 0,0
anim = 1100
poweradd = 0*var(5)

[State 3000]
type = varset
trigger1 = time=0
var(1)=0

[State 3000]
type = varset
trigger1 = (prevstateno=[3000,3999]) && time=0 && !var(21)
var(19)=1

[State 420,PlaySnd]
type = PlaySnd
trigger1 = AnimElem = 2
value = 1100, 0

[State 1000, Spark]
type = Explod
trigger1 = AnimElem = 3
Anim = 6100
id = 6100
pos = 0, 0
postype = p1
ownpal = 0
bindtime = -1
sprpriority = 3
persistent=0
ignorehitpause=0
scale = const(size.xscale),const(size.yscale)

[State 220,Hitdef]
type = HitDef
trigger1 = AnimElem=4
attr = S, SA
damage    = ifelse(ceil(91*fvar(7))<7,7,ceil(91*fvar(7))),ifelse(ceil(ceil(91*fvar(7))/8)<7,7,ceil(ceil(91*fvar(7))/8))
animtype = Hard
guardflag = M
hitflag = MAF
pausetime = floor(10/ifelse(var(21),2,1)),floor(9/ifelse(var(21),2,1))
sparkno = s7200+(random%8)
guard.sparkno = s7010
sparkxy = ifelse((Abs(P2bodydist X)-10)<20,-20,-10),-120
hitsound = S1, 15
guardsound = S0, 0
ground.type = High
ground.slidetime = 15
ground.hittime  = 15
ground.velocity = -2.0,-8.0
guard.velocity = -8.5
ground.cornerpush.veloff = 0
guard.cornerpush.veloff = ifelse((fvar(23)-ifelse(var(21),1,ceil(13*1.0/2)))<0,0,-22.0)
air.velocity = -2.0,-8.0
air.cornerpush.veloff = 0
yaccel = .5
fall.recover= 0
air.recover=0
fall = 1
air.fall = 1
getpower = ifelse(var(16),4,8)*var(5),2*var(5)
givepower = 2*var(6),2*var(6)
forcestand=1
palfx.color = 0
palfx.add = 100,40,90
palfx.mul = 90,50,90
palfx.time = 60

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(40) = ifelse((Abs(P2bodydist X)-10)<20,-20,-10)

[State 200,VarSet]
type = VarSet
trigger1 = 1
var(41) = -120

[State 200,StateTypeSet]
type = StateTypeSet
trigger1 = AnimElem = 5
movetype = I

[State 200,Exit]
type = ChangeState
trigger1 = AnimTime = 0
value = 0
ctrl = 1

