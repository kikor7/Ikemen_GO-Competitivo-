
;【超必殺技】

;==============================================================================
;■悪滅

[Statedef 1700]
type = S
movetype = I
physics = N
poweradd = 0

anim = IfElse(Ceil(var(52)/100%10)=0,1700,IfElse(Ceil(var(52)/100%10)=1,1701,1702))
ctrl = 0
sprpriority = 2

;------------------------------------------------------------------------------

[State -1, 無敵]
type = NotHitBy
trigger1 = time<=5
value = SCA, AA,AP,AT
time = 1
IgnoreHitPause = 1

[State -1, 打撃投げ無敵]
type = NotHitBy
trigger1 = time=6
value = , AA,AT
time = 25+(Ceil(var(54)%10)*Ceil(var(52)/100%10))
IgnoreHitPause = 1

;------------------------------------------------------------------------------

[State -1, 桜声]
type = PlaySnd
trigger1 = time=1
channel = 0
value = S3, 28

[State -1, 魔術SE]
type = PlaySnd
trigger1 = time=3
value = S70, 12

;------------------------------------------------------------------------------
;■ゲージ消費

[State -1]
type = PowerAdd
trigger1 = time=6
