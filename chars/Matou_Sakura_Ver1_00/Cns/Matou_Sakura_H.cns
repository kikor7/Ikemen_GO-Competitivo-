;------------------------------------------------------------------------------
;■振り向き	★演出用反転廃止

[state -1]
type = null;Turn
triggerall = time=0
triggerall = (teammode=single)||(teammode=turns)
trigger1 = enemynear(var(16)),facing=facing&&statetype!=A
trigger1 = Ceil(((enemynear(var(16)),pos x*enemynear(var(16)),facing*-1)-(pos x*facing*-1))*-1)<0
trigger2 = enemynear(var(16)),facing=facing&&statetype=A
trigger2 = Ceil((enemynear(var(16)),pos x*enemynear(var(16)),facing)+(pos x*facing*-1))<0
trigger3 = enemynear(var(16)),facing*-1=facing
trigger3 = Ceil((enemynear(var(16)),pos x*enemynear(var(16)),facing*-1)+(pos x*facing*-1))<0

