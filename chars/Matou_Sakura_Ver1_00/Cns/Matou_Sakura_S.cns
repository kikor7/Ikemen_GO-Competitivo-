
;【必殺技】

;==============================================================================
;■烈風拳（小）

[Statedef 1000]
type = S
movetype = A
physics = N
poweradd = Ceil(fvar(7)*50)

anim = 1000
ctrl = 0
sprpriority = 2

;------------------------------------------------------------------------------

[State -1, 桜声]
type = PlaySnd
trigger1 = time=0
channel = 0
value = S3, 1

[State -1, 魔術SE]
type = PlaySnd
trigger1 = time=16
value = S70, 10

[State -1, 腕振上げ残像]
type = Explod
trigger1 = time=0
anim = 1010
ID = 1001
scale = 0.5,0.5
postype = p1
pos = 0,0
ownpal = 1
sprpriority = 3
bindtime = -1
removetime = -2
removeongethit = 1

IgnoreHitPause = 0
Persistent = 0

;------------------------------------------------------------------------------
;■ID設定
[State -1, ID重複無し用]
type = null
trigger1 = time=16
trigger1 = var(6):=IfElse(!NumHelper(1020),10200,10500)

[State 1000, 烈風弾呼出]
type = Helper
trigger1 = time=16
helpertype = normal

name = "reppuu_tama"
stateno = 1020
ID = Floor(var(6)/10)
postype = p1
pos = 36, 0
facing = 0
keyctrl = 0
ownpal = 1
Persistent = 0
IgnoreHitPause = 0

size.xscale = 0.75
size.yscale = 0.5

[State -1, 桃色燐光呼出]
type = Helper
trigger1 = time=13
trigger2 = time=16

name = "reppuu_ef"
stateno = IfElse(time=13,1007,1009)
ID = IfElse(time=13,1007,1009)

postype = p1
pos = 0, 0
facing = 0
keyctrl = 0
ownpal = 1
IgnoreHitPause = 0

size.xscale = 1.0
size.yscale = 1.25

[State -1, 歩行時慣性]
type = Velset 
trigger1 = time=0&&Prevstateno=20
x = 0

[State -1, ダッシュ時慣性]
type = Velmul
trigger1 = PrevStateNo!=20
x = 0.91

[State 1000, END]
type = ChangeState
trigger1 = AnimTime=0
value = 0
ctrl = 1


;==============================================================================
;■烈風弾（小）

[Statedef 1020]
type = S
ctrl = 0
anim = 1020

movetype = A
physics = N
velset = 0,0

sprpriority = 3

[State -1,影無し]
type = AssertSpecial
trigger1 = 1
Flag = Noshadow
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■ID設定
[State -1]
type = null
trigger1 = time=0
trigger1 = var(6):=Ceil(root,var(6)/10)

[State -1, 相殺後チェック]
type = null
trigger1 = time=0
trigger1 = var(5):=IfElse(Floor(root,var(6)%10),1,0)

;------------------------------------------------------------------------------
;■燐光表示

[State -1, 桃色燐光呼出]
type = Helper
trigger1 = time%11=0
trigger1 = var(10):=1007
trigger2 = time%19=0
trigger2 = var(10):=1008

name = "reppuu_ef"
stateno = var(10)
ID = var(10)

postype = p1
pos = 5, Random%15
facing = 0
keyctrl = 0
ownpal = 1
IgnoreHitPause = 0

size.xscale = 0.75
size.yscale = 0.5

;------------------------------------------------------------------------------
;■弾速調整

[State -1, 初速]
type = VelAdd
trigger1 = time=1
x = 1.1

[State -1, 加速]
type = VelAdd
trigger1 = time=[2,80]
trigger1 = !movecontact
x = 0.05

[State -1, 減速]
type = VelAdd
trigger1 = movecontact>=4
trigger1 = Vel X >=0.5
x = -0.10

[State -1, 減速]
type = VelAdd
trigger1 = movecontact>=4
trigger1 = Vel X>=3.5
x = -0.15

;------------------------------------------------------------------------------
;■接触処理

[State -1, 無敵]
type = NotHitBy
trigger1 = 1
value = , AA,AT
time = 1
IgnoreHitPause = 1

[State -1, 相殺反射消滅]
type = HitOverride
trigger1 = 1
attr = SCA, AA,AT,AP
stateno = 1040
time = 1
IgnoreHitPause = 1

;------------------------------------------------------------------------------
