;------------------------------------------------------------------------------
;■ジャプニカ暗殺帳攻撃力補正

[State -1]
type = AttackMulSet
trigger1 = Ceil(root,var(53)/1000%10)>=1
trigger1 = Ceil(root,var(54)%10)>=1
value = 1+(Ceil(root,var(54)%10)*Ceil(root,var(53)/1000%10)*0.025)
IgnoreHitPause = 1

;------------------------------------------------------------------------------
;■攻撃

[State 1020, 1HIT目]
type = HitDef
trigger1 = movecontact=0
trigger1 = var(0):=50

ID = var(6)
sprpriority = 3
numhits = 0

attr = C, SP
damage = Ceil(root,fvar(1)*root,fvar(2)*root,fvar(3)*root,fvar(4)*(1+root,fvar(10)/80)*(1+Floor(root,fvar(20)/400)*0.05)*50), 8
yaccel = IfElse(root,fvar(9)+0.42<=0.99,root,fvar(9)+0.42,0.99)

hitflag = MAFD
guardflag = MA
guard.dist = 100

priority = 7, Hit
pausetime = 0, 2
guard.pausetime = 0, 2

sparkno = IfElse(Ceil(root,var(51)/1000000000%10)<=0,-1,1)
guard.sparkno = S16100
sparkxy = Random%5-10,0

hitsound = S0, 2
guardsound = S1, 0

animtype = Hard
ground.type = Low
air.type = Low

ground.slidetime = 8
ground.hittime = Ceil(root,fvar(10)/5+4)+18
ground.velocity = -0.5, 0
ground.cornerpush.veloff = -2.0
fall = 0

guard.slidetime = 5
guard.hittime = 15
guard.ctrltime = 15
guard.velocity = -1.0
guard.cornerpush.veloff = 0

air.hittime = Ceil(root,fvar(10)/5+4)+15
air.velocity = -2.6,-2.1
air.fall = 1

fall.yvelocity = -4.5
fall.recover = IfElse(root,fvar(10)>=10,0,1)
fall.recovertime = IfElse(root,fvar(10)>=10,999,Ceil(root,fvar(10)/5+1)+20)

airguard.ctrltime = 15
airguard.velocity = -2.2,-3.2

down.velocity = -1.6, 0
Persistent = 0


