
;【通常攻撃】

;==============================================================================
;■立ち小

[Statedef 200]
type = S
movetype = A
physics = N
juggle = 1

ctrl = 0
anim = 200
poweradd = Ceil(fvar(7)*7)
sprpriority = 2

[State 200, 1HIT目]
type = HitDef
trigger1 = Ceil(var(52)/100%10)>=1&&AnimElemTime(4)=0

ID = 200
sprpriority = 2
numhits = 0

attr = S, NA
damage = Ceil(fvar(1)*fvar(2)*fvar(3)*fvar(4)*(1+fvar(10)/80)*(1+Floor(fvar(20)/400)*0.05)*6), 0
getpower = 15,7

yaccel = IfElse(fvar(9)+0.42<=0.99,fvar(9)+0.42,0.99)

hitflag = MAF
guardflag = MA
guard.dist = 120

priority = 2, Hit
pausetime = 5, 5
guard.pausetime = 5, 5

sparkno = IfElse(Ceil(var(51)/1000000000%10)<=0,-1,1)
guard.sparkno = S16100
sparkxy = (5+Random%5),IfElse(P2StateType!=A,-(60+Random%10),Ceil(P2BodyDist Y/2-50))

hitsound = S0, 0
guardsound = S1, 0

animtype = light
ground.type = High
air.type = Low

ground.slidetime = 10
ground.hittime = Ceil(fvar(10)/5*1.2)+14
ground.velocity = -5.5, 0
ground.cornerpush.veloff = -5.5
fall = 0

guard.slidetime = 8
guard.hittime = 10
guard.ctrltime = 10
guard.velocity = -3.5
guard.cornerpush.veloff = -3.5

air.hittime = Ceil(fvar(10)/5*1.2)+20
air.velocity = -2.5,-3.8
air.fall = 0

fall.yvelocity = -4.5
fall.recover = IfElse(fvar(10)>=10,0,1)
fall.recovertime = IfElse(fvar(10)>=10,999,Ceil(fvar(10)/5*1.2)+25)

airguard.ctrltime = 9
airguard.velocity = -2.2,-1.8

[State 200, 2HIT目]
type = HitDef
trigger1 = AnimElemTime(7)=0

ID = 201
sprpriority = 2
numhits = 0

attr = S, NA
damage = IfElse(Ceil(var(52)/100%10)>=1,Ceil(fvar(1)*fvar(2)*fvar(3)*fvar(4)*(1+fvar(10)/80)*(1+Floor(fvar(20)/400)*0.05)*11),Ceil(fvar(1)*fvar(2)*fvar(3)*fvar(4)*(1+fvar(10)/80)*(1+Floor(fvar(20)/400)*0.05)*16)), 0
getpower = 15,7

yaccel = IfElse(fvar(9)+0.42<=0.99,fvar(9)+0.42,0.99)

hitflag = MAFD
guardflag = MA
guard.dist = 135

priority = 2, Hit
pausetime = IfElse(Ceil(var(52)/100%10)>=1,5,8),IfElse(Ceil(var(52)/100%10)>=1,5,8)
guard.pausetime = 5, 5

sparkno = IfElse(Ceil(var(51)/1000000000%10)<=0,-1,1)
guard.sparkno = S16100
sparkxy = (Random%5-5),IfElse(P2StateType!=A,-(80+Random%10),Ceil(P2BodyDist Y/2-70))
hitsound = S0, 0
guardsound = S1, 0

animtype = light
ground.type = High
air.type = Low

ground.slidetime = 11
ground.hittime = Ceil(fvar(10)/5*1.2)+14
ground.velocity = -5.7, 0
ground.cornerpush.veloff = -4.7
fall = 0

guard.slidetime = 8
guard.hittime = 10
guard.ctrltime = 10
guard.velocity = -3.8
guard.cornerpush.veloff = -3.8

air.hittime = Ceil(fvar(10)/5*1.2)+20
air.velocity = -3.4,-5.8
air.fall = 0

fall.yvelocity = -4.5
fall.recover = IfElse(fvar(10)>=10,0,1)
fall.recovertime = IfElse(fvar(10)>=10,999,Ceil(fvar(10)/5*1.2)+28)

airguard.ctrltime = 10
airguard.velocity = -3.4,-1.8

[State -1, 歩行時慣性]
type = Velmul
trigger1 = time=0&&Prevstateno=20
x = 0

[State -1, ダッシュ時慣性]
type = Velmul
trigger1 = PrevStateNo!=20
x = 0.82

;■SE
[State -1, 風SE]
type = PlaySnd
trigger1 = time=1
value = S0, 15

[State -1, 桜声]
type = PlaySnd
trigger1 = time=1
channel = 0
lowpriority = 1
value = S2, 2

;■基底補正
[State -1] 
type = null
triggerall = StateNo=200
triggerall = MoveHit=1
triggerall = P2MoveType=H
trigger1 = NumTarget(200)>0
trigger1 = Target(200),Time=0
trigger1 = fvar(1)>=0.95
trigger1 = fvar(1):=0.95
trigger2 = NumTarget(201)>0
trigger2 = Target(201),Time=0
trigger2 = fvar(1)>=0.90
trigger2 = fvar(1):=0.90
IgnoreHitPause = 1

;■重力補正＆HIT数補正
[State -1]
type = null
triggerall = StateNo=200
triggerall = MoveHit=1
triggerall = P2MoveType=H
trigger1 = NumTarget(200)>0
trigger1 = Target(200),Time=0
trigger1 = fvar(9):=fvar(9)+0.001
trigger1 = fvar(2)>=0.30
trigger1 = fvar(2):=IfElse(Ceil(var(52)/100%10)<=1,fvar(2)-0.020,fvar(2)-0.010)
trigger2 = NumTarget(201)>0
trigger2 = Target(201),Time=0
trigger2 = fvar(9):=fvar(9)+0.001
trigger2 = fvar(2)>=0.30
trigger2 = fvar(2):=IfElse(Ceil(var(52)/100%10)<=1,fvar(2)-0.020,fvar(2)-0.010)
IgnoreHitPause = 1

;■HIT数カウント
[State -1]
type = HitAdd
triggerall = StateNo=200
triggerall = MoveHit=1
trigger1 = NumTarget(200)>0
trigger1 = Target(200),Time=0
trigger1 = Target(200),movetype=H
trigger1 = fvar(12):=Ceil(fvar(12)+NumTarget(200))
value = NumTarget(200)
IgnoreHitPause = 1

[State -1]
type = HitAdd
triggerall = StateNo=200
triggerall = MoveHit=1
trigger1 = NumTarget(201)>0
trigger1 = Target(201),Time=0
trigger1 = Target(201),movetype=H
trigger1 = fvar(12):=Ceil(fvar(12)+NumTarget(201))
value = NumTarget(201)
IgnoreHitPause = 1

;■カウンター文字列制御フラグ
[State -1]
type = VarSet
triggerall = StateNo=200
triggerall = MoveHit=1
triggerall = P2MoveType=H
triggerall = fvar(10)>0
triggerall = Ceil(Floor(var(11)/10)%10)=1
trigger1 = NumTarget(200)>0
trigger1 = Target(200),Time=0
trigger1 = var(11):=Floor(var(11)/100)+10*(2)+Ceil(var(11)%10)
trigger2 = NumTarget(201)>0
trigger2 = Target(201),Time=0
trigger2 = var(11):=Floor(var(11)/100)+10*(2)+Ceil(var(11)%10)
var(10) = IfElse(TeamSide=1,18060*10+5,18061*10+5)
Persistent = 0
IgnoreHitPause = 1

;■リバースビート文字列制御フラグ
[State -1]
type = VarSet
triggerall = StateNo=200
triggerall = fvar(4)>0
trigger1 = PrevStateNo=210||PrevStateNo=220||PrevStateNo=420
trigger1 = fvar(4):=fvar(4)-0.15
trigger2 = PrevStateNo=230||PrevStateNo=235||PrevStateNo=240||PrevStateNo=440||PrevStateNo=460
trigger2 = fvar(4):=fvar(4)-0.25
trigger3 = Prevstateno=200;2HIT目連打ペナ
trigger3 = NumTarget(201)>0
trigger3 = Target(201),Time=0
trigger3 = fvar(4):=fvar(4)-0.05
trigger3 = time=9999
var(10) = IfElse(TeamSide=1,18110*10+5,18111*10+5)
Persistent = 0
IgnoreHitPause = 1

;■インバリ文字列制御フラグ
[State -1]
type = VarSet
triggerall = StateNo=200
triggerall = MoveHit=1
triggerall = P2MoveType=H
triggerall = Ceil(var(11)%10)=1
trigger1 = NumTarget(200)>0
trigger1 = Target(200),Time=0
trigger1 = var(11):=Floor(var(11)/10)*10+(2)
trigger2 = NumTarget(201)>0
trigger2 = Target(201),Time=0
trigger2 = var(11):=Floor(var(11)/10)*10+(2)
var(10) = IfElse(TeamSide=1,18090*10+5,18091*10+5)
Persistent = 0
IgnoreHitPause = 1

[State 200, END] 
type = ChangeState
trigger1 = AnimTime=0
Value = 0
Ctrl = 1


