;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State 0, VarAdd]
type = VarAdd
triggerall = stateno != [70000,70002];70001
triggerall = stateno != [70010,70012];70011
triggerall = stateno != [70020,70020];70021
triggerall = !var(48) > 0
trigger1 = var(49) > 0
v = 49    ;fv =
value = -1
;ignorehitpause =
;persistent =

