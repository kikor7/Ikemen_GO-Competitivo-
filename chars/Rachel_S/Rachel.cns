;---------------------------------------------------------------------------
; Introduction
; CNS difficulty: basic
[Statedef 190]
type = S
ctrl = 0
velset = 0,0

[State 0, VarSet]
type = VarSet
trigger1 = time = 0
v = 49    ;fv = 10
value = 0
;ignorehitpause =
;persistent =

[state 190]
type = varset
trigger1 = time = 0
v = 2
value = ceil(pos x);floor(pos X)

[State 190, VarRandom]
type = VarRandom
triggerall = numenemy = 1
trigger1 = p2name != "Jin" && Authorname = "Speedy9199"
trigger1 = p2name != "Ragna" && Authorname = "Speedy9199"
trigger1 = Time = 0
v = 0
range = 1,3
;ignorehitpause =
;persistent =

[State 190, VarRandom]
type = VarRandom
triggerall = numenemy >= 2
trigger1 = Time = 0
v = 0
range = 1,3
;ignorehitpause =
;persistent =

[state 190, choose var];starts round with a random groove.
type = VarRandom
trigger1 = time = 0
v = 59
range = 0,3

[State 190, 4] ;Change to stand state
type = ChangeState
triggerall = numenemy = 1
trigger1 = p2name != "Jin" && Authorname = "Speedy9199"
trigger1 = p2name != "Ragna" && Authorname = "Speedy9199"
trigger1 = Time = 0
value = 190 + var(0)

[State 190, 4] ;Change to stand state
type = ChangeState
triggerall = numenemy >= 2
trigger1 = Time = 0
value = 190 + var(0)

[State 190, 4] ;Change to stand state
type = ChangeState
trigger1 = numpartner >= 1  
trigger1 = Time = 0
value = 191 + random%3;+ var(0)

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = numenemy = 1 ;&& numpartner = 0
trigger1 = p2name = "Jin" && Authorname = "Speedy9199"
trigger1 = time = 0
value = 10000

[State 190, 2] ;Go straight to intro.
type = ChangeState
triggerall = numenemy = 1 ;&& numpartner = 0
trigger1 = p2name = "Ragna" && Authorname = "Speedy9199"
trigger1 = time = 0
value = 10009;10010

