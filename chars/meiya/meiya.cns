Persistent = 1

[State 3000, ボタン溜め];AI用溜め判定
type = VarSet
triggerall = (Anim = 40)
trigger1 = (Time > 3)
trigger1 = (var(59) = 1 && RoundState = 2) || fvar(1) = 1
v = 25
value = 1
supermovetime = 99999999
pausemovetime = 99999999
IgnoreHitPause = 1
Persistent = 1

[state 3000, ボタン溜めAI時用のリセット]
type = Varset
triggerall = (var(59) = 1 && RoundState = 2) || fvar(1) = 1
triggerall = Statetype   = S || Statetype = C
trigger1 = anim = 1302
trigger2 = Enemynear,Movetype != H
trigger2 = P2Stateno  != [5100,5110]
trigger2 = prevstateno != 227 || prevstateno != 207
trigger3 = prevstateno = 410
trigger3 = Enemynear,Statetype != A && Enemynear,Movetype = H
trigger4 = P2BodyDist X <= -1
trigger5 = prevstateno = 1010
trigger5 = Enemynear,Statetype != A && Enemynear,Movetype = H
trigger6 = Enemynear,Movetype = H && Enemynear,Statetype = A
trigger6 = prevstateno = 1101
trigger6 = (P2BodyDist Y >= -90 && enemynear,vel Y > 0) || (enemynear,vel Y > 1)
trigger7 = Enemynear,Stateno = 5120
trigger7 = Enemynear,Animtime = -7
trigger7 = random < 500
trigger8 = prevstateno = 227 || prevstateno = 207
trigger8 = var(58) = [0,30]
trigger8 = var(26) = 40
trigger9 = prevstateno = 227 || prevstateno = 207
trigger9 = var(58) = [31,99]
v = 25
value = 0
supermovetime = 99999999
pausemovetime = 99999999
IgnoreHitPause = 1
Persistent = 1

[State 3000, 溜め時間];ボタンが押しっぱなしなら変数の値を増やしていく
