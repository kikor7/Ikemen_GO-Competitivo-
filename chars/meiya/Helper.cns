trigger1 = 1
text = "Hit=%d, Count=%d, Proj=%d, Front-Screen-Edge=%d, Speed=%f"
params = (Root,var(27)),var(40),var(41),floor(FrontEdgeDist),(Vel X)

;***********************************
[State 2000, 親の変数];気弾ヒット判定
