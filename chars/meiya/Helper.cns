trigger1 = (Root,ProjContactTime(1305) = 1)
v = 41
value = 1 ;当たる度に１増やす
pausemovetime = 99999999
IgnoreHitPause = 1
Persistent = 1

[State 2000, 溜めレベルを測定2];ヒット数をチャージレベルごとに1・２・３と増やすための変数
