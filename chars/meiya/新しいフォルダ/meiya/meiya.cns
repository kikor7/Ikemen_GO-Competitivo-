anim = 3105       ;超必エフェクトのアクションナンバー。通常は「fightfx.air」のアニメを使うが、
                 ;左に「s」を付ければ「自分のairファイル」のアクションナンバーが使える。
pos = 25, -57    ;超必エフェクトの座標（Ｘ軸,Ｙ軸）
