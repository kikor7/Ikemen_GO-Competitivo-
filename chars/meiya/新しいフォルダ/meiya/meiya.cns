;---------------------------------------------------------------------------
; ※８：ReversalDef
;
; 　攻撃判定ボックス（Clsn1）の設置はHitDefを有効にするためだけでなく、
; 　相手の攻撃を受け止める判定を設ける『ReversalDef』にも使う。
;
; 　実際に攻撃を受け止めるには、「attr」の代わりに
;　「reversal.attr」のパラメータを使い、受け止める相手の攻撃属性を指定する。
; 　それ以外はHitDefと設定の仕方が一緒。
;
; 　ReversalDefの設置について二つ注意する事がある。
;
; 　まず、ReversalDefは『Projectileを受け止める事は出来ない』。
; 　あくまでもこのコントローラは「HitDefを受け止めるもの」であるため。
; 
; 　そしてそのHitDefに関係するもう一つの注意点。
;
;　「HitDefを使っている攻撃用ヘルパー」を受け止める場合、
; 　ReversalDefにP2StateNoを設置していたならば
;　『そのヘルパーがそのステートに変わり、相手キャラに分身してしまう』。
; 　波動拳の気弾などにClsn1のあるヘルパーが使われてる場合は明らかにバグになる。
;　「受け止める目標がヘルパーになってしまった場合に、分身するバグを回避する方法」
; 　を自分・相手両方共に駆使する必要がある。コンプリートゲームなら楽だけどね。
;
; 　ちなみに、『MoveReversed』というトリガーは
;　「相手のReversalDef」に「自分のHitDef」が受け止められた時間を計測するトリガー。
; 　逆に「自分のReversalDef」で相手の攻撃を受け止めた事を判断する場合は、
; 　なぜか「MoveHit」が使える。なんでか教えてよエレクバイト先生！（コラ
; 　まぁReversalDefも「攻撃判定を定義する」系統だからなんだろうけどね。
;
;---------------------------------------------------------------------------
; ※９：HitOverRide
;
; 　この命令はその名の如く、攻撃を食らった時
;　『食らい状態を任意のステートで上書きする事が出来る』命令。
; 　これの応用で『ブロッキング』なども作る事が出来る。
;
; 　しかし相手のHitDefに「P2StateNo」がある場合、自分がHitOverRideで
; 　食らい動作を上書き出来る状態なら、
;　『その攻撃を食らわなくなる（相手のHitDefが空振る）』ので注意。
;
;---------------------------------------------------------------------------
;シールド成功
;[Statedef 702]
;type     = U
;movetype = I
;physics  = N
;ctrl     = 0
;velset   = 0,0
;anim     = ifelse(StateType=A,706,ifelse(StateType=C,704,702))

;[State 702, 音を鳴らす]
;type = PlaySnd
;trigger1 = Time = 0
;value = 26, 0

;[State 702, 状態変更]
;type = StateTypeSet
;trigger1 = StateType = A
;Physics = A
;IgnoreHitPause = 1

;[State 702, ライフ増減]
;type = LifeAdd
;trigger1 = Time = 0
;value = 10 ;ライフが１０ポイント回復
;IgnoreHitPause = 1

;[State 702, 時間停止];自分も相手も制限時間も一時的に止める（ポーズ）
;type = Pause
;trigger1 = Time = 0
;time = 13      ;ポーズする時間（フレーム）
;movetime = 13  ;ポーズ中に動ける時間。timeよりも多いとバグる（デフォルトは０）
;IgnoreHitPause = 1

;[State 702, コントロール]
;type = CtrlSet
;trigger1 = Time = 14
;value = 1

;[State 702, 画面全体の色]
;type = EnvColor
;trigger1 = Time = 0
;value = 255,255,255 ;画面全体を塗り潰す色合い（赤,緑,青）
;time = 1

;[State 702, 軸位置]
;type = PosSet
;trigger1 = StateType != A
;y = 0

;[State 702, 移動速度]
;type = VelSet
;triggerall = StateType = A
;trigger1 = Time = [0,13]
;x = 0
;y = 0

;[State 702, ステート変更]
;type = ChangeState
;trigger1 = (StateType != A) && (AnimTime = 0)
;trigger2 = (StateType = A) && (Time > 19)
;value = ifelse(StateType=A,51,ifelse(StateType=C,11,0))
;ctrl = 1

;===========================================================================


;===========================================================================
; 常時監視ステート（－２）
;===========================================================================
;---------------------------------------------------------------------------
; 通常の食らい状態（Statedef 5000～5199間）でも、
; 相手に（「P2StateNo」や「TargetState」等で）制御を奪われても、
; 常に登録したステートコントローラが有効になります。
; サブシステム等を制御する時に重宝するでしょう。
;---------------------------------------------------------------------------

[Statedef -2]

[State -2, 念タン用]
type = VarRangeSet
trigger1 = (StateNo != 1302)
first = 25
last = 26
value = 0
IgnoreHitPause = 1

[State -2, 念タン用]
type = VarSet
trigger1 = (ProjHitTime(1305) != [1,5])
v = 27
value = 0
IgnoreHitPause = 1

[State -2, 金剛砕硬直解除]
type = Varset
trigger1 = movetype = H
trigger2 = movetype = I
v = 35
value = 0
persistent = 1
ignorehitpause = 1

[State -2, 連続使用制限解除]
type = VarRangeSet
trigger1 = P2Movetype  != H
trigger2 = P2Statetype  = L
first = 16
last  = 20
value = 0
ignorehitpause = 1


[State -2, 連続使用制限解除];エルボー
type = VarSet
trigger1 = P2Movetype  != H
v = 21
value = 0
ignorehitpause = 1

[State -2, 連続使用制限解除];その２
type = VarRangeSet
trigger1 = P2Movetype  != H
trigger2 = P2Statetype  = L
first = 37
last  = 39
value = 0
ignorehitpause = 1

[State -2, Powerゲージ時間で増加]
type = PowerAdd
triggerall = roundstate = 2
trigger1 = gametime%2 = 0
value = 1
ignorehitpause = 1

[State -2, マッスルシフト秒数加算]
type = varadd
trigger1 = var(22) >= 1
v = 23
value = 1

[state -2, マッスルシフト終了時]
type = Helper
trigger1 = var(23) = 1800
trigger2 = var(22) >= 7
postype = p1
pos = 0, 0
stateno = 22017
supermovetime = 9999
pausemovetime = 9999
persistent = 0
ownpal = 1

[State -2, マッスルシフトリセット]
type = varrangeset 
trigger1 = var(23) = 1800
trigger2 = var(22) >= 7
first = 22
last  = 23
value = 0

[State -2, ランダムダメージ]
type = VarRandom
trigger1 = 1
v = 29
range = 85, 115

[State -2, ランダムクリティカル]
type = VarRandom
trigger1 = var(30) >= 15
trigger2 = roundstate = 0
v = 30
range = 0, 14
ignorehitpause = 1

[State -2, ランダムクリティカル]
type = VarAdd
triggerall = stateno != 3120
triggerall = stateno != [3600,3606]
triggerall = stateno != 810
triggerall = stateno != 840
trigger1 = movehit = 1
trigger2 = projhit(1305) = 1
v = 30
value = 1

[State 200, クリティカル演出]
type = allpalfx
triggerall = var(30) > 14
triggerall = stateno != 3120
triggerall = stateno != [3600,3606]
triggerall = stateno != 810
triggerall = stateno != 840
trigger1 = movehit = 1
trigger2 = projhit(1305) = 1
add = 50,0,0
mul = 256,200,200
sinadd = 10, 10, 10
time = 4
ignorehitpause = 1
supermovetime = 9999
pausemovetime = 9999

[state -2, クリティカル文字]
type = Helper
triggerall = var(30) > 14
triggerall = stateno != 3120
triggerall = stateno != [3600,3606]
triggerall = stateno != 810
triggerall = stateno != 840
trigger1 = movehit = 1
trigger2 = projhit(1305) = 1
postype = p2
pos = 0, 30
stateno = 22015
supermovetime = 9999
pausemovetime = 9999
ownpal = 1
sprpriority = 3

;---------------------------------------------------------------------------------------------
;アラド風浮き調整用　コンボ中に与えたダメージ量の比率計算

[State -2, 相手初期HP];浮き設定
type = varset
trigger1 = roundstate = 0
fv = 22
value = P2Life
persistent = 1
ignorehitpause = 1

[State -2, 相手現在HP];浮き設定
type = varset
trigger1 = P2Movetype != H
fv = 21
value = P2Life
persistent = 1
ignorehitpause = 1

[State -2, 与ダメージ比率];浮き設定
type = varset
trigger1 = P2Movetype = H
fv = 20
value = (fvar(21)-(P2Life))/fvar(22)
persistent = 1
ignorehitpause = 1

;---------------------------------------------------------------------------------------------
;ダメージポップアップ
[state -2, 敵ライフ1]
type = varset
trigger1 = hitcount%2 = 0
trigger2 = projhit(1305) = 1
trigger2 = var(7) >= var(8)
trigger3 = p2life > var(7)
v = 7
value = P2Life
ignorehitpause = 1
persistent = 1

[state -2, 敵ライフ2]
type = varset
trigger1 = hitcount%2 != 0
trigger2 = projhit(1305) = 1
trigger2 = var(8) > var(7)
trigger3 = p2life > var(8)
v = 8
value = P2Life
ignorehitpause = 1
persistent = 1

[state -2, 与えたダメージ]
type = varset
trigger1 = movehit = 1
trigger2 = projhittime(1305) = 1
v = 9
value = ifelse(var(8) > var(7) , var(8) - var(7) , var(7) - var(8))
ignorehitpause = 1

[state -2, 千の位　０～５]
