v =10
value = ifelse(var(9) < 6000 , 5000 , ifelse(var(9) < 7000 , 6000 , ifelse(var(9) < 8000 , 7000 , ifelse(var(9) < 9000 , 8000 , 9000))))
ignorehitpause = 1

