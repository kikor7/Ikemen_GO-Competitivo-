;自動振り向き
[State -2, 0]
type = turn
triggerall = p2dist X < -1
triggerall = time >= 0
trigger1 = stateno = 45
trigger2 = stateno = 50
trigger2 = PrevStateno = 45
trigger3 = Stateno = 50
