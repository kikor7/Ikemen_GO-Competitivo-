;相手側２（放り投げられた）
[Statedef 3603]
type    = A
movetype= H
physics = N
velset = 4,0
poweradd = 40

[State 3603, 速度加算];重力
type = VelAdd
trigger1 = 1
y = 0.4 ;現在のＹ軸方向の移動速度を「0.4ポイント」ずつ増やしていく

[State 3603, ステート変更]
type = ChangeState
triggerall = Vel Y > 0
triggerall = Pos Y >= -20
triggerall = alive      ;生きている時
triggerall = CanRecover ;空中受け身が可能な時
trigger1 = Command = "recovery"
value = 5200

[State 3603, 相手ステートに戻す]
type = SelfState
triggerall = Vel Y > 0
triggerall = alive
triggerall = CanRecover
trigger1 = Command = "recovery"
value = 5210

[State 3603, 相手ステートに戻す]
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100

