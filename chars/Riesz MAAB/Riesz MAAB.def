; Definition file for Riesz
; Contains all the filenames needed for the character
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Player Information
[Info]
Name = "Riesz MAAB Sprite by Lingle"          ;Name of character
DisplayName = "Riesz"                         ;Name of character to display
VersionDate = 06,12,2022                      ;Version date of character (MM-DD-YYYY or X.XX)
MugenVersion = 1.1                            ;Version of M.U.G.E.N character works on (X.XX)
Author = "Manny Lingle";曼尼琳各              ;Character author name
Pal.Defaults = 1,2,3,4                        ;Default palettes in order of preference (up to 4)
                                              ;Numbering starts from 1
LocalCoord = 1920,1080;#因人物使用1080P       ;Local coordinate space width and height
                      ;特地寫上注意事項以便提醒(請往下看)↓

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; リース定義ファイル
; キャラに必要なすべてのファイル名が含まれています
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; キャラ情報
[Ja.Info]
Name = "Riesz MAAB Sprite by Lingle"          ;キャラの名前
DisplayName = "リース"                        ;キャラ選択時に表示されるキャラの名前
VersionDate = 06,12,2022                      ;キャラのバージョン。書式は「月,日,年」
MugenVersion = 1.1                            ;キャラを制作したMUGENのバージョン 
Author = "Manny Lingle";曼尼琳各              ;製作者の名前
Pal.Defaults = 1,2,3,4                        ;コンピューターが優先的に使うパレットの番号
                                              ;番号は1から始まります
LocalCoord = 1920,1080;#                      ;解像度横幅の値と縦幅の値

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 莉絲的定義文件
; 包含該人物角色所需的所有文件名稱
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; 人物訊息
[Zh.Info]
Name = "Riesz MAAB Sprite by Lingle"          ;人物名
DisplayName = "莉絲"                          ;人物顯示名
VersionDate = 06,12,2022                      ;人物版本號 (月-日-年 或者 X.XX)
MugenVersion = 1.1                            ;人物對應的MUGEN版本 (X.XX)
Author = "Manny Lingle";曼尼琳各              ;作者名
Pal.Defaults = 1,2,3,4                        ;默認色表順序 (最多4個)
                                              ;序號從1開始
LocalCoord = 1920,1080;#                      ;分辨率寬度和高度

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Files For The Player
; 檔案的連結
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
[Files]
movelist = movelist.dat
Cmd      = RizMAAB-Command.cmd              ;人物手操指令、AI指令
Cns      = RizMAAB-Constants.cns            ;人物基本參數
St       = RizMAAB-Constants.cns            ;人物開頭動作、勝利動作、挑釁動作
St1      = RizMAAB-Statedef-3-2.st          ;[Statedef -3]、[Statedef -2]
St2      = RizMAAB-NormalMoves.st           ;基本技
St3      = RizMAAB-SpecialMoves.st          ;必殺技/特殊技
St4      = RizMAAB-HyperMoves.st            ;超必殺技
St5      = RizMAAB-Helper.st                ;援助者
St6      = RizMAAB-Opponent.st              ;對手動作狀態
St7      = RizMAAB-Config.txt               ;設定檔
StCommon = RizMAAB-Common.cns               ;公用狀態 (如果人物包裡沒有相關的Common檔，這裡寫成common1.cns的話就會讀取data資料夾裡的common1.cns檔)
Sprite   = RizMAAB-Sprite.sff               ;圖片檔
Anim     = RizMAAB-Animation.air            ;動畫檔
Sound    = RizMAAB-Sound.snd                ;音效檔

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Maps character selection buttons to palette numbers.
; 將選人時的按鍵對應到色表上(SFFv2格式)
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
[Palette Keymap]
a = 1
b = 2
c = 3
x = 4
y = 5
z = 6
a2 = 7                                 ;Hold Start and press button A for palette 7.
b2 = 8                                 ;Hold Start and press button B for palette 8.
c2 = 9                                 ;Hold Start and press button C for palette 9.
x2 = 10                                ;Hold Start and press button X for palette 10.
y2 = 11                                ;Hold Start and press button Y for palette 11.
z2 = 12                                ;Hold Start and press button Z for palette 12.

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
; Arcade Mode
; 故事模式
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;[Arcade]
;intro.storyboard =  
;ending.storyboard =

;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
;#人物會在部份16:9寬高場地戰鬥時，會感覺到人物比例過大。
; 主因是在製作場景時未考慮到跟人物的比例關係(ZoomIn和ZoomOut其中一個數字為1或者1以上)。
; 其中一種解決方法就是改變人物的LocalCoord(將數值變大，例如1920,1080改為2048,1440)。
; 但是這樣人物整體的比例都會改變(包含人物自帶的能量條……等圖片素材)，
; 所以建議還是從場景的部份來修改(改變Zoom縮放數值)。
;
; 關於修改場景：場景的ZoomIn和ZoomOut值相同，場景就不會有縮放效果。
; 如果兩數值皆小於1.00數值，人物比例就會在該場景縮小。
; 但是場景的部份參數(例如Start參數)需要再重新調整。

;#人物圖片非常非常大，所以localcoord使用1920x1080

; 補充：經過多次製作人物的記錄，
; 人物的localcoord只推薦使用以下四種，其他比例(非4:3、16:9)在寬屏的場景上會有比例上的Bug錯誤。
; localcoord = 320,240 (低畫質) 系統默認值
; localcoord = 640,480 (HD高畫質) *推薦* 320x240的二倍
; localcoord = 1280,720 (HD寬螢幕高畫質) *推薦* 320x240的四倍
; localcoord = 1920,1080 (Full HD寬螢幕高畫質) 320x240的六倍
; 目的是為了要讓[Size]項目的xscale和yscale參數保持在整數1(減少乘除後出現的小數點，且方便之後的代碼編寫)。

; 人物DEF檔localcoord跟Const720p觸發器的注意事項請看RizMAAB-Common.cns檔案內的說明。
;＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝＝
