;----------------------------------------------------------------
; 花風院 骸羅
;----------------------------------------------------------------
[Info]
name = "Kafuin Gaira"         ;キャラの名前
displayname = "Gaira Caffeine"  ;表示されるキャラの名前
versiondate = 09,25,2001      ;キャラの更新情報
mugenversion = 09,25,2001     ;キャラが動くmugenのバージョン
author = "FUJY"               ;キャラの製作者名
pal.defaults = 3,1,2,4        ;敵としてでるキャラのパレット

; Files for the player
[Files]
movelist = movelist.dat
cmd     = Gaira.cmd      ;キャラのコマンド
cns     = Gaira.cns      ;キャラのプログラム
st      = Gaira.cns      ;キャラのプログラム
st1     = Gaira-N.cns    ;通常攻撃・特殊攻撃・通常投げのステート
st2     = Gaira-S.cns    ;必殺技のステート
st3     = Gaira-H.cns    ;超必殺技のステート
stcommon = common1.cns 
sprite  = Gaira.sff      ;キャラの絵
anim    = Gaira.air      ;キャラの動き
sound   = Gaira.snd      ;キャラの音
pal1    = Gaira01.act    ;キャラの色（最大１２個）
pal2    = Gaira02.act
pal3    = Gaira03.act
pal4    = Gaira04.act