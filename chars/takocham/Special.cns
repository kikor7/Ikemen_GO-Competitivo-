;===========================================================================
; 必殺技
;===========================================================================
;スライサーＡ
[Statedef 1000]
type     = U
movetype = A
physics  = N
poweradd = 20
ctrl     = 0
anim     = 1000

;***********************************
[State 1000, 状態変更]
type = StateTypeSet
trigger1 = (StateType = A)
Physics = A
IgnoreHitPause = 1
Persistent = 1

[State 1000, 物理的なキャラの幅]
type = Width
triggerall = (StateType != A)
trigger1 = (AnimElemTime(5) > 0) && (AnimElemTime(16) < 0)
player = 30,0
edge = 45,0

[State 1000, 埃]
type = MakeDust
triggerall = (StateType != A)
trigger1 = Time = 10
pos = 40,0
spacing = 1

;***********************************
[State 1000, 軸位置]
type = PosSet
trigger1 = (StateType != A)
y = 0

[State 1000, 移動速度]
type = VelSet
trigger1 = (StateType != A)
x = -0.3
y = 0

;***********************************
[State 1000, 音を鳴らす]
type = PlaySnd
trigger1 = AnimElem = 7
value = 2,5
channel = 1

[State 1000, 音を鳴らす]
type = PlaySnd
triggerall = (var(28) = [1,40])
trigger1 = AnimElem = 6
value = 4,7

[State 1000, 音を鳴らす]
type = PlaySnd
triggerall = (var(28) = [41,80])
trigger1 = AnimElem = 6
value = 5,1

[State 1000, 音を鳴らす]
type = PlaySnd
triggerall = (var(28) = [81,120])
trigger1 = AnimElem = 6
value = 4,9

;***********************************
[State 1000, 飛び道具]
type = Projectile
triggerall = (Anim = 1000)
trigger1 = AnimElem = 7
attr             = S, SP
damage           = ceil(30*fvar(0)),6
getpower = 30,15
animtype	= back
air.animtype	= back
pausetime        = 0,12
;-----------------------------------
offset           = 35,-45
velocity         = 5,ifelse((StateType=A),1,-1)
accel            = 0,0
projID           = 1000
projanim         = ifelse((var(28) = [1,17]),3000,ifelse((var(28) = [18,34]),3001,ifelse((var(28) = [35,51]),3002,ifelse((var(28) = [52,69]),3003,ifelse((var(28) = [70,84]),3004,ifelse((var(28) = [85,102]),3005,3006))))))
projscale        = .7,.7
projshadow       = 0,0,0
projhits         = 2
projmisstime     = 5
projpriority     = 3
projremovetime   = -1
projsprpriority  = 4
;-----------------------------------
HitFlag		= MAF
guardflag        = MA
priority         = 3
sparkno          = s(var(45))
sparkxy          = 30,0
guard.sparkno    = s4216
hitsound         = s0,6
guardsound       = s0,10
ground.type      = High
ground.slidetime = 10
ground.hittime   = 10
ground.velocity	= -4,-5
guard.velocity	= -7
air.velocity	= -4,-5
air.juggle       = 5
air.fall	= 1
ground.cornerpush.veloff= 0
guard.cornerpush.veloff	= 0
air.cornerpush.veloff	= 0
yaccel		= .5
fall		= 1
fall.recovertime= 25
fall.recover	= 0

;***********************************
[State 1000, ステート変更]
type = ChangeState
triggerall = (StateType != A)
trigger1 = AnimTime = 0
value = 0
ctrl = 1

