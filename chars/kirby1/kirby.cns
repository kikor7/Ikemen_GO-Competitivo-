trigger2 = enemy,name = "Dedede"
trigger3 = enemy,name = "DEDEDE 339" 
trigger4 = enemy,name = "Daroach"
value = 19

[State 0, VictoryQuote]
type = VictoryQuote
triggerall = PalNo >= 10
triggerall = enemy,authorname != "Mayyyro" || (enemy,authorname = "Mayyyro" && enemy,palno < 10)
trigger1 = enemy,name = "Kirby"
trigger2 = enemy,name = "Kirby The Star Warrior"
trigger3 = enemy,name = "D4Kirby"
trigger4 = enemy,name = "Kirby MYTHOS"
value = 20


[State 0, VictoryQuote]
type = VictoryQuote
triggerall = PalNo >= 10
trigger1 = enemy,name = "SuperMario"
trigger2 = enemy,name = "Mario"
trigger3 = enemy,name = "Super Better Mario V3"
value = 21

[State 0, VictoryQuote]
type = VictoryQuote
triggerall = PalNo >= 10
trigger1 = enemy,name = "Shadow The Hedgehog"
trigger2 = enemy,name = "ShadowMH"
trigger3 = enemy,name = "Ow The Edge"
value = 22

;---------------------------------------------------------------------------
; States that are executed when in self's state file (use statedef -3)
;---------------------------------------------------------------------------

[Statedef -3]

[State -3, Variable Height]
type = PlayerPush
triggerAll = StateType = A && MoveType != H && NumEnemy
triggerAll = P2BodyDist x = [-(EnemyNear, const(size.ground.back) + EnemyNear, const(size.ground.front)), 0]
trigger1 = P2StateType = S
trigger1 = P2Dist y >= (EnemyNear, const(size.height) - 12)
trigger2 = P2StateType = C
trigger2 = P2Dist y >= (EnemyNear, const(size.height) - 28)
trigger3 = P2StateType = L
trigger3 = P2Dist y >= 12
value = 0
ignoreHitPause = 1


[State 0, PlaySnd]
type = StopSnd
trigger1 = prevstateno = 1000
channel = 18

[State 0, PlaySnd]
type = StopSnd
trigger1 = prevstateno = 1201
channel = 17

[State 0, VarSet]
type = VarSet
trigger1 = numhelper(2310)
fv = 16    ;fv = 10
value = helper(2310),p2dist x

[State 0, VarSet]
type = VarSet
trigger1 = !numhelper(2310)
fv = 16    ;fv = 10
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = StateNo != [40,44]
v = 5   ;fv = 10
value = 0
;ignorehitpause = 
;persistent = 

[State 0, VarSet]
type = VarSet
trigger1 = statetype = s
v = 45   ;fv = 10
value = 0

[State 0, VarSet]
type = VarSet
trigger1 = statetype = s
v = 47   ;fv = 10
value = 0

; Sound effects and voices

[State -3, Light Hurt Sound]
type = PlaySnd
triggerall = gethitvar(animtype) = 0
triggerall = time = 0
triggerall = random < 100
trigger1 = StateNo = [5000,5070]
value = S12,0+random%2
channel = 0



[State -3, Med Hurt Sound]
type = PlaySnd
triggerall = gethitvar(animtype) = 1
triggerall = time = 0
triggerall = random < 300
trigger1 = StateNo = [5000,5070]
value = S12,2+random%2
channel = 0

[State -3, Heavy Hurt Sound]
type = PlaySnd
triggerall = gethitvar(animtype) = [2,5]
triggerall = time = 0
triggerall = random < 500
trigger1 = StateNo = [5000,5070]
value = S12,4+random%2
channel = 0


[State -3, Walk sound]
type = PlaySnd
triggerall = stateno = 20
trigger1 = AnimElem = 2 || AnimElem = 7
value = S8, 3

[State -3, run sound]
type = PlaySnd
triggerall = stateno = 100
trigger1 = AnimElemTime(2) = 0
trigger2 = AnimElemTime(7) = 0
value = S8, 4
volumescale = 100

[State -3, Jump sound]
type = PlaySnd
triggerall = Time = 0
trigger1 = stateno = 45 && prevstateno != 40
value = S8, 5

[State -3, Landing Sound]
type = PlaySnd
triggerall = Time = 1
trigger1 = stateno = 52 ;Jump land
trigger2 = stateno = 106 ;Run-back land
value = S8, 2

[state -3, AI Detect Projectile System]
type = helper
trigger1 = ailevel ;M.U.G.E.N 1.0+
;trigger1 = var(59) = 1 ;M.U.G.E.N below 1.0 that uses Winane's AI Activation Method.
trigger1 = !numhelper(33333333)
name = "AI Detect Projectile System"
ID = 33333333
stateno = 33333333
postype = p1
ownpal = 1
keyctrl = 0
size.xscale = 1.0
size.yscale = 1.0
supermovetime = 2147483647
pausemovetime = 2147483647
ignorehitpause = 1
