trigger1 = 1
flag = noshadow
flag2 = noautoturn

[State 800, +o-]
trigger1 = Time = 0
persistent = 0
type = VarSet
v = 1
value = 1
[State 800, +o-]
trigger1 = Time = 0 && (1+floor(Random*100/1000.0)) > 50
persistent = 0
type = VarSet
v = 1
value = -1

[State 800, NumberDebris]
trigger1 = Time = 0
persistent = 0
type = MapSet
Map = "TopeDebris"
value = (4+floor(Random*6/1000.0))

[State 333, Debris1]
trigger1 = Time = [10,50] && NumExplod < Map(TopeDebris) && (1+floor(Random*100/1000.0)) < 20
type = Explod
anim = (75+floor(Random*2/1000.0))
space = stage
pos = Pos X + CameraPos X, Pos Y - 10
vel = (50+floor(Random*61/1000.0))*Var(1)/80,-2.0
accel = 0,0.12
random = 20,0
RemoveTime = 120
supermove = 1
facing = facing
sprpriority = 8
ID = 77
ontop = 1
facing = Var(1)

[State 333, DebrisBounce]
type = ModifyExplod
trigger1 = Time = 65
space = stage
vel = 0.4 * Var(1),-2
ID = 77
[State 333, DebrisBounce]
type = ModifyExplod
trigger1 = Time = 95
space = stage
vel = 0.4 * Var(1),-1
ID = 77
[State 333, DebrisBounce]
