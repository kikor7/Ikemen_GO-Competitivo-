;Starts looking around,
;until START animation
;Then Idle
;Look around once in a while
;Update position after being left behind,
;not while marking points
;follow hits
;normal hits change animation
;strong fall hits imply sound *and slowdown* 1/3 of the times
;when round ends, look around.
;then put away and bow and idle?

;If match over, when Round Over throw confetti
;If perfect, when Round Over show up 4 more around, 
;put away, clap and bow
;then throw confetti

;Movement is kinda simple,
;as is Ippon.
;Ippon is only scored if within reasonable distance from players
;Movement will take center screen position 
;and measure against that
;For flipping, account for: 
;team who got hit (p1 = white, p2 = red)
;Position of hitting party - Position of hit party; 
;< 0 then turn left
;> 0 then turn right(default)
;For Ippon:
;p1 is white flag
;p2 is red flag

; LookAround [Begin Action 7]
; Clap [Begin Action 11]
; PutAway [Begin Action 12]
; Bow [Begin Action 13]
; Confetti [Begin Action 14]
; ConfettiFlip [Begin Action 15]
; Idle = 18
; Draw = 21

;Sounds: 
;0,0 = BIG Ippon
;0,2 = Clap
;KUROCLONE--------------------------------------------------------------------------------------
[Statedef 602]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = -0.01,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 9                       ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = -5                  ;Set p1's sprite layering priority to 2 (in front)
