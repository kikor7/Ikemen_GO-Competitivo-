;--------------------------------------------------------------------------
;-Gen An
;Fogata Sana [Begin Action 73]
;Fogata se rompe [Begin Action 74]
;trozos de fogata [Begin Action 76] [Begin Action 75]
[Statedef 820];
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                    ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 73                     ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 9                  ;Set p1's sprite layering priority to 2 (in front)

[State 600, NoShadowAndNoOtherStuffs]
trigger1 = HelperName = "RightGen2" || HelperName = "LeftGen2" 
type = sprpriority
value = -4

[State 600, NoShadowAndNoOtherStuffs]
type = Assertspecial
trigger1 = 1
flag = noshadow
flag2 = noautoturn

[State 333, NoProjectileOrThrowHit]
Time = 2
trigger1 = 1
type = NotHitBy
value = ,AT
[State 333, NoProjectileOrThrowHit]
trigger1 = 1
Time = 2
type = NotHitBy
value = ,AP

[State 415, DieStanding]
Trigger1 = 1
stateno = 821
attr = SCA, AA, AP, AT
time = 1
type = HitOverride
slot = 2

[State 333, NotNormallyHit]
trigger1 = Root,Map(DestructiblesEspeciales) = 1776
Time = 1
type = NotHitBy
value = ,NA,AT

[State 333, NoHitByAnyoneUnlessAttackingANDInList]
;si está lejos, o no ataca, o no corta
;si corta, ataca y está cerca que deje de renovarse la inv.
trigger1 = Abs(player(1),Pos Y - Pos Y) > 59 || player(1),movetype != A || player(1),Map(LasombraCortante) != 1789
trigger1 = Abs(player(2),Pos Y - Pos Y) > 59 || player(2),movetype != A || player(2),Map(LasombraCortante) != 1789
trigger1 = Abs(player(3),Pos Y - Pos Y) > 59 || player(3),movetype != A || player(3),Map(LasombraCortante) != 1789
trigger1 = Abs(player(4),Pos Y - Pos Y) > 59 || player(4),movetype != A || player(4),Map(LasombraCortante) != 1789
trigger1 = Abs(player(5),Pos Y - Pos Y) > 59 || player(5),movetype != A || player(5),Map(LasombraCortante) != 1789
trigger1 = Abs(player(6),Pos Y - Pos Y) > 59 || player(6),movetype != A || player(6),Map(LasombraCortante) != 1789
trigger1 = Abs(player(7),Pos Y - Pos Y) > 59 || player(7),movetype != A || player(7),Map(LasombraCortante) != 1789
trigger1 = Abs(player(8),Pos Y - Pos Y) > 59 || player(8),movetype != A || player(8),Map(LasombraCortante) != 1789
triggerall = IsHelper(1) = 0
triggerall = IsHelper(2) = 0
triggerall = IsHelper(3) = 0
triggerall = IsHelper(4) = 0 && Root,Map(LasombraCortante) = 1789
triggerall = IsHelper(4101) = 0
Time = 1
type = NotHitBy
value = SCA
