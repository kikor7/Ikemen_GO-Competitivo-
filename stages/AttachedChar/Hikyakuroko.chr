ID = 2
scale = 1,1
[State 666, SoundFall]
type = PlaySnd
triggerall = (playerid(Var(11)), Vel Y) > 0 && playerid(var(11)),Pos Y >= -6
trigger1 = (playerid(Var(11)), hitfall) = 1 || playerid(Var(11)), MoveType = H
persistent = 60
value = 70,1

[State 666, Follow];
type = ModifyExplod
trigger1 = 1
ID = 1
