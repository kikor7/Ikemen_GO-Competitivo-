value = GetHitVar(ID)
type = MapSet
map = "WhoHitMe"

[State 777, DTC];
Trigger1 = 1
type = DisplayToClipBoard
text="X:%v"
params = Map(WhoHitMe)

[State 800, EnemyLeftOrRight]
trigger1 = 1
persistent = 0
type = MapSet
map = "DireccionEnemigo"
value = 1
[State 800, EnemyLeftOrRight]
trigger1 = PlayerID(Map(WhoHitMe)),Pos X > Pos X
persistent = 0
type = MapSet
map = "DireccionEnemigo"
value = -1
[State 800, EnemyLeftOrRight]
trigger1 = Map(DireccionEnemigo) != Facing && Time = 0
persistent = 0
type = Turn

[State 600, NoShadowAndNoOtherStuffs]
