pos = playerid(var(11)),Pos X + CameraPos X, Var(1)+10
sprpriority = 9
RemoveTime = -2
ID = 1
bindtime = -1
ontop = 1

[State 666, Jumping];
type = RemoveExplod
trigger1 = (playerid(Var(11)), Vel Y) < 0
ID = 1
[State 666, SoundJumpOrAttack]
