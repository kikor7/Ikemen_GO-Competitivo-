;Because this is an attached character, none of these constants matter.
;They basically don't exist.


[Data]
;Amount of life to start with
life = 1000
;attack power (more is stronger)
attack = 100
;defensive power (more is stronger)
defence = 100
;Percentage to increase defense everytime player is knocked down
fall.defence_up = 50
;Time which player lies down for, before getting up
liedown.time = 60
;Number of points for juggling
airjuggle = 15
;Default hit spark number for HitDefs
sparkno = 2
;Default guard spark number
guard.sparkno = 40
;1 to enable echo on KO
KO.echo = 0
;Volume offset (negative for softer)
volume = 0
;Variables with this index and above will not have their values
;reset to 0 between rounds or matches. There are 60 int variables,
;indexed from 0 to 59, and 40 float variables, indexed from 0 to 39.
;If omitted, then it defaults to 60 and 40 for integer and float
;variables repectively, meaning that none are persistent, i.e. all
;are reset. If you want your variables to persist between matches,
;you need to override state 5900 from common1.cns.
IntPersistIndex = 60
FloatPersistIndex = 40

[Size]
xscale = 1           ;Horizontal scaling factor.
yscale = 1           ;Vertical scaling factor.
ground.back = 15     ;Player width (back, ground)
ground.front = 16    ;Player width (front, ground)
air.back = 12        ;Player width (back, air)
air.front = 12       ;Player width (front, air)
height = 60          ;Height of player (for opponent to jump over)
attack.dist = 160    ;Default attack distance
proj.attack.dist = 90 ;Default attack distance for projectiles
proj.doscale = 0     ;Set to 1 to scale projectiles too
head.pos = -5, -90   ;Approximate position of head
mid.pos = -5, -60    ;Approximate position of midsection
shadowoffset = 0     ;Number of pixels to vertically offset the shadow
draw.offset = 0,0    ;Player drawing offset in pixels (x, y). Recommended 0,0

[Velocity]
walk.fwd  = 2.4      ;Walk forward
walk.back = -2.2     ;Walk backward
run.fwd  = 4.6, 0    ;Run forward (x, y)
run.back = -4.5,-3.8 ;Hop backward (x, y)
jump.neu = 0,-8.4    ;Neutral jumping velocity (x, y)
jump.back = -2.55    ;Jump back Speed (x, y)
jump.fwd = 2.5       ;Jump forward Speed (x, y)
runjump.back = -2.55,-8.1 ;Running jump speeds (opt)
runjump.fwd = 4,-8.1      ;.
airjump.neu = 0,-8.1      ;.
airjump.back = -2.55      ;Air jump speeds (opt)
airjump.fwd = 2.5         ;.
air.gethit.groundrecover = -.15,-3.5  ;Velocity for ground recovery state (x, y) **MUGEN 1.0**
air.gethit.airrecover.mul = .5,.2     ;Multiplier for air recovery velocity (x, y) **MUGEN 1.0**
air.gethit.airrecover.add = 0,-4.5    ;Velocity offset for air recovery (x, y) **MUGEN 1.0**
air.gethit.airrecover.back = -1       ;Extra x-velocity for holding back during air recovery **MUGEN 1.0**
air.gethit.airrecover.fwd = 0         ;Extra x-velocity for holding forward during air recovery **MUGEN 1.0**
air.gethit.airrecover.up = -2         ;Extra y-velocity for holding up during air recovery **MUGEN 1.0**
air.gethit.airrecover.down = 1.5      ;Extra y-velocity for holding down during air recovery **MUGEN 1.0**

[Movement]
airjump.num = 1       ;Number of air jumps allowed (opt)
airjump.height = 35   ;Minimum distance from ground before you can air jump (opt)
yaccel = .44          ;Vertical acceleration
stand.friction = .85  ;Friction coefficient when standing
crouch.friction = .82 ;Friction coefficient when crouching
stand.friction.threshold = 2          ;If player's speed drops below this threshold while standing, stop his movement **MUGEN 1.0**
crouch.friction.threshold = .05       ;If player's speed drops below this threshold while crouching, stop his movement **MUGEN 1.0**
air.gethit.groundlevel = 25           ;Y-position at which a falling player is considered to hit the ground **MUGEN 1.0**
air.gethit.groundrecover.ground.threshold = -20 ;Y-position below which falling player can use the recovery command **MUGEN 1.0**
air.gethit.groundrecover.groundlevel = 10   ;Y-position at which player in the ground recovery state touches the ground **MUGEN 1.0**
air.gethit.airrecover.threshold = -1  ;Y-velocity above which player may use the air recovery command **MUGEN 1.0**
air.gethit.airrecover.yaccel = .35    ;Vertical acceleration for player in the air recovery state **MUGEN 1.0**
air.gethit.trip.groundlevel = 15      ;Y-position at which player in the tripped state touches the ground **MUGEN 1.0**
down.bounce.offset = 0, 20            ;Offset for player bouncing off the ground (x, y) **MUGEN 1.0**
down.bounce.yaccel = .4               ;Vertical acceleration for player bouncing off the ground **MUGEN 1.0**
down.bounce.groundlevel = 12          ;Y-position at which player bouncing off the ground touches the ground again **MUGEN 1.0**
down.friction.threshold = .05         ;If the player's speed drops below this threshold while lying down, stop his movement **MUGEN 1.0**

;---------------------------------------------------------------------------
[Statedef 666]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 0                       ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = -9                  ;Set p1's sprite layering priority to 2 (in front)

[State 666, 1];Allow to move out of camera
type = Screenbound
trigger1 = 1

[State 666, 2];Spikes Hit
trigger1 = 1
type = HitDef
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 1, 0                   ;Damage that move inflicts, guard damage
animtype = Heavy                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag =                      ;Flags on how move is to be guarded against; unblockable
hitflag = MAFD                  ;Flags of conditions that move can hit
guard.dist = 1 ;don't trigger blocking
priority = 7, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 0, 0                 ;Time attacker pauses, time opponent shakes
sparkno = 0                      ;Spark anim no (Def: set above)
sparkxy = 0, (enemynear, pos y - enemynear,Const(size.height)/2);
hitsound = S0, 0                  ;Sound to play on hit
guardsound = S0, 0                ;Sound to play on guard
ground.type = Trip               ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 11             ;Time opponent is in hit state
ground.velocity = -8             ;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.4,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 15                 ;Time before opponent regains control in air
p2facing = -1
p2stateno = 820

[State 666, 2];No blocking triggered on P2
type = AttackDist
trigger1 = 1
value = 0

[State 666, 3];draw behind dammit
type = SprPriority
trigger1 = 1
value = -9

[State 666, 4];
type = AssertSpecial
trigger1 = 1
flag = noautoturn

;Enemy Falling after being hit, copied from KFM throw------------------------------------
[Statedef 820]
type    = A
movetype= H
physics = N
poweradd = 0

[State 820, 0];Hurt anim
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

[State 820, 1];Stop in place
type = VelSet
Trigger1 = Time < 20
x = 0
y = 0

[State 820, 2];Invinc to avoid double hit by spikes AND juggling - this is accurate to source
trigger1 = 1
type = NotHitBy
value = SCA

;[State 820, 3];Shake
;Trigger1 = 1
;type = offset
;x = 1*sin(gametime*60)
;y = 1*sin(gametime*60)

[State 820, 4] ;Speed
trigger1 = Time > 20
persistent = 0
Type = VelSet
x = 3
y = -4

[State 820, 5] ;Gravity
type = VelAdd
Trigger1 = Time > 20
y = .4

[State 820, 6] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground


;------------------------------------------------------------------------------------------------------------------------------------------------------
[Statedef 777];Oil Manager
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 1                     ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 9                  ;Set p1's sprite layering priority to 2 (in front)

[State 777, NoShadow]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = NoHardcodedKeys
flag3 = noautoturn
flag4 = invisible
[State 777, 1];Allow to move out of camera
type = Screenbound
trigger1 = 0
[State 777, 2];No turn around
type = AssertSpecial
trigger1 = 1
flag = noautoturn
[State 777, 3];No Push
trigger1 = 1
type = PlayerPush
value = 0
[State 777, 4];No blocking triggered on P2
type = AttackDist
trigger1 = 1
value = 0
[State 777, 5];draw behind dammit
type = SprPriority
trigger1 = 1
value = -5

[State 777, ShowMeYourIDs]
;Record every player's ID at all times
Trigger1 = Time = 1
Trigger1 = var(11) := player(1), ID
Trigger1 = var(12) := player(2), ID
Trigger1 = var(13) := player(3), ID
Trigger1 = var(14) := player(4), ID
Trigger1 = var(15) := player(5), ID
Trigger1 = var(16) := player(6), ID
Trigger1 = var(17) := player(7), ID
Trigger1 = var(18) := player(8), ID
type = null

[State 777, SetPosXP1]
type = VarSet
trigger1 = NumExplod(Var(11)) = 0
trigger2 = PlayerID(Var(11)), Pos Y != 0
v = 1
value = (PlayerID(Var(11)), Pos X)
[State 777, StoppedAndOnTheGround]
trigger1 = PlayerID(Var(11)), Pos Y = 0
trigger1 = PlayerID(Var(11)), Vel X = 0
trigger1 = NumExplod(Var(11)) = 0
type = Explod
anim = 0;Empty Anim
removetime = 220;IntertiaTime
ID = Var(11)
[State 777, StayInSpotP1]
Trigger1 = NumExplod(Var(11)) = 1
Trigger1 = PlayerID(Var(11)), Pos Y = 0
type = PosSet
x = Var(1)
RedirectID = Var(11)
[State 777, MoreSpeedP1]
;More Speed For P1 all the time
trigger1 = PlayerID(Var(11)), Pos Y = 0
Trigger1 = PlayerID(Var(11)), Vel X < 9 
Trigger1 = PlayerID(Var(11)), Vel X > -9 
Trigger1 = PlayerID(Var(11)),StateNo != 820 && PlayerID(Var(11)),StateNo != 5110
type = VelMul
x = 1.4
RedirectID = Var(11)

[State 777, DTC];
Trigger1 = 1
type = DisplayToClipBoard
text="NumExplod(Var(11)):%d, Var(1):%d"
params = NumExplod(Var(11)), Var(1)

