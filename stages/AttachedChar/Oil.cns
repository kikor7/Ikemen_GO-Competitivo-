[State 777, DTC];
Trigger1 = 1
type = DisplayToClipBoard
text="Vel X: %d, Var(1): %d"
params = (PlayerID(Var(11)), Vel X), Var(1)
;---------------------------------------------------------------
[Statedef -4]
[State 1, 0];Spawn Helper
type = helper
ignorehitpause = 1
trigger1 = !ishelper
trigger1 = NumHelper(1) = 0
Trigger1 = Time = 1
name = "Aceite"
ID = 1
stateno = 777
pos = 0,0;
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 99999
pausemovetime = 99999
size.ground.back = 20
size.ground.front = 20
size.height = 100
immortal = 1

[State 1, 2];Fix Player
type = TagOut
trigger1 = !ishelper
ignorehitpause = 1

[State 1, 3];Fix Player
type = Assertspecial
trigger1 = !ishelper
persistent = 0
flag = invisible
flag2 = NoHardcodedKeys
flag3 = noautoturn
flag4 = noshadow
ignorehitpause = 1