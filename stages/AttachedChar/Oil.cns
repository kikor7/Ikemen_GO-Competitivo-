;InertiaTime
;Trigger1 = PlayerID(Var(18)),StateNo != 820 && PlayerID(Var(18)),StateNo != 5110
;------------------------------------------------------------------------------------------------------------------------------------------------------
[Statedef 777];Oil Manager
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 0                      ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 9                  ;Set p1's sprite layering priority to 2 (in front)

[State 777, NoShadow]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = NoHardcodedKeys
flag3 = noautoturn
[State 777, 1];Allow to move out of camera
type = Screenbound
trigger1 = 0
[State 777, 2];No turn around
type = AssertSpecial
trigger1 = 1
flag = noautoturn
[State 777, 3];No Push
trigger1 = 1
type = PlayerPush
value = 0
[State 777, 4];No blocking triggered on P2
type = AttackDist
trigger1 = 1
value = 0
[State 777, 5];draw behind dammit
type = SprPriority
trigger1 = 1
value = -5

[State 777, ShowMeYourIDs]
;Record every player's ID at all times
Trigger1 = Time = 1
Trigger1 = var(11) := player(1), ID
Trigger1 = var(12) := player(2), ID
Trigger1 = var(13) := player(3), ID
Trigger1 = var(14) := player(4), ID
Trigger1 = var(15) := player(5), ID
Trigger1 = var(16) := player(6), ID
Trigger1 = var(17) := player(7), ID
Trigger1 = var(18) := player(8), ID
type = null

[State 777, SetPosXP1]
type = VarSet
trigger1 = NumExplod(Var(11)) = 0
trigger2 = PlayerID(Var(11)), Pos Y != 0
v = 1
value = (PlayerID(Var(11)), Pos X)
[State 333, StoppedAndOnTheGround]
trigger1 = PlayerID(Var(11)), Pos Y = 0
trigger1 = PlayerID(Var(11)), Vel X = 0
trigger1 = NumExplod(Var(11)) = 0
type = Explod
anim = 999;Empty Anim
removetime = 220;IntertiaTime
ID = Var(11)
[State 777, StayInSpotP1]
Trigger1 = NumExplod(Var(11)) = 1
Trigger1 = PlayerID(Var(11)), Pos Y = 0
type = PosSet
x = Var(1)
RedirectID = Var(11)
[State 777, MoreSpeedP1]
;More Speed For P1 all the time
trigger1 = PlayerID(Var(11)), Pos Y = 0
Trigger1 = PlayerID(Var(11)), Vel X < 9 
Trigger1 = PlayerID(Var(11)), Vel X > -9 
type = VelMul
x = 1.4
RedirectID = Var(11)

