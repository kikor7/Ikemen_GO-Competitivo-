;Enemy Falling after being hit, copied from KFM throw
[Statedef 820]
type    = A
movetype= H
physics = N
poweradd = 0

[State 820, InvisbleWhileBurning]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2 = NoHardcodedKeys
flag3 = noautoturn
flag4 = noshadow

[State 820, 0];Hurt anim
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

[State 820, 2];Invinc to avoid double hit by blast AND juggling - this is accurate to source
trigger1 = 1
type = NotHitBy
value = SCA

[State 820, 4] ;Speed
trigger1 = Time = 1
persistent = 0
Type = VelSet
x = -5
y = -6

[State 820, 5] ;Gravity
type = VelAdd
Trigger1 = Time > 1
y = .4

[State 820, 6] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground

