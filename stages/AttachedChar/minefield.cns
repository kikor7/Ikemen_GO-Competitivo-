;3 minas, una cada X distancia.
;Cada mina es un Helper.
;Variables: Daño, RespawnTime
;Var 1 del helper es cuánto lleva "fuera"
;Idle animation - anim 2
;Lo tocan
;Explota - anim 0
;Cambia a anim 6 y es invisible durante RespawnTime
;Pop - termina RespawnTime y anim 6...

;------------------------------------------------------------------------------------------------------------------------------------------------------
[Statedef 333];Respawn, stay idle, trigger
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 6                      ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 9                  ;Set p1's sprite layering priority to 2 (in front)

[State 333, NoShadowMines]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = NoHardcodedKeys
flag3 = noautoturn
[State 333, 1];Allow to move out of camera
type = Screenbound
trigger1 = 0
[State 333, 2];No turn around
type = AssertSpecial
trigger1 = 1
flag = noautoturn
[State 333, 3];No Push
trigger1 = 1
type = PlayerPush
value = 0
[State 333, 4];No blocking triggered on P2
type = AttackDist
trigger1 = 1
value = 0
[State 333, 5];draw behind dammit
type = SprPriority
trigger1 = 1
value = -5

[State 333, StopRespawnAnim]
trigger1 = Time > 10
trigger1 = AnimTime = 0
type = ChangeAnim
value = 2

[State 333, STOPHITTINGPPLDAMMIT]
Type = StateTypeSet
Trigger1 = RoundState != 2
movetype = I
[State 333, OkHitThem]
Type = StateTypeSet
Trigger1 = RoundState = 2 && Time > 300
movetype = A

[State 333, Triggered]
Trigger1 = 1
type = HitDef
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 0, 0                   ;Damage that move inflicts, guard damage
animtype = Heavy                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag =                      ;Flags on how move is to be guarded against; unblockable
hitflag = MAFD                  ;Flags of conditions that move can hit
guard.dist = 0 ;don't trigger blocking
fall = 0						;enemy must fall
priority = 7, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 0, 0                 ;Time attacker pauses, time opponent shakes
sparkno = -1;0;S14                      ;Spark anim no (Def: set above)
sparkxy = 0,170; (enemynear, pos y - enemynear,Const(size.height/2);
;X-offset for the "hit spark" rel. to p2, Y-offset for the spark rel. to p1
;hitsound = S0, 0                  ;Sound to play on hit
;guardsound = S0, 0                ;Sound to play on guard
ground.type =  none              ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 11             ;Time opponent is in hit state
ground.velocity = -8             ;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.4,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 15                 ;Time before opponent regains control in air
p1stateno = 334
ground.cornerpush.veloff = 0
;-----------------------------------------------------------------------------------------------------------------------------------------------------
[Statedef 334];Blow up
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= A                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 0                        ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = 9                  ;Set p1's sprite layering priority to 2 (in front)

;Record every player's ID at all times
[State 334, ShowMeYourIDs]
Trigger1 = var(11) := player(1), ID
Trigger1 = var(12) := player(2), ID
Trigger1 = var(13) := player(3), ID
Trigger1 = var(14) := player(4), ID
Trigger1 = var(15) := player(5), ID
Trigger1 = var(16) := player(6), ID
Trigger1 = var(17) := player(7), ID
Trigger1 = var(18) := player(8), ID
Trigger1 = 1
type = null

[State 334, 1];Allow to move out of camera
type = Screenbound
trigger1 = 0
[State 334, 2];No turn around
type = AssertSpecial
trigger1 = 1
flag = noautoturn
[State 334, 3];No Push
trigger1 = 1
type = PlayerPush
value = 0
[State 334, 4];No blocking triggered on P2
type = AttackDist
trigger1 = 1
value = 0
[State 334, 5];draw behind dammit
type = SprPriority
trigger1 = 1
value = -5
[State 334, NoShadowMines]
type = AssertSpecial
trigger1 = 1
flag = noshadow
flag2 = NoHardcodedKeys
flag3 = noautoturn

[State 334, Boom]
Trigger1 = Roundstate = 2
type = HitDef
attr = S, NA                     ;Attribute: Standing, Normal Attack
damage = 20, 0                   ;Damage that move inflicts, guard damage
animtype = Heavy                 ;Animation type: Light, Medium, Heavy, Back (def: Light)
guardflag =                      ;Flags on how move is to be guarded against; unblockable
hitflag = MAFD                  ;Flags of conditions that move can hit
guard.dist = 1 ;don't trigger blocking
fall = 1						;enemy must fall
priority = 7, Hit                ;Attack priority: 0 (least) to 7 (most), 4 default
;Hit/Miss/Dodge type (Def: Hit)
pausetime = 0, 0                 ;Time attacker pauses, time opponent shakes
sparkno = 0;S14                      ;Spark anim no (Def: set above)
sparkxy = 0,170; (enemynear, pos y - enemynear,Const(size.height/2);
;X-offset for the "hit spark" rel. to p2, Y-offset for the spark rel. to p1
;hitsound = S0, 0                  ;Sound to play on hit
;guardsound = S0, 0                ;Sound to play on guard
ground.type =  Trip              ;Type: High, Low, Trip (def: Normal)
ground.slidetime = 5             ;Time that the opponent slides back
ground.hittime  = 11             ;Time opponent is in hit state
ground.velocity = -8             ;Velocity at which opponent is pushed
airguard.velocity = -1.9,-.8     ;Guard velocity in air (def: (air.xvel*1.5, air.yvel/2))
air.type = High                  ;Type: High, Low, Trip (def: same as ground.type)
air.velocity = -1.4,-3           ;X-velocity at which opponent is pushed,
;Y-velocity at which opponent is pushed
air.hittime = 15                 ;Time before opponent regains control in air
ID = 69
p2stateno = 820
ground.cornerpush.veloff = 0

[State 334, 0]
type = PlaySnd
Trigger1 = Time = 1
persistent = 0
value = 5,0;BOOOM

[State 333, DramaticPause]
triggerall = Time % 3 = 0
Trigger1 = NumExplod(Var(11)) = 1
Trigger2 = NumExplod(Var(12)) = 1
Trigger3 = NumExplod(Var(13)) = 1
Trigger4 = NumExplod(Var(14)) = 1
Trigger5 = NumExplod(Var(15)) = 1
Trigger6 = NumExplod(Var(16)) = 1
Trigger7 = NumExplod(Var(17)) = 1
Trigger8 = NumExplod(Var(18)) = 1
type = Pause
time = 2

[State 334, BlastP1]
type = Explod
Triggerall = Anim = 0;HitDef conditions
Trigger1 = PlayerID(Var(11)), gethitvar(ChainID) = 69
;Trigger1 = PlayerID(Var(11)), StateNo = 820
Trigger1 = NumExplod(Var(11)) < 1
type = explod
anim = 822;burn
bindtime = -1
space = stage
pos = 0,-25
facing = PlayerID(Var(11)), facing
vel = 0,0
sprpriority = 9
Ontop = 1
removetime = 200
ownpal = 1
facing = 1
ID = Var(11)
bindID = Var(11)
[State 333, EndBlastP1]
type = RemoveExplod
ID = Var(11)
;trigger2 = PlayerID(Var(11)),PrevStateNo = 820
Trigger1 = PlayerID(Var(11)), Pos Y = 0

