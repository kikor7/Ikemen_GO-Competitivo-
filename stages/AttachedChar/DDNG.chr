trigger1 = NumHelper(6) > 2
type = ModifyBGCtrl
sctrlID = 3
ID = 3
value = 0
[State 200, ChangeIntoNew]
trigger1 = Var(3) > 0
trigger1 = NumHelper(6) > 2
persistent = 0
