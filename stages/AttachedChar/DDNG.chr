[State 200, HowManyBits]
trigger1 = Time = 0
persistent = 0
type = VarRandom
v = 9
range = 3,9
[State 200, NoMoreBits]
triggerall = Var(3) > 0
trigger1 = NumHelper(6) = Var(9)
persistent = 1
type = VarSet
v = 9
value = 0

[State 200, DramaticPause]
triggerall = Var(3) > 0 && Time % 5 = 0
trigger1 = NumHelper(6) < 9 && NumHelper(6) > 1
persistent = 0
type = Pause
time = 15

[State 200, Blasts]
