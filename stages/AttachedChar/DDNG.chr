space = stage
pos = Pos X + CameraPos X, Pos Y - 30
vel = 0,0
accel = 0,0
random = 40,20
RemoveTime = -2
supermove = 1
sprpriority = 3
ID = 192
facing = 1
[State 200, BigBlast]
