;-----------------------------------------------------------------------------------------------------------------------------------------------------
[State 339, DTC];
Trigger1 = 1
type = DisplayToClipBoard
text="NumHelpers:%d, RespawnTime:%d, TimeSinceBlast:%d"
params = NumHelper, Var(1), Var(2)
-----------------------------------------------------------------------------------------------------------------------------------------------------
;Enemy Falling after being hit, copied from KFM throw
[Statedef 820]
type    = A
movetype= H
physics = N
poweradd = 0

[State 820, InvisbleWhileBurning]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2 = NoHardcodedKeys
flag3 = noautoturn
flag4 = noshadow

[State 820, 0];Hurt anim
type = ChangeAnim2
Trigger1 = Time = 0
value = 820

[State 820, 2];Invinc to avoid double hit by blast AND juggling - this is accurate to source
trigger1 = 1
type = NotHitBy
value = SCA

[State 820, Forward];
trigger1 = Time = 1
persistent = 0
Type = VelSet
x = 5
y = -6

[State 820, Backward];Speed other way
triggerall = Time = 1
trigger1 = StageBackEdge > StageFrontEdge;bump into, neg speed
persistent = 0
Type = VelSet
x = -5
y = -6

[State 820, 5] ;Gravity
type = VelAdd
Trigger1 = Time > 1
y = .4

[State 820, 6] ;Hit ground
type = SelfState
trigger1 = Vel Y > 0
trigger1 = Pos Y >= 0
value = 5100 ;Hit ground

;--------------------------------------------------------------------------
;Code taken from a RicePigeon and PotS thread in Guild
;x= ceil(helper(123),pos x * 0.75); simulates "delta = 0.75, 1"
; Delta Helper;Special Thanks for PotS and RicePigeon's Delta code for helpers
[Statedef 4101]
movetype = I
velSet = 0,0
sprPriority = 0
anim = 2 ;<-- BLANK ANIM
ctrl = 0

[State 4101, 1];Allow to move out of camera
type = Screenbound
trigger1 = 0

[State 4101, Zeeky]
type = destroyself
trigger1 = root,alive = 0

[State 4101, Invisble]
type = AssertSpecial
trigger1 = 1
flag = invisible
flag2 = NoHardcodedKeys
flag3 = noautoturn
flag4 = noshadow

;---------------------------------------------------------------
[Statedef -4]
[State 1, 0];Spawn Helper 1
type = helper
ignorehitpause = 1
trigger1 = !ishelper
trigger1 = NumHelper = 0
name = "Walls"
ID = 1
stateno = 334
pos = -20,-220;
facing = 1
keyctrl = 0
ownpal = 0
supermovetime = 99999
pausemovetime = 99999
size.ground.back = 20
size.ground.front = 20
size.height = 100
immortal = 1

[State 1, 1];Spawn Delta Helper
type = helper
trigger1 = time = 0
trigger1 = numhelper < 2
persistent = 0
helpertype = normal
name = "Delta_Pos"
ID = 4101
pos = 0,0
stateno = 4101
pausemovetime = 999999

[State 1, 2];Fix Player
type = TagOut
trigger1 = !ishelper
ignorehitpause = 1

[State 1, 3];Fix Player
type = Assertspecial
trigger1 = !ishelper
persistent = 0
flag = invisible
flag2 = NoHardcodedKeys
flag3 = noautoturn
flag4 = noshadow
ignorehitpause = 1