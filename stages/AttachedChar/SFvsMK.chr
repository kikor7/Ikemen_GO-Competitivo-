;BRIDGE SLAMMING
;----------------------------------------------------------------------------------------------------------------------------------------
;----------------------------P1
[State 701, DetectFall]
Triggerall = NumExplod(8258231) = 0
Trigger1 = player(1), Pos Y >= -3 
Trigger1 = player(1), Time = 1
Trigger1 = player(1), stateno = 5100 || player(1), stateno = 5110
Trigger1 = (1+floor(Random*100/1000.0)) > 33
type = VarAdd
value = -1 * (5+Random*10/999.0)
v = 7

[State 701, DetectSlam]
Triggerall = NumExplod(8258231) = 0
Trigger1 = player(1), vel Y > 8 && player(1), Pos Y >= -3 && player(1), hitfall = 1
Trigger1 = (1+floor(Random*100/1000.0)) > 33
type = VarAdd
value = -1 * (player(1), vel Y) * ((3+Random*2/999.0));Damage is scaled according to speed of the slam
v = 7

[State 701, DetectThrow]
Triggerall = NumExplod(8258231) = 0
Trigger1 = Map(P1LastPosYCustomState) < player(1), Pos Y  + CameraPos Y
Trigger1 = player(1), Pos Y >= -3 
Trigger1 = player(1), InCustomState = 1 && player(1), Ctrl = 0
Trigger1 = player(1), Time > 5
Trigger1 = (1+floor(Random*100/1000.0)) > 33
type = VarAdd
value = -1 * (70+Random*20/999.0)
v = 7

[State 701, Timer]
Triggerall = NumExplod(8258231) = 0
Trigger1 = player(1), Pos Y >= -3 
Trigger1 = player(1), Time = 1
Trigger1 = player(1), stateno = 5100 || player(1), stateno = 5110 
Trigger2 = player(1), vel Y > 8 && player(1), Pos Y >= -3 && player(1), hitfall = 1
ID = 8258231
type = Explod
anim = 999
space = stage
pos = 0,0
RemoveTime = 60;TIMER
supermovetime = 99999
pausemovetime = 99999

[State 701, TimerCustom]
