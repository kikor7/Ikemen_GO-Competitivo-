;------------------------------------------------------------------------
;UPPERCUT TRANSITION
;------------------------------------------------------------------------
;-Basic conditions checking (no KO, timer > 1, etc.)
;-Game pause
;-Layers moving down
;-Non Player 21 invisibility and Explods of all the players that move "down"
;-Player 21 opens a hole and is sent higher and falls
;-Debris spawning
;-Landing 
[Statedef 1810]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                      ;Move-type: A-attack, I-idle, H-gethit
physics = S                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 999                     ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = -9                  ;Set p1's sprite layering priority to 2 (in front)

[State 1810, Die]
trigger1 = Var(20) = 150
type = DestroySelf

[State 1810, StartUp]
trigger1 = Time = 0
V = 20
Value = 0
type = VarSet
[State 1810, StartUp]
trigger1 = Time = 0
V = 21
Value = 0
type = VarSet

;Record every player's ID at all times
[State 1810, ShowMeYourIDs]
Trigger1 = var(11) := player(1), ID
Trigger1 = var(12) := player(2), ID
Trigger1 = var(13) := player(3), ID
Trigger1 = var(14) := player(4), ID
Trigger1 = var(15) := player(5), ID
Trigger1 = var(16) := player(6), ID
Trigger1 = var(17) := player(7), ID
Trigger1 = var(18) := player(8), ID
type = null

[State 1810, WhoIsFalling]
triggerall = Roundstate = 2 && TimeElapsed > 60
trigger1 = playerid(Var(11)),Vel Y < -2 && playerid(Var(11)),Pos Y < Pos Y && playerid(Var(11)),Hitfall = 1
V = 21
Value = 11
type = VarSet
