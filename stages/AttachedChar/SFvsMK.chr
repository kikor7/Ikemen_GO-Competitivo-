V = 20
Value = 1
type = VarAdd
supermovetime = 99999
pausemovetime = 99999

;STOP TIMER
[State 1810, StopTimer]
trigger1 = Var(20) = 0
V = 22
Value = TimeRemaining
type = VarSet
