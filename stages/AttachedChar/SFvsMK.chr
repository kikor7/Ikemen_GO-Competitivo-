;------------------------Hide All but the one flying
;P1
[State DisappearAndStop]
trigger1 = Var(20) < 152 && Var(21) != 0
trigger1 = 11 != Var(21)
type = AssertSpecial
flag = Invisible
flag2 = NoInput
flag3 = NoShadow
RedirectID = playerid(Var(11)),ID
[State ISaidStop]
trigger1 = Var(20) < 148 && Var(21) != 0
trigger1 = 11 != Var(21)
type = CtrlSet
Value = 0
RedirectID = playerid(Var(11)),ID 
[State OkGo]
trigger1 = Var(20) > 148 && Var(21) != 0
trigger1 = 11 != Var(21)
type = CtrlSet
Value = 1
RedirectID = playerid(Var(11)),ID 
[State Stop]
trigger1 = Var(20) < 152 && Var(21) != 0
trigger1 = 11 != Var(21)
type = VelSet
x = 0
y = 0
RedirectID = playerid(Var(11)),ID 
[State Reposition]
trigger1 = Var(20) < 152 && Var(21) != 0
trigger1 = 11 != Var(21)
type = PosSet
y = 1
RedirectID = playerid(Var(11)),ID 
