;------------------------------------------------------
;NON HITDEF BASED FATALITY SYSTEM
[State 665, FatalTriggerForVictim]
type = SelfState
trigger1 = Anim = 0
trigger1 = playerid(Var(21)),Pos Y <= Pos Y;It's *under* us AND the fatal is enabled
trigger1 = playerid(Var(21)),Vel Y > 0;It's going down
persistent = 0;just in case
ReadPlayerID = player(9),ID
RedirectID = Var(21)
Value = 820

[State 665, FatalTriggerOutsideS]
type = ChangeState
trigger1 = Anim = 0
trigger1 = playerid(Var(21)),Pos Y >= Pos Y;It's *under* us AND the fatal is enabled
trigger1 = playerid(Var(21)),Vel Y > 0;It's going down
trigger1 = Root,Helper(95),StateNo = 1096 && Root,Helper(95),NumHelper(13) > 0
trigger1 = playerid(Var(21)),Pos X + CameraPos X >= -270 && playerid(Var(21)),Pos X + CameraPos X <= 270
persistent = 1
Value = 780

[State 665, FatalTriggerOutsideNormal]
type = ChangeState
trigger1 = Anim = 0
trigger1 = playerid(Var(21)),Pos Y >= Pos Y;It's *under* us AND the fatal is enabled
trigger1 = playerid(Var(21)),Vel Y > 0;It's going down
trigger1 = Parent,Helper(95),StateNo = 1096 && Root,Helper(95),NumHelper(13) = 0
trigger1 = playerid(Var(21)),Pos X + CameraPos X >= -200 && playerid(Var(21)),Pos X + CameraPos X <= 200
persistent = 1
Value = 779

[State 665, FatalTriggerBottom]
type = ChangeState
trigger1 = Anim = 0
trigger1 = playerid(Var(21)),Pos Y >= Pos Y;It's *under* us AND the fatal is enabled
trigger1 = playerid(Var(21)),Vel Y > 0;It's going down
trigger1 = Root,NumHelper(3) = 0 && Root,Helper(95),StateNo = 1095
trigger1 = playerid(Var(21)),Pos X + CameraPos X >= -365 && playerid(Var(21)),Pos X + CameraPos X <= 365
persistent = 1
Value = 777

;66 is uppercutter
;3 is stageelements
;1095 is windowoutside

[State 665, FatalTriggerTopFloor]
type = ChangeState
trigger1 = Anim = 0
trigger1 = playerid(Var(21)),Pos X + CameraPos X >= 248 || playerid(Var(21)),Pos X + CameraPos X <= -248
trigger1 = playerid(Var(21)),Pos Y >= Pos Y;It's *under* us AND the fatal is enabled
trigger1 = playerid(Var(21)),Vel Y > 0;It's going down
trigger1 = Root,NumHelper(66) = 0 && Root,NumHelper(3) > 0
trigger1 = Parent,Helper(95),StateNo = 1095
persistent = 1
Value = 776

[State 665, FatalTriggerMidFloor]
type = ChangeState
trigger1 = Anim = 0
