trigger1 = (Var(3) != 0) % 2 = 0
trigger2 = Root,Helper(4101),Var(2) > 0 || Root,Helper(4101),Var(4) > 0 || Root,Helper(4101),Var(6) > 0 || Root,Helper(4101),Var(8) > 0 
trigger2 = (Var(3) != 0) % 2 = 1
persistent = 0
