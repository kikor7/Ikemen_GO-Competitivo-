;--------------------------------------------------------------------------------------------------------------------
;THE X HELPER STATE
;--------------------------------------------------------------------------------------------------------------------
[Statedef 1313]
type    = S                      ;State-type: S-stand, C-crouch, A-air, L-liedown
movetype= I                      ;Move-type: A-attack, I-idle, H-gethit
physics = N                      ;Physics: S-stand, C-crouch, A-air
juggle  = 1                     ;Number of air juggle points move takes
;Commonly-used controllers:
velset = 0,0                     ;Set velocity (x,y) (Def: no change)
ctrl = 0                         ;Set ctrl (Def: no change)
anim = 999                       ;Change animation (Def: no change)
poweradd = 0                    ;Power to add (Def: 0)
sprpriority = -9                  ;Set p1's sprite layering priority to 2 (in front)

[State HideOld]
trigger1 = Time > 253 && Parent,StateNo = 1096
persistent = 1
type = ModifyBGCtrl
SctrlID = 34
value = 0
supermovetime = 99999
pausemovetime = 99999
ID = 34
[State ShowEverything]
trigger1 = Time > 253 && Parent,StateNo = 1096
persistent = 1
type = ModifyBGCtrl
SctrlID = 36
value = 1
supermovetime = 99999
pausemovetime = 99999
ID = 36

[State 1313, Tune4]
trigger1 = RoundState = 2
persistent = 0
bgm = "Mortal Kombat Official Soundtrack Techno Syndrome 2021 Benjamin Wallfisch WaterTower.mp3"
loop = 1
type = playbgm

[State 2OS, Blue FX];
type= allpalfx
trigger1 = Time > 255
trigger1 = Time % 1024 = 0
trigger1 = Parent,HelperName != "Delta_Pos"
time=1024
sinadd=-64,-64,2,2048;; 1st value red, 2nd green, 3rd blue, 4th fade speed time, 10 is slow, raise it to be faster if desired
invertall=0
color=256
ignorehitpause=1
supermovetime = 9999
pausemovetime = 9999

;The X mode implies:
;50% CHANCE OF TIMER GETTING 10'
[State TimerReset]
trigger1 = RoundState = 2
trigger1 = TimeRemaining = 60
trigger1 = (1+floor(Random*100/1000.0)) > 50
type= RoundTimeAdd
value = 600

;FLOATY, HIGH JUMP
[State AddVelWhenJumping];
trigger1 = RoundState = 2
trigger1 = player(1),Time = 2
trigger1 = (player(1),Vel Y < 0); && (player(1),Vel Y > -5)
persistent = 30
type= VelAdd
y = -5
ignorehitpause=1
supermovetime = 9999
pausemovetime = 9999
RedirectID = player(1),ID
[State FallSlow];
triggerall = RoundState = 2
trigger1 = player(1),Pos Y < 0 && player(1),Vel Y > 1
type= VelMul
y = 0.80
ignorehitpause=1
supermovetime = 9999
pausemovetime = 9999
RedirectID = player(1),ID
;SELF INFINITES WHILE IN AIR
[State ForceRecoveryInAir]
Triggerall = player(1),Ctrl = 0;has no control
trigger1 = player(1),statetype = A;Is in Air
type = CtrlSet
value = 1
RedirectID = player(1),ID
[State TurnAround]
trigger1 = player(1),Pos Y < 0
trigger1 = player(1),Command = "holdback"
type = Turn
RedirectID = player(1),ID
;CONSTANT FILLING POWERBAR
[State TurnAround]
trigger1 = RoundState > 0
trigger1 = Time % 2 = 0
type = PowerAdd
value = 8
RedirectID = player(1),ID

