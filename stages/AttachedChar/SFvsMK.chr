;WHILE IN AIR
[State 701, ForceRecoveryInAir]
Triggerall = Var(1) > 2 && Var(5) = [10,1013]
Trigger1 = player(1),Ctrl = 0;has no control
Trigger1 = player(1),hitfall = 1 || player(1),InCustomState = 1;fell
Trigger2 = Var(5) < 10;beginning of the fall
trigger3 = player(1),AnimTime = 0 && player(1),Time > 1
trigger4 = player(1),Time > 60 ;(antes AnimElemLength, no existe en Ikemen 1.0)
