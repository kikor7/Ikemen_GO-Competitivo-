# Objetivo del repo: editar codigo y configuracion (def, cns, cmd, air, st, zss, lua...).
# Los binarios pesados (sprites, sonidos, musica, video) no se suben.

# =========================
# IKEMEN GO / MUGEN - ARCHIVOS DEL MOTOR Y LOGS
# =========================
/save/
/logs/
*.log
*.dmp
sav/

# =========================
# BINARIOS PESADOS
# =========================
# Sprites y sonidos de personajes/stages/motif
*.sff
*.snd
# Musica y audio
*.mp3
*.ogg
*.wav
*.flac
*.opus
*.m4a
# Video
*.mp4
*.webm
*.avi
*.mkv
*.wmv
*.mpg
# Comprimidos (descargas de personajes/stages)
*.zip
*.rar
*.7z
# Nota: las paletas .act NO se ignoran: pesan 768 bytes y sin ellas
# los personajes nuevos se ven con colores incorrectos.

# =========================
# CONTENIDO PESADO POR CARPETA
# =========================
# stages: se suben los archivos de texto editables y los .sff (sprites, hacen falta
# para arreglar fotos/capas del escenario); musica y sonidos siguen fuera.
/stages/**
!/stages/**/
!/stages/**/*.def
!/stages/**/*.DEF
!/stages/**/*.zss
!/stages/**/*.lua
!/stages/**/*.txt
# personajes adjuntos de escenarios interactivos (AttachedChar): codigo editable
!/stages/**/*.chr
!/stages/**/*.CHR
!/stages/**/*.cns
!/stages/**/*.CNS
!/stages/**/*.cmd
!/stages/**/*.air
!/stages/**/*.st
!/stages/**/*.const
!/stages/**/*.CONST
/sound/
/video/

# =========================
# SISTEMA Y CONFIGURACION LOCAL
# =========================
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
# Restos de descargas incompletas de MEGA
*.mega

# =========================
# ENTORNO DE DESARROLLO Y CONFIGURACION DE IA
# =========================
.vscode/
.idea/
*.swp
*.swo
.env
.sff


